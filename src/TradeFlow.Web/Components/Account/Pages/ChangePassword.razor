@page "/Account/ChangePassword"
@layout LoginLayout

@using System.ComponentModel.DataAnnotations
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Domain.Enums
@using TradeFlow.Infrastructure.Persistence

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IAuditService AuditService
@inject ICredentialVaultService VaultService
@inject ILogger<ChangePassword> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Đổi mật khẩu bắt buộc — TradeFlow</PageTitle>

<div class="tf-login-page tf-login-container">
    <div class="tf-login-overlay" aria-hidden="true"></div>

    <div class="tf-login-card tf-login-glass-card" style="max-width: 520px;">
        @* Brand Header *@
        <div class="tf-login-brand-header">
            <div class="tf-login-brand-badge">
                <div class="tf-login-brand-logo">
                    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 2a5 5 0 00-5 5v3H6a2 2 0 00-2 2v8a2 2 0 002 2h12a2 2 0 002-2v-8a2 2 0 00-2-2h-1V7a5 5 0 00-5-5zm-3 5a3 3 0 116 0v3H9V7zm3 7a1.5 1.5 0 011 1.41V17a1 1 0 11-2 0v-1.59A1.5 1.5 0 0112 14z" fill="#38bdf8"/>
                    </svg>
                </div>
                <div>
                    <div class="tf-login-brand-name">TradeFlow</div>
                    <div class="tf-login-brand-tagline">Bảo mật tài khoản</div>
                </div>
            </div>

            <h1 class="tf-login-title">Yêu cầu đổi mật khẩu</h1>
            <p class="tf-login-subtitle">
                @if (_isFirstTime)
                {
                    <span>Đây là lần đăng nhập đầu tiên với mật khẩu tạm thời. Để đảm bảo an toàn, bạn bắt buộc phải thiết lập mật khẩu mới trước khi tiếp tục.</span>
                }
                else
                {
                    <span>Tài khoản của bạn đã được quản trị viên đặt lại mật khẩu. Vui lòng thiết lập mật khẩu mới để tiếp tục.</span>
                }
            </p>
        </div>

        @* Error alert *@
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="tf-login-alert tf-login-alert-error" role="alert" style="margin-bottom: 20px;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:1px;">
                    <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
                <span>@_errorMessage</span>
            </div>
        }

        @* Success alert *@
        @if (!string.IsNullOrEmpty(_successMessage))
        {
            <div class="tf-login-alert" role="alert" style="background:rgba(16,185,129,0.15);border:1px solid rgba(16,185,129,0.4);color:#10b981;margin-bottom:20px;padding:12px;border-radius:8px;display:flex;align-items:center;gap:10px;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;">
                    <polyline points="20 6 9 17 4 12"/>
                </svg>
                <span>@_successMessage</span>
            </div>
        }

        <EditForm EditContext="_editContext" method="post" OnSubmit="HandleChangePasswordAsync" FormName="change-password">
            <DataAnnotationsValidator />

            @* Current Password *@
            <div class="tf-login-field">
                <label class="tf-login-label" for="old-password">Mật khẩu hiện tại (mật khẩu tạm)</label>
                <div class="tf-login-input-wrap">
                    <TradeFlow.Web.Components.Account.Shared.PasswordToggleInput
                        Name="Input.OldPassword"
                        Id="old-password"
                        CssClass="tf-login-input"
                        Placeholder="Nhập mật khẩu hiện tại"
                        Autocomplete="current-password"
                        InitialValue="@Input.OldPassword" />
                </div>
                <ValidationMessage For="() => Input.OldPassword" class="tf-login-val-msg" />
            </div>

            @* New Password *@
            <div class="tf-login-field">
                <label class="tf-login-label" for="new-password">Mật khẩu mới</label>
                <div class="tf-login-input-wrap">
                    <TradeFlow.Web.Components.Account.Shared.PasswordToggleInput
                        Name="Input.NewPassword"
                        Id="new-password"
                        CssClass="tf-login-input"
                        Placeholder="Tối thiểu 8 ký tự (hoa, thường, số, ký tự đặc biệt)"
                        Autocomplete="new-password"
                        InitialValue="@Input.NewPassword" />
                </div>
                <ValidationMessage For="() => Input.NewPassword" class="tf-login-val-msg" />
                <div style="font-size: 11px; color: var(--tf-text-secondary, #94a3b8); margin-top: 4px;">
                    Mật khẩu phải dài ít nhất 8 ký tự, bao gồm chữ hoa, chữ thường, số và ký tự đặc biệt (!@@#$%^&*).
                </div>
            </div>

            @* Confirm New Password *@
            <div class="tf-login-field">
                <label class="tf-login-label" for="confirm-password">Xác nhận mật khẩu mới</label>
                <div class="tf-login-input-wrap">
                    <TradeFlow.Web.Components.Account.Shared.PasswordToggleInput
                        Name="Input.ConfirmPassword"
                        Id="confirm-password"
                        CssClass="tf-login-input"
                        Placeholder="Nhập lại mật khẩu mới"
                        Autocomplete="new-password"
                        InitialValue="@Input.ConfirmPassword" />
                </div>
                <ValidationMessage For="() => Input.ConfirmPassword" class="tf-login-val-msg" />
            </div>

            @* Submit Button *@
            <div style="margin-top: 24px;">
                <button type="submit" class="tf-login-btn" disabled="@_isSubmitting" id="btn-change-password-submit">
                    @if (_isSubmitting)
                    {
                        <span class="tf-spinner" style="width:16px;height:16px;border-width:2px;display:inline-block;margin-right:8px;" aria-hidden="true"></span>
                        <span>Đang xử lý...</span>
                    }
                    else
                    {
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:8px;">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                        <span>Cập nhật mật khẩu &amp; Tiếp tục</span>
                    }
                </button>
            </div>
        </EditForm>

        <div class="tf-login-footer-info" style="margin-top: 24px; text-align: center;">
            <form action="Account/Logout" method="post" style="display:inline;">
                <AntiforgeryToken />
                <button type="submit" style="background:none;border:none;color:#94a3b8;font-size:13px;cursor:pointer;text-decoration:underline;">
                    Đăng xuất tài khoản này
                </button>
            </form>
        </div>
    </div>
</div>

@code {
    private string? _errorMessage;
    private string? _successMessage;
    private EditContext _editContext = default!;
    private bool _isSubmitting;
    private bool _isFirstTime = true;
    private ApplicationUser? _currentUser;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private ChangePasswordModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        _editContext = new EditContext(Input);

        _currentUser = await UserManager.GetUserAsync(HttpContext.User);
        if (_currentUser == null)
        {
            // Nếu chưa đăng nhập, đưa về trang đăng nhập
            NavigationManager.NavigateTo("Account/Login", forceLoad: true);
            return;
        }

        _isFirstTime = _currentUser.MustChangePassword;

        // Nếu người dùng không có cờ bắt buộc đổi và tài khoản đang hoạt động bình thường, chuyển về trang chủ
        if (!_currentUser.MustChangePassword && _currentUser.Status == UserStatus.Active)
        {
            NavigationManager.NavigateTo("/", forceLoad: true);
        }
    }

    private async Task HandleChangePasswordAsync()
    {
        if (_isSubmitting) return;
        _isSubmitting = true;

        try
        {
            _errorMessage = null;
            _successMessage = null;

            if (!_editContext.Validate())
            {
                return;
            }

            if (_currentUser == null)
            {
                _currentUser = await UserManager.GetUserAsync(HttpContext.User);
                if (_currentUser == null)
                {
                    NavigationManager.NavigateTo("Account/Login", forceLoad: true);
                    return;
                }
            }

            // Kiểm tra mật khẩu mới không được trùng với mật khẩu cũ
            if (Input.NewPassword.Trim() == Input.OldPassword.Trim())
            {
                _errorMessage = "Mật khẩu mới không được trùng với mật khẩu tạm thời vừa được cấp.";
                return;
            }

            // Kiểm tra quy tắc độ mạnh mật khẩu
            if (!IsStrongPassword(Input.NewPassword))
            {
                _errorMessage = "Mật khẩu mới phải có tối thiểu 8 ký tự, bao gồm ít nhất một chữ hoa, một chữ thường, một chữ số và một ký tự đặc biệt (!@#$%^&*).";
                return;
            }

            var changeResult = await UserManager.ChangePasswordAsync(_currentUser, Input.OldPassword, Input.NewPassword);
            if (!changeResult.Succeeded)
            {
                var errors = changeResult.Errors.Select(e => TranslateIdentityError(e.Code, e.Description));
                _errorMessage = string.Join(". ", errors);
                return;
            }

            // Cập nhật trạng thái người dùng & đồng bộ EncryptedPassword cho ROOT
            _currentUser.MustChangePassword = false;
            _currentUser.PasswordChangedAt = DateTime.UtcNow;
            _currentUser.Status = UserStatus.Active;
            _currentUser.EncryptedPassword = VaultService.EncryptPassword(Input.NewPassword);

            await UserManager.UpdateSecurityStampAsync(_currentUser);
            await UserManager.UpdateAsync(_currentUser);

            // Làm mới cookie phiên đăng nhập
            await SignInManager.RefreshSignInAsync(_currentUser);

            // Ghi log kiểm toán
            await AuditService.LogAsync(
                AuditEventType.PasswordChanged,
                _currentUser.UserName ?? "User",
                "ApplicationUser",
                _currentUser.UserName,
                $"Người dùng '{_currentUser.UserName}' đã đổi mật khẩu lần đầu thành công và kích hoạt trạng thái Hoạt động.");

            // Chuyển hướng vào hệ thống
            RedirectManager.RedirectTo("/");
        }
        catch (NavigationException)
        {
            throw;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Lỗi xảy ra khi đổi mật khẩu người dùng.");
            _errorMessage = "Đã xảy ra lỗi không mong muốn. Vui lòng thử lại sau.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private static bool IsStrongPassword(string password)
    {
        if (string.IsNullOrWhiteSpace(password) || password.Length < 8) return false;
        bool hasUpper = password.Any(char.IsUpper);
        bool hasLower = password.Any(char.IsLower);
        bool hasDigit = password.Any(char.IsDigit);
        bool hasSpecial = Regex.IsMatch(password, @"[!@#$%^&*(),.?"":{}|<>]");
        return hasUpper && hasLower && hasDigit && hasSpecial;
    }

    private static string TranslateIdentityError(string code, string defaultDesc)
    {
        return code switch
        {
            "PasswordMismatch" => "Mật khẩu hiện tại không chính xác.",
            "PasswordTooShort" => "Mật khẩu quá ngắn (tối thiểu 8 ký tự).",
            "PasswordRequiresNonAlphanumeric" => "Mật khẩu phải chứa ít nhất một ký tự đặc biệt.",
            "PasswordRequiresDigit" => "Mật khẩu phải chứa ít nhất một chữ số.",
            "PasswordRequiresLower" => "Mật khẩu phải chứa ít nhất một chữ cái thường.",
            "PasswordRequiresUpper" => "Mật khẩu phải chứa ít nhất một chữ cái in hoa.",
            _ => defaultDesc
        };
    }

    private sealed class ChangePasswordModel
    {
        [Required(ErrorMessage = "Vui lòng nhập mật khẩu hiện tại.")]
        [DataType(DataType.Password)]
        public string OldPassword { get; set; } = "";

        [Required(ErrorMessage = "Vui lòng nhập mật khẩu mới.")]
        [StringLength(100, MinimumLength = 8, ErrorMessage = "Mật khẩu phải từ 8 ký tự trở lên.")]
        [DataType(DataType.Password)]
        public string NewPassword { get; set; } = "";

        [Required(ErrorMessage = "Vui lòng xác nhận mật khẩu mới.")]
        [DataType(DataType.Password)]
        [Compare("NewPassword", ErrorMessage = "Mật khẩu xác nhận không khớp với mật khẩu mới.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
