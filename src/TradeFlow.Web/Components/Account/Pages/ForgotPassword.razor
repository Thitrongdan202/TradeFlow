@page "/Account/ForgotPassword"
@layout LoginLayout

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Domain.Enums
@using TradeFlow.Infrastructure.Persistence

@inject UserManager<ApplicationUser> UserManager
@inject IAuditService AuditService
@inject ILogger<ForgotPassword> Logger
@inject NavigationManager NavigationManager

<PageTitle>Quên mật khẩu — TradeFlow</PageTitle>

<div class="tf-login-page tf-login-container">
    @* Atmospheric maritime gradient overlay *@
    <div class="tf-login-overlay" aria-hidden="true"></div>

    @* Translucent Frosted Glass Card *@
    <div class="tf-login-card tf-login-glass-card">
        @* Brand Header *@
        <div class="tf-login-brand-header">
            <div class="tf-login-brand-badge">
                <div class="tf-login-brand-logo">
                    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M3 3h7v7H3V3z" fill="#38bdf8"/>
                        <path d="M14 3h7v7h-7V3z" fill="#818cf8"/>
                        <path d="M3 14h7v7H3v-7z" fill="#818cf8" opacity="0.8"/>
                        <path d="M14 14h7v7h-7v-7z" fill="#38bdf8"/>
                    </svg>
                </div>
                <div>
                    <div class="tf-login-brand-name">TradeFlow</div>
                    <div class="tf-login-brand-tagline">Hỗ trợ khôi phục</div>
                </div>
            </div>

            <h1 class="tf-login-title">Quên mật khẩu?</h1>
            <p class="tf-login-subtitle">
                Gửi yêu cầu hỗ trợ đến quản trị viên để được cấp lại mật khẩu truy cập hệ thống.
            </p>
        </div>

        @if (_isSubmitted)
        {
            @* Administrator-Assisted Recovery Confirmation Message *@
            <div class="tf-login-alert tf-login-alert-success" role="alert" id="tf-recovery-success-alert" style="flex-direction:column;align-items:center;text-align:center;padding:24px 18px;gap:14px;">
                <div style="width:52px;height:52px;border-radius:50%;background:rgba(34,197,94,0.22);border:1px solid rgba(34,197,94,0.45);display:flex;align-items:center;justify-content:center;color:#4ade80;">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"/>
                    </svg>
                </div>
                <div style="font-size:16px;font-weight:600;color:#ffffff;">Đã gửi yêu cầu hỗ trợ thành công</div>
                <div style="font-size:14px;color:#dcfce7;line-height:1.55;" id="tf-recovery-confirmation-text">
                    Yêu cầu hỗ trợ đã được gửi đến quản trị viên. Vui lòng liên hệ quản trị viên để được hỗ trợ cấp lại mật khẩu.
                </div>
                <div style="font-size:12px;color:rgba(255,255,255,0.7);margin-top:2px;">
                    Thông báo đã được chuyển trực tiếp vào Trung tâm thông báo điều hành. Quản trị viên sẽ xử lý và liên hệ hỗ trợ bạn sớm nhất.
                </div>
            </div>

            <div style="margin-top:24px;">
                <a href="/Account/Login" class="tf-login-submit-btn" style="text-decoration:none;" id="btn-back-to-login">
                    Quay lại đăng nhập
                </a>
            </div>
        }
        else
        {
            @* Recovery Request Form *@
            <EditForm Model="Input" FormName="forgot-password" OnValidSubmit="OnValidSubmitAsync" method="post">
                <DataAnnotationsValidator />

                @* Username or Email *@
                <div class="tf-login-field">
                    <label class="tf-login-label" for="recovery-username">Tên đăng nhập hoặc email đã đăng ký</label>
                    <div class="tf-login-input-wrap">
                        <InputText @bind-Value="Input.UsernameOrEmail"
                                   id="recovery-username"
                                   class="tf-login-input"
                                   autocomplete="username"
                                   placeholder="Nhập tên đăng nhập hoặc email"
                                   aria-required="true" />
                    </div>
                    <ValidationMessage For="() => Input.UsernameOrEmail" class="tf-login-val-msg" />
                </div>

                @* Optional contact info / note *@
                <div class="tf-login-field">
                    <label class="tf-login-label" for="recovery-contact">Thông tin liên hệ / Ghi chú (tùy chọn)</label>
                    <div class="tf-login-input-wrap">
                        <InputText @bind-Value="Input.ContactInfo"
                                   id="recovery-contact"
                                   class="tf-login-input"
                                   placeholder="Ví dụ: SĐT 0912..., phòng Kế toán" />
                    </div>
                    <div style="font-size:12px;color:rgba(255,255,255,0.65);margin-top:5px;">
                        Cung cấp số điện thoại hoặc phòng ban để quản trị viên xác minh và hỗ trợ nhanh chóng.
                    </div>
                </div>

                @* Submit button *@
                <button type="submit"
                        class="tf-login-submit-btn"
                        id="btn-submit-recovery"
                        disabled="@_isSubmitting"
                        style="margin-top:10px;">
                    @if (_isSubmitting)
                    {
                        <span class="tf-login-spinner" aria-hidden="true"></span>
                        <span>Đang gửi yêu cầu...</span>
                    }
                    else
                    {
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="22" y1="2" x2="11" y2="13"/>
                            <polygon points="22 2 15 22 11 13 2 9 22 2"/>
                        </svg>
                        <span>Gửi yêu cầu hỗ trợ</span>
                    }
                </button>

                <div style="text-align:center;margin-top:20px;">
                    <a href="/Account/Login" class="tf-login-forgot-link" style="color:rgba(255,255,255,0.85);font-size:13px;" id="link-cancel-recovery">
                        ← Quay lại đăng nhập
                    </a>
                </div>
            </EditForm>
        }

        <div class="tf-login-footer-info">
            TradeFlow &copy; @DateTime.Now.Year — Cổng hỗ trợ người dùng doanh nghiệp
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    private bool _isSubmitting;
    private bool _isSubmitted;

    protected override void OnInitialized()
    {
        Input ??= new();
    }

    private async Task OnValidSubmitAsync()
    {
        if (_isSubmitting) return;
        _isSubmitting = true;

        try
        {
            var identifier = Input.UsernameOrEmail?.Trim() ?? string.Empty;

            // Search user by email or username
            ApplicationUser? user = null;
            if (identifier.Contains('@'))
            {
                user = await UserManager.FindByEmailAsync(identifier);
            }
            if (user == null)
            {
                user = await UserManager.FindByNameAsync(identifier);
            }

            var noteDetails = !string.IsNullOrWhiteSpace(Input.ContactInfo)
                ? $"Thông tin liên hệ / ghi chú: {Input.ContactInfo.Trim()}"
                : "Không có ghi chú thêm.";

            var clientIp = HttpContext?.Connection?.RemoteIpAddress?.ToString();
            var userAgent = HttpContext?.Request?.Headers?.UserAgent.ToString();

            // Submit recovery request to administrator audit & notification pipeline
            await AuditService.LogAsync(
                AuditEventType.PasswordRecoveryRequested,
                performedBy: "Khách (Yêu cầu khôi phục)",
                targetEntity: "ApplicationUser",
                targetId: user?.UserName ?? identifier,
                details: noteDetails,
                ipAddress: clientIp,
                userAgent: userAgent);

            Logger.LogInformation("Password recovery requested for {TargetId} from IP {Ip}", user?.UserName ?? identifier, clientIp);
            _isSubmitted = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error logging password recovery request for {UsernameOrEmail}", Input?.UsernameOrEmail);
            // Present graceful success state even on internal exception to avoid user lockouts or enumeration
            _isSubmitted = true;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    public sealed class InputModel
    {
        [Required(ErrorMessage = "Vui lòng nhập tên đăng nhập hoặc email đã đăng ký.")]
        public string UsernameOrEmail { get; set; } = "";

        public string? ContactInfo { get; set; }
    }
}
