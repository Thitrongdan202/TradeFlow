@page "/Account/Lockout"
@layout LoginLayout

<PageTitle>Tài khoản bị khóa — TradeFlow</PageTitle>

<div class="tf-login-page tf-login-container">
    <div class="tf-login-overlay" aria-hidden="true"></div>

    <div class="tf-login-card tf-login-glass-card" style="text-align:center;">
        <div class="tf-login-brand-header">
            <div class="tf-login-brand-badge">
                <div class="tf-login-brand-logo">
                    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M3 3h7v7H3V3z" fill="#38bdf8"/>
                        <path d="M14 3h7v7h-7V3z" fill="#818cf8"/>
                        <path d="M3 14h7v7H3v-7z" fill="#818cf8" opacity="0.8"/>
                        <path d="M14 14h7v7h-7v-7z" fill="#38bdf8"/>
                    </svg>
                </div>
                <div>
                    <div class="tf-login-brand-name">TradeFlow</div>
                    <div class="tf-login-brand-tagline">Bảo mật hệ thống</div>
                </div>
            </div>
        </div>

        <div class="tf-login-alert tf-login-alert-error" role="alert" style="flex-direction:column;align-items:center;text-align:center;padding:24px 18px;gap:14px;">
            <div style="width:56px;height:56px;border-radius:50%;background:rgba(239,68,68,0.2);border:1px solid rgba(239,68,68,0.45);display:flex;align-items:center;justify-content:center;color:#f87171;">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
            </div>
            <div style="font-size:18px;font-weight:600;color:#ffffff;">Tài khoản bị tạm khóa</div>
            <div style="font-size:14px;color:#fecaca;line-height:1.55;">
                Tài khoản của bạn đã bị tạm khóa do nhập sai mật khẩu quá nhiều lần (5 lần liên tiếp). Vui lòng thử lại sau 15 phút hoặc gửi yêu cầu hỗ trợ đến quản trị viên.
            </div>
        </div>

        <div style="margin-top:24px;display:flex;flex-direction:column;gap:12px;">
            <a href="/Account/Login" class="tf-login-submit-btn" style="text-decoration:none;">
                Quay lại đăng nhập
            </a>
            <a href="/Account/ForgotPassword" class="tf-login-forgot-link" style="color:#38bdf8;font-size:13px;">
                Gửi yêu cầu hỗ trợ mở khóa
            </a>
        </div>

        <div class="tf-login-footer-info">
            TradeFlow &copy; @DateTime.Now.Year — Trung tâm an ninh & bảo mật
        </div>
    </div>
</div>
