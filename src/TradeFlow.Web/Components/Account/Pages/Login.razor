@page "/Account/Login"
@layout LoginLayout

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using TradeFlow.Domain.Enums
@using TradeFlow.Infrastructure.Persistence

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject ILogger<Login> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Đăng nhập — TradeFlow</PageTitle>

<div class="tf-login-page tf-login-container">
    @* Atmospheric maritime gradient overlay *@
    <div class="tf-login-overlay" aria-hidden="true"></div>

    @* Translucent Frosted Glass Card *@
    <div class="tf-login-card tf-login-glass-card">
        @* Brand Header *@
        <div class="tf-login-brand-header">
            <div class="tf-login-brand-badge">
                <div class="tf-login-brand-logo">
                    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M3 3h7v7H3V3z" fill="#38bdf8"/>
                        <path d="M14 3h7v7h-7V3z" fill="#818cf8"/>
                        <path d="M3 14h7v7H3v-7z" fill="#818cf8" opacity="0.8"/>
                        <path d="M14 14h7v7h-7v-7z" fill="#38bdf8"/>
                    </svg>
                </div>
                <div>
                    <div class="tf-login-brand-name">TradeFlow</div>
                    <div class="tf-login-brand-tagline">Quản lý thương mại</div>
                </div>
            </div>

            <h1 class="tf-login-title">Chào mừng trở lại</h1>
            <p class="tf-login-subtitle">Đăng nhập để tiếp tục quản lý hoạt động kinh doanh của bạn.</p>
        </div>

        @* Error alert *@
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="tf-login-alert tf-login-alert-error" role="alert" id="tf-login-error-alert">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:1px;">
                    <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
                <span>@_errorMessage</span>
            </div>
        }

        @* Login Form — Static SSR POST with JavaScript eye icon *@
        <EditForm EditContext="_editContext" method="post" OnSubmit="LoginUser" FormName="login">
            <DataAnnotationsValidator />

            @* Username or Email *@
            <div class="tf-login-field">
                <label class="tf-login-label" for="login-username">Tên đăng nhập hoặc email</label>
                <div class="tf-login-input-wrap">
                    <InputText @bind-Value="Input.Username"
                               id="login-username"
                               class="@UsernameInputClass"
                               autocomplete="username"
                               placeholder="Tên đăng nhập hoặc email"
                               aria-required="true"
                               aria-describedby="login-username-error" />
                </div>
                <ValidationMessage For="() => Input.Username" id="login-username-error" class="tf-login-val-msg" />
            </div>

            @* Password with Eye Toggle *@
            <div class="tf-login-field">
                <label class="tf-login-label" for="login-password">Mật khẩu</label>
                <TradeFlow.Web.Components.Account.Shared.PasswordToggleInput
                    Name="Input.Password"
                    Id="login-password"
                    CssClass="@PasswordInputClass"
                    Placeholder="Nhập mật khẩu"
                    Autocomplete="current-password"
                    InitialValue="@Input.Password" />
                <ValidationMessage For="() => Input.Password" class="tf-login-val-msg" />
            </div>

            @* Remember Me + Forgot Password *@
            <div class="tf-login-meta-row">
                <label class="tf-login-checkbox-label">
                    <InputCheckbox @bind-Value="Input.RememberMe" class="tf-login-checkbox" id="login-remember-me" />
                    <span>Ghi nhớ đăng nhập</span>
                </label>
                <a href="/Account/ForgotPassword" class="tf-login-forgot-link" id="login-forgot-password-link">Quên mật khẩu?</a>
            </div>

            @* Submit button *@
            <button type="submit"
                    class="tf-login-submit-btn"
                    id="login-submit-button"
                    disabled="@_isSubmitting"
                    aria-busy="@(_isSubmitting ? "true" : "false")">
                @if (_isSubmitting)
                {
                    <span class="tf-login-spinner" aria-hidden="true"></span>
                    <span>Đang đăng nhập...</span>
                }
                else
                {
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4"/>
                        <polyline points="10 17 15 12 10 7"/>
                        <line x1="15" y1="12" x2="3" y2="12"/>
                    </svg>
                    <span>Đăng nhập</span>
                }
            </button>
        </EditForm>

        <div class="tf-login-footer-info">
            Hệ thống quản lý thương mại và kho vận TradeFlow &copy; @DateTime.Now.Year
        </div>
    </div>
</div>

@code {
    private string? _errorMessage;
    private EditContext _editContext = default!;
    private bool _usernameHasError;
    private bool _passwordHasError;
    private bool _isSubmitting;

    private string UsernameInputClass => _usernameHasError ? "tf-login-input tf-input-error" : "tf-login-input";
    private string PasswordInputClass => _passwordHasError ? "tf-login-input tf-input-error" : "tf-login-input";

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        _editContext = new EditContext(Input);

        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
        }
    }

    public async Task LoginUser()
    {
        if (_isSubmitting) return;
        _isSubmitting = true;

        try
        {
            _errorMessage = null;
            _usernameHasError = false;
            _passwordHasError = false;

            if (!_editContext.Validate())
            {
                _usernameHasError = _editContext.GetValidationMessages(() => Input.Username).Any();
                _passwordHasError = _editContext.GetValidationMessages(() => Input.Password).Any();
                return;
            }

            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(15));

            // Support login by username OR email
            ApplicationUser? user = null;
            var loginInput = Input.Username.Trim();

            // Try by email first
            if (loginInput.Contains('@'))
            {
                user = await UserManager.FindByEmailAsync(loginInput);
            }
            // Then by username
            if (user == null)
            {
                user = await UserManager.FindByNameAsync(loginInput);
            }

            if (user == null)
            {
                // Generic error prevents user enumeration
                _errorMessage = "Tên đăng nhập hoặc mật khẩu không chính xác.";
                _usernameHasError = true;
                _passwordHasError = true;
                return;
            }

            // Check account status (custom field)
            if (user.Status == UserStatus.Locked)
            {
                Logger.LogWarning("Attempt to log in to locked account: {Username}", loginInput);
                _errorMessage = "Tài khoản của bạn đã bị khóa. Vui lòng liên hệ quản trị viên để được mở khóa.";
                return;
            }

            if (user.Status == UserStatus.Terminated || user.Status == UserStatus.Disabled)
            {
                Logger.LogWarning("Attempt to log in to terminated/disabled account: {Username}", loginInput);
                _errorMessage = "Tài khoản đã bị vô hiệu hóa: Tài khoản của bạn hiện không còn quyền truy cập hệ thống do trạng thái nhân sự đã được cập nhật. Vui lòng liên hệ bộ phận quản trị nếu cần hỗ trợ.";
                return;
            }

            // Sign in using the actual username (not the input which could be email)
            var result = await SignInManager.PasswordSignInAsync(
                user.UserName!, Input.Password, Input.RememberMe, lockoutOnFailure: true);

            if (result.Succeeded)
            {
                Logger.LogInformation("User {Username} logged in successfully.", user.UserName);

                // First-time login interception or mandatory password change
                if (user.MustChangePassword || user.Status == UserStatus.MustChangePassword)
                {
                    RedirectManager.RedirectTo("Account/ChangePassword");
                    return;
                }

                RedirectManager.RedirectTo(ReturnUrl);
            }
            else if (result.RequiresTwoFactor)
            {
                RedirectManager.RedirectTo(
                    "Account/LoginWith2fa",
                    new() { ["returnUrl"] = ReturnUrl, ["rememberMe"] = Input.RememberMe });
            }
            else if (result.IsLockedOut)
            {
                Logger.LogWarning("User account {Username} locked out.", user.UserName);
                RedirectManager.RedirectTo("Account/Lockout");
            }
            else if (result.IsNotAllowed)
            {
                _errorMessage = "Tài khoản của bạn chưa được kích hoạt hoặc chưa xác minh email.";
            }
            else
            {
                Logger.LogWarning("Failed login attempt for user {Username}.", user.UserName);
                // Consistent generic error prevents user enumeration
                _errorMessage = "Tên đăng nhập hoặc mật khẩu không chính xác.";
                _usernameHasError = true;
                _passwordHasError = true;
            }
        }
        catch (OperationCanceledException)
        {
            Logger.LogWarning("Login operation timed out for input {Username}.", Input?.Username);
            _errorMessage = "Yêu cầu đăng nhập quá thời gian phản hồi. Vui lòng thử lại.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error during login for input {Username}.", Input?.Username);
            _errorMessage = "Không thể kết nối đến máy chủ xác thực. Vui lòng thử lại sau giây lát.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Vui lòng nhập tên đăng nhập hoặc email.")]
        public string Username { get; set; } = "";

        [Required(ErrorMessage = "Vui lòng nhập mật khẩu.")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [Display(Name = "Ghi nhớ đăng nhập")]
        public bool RememberMe { get; set; }
    }
}
