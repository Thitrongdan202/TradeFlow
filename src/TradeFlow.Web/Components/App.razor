            openDatePicker: function (wrapId, popupId, dotNetRef) {
                var wrap = document.getElementById(wrapId);
                var popup = document.getElementById(popupId);
                if (!wrap || !popup) return;

                // Close any other active datepicker first, notifying Blazor
                if (window.tradeflow._datePickers) {
                    for (var id in window.tradeflow._datePickers) {
                        if (id !== popupId) {
                            var old = window.tradeflow._datePickers[id];
                            if (old && old.dotNetRef) {
                                try { old.dotNetRef.invokeMethodAsync('CloseFromJs'); } catch (e) {}
                            }
                            window.tradeflow.closeDatePicker(id);
                        }
                    }
                }

                function updatePosition() {
                    if (!wrap || !wrap.isConnected || !popup || !popup.isConnected) {
                        window.tradeflow.closeDatePicker(popupId);
                        return;
                    }

                    var wrapRect = wrap.getBoundingClientRect();
                    if (wrapRect.width === 0 && wrapRect.height === 0) return;
                    if (wrapRect.bottom < 0 || wrapRect.top > window.innerHeight) {
                        return;
                    }

                    // Detect containing block offset
                    var cb = window.tradeflow._getContainingBlock(popup);
                    var containerLeft = 0;
                    var containerTop = 0;
                    if (cb) {
                        var cbRect = cb.getBoundingClientRect();
                        containerLeft = cbRect.left;
                        containerTop = cbRect.top;
                    }

                    var popupWidth = popup.offsetWidth || 288;
                    var popupHeight = popup.offsetHeight || 340;
                    var spaceBelow = window.innerHeight - wrapRect.bottom;
                    var spaceAbove = wrapRect.top;
                    var offset = 4;

                    // Preferred placement: bottom-start (directly below input, aligned to input left edge)
                    // Only flip to top-start if space below is insufficient AND space above is larger
                    var isFlipped = (spaceBelow < popupHeight + offset + 8) && (spaceAbove > spaceBelow);

                    var targetTop;
                    if (isFlipped) {
                        targetTop = wrapRect.top - containerTop - popupHeight - offset;
                        popup.setAttribute('data-placement', 'top-start');
                    } else {
                        targetTop = wrapRect.bottom - containerTop + offset;
                        popup.setAttribute('data-placement', 'bottom-start');
                    }

                    // Horizontal placement: bottom-start strictly aligns to wrapRect.left
                    var targetLeft = wrapRect.left - containerLeft;

                    // Clamp to viewport boundaries if input is near the screen edge
                    var viewportRightLimit = window.innerWidth - popupWidth - 8;
                    if (wrapRect.left + popupWidth > window.innerWidth - 8) {
                        targetLeft = Math.min(targetLeft, viewportRightLimit - containerLeft);
                    }
                    if (targetLeft + containerLeft < 8) {
                        targetLeft = 8 - containerLeft;
                    }

                    popup.style.top = targetTop + 'px';
                    popup.style.left = targetLeft + 'px';
                }

                updatePosition();
                requestAnimationFrame(updatePosition);
                setTimeout(updatePosition, 50);
                setTimeout(updatePosition, 160);

                var scrollHandler = function () {
                    updatePosition();
                };

                var resizeHandler = function () {
                    updatePosition();
                };

