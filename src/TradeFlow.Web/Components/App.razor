        document.addEventListener('click', function (e) {

            var toggleBtn = e.target.closest('.tf-sidebar-toggle, .tf-nav-collapse-btn');

            if (toggleBtn) {

                window.tradeflow.toggleSidebar();

                return;

            }

            var closeBtn = e.target.closest('.tf-mobile-close-btn, .tf-sidebar-backdrop');

            if (closeBtn) {

                window.tradeflow.closeMobileSidebar();

                return;

            }

            var flyoutLink = e.target.closest('.tf-flyout-link');

            if (flyoutLink) {

                var flyout = flyoutLink.closest('.tf-nav-flyout');

                if (flyout) {

                    flyout.style.display = 'none';

                    setTimeout(function () {

                        flyout.style.display = '';

                    }, 350);

                }

            }

        });

        // Early and DOMContentLoaded initialization

        window.tradeflow.initSidebar();

        document.addEventListener('DOMContentLoaded', function () {

            window.tradeflow.initSidebar();

        });

