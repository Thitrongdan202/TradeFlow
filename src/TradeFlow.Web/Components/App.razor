downloadPdf: function (url, defaultFilename) {

                return new Promise(function (resolve, reject) {

                    try {

                        // Direct fetch to blob to ensure pure binary download without opening preview tab or print dialog

                        fetch(url, {

                            method: 'GET',

                            headers: { 'Accept': 'application/pdf' },

                            credentials: 'same-origin'

                        })

                        .then(function (response) {

                            if (!response.ok) {

                                throw new Error('HTTP error status: ' + response.status);

                            }

                            var disposition = response.headers.get('content-disposition');

                            var filename = defaultFilename;

                            if (disposition) {

                                var match = disposition.match(/filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/);

                                if (match && match[1]) {

                                    filename = match[1].replace(/['"]/g, '').trim();

                                }

                            }

                            if (!filename) filename = 'document.pdf';

                            return response.blob().then(function (blob) {

                                return { blob: blob, filename: filename };

                            });

                        })

                        .then(function (res) {

                            var blobUrl = window.URL.createObjectURL(res.blob);

                            var link = document.createElement('a');

                            link.style.display = 'none';

                            link.href = blobUrl;

                            link.download = res.filename;

                            document.body.appendChild(link);

                            link.click();

                            setTimeout(function () {

                                if (link.parentNode) link.parentNode.removeChild(link);

                                window.URL.revokeObjectURL(blobUrl);

                            }, 500);

                            resolve(true);

                        })

                        .catch(function (err) {

                            console.error('[tradeflow.downloadPdf] Download failed:', err);

                            // Fallback to direct hidden anchor download

                            try {

                                var fallback = document.createElement('a');

                                fallback.style.display = 'none';

                                fallback.href = url;

                                if (defaultFilename) fallback.download = defaultFilename;

                                document.body.appendChild(fallback);

                                fallback.click();

                                setTimeout(function () {

                                    if (fallback.parentNode) fallback.parentNode.removeChild(fallback);

                                }, 500);

                                resolve(true);

                            } catch (e) {

                                reject(err);

                            }

                        });

                    } catch (e) {

                        console.error('[tradeflow.downloadPdf] Unexpected error:', e);

                        reject(e);

                    }

                });

            },

