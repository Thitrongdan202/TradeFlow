        <div id="tf-startup-loader" class="tf-loading-overlay is-active" role="status" aria-busy="true" aria-live="polite" aria-label="Đang tải...">

            <div class="tf-loading-backdrop"></div>

            <div class="tf-loading-container" id="tf-startup-normal-content">

                <div class="tf-loading-brand-visual">

