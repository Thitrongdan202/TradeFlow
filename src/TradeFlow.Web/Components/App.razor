@code {

    [CascadingParameter] private HttpContext? CascadedHttpContext { get; set; }

    [Inject] private IHttpContextAccessor HttpContextAccessor { get; set; } = null!;

    [Inject] private TradeFlow.Application.Common.Interfaces.ICompanyBrandingService BrandingService { get; set; } = null!;

    private string _serverTheme = "light";

    private bool _isEnhancedNav = false;

    private IComponentRenderMode? PageRenderMode =>

        (CascadedHttpContext ?? HttpContextAccessor?.HttpContext)?.AcceptsInteractiveRouting() == true ? InteractiveServer : null;

    private TradeFlow.Application.Common.Models.Settings.CompanyBrandingDto _branding = new()

    {

        CompanyName = "TỔNG KHO THIẾT BỊ VỆ SINH LACASA",

        LogoPath = "/uploads/branding/lacasa_logo.png",

        ShowLoadingScreen = true,

        ShowCompanyNameOnLoading = true,

        SpinnerColor = "#10b981",

        SpinnerOpacity = 0.8,

        SpinnerSpeed = "normal"

    };

    protected override void OnInitialized()

    {

        try

        {

            var ctx = CascadedHttpContext ?? HttpContextAccessor?.HttpContext;

            if (ctx?.Request?.Headers != null)

            {

                var acceptHeader = ctx.Request.Headers.Accept.ToString();

                if (!string.IsNullOrEmpty(acceptHeader) && acceptHeader.Contains("blazor-enhanced-nav=on", StringComparison.OrdinalIgnoreCase))

                {

                    _isEnhancedNav = true;

                }

                else if (ctx.Request.Headers.ContainsKey("blazor-enhanced-nav") ||

                         ctx.Request.Headers.ContainsKey("X-Blazor-Enhanced-Nav"))

                {

                    _isEnhancedNav = true;

                }

            }

            if (ctx?.Request?.Cookies != null)

            {

                if (ctx.Request.Cookies.TryGetValue("tf_theme", out var cookieTheme) ||

                    ctx.Request.Cookies.TryGetValue("tradeflow_theme", out cookieTheme))

                {

                    if (cookieTheme == "dark" || cookieTheme == "light")

                    {

                        _serverTheme = cookieTheme;

                    }

                }

            }

        }

        catch

        {

            // Fail-safe default

        }

        try

        {

            _branding = BrandingService.GetCachedBranding();

        }

        catch

        {

            // Fail-safe: use defaults if cache lookup fails

        }

    }

    private static string GetSpeedDuration(string? speed)

    {

        return (speed?.ToLowerInvariant()) switch

        {

            "slow" => "2.4s",

            "fast" => "0.85s",

            _ => "1.4s"

        };

    }

