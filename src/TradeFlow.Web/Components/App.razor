<!DOCTYPE html>

<html lang="vi" data-bs-theme="@_serverTheme" data-theme="@_serverTheme" class="@(_serverTheme == "dark" ? "dark" : "")">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="description" content="TradeFlow — Hệ thống quản lý kinh doanh nội bộ" />

    <base href="/" />

    <script>

        // Early Theme Initialization & Guardian Observer to eliminate flicker (FOUT/Flash) before DOM paint

        (function() {

            function getPreferredTheme() {

                try {

                    var cookieMatch = document.cookie.match(/(?:^|;\s*)(?:tf_theme|tradeflow_theme)=([^;]+)/);

                    var cookieTheme = cookieMatch ? cookieMatch[1] : null;

                    if (cookieTheme === 'dark' || cookieTheme === 'light') return cookieTheme;

                    var stored = localStorage.getItem('tf_theme') || localStorage.getItem('tradeflow_theme');

                    if (stored === 'dark' || stored === 'light') return stored;

                } catch (e) {}

                return window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';

            }

            var theme = getPreferredTheme();

            document.documentElement.setAttribute('data-bs-theme', theme);

            document.documentElement.setAttribute('data-theme', theme);

            if (theme === 'dark') {

                document.documentElement.classList.add('dark');

            } else {

                document.documentElement.classList.remove('dark');

            }

            // Immediately ensure both cookies and localStorage are synced synchronously

            try {

                if (!document.cookie.includes('tf_theme=' + theme)) {

                    document.cookie = 'tf_theme=' + theme + ';path=/;max-age=31536000;SameSite=Lax';

                }

                if (!document.cookie.includes('tradeflow_theme=' + theme)) {

                    document.cookie = 'tradeflow_theme=' + theme + ';path=/;max-age=31536000;SameSite=Lax';

                }

                localStorage.setItem('tf_theme', theme);

                localStorage.setItem('tradeflow_theme', theme);

            } catch (e) {}

            // Continuous guardian observer: prevents any Blazor enhanced nav or script from temporarily flashing Light Mode

            if (typeof MutationObserver !== 'undefined') {

                var themeObserver = new MutationObserver(function() {

                    var curTheme = getPreferredTheme();

                    var attrTheme = document.documentElement.getAttribute('data-theme');

                    var attrBsTheme = document.documentElement.getAttribute('data-bs-theme');

                    var hasDarkClass = document.documentElement.classList.contains('dark');

                    if (attrTheme !== curTheme || attrBsTheme !== curTheme || (curTheme === 'dark' && !hasDarkClass) || (curTheme === 'light' && hasDarkClass)) {

                        themeObserver.disconnect();

                        document.documentElement.setAttribute('data-theme', curTheme);

                        document.documentElement.setAttribute('data-bs-theme', curTheme);

                        if (curTheme === 'dark') document.documentElement.classList.add('dark');

                        else document.documentElement.classList.remove('dark');

                        themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme', 'data-bs-theme', 'class'] });

                    }

                });

                themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme', 'data-bs-theme', 'class'] });

            }

        })();

    </script>

    @if (!string.IsNullOrEmpty(_branding.LogoPath))

    {

        <link rel="preload" as="image" href="@_branding.LogoPath" />

    }

    <style>

        /* Continuous Root & Body Canvas Stability - Zero light flashes across all frames */

        html, body {

            background-color: var(--tf-bg, #17191F);

        }

        html[data-bs-theme="dark"], html[data-theme="dark"], html.dark {

            background-color: #17191F !important;

            color-scheme: dark;

        }

        html[data-bs-theme="light"], html[data-theme="light"] {

            background-color: #F1F3F6 !important;

            color-scheme: light;

        }

        /* Critical Startup Loading Screen - Inlined for instant 60 FPS render with 0 layout shift */

        #tf-startup-loader {

            position: fixed;

            inset: 0;

            z-index: 99999;

            display: flex;

            flex-direction: column;

            align-items: center;

            justify-content: center;

            background-color: var(--tf-bg, #F1F3F6);

            opacity: 1;

            visibility: visible;

            pointer-events: auto;

            user-select: none;

            contain: strict;

            transform: translate3d(0, 0, 0);

            will-change: opacity, visibility;

            transition: opacity 0.25s cubic-bezier(0.2, 0, 0, 1), visibility 0.25s cubic-bezier(0.2, 0, 0, 1);

        }

        #tf-startup-loader.is-fading-out {

            opacity: 0 !important;

            visibility: hidden !important;

            pointer-events: none !important;

            transition: opacity 0.25s cubic-bezier(0.2, 0, 0, 1), visibility 0.25s cubic-bezier(0.2, 0, 0, 1) !important;

        }

        #tf-startup-loader .tf-loading-backdrop {

            position: absolute;

            inset: 0;

            background-color: var(--tf-bg, #F1F3F6);

            backdrop-filter: none !important;

            -webkit-backdrop-filter: none !important;

            pointer-events: none;

        }

        /* Authoritative Dark Theme Rules for Startup Loader */

        html[data-bs-theme="dark"] #tf-startup-loader,

        html[data-theme="dark"] #tf-startup-loader,

        html.dark #tf-startup-loader,

        html[data-bs-theme="dark"] #tf-startup-loader .tf-loading-backdrop,

        html[data-theme="dark"] #tf-startup-loader .tf-loading-backdrop,

        html.dark #tf-startup-loader .tf-loading-backdrop {

            background-color: #17191F !important;

            color: #F0F2F6 !important;

        }

        html[data-bs-theme="dark"] .tf-loading-company-name,

        html[data-theme="dark"] .tf-loading-company-name,

        html.dark .tf-loading-company-name {

            color: #F0F2F6 !important;

        }

        html[data-bs-theme="dark"] .tf-loading-status-text,

        html[data-theme="dark"] .tf-loading-status-text,

        html.dark .tf-loading-status-text {

            color: #94A3B8 !important;

        }

        html[data-bs-theme="dark"] .tf-startup-error-box,

        html[data-theme="dark"] .tf-startup-error-box,

        html.dark .tf-startup-error-box {

            background-color: #1e2028 !important;

            border-color: #7f1d1d !important;

            color: #f1f5f9 !important;

        }

        .tf-loading-container {

            position: relative;

            z-index: 2;

            display: flex;

            flex-direction: column;

            align-items: center;

            justify-content: center;

            text-align: center;

            padding: 24px;

        }

        .tf-loading-brand-visual {

            position: relative;

            width: 140px;

            height: 140px;

            display: flex;

            align-items: center;

            justify-content: center;

            margin-bottom: 14px;

            contain: layout size;

        }

        .tf-startup-ring {

            position: absolute;

            inset: 0;

            width: 100%;

            height: 100%;

            pointer-events: none;

            transform-origin: 50% 50%;

            will-change: transform;

            animation: tf-startup-ring-spin 1.4s linear infinite;

        }

        .tf-loading-ring-svg {

            width: 100%;

            height: 100%;

            display: block;

            pointer-events: none;

            overflow: visible;

        }

        .tf-loading-logo-box {

            position: relative;

            z-index: 3;

            width: 95px;

            height: 65px;

            display: flex;

            align-items: center;

            justify-content: center;

            padding: 6px;

        }

        .tf-loading-logo-img {

            max-width: 100%;

            max-height: 100%;

            width: auto;

            height: auto;

            object-fit: contain;

            display: block;

            user-select: none;

            pointer-events: none;

        }

        .tf-loading-company-name {

            font-size: 15px;

            font-weight: 600;

            color: #1e293b;

            margin-bottom: 6px;

            letter-spacing: 0.2px;

            max-width: 320px;

            min-height: 22px;

            line-height: 1.4;

        }

        .tf-loading-status-text {

            font-size: 13px;

            font-weight: 500;

            color: #64748b;

            letter-spacing: 0.3px;

            min-height: 20px;

            line-height: 1.4;

        }

        .tf-startup-error-box {

            position: relative;

            z-index: 10;

            display: flex;

            flex-direction: column;

            align-items: center;

            justify-content: center;

            text-align: center;

            max-width: 380px;

            padding: 24px;

            background: #ffffff;

            border-radius: 12px;

            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.08), 0 8px 10px -6px rgba(0, 0, 0, 0.04);

            border: 1px solid #fee2e2;

        }

        .tf-startup-error-icon {

            margin-bottom: 12px;

        }

        .tf-startup-error-title {

            font-size: 16px;

            font-weight: 600;

            color: #b91c1c;

            margin-bottom: 6px;

        }

        .tf-startup-error-message {

            font-size: 13.5px;

            color: #64748b;

            line-height: 1.5;

            margin-bottom: 18px;

        }

        .tf-startup-retry-btn {

            display: inline-flex;

            align-items: center;

            justify-content: center;

            padding: 8px 20px;

            background-color: #059669;

            color: #ffffff;

            border: none;

            border-radius: 8px;

            font-size: 13.5px;

            font-weight: 500;

            cursor: pointer;

            transition: background-color 0.15s ease;

        }

        .tf-startup-retry-btn:hover {

            background-color: #047857;

        }

        @@keyframes tf-startup-ring-spin {

            0% {

                transform: rotate(0deg);

            }

            100% {

                transform: rotate(360deg);

            }

        }

        @@media (prefers-reduced-motion: reduce) {

            .tf-startup-ring {

                animation: none !important;

            }

        }

    </style>

