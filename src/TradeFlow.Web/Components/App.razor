<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="TradeFlow — Hệ thống quản lý kinh doanh nội bộ" />
    <base href="/" />
    @if (!string.IsNullOrEmpty(_branding.LogoPath))
    {
        <link rel="preload" as="image" href="@_branding.LogoPath" />
    }
    <style>
        /* Critical Startup Loading Screen - Inlined for instant 60 FPS render with 0 layout shift */
        #tf-startup-loader {
            position: fixed;
            inset: 0;
            z-index: 99999;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background-color: #F1F3F6;
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
            user-select: none;
            contain: strict;
            transform: translate3d(0, 0, 0);
            will-change: opacity, visibility;
            transition: opacity 0.25s cubic-bezier(0.2, 0, 0, 1), visibility 0.25s cubic-bezier(0.2, 0, 0, 1);
        }

        #tf-startup-loader.is-fading-out {
            opacity: 0 !important;
            visibility: hidden !important;
            pointer-events: none !important;
            transition: opacity 0.25s cubic-bezier(0.2, 0, 0, 1), visibility 0.25s cubic-bezier(0.2, 0, 0, 1) !important;
        }

        #tf-startup-loader .tf-loading-backdrop {
            position: absolute;
            inset: 0;
            background-color: #F1F3F6 !important;
            backdrop-filter: none !important;
            -webkit-backdrop-filter: none !important;
            pointer-events: none;
        }

        .tf-loading-container {
            position: relative;
            z-index: 2;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 24px;
        }

        .tf-loading-brand-visual {
            position: relative;
            width: 140px;
            height: 140px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 14px;
            contain: layout size;
        }

        .tf-startup-ring {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            transform-origin: 50% 50%;
            will-change: transform;
            animation: tf-startup-ring-spin 1.4s linear infinite;
        }

        .tf-loading-ring-svg {
            width: 100%;
            height: 100%;
            display: block;
            pointer-events: none;
            overflow: visible;
        }

        .tf-loading-logo-box {
            position: relative;
            z-index: 3;
            width: 95px;
            height: 65px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 6px;
        }

        .tf-loading-logo-img {
            max-width: 100%;
            max-height: 100%;
            width: auto;
            height: auto;
            object-fit: contain;
            display: block;
            user-select: none;
            pointer-events: none;
        }

        .tf-loading-company-name {
            font-size: 15px;
            font-weight: 600;
            color: #1e293b;
            margin-bottom: 6px;
            letter-spacing: 0.2px;
            max-width: 320px;
            min-height: 22px;
            line-height: 1.4;
        }

        .tf-loading-status-text {
            font-size: 13px;
            font-weight: 500;
            color: #64748b;
            letter-spacing: 0.3px;
            min-height: 20px;
            line-height: 1.4;
        }

        .tf-startup-error-box {
            position: relative;
            z-index: 10;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            max-width: 380px;
            padding: 24px;
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.08), 0 8px 10px -6px rgba(0, 0, 0, 0.04);
            border: 1px solid #fee2e2;
        }

        .tf-startup-error-icon {
            margin-bottom: 12px;
        }

        .tf-startup-error-title {
            font-size: 16px;
            font-weight: 600;
            color: #b91c1c;
            margin-bottom: 6px;
        }

        .tf-startup-error-message {
            font-size: 13.5px;
            color: #64748b;
            line-height: 1.5;
            margin-bottom: 18px;
        }

        .tf-startup-retry-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 8px 20px;
            background-color: #059669;
            color: #ffffff;
            border: none;
            border-radius: 8px;
            font-size: 13.5px;
            font-weight: 500;
            cursor: pointer;
            transition: background-color 0.15s ease;
        }

        .tf-startup-retry-btn:hover {
            background-color: #047857;
        }

        @@keyframes tf-startup-ring-spin {
            0% {
                transform: rotate(0deg);
            }
            100% {
                transform: rotate(360deg);
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            .tf-startup-ring {
                animation: none !important;
            }
        }
    </style>
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["TradeFlow.Web.styles.css"]" />
    <link rel="stylesheet" href="@Assets["css/tailwind.min.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    @if (_branding.ShowLoadingScreen)
    {
        <div id="tf-startup-loader" class="tf-loading-overlay is-active" role="status" aria-busy="true" aria-live="polite" aria-label="Đang tải...">
            <div class="tf-loading-backdrop"></div>
            <div class="tf-loading-container" id="tf-startup-normal-content">
                <div class="tf-loading-brand-visual">
                    <div class="tf-startup-ring" style="animation-duration: @GetSpeedDuration(_branding.SpinnerSpeed);">
                        <svg class="tf-loading-ring-svg"
                             viewBox="0 0 100 100"
                             aria-hidden="true">
                            <circle cx="50" cy="50" r="44"
                                    fill="none"
                                    stroke="@_branding.SpinnerColor"
                                    stroke-width="2"
                                    opacity="@Math.Min(_branding.SpinnerOpacity * 0.14, 0.18)" />
                            <circle cx="50" cy="50" r="44"
                                    fill="none"
                                    stroke="@_branding.SpinnerColor"
                                    stroke-width="2.5"
                                    stroke-dasharray="85 190"
                                    stroke-dashoffset="0"
                                    stroke-linecap="round"
                                    opacity="@Math.Min(_branding.SpinnerOpacity, 0.88)" />
                        </svg>
                    </div>

                    <div class="tf-loading-logo-box">
                        @if (!string.IsNullOrEmpty(_branding.LogoPath))
                        {
                            <img src="@_branding.LogoPath"
                                 alt="@_branding.CompanyName"
                                 class="tf-loading-logo-img"
                                 width="95"
                                 height="65"
                                 loading="eager"
                                 decoding="async" />
                        }
                        else
                        {
                            <div style="font-weight: 800; font-size: 17px; letter-spacing: 0.8px; color: var(--tf-primary); text-transform: uppercase;">
                                @(string.IsNullOrWhiteSpace(_branding.CompanyName) ? "TradeFlow" : _branding.CompanyName)
                            </div>
                        }
                    </div>
                </div>

                @if (_branding.ShowCompanyNameOnLoading && !string.IsNullOrWhiteSpace(_branding.CompanyName))
                {
                    <div class="tf-loading-company-name">
                        @_branding.CompanyName
                    </div>
                }

                <div class="tf-loading-status-text">
                    Đang tải...
                </div>
            </div>

            <div class="tf-startup-error-box" id="tf-startup-error-box" style="display: none;" role="alert">
                <div class="tf-startup-error-icon">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                </div>
                <div class="tf-startup-error-title">Không thể kết nối đến hệ thống</div>
                <div class="tf-startup-error-message">Đã xảy ra sự cố trong quá trình khởi tạo ứng dụng. Vui lòng thử lại.</div>
                <button type="button" class="tf-startup-retry-btn" onclick="window.location.reload()">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;">
                        <polyline points="23 4 23 10 17 10"></polyline>
                        <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
                    </svg>
                    Thử lại
                </button>
            </div>
        </div>
    }

    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["lib/gsap/gsap.min.js"]"></script>
    <script src="@Assets["js/tradeflow-motion.js"]"></script>
    <script>
        (function () {
            var loader = document.getElementById('tf-startup-loader');
            if (!loader) return;

            var dismissed = false;
            function dismissStartupLoader() {
                if (dismissed) return;
                dismissed = true;

                // 1. Immediately disable pointer-events so user interactions are never blocked
                loader.style.pointerEvents = 'none';
                loader.classList.remove('is-active');
                loader.classList.add('is-fading-out');

                // 2. Remove cleanly from DOM after natural Google decelerate fade-out (250ms)
                setTimeout(function () {
                    if (loader && loader.parentNode) {
                        loader.parentNode.removeChild(loader);
                    }
                }, 280);
            }

            window.tfDismissStartupLoader = dismissStartupLoader;

            function showStartupError() {
                if (dismissed) return;
                var normalContent = document.getElementById('tf-startup-normal-content');
                var errorBox = document.getElementById('tf-startup-error-box');
                if (normalContent) normalContent.style.display = 'none';
                if (errorBox) {
                    errorBox.style.display = 'flex';
                    loader.setAttribute('aria-busy', 'false');
                }
            }

            window.tfShowStartupError = showStartupError;

            // Check if application UI or auth page is rendered in DOM
            function isAppContentReady() {
                return !!(
                    document.querySelector('.tf-app') ||
                    document.querySelector('.tf-content') ||
                    document.querySelector('.tf-login-page') ||
                    document.querySelector('.tf-login-redirect') ||
                    document.querySelector('.tf-sales-workspace') ||
                    document.querySelector('.container-fluid')
                );
            }

            // Continuous mutation watcher for instant dismissal as soon as Blazor paints
            if (document.body) {
                var bodyObserver = new MutationObserver(function () {
                    if (!dismissed && isAppContentReady()) {
                        bodyObserver.disconnect();
                        // Dismiss on next animation frame for a buttery smooth 60fps transition
                        requestAnimationFrame(function () {
                            dismissStartupLoader();
                        });
                    }
                });
                bodyObserver.observe(document.body, { childList: true, subtree: true });
            }

            // Also check on DOM readiness states
            if (document.readyState === 'complete' || document.readyState === 'interactive') {
                if (isAppContentReady()) {
                    dismissStartupLoader();
                }
            } else {
                document.addEventListener('DOMContentLoaded', function () {
                    if (isAppContentReady()) {
                        dismissStartupLoader();
                    }
                });
            }

            // Blazor enhanced page load hook
            if (window.Blazor && window.Blazor.addEventListener) {
                window.Blazor.addEventListener('enhancedload', function () {
                    dismissStartupLoader();
                });
            }

            // Watch specifically for real Blazor circuit crashes
            var blazorErrorUi = document.getElementById('blazor-error-ui');
            if (blazorErrorUi) {
                var errObserver = new MutationObserver(function () {
                    var display = window.getComputedStyle(blazorErrorUi).display;
                    if (display !== 'none' && !dismissed) {
                        showStartupError();
                    }
                });
                errObserver.observe(blazorErrorUi, { attributes: true, attributeFilter: ['style', 'class'] });
            }

            // Safe liveness watchdog: smoothly dismiss after 2s without crashing into fake error
            setTimeout(function () {
                if (!dismissed) {
                    dismissStartupLoader();
                }
            }, 2000);
        })();

        window.tradeflow = {
            isMobile: function () {
                return window.innerWidth < 1024;
            },
            getSidebarCollapsed: function () {
                try {
                    return localStorage.getItem('tf_sidebar_collapsed') === 'true';
                } catch (e) {
                    return false;
                }
            },
            setSidebarCollapsed: function (val) {
                try {
                    localStorage.setItem('tf_sidebar_collapsed', val ? 'true' : 'false');
                } catch (e) { }
                var sidebar = document.querySelector('.tf-sidebar');
                if (sidebar) {
                    sidebar.classList.add('is-animating-horizontal');
                    setTimeout(function () {
                        sidebar.classList.remove('is-animating-horizontal');
                    }, 260);
                }
            },
            toggleSidebar: function () {
                var isMob = window.innerWidth < 1024;
                var sidebar = document.querySelector('.tf-sidebar');
                var wrapper = document.querySelector('.tf-main-wrapper');
                var app = document.querySelector('.tf-app');
                var hamburgerBtn = document.querySelector('.tf-sidebar-toggle');
                var bottomBtn = document.querySelector('.tf-nav-collapse-btn');
                var backdrop = document.querySelector('.tf-sidebar-backdrop');

                if (isMob) {
                    if (!sidebar) return;
                    var isOpen = sidebar.classList.toggle('open');
                    if (backdrop) {
                        if (isOpen) {
                            backdrop.classList.add('active');
                        } else {
                            backdrop.classList.remove('active');
                        }
                    }
                    if (hamburgerBtn) {
                        hamburgerBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
                    }
                } else {
                    if (!sidebar) return;
                    var isCurrentlyCollapsed = sidebar.classList.contains('is-collapsed');
                    var willBeCollapsed = !isCurrentlyCollapsed;

                    if (willBeCollapsed) {
                        sidebar.classList.add('is-collapsed');
                        if (wrapper) wrapper.classList.add('is-collapsed');
                        if (app) app.classList.add('is-sidebar-collapsed');
                    } else {
                        sidebar.classList.remove('is-collapsed');
                        if (wrapper) wrapper.classList.remove('is-collapsed');
                        if (app) app.classList.remove('is-sidebar-collapsed');
                    }

                    sidebar.classList.add('is-animating-horizontal');
                    setTimeout(function () {
                        sidebar.classList.remove('is-animating-horizontal');
                    }, 260);

                    try {
                        localStorage.setItem('tf_sidebar_collapsed', willBeCollapsed ? 'true' : 'false');
                    } catch (e) { }

                    var titleText = willBeCollapsed ? 'Mở rộng thanh menu (Ctrl+B)' : 'Thu gọn thanh menu (Ctrl+B)';
                    var labelText = willBeCollapsed ? 'Mở rộng thanh menu' : 'Thu gọn thanh menu';

                    if (hamburgerBtn) {
                        hamburgerBtn.setAttribute('aria-expanded', willBeCollapsed ? 'false' : 'true');
                        hamburgerBtn.setAttribute('title', titleText);
                    }
                    if (bottomBtn) {
                        bottomBtn.setAttribute('aria-expanded', willBeCollapsed ? 'false' : 'true');
                        bottomBtn.setAttribute('title', titleText);
                        bottomBtn.setAttribute('aria-label', labelText);
                        var svg = bottomBtn.querySelector('svg');
                        if (svg) {
                            svg.style.transform = willBeCollapsed ? 'rotate(180deg)' : 'rotate(0deg)';
                        }
                        var labelSpan = bottomBtn.querySelector('.tf-nav-label');
                        if (labelSpan) {
                            labelSpan.textContent = willBeCollapsed ? 'Mở rộng' : 'Thu gọn';
                        }
                    }
                }
            },
            closeMobileSidebar: function () {
                var sidebar = document.querySelector('.tf-sidebar');
                if (sidebar) sidebar.classList.remove('open');
                var backdrop = document.querySelector('.tf-sidebar-backdrop');
                if (backdrop) backdrop.classList.remove('active');
                var hamburgerBtn = document.querySelector('.tf-sidebar-toggle');
                if (hamburgerBtn) hamburgerBtn.setAttribute('aria-expanded', 'false');
            },
            initSidebar: function () {
                var isMob = window.innerWidth < 1024;
                if (isMob) return;

                var isCollapsed = false;
                try {
                    isCollapsed = localStorage.getItem('tf_sidebar_collapsed') === 'true';
                } catch (e) { }

                var sidebar = document.querySelector('.tf-sidebar');
                var wrapper = document.querySelector('.tf-main-wrapper');
                var app = document.querySelector('.tf-app');
                var hamburgerBtn = document.querySelector('.tf-sidebar-toggle');
                var bottomBtn = document.querySelector('.tf-nav-collapse-btn');

                if (sidebar) {
                    if (isCollapsed) {
                        sidebar.classList.add('is-collapsed');
                        if (wrapper) wrapper.classList.add('is-collapsed');
                        if (app) app.classList.add('is-sidebar-collapsed');
                    } else {
                        sidebar.classList.remove('is-collapsed');
                        if (wrapper) wrapper.classList.remove('is-collapsed');
                        if (app) app.classList.remove('is-sidebar-collapsed');
                    }
                }

                var titleText = isCollapsed ? 'Mở rộng thanh menu (Ctrl+B)' : 'Thu gọn thanh menu (Ctrl+B)';
                var labelText = isCollapsed ? 'Mở rộng thanh menu' : 'Thu gọn thanh menu';

                if (hamburgerBtn) {
                    hamburgerBtn.setAttribute('aria-expanded', isCollapsed ? 'false' : 'true');
                    hamburgerBtn.setAttribute('title', titleText);
                }
                if (bottomBtn) {
                    bottomBtn.setAttribute('aria-expanded', isCollapsed ? 'false' : 'true');
                    bottomBtn.setAttribute('title', titleText);
                    bottomBtn.setAttribute('aria-label', labelText);
                    var svg = bottomBtn.querySelector('svg');
                    if (svg) {
                        svg.style.transform = isCollapsed ? 'rotate(180deg)' : 'rotate(0deg)';
                    }
                    var labelSpan = bottomBtn.querySelector('.tf-nav-label');
                    if (labelSpan) {
                        labelSpan.textContent = isCollapsed ? 'Mở rộng' : 'Thu gọn';
                    }
                }
            },
            setupEscapeHandler: function (dotNetHelper) {
                // Retained for backward compatibility
            },
            downloadPdfBase64: function (base64Data, fileName) {
                var link = document.createElement('a');
                link.download = fileName;
                link.href = 'data:application/pdf;base64,' + base64Data;
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            }
        };

        // Attach global keyboard shortcuts (Ctrl+B, Escape)
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' || e.keyCode === 27) {
                window.tradeflow.closeMobileSidebar();
            } else if ((e.ctrlKey || e.metaKey) && (e.key === 'b' || e.key === 'B')) {
                e.preventDefault();
                window.tradeflow.toggleSidebar();
            }
        });

        // Window resize handler
        window.addEventListener('resize', function () {
            if (window.innerWidth >= 1024) {
                window.tradeflow.closeMobileSidebar();
                window.tradeflow.initSidebar();
            }
        });

        // Event delegation for sidebar toggling, mobile drawer, and flyouts
        document.addEventListener('click', function (e) {
            var toggleBtn = e.target.closest('.tf-sidebar-toggle, .tf-nav-collapse-btn');
            if (toggleBtn) {
                window.tradeflow.toggleSidebar();
                return;
            }
            var closeBtn = e.target.closest('.tf-mobile-close-btn, .tf-sidebar-backdrop');
            if (closeBtn) {
                window.tradeflow.closeMobileSidebar();
                return;
            }
            var flyoutLink = e.target.closest('.tf-flyout-link');
            if (flyoutLink) {
                var flyout = flyoutLink.closest('.tf-nav-flyout');
                if (flyout) {
                    flyout.style.display = 'none';
                    setTimeout(function () {
                        flyout.style.display = '';
                    }, 350);
                }
            }
        });

        // Early and DOMContentLoaded initialization
        window.tradeflow.initSidebar();
        document.addEventListener('DOMContentLoaded', function () {
            window.tradeflow.initSidebar();
        });
    </script>
</body>

</html>

@code {
    [Inject] private TradeFlow.Application.Common.Interfaces.ICompanyBrandingService BrandingService { get; set; } = null!;

    private TradeFlow.Application.Common.Models.Settings.CompanyBrandingDto _branding = new()
    {
        CompanyName = "TỔNG KHO THIẾT BỊ VỆ SINH LACASA",
        LogoPath = "/uploads/branding/lacasa_logo.png",
        ShowLoadingScreen = true,
        ShowCompanyNameOnLoading = true,
        SpinnerColor = "#10b981",
        SpinnerOpacity = 0.8,
        SpinnerSpeed = "normal"
    };

    protected override void OnInitialized()
    {
        try
        {
            _branding = BrandingService.GetCachedBranding();
        }
        catch
        {
            // Fail-safe: use defaults if cache lookup fails
        }
    }

    private static string GetSpeedDuration(string? speed)
    {
        return (speed?.ToLowerInvariant()) switch
        {
            "slow" => "2.4s",
            "fast" => "0.85s",
            _ => "1.4s"
        };
    }
}
