    <script src="js/backup-restore.js"></script>

    <script>

        (function () {

            // Check if application UI or auth page is rendered in DOM

            function isAppContentReady() {

                return !!(

                    document.querySelector('.tf-app') ||

                    document.querySelector('.tf-content') ||

                    document.querySelector('.tf-login-page') ||

                    document.querySelector('.tf-login-card') ||

                    document.querySelector('.tf-login-redirect') ||

                    document.querySelector('.tf-sales-workspace') ||

                    document.querySelector('.container-fluid') ||

                    document.querySelector('.tf-page-header') ||

                    document.querySelector('#blazor-error-ui[style*="display: block"]')

                );

            }

            function dismissLoaderElement(loaderEl) {

                if (!loaderEl || loaderEl._tfDismissed) return;

                loaderEl._tfDismissed = true;

                window.__tfAppLoaded = true;

                // If app is already active in DOM, remove instantly without delay

                if (isAppContentReady()) {

                    loaderEl.style.display = 'none';

                    if (loaderEl.parentNode) {

                        loaderEl.parentNode.removeChild(loaderEl);

                    }

                    return;

                }

                // 1. Immediately disable pointer-events so user interactions are never blocked

                loaderEl.style.pointerEvents = 'none';

                loaderEl.classList.remove('is-active');

                loaderEl.classList.add('is-fading-out');

                // 2. Remove cleanly from DOM after smooth fade-out (250ms)

                setTimeout(function () {

                    if (loaderEl && loaderEl.parentNode) {

                        loaderEl.parentNode.removeChild(loaderEl);

                    }

                }, 280);

            }

            function dismissAllStartupLoaders() {

                var loaders = document.querySelectorAll('#tf-startup-loader, .tf-loading-overlay.is-active:not(.is-preview-mode)');

                for (var i = 0; i < loaders.length; i++) {

                    dismissLoaderElement(loaders[i]);

                }

            }

            // Expose globally for Blazor Interop and inline callers

            window.tfDismissStartupLoader = dismissAllStartupLoaders;

            function showStartupError() {

                var normalContent = document.getElementById('tf-startup-normal-content');

                var errorBox = document.getElementById('tf-startup-error-box');

                var loader = document.getElementById('tf-startup-loader');

                if (normalContent) normalContent.style.display = 'none';

                if (errorBox) {

                    errorBox.style.display = 'flex';

                }

                if (loader) {

                    loader.setAttribute('aria-busy', 'false');

                    loader.style.pointerEvents = 'auto';

                }

            }

            window.tfShowStartupError = showStartupError;

            // Ensure every loader found has a safety watchdog (max 1500ms)

            function armWatchdogs() {

                var loaders = document.querySelectorAll('#tf-startup-loader, .tf-loading-overlay.is-active:not(.is-preview-mode)');

                for (var i = 0; i < loaders.length; i++) {

                    var el = loaders[i];

                    if (!el._tfWatchdogArmed) {

                        el._tfWatchdogArmed = true;

                        (function (target) {

                            setTimeout(function () {

                                dismissLoaderElement(target);

                            }, 1500);

                        })(el);

                    }

                }

            }

            // Continuous mutation watcher for instant dismissal as soon as Blazor paints

            if (document.body) {

                var bodyObserver = new MutationObserver(function () {

                    armWatchdogs();

                    if (isAppContentReady()) {

                        requestAnimationFrame(function () {

                            dismissAllStartupLoaders();

                        });

                    }

                });

                bodyObserver.observe(document.body, { childList: true, subtree: true });

            }

            // DOM readiness checks

            if (document.readyState === 'complete' || document.readyState === 'interactive') {

                armWatchdogs();

                if (isAppContentReady()) {

                    dismissAllStartupLoaders();

                }

            } else {

                document.addEventListener('DOMContentLoaded', function () {

                    armWatchdogs();

                    if (isAppContentReady()) {

                        dismissAllStartupLoaders();

                    }

                });

            }

            // Blazor enhanced page load hook: always re-apply theme & dismiss startup loaders instantly

            if (window.Blazor && window.Blazor.addEventListener) {

                window.Blazor.addEventListener('enhancedload', function () {

                    if (window.tradeflow && window.tradeflow.applyTheme) {

                        window.tradeflow.applyTheme();

                    }

                    armWatchdogs();

                    dismissAllStartupLoaders();

                });

            }

            // Tab visibility / page restore hook (e.g. user returns to inactive tab)

            document.addEventListener('visibilitychange', function () {

                if (document.visibilityState === 'visible') {

                    if (isAppContentReady()) {

                        dismissAllStartupLoaders();

                    }

                }

            });

            window.addEventListener('pageshow', function () {

                if (isAppContentReady()) {

                    dismissAllStartupLoaders();

                }

            });

            // Watch specifically for real Blazor circuit crashes

            var blazorErrorUi = document.getElementById('blazor-error-ui');

            if (blazorErrorUi) {

                var errObserver = new MutationObserver(function () {

                    var display = window.getComputedStyle(blazorErrorUi).display;

                    if (display !== 'none') {

                        showStartupError();

                    }

                });

                errObserver.observe(blazorErrorUi, { attributes: true, attributeFilter: ['style', 'class'] });

            }

            // Initial immediate arming

            armWatchdogs();

        })();

        window.tradeflow = {

            isMobile: function () {

                return window.innerWidth < 1024;

            },

            getSidebarCollapsed: function () {

                try {

                    return localStorage.getItem('tf_sidebar_collapsed') === 'true';

                } catch (e) {

                    return false;

                }

            },

            setSidebarCollapsed: function (val) {

                try {

                    localStorage.setItem('tf_sidebar_collapsed', val ? 'true' : 'false');

                } catch (e) { }

                var sidebar = document.querySelector('.tf-sidebar');

                if (sidebar) {

                    sidebar.classList.add('is-animating-horizontal');

                    setTimeout(function () {

                        sidebar.classList.remove('is-animating-horizontal');

                    }, 260);

                }

            },

            toggleSidebar: function () {

                var isMob = window.innerWidth < 1024;

                var sidebar = document.querySelector('.tf-sidebar');

                var wrapper = document.querySelector('.tf-main-wrapper');

                var app = document.querySelector('.tf-app');

                var hamburgerBtn = document.querySelector('.tf-sidebar-toggle');

                var bottomBtn = document.querySelector('.tf-nav-collapse-btn');

                var backdrop = document.querySelector('.tf-sidebar-backdrop');

                if (isMob) {

                    if (!sidebar) return;

                    var isOpen = sidebar.classList.toggle('open');

                    if (backdrop) {

                        if (isOpen) {

                            backdrop.classList.add('active');

                        } else {

                            backdrop.classList.remove('active');

                        }

                    }

                    if (hamburgerBtn) {

                        hamburgerBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');

                    }

                } else {

                    if (!sidebar) return;

                    var isCurrentlyCollapsed = sidebar.classList.contains('is-collapsed');

                    var willBeCollapsed = !isCurrentlyCollapsed;

                    if (willBeCollapsed) {

                        sidebar.classList.add('is-collapsed');

                        if (wrapper) wrapper.classList.add('is-collapsed');

                        if (app) app.classList.add('is-sidebar-collapsed');

                    } else {

                        sidebar.classList.remove('is-collapsed');

                        if (wrapper) wrapper.classList.remove('is-collapsed');

                        if (app) app.classList.remove('is-sidebar-collapsed');

                    }

                    sidebar.classList.add('is-animating-horizontal');

                    setTimeout(function () {

                        sidebar.classList.remove('is-animating-horizontal');

                    }, 260);

                    try {

                        localStorage.setItem('tf_sidebar_collapsed', willBeCollapsed ? 'true' : 'false');

                    } catch (e) { }

                    var titleText = willBeCollapsed ? 'Mở rộng thanh menu (Ctrl+B)' : 'Thu gọn thanh menu (Ctrl+B)';

                    var labelText = willBeCollapsed ? 'Mở rộng thanh menu' : 'Thu gọn thanh menu';

                    if (hamburgerBtn) {

                        hamburgerBtn.setAttribute('aria-expanded', willBeCollapsed ? 'false' : 'true');

                        hamburgerBtn.setAttribute('title', titleText);

                    }

                    if (bottomBtn) {

                        bottomBtn.setAttribute('aria-expanded', willBeCollapsed ? 'false' : 'true');

                        bottomBtn.setAttribute('title', titleText);

                        bottomBtn.setAttribute('aria-label', labelText);

                        var svg = bottomBtn.querySelector('svg');

                        if (svg) {

                            svg.style.transform = willBeCollapsed ? 'rotate(180deg)' : 'rotate(0deg)';

                        }

                        var labelSpan = bottomBtn.querySelector('.tf-nav-label');

                        if (labelSpan) {

                            labelSpan.textContent = willBeCollapsed ? 'Mở rộng' : 'Thu gọn';

                        }

                    }

                }

            },

            closeMobileSidebar: function () {

                var sidebar = document.querySelector('.tf-sidebar');

                if (sidebar) sidebar.classList.remove('open');

                var backdrop = document.querySelector('.tf-sidebar-backdrop');

                if (backdrop) backdrop.classList.remove('active');

                var hamburgerBtn = document.querySelector('.tf-sidebar-toggle');

                if (hamburgerBtn) hamburgerBtn.setAttribute('aria-expanded', 'false');

            },

            initSidebar: function () {

                var isMob = window.innerWidth < 1024;

                if (isMob) return;

                var isCollapsed = false;

                try {

                    isCollapsed = localStorage.getItem('tf_sidebar_collapsed') === 'true';

                } catch (e) { }

                var sidebar = document.querySelector('.tf-sidebar');

                var wrapper = document.querySelector('.tf-main-wrapper');

                var app = document.querySelector('.tf-app');

                var hamburgerBtn = document.querySelector('.tf-sidebar-toggle');

                var bottomBtn = document.querySelector('.tf-nav-collapse-btn');

                if (sidebar) {

                    if (isCollapsed) {

                        sidebar.classList.add('is-collapsed');

                        if (wrapper) wrapper.classList.add('is-collapsed');

                        if (app) app.classList.add('is-sidebar-collapsed');

                    } else {

                        sidebar.classList.remove('is-collapsed');

                        if (wrapper) wrapper.classList.remove('is-collapsed');

                        if (app) app.classList.remove('is-sidebar-collapsed');

                    }

                }

                var titleText = isCollapsed ? 'Mở rộng thanh menu (Ctrl+B)' : 'Thu gọn thanh menu (Ctrl+B)';

                var labelText = isCollapsed ? 'Mở rộng thanh menu' : 'Thu gọn thanh menu';

                if (hamburgerBtn) {

                    hamburgerBtn.setAttribute('aria-expanded', isCollapsed ? 'false' : 'true');

                    hamburgerBtn.setAttribute('title', titleText);

                }

                if (bottomBtn) {

                    bottomBtn.setAttribute('aria-expanded', isCollapsed ? 'false' : 'true');

                    bottomBtn.setAttribute('title', titleText);

                    bottomBtn.setAttribute('aria-label', labelText);

                    var svg = bottomBtn.querySelector('svg');

                    if (svg) {

