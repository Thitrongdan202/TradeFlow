            _datePickers: {},
            _getContainingBlock: function (element) {
                var currentNode = element.parentElement;
                while (currentNode && currentNode !== document.body && currentNode !== document.documentElement) {
                    var css = window.getComputedStyle(currentNode);
                    if (
                        css.transform !== 'none' ||
                        css.perspective !== 'none' ||
                        css.filter !== 'none' ||
                        (css.backdropFilter && css.backdropFilter !== 'none') ||
                        (css.contain && (css.contain.indexOf('paint') !== -1 || css.contain.indexOf('layout') !== -1 || css.contain.indexOf('strict') !== -1 || css.contain.indexOf('content') !== -1)) ||
                        (css.willChange && (css.willChange.indexOf('transform') !== -1 || css.willChange.indexOf('perspective') !== -1 || css.willChange.indexOf('filter') !== -1))
                    ) {
                        return currentNode;
                    }
                    currentNode = currentNode.parentElement;
                }
                return null;
