<AuthorizeView>
    <Authorized>
        <div class="tf-top-user">
            <a href="/Account/Manage" class="tf-top-user-link">
                <span class="bi bi-person-circle me-1"></span>
                @context.User.Identity?.Name
            </a>
            <form action="/Account/Logout" method="post" class="d-inline">
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="/" />
                <button type="submit" class="btn btn-sm btn-outline-secondary ms-2">
                    <span class="bi bi-box-arrow-right me-1"></span>
                    Đăng xuất
                </button>
            </form>
        </div>
    </Authorized>
    <NotAuthorized>
        <a href="/Account/Login" class="btn btn-sm btn-primary">
            <span class="bi bi-box-arrow-in-right me-1"></span>
            Đăng nhập
        </a>
    </NotAuthorized>
</AuthorizeView>
