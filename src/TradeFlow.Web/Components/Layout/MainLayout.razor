@inherits LayoutComponentBase
@implements IDisposable
@inject IJSRuntime JSRuntime
@inject NavigationManager Nav
@inject TradeFlow.Application.Common.Interfaces.ISupportService SupportService

<div class="tf-app @(_sidebarCollapsed ? "is-sidebar-collapsed" : "")">
    <aside class="tf-sidebar no-print @(_sidebarOpen ? "open" : "") @(_sidebarCollapsed ? "is-collapsed" : "")">
        <NavMenu IsCollapsed="@_sidebarCollapsed" OnToggleCollapse="ToggleSidebarCollapse" OnCloseMobile="CloseSidebar" />
    </aside>

    @* Mobile overlay *@
    <div class="tf-sidebar-backdrop no-print @(_sidebarOpen ? "open" : "")" @onclick="CloseSidebar"></div>

    <div class="tf-main-wrapper @(_sidebarCollapsed ? "is-collapsed" : "")">
        <header class="tf-topbar no-print">
            <div class="tf-topbar-left">
                @* Sidebar toggle (Desktop: collapses/expands, Mobile: opens/closes drawer) *@
                <button class="tf-topbar-btn tf-sidebar-toggle" @onclick="HandleToggleClick" title="@(_sidebarCollapsed ? "Mở rộng thanh menu (Ctrl+B)" : "Thu gọn thanh menu (Ctrl+B)")" aria-label="Menu" aria-expanded="@(!_sidebarCollapsed)">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="3" y1="6" x2="21" y2="6"/>
                        <line x1="3" y1="12" x2="21" y2="12"/>
                        <line x1="3" y1="18" x2="21" y2="18"/>
                    </svg>
                </button>
            </div>

            @* Right-side topbar actions *@
            <div class="tf-topbar-actions">
                @* Live System Time Pill *@
                <div class="tf-topbar-clock-pill" title="Thời gian hệ thống (GMT+7)">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    <span>@_currentTimeFormatted</span>
                </div>

                @* Support / Audit Hub Button (Role-dependent replacement for warehouse pill) *@
                @if (_isAdminUser)
                {
                    <AdminAuditSupportMenu OnOpenSupportModal='() => _supportModal?.Open("manage")'
                                           OnOpenSpecificTicket='(id) => _supportModal?.Open("detail", id)' />
                }
                else if (_isManagerUser)
                {
                    <button type="button"
                            class="tf-topbar-support-pill"
                            title="Trung tâm Hỗ trợ &amp; Tiếp nhận báo cáo"
                            @onclick='() => _supportModal?.Open("manage")'>
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 18v-6a9 9 0 0 1 18 0v6"></path>
                            <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path>
                        </svg>
                        <span>Hỗ trợ</span>
                        @if (_supportBadgeCount > 0)
                        {
                            <span class="tf-audit-badge-count">@_supportBadgeCount</span>
                        }
                    </button>
                }
                else
                {
                    <button type="button"
                            class="tf-topbar-support-pill"
                            title="Gửi báo cáo lỗi &amp; Hỗ trợ hệ thống"
                            @onclick='() => _supportModal?.Open("create")'>
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 18v-6a9 9 0 0 1 18 0v6"></path>
                            <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path>
                        </svg>
                        <span>Hỗ trợ</span>
                        @if (_supportBadgeCount > 0)
                        {
                            <span class="tf-audit-badge-count">@_supportBadgeCount</span>
                        }
                    </button>
                }

                @* Quick Action: Audit History *@
                <a href="/cai-dat/nhat-ky-he-thong" class="tf-topbar-btn" title="Nhật ký hệ thống &amp; Kiểm toán" aria-label="Nhật ký hệ thống">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/>
                        <polyline points="12 6 12 12 16 14"/>
                    </svg>
                </a>

                @* Quick Action: Interactive Notifications Menu *@
                <NotificationMenu OnOpenSupport='(ticketId) => _supportModal?.Open("detail", ticketId)' />

                <div class="tf-topbar-divider"></div>

                @* Premium Animated Light/Dark Mode Switch *@
                <ThemeToggle />

                @* User menu *@
                <UserMenu />
            </div>
        </header>

        <main class="tf-content">
            <ErrorBoundary @ref="_contentErrorBoundary">
                <ChildContent>
                    <div class="tf-page-transition-wrap" @key="@Nav.Uri">
                        @Body
                    </div>
                </ChildContent>
                <ErrorContent Context="ex">
                    <div class="tf-page-error-container" style="display: flex; justify-content: center; align-items: center; min-height: 400px; padding: 2rem;">
                        <div class="tf-card text-center" style="max-width: 520px; width: 100%; padding: 2.5rem 2rem; border-radius: 12px; box-shadow: var(--tf-shadow-md); border: 1px solid var(--tf-border); background: var(--tf-surface, #ffffff);">
                            <div style="width: 56px; height: 56px; border-radius: 50%; background: rgba(239, 68, 68, 0.1); color: #ef4444; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.25rem;">
                                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <line x1="12" y1="8" x2="12" y2="12"></line>
                                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                                </svg>
                            </div>
                            <h3 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 0.5rem; color: var(--tf-text-primary, #1e293b);">Đã xảy ra sự cố khi tải trang này</h3>
                            <p style="font-size: 0.875rem; color: var(--tf-text-muted, #64748b); margin-bottom: 1.5rem; line-height: 1.5;">Hệ thống đã ghi nhận sự cố. Toàn bộ thanh điều hướng và menu vẫn hoạt động bình thường. Bạn có thể nhấn nút "Thử lại" bên dưới hoặc quay về Bảng điều khiển.</p>
                            <div style="display: flex; justify-content: center; gap: 0.75rem;">
                                <button type="button" class="btn btn-primary" @onclick="() => _contentErrorBoundary?.Recover()">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;">
                                        <polyline points="23 4 23 10 17 10"></polyline>
                                        <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
                                    </svg>
                                    Thử lại
                                </button>
                                <a href="/" class="btn btn-outline-secondary">
                                    Về bảng điều khiển
                                </a>
                            </div>
                        </div>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </main>
    </div>
</div>

<SupportCenterModal @ref="_supportModal" />

<GlobalLoadingScreen />

<div id="blazor-error-ui" class="no-print" data-nosnippet>
    Đã xảy ra lỗi không mong đợi.
    <a href="." class="reload">Tải lại</a>
    <span class="dismiss">✕</span>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateCascade { get; set; }

    private bool _sidebarOpen;
    private bool _sidebarCollapsed;
    private DotNetObjectReference<MainLayout>? _dotNetRef;
    private ErrorBoundary? _contentErrorBoundary;
    private string _currentTimeFormatted = DateTime.Now.ToString("HH:mm • dd/MM/yyyy");
    private System.Threading.Timer? _clockTimer;

    private SupportCenterModal? _supportModal;
    private int _supportBadgeCount = 0;
    private bool _isAdminUser = false;
    private bool _isManagerUser = false;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        _clockTimer = new System.Threading.Timer(_ =>
        {
            _currentTimeFormatted = DateTime.Now.ToString("HH:mm • dd/MM/yyyy");
            InvokeAsync(StateHasChanged);
        }, null, 10000, 30000);
    }

    protected override async Task OnParametersSetAsync()
    {
        await CheckMandatoryPasswordChangeAsync();

        if (AuthStateCascade != null)
        {
            var authState = await AuthStateCascade;
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                _isAdminUser = user.IsInRole("Administrator") || user.Identity.Name?.Equals("admin", StringComparison.OrdinalIgnoreCase) == true;
                _isManagerUser = user.IsInRole("Manager");
                try
                {
                    _supportBadgeCount = await SupportService.GetBadgeCountAsync(user);
                }
                catch { }
            }
            else
            {
                _isAdminUser = false;
                _isManagerUser = false;
                _supportBadgeCount = 0;

                var relative = Nav.ToBaseRelativePath(Nav.Uri);
                var pathOnly = relative.Split('?')[0].TrimStart('/');
                if (!pathOnly.StartsWith("account/", StringComparison.OrdinalIgnoreCase) &&
                    !pathOnly.StartsWith("error", StringComparison.OrdinalIgnoreCase) &&
                    !pathOnly.StartsWith("loi", StringComparison.OrdinalIgnoreCase))
                {
                    var returnUrl = string.IsNullOrWhiteSpace(relative) || relative == "/"
                        ? ""
                        : $"?returnUrl={Uri.EscapeDataString(relative)}";
                    Nav.NavigateTo($"Account/Login{returnUrl}", forceLoad: true);
                }
            }
        }
    }

    private async Task CheckMandatoryPasswordChangeAsync()
    {
        if (AuthStateCascade != null)
        {
            var authState = await AuthStateCascade;
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                var mustChange = user.FindFirst("MustChangePassword")?.Value;
                if (string.Equals(mustChange, "true", StringComparison.OrdinalIgnoreCase))
                {
                    var relative = Nav.ToBaseRelativePath(Nav.Uri).ToLowerInvariant();
                    if (!relative.StartsWith("account/changepassword") && !relative.StartsWith("account/logout"))
                    {
                        Nav.NavigateTo("Account/ChangePassword", forceLoad: true);
                    }
                }
            }
        }
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _contentErrorBoundary?.Recover();
        try
        {
            await JSRuntime.InvokeVoidAsync("TradeFlowMotion.unlockScroll", true);
        }
        catch { }
    }

    private async Task HandleToggleClick()
    {
        bool isMobile = await CheckIsMobileAsync();
        if (isMobile)
        {
            _sidebarOpen = !_sidebarOpen;
        }
        else
        {
            await ToggleSidebarCollapse();
        }
    }

    private async Task ToggleSidebarCollapse()
    {
        _sidebarCollapsed = !_sidebarCollapsed;
        try
        {
            await JSRuntime.InvokeVoidAsync("tradeflow.setSidebarCollapsed", _sidebarCollapsed);
        }
        catch { }
    }

    private void CloseSidebar()
    {
        _sidebarOpen = false;
    }

    [JSInvokable]
    public void OnEscapePressed()
    {
        if (_sidebarOpen)
        {
            _sidebarOpen = false;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task ToggleSidebarFromKeyboard()
    {
        await HandleToggleClick();
        StateHasChanged();
    }

    [JSInvokable]
    public void OnWindowResize(bool isMobile)
    {
        if (!isMobile && _sidebarOpen)
        {
            _sidebarOpen = false;
            StateHasChanged();
        }
    }

    private async Task<bool> CheckIsMobileAsync()
    {
        try
        {
            return await JSRuntime.InvokeAsync<bool>("tradeflow.isMobile");
        }
        catch
        {
            return false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("tfDismissStartupLoader");
            }
            catch { }

            try
            {
                await JSRuntime.InvokeVoidAsync("tradeflow.initSidebar");
                _dotNetRef = DotNetObjectReference.Create(this);
                await JSRuntime.InvokeVoidAsync("tradeflow.setupEscapeHandler", _dotNetRef);
                bool isMobile = await JSRuntime.InvokeAsync<bool>("tradeflow.isMobile");
                if (!isMobile)
                {
                    bool savedCollapsed = await JSRuntime.InvokeAsync<bool>("tradeflow.getSidebarCollapsed");
                    if (savedCollapsed != _sidebarCollapsed)
                    {
                        _sidebarCollapsed = savedCollapsed;
                        StateHasChanged();
                    }
                }
            }
            catch { }
        }
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        _clockTimer?.Dispose();
        _dotNetRef?.Dispose();
    }
}
