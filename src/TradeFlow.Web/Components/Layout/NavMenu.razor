@rendermode InteractiveServer
@implements IDisposable
@inject NavigationManager Nav

<nav class="tf-sidebar-inner" style="display:flex; flex-direction:column; height:100%;">
    @* Brand Header — Circular Badge & Modern Identity *@
    <a href="/" class="tf-brand">
        <div class="tf-brand-logo">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
            </svg>
        </div>
        <div class="tf-brand-text">
            <span class="tf-brand-name">TradeFlow</span>
            <span class="tf-brand-tagline">ERP &amp; Bán hàng</span>
        </div>
    </a>

    @* Navigation Menu Items *@
    <div class="tf-nav-scroll">

        @* 1. TỔNG QUAN (DASHBOARD) *@
        <div class="tf-nav-item">
            <NavLink class="tf-nav-link" href="" Match="NavLinkMatch.All" ActiveClass="active">
                <span class="tf-nav-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="7" height="7" rx="1.5"/>
                        <rect x="14" y="3" width="7" height="7" rx="1.5"/>
                        <rect x="14" y="14" width="7" height="7" rx="1.5"/>
                        <rect x="3" y="14" width="7" height="7" rx="1.5"/>
                    </svg>
                </span>
                <span class="tf-nav-label">Tổng quan</span>
            </NavLink>
        </div>

        @* 2. BÁN HÀNG *@
        <div class="tf-nav-item @(IsSectionActive("ban-hang") ? "is-active" : "")">
            <button type="button" class="tf-nav-link @(IsSectionActive("ban-hang") ? "active" : "")" @onclick="ToggleSales">
                <span class="tf-nav-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="9" cy="21" r="1"/>
                        <circle cx="20" cy="21" r="1"/>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                    </svg>
                </span>
                <span class="tf-nav-label">Bán hàng</span>
                <span class="tf-nav-chevron-wrap">
                    <svg class="tf-nav-chevron @(IsSalesOpen ? "expanded" : "")" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="9 18 15 12 9 6"/>
                    </svg>
                </span>
            </button>

            @* Desktop Fly-out Submenu *@
            <div class="tf-nav-flyout">
                <div class="tf-nav-flyout-header">Bán hàng</div>
                <div class="tf-nav-flyout-body">
                    <AuthorizeView Policy="Permission:Quotations:View">
                        <NavLink class="tf-flyout-link" href="/ban-hang/bao-gia" Match="NavLinkMatch.All" ActiveClass="active">
                            <span class="tf-flyout-dot"></span>
                            <span>Báo giá</span>
                        </NavLink>
                    </AuthorizeView>
                    <NavLink class="tf-flyout-link" href="/ban-hang/don-ban-hang" Match="NavLinkMatch.All" ActiveClass="active">
                        <span class="tf-flyout-dot"></span>
                        <span>Đơn bán hàng</span>
                    </NavLink>
                </div>
            </div>

            @* Mobile / Click Accordion Submenu *@
            <div class="tf-nav-sub @(IsSalesOpen ? "expanded" : "")">
                <AuthorizeView Policy="Permission:Quotations:View">
                    <div class="tf-nav-sub-item">
                        <NavLink class="tf-nav-sub-link" href="/ban-hang/bao-gia" Match="NavLinkMatch.All" ActiveClass="active">
                            <span class="tf-nav-sub-dot"></span>Báo giá
                        </NavLink>
                    </div>
                </AuthorizeView>
                <div class="tf-nav-sub-item">
                    <NavLink class="tf-nav-sub-link" href="/ban-hang/don-ban-hang" Match="NavLinkMatch.All" ActiveClass="active">
                        <span class="tf-nav-sub-dot"></span>Đơn bán hàng
                    </NavLink>
                </div>
            </div>
        </div>

        @* 3. HÓA ĐƠN *@
