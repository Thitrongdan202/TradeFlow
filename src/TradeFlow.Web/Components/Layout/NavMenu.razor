@rendermode InteractiveServer
@implements IDisposable
@inject NavigationManager Nav

<nav class="tf-sidebar-inner">
    @* Brand *@
    <a href="/" class="tf-brand">
        <div class="tf-brand-logo">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M3 3h7v7H3V3z" fill="white"/>
                <path d="M14 3h7v7h-7V3z" fill="white" opacity="0.6"/>
                <path d="M3 14h7v7H3v-7z" fill="white" opacity="0.6"/>
                <path d="M14 14h7v7h-7v-7z" fill="white"/>
            </svg>
        </div>
        <div class="tf-brand-text">
            <span class="tf-brand-name">TradeFlow</span>
            <span class="tf-brand-tagline">Quản lý thương mại</span>
        </div>
    </a>

    @* Nav items *@
    <div class="tf-nav-scroll">

        @* ---- TỔNG QUAN ---- *@
        <div class="tf-nav-section">
            <div class="tf-nav-item">
                <NavLink class="tf-nav-link" href="" Match="NavLinkMatch.All" ActiveClass="tf-nav-active">
                    <span class="tf-nav-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
                            <rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
                        </svg>
                    </span>
                    <span class="tf-nav-label">Tổng quan</span>
                </NavLink>
            </div>
        </div>

        @* ---- DANH MỤC ---- *@
        <div class="tf-nav-section">
            <div class="tf-nav-section-label">Danh mục</div>

            <div class="tf-nav-item">
                <button type="button" class="tf-nav-link" @onclick="ToggleCatalog">
                    <span class="tf-nav-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="8" y1="6" x2="21" y2="6"/>
                            <line x1="8" y1="12" x2="21" y2="12"/>
                            <line x1="8" y1="18" x2="21" y2="18"/>
                            <line x1="3" y1="6" x2="3.01" y2="6"/>
                            <line x1="3" y1="12" x2="3.01" y2="12"/>
                            <line x1="3" y1="18" x2="3.01" y2="18"/>
                        </svg>
                    </span>
                    <span class="tf-nav-label">Danh mục</span>
                    <svg class="tf-nav-chevron @(IsCatalogOpen ? "expanded" : "")" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"/>
                    </svg>
                </button>
                <div class="tf-nav-sub @(IsCatalogOpen ? "expanded" : "")">
                    <AuthorizeView Policy="Permission:Products:View">
                        <div class="tf-nav-sub-item">
                            <NavLink class="tf-nav-sub-link" href="/danh-muc/san-pham" ActiveClass="active">
                                <span class="tf-nav-sub-dot"></span>Sản phẩm
                            </NavLink>
                        </div>
                    </AuthorizeView>
                    <AuthorizeView Policy="Permission:ProductCategories:View">
                        <div class="tf-nav-sub-item">
                            <NavLink class="tf-nav-sub-link" href="/danh-muc/danh-muc-san-pham" ActiveClass="active">
                                <span class="tf-nav-sub-dot"></span>Danh mục sản phẩm
                            </NavLink>
                        </div>
                    </AuthorizeView>
                    <AuthorizeView Policy="Permission:UnitOfMeasures:View">
                        <div class="tf-nav-sub-item">
                            <NavLink class="tf-nav-sub-link" href="/danh-muc/don-vi-tinh" ActiveClass="active">
                                <span class="tf-nav-sub-dot"></span>Đơn vị tính
                            </NavLink>
                        </div>
                    </AuthorizeView>
                    <AuthorizeView Policy="Permission:Currencies:View">
                        <div class="tf-nav-sub-item">
                            <NavLink class="tf-nav-sub-link" href="/danh-muc/loai-tien" ActiveClass="active">
                                <span class="tf-nav-sub-dot"></span>Loại tiền
                            </NavLink>
                        </div>
                    </AuthorizeView>
                </div>
            </div>
        </div>

        @* ---- ĐỐI TÁC ---- *@
        <div class="tf-nav-section">
            <div class="tf-nav-section-label">Đối tác</div>

            <div class="tf-nav-item">
                <button type="button" class="tf-nav-link" @onclick="TogglePartners">
                    <span class="tf-nav-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
                            <circle cx="9" cy="7" r="4"/>
                            <path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/>
                        </svg>
                    </span>
                    <span class="tf-nav-label">Đối tác</span>
                    <svg class="tf-nav-chevron @(IsPartnersOpen ? "expanded" : "")" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"/>
                    </svg>
                </button>
                <div class="tf-nav-sub @(IsPartnersOpen ? "expanded" : "")">
                    <AuthorizeView Policy="Permission:Customers:View">
                        <div class="tf-nav-sub-item">
                            <NavLink class="tf-nav-sub-link" href="/doi-tac/khach-hang" ActiveClass="active">
                                <span class="tf-nav-sub-dot"></span>Khách hàng
                            </NavLink>
                        </div>
                    </AuthorizeView>
                    <AuthorizeView Policy="Permission:Suppliers:View">
                        <div class="tf-nav-sub-item">
                            <NavLink class="tf-nav-sub-link" href="/doi-tac/nha-cung-cap" ActiveClass="active">
                                <span class="tf-nav-sub-dot"></span>Nhà cung cấp
                            </NavLink>
                        </div>
                    </AuthorizeView>
                </div>
            </div>
        </div>

        @* ---- KHO HÀNG ---- *@
        <div class="tf-nav-section">
            <div class="tf-nav-section-label">Kho hàng</div>

            <div class="tf-nav-item">
                <button type="button" class="tf-nav-link" @onclick="ToggleWarehouse">
                    <span class="tf-nav-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 2H2v5l10 5 10-5V2z"/><path d="M12 22V12"/><path d="M2 7v15h20V7"/>
                        </svg>
                    </span>
                    <span class="tf-nav-label">Kho hàng</span>
                    <svg class="tf-nav-chevron @(IsWarehouseOpen ? "expanded" : "")" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"/>
                    </svg>
                </button>
                <div class="tf-nav-sub @(IsWarehouseOpen ? "expanded" : "")">
                    <AuthorizeView Policy="Permission:Warehouses:View">
                        <div class="tf-nav-sub-item">
                            <NavLink class="tf-nav-sub-link" href="/kho-hang" ActiveClass="active">
                                <span class="tf-nav-sub-dot"></span>Kho hàng
                            </NavLink>
                        </div>
                    </AuthorizeView>
                </div>
            </div>
        </div>

        @* ---- BẢNG GIÁ (Phase 4) ---- *@
        <div class="tf-nav-section">
            <div class="tf-nav-section-label">Bảng giá</div>

            <div class="tf-nav-item">
                <button type="button" class="tf-nav-link" @onclick="TogglePricing">
                    <span class="tf-nav-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 2v20M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/>
                        </svg>
                    </span>
                    <span class="tf-nav-label">Bảng giá</span>
                    <svg class="tf-nav-chevron @(IsPricingOpen ? "expanded" : "")" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"/>
                    </svg>
                </button>
                <div class="tf-nav-sub @(IsPricingOpen ? "expanded" : "")">
                    <AuthorizeView Policy="Permission:PriceLists:View">
                        <div class="tf-nav-sub-item">
                            <NavLink class="tf-nav-sub-link" href="/bang-gia" Match="NavLinkMatch.All" ActiveClass="active">
                                <span class="tf-nav-sub-dot"></span>Danh sách bảng giá
                            </NavLink>
                        </div>
                    </AuthorizeView>
                    <AuthorizeView Policy="Permission:PriceLists:Create">
                        <div class="tf-nav-sub-item">
                            <NavLink class="tf-nav-sub-link" href="/bang-gia/nhap-excel" ActiveClass="active">
                                <span class="tf-nav-sub-dot"></span>Nhập từ Excel
                            </NavLink>
                        </div>
                    </AuthorizeView>
                    <AuthorizeView Policy="Permission:PriceLists:View">
                        <div class="tf-nav-sub-item">
                            <NavLink class="tf-nav-sub-link" href="/bang-gia/so-sanh" ActiveClass="active">
                                <span class="tf-nav-sub-dot"></span>So sánh bảng giá
                            </NavLink>
                        </div>
                        <div class="tf-nav-sub-item">
                            <NavLink class="tf-nav-sub-link" href="/bang-gia/lich-su" ActiveClass="active">
                                <span class="tf-nav-sub-dot"></span>Lịch sử giá SP
                            </NavLink>
                        </div>
                    </AuthorizeView>
                </div>
            </div>
        </div>


        @* ---- BÁN HÀNG (Phase 5) ---- *@
        <div class="tf-nav-section">
            <div class="tf-nav-section-label">Bán hàng</div>

            <div class="tf-nav-item">
                <button type="button" class="tf-nav-link" @onclick="ToggleSales">
                    <span class="tf-nav-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle>
                            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                        </svg>
                    </span>
                    <span class="tf-nav-label">Bán hàng</span>
                    <svg class="tf-nav-chevron @(IsSalesOpen ? "expanded" : "")" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                </button>
                <div class="tf-nav-sub @(IsSalesOpen ? "expanded" : "")">
                    <div class="tf-nav-sub-item">
                        <NavLink class="tf-nav-sub-link" href="/ban-hang/don-ban-hang" Match="NavLinkMatch.All" ActiveClass="active">
                            <span class="tf-nav-sub-dot"></span>Đơn bán hàng
                        </NavLink>
                    </div>
                </div>
            </div>
            
            <div class="tf-nav-item">
                <button type="button" class="tf-nav-link" @onclick="ToggleInvoice">
                    <span class="tf-nav-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                            <polyline points="10 9 9 9 8 9"></polyline>
                        </svg>
                    </span>
                    <span class="tf-nav-label">Hóa đơn</span>
                    <svg class="tf-nav-chevron @(IsInvoiceOpen ? "expanded" : "")" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                </button>
                <div class="tf-nav-sub @(IsInvoiceOpen ? "expanded" : "")">
                    <div class="tf-nav-sub-item">
                        <NavLink class="tf-nav-sub-link" href="/hoa-don" Match="NavLinkMatch.All" ActiveClass="active">
                            <span class="tf-nav-sub-dot"></span>Danh sách hóa đơn
                        </NavLink>
                    </div>
                </div>
            </div>
        </div>

        @* ---- CÀI ĐẶT ---- *@
        <div class="tf-nav-section">
            <div class="tf-nav-section-label">Hệ thống</div>

            <div class="tf-nav-item">
                <NavLink class="tf-nav-link" href="/cai-dat" Match="NavLinkMatch.All" ActiveClass="tf-nav-active">
                    <span class="tf-nav-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="3"/>
                            <path d="M19.07 4.93a10 10 0 010 14.14M4.93 4.93a10 10 0 000 14.14"/>
                        </svg>
                    </span>
                    <span class="tf-nav-label">Cài đặt</span>
                </NavLink>
            </div>
        </div>

    </div>
</nav>

@code {
    

    private bool IsCatalogOpen { get; set; }
    private bool IsPartnersOpen { get; set; }
    private bool IsWarehouseOpen { get; set; }
    private bool IsPricingOpen { get; set; }
    private bool IsSalesOpen { get; set; }
    private bool IsInvoiceOpen { get; set; }

    private string _currentUrl = "";

    protected override void OnInitialized()
    {
        _currentUrl = Nav.ToBaseRelativePath(Nav.Uri);
        AutoExpandSection(_currentUrl);
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _currentUrl = Nav.ToBaseRelativePath(e.Location);
        AutoExpandSection(_currentUrl);
        StateHasChanged();
    }

    private void AutoExpandSection(string url)
    {
        if (url.StartsWith("danh-muc")) IsCatalogOpen = true;
        if (url.StartsWith("doi-tac")) IsPartnersOpen = true;
        if (url.StartsWith("kho")) IsWarehouseOpen = true;
        if (url.StartsWith("bang-gia")) IsPricingOpen = true;
        if (url.StartsWith("ban-hang")) IsSalesOpen = true;
        if (url.StartsWith("hoa-don")) IsInvoiceOpen = true;
    }

    private void ToggleCatalog() => IsCatalogOpen = !IsCatalogOpen;
    private void TogglePartners() => IsPartnersOpen = !IsPartnersOpen;
    private void ToggleWarehouse() => IsWarehouseOpen = !IsWarehouseOpen;
    private void TogglePricing() => IsPricingOpen = !IsPricingOpen;
    private void ToggleSales() => IsSalesOpen = !IsSalesOpen;
    private void ToggleInvoice() => IsInvoiceOpen = !IsInvoiceOpen;

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}