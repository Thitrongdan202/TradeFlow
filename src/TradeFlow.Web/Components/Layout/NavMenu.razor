@implements IDisposable
@inject NavigationManager Nav

<nav class="tf-sidebar-inner">
    @* Brand *@
    <a href="/" class="tf-brand" @onclick="OnNavClick" @onclick:preventDefault="false">
        <div class="tf-brand-logo">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M3 3h7v7H3V3z" fill="white"/>
                <path d="M14 3h7v7h-7V3z" fill="white" opacity="0.6"/>
                <path d="M3 14h7v7H3v-7z" fill="white" opacity="0.6"/>
                <path d="M14 14h7v7h-7v-7z" fill="white"/>
            </svg>
        </div>
        <div class="tf-brand-text">
            <span class="tf-brand-name">TradeFlow</span>
            <span class="tf-brand-tagline">Quản lý thương mại</span>
        </div>
    </a>

    @* Nav items *@
    <div class="tf-nav-scroll">

        @* ---- TỔNG QUAN ---- *@
        <div class="tf-nav-section">
            <div class="tf-nav-item">
                <NavLink class="tf-nav-link" href="" Match="NavLinkMatch.All" ActiveClass="tf-nav-active" @onclick="OnNavClick">
                    <span class="tf-nav-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
                            <rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
                        </svg>
                    </span>
                    <span class="tf-nav-label">Tổng quan</span>
                </NavLink>
            </div>
        </div>

        @* ---- BÁN HÀNG ---- *@
        <div class="tf-nav-section">
            <div class="tf-nav-section-label">Bán hàng</div>

            <div class="tf-nav-item">
                <button class="tf-nav-link @(IsSalesOpen ? "tf-nav-active" : "")" @onclick="ToggleSales">
                    <span class="tf-nav-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
                            <line x1="3" y1="6" x2="21" y2="6"/>
                            <path d="M16 10a4 4 0 01-8 0"/>
                        </svg>
                    </span>
                    <span class="tf-nav-label">Bán hàng</span>
                    <svg class="tf-nav-chevron @(IsSalesOpen ? "expanded" : "")" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"/>
                    </svg>
                </button>
                <div class="tf-nav-sub @(IsSalesOpen ? "expanded" : "")">
                    <div class="tf-nav-sub-item">
                        <NavLink class="tf-nav-sub-link" href="ban-hang/bao-gia" ActiveClass="active" @onclick="OnNavClick">
                            <span class="tf-nav-sub-dot"></span>Báo giá
                        </NavLink>
                    </div>
                    <div class="tf-nav-sub-item">
                        <NavLink class="tf-nav-sub-link" href="ban-hang/don-hang" ActiveClass="active" @onclick="OnNavClick">
                            <span class="tf-nav-sub-dot"></span>Đơn bán hàng
                        </NavLink>
                    </div>
                    <div class="tf-nav-sub-item">
                        <NavLink class="tf-nav-sub-link" href="ban-hang/hoa-don" ActiveClass="active" @onclick="OnNavClick">
                            <span class="tf-nav-sub-dot"></span>Hóa đơn
                        </NavLink>
                    </div>
                </div>
            </div>
        </div>

        @* ---- MUA HÀNG ---- *@
        <div class="tf-nav-section">
            <div class="tf-nav-section-label">Mua hàng</div>

            <div class="tf-nav-item">
                <button class="tf-nav-link @(IsPurchaseOpen ? "tf-nav-active" : "")" @onclick="TogglePurchase">
                    <span class="tf-nav-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                            <path d="M1 1h4l2.68 13.39a2 2 0 001.98 1.61h9.72a2 2 0 001.98-1.61L23 6H6"/>
                        </svg>
                    </span>
                    <span class="tf-nav-label">Mua hàng</span>
                    <svg class="tf-nav-chevron @(IsPurchaseOpen ? "expanded" : "")" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"/>
                    </svg>
                </button>
                <div class="tf-nav-sub @(IsPurchaseOpen ? "expanded" : "")">
                    <div class="tf-nav-sub-item">
                        <NavLink class="tf-nav-sub-link" href="mua-hang/don-hang" ActiveClass="active" @onclick="OnNavClick">
                            <span class="tf-nav-sub-dot"></span>Đơn mua hàng
                        </NavLink>
                    </div>
                    <div class="tf-nav-sub-item">
                        <NavLink class="tf-nav-sub-link" href="mua-hang/de-nghi-mua" ActiveClass="active" @onclick="OnNavClick">
                            <span class="tf-nav-sub-dot"></span>Đề nghị mua
                        </NavLink>
                    </div>
                </div>
            </div>
        </div>

        @* ---- KHO HÀNG ---- *@
        <div class="tf-nav-section">
            <div class="tf-nav-section-label">Kho hàng</div>

            <div class="tf-nav-item">
                <button class="tf-nav-link @(IsWarehouseOpen ? "tf-nav-active" : "")" @onclick="ToggleWarehouse">
                    <span class="tf-nav-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 2H2v5l10 5 10-5V2z"/><path d="M12 22V12"/><path d="M2 7v15h20V7"/>
                        </svg>
                    </span>
                    <span class="tf-nav-label">Kho hàng</span>
                    <svg class="tf-nav-chevron @(IsWarehouseOpen ? "expanded" : "")" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"/>
                    </svg>
                </button>
                <div class="tf-nav-sub @(IsWarehouseOpen ? "expanded" : "")">
                    <div class="tf-nav-sub-item">
                        <NavLink class="tf-nav-sub-link" href="kho/ton-kho" ActiveClass="active" @onclick="OnNavClick">
                            <span class="tf-nav-sub-dot"></span>Tồn kho
                        </NavLink>
                    </div>
                    <div class="tf-nav-sub-item">
                        <NavLink class="tf-nav-sub-link" href="kho/nhap-kho" ActiveClass="active" @onclick="OnNavClick">
                            <span class="tf-nav-sub-dot"></span>Nhập kho
                        </NavLink>
                    </div>
                    <div class="tf-nav-sub-item">
                        <NavLink class="tf-nav-sub-link" href="kho/xuat-kho" ActiveClass="active" @onclick="OnNavClick">
                            <span class="tf-nav-sub-dot"></span>Xuất kho
                        </NavLink>
                    </div>
                </div>
            </div>
        </div>

        @* ---- ĐỐI TÁC ---- *@
        <div class="tf-nav-section">
            <div class="tf-nav-section-label">Đối tác</div>

            <div class="tf-nav-item">
                <NavLink class="tf-nav-link" href="doi-tac/khach-hang" ActiveClass="tf-nav-active" @onclick="OnNavClick">
                    <span class="tf-nav-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
                            <circle cx="9" cy="7" r="4"/>
                            <path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/>
                        </svg>
                    </span>
                    <span class="tf-nav-label">Khách hàng</span>
                </NavLink>
            </div>

            <div class="tf-nav-item">
                <NavLink class="tf-nav-link" href="doi-tac/nha-cung-cap" ActiveClass="tf-nav-active" @onclick="OnNavClick">
                    <span class="tf-nav-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
                            <circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
                        </svg>
                    </span>
                    <span class="tf-nav-label">Nhà cung cấp</span>
                </NavLink>
            </div>
        </div>

        @* ---- BÁO CÁO ---- *@
        <div class="tf-nav-section">
            <div class="tf-nav-section-label">Phân tích</div>

            <div class="tf-nav-item">
                <NavLink class="tf-nav-link" href="bao-cao" ActiveClass="tf-nav-active" @onclick="OnNavClick">
                    <span class="tf-nav-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="20" x2="18" y2="10"/>
                            <line x1="12" y1="20" x2="12" y2="4"/>
                            <line x1="6" y1="20" x2="6" y2="14"/>
                        </svg>
                    </span>
                    <span class="tf-nav-label">Báo cáo</span>
                </NavLink>
            </div>
        </div>

        @* ---- CÀI ĐẶT ---- *@
        <div class="tf-nav-section">
            <div class="tf-nav-section-label">Hệ thống</div>

            <div class="tf-nav-item">
                <button class="tf-nav-link @(IsSettingsOpen ? "tf-nav-active" : "")" @onclick="ToggleSettings">
                    <span class="tf-nav-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="3"/>
                            <path d="M19.07 4.93a10 10 0 010 14.14M4.93 4.93a10 10 0 000 14.14"/>
                        </svg>
                    </span>
                    <span class="tf-nav-label">Cài đặt</span>
                    <svg class="tf-nav-chevron @(IsSettingsOpen ? "expanded" : "")" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"/>
                    </svg>
                </button>
                <div class="tf-nav-sub @(IsSettingsOpen ? "expanded" : "")">
                    <div class="tf-nav-sub-item">
                        <NavLink class="tf-nav-sub-link" href="cai-dat/nguoi-dung" ActiveClass="active" @onclick="OnNavClick">
                            <span class="tf-nav-sub-dot"></span>Người dùng
                        </NavLink>
                    </div>
                    <div class="tf-nav-sub-item">
                        <NavLink class="tf-nav-sub-link" href="cai-dat/vai-tro" ActiveClass="active" @onclick="OnNavClick">
                            <span class="tf-nav-sub-dot"></span>Vai trò
                        </NavLink>
                    </div>
                    <div class="tf-nav-sub-item">
                        <NavLink class="tf-nav-sub-link" href="cai-dat/cong-ty" ActiveClass="active" @onclick="OnNavClick">
                            <span class="tf-nav-sub-dot"></span>Thông tin công ty
                        </NavLink>
                    </div>
                    <div class="tf-nav-sub-item">
                        <NavLink class="tf-nav-sub-link" href="cai-dat/nhat-ky" ActiveClass="active" @onclick="OnNavClick">
                            <span class="tf-nav-sub-dot"></span>Nhật ký hoạt động
                        </NavLink>
                    </div>
                </div>
            </div>
        </div>

    </div>
</nav>

@code {
    [Parameter] public EventCallback OnNavClick { get; set; }

    private bool IsSalesOpen { get; set; }
    private bool IsPurchaseOpen { get; set; }
    private bool IsWarehouseOpen { get; set; }
    private bool IsSettingsOpen { get; set; }

    private string _currentUrl = "";

    protected override void OnInitialized()
    {
        _currentUrl = Nav.ToBaseRelativePath(Nav.Uri);
        AutoExpandSection(_currentUrl);
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _currentUrl = Nav.ToBaseRelativePath(e.Location);
        AutoExpandSection(_currentUrl);
        StateHasChanged();
    }

    private void AutoExpandSection(string url)
    {
        if (url.StartsWith("ban-hang")) IsSalesOpen = true;
        if (url.StartsWith("mua-hang")) IsPurchaseOpen = true;
        if (url.StartsWith("kho")) IsWarehouseOpen = true;
        if (url.StartsWith("cai-dat")) IsSettingsOpen = true;
    }

    private void ToggleSales() => IsSalesOpen = !IsSalesOpen;
    private void TogglePurchase() => IsPurchaseOpen = !IsPurchaseOpen;
    private void ToggleWarehouse() => IsWarehouseOpen = !IsWarehouseOpen;
    private void ToggleSettings() => IsSettingsOpen = !IsSettingsOpen;

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
