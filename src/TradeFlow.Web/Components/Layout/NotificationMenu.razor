@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Application.Common.Models.Notifications
@inject INotificationService NotificationService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

<div class="tf-dropdown tf-notification-dropdown-container" @onkeydown="HandleKeyDown">
    <button type="button"
            class="tf-topbar-btn tf-notification-btn @(_isOpen ? "active" : "")"
            title="Thông báo hệ thống"
            aria-label="Thông báo hệ thống"
            aria-expanded="@_isOpen"
            aria-haspopup="true"
            id="tf-notification-menu-btn"
            @onclick="ToggleDropdown">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
            <path d="M13.73 21a2 2 0 0 1-3.46 0" />
        </svg>
        @if (_unreadCount > 0)
        {
            <span class="tf-topbar-badge-dot" title="@($"{_unreadCount} thông báo mới")"></span>
        }
    </button>

    @if (_isOpen)
    {
        @* Backdrop capturing outside clicks *@
        <div class="tf-dropdown-backdrop"
             @onclick="CloseDropdown"
             style="position:fixed;top:0;left:0;right:0;bottom:0;z-index:1079;background:transparent;cursor:default;"></div>

        @* Notification Dropdown Panel *@
        <div id="tf-notification-panel"
             class="tf-dropdown-menu tf-notification-panel show"
             role="dialog"
             aria-label="Bảng thông báo hệ thống"
             style="z-index:1080;">
            
            @* 1. HEADER (Fixed at top) *@
            <div class="tf-notification-header">
                <div class="tf-notif-title-group">
                    <span class="tf-notif-title">Thông báo</span>
                    @if (_unreadCount > 0)
                    {
                        <span class="tf-notif-unread-count-pill" title="Số lượng chưa đọc">@_unreadCount chưa đọc</span>
                    }
                    else if (_notifications.Any())
                    {
                        <span class="tf-notif-all-read-pill" title="Tất cả đã được đọc">Đã xem hết</span>
                    }
                </div>
                <div class="tf-notif-header-actions">
                    @if (_unreadCount > 0)
                    {
                        <button type="button" class="tf-notif-mark-read-btn" @onclick="MarkAllAsRead" title="Đánh dấu đã đọc tất cả">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12" />
                            </svg>
                            <span>Đã đọc tất cả</span>
                        </button>
                    }
                    <button type="button" class="tf-notif-close-icon" @onclick="CloseDropdown" title="Đóng bảng thông báo (Esc)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18" />
                            <line x1="6" y1="6" x2="18" y2="18" />
                        </svg>
                    </button>
                </div>
            </div>

            @* 2. BODY / LIST (Scrolls independently) *@
            <div class="tf-notification-body">
                @if (_isLoading)
                {
                    <div class="tf-notif-state-box">
                        <div class="tf-notif-spinner"></div>
                        <div class="tf-notif-state-title">Đang tải thông báo...</div>
                        <div class="tf-notif-state-desc">Đang đồng bộ dữ liệu mới nhất từ hệ thống TradeFlow.</div>
                    </div>
                }
                else if (_hasError)
                {
                    <div class="tf-notif-state-box error">
                        <div class="tf-notif-state-icon-wrap error">
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10" />
                                <line x1="12" y1="8" x2="12" y2="12" />
                                <line x1="12" y1="16" x2="12.01" y2="16" />
                            </svg>
                        </div>
                        <div class="tf-notif-state-title">Không thể tải thông báo</div>
                        <div class="tf-notif-state-desc">@_errorMessage</div>
                        <button type="button" class="tf-notif-retry-btn" @onclick="LoadNotificationsAsync">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
                            Thử lại
                        </button>
                    </div>
                }
                else if (!_notifications.Any())
                {
                    <div class="tf-notif-state-box empty">
                        <div class="tf-notif-empty-icon">
                            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                                <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                            </svg>
                        </div>
                        <div class="tf-notif-state-title">Chưa có thông báo mới</div>
                        <div class="tf-notif-state-desc">Hệ thống đang hoạt động ổn định. Bạn sẽ nhận được thông báo khi có yêu cầu phê duyệt hoặc cập nhật mới.</div>
                    </div>
                }
                else
                {
                    <div class="tf-notif-list">
                        @foreach (var n in _notifications)
                        {
                            var category = GetNotificationCategory(n);
                            <div class="tf-notif-card @(n.IsRead ? "is-read" : "is-unread") @(n.IsApprovalRequest ? "is-approval-card" : "")"
                                 @onclick="() => OnItemClicked(n)">
                                
                                @* Card Header: Icon + Category Badge + Time + Title *@
                                <div class="tf-notif-card-header">
                                    <div class="tf-notif-icon-wrap @category" title="@GetCategoryLabel(n)">
                                        @if (category == "attendance")
                                        {
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <circle cx="12" cy="12" r="10" />
                                                <polyline points="12 6 12 12 16 14" />
                                            </svg>
                                        }
                                        else if (category == "leave")
                                        {
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                                                <line x1="16" y1="2" x2="16" y2="6" />
                                                <line x1="8" y1="2" x2="8" y2="6" />
                                                <line x1="3" y1="10" x2="21" y2="10" />
                                                <path d="M8 14h.01" />
                                                <path d="M12 14h.01" />
                                                <path d="M16 14h.01" />
                                            </svg>
                                        }
                                        else if (category == "pricing")
                                        {
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z" />
                                                <line x1="7" y1="7" x2="7.01" y2="7" />
                                            </svg>
                                        }
                                        else if (category == "employee")
                                        {
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                                                <circle cx="8.5" cy="7" r="4" />
                                                <line x1="20" y1="8" x2="20" y2="14" />
                                                <line x1="23" y1="11" x2="17" y2="11" />
                                            </svg>
                                        }
                                        else if (category == "warning")
                                        {
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                                                <line x1="12" y1="9" x2="12" y2="13" />
                                                <line x1="12" y1="17" x2="12.01" y2="17" />
                                            </svg>
                                        }
                                        else if (category == "error")
                                        {
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <circle cx="12" cy="12" r="10" />
                                                <line x1="15" y1="9" x2="9" y2="15" />
                                                <line x1="9" y1="9" x2="15" y2="15" />
                                            </svg>
                                        }
                                        else if (category == "success")
                                        {
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                                                <polyline points="22 4 12 14.01 9 11.01" />
                                            </svg>
                                        }
                                        else
                                        {
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <circle cx="12" cy="12" r="10" />
                                                <line x1="12" y1="16" x2="12" y2="12" />
                                                <line x1="12" y1="8" x2="12.01" y2="8" />
                                            </svg>
                                        }
                                    </div>

                                    <div class="tf-notif-title-area">
                                        <div class="tf-notif-headline-row">
                                            <span class="tf-notif-type-tag @category">
                                                @(n.RequestTypeName ?? GetCategoryLabel(n))
                                            </span>
                                            <span class="tf-notif-time-badge" title="@n.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")">
                                                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <circle cx="12" cy="12" r="10"/>
                                                    <polyline points="12 6 12 12 16 14"/>
                                                </svg>
                                                @FormatRelativeTime(n.CreatedAt)
                                            </span>
                                            @if (!n.IsRead)
                                            {
                                                <span class="tf-notif-new-dot" title="Chưa đọc"></span>
                                            }
                                        </div>
                                        <h4 class="tf-notif-card-title">@n.Title</h4>
                                    </div>
                                </div>

                                @* Card Body: Full description without truncation *@
                                <div class="tf-notif-card-message">
                                    @n.Message
                                </div>

                                @* Metadata Grid (Mã, Người gửi, Trạng thái...) *@
                                @if (n.IsApprovalRequest || !string.IsNullOrEmpty(n.RequestCode) || !string.IsNullOrEmpty(n.Requester) || !string.IsNullOrEmpty(n.Status))
                                {
                                    <div class="tf-notif-meta-grid">
                                        @if (!string.IsNullOrEmpty(n.RequestCode))
                                        {
                                            <div class="tf-meta-item">
                                                <span class="tf-meta-label">Mã đơn:</span>
                                                <span class="tf-meta-value code">@n.RequestCode</span>
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(n.Requester))
                                        {
                                            <div class="tf-meta-item">
                                                <span class="tf-meta-label">Người gửi:</span>
                                                <span class="tf-meta-value">@n.Requester</span>
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(n.Status))
                                        {
                                            <div class="tf-meta-item">
                                                <span class="tf-meta-label">Trạng thái:</span>
                                                <span class="tf-status-badge @GetStatusClass(n.Status)">
                                                    <span class="tf-status-dot"></span>
                                                    @n.Status
                                                </span>
                                            </div>
                                        }
                                    </div>
                                }

                                @* Card Actions *@
                                @if (n.IsApprovalRequest)
                                {
                                    <div class="tf-notif-card-actions" @onclick:stopPropagation="true">
                                        @if (n.CanApprove)
                                        {
                                            <button type="button"
                                                    class="tf-notif-btn tf-notif-btn-approve"
                                                    disabled="@(_actionLoadingId == n.Id)"
                                                    @onclick="() => HandleApprove(n)"
                                                    title="Phê duyệt yêu cầu này">
                                                @if (_actionLoadingId == n.Id)
                                                {
                                                    <span class="tf-btn-spinner"></span>
                                                    <span>Đang duyệt...</span>
                                                }
                                                else
                                                {
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                                                    <span>Phê duyệt</span>
                                                }
                                            </button>
                                            <button type="button"
                                                    class="tf-notif-btn tf-notif-btn-reject"
                                                    disabled="@(_actionLoadingId == n.Id)"
                                                    @onclick="() => HandleReject(n)"
                                                    title="Từ chối yêu cầu này">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                                <span>Từ chối</span>
                                            </button>
                                        }
                                        else if (n.IsSelfRequest)
                                        {
                                            <div class="tf-notif-self-notice">
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                                                <span>Đề xuất của bạn (không thể tự duyệt)</span>
                                            </div>
                                        }

                                        @if (!string.IsNullOrEmpty(n.TargetUrl))
                                        {
                                            <a href="@n.TargetUrl" class="tf-link-view-detail" @onclick="CloseDropdown">
                                                <span>@(n.ActionButtonText ?? "Xem chi tiết")</span>
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                                            </a>
                                        }
                                    </div>
                                }
                                else if (!string.IsNullOrEmpty(n.TargetUrl) || !string.IsNullOrEmpty(n.ActionButtonText))
                                {
                                    <div class="tf-notif-card-actions info-only" @onclick:stopPropagation="true">
                                        <span class="tf-notif-info-time">@n.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                        @if (!string.IsNullOrEmpty(n.TargetUrl))
                                        {
                                            <a href="@n.TargetUrl" class="tf-link-view-detail" @onclick="() => HandleActionClick(n.TargetUrl)">
                                                <span>@(n.ActionButtonText ?? "Xem chi tiết")</span>
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                                            </a>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            @* 3. FOOTER (Fixed at bottom) *@
            <div class="tf-notification-footer">
                <div class="tf-notif-footer-brand">
                    <span class="tf-footer-online-dot"></span>
                    <span class="tf-notif-footer-text">Hệ thống thông báo TradeFlow</span>
                </div>
                <button type="button" class="tf-notif-refresh-btn @(_isLoading ? "is-refreshing" : "")" @onclick="LoadNotificationsAsync" title="Làm mới danh sách thông báo">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="23 4 23 10 17 10"/>
                        <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
                    </svg>
                    <span>Làm mới</span>
                </button>
            </div>
        </div>
    }
</div>

@code {
    private bool _isOpen;
    private bool _isLoading;
    private bool _hasError;
    private string _errorMessage = "Đã có lỗi xảy ra khi truy vấn dữ liệu thông báo.";
    private string? _actionLoadingId;
    private int _unreadCount => _notifications.Count(n => !n.IsRead);
    private List<SystemNotificationDto> _notifications = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadNotificationsAsync();
    }

    private async Task ToggleDropdown()
    {
        _isOpen = !_isOpen;
        if (_isOpen)
        {
            await LoadNotificationsAsync();
        }
    }

    private void CloseDropdown()
    {
        _isOpen = false;
    }

    private async Task LoadNotificationsAsync()
    {
        try
        {
            _isLoading = true;
            _hasError = false;
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            _notifications = await NotificationService.GetNotificationsAsync(authState.User, 20);
        }
        catch (Exception ex)
        {
            _hasError = true;
            _errorMessage = "Không thể tải danh sách thông báo: " + ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnItemClicked(SystemNotificationDto n)
    {
        await MarkAsRead(n);
        if (!string.IsNullOrEmpty(n.TargetUrl) && !n.IsApprovalRequest)
        {
            CloseDropdown();
            Nav.NavigateTo(n.TargetUrl);
        }
    }

    private async Task MarkAsRead(SystemNotificationDto notif)
    {
        if (notif.IsRead) return;
        notif.IsRead = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            await NotificationService.MarkAsReadAsync(notif.Id, authState.User);
        }
        catch { }
    }

    private async Task MarkAllAsRead()
    {
        foreach (var n in _notifications)
        {
            n.IsRead = true;
        }
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            await NotificationService.MarkAllAsReadAsync(authState.User);
        }
        catch { }
    }

    private async Task HandleApprove(SystemNotificationDto n)
    {
        _actionLoadingId = n.Id;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var success = await NotificationService.ApproveNotificationAsync(n.Id, authState.User);
            if (success)
            {
                await LoadNotificationsAsync();
            }
        }
        catch (Exception ex)
        {
            _hasError = true;
            _errorMessage = ex.Message;
        }
        finally
        {
            _actionLoadingId = null;
        }
    }

    private async Task HandleReject(SystemNotificationDto n)
    {
        _actionLoadingId = n.Id;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var success = await NotificationService.RejectNotificationAsync(n.Id, "Từ chối duyệt qua trung tâm thông báo", authState.User);
            if (success)
            {
                await LoadNotificationsAsync();
            }
        }
        catch (Exception ex)
        {
            _hasError = true;
            _errorMessage = ex.Message;
        }
        finally
        {
            _actionLoadingId = null;
        }
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && _isOpen)
        {
            CloseDropdown();
        }
    }

    private void HandleActionClick(string? url)
    {
        CloseDropdown();
        if (!string.IsNullOrEmpty(url))
        {
            Nav.NavigateTo(url);
        }
    }

    private string GetNotificationCategory(SystemNotificationDto n)
    {
        if (!string.IsNullOrEmpty(n.RequestType))
        {
            if (n.RequestType.Contains("Attendance", StringComparison.OrdinalIgnoreCase)) return "attendance";
            if (n.RequestType.Contains("Leave", StringComparison.OrdinalIgnoreCase)) return "leave";
            if (n.RequestType.Contains("Price", StringComparison.OrdinalIgnoreCase)) return "pricing";
            if (n.RequestType.Contains("Employee", StringComparison.OrdinalIgnoreCase)) return "employee";
        }
        if (n.Title.Contains("chấm công", StringComparison.OrdinalIgnoreCase)) return "attendance";
        if (n.Title.Contains("nghỉ phép", StringComparison.OrdinalIgnoreCase)) return "leave";
        if (n.Title.Contains("bảng giá", StringComparison.OrdinalIgnoreCase)) return "pricing";
        if (n.Title.Contains("nhân sự", StringComparison.OrdinalIgnoreCase) || n.Title.Contains("nhân viên", StringComparison.OrdinalIgnoreCase)) return "employee";
        if (n.Type == "warning") return "warning";
        if (n.Type == "error") return "error";
        if (n.Type == "success") return "success";
        if (n.Type == "order") return "order";
        return "system";
    }

    private string GetCategoryLabel(SystemNotificationDto n)
    {
        var cat = GetNotificationCategory(n);
        return cat switch
        {
            "attendance" => "Chấm công",
            "leave" => "Nghỉ phép",
            "pricing" => "Bảng giá",
            "employee" => "Nhân sự",
            "warning" => "Cảnh báo",
            "error" => "Cần xử lý",
            "success" => "Thành công",
            "order" => "Đơn hàng",
            _ => "Hệ thống"
        };
    }

    private string GetStatusClass(string? status)
    {
        if (string.IsNullOrEmpty(status)) return "status-default";
        var s = status.ToLowerInvariant();
        if (s.Contains("chờ duyệt") || s.Contains("pending")) return "status-pending";
        if (s.Contains("đã duyệt") || s.Contains("approved")) return "status-approved";
        if (s.Contains("từ chối") || s.Contains("rejected")) return "status-rejected";
        if (s.Contains("bổ sung") || s.Contains("needdocs")) return "status-needdocs";
        if (s.Contains("bản nháp") || s.Contains("draft")) return "status-draft";
        return "status-default";
    }

    private string FormatRelativeTime(DateTime utcTime)
    {
        var local = utcTime.ToLocalTime();
        var span = DateTime.Now - local;
        if (span.TotalMinutes < 1) return "Vừa xong";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes} phút trước";
        if (span.TotalHours < 24 && local.Date == DateTime.Today) return $"Hôm nay {local:HH:mm}";
        if (span.TotalDays < 2 && local.Date == DateTime.Today.AddDays(-1)) return $"Hôm qua {local:HH:mm}";
        return local.ToString("dd/MM/yyyy HH:mm");
    }
}
