@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Application.Common.Models.Notifications
@inject INotificationService NotificationService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

<div class="tf-dropdown tf-notification-dropdown-container" @onkeydown="HandleKeyDown">
    <button type="button"
            class="tf-topbar-btn tf-notification-btn @(_isOpen ? "active" : "")"
            title="Thông báo hệ thống"
            aria-label="Thông báo hệ thống"
            aria-expanded="@_isOpen"
            aria-haspopup="true"
            id="tf-notification-menu-btn"
            @onclick="ToggleDropdown">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
            <path d="M13.73 21a2 2 0 0 1-3.46 0" />
        </svg>
        @if (_unreadCount > 0)
        {
            <span class="tf-topbar-badge-dot" title="@($"{_unreadCount} thông báo mới")"></span>
        }
    </button>

    @if (_isOpen)
    {
        @* Backdrop capturing outside clicks *@
        <div class="tf-dropdown-backdrop"
             @onclick="CloseDropdown"
             style="position:fixed;top:0;left:0;right:0;bottom:0;z-index:998;background:transparent;cursor:default;"></div>

        @* Notification Dropdown Panel *@
        <div id="tf-notification-panel"
             class="tf-dropdown-menu tf-notification-panel show"
             role="dialog"
             aria-label="Bảng thông báo hệ thống"
             style="position:absolute;right:0;top:calc(100% + 8px);z-index:999;display:block;">
            
            <div class="tf-notification-header">
                <div class="tf-notif-title-group">
                    <span class="tf-notif-title">Thông báo</span>
                    @if (_notifications.Any())
                    {
                        <span class="tf-notif-count-pill">@_notifications.Count</span>
                    }
                </div>
                <div class="tf-notif-header-actions">
                    @if (_unreadCount > 0)
                    {
                        <button type="button" class="tf-notif-action-btn" @onclick="MarkAllAsRead" title="Đánh dấu đã đọc tất cả">
                            Đã đọc tất cả
                        </button>
                    }
                    <button type="button" class="tf-notif-close-icon" @onclick="CloseDropdown" title="Đóng bảng thông báo (Esc)">
                        ✕
                    </button>
                </div>
            </div>

            <div class="tf-notification-body">
                @if (_isLoading)
                {
                    <div class="tf-notif-state-box">
                        <div class="tf-notif-spinner"></div>
                        <div class="tf-notif-state-title">Đang tải thông báo...</div>
                    </div>
                }
                else if (_hasError)
                {
                    <div class="tf-notif-state-box error">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2">
                            <circle cx="12" cy="12" r="10" />
                            <line x1="12" y1="8" x2="12" y2="12" />
                            <line x1="12" y1="16" x2="12.01" y2="16" />
                        </svg>
                        <div class="tf-notif-state-title">Không thể tải thông báo</div>
                        <div class="tf-notif-state-desc">@_errorMessage</div>
                        <button type="button" class="tf-notif-retry-btn" @onclick="LoadNotificationsAsync">Thử lại</button>
                    </div>
                }
                else if (!_notifications.Any())
                {
                    <div class="tf-notif-state-box empty">
                        <div class="tf-notif-empty-icon">
                            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                                <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                            </svg>
                        </div>
                        <div class="tf-notif-state-title">Chưa có thông báo mới</div>
                        <div class="tf-notif-state-desc">Bạn sẽ thấy thông báo mới tại đây khi có cập nhật từ hệ thống hoặc đề xuất phê duyệt.</div>
                    </div>
                }
                else
                {
                    <div class="tf-notif-list">
                        @foreach (var n in _notifications)
                        {
                            <div class="tf-notif-item @(n.IsRead ? "read" : "unread") @(n.IsApprovalRequest ? "is-approval" : "")" @onclick="() => OnItemClicked(n)">
                                <div class="tf-notif-item-icon @n.Type">
                                    @if (n.IsApprovalRequest)
                                    {
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M9 11l3 3L22 4"/>
                                            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
                                        </svg>
                                    }
                                    else if (n.Type == "warning")
                                    {
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                                            <line x1="12" y1="9" x2="12" y2="13"/>
                                            <line x1="12" y1="17" x2="12.01" y2="17"/>
                                        </svg>
                                    }
                                    else
                                    {
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <circle cx="12" cy="12" r="10"/>
                                            <line x1="12" y1="16" x2="12" y2="12"/>
                                            <line x1="12" y1="8" x2="12.01" y2="8"/>
                                        </svg>
                                    }
                                </div>
                                <div class="tf-notif-item-content">
                                    <div class="tf-notif-top-row">
                                        <div class="tf-notif-item-title">@n.Title</div>
                                        @if (n.IsApprovalRequest)
                                        {
                                            <span class="tf-notif-badge-pill">@n.RequestTypeName</span>
                                        }
                                    </div>
                                    <div class="tf-notif-item-body">@n.Message</div>
                                    
                                    @if (n.IsApprovalRequest)
                                    {
                                        <div class="tf-notif-approval-meta">
                                            <span>Mã: <strong>@n.RequestCode</strong></span>
                                            <span>• Người gửi: <strong>@n.Requester</strong></span>
                                            <span>• Trạng thái: <span class="tf-status-draft-pill">@n.Status</span></span>
                                        </div>

                                        <div class="tf-notif-approval-actions" @onclick:stopPropagation="true">
                                            @if (n.CanApprove)
                                            {
                                                <button type="button" class="tf-btn-appr-ok" disabled="@(_actionLoadingId == n.Id)" @onclick="() => HandleApprove(n)">
                                                    @if (_actionLoadingId == n.Id)
                                                    {
                                                        <span>Đang xử lý...</span>
                                                    }
                                                    else
                                                    {
                                                        <span>Phê duyệt</span>
                                                    }
                                                </button>
                                                <button type="button" class="tf-btn-appr-no" disabled="@(_actionLoadingId == n.Id)" @onclick="() => HandleReject(n)">
                                                    <span>Từ chối</span>
                                                </button>
                                            }
                                            else if (n.IsSelfRequest)
                                            {
                                                <span class="tf-notif-self-hint">Đề xuất của bạn (không thể tự duyệt)</span>
                                            }

                                            @if (!string.IsNullOrEmpty(n.TargetUrl))
                                            {
                                                <a href="@n.TargetUrl" class="tf-notif-detail-link" @onclick="CloseDropdown">
                                                    Chi tiết &rarr;
                                                </a>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="tf-notif-item-time">@n.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                    }
                                </div>
                                @if (!n.IsRead)
                                {
                                    <span class="tf-notif-unread-dot" title="Chưa đọc"></span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="tf-notification-footer">
                <span class="tf-notif-footer-text">Hệ thống thông báo TradeFlow</span>
                <button type="button" class="tf-notif-refresh-btn" @onclick="LoadNotificationsAsync" title="Làm mới">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="23 4 23 10 17 10"/>
                        <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
                    </svg>
                    Làm mới
                </button>
            </div>
        </div>
    }
</div>

@code {
    private bool _isOpen;
    private bool _isLoading;
    private bool _hasError;
    private string _errorMessage = "Đã có lỗi xảy ra khi truy vấn dữ liệu thông báo.";
    private string? _actionLoadingId;
    private int _unreadCount => _notifications.Count(n => !n.IsRead);
    private List<SystemNotificationDto> _notifications = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadNotificationsAsync();
    }

    private async Task ToggleDropdown()
    {
        _isOpen = !_isOpen;
        if (_isOpen)
        {
            await LoadNotificationsAsync();
        }
    }

    private void CloseDropdown()
    {
        _isOpen = false;
    }

    private async Task LoadNotificationsAsync()
    {
        try
        {
            _isLoading = true;
            _hasError = false;
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            _notifications = await NotificationService.GetNotificationsAsync(authState.User, 20);
        }
        catch (Exception ex)
        {
            _hasError = true;
            _errorMessage = "Không thể tải danh sách thông báo: " + ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnItemClicked(SystemNotificationDto n)
    {
        await MarkAsRead(n);
        if (!string.IsNullOrEmpty(n.TargetUrl) && !n.IsApprovalRequest)
        {
            CloseDropdown();
            Nav.NavigateTo(n.TargetUrl);
        }
    }

    private async Task MarkAsRead(SystemNotificationDto notif)
    {
        if (notif.IsRead) return;
        notif.IsRead = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            await NotificationService.MarkAsReadAsync(notif.Id, authState.User);
        }
        catch { }
    }

    private async Task MarkAllAsRead()
    {
        foreach (var n in _notifications)
        {
            n.IsRead = true;
        }
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            await NotificationService.MarkAllAsReadAsync(authState.User);
        }
        catch { }
    }

    private async Task HandleApprove(SystemNotificationDto n)
    {
        _actionLoadingId = n.Id;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var success = await NotificationService.ApproveNotificationAsync(n.Id, authState.User);
            if (success)
            {
                await LoadNotificationsAsync();
            }
        }
        catch (Exception ex)
        {
            _hasError = true;
            _errorMessage = ex.Message;
        }
        finally
        {
            _actionLoadingId = null;
        }
    }

    private async Task HandleReject(SystemNotificationDto n)
    {
        _actionLoadingId = n.Id;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var success = await NotificationService.RejectNotificationAsync(n.Id, "Từ chối duyệt qua trung tâm thông báo", authState.User);
            if (success)
            {
                await LoadNotificationsAsync();
            }
        }
        catch (Exception ex)
        {
            _hasError = true;
            _errorMessage = ex.Message;
        }
        finally
        {
            _actionLoadingId = null;
        }
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && _isOpen)
        {
            CloseDropdown();
        }
    }
}
