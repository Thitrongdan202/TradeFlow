@code {
    [Parameter]
    public EventCallback<int> OnOpenSupport { get; set; }

    private bool _isOpen;
    private bool _isLoading;
    private bool _hasError;
    private string _errorMessage = "Đã có lỗi xảy ra khi truy vấn dữ liệu thông báo.";
    private string? _actionLoadingId;
    private int _unreadCount => _notifications.Count(n => !n.IsRead);
    private List<SystemNotificationDto> _notifications = new();

    // Rejection Dialog State
    private SystemNotificationDto? _rejectTarget;
    private string _rejectReason = "";
    private string? _rejectError;
    private bool _isRejectSubmitting = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadNotificationsAsync();
    }

    private async Task ToggleDropdown()
    {
        _isOpen = !_isOpen;
        if (_isOpen)
        {
            await LoadNotificationsAsync();
        }
    }

    private void CloseDropdown()
    {
        _isOpen = false;
        CloseRejectModal();
    }

    private void OpenRejectModal(SystemNotificationDto n)
    {
        _rejectTarget = n;
        _rejectReason = "";
        _rejectError = null;
    }

    private void CloseRejectModal()
    {
        _rejectTarget = null;
        _rejectReason = "";
        _rejectError = null;
    }

    private async Task ConfirmRejectAsync()
    {
        if (_rejectTarget == null) return;
        if (string.IsNullOrWhiteSpace(_rejectReason))
        {
            _rejectError = "Vui lòng nhập lý do từ chối cụ thể.";
            return;
        }

        try
        {
            _isRejectSubmitting = true;
            _rejectError = null;
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var success = await NotificationService.RejectNotificationAsync(_rejectTarget.Id, _rejectReason.Trim(), authState.User);
            if (success)
            {
                CloseRejectModal();
                await LoadNotificationsAsync();
            }
            else
            {
                _rejectError = "Thao tác không thành công. Vui lòng kiểm tra quyền hạn và thử lại.";
            }
        }
        catch (Exception ex)
        {
            _rejectError = ex.Message;
        }
        finally
        {
            _isRejectSubmitting = false;
        }
    }

    private async Task LoadNotificationsAsync()
    {
        try
        {
            _isLoading = true;
            _hasError = false;
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            _notifications = await NotificationService.GetNotificationsAsync(authState.User, 25);
        }
        catch (Exception ex)
        {
            _hasError = true;
            _errorMessage = "Không thể tải danh sách thông báo: " + ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleCardOrDetailClick(SystemNotificationDto n)
    {
        await MarkAsRead(n);
        CloseDropdown();

        // Support Tickets: In-place modal opening without losing current screen or unsaved form state
        if (n.RequestType == "SupportTicket" || n.TargetUrl == "#support-center")
        {
            if (n.EntityId.HasValue && OnOpenSupport.HasDelegate)
            {
                await OnOpenSupport.InvokeAsync(n.EntityId.Value);
            }
        }
        else if (!string.IsNullOrEmpty(n.TargetUrl))
        {
            Nav.NavigateTo(n.TargetUrl);
        }
    }

    private async Task MarkAsRead(SystemNotificationDto notif)
    {
        if (notif.IsRead) return;
        notif.IsRead = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            await NotificationService.MarkAsReadAsync(notif.Id, authState.User);
        }
        catch { }
    }

    private async Task MarkAllAsRead()
    {
        foreach (var n in _notifications)
        {
            n.IsRead = true;
        }
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            await NotificationService.MarkAllAsReadAsync(authState.User);
        }
        catch { }
    }

    private async Task HandleApprove(SystemNotificationDto n)
    {
        _actionLoadingId = n.Id;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var success = await NotificationService.ApproveNotificationAsync(n.Id, authState.User);
            if (success)
            {
                await LoadNotificationsAsync();
            }
        }
        catch (Exception ex)
        {
            _hasError = true;
            _errorMessage = ex.Message;
        }
        finally
        {
            _actionLoadingId = null;
        }
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && _isOpen)
        {
            if (_rejectTarget != null)
            {
                CloseRejectModal();
            }
            else
            {
                CloseDropdown();
            }
        }
    }

    private string GetNotificationCategory(SystemNotificationDto n)
    {
        if (!string.IsNullOrEmpty(n.RequestType))
        {
            if (n.RequestType.Contains("Attendance", StringComparison.OrdinalIgnoreCase)) return "attendance";
            if (n.RequestType.Contains("Leave", StringComparison.OrdinalIgnoreCase)) return "leave";
            if (n.RequestType.Contains("Shift", StringComparison.OrdinalIgnoreCase)) return "shift";
            if (n.RequestType.Contains("Support", StringComparison.OrdinalIgnoreCase)) return "support";
            if (n.RequestType.Contains("Contract", StringComparison.OrdinalIgnoreCase)) return "contract";
            if (n.RequestType.Contains("Invoice", StringComparison.OrdinalIgnoreCase)) return "invoice";
            if (n.RequestType.Contains("Sales", StringComparison.OrdinalIgnoreCase) || n.RequestType.Contains("Order", StringComparison.OrdinalIgnoreCase)) return "order";
            if (n.RequestType.Contains("Price", StringComparison.OrdinalIgnoreCase)) return "pricing";
            if (n.RequestType.Contains("Employee", StringComparison.OrdinalIgnoreCase)) return "employee";
            if (n.RequestType.Contains("Stock", StringComparison.OrdinalIgnoreCase) || n.RequestType.Contains("Warehouse", StringComparison.OrdinalIgnoreCase)) return "warehouse";
        }
        if (n.Title.Contains("hỗ trợ", StringComparison.OrdinalIgnoreCase) || n.Title.Contains("báo cáo lỗi", StringComparison.OrdinalIgnoreCase)) return "support";
        if (n.Title.Contains("chấm công", StringComparison.OrdinalIgnoreCase) || n.Title.Contains("giải trình", StringComparison.OrdinalIgnoreCase)) return "attendance";
        if (n.Title.Contains("nghỉ phép", StringComparison.OrdinalIgnoreCase)) return "leave";
        if (n.Title.Contains("đổi ca", StringComparison.OrdinalIgnoreCase)) return "shift";
        if (n.Title.Contains("hợp đồng", StringComparison.OrdinalIgnoreCase) || n.Title.Contains("HĐLĐ", StringComparison.OrdinalIgnoreCase)) return "contract";
        if (n.Title.Contains("hóa đơn", StringComparison.OrdinalIgnoreCase)) return "invoice";
        if (n.Title.Contains("đơn bán", StringComparison.OrdinalIgnoreCase) || n.Title.Contains("đơn hàng", StringComparison.OrdinalIgnoreCase)) return "order";
        if (n.Title.Contains("bảng giá", StringComparison.OrdinalIgnoreCase)) return "pricing";
        if (n.Title.Contains("nhân sự", StringComparison.OrdinalIgnoreCase) || n.Title.Contains("nhân viên", StringComparison.OrdinalIgnoreCase)) return "employee";
        if (n.Title.Contains("tồn kho", StringComparison.OrdinalIgnoreCase) || n.Title.Contains("kho", StringComparison.OrdinalIgnoreCase)) return "warehouse";
        if (n.Type == "warning") return "warning";
        if (n.Type == "error") return "error";
        if (n.Type == "success") return "success";
        if (n.Type == "order") return "order";
        return "system";
    }

    private string GetCategoryLabel(SystemNotificationDto n)
    {
        var cat = GetNotificationCategory(n);
        return cat switch
        {
            "attendance" => "Chấm công",
            "leave" => "Nghỉ phép",
            "shift" => "Đổi ca làm",
            "support" => "Báo cáo hỗ trợ",
            "contract" => "Hợp đồng",
            "invoice" => "Hóa đơn",
            "order" => "Bán hàng",
            "pricing" => "Bảng giá",
            "employee" => "Nhân sự",
            "warehouse" => "Kho hàng",
            "warning" => "Cảnh báo",
            "error" => "Cần xử lý",
            "success" => "Thành công",
            _ => "Hệ thống"
        };
    }

    private string GetStatusClass(string? status)
    {
        if (string.IsNullOrEmpty(status)) return "status-default";
        var s = status.ToLowerInvariant();
        if (s.Contains("chờ duyệt") || s.Contains("pending") || s.Contains("chờ ký") || s.Contains("chờ thanh toán")) return "status-pending";
        if (s.Contains("mới gửi") || s.Contains("new")) return "status-pending";
        if (s.Contains("đã duyệt") || s.Contains("approved") || s.Contains("đã giải quyết") || s.Contains("resolved")) return "status-approved";
        if (s.Contains("từ chối") || s.Contains("rejected")) return "status-rejected";
        if (s.Contains("bổ sung") || s.Contains("needdocs")) return "status-needdocs";
        if (s.Contains("bản nháp") || s.Contains("draft")) return "status-draft";
        return "status-default";
    }

    private string FormatRelativeTime(DateTime utcTime)
    {
        var local = utcTime.ToLocalTime();
        var span = DateTime.Now - local;
        if (span.TotalMinutes < 1) return "Vừa xong";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes} phút trước";
        if (span.TotalHours < 24 && local.Date == DateTime.Today) return $"Hôm nay {local:HH:mm}";
        if (span.TotalDays < 2 && local.Date == DateTime.Today.AddDays(-1)) return $"Hôm qua {local:HH:mm}";
        return local.ToString("dd/MM/yyyy HH:mm");
    }
}
