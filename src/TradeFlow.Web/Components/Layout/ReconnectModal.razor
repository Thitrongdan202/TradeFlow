<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

<dialog id="components-reconnect-modal" data-nosnippet>
    <div class="components-reconnect-container">
        <div class="components-rejoining-animation" aria-hidden="true">
            <div></div>
            <div></div>
        </div>
        <p class="components-reconnect-first-attempt-visible">
            Đang kết nối lại máy chủ...
        </p>
        <p class="components-reconnect-repeated-attempt-visible">
            Kết nối lại chưa thành công... đang thử lại sau <span id="components-seconds-to-next-attempt"></span> giây.
        </p>
        <p class="components-reconnect-failed-visible">
            Mất kết nối với máy chủ.<br />Vui lòng thử kết nối lại hoặc tải lại trang.
        </p>
        <div class="components-reconnect-failed-visible" style="display:none;flex-direction:row;gap:8px;justify-content:center;width:100%;">
            <button id="components-reconnect-button" type="button" style="background-color:#2563eb;color:#ffffff;padding:8px 16px;border-radius:6px;border:none;cursor:pointer;font-weight:500;">
                Thử kết nối lại
            </button>
            <button id="components-reload-button" type="button" onclick="location.reload()" style="background-color:#e2e8f0;color:#334155;padding:8px 16px;border-radius:6px;border:none;cursor:pointer;font-weight:500;">
                Tải lại trang
            </button>
        </div>
        <p class="components-pause-visible">
            Phiên làm việc đã tạm dừng.
        </p>
        <p class="components-resume-failed-visible">
            Không thể tiếp tục phiên làm việc.<br />Vui lòng thử lại hoặc tải lại trang.
        </p>
        <button id="components-resume-button" class="components-pause-visible components-resume-failed-visible" type="button" style="background-color:#2563eb;color:#ffffff;padding:8px 16px;border-radius:6px;border:none;cursor:pointer;font-weight:500;">
            Tiếp tục phiên
        </button>
    </div>
</dialog>
