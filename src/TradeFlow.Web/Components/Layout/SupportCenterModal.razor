    private (DateTime? from, DateTime? to) ResolveDateRange()
    {
        var now = DateTime.UtcNow;
        var todayStart = DateTime.UtcNow.Date;
        return _datePreset switch
        {
            "today" => (todayStart, now),
            "7days" => (now.AddDays(-7), now),
            "30days" => (now.AddDays(-30), now),
            "custom" => (_customFromDate?.ToUniversalTime(), _customToDate?.ToUniversalTime().AddDays(1).AddTicks(-1)),
            _ => (null, null)
        };
    }

    private string GetDatePresetLabel() => _datePreset switch
    {
        "today" => "Hôm nay",
        "7days" => "7 ngày qua",
        "30days" => "30 ngày qua",
        "custom" => $"{_customFromDate:dd/MM} - {_customToDate:dd/MM}",
        _ => "Tất cả"
    };

    private string GetAssigneeLabel()
    {
        if (_filterAssigneeId == "unassigned") return "Chưa phân công";
        var user = _assignableUsers.FirstOrDefault(u => u.Id == _filterAssigneeId);
        return user?.FullName ?? user?.UserName ?? _filterAssigneeId ?? "Đã chọn";
    }

    private string GetSubmitterLabel()
    {
        var user = _assignableUsers.FirstOrDefault(u => u.Id == _filterSubmitterId);
        return user?.FullName ?? user?.UserName ?? _filterSubmitterId ?? "Đã chọn";
    }

    private async Task FilterTicketsAsync()
    {
        if (_user == null || !_canManage) return;

        var (fromDate, toDate) = ResolveDateRange();

        var filter = new SupportTicketFilter
        {
            SearchKeyword = _searchKeyword,
            Status = _filterStatus,
            Category = _filterCategory,
            RelatedModule = _filterModule,
            Priority = _filterPriority,
            FromDate = fromDate,
            ToDate = toDate,
            AssignedToUserId = _filterAssigneeId,
            CreatedByUserId = _filterSubmitterId,
            SortBy = _sortBy
        };

        _manageTickets = await SupportService.GetTicketsAsync(filter, _user);
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        _fileError = null;
        var allowed = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
        {
            ".png", ".jpg", ".jpeg", ".webp", ".gif",
            ".pdf", ".docx", ".xlsx", ".txt", ".log", ".csv"
        };

        foreach (var file in e.GetMultipleFiles(5))
        {
            if (_selectedFiles.Count >= 5)
            {
                _fileError = "Chỉ được đính kèm tối đa 5 tệp cho mỗi báo cáo.";
                break;
            }

            var ext = Path.GetExtension(file.Name);
            if (string.IsNullOrEmpty(ext) || !allowed.Contains(ext))
            {
                _fileError = $"Tệp '{file.Name}' có định dạng không được hỗ trợ.";
                continue;
            }

            if (file.Size > 10 * 1024 * 1024)
            {
                _fileError = $"Tệp '{file.Name}' vượt quá giới hạn 10MB.";
                continue;
            }

            try
            {
                using var stream = file.OpenReadStream(10 * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                byte[] bytes = ms.ToArray();

                string? previewUrl = null;
                if (file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
                {
                    previewUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(bytes)}";
                }

                _selectedFiles.Add(new LocalUploadFile
                {
                    FileName = file.Name,
                    ContentType = file.ContentType,
                    SizeBytes = file.Size,
                    Data = bytes,
                    PreviewUrl = previewUrl,
                    Extension = ext.TrimStart('.').ToUpperInvariant()
                });
            }
            catch (Exception ex)
            {
                _fileError = $"Không thể tải tệp '{file.Name}': {ex.Message}";
            }
        }
    }

    private void RemoveFile(LocalUploadFile file)
    {
        _selectedFiles.Remove(file);
    }

    private async Task SubmitTicketAsync()
    {
        if (_user == null) return;
        if (string.IsNullOrWhiteSpace(_title))
        {
            _errorMessage = "Vui lòng nhập tiêu đề báo cáo.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_description))
        {
            _errorMessage = "Vui lòng nhập mô tả chi tiết vấn đề.";
            return;
        }

        _isSubmitting = true;
        _errorMessage = null;

        try
        {
            var cmd = new CreateSupportTicketCommand
            {
                Category = _category,
                RelatedModule = _module,
                Title = _title,
                Description = _description,
                Priority = _priority,
                CurrentRoute = _currentRoute,
                Files = _selectedFiles.Select(f => new SupportFileUploadDto
                {
                    FileName = f.FileName,
                    ContentType = f.ContentType,
                    FileSizeBytes = f.SizeBytes,
                    Data = f.Data
                }).ToList()
            };

            var ticket = await SupportService.CreateTicketAsync(cmd, _user);

            _successMessage = "Đã gửi yêu cầu hỗ trợ thành công.";
            _successCode = ticket.Code;

            // Reset form
            _title = string.Empty;
            _description = string.Empty;
            _selectedFiles.Clear();

            // Refresh lists
            await RefreshDataAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = "Lỗi khi gửi yêu cầu: " + ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task ViewTicketDetailAsync(int ticketId)
    {
        if (_user == null && AuthStateCascade != null)
        {
            var authState = await AuthStateCascade;
            _user = authState.User;
        }
        if (_user == null) return;
        try
        {
            _currentTicket = await SupportService.GetTicketByIdAsync(ticketId, _user);
            if (_currentTicket != null)
            {
                _selectedAssigneeId = _currentTicket.AssignedToUserId;
                _activeTab = "detail";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Không thể xem chi tiết yêu cầu: " + ex.Message;
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
            _ = TriggerTabAnimation();
        }
    }

    private async Task QuickUpdateStatusAsync(SupportStatus newStatus)
    {
        if (_user == null || _currentTicket == null) return;
        try
        {
            await SupportService.UpdateTicketStatusAsync(new UpdateSupportTicketStatusCommand
            {
                TicketId = _currentTicket.Id,
                NewStatus = newStatus
            }, _user);

            await ViewTicketDetailAsync(_currentTicket.Id);
            await RefreshDataAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = "Lỗi cập nhật trạng thái: " + ex.Message;
        }
    }

    private void PromptRejectModal()
    {
        _rejectionReasonInput = string.Empty;
        _showRejectModal = true;
    }

    private async Task ExecuteRejectTicketAsync()
    {
        if (_user == null || _currentTicket == null) return;
        if (string.IsNullOrWhiteSpace(_rejectionReasonInput))
        {
            _errorMessage = "Vui lòng nhập lý do từ chối.";
            return;
        }

        try
        {
            await SupportService.UpdateTicketStatusAsync(new UpdateSupportTicketStatusCommand
            {
                TicketId = _currentTicket.Id,
                NewStatus = SupportStatus.Rejected,
                ReasonOrNotes = _rejectionReasonInput.Trim()
            }, _user);

            _showRejectModal = false;
            await ViewTicketDetailAsync(_currentTicket.Id);
            await RefreshDataAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = "Lỗi từ chối yêu cầu: " + ex.Message;
        }
    }

    private async Task ExecuteAssignTicketAsync()
    {
        if (_user == null || _currentTicket == null || string.IsNullOrEmpty(_selectedAssigneeId)) return;
        try
        {
            await SupportService.AssignTicketAsync(new AssignSupportTicketCommand
            {
                TicketId = _currentTicket.Id,
                AssignToUserId = _selectedAssigneeId
            }, _user);

            await ViewTicketDetailAsync(_currentTicket.Id);
            await RefreshDataAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = "Lỗi phân công: " + ex.Message;
        }
    }

    private async Task SubmitReplyAsync()
    {
        if (_user == null || _currentTicket == null || string.IsNullOrWhiteSpace(_replyText)) return;

        _isSubmittingReply = true;
        try
        {
            await SupportService.AddCommentAsync(new AddSupportCommentCommand
            {
                TicketId = _currentTicket.Id,
                Content = _replyText,
                IsInternalNote = _replyIsInternal
            }, _user);

            _replyText = string.Empty;
            _replyIsInternal = false;
            await ViewTicketDetailAsync(_currentTicket.Id);
            await RefreshDataAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = "Lỗi gửi phản hồi: " + ex.Message;
        }
        finally
        {
            _isSubmittingReply = false;
        }
    }

