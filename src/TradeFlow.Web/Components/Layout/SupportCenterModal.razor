@rendermode InteractiveServer
@using System.IO
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Application.Common.Models.Support
@using TradeFlow.Domain.Entities.Support
@using TradeFlow.Domain.Enums
@using TradeFlow.Infrastructure.Persistence

@inject ISupportService SupportService
@inject NavigationManager Nav
@inject IDbContextFactory<TradeFlowDbContext> DbFactory
@inject IJSRuntime JS

@if (_isOpen)
{
    <div id="tf-support-overlay" class="tf-support-overlay is-active" @onclick="Close">
        <div id="tf-support-dialog" class="tf-support-dialog" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="tf-support-modal-title">
            
            <!-- HEADER -->
            <div class="tf-support-header">
                <div class="tf-support-header-left">
                    <div class="tf-support-icon-wrap">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 18v-6a9 9 0 0 1 18 0v6"></path>
                            <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path>
                        </svg>
                    </div>
                    <div class="tf-support-title-group">
                        <h2 id="tf-support-modal-title">Trung tâm hỗ trợ TradeFlow</h2>
                        <p>Gửi báo cáo lỗi, sự cố hệ thống hoặc yêu cầu hỗ trợ đến bộ phận quản lý.</p>
                    </div>
                </div>
                <button type="button" class="tf-support-close-btn" @onclick="Close" title="Đóng cửa sổ (Esc)">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            <!-- TAB SWITCHER -->
            <div class="tf-support-tabs-bar">
                @if (_canManage)
                {
                    <button type="button"
                            class="tf-support-tab-btn @(_activeTab == "manage" ? "is-active" : "")"
                            @onclick='() => SwitchTab("manage")'>
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                            <line x1="8" y1="21" x2="16" y2="21"></line>
                            <line x1="12" y1="17" x2="12" y2="21"></line>
                        </svg>
                        <span>Tiếp nhận &amp; Xử lý</span>
                        @if (_stats != null && _stats.NewTickets > 0)
                        {
                            <span class="tf-support-tab-badge tf-badge-danger">@_stats.NewTickets</span>
                        }
                    </button>
                }

                <button type="button"
                        class="tf-support-tab-btn @(_activeTab == "my-tickets" ? "is-active" : "")"
                        @onclick='() => SwitchTab("my-tickets")'>
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                    </svg>
                    <span>Báo cáo của tôi</span>
                    @if (_myTickets.Count > 0)
                    {
                        <span class="tf-support-tab-badge tf-badge-neutral">@_myTickets.Count</span>
                    }
                </button>

                <button type="button"
                        class="tf-support-tab-btn @(_activeTab == "create" ? "is-active" : "")"
                        @onclick='() => SwitchTab("create")'>
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    <span>Gửi báo cáo mới</span>
                </button>

                @if (_activeTab == "detail" && _currentTicket != null)
                {
                    <div class="tf-support-tab-btn is-active tf-tab-detail-pill">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                        </svg>
                        <span>Chi tiết: @_currentTicket.Code</span>
                    </div>
                }
            </div>

            <!-- BODY -->
            <div id="tf-support-body" class="tf-support-body">
                <!-- Global Alerts -->
                @if (!string.IsNullOrEmpty(_successMessage))
                {
                    <div class="tf-support-banner tf-banner-success">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                        <div class="tf-banner-text">
                            <div class="tf-banner-headline">@_successMessage</div>
                            @if (!string.IsNullOrEmpty(_successCode))
                            {
                                <div class="tf-banner-subline">
                                    Mã yêu cầu: <span class="tf-code-badge">@_successCode</span>. Bộ phận phụ trách đã nhận được thông báo và sẽ phản hồi sớm nhất.
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="tf-support-banner tf-banner-error">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="8" x2="12" y2="12"></line>
                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                        <div class="tf-banner-text">@_errorMessage</div>
                    </div>
                }

                <!-- TAB 1: FORM GỬI BÁO CÁO MỚI -->
                @if (_activeTab == "create")
                {
                    <form @onsubmit="SubmitTicketAsync" class="tf-support-create-form">
                        <div class="tf-support-form-grid">
                            <div class="tf-support-form-group">
                                <label class="tf-support-label">Loại yêu cầu <span class="required">*</span></label>
                                <select class="tf-support-select" @bind="_category">
                                    <option value="@SupportCategory.SystemError">Lỗi hệ thống</option>
                                    <option value="@SupportCategory.OperationError">Lỗi thao tác</option>
                                    <option value="@SupportCategory.UiDisplayError">Lỗi hiển thị giao diện</option>
                                    <option value="@SupportCategory.DataInaccurate">Dữ liệu không chính xác</option>
                                    <option value="@SupportCategory.FeatureInaccessible">Không truy cập được chức năng</option>
                                    <option value="@SupportCategory.UsageSupport">Yêu cầu hỗ trợ sử dụng</option>
                                    <option value="@SupportCategory.ImprovementProposal">Đề xuất cải tiến</option>
                                    <option value="@SupportCategory.Other">Khác</option>
                                </select>
                            </div>

                            <div class="tf-support-form-group">
                                <label class="tf-support-label">Module liên quan <span class="required">*</span></label>
                                <select class="tf-support-select" @bind="_module">
                                    <option value="@SupportRelatedModule.Attendance">Chấm công</option>
                                    <option value="@SupportRelatedModule.Sales">Bán hàng / POS</option>
                                    <option value="@SupportRelatedModule.Invoices">Hóa đơn</option>
                                    <option value="@SupportRelatedModule.Products">Sản phẩm &amp; Bảng giá</option>
                                    <option value="@SupportRelatedModule.Warehouse">Kho hàng &amp; Tồn kho</option>
                                    <option value="@SupportRelatedModule.Partners">Đối tác / Khách hàng</option>
                                    <option value="@SupportRelatedModule.Contracts">Hợp đồng</option>
                                    <option value="@SupportRelatedModule.Documents">Chứng từ</option>
                                    <option value="@SupportRelatedModule.Employees">Nhân sự</option>
                                    <option value="@SupportRelatedModule.Settings">Cài đặt &amp; Quản trị</option>
                                    <option value="@SupportRelatedModule.Other">Khác</option>
                                </select>
                            </div>

                            <div class="tf-support-form-group full-width">
                                <label class="tf-support-label">Tiêu đề báo cáo <span class="required">*</span></label>
                                <input type="text"
                                       class="tf-support-input"
                                       placeholder="Tóm tắt ngắn gọn vấn đề (ví dụ: Không thể lưu đơn bán hàng số DH-0021)"
                                       @bind="_title"
                                       @bind:event="oninput"
                                       maxlength="250"
                                       required />
                            </div>

                            <div class="tf-support-form-group full-width">
                                <label class="tf-support-label">Mô tả chi tiết <span class="required">*</span></label>
                                <textarea class="tf-support-textarea"
                                          placeholder="Vui lòng nêu rõ:&#10;• Bạn vừa thực hiện thao tác gì?&#10;• Kết quả thực tế đang xảy ra là gì?&#10;• Kết quả bạn mong muốn?&#10;• Các bước để tái hiện lại lỗi?"
                                          @bind="_description"
                                          @bind:event="oninput"
                                          required></textarea>
                            </div>

                            <div class="tf-support-form-group">
                                <label class="tf-support-label">Mức độ ưu tiên</label>
                                <select class="tf-support-select" @bind="_priority">
                                    <option value="@SupportPriority.Normal">Bình thường (Tiêu chuẩn)</option>
                                    <option value="@SupportPriority.Medium">Cần xử lý sớm (Trong ngày)</option>
                                    <option value="@SupportPriority.Urgent">Khẩn cấp (Ảnh hưởng toàn hệ thống)</option>
                                </select>
                            </div>

                            <div class="tf-support-form-group">
                                <label class="tf-support-label">Trang / Route gửi yêu cầu</label>
                                <input type="text" class="tf-support-input tf-input-readonly" @bind="_currentRoute" readonly title="Tự động nhận diện từ màn hình đang làm việc" />
                            </div>

                            <!-- Upload Dropzone -->
                            <div class="tf-support-form-group full-width">
                                <label class="tf-support-label">Tệp đính kèm (Ảnh chụp màn hình, PDF, Excel, Log, ...)</label>
                                <div class="tf-support-dropzone">
                                    <div class="tf-support-dropzone-icon">
                                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                            <polyline points="17 8 12 3 7 8"></polyline>
                                            <line x1="12" y1="3" x2="12" y2="15"></line>
                                        </svg>
                                    </div>
                                    <div class="tf-support-dropzone-text">Kéo thả tệp vào đây hoặc nhấn để chọn từ thiết bị</div>
                                    <div class="tf-support-dropzone-hint">Cho phép PNG, JPG, WEBP, PDF, DOCX, XLSX, CSV, TXT, LOG (Tối đa 5 tệp, 10MB/tệp)</div>
                                    <InputFile OnChange="HandleFileSelected" multiple class="tf-support-file-input" />
                                </div>

                                @if (!string.IsNullOrEmpty(_fileError))
                                {
                                    <div class="tf-field-error">@_fileError</div>
                                }

                                @if (_selectedFiles.Count > 0)
                                {
                                    <div class="tf-support-file-grid">
                                        @foreach (var file in _selectedFiles)
                                        {
                                            <div class="tf-support-file-card">
                                                <div class="tf-support-file-preview">
                                                    @if (file.PreviewUrl != null)
                                                    {
                                                        <img src="@file.PreviewUrl" class="tf-file-thumb" alt="Preview" />
                                                    }
                                                    else
                                                    {
                                                        <div class="tf-file-ext-badge">@file.Extension</div>
                                                    }
                                                </div>
                                                <div class="tf-support-file-info">
                                                    <span class="tf-support-file-name" title="@file.FileName">@file.FileName</span>
                                                    <span class="tf-support-file-size">@file.FormattedSize</span>
                                                </div>
                                                <button type="button" class="tf-support-file-remove" @onclick="() => RemoveFile(file)" title="Gỡ tệp này">
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                                        <line x1="18" y1="6" x2="6" y2="18"></line>
                                                        <line x1="6" y1="6" x2="18" y2="18"></line>
                                                    </svg>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Footer -->
                        <div class="tf-support-form-actions">
                            <button type="button" class="tf-support-btn tf-btn-ghost" @onclick="Close">Hủy</button>
                            <button type="submit" class="tf-support-btn tf-btn-primary" disabled="@_isSubmitting">
                                @if (_isSubmitting)
                                {
                                    <span class="tf-spinner-sm"></span>
                                    <span>Đang gửi báo cáo...</span>
                                }
                                else
                                {
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="22" y1="2" x2="11" y2="13"></line>
                                        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                                    </svg>
                                    <span>Gửi báo cáo</span>
                                }
                            </button>
                        </div>
                    </form>
                }

                <!-- TAB 2: BÁO CÁO CỦA TÔI -->
                @if (_activeTab == "my-tickets")
                {
                    @if (_myTickets.Count == 0)
                    {
                        <div class="tf-support-empty-state">
                            <div class="tf-empty-icon">
                                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                </svg>
                            </div>
                            <h3>Bạn chưa gửi báo cáo nào</h3>
                            <p>Khi gặp trục trặc kỹ thuật hoặc cần hướng dẫn, hãy bấm "Gửi báo cáo mới" để gửi yêu cầu đến quản trị viên.</p>
                            <button type="button" class="tf-support-btn tf-btn-primary" @onclick='() => SwitchTab("create")'>
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="12" y1="5" x2="12" y2="19"></line>
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                </svg>
                                <span>Tạo báo cáo đầu tiên</span>
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="tf-support-table-container">
                            <div class="tf-support-table-header">
                                <div class="tf-col-title">MÃ &amp; TIÊU ĐỀ</div>
                                <div class="tf-col-module">PHÂN LOẠI &amp; MODULE</div>
                                <div class="tf-col-priority">ƯU TIÊN</div>
                                <div class="tf-col-status">TRẠNG THÁI</div>
                                <div class="tf-col-time">THỜI GIAN</div>
                            </div>

                            <div class="tf-support-table-body">
                                @foreach (var t in _myTickets)
                                {
                                    <div class="tf-support-table-row" @onclick="() => ViewTicketDetailAsync(t.Id)" role="button" tabindex="0">
                                        <div class="tf-col-title">
                                            <div class="tf-row-primary">
                                                <span class="tf-code-badge">@t.Code</span>
                                                <span class="tf-ticket-title" title="@t.Title">@t.Title</span>
                                            </div>
                                            <div class="tf-row-chips">
                                                @if (t.AttachmentCount > 0)
                                                {
                                                    <span class="tf-chip-pill" title="@t.AttachmentCount tệp đính kèm">📎 @t.AttachmentCount</span>
                                                }
                                                @if (t.CommentCount > 0)
                                                {
                                                    <span class="tf-chip-pill" title="@t.CommentCount phản hồi">💬 @t.CommentCount</span>
                                                }
                                            </div>
                                        </div>

                                        <div class="tf-col-module">
                                            <span class="tf-cat-name">@t.CategoryName</span>
                                            <span class="tf-mod-badge">@t.RelatedModuleName</span>
                                        </div>

                                        <div class="tf-col-priority">
                                            <span class="tf-priority-pill @GetPriorityClass(t.Priority)">@t.PriorityName</span>
                                        </div>

                                        <div class="tf-col-status">
                                            <span class="tf-status-pill @GetStatusBadgeClass(t.Status)">@t.StatusName</span>
                                        </div>

                                        <div class="tf-col-time">
                                            <span class="tf-time-text">@t.CreatedAt.ToLocalTime().ToString("HH:mm dd/MM/yyyy")</span>
                                            <svg class="tf-row-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="9 18 15 12 9 6"></polyline>
                                            </svg>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }

                <!-- TAB 3: TIẾP NHẬN & XỬ LÝ (MANAGER & ADMIN) -->
                @if (_activeTab == "manage")
                {
                    <!-- Sleek KPI Strip (Compact status toolbar & Quick Filter, not bulky cards!) -->
                    @if (_stats != null)
                    {
                        <div class="tf-support-kpi-strip">
                            <button type="button"
                                    class="tf-kpi-pill @(_filterStatus == null ? "is-active" : "")"
                                    @onclick="() => QuickFilterStatus(null)"
                                    title="Bỏ lọc trạng thái (Hiển thị tất cả)">
                                <span class="tf-kpi-label">Tổng báo cáo</span>
                                <span class="tf-kpi-number">@_stats.TotalTickets</span>
                            </button>

                            <button type="button"
                                    class="tf-kpi-pill tf-kpi-new @(_filterStatus == SupportStatus.New ? "is-active" : "")"
                                    @onclick="() => QuickFilterStatus(SupportStatus.New)"
                                    title="Lọc báo cáo Mới gửi">
                                <span class="tf-kpi-dot dot-new"></span>
                                <span class="tf-kpi-label">Mới gửi</span>
                                <span class="tf-kpi-number">@_stats.NewTickets</span>
                            </button>

                            <button type="button"
                                    class="tf-kpi-pill tf-kpi-prog @(_filterStatus == SupportStatus.InProgress ? "is-active" : "")"
                                    @onclick="() => QuickFilterStatus(SupportStatus.InProgress)"
                                    title="Lọc báo cáo Đang xử lý">
                                <span class="tf-kpi-dot dot-prog"></span>
                                <span class="tf-kpi-label">Đang xử lý</span>
                                <span class="tf-kpi-number">@_stats.InProgressTickets</span>
                            </button>

                            <button type="button"
                                    class="tf-kpi-pill tf-kpi-wait @(_filterStatus == SupportStatus.WaitingForCustomer ? "is-active" : "")"
                                    @onclick="() => QuickFilterStatus(SupportStatus.WaitingForCustomer)"
                                    title="Lọc báo cáo Chờ phản hồi">
                                <span class="tf-kpi-dot dot-wait"></span>
                                <span class="tf-kpi-label">Chờ phản hồi</span>
                                <span class="tf-kpi-number">@_stats.WaitingCustomerTickets</span>
                            </button>

                            <button type="button"
                                    class="tf-kpi-pill tf-kpi-res @(_filterStatus == SupportStatus.Resolved ? "is-active" : "")"
                                    @onclick="() => QuickFilterStatus(SupportStatus.Resolved)"
                                    title="Lọc báo cáo Đã giải quyết">
                                <span class="tf-kpi-dot dot-res"></span>
                                <span class="tf-kpi-label">Đã giải quyết</span>
                                <span class="tf-kpi-number">@_stats.ResolvedTickets</span>
                            </button>
                        </div>
                    }

                    <!-- Unified Horizontal Toolbar: Search + Advanced Filter Popover + Sort -->
                    <div class="tf-support-toolbar">
                        <!-- 1. Search Box -->
                        <div class="tf-search-input-wrap">
                            <svg class="tf-search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="11" cy="11" r="8"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            </svg>
                            <input type="text"
                                   class="tf-support-search"
                                   placeholder="Tìm kiếm theo mã, tiêu đề, người gửi..."
                                   value="@_searchKeyword"
                                   @oninput="HandleSearchInput" />
                            @if (!string.IsNullOrEmpty(_searchKeyword))
                            {
                                <button type="button" class="tf-search-clear-btn" @onclick="ClearSearchAsync" title="Xóa từ khóa">
                                    &times;
                                </button>
                            }
                        </div>

                        <!-- 2. Advanced Filter Popover Button & Anchor -->
                        <div class="tf-popover-anchor">
                            <button type="button"
                                    class="tf-filter-trigger-btn @(_showFilterPopover ? "is-open" : "") @(ActiveFilterCount > 0 ? "has-filters" : "")"
                                    @onclick="ToggleFilterPopover"
                                    title="Mở bộ lọc nâng cao">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="4" y1="21" x2="4" y2="14"></line>
                                    <line x1="4" y1="10" x2="4" y2="3"></line>
                                    <line x1="12" y1="21" x2="12" y2="12"></line>
                                    <line x1="12" y1="8" x2="12" y2="3"></line>
                                    <line x1="20" y1="21" x2="20" y2="16"></line>
                                    <line x1="20" y1="12" x2="20" y2="3"></line>
                                    <line x1="1" y1="14" x2="7" y2="14"></line>
                                    <line x1="9" y1="8" x2="15" y2="8"></line>
                                    <line x1="17" y1="16" x2="23" y2="16"></line>
                                </svg>
                                <span>Bộ lọc</span>
                                @if (ActiveFilterCount > 0)
                                {
                                    <span class="tf-filter-active-count">@ActiveFilterCount</span>
                                }
                                <svg class="tf-filter-chevron @(_showFilterPopover ? "is-rotated" : "")" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="6 9 12 15 18 9"></polyline>
                                </svg>
                            </button>

                            <!-- Advanced Filter Popover Panel -->
                            @if (_showFilterPopover)
                            {
                                <div class="tf-popover-backdrop" @onclick="CloseFilterPopover"></div>

                                <div class="tf-filter-popover" @onclick:stopPropagation="true">
                                    <div class="tf-popover-header">
                                        <div class="tf-popover-title-wrap">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:#0284c7;">
                                                <line x1="4" y1="21" x2="4" y2="14"></line>
                                                <line x1="4" y1="10" x2="4" y2="3"></line>
                                                <line x1="12" y1="21" x2="12" y2="12"></line>
                                                <line x1="12" y1="8" x2="12" y2="3"></line>
                                                <line x1="20" y1="21" x2="20" y2="16"></line>
                                                <line x1="20" y1="12" x2="20" y2="3"></line>
                                                <line x1="1" y1="14" x2="7" y2="14"></line>
                                                <line x1="9" y1="8" x2="15" y2="8"></line>
                                                <line x1="17" y1="16" x2="23" y2="16"></line>
                                            </svg>
                                            <span class="tf-popover-title">Bộ lọc nâng cao</span>
                                        </div>
                                        <button type="button" class="tf-popover-close-btn" @onclick="CloseFilterPopover">&times;</button>
                                    </div>

                                    <div class="tf-popover-body">
                                        <div class="tf-popover-grid">
                                            <!-- 1. Loại báo cáo -->
                                            <div class="tf-popover-field">
                                                <label class="tf-popover-label">Loại báo cáo</label>
                                                <select class="tf-support-select tf-popover-select" @bind="_filterCategory" @bind:after="FilterTicketsAsync">
                                                    <option value="">Tất cả phân loại</option>
                                                    <option value="@SupportCategory.SystemError">Lỗi hệ thống</option>
                                                    <option value="@SupportCategory.OperationError">Lỗi thao tác</option>
                                                    <option value="@SupportCategory.UiDisplayError">Lỗi giao diện</option>
                                                    <option value="@SupportCategory.DataInaccurate">Dữ liệu không chính xác</option>
                                                    <option value="@SupportCategory.FeatureInaccessible">Không truy cập được chức năng</option>
                                                    <option value="@SupportCategory.UsageSupport">Yêu cầu hỗ trợ sử dụng</option>
                                                    <option value="@SupportCategory.ImprovementProposal">Đề xuất cải tiến</option>
                                                    <option value="@SupportCategory.Other">Khác</option>
                                                </select>
                                            </div>

                                            <!-- 2. Module liên quan -->
                                            <div class="tf-popover-field">
                                                <label class="tf-popover-label">Phân hệ / Module</label>
                                                <select class="tf-support-select tf-popover-select" @bind="_filterModule" @bind:after="FilterTicketsAsync">
                                                    <option value="">Tất cả module</option>
                                                    <option value="@SupportRelatedModule.Attendance">Chấm công</option>
                                                    <option value="@SupportRelatedModule.Sales">Bán hàng / POS</option>
                                                    <option value="@SupportRelatedModule.Invoices">Hóa đơn</option>
                                                    <option value="@SupportRelatedModule.Products">Sản phẩm &amp; Bảng giá</option>
                                                    <option value="@SupportRelatedModule.Warehouse">Kho hàng &amp; Tồn kho</option>
                                                    <option value="@SupportRelatedModule.Partners">Đối tác / Khách hàng</option>
                                                    <option value="@SupportRelatedModule.Contracts">Hợp đồng</option>
                                                    <option value="@SupportRelatedModule.Documents">Chứng từ</option>
                                                    <option value="@SupportRelatedModule.Employees">Nhân sự</option>
                                                    <option value="@SupportRelatedModule.Settings">Cài đặt &amp; Quản trị</option>
                                                    <option value="@SupportRelatedModule.Other">Khác</option>
                                                </select>
                                            </div>

                                            <!-- 3. Mức độ ưu tiên -->
                                            <div class="tf-popover-field">
                                                <label class="tf-popover-label">Mức độ ưu tiên</label>
                                                <select class="tf-support-select tf-popover-select" @bind="_filterPriority" @bind:after="FilterTicketsAsync">
                                                    <option value="">Tất cả mức độ</option>
                                                    <option value="@SupportPriority.Normal">Bình thường</option>
                                                    <option value="@SupportPriority.Medium">Cần xử lý sớm</option>
                                                    <option value="@SupportPriority.Urgent">Khẩn cấp</option>
                                                </select>
                                            </div>

                                            <!-- 4. Thời gian gửi -->
                                            <div class="tf-popover-field">
                                                <label class="tf-popover-label">Thời gian gửi</label>
                                                <select class="tf-support-select tf-popover-select" @bind="_datePreset" @bind:after="FilterTicketsAsync">
                                                    <option value="all">Tất cả thời gian</option>
                                                    <option value="today">Hôm nay</option>
                                                    <option value="7days">7 ngày qua</option>
                                                    <option value="30days">30 ngày qua</option>
                                                    <option value="custom">Tùy chỉnh khoảng ngày...</option>
                                                </select>
                                            </div>

                                            @if (_datePreset == "custom")
                                            {
                                                <div class="tf-popover-field full-width" style="display:flex;gap:8px;align-items:center;">
                                                    <div style="flex:1;">
                                                        <label class="tf-popover-label" style="font-size:11px;">Từ ngày</label>
                                                        <input type="date" class="tf-support-input tf-popover-date" @bind="_customFromDate" @bind:after="FilterTicketsAsync" />
                                                    </div>
                                                    <div style="flex:1;">
                                                        <label class="tf-popover-label" style="font-size:11px;">Đến ngày</label>
                                                        <input type="date" class="tf-support-input tf-popover-date" @bind="_customToDate" @bind:after="FilterTicketsAsync" />
                                                    </div>
                                                </div>
                                            }

                                            <!-- 5. Người phụ trách / Người xử lý -->
                                            <div class="tf-popover-field">
                                                <label class="tf-popover-label">Người xử lý</label>
                                                <select class="tf-support-select tf-popover-select" @bind="_filterAssigneeId" @bind:after="FilterTicketsAsync">
                                                    <option value="">Tất cả người xử lý</option>
                                                    <option value="unassigned">Chưa phân công</option>
                                                    @foreach (var u in _assignableUsers)
                                                    {
                                                        <option value="@u.Id">@(u.FullName ?? u.UserName)</option>
                                                    }
                                                </select>
                                            </div>

                                            <!-- 6. Người gửi -->
                                            <div class="tf-popover-field">
                                                <label class="tf-popover-label">Người gửi</label>
                                                <select class="tf-support-select tf-popover-select" @bind="_filterSubmitterId" @bind:after="FilterTicketsAsync">
                                                    <option value="">Tất cả người gửi</option>
                                                    @foreach (var u in _assignableUsers)
                                                    {
                                                        <option value="@u.Id">@(u.FullName ?? u.UserName)</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="tf-popover-footer">
                                        <button type="button" class="tf-popover-reset-btn" @onclick="ResetAdvancedFiltersAsync">
                                            Xóa bộ lọc
                                        </button>
                                        <button type="button" class="tf-support-btn tf-btn-primary tf-btn-sm" @onclick="CloseFilterPopover">
                                            Áp dụng
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- 3. Sort Order Dropdown -->
                        <div class="tf-sort-wrap">
                            <select class="tf-support-select tf-sort-select" @bind="_sortBy" @bind:after="FilterTicketsAsync" title="Sắp xếp danh sách">
                                <option value="created_desc">Mới nhất trước</option>
                                <option value="created_asc">Cũ nhất trước</option>
                                <option value="priority_desc">Ưu tiên cao trước</option>
                            </select>
                        </div>
                    </div>

                    <!-- Active Filter Chips Strip -->
                    @if (HasAnyActiveChips)
                    {
                        <div class="tf-active-chips-strip">
                            <span class="tf-chips-label">Đang lọc:</span>

                            @if (_filterStatus.HasValue)
                            {
                                <span class="tf-filter-chip">
                                    <span>Trạng thái: @_filterStatus.Value.ToDisplayName()</span>
                                    <button type="button" @onclick='() => RemoveFilterChip("status")' title="Xóa điều kiện này">&times;</button>
                                </span>
                            }

                            @if (_filterCategory.HasValue)
                            {
                                <span class="tf-filter-chip">
                                    <span>Loại: @_filterCategory.Value.ToDisplayName()</span>
                                    <button type="button" @onclick='() => RemoveFilterChip("category")' title="Xóa điều kiện này">&times;</button>
                                </span>
                            }

                            @if (_filterModule.HasValue)
                            {
                                <span class="tf-filter-chip">
                                    <span>Module: @_filterModule.Value.ToDisplayName()</span>
                                    <button type="button" @onclick='() => RemoveFilterChip("module")' title="Xóa điều kiện này">&times;</button>
                                </span>
                            }

                            @if (_filterPriority.HasValue)
                            {
                                <span class="tf-filter-chip">
                                    <span>Ưu tiên: @_filterPriority.Value.ToDisplayName()</span>
                                    <button type="button" @onclick='() => RemoveFilterChip("priority")' title="Xóa điều kiện này">&times;</button>
                                </span>
                            }

                            @if (_datePreset != "all")
                            {
                                <span class="tf-filter-chip">
                                    <span>Thời gian: @GetDatePresetLabel()</span>
                                    <button type="button" @onclick='() => RemoveFilterChip("date")' title="Xóa điều kiện này">&times;</button>
                                </span>
                            }

                            @if (!string.IsNullOrEmpty(_filterAssigneeId))
                            {
                                <span class="tf-filter-chip">
                                    <span>Phụ trách: @GetAssigneeLabel()</span>
                                    <button type="button" @onclick='() => RemoveFilterChip("assignee")' title="Xóa điều kiện này">&times;</button>
                                </span>
                            }

                            @if (!string.IsNullOrEmpty(_filterSubmitterId))
                            {
                                <span class="tf-filter-chip">
                                    <span>Người gửi: @GetSubmitterLabel()</span>
                                    <button type="button" @onclick='() => RemoveFilterChip("submitter")' title="Xóa điều kiện này">&times;</button>
                                </span>
                            }

                            @if (!string.IsNullOrWhiteSpace(_searchKeyword))
                            {
                                <span class="tf-filter-chip">
                                    <span>Từ khóa: "@_searchKeyword"</span>
                                    <button type="button" @onclick='() => RemoveFilterChip("keyword")' title="Xóa từ khóa">&times;</button>
                                </span>
                            }

                            <button type="button" class="tf-chips-clear-all-btn" @onclick="ResetFiltersAsync" title="Xóa toàn bộ các điều kiện lọc">
                                Xóa tất cả
                            </button>
                        </div>
                    }

                    <!-- Management Table (Data Rows) -->
                    @if (_manageTickets.Count == 0)
                    {
                        <div class="tf-support-empty-state">
                            <div class="tf-empty-icon">
                                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="11" cy="11" r="8"></circle>
                                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                </svg>
                            </div>
                            <h3>Không tìm thấy báo cáo phù hợp</h3>
                            <p>Không có bản ghi nào khớp với điều kiện lọc hiện tại. Thử thay đổi từ khóa hoặc bộ lọc trạng thái.</p>
                            @if (HasAnyActiveChips)
                            {
                                <button type="button" class="tf-support-btn tf-btn-ghost tf-btn-sm" style="margin-top:6px;" @onclick="ResetFiltersAsync">
                                    Đặt lại toàn bộ bộ lọc
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="tf-support-table-container">
                            <div class="tf-support-table-header tf-manage-grid">
                                <div class="tf-col-title">MÃ &amp; TIÊU ĐỀ</div>
                                <div class="tf-col-author">NGƯỜI GỬI / PHÒNG BAN</div>
                                <div class="tf-col-module">PHÂN LOẠI &amp; MODULE</div>
                                <div class="tf-col-priority">ƯU TIÊN</div>
                                <div class="tf-col-status">TRẠNG THÁI</div>
                                <div class="tf-col-time">THỜI GIAN</div>
                            </div>

                            <div class="tf-support-table-body">
                                @foreach (var t in _manageTickets)
                                {
                                    <div class="tf-support-table-row tf-manage-grid" @onclick="() => ViewTicketDetailAsync(t.Id)" role="button" tabindex="0">
                                        <div class="tf-col-title">
                                            <div class="tf-row-primary">
                                                <span class="tf-code-badge">@t.Code</span>
                                                <span class="tf-ticket-title" title="@t.Title">@t.Title</span>
                                            </div>
                                            <div class="tf-row-chips">
                                                @if (t.AttachmentCount > 0)
                                                {
                                                    <span class="tf-chip-pill" title="@t.AttachmentCount tệp đính kèm">📎 @t.AttachmentCount</span>
                                                }
                                                @if (t.CommentCount > 0)
                                                {
                                                    <span class="tf-chip-pill" title="@t.CommentCount phản hồi">💬 @t.CommentCount</span>
                                                }
                                                @if (!string.IsNullOrEmpty(t.AssignedToFullName))
                                                {
                                                    <span class="tf-chip-assignee" title="Người phụ trách">👤 @t.AssignedToFullName</span>
                                                }
                                            </div>
                                        </div>

                                        <div class="tf-col-author">
                                            <span class="tf-author-name">@(t.SubmitterFullName ?? t.CreatedByUserName)</span>
                                            <span class="tf-author-dept">
                                                @(t.SubmitterRole ?? "Nhân viên")
                                                @if (!string.IsNullOrEmpty(t.SubmitterDepartment))
                                                {
                                                    <span>• Phòng @t.SubmitterDepartment</span>
                                                }
                                            </span>
                                        </div>

                                        <div class="tf-col-module">
                                            <span class="tf-cat-name">@t.CategoryName</span>
                                            <span class="tf-mod-badge">@t.RelatedModuleName</span>
                                        </div>

                                        <div class="tf-col-priority">
                                            <span class="tf-priority-pill @GetPriorityClass(t.Priority)">@t.PriorityName</span>
                                        </div>

                                        <div class="tf-col-status">
                                            <span class="tf-status-pill @GetStatusBadgeClass(t.Status)">@t.StatusName</span>
                                        </div>

                                        <div class="tf-col-time">
                                            <span class="tf-time-text">@t.CreatedAt.ToLocalTime().ToString("HH:mm dd/MM/yyyy")</span>
                                            <svg class="tf-row-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="9 18 15 12 9 6"></polyline>
                                            </svg>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }

                <!-- TAB 4: CHI TIẾT & TRAO ĐỔI (DETAIL VIEW) -->
                @if (_activeTab == "detail" && _currentTicket != null)
                {
                    <div class="tf-detail-view-container">
                        <!-- Navigation & Badges Bar -->
                        <div class="tf-detail-topbar">
                            <button type="button" class="tf-support-btn tf-btn-ghost tf-btn-back" @onclick='() => SwitchTab(_canManage ? "manage" : "my-tickets")'>
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="19" y1="12" x2="5" y2="12"></line>
                                    <polyline points="12 19 5 12 12 5"></polyline>
                                </svg>
                                <span>Quay lại danh sách</span>
                            </button>

                            <div class="tf-detail-tags">
                                <span class="tf-code-badge tf-code-large">@_currentTicket.Code</span>
                                <span class="tf-status-pill @GetStatusBadgeClass(_currentTicket.Status)">@_currentTicket.StatusName</span>
                                <span class="tf-priority-pill @GetPriorityClass(_currentTicket.Priority)">@_currentTicket.PriorityName</span>
                            </div>
                        </div>

                        <!-- Action Toolbar for Manager / Admin -->
                        @if (_canManage)
                        {
                            <div class="tf-detail-action-bar">
                                <div class="tf-action-buttons-group">
                                    <span class="tf-action-group-label">Thao tác:</span>
                                    @if (_currentTicket.Status == SupportStatus.New)
                                    {
                                        <button type="button" class="tf-support-btn tf-btn-primary tf-btn-sm" @onclick="() => QuickUpdateStatusAsync(SupportStatus.Acknowledged)">
                                            Tiếp nhận
                                        </button>
                                    }
                                    @if (_currentTicket.Status != SupportStatus.InProgress && _currentTicket.Status != SupportStatus.Resolved && _currentTicket.Status != SupportStatus.Closed)
                                    {
                                        <button type="button" class="tf-support-btn tf-btn-outline tf-btn-sm" @onclick="() => QuickUpdateStatusAsync(SupportStatus.InProgress)">
                                            Bắt đầu xử lý
                                        </button>
                                    }
                                    @if (_currentTicket.Status != SupportStatus.Resolved && _currentTicket.Status != SupportStatus.Closed)
                                    {
                                        <button type="button" class="tf-support-btn tf-btn-success tf-btn-sm" @onclick="() => QuickUpdateStatusAsync(SupportStatus.Resolved)">
                                            Đánh dấu Đã giải quyết
                                        </button>
                                    }
                                    @if (_currentTicket.Status != SupportStatus.Rejected && _currentTicket.Status != SupportStatus.Closed)
                                    {
                                        <button type="button" class="tf-support-btn tf-btn-danger tf-btn-sm" @onclick="PromptRejectModal">
                                            Từ chối tiếp nhận
                                        </button>
                                    }
                                </div>

                                <div class="tf-assign-group">
                                    <span class="tf-action-group-label">Phân công:</span>
                                    <select class="tf-support-select tf-select-assign" @bind="_selectedAssigneeId" @bind:after="ExecuteAssignTicketAsync">
                                        <option value="">-- Chọn người xử lý --</option>
                                        @foreach (var u in _assignableUsers)
                                        {
                                            <option value="@u.Id">@(u.FullName ?? u.UserName)</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        }
                        else if (_currentTicket.Status == SupportStatus.Resolved)
                        {
                            <!-- Submitter Confirm Resolution -->
                            <div class="tf-support-banner tf-banner-confirm-resolve">
                                <div class="tf-confirm-text">
                                    <strong>Sự cố đã được đánh dấu Đã giải quyết.</strong> Vui lòng xác nhận nếu vấn đề đã được khắc phục hoàn toàn.
                                </div>
                                <button type="button" class="tf-support-btn tf-btn-success tf-btn-sm" @onclick="() => QuickUpdateStatusAsync(SupportStatus.Closed)">
                                    Xác nhận &amp; Đóng yêu cầu
                                </button>
                            </div>
                        }

                        <!-- Meta Info Strip (Clean 4-cell layout) -->
                        <div class="tf-detail-meta-grid">
                            <div class="tf-meta-cell">
                                <div class="tf-meta-label">Người gửi</div>
                                <div class="tf-meta-val">
                                    <strong>@_currentTicket.SubmitterFullName</strong>
                                    <span class="tf-meta-sub">(@_currentTicket.SubmitterRole@(!string.IsNullOrEmpty(_currentTicket.SubmitterDepartment) ? $" - {_currentTicket.SubmitterDepartment}" : ""))</span>
                                </div>
                            </div>

                            <div class="tf-meta-cell">
                                <div class="tf-meta-label">Thời điểm gửi</div>
                                <div class="tf-meta-val">
                                    <span>@_currentTicket.CreatedAt.ToLocalTime().ToString("HH:mm:ss • dd/MM/yyyy")</span>
                                </div>
                            </div>

                            <div class="tf-meta-cell">
                                <div class="tf-meta-label">Phân loại &amp; Module</div>
                                <div class="tf-meta-val">
                                    <span>@_currentTicket.CategoryName • <strong>@_currentTicket.RelatedModuleName</strong></span>
                                    @if (!string.IsNullOrEmpty(_currentTicket.CurrentRoute))
                                    {
                                        <span class="tf-meta-route" title="Route gửi báo cáo">(@_currentTicket.CurrentRoute)</span>
                                    }
                                </div>
                            </div>

                            <div class="tf-meta-cell">
                                <div class="tf-meta-label">Người phụ trách</div>
                                <div class="tf-meta-val">
                                    @if (!string.IsNullOrEmpty(_currentTicket.AssignedToFullName))
                                    {
                                        <span class="tf-assignee-highlight">👤 @_currentTicket.AssignedToFullName</span>
                                    }
                                    else
                                    {
                                        <span class="tf-unassigned-text">Chưa phân công</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Ticket Content Card -->
                        <div class="tf-detail-content-card">
                            <h3 class="tf-detail-content-title">@_currentTicket.Title</h3>
                            <div class="tf-detail-content-body">
                                @_currentTicket.Description
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(_currentTicket.RejectionReason))
                        {
                            <div class="tf-support-banner tf-banner-rejection">
                                <div class="tf-rejection-label">Lý do từ chối:</div>
                                <div class="tf-rejection-text">@_currentTicket.RejectionReason</div>
                            </div>
                        }

                        <!-- Attachments Section -->
                        @if (_currentTicket.Attachments.Count > 0)
                        {
                            <div class="tf-detail-attachments-section">
                                <div class="tf-attachments-section-head">
                                    <h4 class="tf-section-subtitle">TỆP ĐÍNH KÈM (@_currentTicket.Attachments.Count)</h4>
                                    <span class="tf-attachments-hint">Nhấn vào tệp để xem trực tiếp</span>
                                </div>
                                <div class="tf-attachments-gallery">
                                    @foreach (var att in _currentTicket.Attachments)
                                    {
                                        <div class="tf-attachment-card @(att.IsImage ? "is-image-card" : "is-doc-card")"
                                             role="button"
                                             tabindex="0"
                                             title="Nhấn để xem trực tiếp: @att.OriginalFileName"
                                             @onclick="() => OpenAttachmentViewer(att, _currentTicket.Attachments)">
                                            @if (att.IsImage)
                                            {
                                                <div class="tf-att-thumb-wrap">
                                                    <img src="@att.PreviewUrl" alt="@att.OriginalFileName" class="tf-att-thumb-img" loading="lazy" />
                                                    <div class="tf-att-thumb-overlay">
                                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                                            <circle cx="11" cy="11" r="8"></circle>
                                                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                                            <line x1="11" y1="8" x2="11" y2="14"></line>
                                                            <line x1="8" y1="11" x2="14" y2="11"></line>
                                                        </svg>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="tf-att-icon-box @(att.IsPdf ? "is-pdf" : "")">
                                                    <span class="tf-att-ext-label">@att.FileExtension</span>
                                                </div>
                                            }
                                            <div class="tf-att-info">
                                                <span class="tf-att-filename">@att.OriginalFileName</span>
                                                <span class="tf-att-meta">
                                                    @att.FormattedSize • @(att.IsImage ? "Xem ảnh" : (att.IsPdf || att.IsTextPreview ? "Xem tài liệu" : "Xem chi tiết"))
                                                </span>
                                            </div>
                                            <a href="@att.DownloadUrl"
                                               download="@att.OriginalFileName"
                                               class="tf-att-download-action"
                                               title="Tải tệp xuống máy"
                                               @onclick:stopPropagation="true">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                                    <polyline points="7 10 12 15 17 10"></polyline>
                                                    <line x1="12" y1="15" x2="12" y2="3"></line>
                                                </svg>
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- Discussion Timeline -->
                        <div class="tf-detail-thread-section">
                            <h4 class="tf-section-subtitle">TRAO ĐỔI &amp; PHẢN HỒI (@_currentTicket.Comments.Count)</h4>

                            @if (_currentTicket.Comments.Count == 0)
                            {
                                <div class="tf-thread-empty">
                                    Chưa có trao đổi nào cho báo cáo này. Nhập phản hồi bên dưới để gửi trao đổi.
                                </div>
                            }
                            else
                            {
                                <div class="tf-thread-messages">
                                    @foreach (var c in _currentTicket.Comments)
                                    {
                                        <div class="tf-thread-msg @(c.IsInternalNote ? "is-internal-note" : "")">
                                            <div class="tf-msg-header">
                                                <div class="tf-msg-author-info">
                                                    <span class="tf-msg-author-name">@c.AuthorFullName</span>
                                                    <span class="tf-msg-author-role">@c.AuthorRole</span>
                                                    @if (c.IsInternalNote)
                                                    {
                                                        <span class="tf-internal-pill">🔒 Ghi chú nội bộ</span>
                                                    }
                                                </div>
                                                <span class="tf-msg-time">@c.CreatedAt.ToLocalTime().ToString("HH:mm • dd/MM/yyyy")</span>
                                            </div>

                                            <div class="tf-msg-content">@c.Content</div>

                                            @if (c.Attachments.Count > 0)
                                            {
                                                <div class="tf-msg-attachments">
                                                    @foreach (var a in c.Attachments)
                                                    {
                                                        <div class="tf-msg-att-pill-group">
                                                            <button type="button"
                                                                    class="tf-msg-att-pill"
                                                                    title="Nhấn để xem trực tiếp: @a.OriginalFileName"
                                                                    @onclick="() => OpenAttachmentViewer(a, c.Attachments)">
                                                                @if (a.IsImage)
                                                                {
                                                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                                                                }
                                                                else
                                                                {
                                                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                                                                }
                                                                <span>@a.OriginalFileName (@a.FormattedSize)</span>
                                                            </button>
                                                            <a href="@a.DownloadUrl"
                                                               download="@a.OriginalFileName"
                                                               class="tf-msg-att-dl"
                                                               title="Tải về"
                                                               @onclick:stopPropagation="true">
                                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                                                            </a>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }

                            <!-- Redesigned Reply Form Card (Part 4) -->
                            <div class="tf-reply-card @(_replyIsInternal ? "is-internal-mode" : "")">
                                <div class="tf-reply-header">
                                    <div class="tf-reply-header-left">
                                        <span class="tf-reply-header-icon">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                                            </svg>
                                        </span>
                                        <h5 class="tf-reply-title">Gửi phản hồi / Bổ sung thông tin</h5>
                                    </div>
                                    @if (_replyIsInternal)
                                    {
                                        <span class="tf-reply-mode-badge is-internal">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                            </svg>
                                            <span>Chế độ ghi chú nội bộ</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="tf-reply-mode-badge">Phản hồi công khai</span>
                                    }
                                </div>

                                <div class="tf-reply-body">
                                    <textarea class="tf-support-textarea tf-reply-textarea"
                                              rows="3"
                                              placeholder="@(_replyIsInternal ? "Nhập ghi chú nội bộ dành riêng cho Manager & Admin xử lý..." : "Nhập nội dung phản hồi, hướng dẫn khắc phục hoặc bổ sung thông tin...")"
                                              @bind="_replyText"
                                              @bind:event="oninput"></textarea>
                                </div>

                                <div class="tf-reply-footer">
                                    <div class="tf-reply-footer-left">
                                        @if (_canManage)
                                        {
                                            <label class="tf-internal-toggle @(_replyIsInternal ? "is-checked" : "")">
                                                <input type="checkbox" class="tf-internal-checkbox" @bind="_replyIsInternal" />
                                                <span class="tf-internal-toggle-dot"></span>
                                                <span class="tf-internal-toggle-text">Ghi chú nội bộ (chỉ Manager &amp; Admin thấy)</span>
                                            </label>
                                        }
                                        else
                                        {
                                            <span class="tf-reply-helper-hint">Phản hồi được cập nhật trực tiếp vào tiến trình xử lý báo cáo.</span>
                                        }
                                    </div>

                                    <div class="tf-reply-footer-right">
                                        @if (!string.IsNullOrEmpty(_replyText))
                                        {
                                            <span class="tf-reply-char-count">@_replyText.Length ký tự</span>
                                        }
                                        <button type="button"
                                                class="tf-support-btn tf-btn-primary tf-reply-submit-btn @(_replyIsInternal ? "is-internal-btn" : "")"
                                                disabled="@(_isSubmittingReply || string.IsNullOrWhiteSpace(_replyText))"
                                                @onclick="SubmitReplyAsync">
                                            @if (_isSubmittingReply)
                                            {
                                                <span class="tf-spinner-sm"></span>
                                                <span>Đang gửi...</span>
                                            }
                                            else
                                            {
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                                    <line x1="22" y1="2" x2="11" y2="13"></line>
                                                    <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                                                </svg>
                                                <span>@(_replyIsInternal ? "Lưu ghi chú nội bộ" : "Gửi phản hồi")</span>
                                            }
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

<!-- Direct Attachment Viewer Modal: Lightbox for Images & Inline Viewer for PDF/Documents (Part 3) -->
@if (_previewAttachment != null)
{
    <div class="tf-att-viewer-overlay"
         id="tf-att-viewer-overlay"
         tabindex="0"
         @onkeydown="HandlePreviewKeyDown"
         @onclick="CloseAttachmentViewer">
        <div class="tf-att-viewer-container" @onclick:stopPropagation="true">
            <!-- Top Toolbar -->
            <div class="tf-att-viewer-toolbar">
                <div class="tf-att-viewer-filemeta">
                    <span class="tf-att-viewer-badge @(_previewAttachment.IsImage ? "is-img" : (_previewAttachment.IsPdf ? "is-pdf" : "is-doc"))">
                        @(_previewAttachment.IsImage ? "IMAGE" : _previewAttachment.FileExtension)
                    </span>
                    <div class="tf-att-viewer-titles">
                        <span class="tf-att-viewer-filename" title="@_previewAttachment.OriginalFileName">@_previewAttachment.OriginalFileName</span>
                        <span class="tf-att-viewer-submeta">
                            @_previewAttachment.FormattedSize
                            @if (!string.IsNullOrEmpty(_previewAttachment.UploadedByUserName))
                            {
                                <text> • Tải lên bởi @_previewAttachment.UploadedByUserName</text>
                            }
                            @if (_previewAttachment.IsImage && _previewImageList.Count > 1)
                            {
                                <text> • Ảnh @(_previewImageIndex + 1) / @_previewImageList.Count</text>
                            }
                        </span>
                    </div>
                </div>

                <div class="tf-att-viewer-actions">
                    @if (_previewAttachment.IsImage)
                    {
                        <div class="tf-att-zoom-controls" title="Điều chỉnh thu phóng">
                            <button type="button" class="tf-att-tool-btn" @onclick="ZoomOutPreview" disabled="@(_previewZoom <= 0.5)" title="Thu nhỏ (-)">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
                            </button>
                            <button type="button" class="tf-att-zoom-readout" @onclick="ResetPreviewZoom" title="Đặt lại 100%">
                                @($"{(int)Math.Round(_previewZoom * 100)}%")
                            </button>
                            <button type="button" class="tf-att-tool-btn" @onclick="ZoomInPreview" disabled="@(_previewZoom >= 3.0)" title="Phóng to (+)">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
                            </button>
                        </div>
                    }

                    <a href="@_previewAttachment.DownloadUrl"
                       download="@_previewAttachment.OriginalFileName"
                       class="tf-att-viewer-dl-btn"
                       title="Tải tệp này về máy">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                            <polyline points="7 10 12 15 17 10"></polyline>
                            <line x1="12" y1="15" x2="12" y2="3"></line>
                        </svg>
                        <span>Tải xuống</span>
                    </a>

                    <button type="button"
                            class="tf-att-viewer-close-btn"
                            title="Đóng trình xem tệp (Esc)"
                            @onclick="CloseAttachmentViewer">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Main Viewer Stage -->
            <div class="tf-att-viewer-stage" @onclick="CloseAttachmentViewer">
                @if (_previewAttachment.IsImage)
                {
                    @if (_previewImageList.Count > 1)
                    {
                        <button type="button"
                                class="tf-att-nav-arrow prev"
                                title="Ảnh trước (←)"
                                @onclick="PrevPreviewImage"
                                @onclick:stopPropagation="true">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                        </button>
                    }

                    <div class="tf-att-image-canvas" @onclick:stopPropagation="true">
                        <img src="@_previewAttachment.PreviewUrl"
                             alt="@_previewAttachment.OriginalFileName"
                             class="tf-att-lightbox-img"
                             style="transform: scale(@_previewZoom.ToString(System.Globalization.CultureInfo.InvariantCulture));" />
                    </div>

                    @if (_previewImageList.Count > 1)
                    {
                        <button type="button"
                                class="tf-att-nav-arrow next"
                                title="Ảnh tiếp theo (→)"
                                @onclick="NextPreviewImage"
                                @onclick:stopPropagation="true">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                        </button>
                    }
                }
                else if (_previewAttachment.IsPdf || _previewAttachment.IsTextPreview)
                {
                    <div class="tf-att-doc-stage" @onclick:stopPropagation="true">
                        <iframe src="@_previewAttachment.PreviewUrl"
                                class="tf-doc-preview-frame"
                                title="@_previewAttachment.OriginalFileName"></iframe>
                    </div>
                }
                else
                {
                    <div class="tf-att-unsupported-card" @onclick:stopPropagation="true">
                        <div class="tf-att-unsupported-icon">
                            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                <polyline points="14 2 14 8 20 8"></polyline>
                                <line x1="16" y1="13" x2="8" y2="13"></line>
                                <line x1="16" y1="17" x2="8" y2="17"></line>
                            </svg>
                        </div>
                        <h4 class="tf-att-unsupported-title">@_previewAttachment.OriginalFileName</h4>
                        <p class="tf-att-unsupported-desc">
                            Định dạng tệp <strong>.@_previewAttachment.FileExtension</strong> (@_previewAttachment.FormattedSize) chưa hỗ trợ hiển thị trực tiếp trong trình duyệt. Bạn có thể tải tệp về máy để mở bằng ứng dụng chuyên dụng.
                        </p>
                        <a href="@_previewAttachment.DownloadUrl"
                           download="@_previewAttachment.OriginalFileName"
                           class="tf-support-btn tf-btn-primary">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                <polyline points="7 10 12 15 17 10"></polyline>
                                <line x1="12" y1="15" x2="12" y2="3"></line>
                            </svg>
                            <span>Tải tệp xuống máy (@_previewAttachment.FormattedSize)</span>
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
}

<!-- Reject Modal Prompt -->
