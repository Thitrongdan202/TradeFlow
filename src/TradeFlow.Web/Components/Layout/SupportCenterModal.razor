}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateCascade { get; set; }

    private bool _isOpen = false;
    private string _activeTab = "create"; // create, my-tickets, manage, detail
    private bool _canManage = false;
    private ClaimsPrincipal? _user;

    // Form inputs
    private SupportCategory _category = SupportCategory.SystemError;
    private SupportRelatedModule _module = SupportRelatedModule.Other;
    private string _title = string.Empty;
    private string _description = string.Empty;
    private SupportPriority _priority = SupportPriority.Normal;
    private string _currentRoute = string.Empty;
    private List<LocalUploadFile> _selectedFiles = new();
    private string? _fileError;
    private bool _isSubmitting = false;
    private string? _errorMessage;
    private string? _successMessage;
    private string? _successCode;

    // Lists and detail
    private List<SupportTicketSummaryDto> _myTickets = new();
    private List<SupportTicketSummaryDto> _manageTickets = new();
    private SupportStatsDto? _stats;
    private SupportTicketDetailDto? _currentTicket;
    private List<ApplicationUser> _assignableUsers = new();
    private string? _selectedAssigneeId;

    // Management filters
    private string _searchKeyword = string.Empty;
    private SupportStatus? _filterStatus;
    private SupportCategory? _filterCategory;
    private SupportRelatedModule? _filterModule;
    private SupportPriority? _filterPriority;
    private string _datePreset = "all"; // all, today, 7days, 30days, custom
    private DateTime? _customFromDate;
    private DateTime? _customToDate;
    private string? _filterAssigneeId;
    private string? _filterSubmitterId;
    private string _sortBy = "created_desc"; // created_desc, created_asc, priority_desc
    private bool _showFilterPopover = false;
    private System.Threading.Timer? _searchDebounceTimer;

    // Discussion reply
    private string _replyText = string.Empty;
    private bool _replyIsInternal = false;
    private bool _isSubmittingReply = false;

    // Reject prompt
    private bool _showRejectModal = false;
    private string _rejectionReasonInput = string.Empty;

    // Direct Attachment Viewer (Lightbox & Document Previewer)
    private SupportAttachmentDto? _previewAttachment;
    private List<SupportAttachmentDto> _previewImageList = new();
    private int _previewImageIndex = 0;
    private double _previewZoom = 1.0;

    private void OpenAttachmentViewer(SupportAttachmentDto att, List<SupportAttachmentDto>? sourceList = null)
    {
        _previewAttachment = att;
        _previewZoom = 1.0;

        if (att.IsImage && sourceList != null)
        {
            _previewImageList = sourceList.Where(x => x.IsImage).ToList();
            _previewImageIndex = _previewImageList.FindIndex(x => x.Id == att.Id);
            if (_previewImageIndex < 0) _previewImageIndex = 0;
        }
        else
        {
            _previewImageList = att.IsImage ? new List<SupportAttachmentDto> { att } : new List<SupportAttachmentDto>();
            _previewImageIndex = 0;
        }
    }

    private void CloseAttachmentViewer()
    {
        _previewAttachment = null;
        _previewImageList.Clear();
        _previewImageIndex = 0;
        _previewZoom = 1.0;
    }

    private void ZoomInPreview()
    {
        _previewZoom = Math.Min(3.0, Math.Round(_previewZoom + 0.25, 2));
    }

    private void ZoomOutPreview()
    {
        _previewZoom = Math.Max(0.5, Math.Round(_previewZoom - 0.25, 2));
    }

    private void ResetPreviewZoom()
    {
        _previewZoom = 1.0;
    }

    private void PrevPreviewImage()
    {
        if (_previewImageList.Count <= 1) return;
        _previewImageIndex = (_previewImageIndex - 1 + _previewImageList.Count) % _previewImageList.Count;
        _previewAttachment = _previewImageList[_previewImageIndex];
        _previewZoom = 1.0;
    }

    private void NextPreviewImage()
    {
        if (_previewImageList.Count <= 1) return;
        _previewImageIndex = (_previewImageIndex + 1) % _previewImageList.Count;
        _previewAttachment = _previewImageList[_previewImageIndex];
        _previewZoom = 1.0;
    }

    private void HandlePreviewKeyDown(KeyboardEventArgs e)
    {
        if (_previewAttachment == null) return;

        switch (e.Key)
        {
            case "Escape":
                CloseAttachmentViewer();
                break;
            case "ArrowLeft":
                if (_previewAttachment.IsImage) PrevPreviewImage();
                break;
            case "ArrowRight":
                if (_previewAttachment.IsImage) NextPreviewImage();
                break;
            case "+":
            case "=":
                if (_previewAttachment.IsImage) ZoomInPreview();
                break;
            case "-":
            case "_":
                if (_previewAttachment.IsImage) ZoomOutPreview();
                break;
            case "0":
                if (_previewAttachment.IsImage) ResetPreviewZoom();
                break;
        }
    }

    private int ActiveFilterCount
    {
        get
        {
            int count = 0;
            if (_filterCategory.HasValue) count++;
            if (_filterModule.HasValue) count++;
            if (_filterPriority.HasValue) count++;
            if (_datePreset != "all") count++;
            if (!string.IsNullOrEmpty(_filterAssigneeId)) count++;
            if (!string.IsNullOrEmpty(_filterSubmitterId)) count++;
            return count;
        }
    }

    private bool HasAnyActiveChips =>
        ActiveFilterCount > 0
        || _filterStatus.HasValue
        || !string.IsNullOrWhiteSpace(_searchKeyword);

    public void Open(string? tab = null, int? ticketId = null)
    {
        _isOpen = true;
        _successMessage = null;
        _errorMessage = null;
        _fileError = null;
        _previewAttachment = null;

        AutoDetectCurrentRouteAndModule();

        if (ticketId.HasValue && ticketId.Value > 0)
        {
            _activeTab = "detail";
            _ = ViewTicketDetailAsync(ticketId.Value);
        }
        else if (!string.IsNullOrEmpty(tab))
        {
            _activeTab = tab;
        }
        else
        {
            _activeTab = _canManage ? "manage" : "create";
        }

        _ = RefreshDataAsync();
        StateHasChanged();
        _ = TriggerModalEnterAnimation();
    }

    public void Close()
    {
        _ = CloseWithAnimationAsync();
    }

    private async Task CloseWithAnimationAsync()
    {
        if (_previewAttachment != null)
        {
            CloseAttachmentViewer();
            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("TradeFlowMotion.animateModalExit", "#tf-support-dialog", "#tf-support-overlay");
        }
        catch { }

        _isOpen = false;
        _showRejectModal = false;
        _showFilterPopover = false;
        _previewAttachment = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task TriggerModalEnterAnimation()
    {
        try
        {
            await Task.Yield();
            await JS.InvokeVoidAsync("TradeFlowMotion.animateModalEnter", "#tf-support-dialog", "#tf-support-overlay");
        }
        catch { }
    }

    private async Task TriggerTabAnimation()
    {
        try
        {
            await Task.Delay(20);
            await JS.InvokeVoidAsync("TradeFlowMotion.animateTabContent", "#tf-support-body");
        }
        catch { }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (AuthStateCascade != null)
        {
            var authState = await AuthStateCascade;
            _user = authState.User;
            _canManage = _user.IsInRole("Administrator")
                      || _user.IsInRole("Manager")
                      || (_user.Identity?.Name?.Equals("admin", StringComparison.OrdinalIgnoreCase) == true);
        }
    }

    private void AutoDetectCurrentRouteAndModule()
    {
        string uri = Nav.Uri;
        var path = new Uri(uri).AbsolutePath.ToLowerInvariant();
        _currentRoute = path;

        if (path.StartsWith("/cham-cong")) _module = SupportRelatedModule.Attendance;
        else if (path.StartsWith("/ban-hang") || path.StartsWith("/pos")) _module = SupportRelatedModule.Sales;
        else if (path.StartsWith("/hoa-don")) _module = SupportRelatedModule.Invoices;
        else if (path.StartsWith("/danh-muc/san-pham") || path.StartsWith("/bang-gia")) _module = SupportRelatedModule.Products;
        else if (path.StartsWith("/kho")) _module = SupportRelatedModule.Warehouse;
        else if (path.StartsWith("/doi-tac")) _module = SupportRelatedModule.Partners;
        else if (path.StartsWith("/hop-dong")) _module = SupportRelatedModule.Contracts;
        else if (path.StartsWith("/tai-lieu")) _module = SupportRelatedModule.Documents;
        else if (path.StartsWith("/nhan-vien")) _module = SupportRelatedModule.Employees;
        else if (path.StartsWith("/cai-dat") || path.StartsWith("/admin")) _module = SupportRelatedModule.Settings;
        else _module = SupportRelatedModule.Other;
    }

    private async Task SwitchTab(string tab)
    {
        _activeTab = tab;
        _errorMessage = null;
        _successMessage = null;
        _showFilterPopover = false;
        await RefreshDataAsync();
        _ = TriggerTabAnimation();
    }

    private async Task RefreshDataAsync()
    {
        if (_user == null && AuthStateCascade != null)
        {
            var authState = await AuthStateCascade;
            _user = authState.User;
            _canManage = _user.IsInRole("Administrator")
                      || _user.IsInRole("Manager")
                      || (_user.Identity?.Name?.Equals("admin", StringComparison.OrdinalIgnoreCase) == true);
        }
        if (_user == null) return;

        try
        {
            // My tickets
            _myTickets = await SupportService.GetTicketsAsync(new SupportTicketFilter { OnlyMine = true }, _user);

            // Management list
            if (_canManage)
            {
                _stats = await SupportService.GetStatsAsync(_user);
                await FilterTicketsAsync();

                // Load assignable users (Admins and Managers)
                await using var context = await DbFactory.CreateDbContextAsync();
                _assignableUsers = await context.Users
                    .AsNoTracking()
                    .Where(u => u.Status == Domain.Enums.UserStatus.Active)
                    .OrderBy(u => u.FullName ?? u.UserName)
                    .ToListAsync();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Lỗi tải dữ liệu: " + ex.Message;
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

