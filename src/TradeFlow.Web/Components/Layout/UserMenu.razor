@using Microsoft.AspNetCore.Identity
@using TradeFlow.Infrastructure.Persistence
@inject NavigationManager Nav
@inject UserManager<ApplicationUser> UserManager

<div class="tf-dropdown" @onclick:stopPropagation="true">
    <AuthorizeView>
        <Authorized>
            <button class="tf-user-btn" @onclick="ToggleMenu" aria-label="Tài khoản của tôi">
                <div class="tf-avatar" title="@_displayName">
                    @GetInitials(_displayName)
                </div>
                <span class="tf-user-name">@TruncateName(_displayName)</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"/>
                </svg>
            </button>

            @if (_isOpen)
            {
                <div class="tf-dropdown-menu tf-user-menu">
                    <div class="tf-user-menu-header">
                        <div class="tf-avatar tf-avatar-lg">@GetInitials(_displayName)</div>
                        <div>
                            <div class="tf-font-semibold">@_displayName</div>
                            <div class="tf-text-xs tf-text-muted">@context.User.Identity?.Name</div>
                        </div>
                    </div>

                    <div class="tf-dropdown-divider"></div>

                    <a href="/tai-khoan" class="tf-dropdown-item" @onclick="CloseMenu">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                            <circle cx="12" cy="7" r="4"/>
                        </svg>
                        Tài khoản của tôi
                    </a>

                    <a href="/tai-khoan/doi-mat-khau" class="tf-dropdown-item" @onclick="CloseMenu">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                            <path d="M7 11V7a5 5 0 0110 0v4"/>
                        </svg>
                        Đổi mật khẩu
                    </a>

                    <div class="tf-dropdown-divider"></div>

                    <form action="/Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="/" />
                        <button type="submit" class="tf-dropdown-item danger" @onclick="CloseMenu">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/>
                                <polyline points="16 17 21 12 16 7"/>
                                <line x1="21" y1="12" x2="9" y2="12"/>
                            </svg>
                            Đăng xuất
                        </button>
                    </form>
                </div>
            }
        </Authorized>
        <NotAuthorized>
            <a href="/Account/Login" class="tf-btn tf-btn-primary tf-btn-sm">
                Đăng nhập
            </a>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    private bool _isOpen;
    private string _displayName = "";

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadUserNameAsync();
    }

    private async Task LoadUserNameAsync()
    {
        if (AuthState == null) return;

        var authState = await AuthState;
        var username = authState.User.Identity?.Name;
        if (string.IsNullOrEmpty(username)) return;

        // Try to get FullName from the FullName claim (injected by CustomUserClaimsPrincipalFactory)
        var fullNameClaim = authState.User.FindFirst("FullName")?.Value;
        if (!string.IsNullOrEmpty(fullNameClaim))
        {
            _displayName = fullNameClaim;
            return;
        }

        // Fallback: load from DB via UserManager
        var user = await UserManager.FindByNameAsync(username);
        _displayName = user?.FullName ?? username;
    }

    private void ToggleMenu() => _isOpen = !_isOpen;
    private void CloseMenu() => _isOpen = false;

    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
        return name[0].ToString().ToUpper();
    }

    private static string TruncateName(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "";
        return name.Length > 20 ? name[..17] + "..." : name;
    }
}
