@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using TradeFlow.Infrastructure.Persistence

@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

<div class="tf-dropdown tf-user-dropdown-container" @onkeydown="HandleKeyDown">
    <AuthorizeView>
        <Authorized>
            <button type="button"
                    class="tf-user-btn"
                    aria-label="Tài khoản cá nhân"
                    aria-expanded="@_isOpen"
                    aria-haspopup="true"
                    id="tf-user-menu-btn"
                    @onclick="ToggleDropdown">
                <div class="tf-avatar">@GetInitials(_displayName)</div>
                <div class="tf-user-info">
                    <span class="tf-user-name">@TruncateName(_displayName)</span>
                    <span class="tf-user-role">@TruncateName(_role)</span>
                </div>
                <svg class="tf-user-chevron @(_isOpen ? "expanded" : "")" width="13" height="13" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"/>
                </svg>
            </button>

            @if (_isOpen)
            {
                @* Backdrop capturing outside clicks on desktop and mobile *@
                <div class="tf-dropdown-backdrop"
                     @onclick="CloseDropdown"
                     style="position:fixed;top:0;left:0;right:0;bottom:0;z-index:998;background:transparent;cursor:default;"></div>

                @* Dropdown Menu *@
                <div id="tf-user-menu-dropdown"
                     class="tf-dropdown-menu tf-user-menu show"
                     style="position:absolute;right:0;top:calc(100% + 8px);z-index:999;display:block;"
                     role="menu"
                     aria-orientation="vertical">
                    <div class="tf-user-menu-header">
                        <div class="tf-avatar tf-avatar-lg">@GetInitials(_displayName)</div>
                        <div style="overflow:hidden;">
                            <div class="tf-font-semibold" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@_displayName</div>
                            <div class="tf-text-xs tf-text-muted" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@_username</div>
                            @if (!string.IsNullOrEmpty(_role))
                            {
                                <div style="margin-top:4px;">
                                    <span class="tf-badge tf-badge-primary">@_role</span>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="tf-dropdown-divider"></div>

                    <a href="/tai-khoan" class="tf-dropdown-item" role="menuitem" @onclick="CloseDropdown">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                            <circle cx="12" cy="7" r="4"/>
                        </svg>
                        Tài khoản của tôi
                    </a>

                    <a href="/tai-khoan/doi-mat-khau" class="tf-dropdown-item" role="menuitem" @onclick="CloseDropdown">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                            <path d="M7 11V7a5 5 0 0110 0v4"/>
                        </svg>
                        Đổi mật khẩu
                    </a>

                    <a href="/cai-dat" class="tf-dropdown-item" role="menuitem" @onclick="CloseDropdown">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="3"/>
                            <path d="M19.07 4.93a10 10 0 010 14.14M4.93 4.93a10 10 0 000 14.14"/>
                        </svg>
                        Cài đặt
                    </a>

                    <div class="tf-dropdown-divider"></div>

                    <form action="/Account/Logout" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn đăng xuất khỏi hệ thống?');">
                        <AntiforgeryToken />
                        <input type="hidden" name="returnUrl" value="Account/Login" />
                        <button type="submit" class="tf-dropdown-item danger" role="menuitem" style="width:100%;text-align:left;border:none;background:none;cursor:pointer;">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/>
                                <polyline points="16 17 21 12 16 7"/>
                                <line x1="21" y1="12" x2="9" y2="12"/>
                            </svg>
                            Đăng xuất
                        </button>
                    </form>
                </div>
            }
        </Authorized>
        <NotAuthorized>
            <a href="/Account/Login" class="tf-btn tf-btn-primary tf-btn-sm">
                Đăng nhập
            </a>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    private bool _isOpen = false;
    private string _displayName = "";
    private string _username = "";
    private string _role = "";

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadUserInfoAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrEmpty(_username))
        {
            await LoadUserInfoAsync();
        }
    }

    private async Task LoadUserInfoAsync()
    {
        if (AuthState == null) return;

        var authState = await AuthState;
        var userPrincipal = authState.User;

        _username = userPrincipal.Identity?.Name ?? "";
        if (string.IsNullOrEmpty(_username)) return;

        var fullNameClaim = userPrincipal.FindFirst("FullName")?.Value;
        var roleClaim = userPrincipal.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;

        if (!string.IsNullOrEmpty(fullNameClaim)) _displayName = fullNameClaim;
        if (!string.IsNullOrEmpty(roleClaim)) _role = roleClaim;

        if (string.IsNullOrEmpty(_displayName) || string.IsNullOrEmpty(_role))
        {
            var dbUser = await UserManager.FindByNameAsync(_username);
            if (dbUser != null)
            {
                if (string.IsNullOrEmpty(_displayName)) _displayName = dbUser.FullName ?? _username;
                if (string.IsNullOrEmpty(_role))
                {
                    var roles = await UserManager.GetRolesAsync(dbUser);
                    _role = roles.FirstOrDefault() ?? "";
                }
            }
            else
            {
                _displayName = _username;
            }
        }
    }

    private void ToggleDropdown()
    {
        _isOpen = !_isOpen;
    }

    private void CloseDropdown()
    {
        _isOpen = false;
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseDropdown();
        }
    }

    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2) return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
        return name[0].ToString().ToUpper();
    }

    private static string TruncateName(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "";
        return name.Length > 20 ? name[..17] + "..." : name;
    }
}