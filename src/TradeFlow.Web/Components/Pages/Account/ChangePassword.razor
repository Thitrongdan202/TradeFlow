@page "/tai-khoan/doi-mat-khau"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Domain.Enums
@using TradeFlow.Infrastructure.Persistence
@rendermode InteractiveServer
@attribute [Authorize]

@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuditService AuditService
@inject NavigationManager Nav

<PageTitle>Đổi mật khẩu — TradeFlow</PageTitle>

<div class="tf-page-header">
    <div class="tf-page-header-left">
        <h1 class="tf-page-title">Đổi mật khẩu</h1>
        <p class="tf-page-subtitle">Cập nhật mật khẩu bảo vệ tài khoản cá nhân</p>
    </div>
    <div class="tf-page-actions">
        <a href="/tai-khoan" class="tf-btn tf-btn-secondary">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
            </svg>
            Quay lại tài khoản
        </a>
    </div>
</div>

<div class="tf-card" style="max-width: 520px;">
    <div class="tf-card-body">
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="tf-alert tf-alert-error tf-mb-4">@_errorMessage</div>
        }
        @if (_showSuccess)
        {
            <div class="tf-alert tf-alert-success tf-mb-4">✅ Mật khẩu đã được cập nhật thành công!</div>
        }

        <EditForm Model="_input" OnValidSubmit="OnSubmitAsync">
            <DataAnnotationsValidator />

            @* Mật khẩu hiện tại *@
            <div class="tf-form-group tf-mb-4">
                <label class="tf-label">Mật khẩu hiện tại <span style="color:var(--tf-error);">*</span></label>
                <div style="position:relative;display:flex;align-items:center;">
                    <input type="@(_showOldPassword ? "text" : "password")"
                           class="tf-input"
                           style="padding-right:42px;"
                           @bind="_input.OldPassword"
                           placeholder="Nhập mật khẩu hiện tại" />
                    <button type="button"
                            @onclick="ToggleOldPasswordVisibility"
                            style="position:absolute;right:8px;background:none;border:none;cursor:pointer;color:var(--tf-text-secondary);padding:6px;display:flex;align-items:center;justify-content:center;"
                            title="@(_showOldPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu")"
                            aria-label="@(_showOldPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu")">
                        @if (_showOldPassword)
                        {
                            @* Eye Off SVG *@
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
                                <line x1="1" y1="1" x2="23" y2="23"/>
                            </svg>
                        }
                        else
                        {
                            @* Eye SVG *@
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                            </svg>
                        }
                    </button>
                </div>
                <ValidationMessage For="() => _input.OldPassword" class="tf-validation-message" style="color:var(--tf-error);font-size:12px;margin-top:4px;" />
            </div>

            @* Mật khẩu mới *@
            <div class="tf-form-group tf-mb-4">
                <label class="tf-label">Mật khẩu mới <span style="color:var(--tf-error);">*</span></label>
                <div style="position:relative;display:flex;align-items:center;">
                    <input type="@(_showNewPassword ? "text" : "password")"
                           class="tf-input"
                           style="padding-right:42px;"
                           @bind="_input.NewPassword"
                           placeholder="Tối thiểu 8 ký tự" />
                    <button type="button"
                            @onclick="ToggleNewPasswordVisibility"
                            style="position:absolute;right:8px;background:none;border:none;cursor:pointer;color:var(--tf-text-secondary);padding:6px;display:flex;align-items:center;justify-content:center;"
                            title="@(_showNewPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu")"
                            aria-label="@(_showNewPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu")">
                        @if (_showNewPassword)
                        {
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
                                <line x1="1" y1="1" x2="23" y2="23"/>
                            </svg>
                        }
                        else
                        {
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                            </svg>
                        }
                    </button>
                </div>
                <ValidationMessage For="() => _input.NewPassword" class="tf-validation-message" style="color:var(--tf-error);font-size:12px;margin-top:4px;" />
            </div>

            @* Xác nhận mật khẩu mới *@
            <div class="tf-form-group tf-mb-4">
                <label class="tf-label">Xác nhận mật khẩu mới <span style="color:var(--tf-error);">*</span></label>
                <div style="position:relative;display:flex;align-items:center;">
                    <input type="@(_showConfirmPassword ? "text" : "password")"
                           class="tf-input"
                           style="padding-right:42px;"
                           @bind="_input.ConfirmPassword"
                           placeholder="Nhập lại mật khẩu mới" />
                    <button type="button"
                            @onclick="ToggleConfirmPasswordVisibility"
                            style="position:absolute;right:8px;background:none;border:none;cursor:pointer;color:var(--tf-text-secondary);padding:6px;display:flex;align-items:center;justify-content:center;"
                            title="@(_showConfirmPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu")"
                            aria-label="@(_showConfirmPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu")">
                        @if (_showConfirmPassword)
                        {
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
                                <line x1="1" y1="1" x2="23" y2="23"/>
                            </svg>
                        }
                        else
                        {
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                            </svg>
                        }
                    </button>
                </div>
                <ValidationMessage For="() => _input.ConfirmPassword" class="tf-validation-message" style="color:var(--tf-error);font-size:12px;margin-top:4px;" />
            </div>

            <div style="margin-top:24px;">
                <button type="submit" class="tf-btn tf-btn-primary tf-btn-full" style="justify-content:center;">
                    Đổi mật khẩu
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private InputModel _input = new();
    private string? _errorMessage;
    private bool _showSuccess;

    private bool _showOldPassword = false;
    private bool _showNewPassword = false;
    private bool _showConfirmPassword = false;

    private void ToggleOldPasswordVisibility() => _showOldPassword = !_showOldPassword;
    private void ToggleNewPasswordVisibility() => _showNewPassword = !_showNewPassword;
    private void ToggleConfirmPasswordVisibility() => _showConfirmPassword = !_showConfirmPassword;

    private async Task OnSubmitAsync()
    {
        _errorMessage = null;
        _showSuccess = false;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var username = authState.User.Identity?.Name;
        if (string.IsNullOrEmpty(username)) return;

        var user = await UserManager.FindByNameAsync(username);
        if (user == null) return;

        var result = await UserManager.ChangePasswordAsync(user, _input.OldPassword, _input.NewPassword);
        if (result.Succeeded)
        {
            _showSuccess = true;
            _input = new();
            await AuditService.LogAsync(AuditEventType.PasswordChanged, username, details: "Người dùng tự đổi mật khẩu cá nhân");
        }
        else
        {
            _errorMessage = string.Join(", ", result.Errors.Select(e => e.Description));
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Vui lòng nhập mật khẩu hiện tại.")]
        public string OldPassword { get; set; } = "";

        [Required(ErrorMessage = "Vui lòng nhập mật khẩu mới.")]
        [StringLength(100, ErrorMessage = "Mật khẩu phải từ {2} đến {1} ký tự.", MinimumLength = 8)]
        public string NewPassword { get; set; } = "";

        [Compare("NewPassword", ErrorMessage = "Mật khẩu xác nhận không khớp.")]
        public string ConfirmPassword { get; set; } = "";
    }
}