@code {
    [Parameter]
    public string? ActiveTab { get; set; }

    private string CurrentTab => string.IsNullOrWhiteSpace(ActiveTab) ? "overview" : (ActiveTab.Equals("users", StringComparison.OrdinalIgnoreCase) ? "accounts" : ActiveTab.ToLowerInvariant());

    private bool _isLoading = true;
    private string? _alertMessage;
    private bool _alertSuccess = true;
    private string _currentUsername = "admin";

    // Overview state
    private RoleOverviewDto? _overview;

    // Roles state
    private List<RoleListItemDto>? _roles;
    private List<RoleListItemDto>? _filteredRoles;
    private string _rolesSearchTerm = string.Empty;
    private string _rolesStatusFilter = "all";

    // Matrix state
    private string? _selectedRoleIdForMatrix;
    private List<RolePermissionItemDto> _selectedRoleMatrixPermissions = [];
    private Dictionary<ResourceType, DataScope> _resourceScopes = [];
    private HashSet<string> _expandedGroups = ["Quản trị hệ thống", "Danh mục chính", "Bảng giá & Kinh doanh"];
    private string _matrixSearchTerm = string.Empty;
