    private static string FormatVietnamTime(DateTime utcTime)
    {
        var vnTime = TimeZoneInfo.ConvertTimeFromUtc(
            DateTime.SpecifyKind(utcTime, DateTimeKind.Utc),
            TimeZoneInfo.FindSystemTimeZoneById("SE Asia Standard Time")
        );
        return vnTime.ToString("dd/MM/yyyy HH:mm:ss");
    }

    private static string FormatDate(DateTime utcTime)
    {
        var vnTime = TimeZoneInfo.ConvertTimeFromUtc(
            DateTime.SpecifyKind(utcTime, DateTimeKind.Utc),
            TimeZoneInfo.FindSystemTimeZoneById("SE Asia Standard Time")
        );
        return vnTime.ToString("dd/MM/yyyy");
    }
