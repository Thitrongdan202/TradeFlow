                <textarea class="tf-textarea" rows="2" placeholder="Ví dụ: Xử lý đơn hàng gấp thay cho quản lý kho nghỉ phép; Đối soát hóa đơn cuối tháng..." @bind="_grantTempCmd.Reason"></textarea>
            </div>
        </div>
        <div class="tf-modal-footer">
            <button type="button" class="tf-btn tf-btn-secondary" @onclick="() => _showGrantTemporaryModal = false">Hủy bỏ</button>
            <button type="button" class="tf-btn tf-btn-warning" @onclick="SubmitGrantTemporaryAsync" disabled="@_isSubmittingModal">Xác nhận cấp quyền</button>
        </div>
    </div>
}

