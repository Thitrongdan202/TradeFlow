                    <button type="button" class="tf-btn tf-btn-xs @(_grantTempCmd.DurationMinutes == 60 ? "tf-btn-primary" : "tf-btn-secondary")" @onclick="@(() => _grantTempCmd.DurationMinutes = 60)">60 phút (1h)</button>
