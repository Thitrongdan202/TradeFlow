            new(ResourceType.Warehouses, "Kho hàng & Địa điểm")
        ]),
        new("Bảng giá & Kinh doanh", [
            new(ResourceType.PriceLists, "Bảng giá sản phẩm"),
            new(ResourceType.Quotations, "Báo giá thương mại"),
            new(ResourceType.SalesOrders, "Đơn bán hàng"),
            new(ResourceType.Invoices, "Hóa đơn VAT & Bán lẻ"),
            new(ResourceType.Documents, "Tài liệu & Chứng từ")
        ]),
        new("An ninh & Chữ ký số", [
            new(ResourceType.Security, "An ninh & Bảo mật hệ thống"),
            new(ResourceType.DigitalSignatures, "Chữ ký số RSA & Người ký")
        ]),
        new("Nhân sự & Chấm công", [
            new(ResourceType.Employees, "Hồ sơ nhân viên"),
            new(ResourceType.EmployeeRequests, "Yêu cầu thêm nhân viên"),
            new(ResourceType.Departments, "Phòng ban cơ cấu"),
            new(ResourceType.Positions, "Chức danh & Vị trí"),
            new(ResourceType.Attendance, "Chấm công & Điểm danh"),
            new(ResourceType.Accounts, "Quản lý tài khoản đăng nhập")
        ]),
        new("Hợp đồng & Phụ lục", [
            new(ResourceType.Contracts, "Hợp đồng thương mại & B2B"),
            new(ResourceType.EmploymentContracts, "Hợp đồng lao động nhân sự")
        ])
    ];

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _currentUsername = authState.User.Identity?.Name ?? "admin";
        await LoadHubDataAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_isLoading)
        {
            await RefreshActiveTabAsync();
        }
    }

    private async Task LoadHubDataAsync()
    {
        _isLoading = true;
        try
        {
            _overview = await RoleService.GetOverviewAsync();
            _roles = await RoleService.GetRolesAsync();
            FilterRoles();

            if (!string.IsNullOrEmpty(_selectedRoleIdForMatrix))
            {
                await LoadMatrixForRoleAsync(_selectedRoleIdForMatrix);
            }
            else if (_roles.Any())
            {
                var targetRole = _roles.FirstOrDefault(r => r.Name == "Sales") ?? _roles.First();
                _selectedRoleIdForMatrix = targetRole.Id;
                await LoadMatrixForRoleAsync(_selectedRoleIdForMatrix);
            }

            _accountAssignments = await RoleService.GetUserRoleAssignmentsAsync();
            FilterAccounts();

            _temporaryAssignments = await RoleService.GetTemporaryRoleAssignmentsAsync();

            // Load audit logs filtered for RBAC
            await LoadAuditLogsAsync();
        }
        catch (Exception ex)
        {
            _alertMessage = "Lỗi khi tải dữ liệu phân quyền: " + ex.Message;
            _alertSuccess = false;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RefreshActiveTabAsync()
    {
        if (CurrentTab == "overview")
        {
            _overview = await RoleService.GetOverviewAsync();
        }
        else if (CurrentTab == "roles")
        {
            _roles = await RoleService.GetRolesAsync();
            FilterRoles();
        }
        else if (CurrentTab == "matrix" && !string.IsNullOrEmpty(_selectedRoleIdForMatrix))
        {
            await LoadMatrixForRoleAsync(_selectedRoleIdForMatrix);
        }
        else if (CurrentTab == "accounts")
        {
            _accountAssignments = await RoleService.GetUserRoleAssignmentsAsync();
            FilterAccounts();
        }
        else if (CurrentTab == "temporary")
        {
            _temporaryAssignments = await RoleService.GetTemporaryRoleAssignmentsAsync();
        }
        else if (CurrentTab == "audit")
        {
            await LoadAuditLogsAsync();
        }
    }

    private async Task LoadAuditLogsAsync()
    {
        var rbacTypes = new[]
        {
            AuditEventType.RoleCreated,
            AuditEventType.RoleUpdated,
            AuditEventType.RoleDeleted,
            AuditEventType.RoleCloned,
            AuditEventType.RolePermissionsUpdated,
            AuditEventType.UserRoleAssigned,
            AuditEventType.UserRoleRevoked,
            AuditEventType.TemporaryRoleGranted,
            AuditEventType.TemporaryRoleRevoked,
            AuditEventType.TemporaryRoleExpired,
            AuditEventType.DataScopeChanged,
            AuditEventType.UnauthorizedAccessAttempt
        };

        _auditLogs = await DbContext.AuditLogs
            .AsNoTracking()
            .Where(a => rbacTypes.Contains(a.EventType))
            .OrderByDescending(a => a.OccurredAt)
            .Take(100)
            .ToListAsync();

        FilterAuditLogs();
    }

    private void SwitchTab(string tab)
    {
        _alertMessage = null;
        Nav.NavigateTo($"/cai-dat/phan-quyen/{tab}");
    }

    private void FilterRoles()
    {
        if (_roles == null) return;
        var query = _roles.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_rolesSearchTerm))
        {
            var term = _rolesSearchTerm.Trim();
            query = query.Where(r => r.Name.Contains(term, StringComparison.OrdinalIgnoreCase) || (r.Description != null && r.Description.Contains(term, StringComparison.OrdinalIgnoreCase)));
        }

        if (_rolesStatusFilter == "active")
            query = query.Where(r => r.IsActive);
        else if (_rolesStatusFilter == "inactive")
            query = query.Where(r => !r.IsActive);

        _filteredRoles = query.ToList();
    }

    private void FilterAccounts()
    {
        if (_accountAssignments == null) return;
        var query = _accountAssignments.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_accountsSearchTerm))
        {
            var term = _accountsSearchTerm.Trim();
            query = query.Where(a => a.UserName.Contains(term, StringComparison.OrdinalIgnoreCase)
                                  || a.FullName.Contains(term, StringComparison.OrdinalIgnoreCase)
                                  || a.Email.Contains(term, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(_accountsRoleFilter))
        {
            query = query.Where(a => string.Equals(a.BaseRoleName, _accountsRoleFilter, StringComparison.OrdinalIgnoreCase)
                                  || string.Equals(a.SecondaryRoleName, _accountsRoleFilter, StringComparison.OrdinalIgnoreCase));
        }

        _filteredAccountAssignments = query.ToList();
    }

    private void FilterAuditLogs()
    {
        if (_auditLogs == null) return;
        var query = _auditLogs.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_auditSearchTerm))
        {
            var term = _auditSearchTerm.Trim();
            query = query.Where(l => l.PerformedBy.Contains(term, StringComparison.OrdinalIgnoreCase)
                                  || (l.Details != null && l.Details.Contains(term, StringComparison.OrdinalIgnoreCase))
                                  || (l.TargetId != null && l.TargetId.Contains(term, StringComparison.OrdinalIgnoreCase)));
        }

        _filteredAuditLogs = query.ToList();
    }

    private async Task ConfigureRolePermissions(string roleId)
    {
        _selectedRoleIdForMatrix = roleId;
        await LoadMatrixForRoleAsync(roleId);
        SwitchTab("matrix");
    }

    private async Task OnMatrixRoleChanged(ChangeEventArgs e)
    {
        var roleId = e.Value?.ToString();
        if (!string.IsNullOrEmpty(roleId))
        {
            _selectedRoleIdForMatrix = roleId;
            await LoadMatrixForRoleAsync(roleId);
        }
    }

    private async Task LoadMatrixForRoleAsync(string roleId)
    {
        var perms = await RoleService.GetRolePermissionsAsync(roleId);
        _selectedRoleMatrixPermissions = perms;

        _resourceScopes.Clear();
        foreach (var p in perms)
        {
            if (!_resourceScopes.ContainsKey(p.Resource) || _resourceScopes[p.Resource] < p.Scope)
            {
                _resourceScopes[p.Resource] = p.Scope;
            }
        }
    }

    private bool IsGroupExpanded(string groupName) => _expandedGroups.Contains(groupName);

    private void ToggleGroupExpanded(string groupName)
    {
        if (_expandedGroups.Contains(groupName))
            _expandedGroups.Remove(groupName);
        else
            _expandedGroups.Add(groupName);
    }

    private void SelectAllGroupPermissions(ModuleGroupMeta group, bool grant)
    {
        var actions = new[]
        {
            PermissionAction.View, PermissionAction.ViewDetail, PermissionAction.Create,
            PermissionAction.Edit, PermissionAction.Delete, PermissionAction.Export,
            PermissionAction.Print, PermissionAction.Approve, PermissionAction.Reject,
            PermissionAction.ManageConfig
        };

        foreach (var res in group.Resources)
        {
            var scope = _resourceScopes.GetValueOrDefault(res.Resource, DataScope.All);
            foreach (var act in actions)
            {
                var existing = _selectedRoleMatrixPermissions.FirstOrDefault(p => p.Resource == res.Resource && p.Action == act);
                if (existing != null)
                {
                    existing.IsGranted = grant;
                    existing.Scope = scope;
                }
                else if (grant)
                {
                    _selectedRoleMatrixPermissions.Add(new RolePermissionItemDto
                    {
                        Resource = res.Resource,
                        Action = act,
                        IsGranted = true,
                        Scope = scope
                    });
                }
            }
        }
    }

    private RenderFragment RenderActionToggle(ResourceType resource, PermissionAction action, bool isSensitive = false) => builder =>
    {
        var perm = _selectedRoleMatrixPermissions.FirstOrDefault(p => p.Resource == resource && p.Action == action);
        bool isGranted = perm?.IsGranted ?? false;

        builder.OpenElement(0, "label");
        builder.AddAttribute(1, "class", $"tf-toggle-wrap {(isSensitive ? "sensitive-perm" : "")}");

        builder.OpenElement(2, "input");
        builder.AddAttribute(3, "type", "checkbox");
        builder.AddAttribute(4, "checked", isGranted);
        builder.AddAttribute(5, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, (e) => ToggleSinglePermission(resource, action, e)));
        builder.CloseElement(); // input

        builder.OpenElement(6, "span");
        builder.AddAttribute(7, "class", "tf-toggle-slider");
        builder.CloseElement(); // span

        if (isSensitive)
        {
            builder.OpenElement(8, "span");
            builder.AddAttribute(9, "class", "tf-sensitive-flag");
            builder.AddAttribute(10, "title", "Quyền thao tác nhạy cảm");
            builder.AddContent(11, "!");
            builder.CloseElement();
        }

        builder.CloseElement(); // label
    };

    private void ToggleSinglePermission(ResourceType resource, PermissionAction action, ChangeEventArgs e)
    {
        bool granted = (bool)(e.Value ?? false);
        var perm = _selectedRoleMatrixPermissions.FirstOrDefault(p => p.Resource == resource && p.Action == action);
        var scope = _resourceScopes.GetValueOrDefault(resource, DataScope.All);

        if (perm != null)
        {
            perm.IsGranted = granted;
            perm.Scope = scope;
        }
        else if (granted)
        {
            _selectedRoleMatrixPermissions.Add(new RolePermissionItemDto
            {
                Resource = resource,
                Action = action,
                IsGranted = true,
                Scope = scope
            });
        }
    }

    private int GetResourceScope(ResourceType resource)
    {
        return (int)_resourceScopes.GetValueOrDefault(resource, DataScope.All);
    }

    private void SetResourceScope(ResourceType resource, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            var scope = (DataScope)val;
            _resourceScopes[resource] = scope;
            foreach (var p in _selectedRoleMatrixPermissions.Where(p => p.Resource == resource))
            {
                p.Scope = scope;
            }
        }
    }

    private async Task SaveMatrixPermissionsAsync()
    {
        if (string.IsNullOrEmpty(_selectedRoleIdForMatrix)) return;

        _isSavingMatrix = true;
        try
        {
            var (success, error) = await RoleService.UpdateRolePermissionsAsync(
                _selectedRoleIdForMatrix,
                _selectedRoleMatrixPermissions.Where(p => p.IsGranted).ToList(),
                _currentUsername
            );

            if (success)
            {
                _alertMessage = "Đã lưu ma trận phân quyền thành công và xóa bộ nhớ cache phân quyền!";
                _alertSuccess = true;
                _roles = await RoleService.GetRolesAsync();
                FilterRoles();
            }
            else
            {
                _alertMessage = error ?? "Lỗi khi lưu quyền.";
                _alertSuccess = false;
            }
        }
        catch (Exception ex)
        {
            _alertMessage = "Lỗi khi lưu ma trận quyền: " + ex.Message;
            _alertSuccess = false;
        }
        finally
        {
            _isSavingMatrix = false;
        }
    }

