    // Accounts state
    private List<UserRoleAssignmentDto>? _accountAssignments;
    private List<UserRoleAssignmentDto>? _filteredAccountAssignments;
    private string _accountsSearchTerm = string.Empty;
    private string _accountsRoleFilter = string.Empty;

    // Temporary grants state
    private List<TemporaryRoleAssignmentItemDto>? _temporaryAssignments;

    // Audit logs state
    private List<TradeFlow.Domain.Entities.Users.AuditLog>? _auditLogs;
    private List<TradeFlow.Domain.Entities.Users.AuditLog>? _filteredAuditLogs;
    private string _auditSearchTerm = string.Empty;

    // Modal controls
    private bool _showCreateRoleModal = false;
    private CreateRoleCommand _createRoleCmd = new();
    private bool _showEditRoleModal = false;
    private UpdateRoleCommand? _editRoleCmd;
    private bool _showCloneRoleModal = false;
    private RoleListItemDto? _cloneSourceRole;
    private string _cloneNewName = string.Empty;
    private string? _cloneNewDesc;
    private bool _showGrantTemporaryModal = false;
    private GrantTemporaryRoleCommand _grantTempCmd = new();
    private bool _showAssignSecondaryModal = false;
    private UserRoleAssignmentDto? _selectedAccountForSecondary;
    private string _selectedSecondaryRoleId = string.Empty;
    private string? _modalError;
    private bool _isSubmittingModal = false;

    private readonly string[] _colorPresets =
    [
        "#4f46e5", "#059669", "#d97706", "#dc2626",
        "#8b5cf6", "#ec4899", "#06b6d4", "#64748b"
    ];

    private record ResourceMeta(ResourceType Resource, string Title);
    private record ModuleGroupMeta(string GroupName, List<ResourceMeta> Resources);

    private readonly List<ModuleGroupMeta> _moduleGroups =
    [
        new("Quản trị hệ thống", [
            new(ResourceType.Users, "Người dùng & Tài khoản"),
            new(ResourceType.Roles, "Vai trò & Phân quyền"),
            new(ResourceType.CompanySettings, "Cài đặt công ty & Thương hiệu"),
            new(ResourceType.AuditLog, "Nhật ký hệ thống & Kiểm toán"),
            new(ResourceType.TechnicalSupport, "Hỗ trợ kỹ thuật từ xa")
        ]),
        new("Danh mục chính", [
            new(ResourceType.Products, "Sản phẩm & Hàng hóa"),
            new(ResourceType.ProductCategories, "Danh mục sản phẩm"),
            new(ResourceType.UnitOfMeasures, "Đơn vị tính"),
            new(ResourceType.Currencies, "Loại tiền & Tỷ giá"),
            new(ResourceType.Customers, "Khách hàng (Đối tác)"),
