                        @foreach (var u in _accountAssignments.Where(a => a.UserName != "admin"))
                        {
                            <option value="@u.UserId">@u.UserName (@u.FullName) — Role 1: @u.BaseRoleName @(!string.IsNullOrEmpty(u.SecondaryRoleName) ? $"[Đã có Role 2: {u.SecondaryRoleName}]" : "")</option>
