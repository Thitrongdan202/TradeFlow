                    <button type="button" class="tf-btn tf-btn-xs @(_grantTempCmd.DurationMinutes == 120 ? "tf-btn-primary" : "tf-btn-secondary")" @onclick="@(() => _grantTempCmd.DurationMinutes = 120)">120 phút (2h max)</button>
