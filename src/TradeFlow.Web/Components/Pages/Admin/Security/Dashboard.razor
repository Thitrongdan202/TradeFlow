    private async Task ExecuteChangePin()
    {
        if (_selectedSignerToChangePin == null) return;
        if (string.IsNullOrWhiteSpace(_changeCurrentPin))
        {
            _changePinError = "Vui lòng nhập mã PIN hiện tại.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_changeNewPin) || _changeNewPin.Length < _settings.PinMinLength)
        {
            _changePinError = $"Mã PIN mới phải có tối thiểu {_settings.PinMinLength} ký tự.";
            return;
        }
        if (_changeNewPin != _changeConfirmPin)
        {
            _changePinError = "Mật mã PIN xác nhận không khớp.";
            return;
        }

        _isChangingPin = true;
        _changePinError = null;
        try
        {
            var res = await SecurityService.ChangeSignerPinAsync(_selectedSignerToChangePin.Id, _changeCurrentPin, _changeNewPin, _currentUsername ?? "Admin");
            if (!res.Succeeded)
            {
                _changePinError = res.ErrorMessage;
                return;
            }

            _showChangePinModal = false;
            _globalMessage = $"Đổi mã PIN thành công cho người ký {_selectedSignerToChangePin.FullName}!";
            _globalSuccess = true;
            await LoadAllDataAsync();
        }
        catch (Exception ex)
        {
            _changePinError = "Lỗi khi đổi PIN: " + ex.Message;
        }
        finally
        {
            _isChangingPin = false;
        }
    }

