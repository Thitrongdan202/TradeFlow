}

@code {
    private string _activeTab = "overview";
    private bool _isLoading = true;
    private string? _globalMessage;
    private bool _globalSuccess;
    private string? _currentUsername;
    private bool _codeHasExpiration = true;

    // Setup PIN Modal (for pre-provisioned signers without credential)
    private bool _showSetupPinModal;
    private SignerIdentityDto? _selectedSignerToSetup;
    private string _setupPin = "";
    private string _setupConfirmPin = "";
    private bool _isSettingUpPin;
    private string? _setupPinError;

    // Change PIN Modal
    private bool _showChangePinModal;
    private SignerIdentityDto? _selectedSignerToChangePin;
    private string _changeCurrentPin = "";
    private string _changeNewPin = "";
    private string _changeConfirmPin = "";
    private bool _isChangingPin;
    private string? _changePinError;

    // Admin Reset PIN Modal
    private bool _showAdminResetPinModal;
    private SignerIdentityDto? _selectedSignerToResetPin;
    private string _adminResetReason = "";
    private bool _isResettingPin;
    private string? _adminResetError;

    // Edit Signature Image Modal
    private bool _showEditSignatureModal;
    private SignerIdentityDto? _selectedSignerToEditSig;
    private string _editSignatureImage = "";
    private bool _isSavingSig;
    private string? _editSigError;

    private SecurityDashboardStats _stats = new();
    private List<SecurityAlertDto> _alerts = new();
    private List<SignerIdentityDto> _signers = new();
    private List<SignerEnrollmentCodeDto> _enrollmentCodes = new();
    private List<DocumentSignatureAuditDto> _audits = new();
    private CompanySecuritySettings _settings = new();
    private List<ApplicationUser> _availableUsers = new();
    private List<Invoice> _recentInvoices = new();

    // Verify Tab
    private int _selectedVerifyInvoiceId = 0;
    private bool _isVerifying = false;
    private SignatureVerificationResult? _manualVerifyResult;

    // Issue Code Modal
    private bool _showIssueCodeModal;
    private string _targetUserId = "";
    private SignerRole _targetSignerRole = SignerRole.AuthorizedSigner;
    private string _targetPosition = "";
    private int _codeExpirationMinutes = 1440;
    private bool _isProcessingIssueCode;
    private string? _issueCodeError;
    private IssuedEnrollmentCodeResult? _newlyIssuedCode;

    // Enroll Signer Modal
    private bool _showEnrollSignerModal;
    private string _enrollRawCode = "";
    private string _enrollPin = "";
    private string _enrollConfirmPin = "";
    private bool _isEnrolling;
    private string? _enrollError;

    // Revoke Signer Modal
    private bool _showRevokeSignerModal;
    private SignerIdentityDto? _selectedSignerToRevoke;
    private string _revokeReason = "";
    private bool _isRevoking;
    private string? _revokeError;

    // Revoke Code Modal
    private bool _showRevokeCodeModal;
    private SignerEnrollmentCodeDto? _selectedCodeToRevoke;
    private string _revokeCodeReason = "";
    private string? _revokeCodeError;

    // Settings save
    private bool _isSavingSettings;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        _currentUsername = auth.User.Identity?.Name ?? "Admin";
        await LoadAllDataAsync();
    }

    private async Task LoadAllDataAsync()
    {
        _isLoading = true;
        try
        {
            _stats = await SecurityService.GetDashboardStatsAsync();
            _alerts = await SecurityService.GetSecurityAlertsAsync();
            _signers = await SecurityService.GetAllSignersAsync();
            _enrollmentCodes = await SecurityService.GetEnrollmentCodesAsync();
            _audits = await SecurityService.GetSignatureAuditsAsync(50);
            _settings = await SecurityService.GetSecuritySettingsAsync();

            _availableUsers = await UserManager.Users
                .Where(u => u.Status == UserStatus.Active)
                .OrderBy(u => u.FullName)
                .ToListAsync();

            _recentInvoices = await DbContext.Invoices
                .OrderByDescending(x => x.Id)
                .Take(30)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            _globalMessage = "Lỗi khi tải dữ liệu an ninh: " + ex.Message;
            _globalSuccess = false;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadAuditLogsAsync()
    {
        _audits = await SecurityService.GetSignatureAuditsAsync(50);
    }

    private void OpenIssueCodeModal()
    {
        _targetUserId = "";
        _targetSignerRole = SignerRole.AuthorizedSigner;
        _targetPosition = "";
        _codeExpirationMinutes = _settings.EnrollmentCodeExpirationMinutes > 0 ? _settings.EnrollmentCodeExpirationMinutes : 1440;
        _issueCodeError = null;
        _showIssueCodeModal = true;
    }

    private async Task ExecuteIssueCode()
    {
        if (string.IsNullOrEmpty(_targetUserId))
        {
            _issueCodeError = "Vui lòng chọn nhân viên nhận ủy quyền.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_targetPosition))
        {
            _issueCodeError = "Vui lòng nhập chức danh người ký.";
            return;
        }

        _isProcessingIssueCode = true;
        _issueCodeError = null;
        try
        {
            var res = await SecurityService.IssueEnrollmentCodeAsync(
                _targetUserId,
                _targetSignerRole,
                _targetPosition.Trim(),
                _codeHasExpiration,
                _codeHasExpiration ? _codeExpirationMinutes : null,
                _currentUsername ?? "Admin");

            if (!res.Succeeded)
            {
                _issueCodeError = res.ErrorMessage;
                return;
            }

            _showIssueCodeModal = false;
            _newlyIssuedCode = res;
            await LoadAllDataAsync();
        }
        catch (Exception ex)
        {
            _issueCodeError = "Lỗi tạo mã: " + ex.Message;
        }
        finally
        {
            _isProcessingIssueCode = false;
        }
    }

    private void CloseNewlyIssuedCodeModal()
    {
        _newlyIssuedCode = null;
    }

    private void OpenEnrollModal()
    {
        _enrollRawCode = "";
        _enrollPin = "";
        _enrollConfirmPin = "";
        _enrollError = null;
        _showEnrollSignerModal = true;
    }

    private async Task ExecuteEnrollSigner()
    {
        if (string.IsNullOrWhiteSpace(_enrollRawCode))
        {
            _enrollError = "Vui lòng nhập mã kích hoạt.";
            return;
        }
        if (string.IsNullOrEmpty(_enrollPin) || _enrollPin.Length < _settings.PinMinLength)
        {
            _enrollError = $"Mã PIN phải có tối thiểu {_settings.PinMinLength} ký tự.";
            return;
        }
        if (_enrollPin != _enrollConfirmPin)
        {
            _enrollError = "Mật mã PIN xác nhận không khớp.";
            return;
        }

        _isEnrolling = true;
        _enrollError = null;
        try
        {
            var res = await SecurityService.EnrollSignerAsync(_enrollRawCode.Trim(), _enrollPin, _currentUsername);
            if (!res.Succeeded)
            {
                _enrollError = res.ErrorMessage;
                return;
            }

            _showEnrollSignerModal = false;
            _globalMessage = $"Kích hoạt thành công chứng thư ký số cho {res.FullName} (Sê-ri: {res.CertificateSerialNumber})!";
            _globalSuccess = true;
            await LoadAllDataAsync();
        }
        catch (Exception ex)
        {
            _enrollError = "Lỗi kích hoạt: " + ex.Message;
        }
        finally
        {
            _isEnrolling = false;
        }
    }

    private void PromptRevokeSigner(SignerIdentityDto signer)
    {
        _selectedSignerToRevoke = signer;
        _revokeReason = "";
        _revokeError = null;
        _showRevokeSignerModal = true;
    }

    private async Task ExecuteRevokeSigner()
    {
        if (_selectedSignerToRevoke == null) return;
        if (string.IsNullOrWhiteSpace(_revokeReason))
        {
            _revokeError = "Vui lòng nhập lý do thu hồi.";
            return;
        }

        _isRevoking = true;
        _revokeError = null;
        try
        {
            var ok = await SecurityService.RevokeSignerAsync(_selectedSignerToRevoke.Id, _revokeReason.Trim(), _currentUsername ?? "Admin");
            if (!ok)
            {
                _revokeError = "Không thể thu hồi chứng thư này.";
                return;
            }

            _showRevokeSignerModal = false;
            _globalMessage = $"Đã thu hồi chứng thư ký số của {_selectedSignerToRevoke.FullName}.";
            _globalSuccess = true;
            await LoadAllDataAsync();
        }
        catch (Exception ex)
        {
            _revokeError = "Lỗi khi thu hồi: " + ex.Message;
        }
        finally
        {
            _isRevoking = false;
        }
    }

    private void PromptRevokeCode(SignerEnrollmentCodeDto code)
    {
        _selectedCodeToRevoke = code;
        _revokeCodeReason = "";
        _revokeCodeError = null;
        _showRevokeCodeModal = true;
    }

    private async Task ExecuteRevokeCode()
    {
        if (_selectedCodeToRevoke == null) return;
        if (string.IsNullOrWhiteSpace(_revokeCodeReason))
        {
            _revokeCodeError = "Vui lòng nhập lý do hủy mã.";
            return;
        }

        try
        {
            var ok = await SecurityService.RevokeEnrollmentCodeAsync(_selectedCodeToRevoke.Id, _revokeCodeReason.Trim(), _currentUsername ?? "Admin");
            if (ok)
            {
                _showRevokeCodeModal = false;
                _globalMessage = "Đã hủy mã kích hoạt thành công.";
                _globalSuccess = true;
                await LoadAllDataAsync();
            }
            else
            {
                _revokeCodeError = "Không thể hủy mã kích hoạt này.";
            }
        }
        catch (Exception ex)
        {
            _revokeCodeError = "Lỗi khi hủy mã: " + ex.Message;
        }
    }

    private async Task VerifySelectedInvoice()
    {
        if (_selectedVerifyInvoiceId <= 0) return;
        _isVerifying = true;
        _manualVerifyResult = null;
        try
        {
            _manualVerifyResult = await InvoiceService.VerifyInvoiceSignatureAsync(_selectedVerifyInvoiceId, _currentUsername);
            await LoadAllDataAsync();
        }
        catch (Exception ex)
        {
            _globalMessage = "Lỗi xác minh hóa đơn: " + ex.Message;
            _globalSuccess = false;
        }
        finally
        {
            _isVerifying = false;
        }
    }

