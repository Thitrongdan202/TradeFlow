    private void PromptSetupPin(SignerIdentityDto signer)
    {
        _selectedSignerToSetup = signer;
        _setupPin = "";
        _setupConfirmPin = "";
        _setupPinError = null;
        _showSetupPinModal = true;
    }

    private async Task ExecuteSetupPin()
    {
        if (_selectedSignerToSetup == null) return;
        if (string.IsNullOrWhiteSpace(_setupPin) || _setupPin.Length < _settings.PinMinLength)
        {
            _setupPinError = $"Mã PIN phải có tối thiểu {_settings.PinMinLength} ký tự.";
            return;
        }
        if (_setupPin != _setupConfirmPin)
        {
            _setupPinError = "Mật mã PIN xác nhận không khớp.";
            return;
        }

        _isSettingUpPin = true;
        _setupPinError = null;
        try
        {
            var res = await SecurityService.SetupSignerPinAndCredentialAsync(_selectedSignerToSetup.Id, _setupPin, _currentUsername ?? "Admin");
            if (!res.Succeeded)
            {
                _setupPinError = res.ErrorMessage;
                return;
            }

            _showSetupPinModal = false;
            _globalMessage = $"Thiết lập mã PIN và cặp khóa RSA thành công cho {_selectedSignerToSetup.FullName}!";
            _globalSuccess = true;
            await LoadAllDataAsync();
        }
        catch (Exception ex)
        {
            _setupPinError = "Lỗi thiết lập PIN: " + ex.Message;
        }
        finally
        {
            _isSettingUpPin = false;
        }
    }

    private void PromptChangePin(SignerIdentityDto signer)
    {
        _selectedSignerToChangePin = signer;
