@page "/cai-dat/nguoi-dung/bao-mat"
@page "/cai-dat/nguoi-dung/dat-lai-mat-khau"
@page "/cai-dat/nguoi-dung/{UserId}/bao-mat"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Domain.Entities.Users
@using TradeFlow.Domain.Enums
@using TradeFlow.Infrastructure.Persistence
@attribute [Authorize(Policy = "Permission:Users:View")]

@inject UserManager<ApplicationUser> UserManager
@inject ISecurityService SecurityService
@inject ICredentialVaultService VaultService
@inject IAuditService AuditService
@inject TradeFlowDbContext DbContext
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Quản trị thông tin xác thực ROOT — TradeFlow</PageTitle>

<div class="tf-page-header">
    <div class="tf-page-header-left">
        <div class="tf-breadcrumb">
            <a href="/cai-dat" class="tf-breadcrumb-link">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
                Cài đặt
            </a>
            <span class="tf-breadcrumb-sep">/</span>
            <a href="/cai-dat/nguoi-dung" class="tf-breadcrumb-link">Quản lý người dùng</a>
            <span class="tf-breadcrumb-sep">/</span>
            <span class="tf-breadcrumb-current">Bảo mật &amp; Đặt lại mật khẩu ROOT</span>
        </div>
        <div style="display:flex;align-items:center;gap:10px;margin-top:4px;">
            <div style="width:36px;height:36px;border-radius:8px;background:linear-gradient(135deg,#4f46e5,#0ea5e9);display:flex;align-items:center;justify-content:center;color:#fff;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0110 0v4"/>
                </svg>
            </div>
            <div>
                <h1 class="tf-page-title" style="margin:0;font-size:20px;">Quản trị thông tin xác thực ROOT</h1>
                <p class="tf-page-subtitle" style="margin:2px 0 0;">Đặc quyền ROOT: Kiểm soát thông tin đăng nhập, giải mã mật khẩu hiện tại, thu hồi phiên và bảo vệ an ninh toàn hệ thống</p>
            </div>
        </div>
    </div>
    <div class="tf-page-actions">
        <a href="/cai-dat/nguoi-dung" class="tf-btn tf-btn-secondary">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
            </svg>
            Danh sách người dùng
        </a>
        <a href="/cai-dat/nhat-ky-he-thong" class="tf-btn tf-btn-ghost">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
            Nhật ký kiểm toán
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(_globalMessage))
{
    <div class="tf-alert @(_globalSuccess ? "tf-alert-success" : "tf-alert-error") tf-mb-4" style="display:flex; justify-content:space-between; align-items:center;">
        <div>@_globalMessage</div>
        <button class="tf-btn tf-btn-ghost tf-btn-sm" style="padding:2px 8px;" @onclick="() => _globalMessage = null">&times;</button>
    </div>
}

@if (_latestResetResult != null)
{
    <div class="tf-card tf-mb-4" style="background:linear-gradient(135deg,#ecfdf5,#f0fdf4);border:1px solid #86efac;box-shadow:0 4px 12px rgba(16,185,129,0.1);">
        <div class="tf-card-body" style="padding:20px;">
            <div style="display:flex;align-items:flex-start;justify-content:space-between;">
                <div style="display:flex;gap:14px;">
                    <div style="width:40px;height:40px;border-radius:10px;background:#10b981;color:#fff;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                    </div>
                    <div>
                        <h3 style="margin:0 0 6px;font-size:16px;font-weight:700;color:#065f46;">
                            Cấp mật khẩu mới thành công cho tài khoản: @_latestResetResult.UserName
                        </h3>
                        <p style="margin:0 0 12px;font-size:13px;color:#047857;">
                            Toàn bộ phiên đăng nhập cũ trên mọi thiết bị đã bị thu hồi ngay lập tức. Hãy gửi thông tin đăng nhập dưới đây cho người dùng:
                        </p>
                        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
                            <div style="font-family:monospace;font-size:18px;font-weight:700;letter-spacing:1px;background:#fff;padding:8px 16px;border-radius:8px;border:1px solid #6ee7b7;color:#0f172a;">
                                @_latestResetResult.TempPassword
                            </div>
                            <button class="tf-btn tf-btn-primary tf-btn-sm" @onclick="() => CopyToClipboard(_latestResetResult.TempPassword)">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                                </svg>
                                <span>@(_copiedText == _latestResetResult.TempPassword ? "Đã sao chép!" : "Sao chép mật khẩu")</span>
                            </button>
                        </div>
                    </div>
                </div>
                <button class="tf-btn tf-btn-ghost tf-btn-sm" @onclick="() => _latestResetResult = null">&times;</button>
            </div>
        </div>
    </div>
}

<div class="tf-dashboard-grid" style="grid-template-columns: 1fr 1.6fr; gap: 20px; margin-bottom: 24px;">
    @* CỘT TRÁI: DANH SÁCH & CHỌN NGƯỜI DÙNG *@
    <div class="tf-card">
        <div class="tf-card-header" style="display:flex;justify-content:space-between;align-items:center;">
            <h2 class="tf-card-title" style="font-size:15px;margin:0;">1. Chọn tài khoản cần kiểm soát</h2>
            <span style="font-size:12px;color:var(--tf-text-muted);">@(_allUsers?.Count ?? 0) tài khoản</span>
        </div>
        <div class="tf-card-body">
            @* Ô tìm kiếm *@
            <div style="position:relative;margin-bottom:12px;">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                     style="position:absolute;left:10px;top:50%;transform:translateY(-50%);color:var(--tf-text-muted);pointer-events:none;">
                    <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
                <input type="text"
                       class="tf-input"
                       style="padding-left:32px;font-size:13px;"
                       placeholder="Tìm username, họ tên, email..."
                       @bind="_userSearchQuery"
                       @bind:event="oninput" />
            </div>

            @if (_allUsers == null)
            {
                <div style="text-align:center;padding:24px;color:var(--tf-text-muted);font-size:13px;">Đang tải danh sách tài khoản...</div>
            }
            else
            {
                <div style="max-height: 480px; overflow-y: auto; display: flex; flex-direction: column; gap: 6px; padding-right: 4px;">
                    @foreach (var u in FilteredUsers)
                    {
                        var isSelected = _selectedUser?.Id == u.User.Id;
                        <div @onclick="() => SelectUser(u.User)"
                             style="padding:10px 12px;border-radius:8px;border:1px solid @(isSelected ? "var(--tf-primary, #4f46e5)" : "var(--tf-border, #e2e8f0)");background:@(isSelected ? "rgba(79,70,229,0.06)" : "var(--tf-surface, #fff)");cursor:pointer;transition:all 0.15s ease;display:flex;align-items:center;justify-content:space-between;">
                            <div style="display:flex;align-items:center;gap:10px;">
                                <div style="width:34px;height:34px;border-radius:50%;background:@(u.User.UserName == "admin" ? "linear-gradient(135deg,#f59e0b,#d97706)" : "linear-gradient(135deg,#6366f1,#8b5cf6)");color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px;">
                                    @(u.User.UserName?[..Math.Min(2, u.User.UserName.Length)].ToUpper())
                                </div>
                                <div>
                                    <div style="font-weight:600;font-size:13px;color:var(--tf-text-primary);">
                                        @u.User.FullName
                                        @if (u.User.UserName == "admin")
                                        {
                                            <span style="background:#fef3c7;color:#b45309;font-size:10px;padding:2px 6px;border-radius:4px;font-weight:700;margin-left:4px;">ROOT</span>
                                        }
                                    </div>
                                    <div style="font-size:11px;color:var(--tf-text-muted);font-family:monospace;">
                                        @@@u.User.UserName
                                    </div>
                                </div>
                            </div>
                            <div style="text-align:right;">
                                @if (u.User.Status == UserStatus.Active)
                                {
                                    <span style="font-size:11px;color:#16a34a;background:#dcfce7;padding:2px 6px;border-radius:4px;font-weight:600;">Hoạt động</span>
                                }
                                else if (u.User.Status == UserStatus.Locked)
                                {
                                    <span style="font-size:11px;color:#dc2626;background:#fee2e2;padding:2px 6px;border-radius:4px;font-weight:600;">Khóa</span>
                                }
                                else
                                {
                                    <span style="font-size:11px;color:#64748b;background:#f1f5f9;padding:2px 6px;border-radius:4px;font-weight:600;">Vô hiệu</span>
                                }
                                <div style="font-size:10px;color:var(--tf-text-muted);margin-top:2px;">
                                    @(u.Roles.FirstOrDefault() ?? "—")
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    @* CỘT PHẢI: CHI TIẾT TÀI KHOẢN & ĐẶT LẠI MẬT KHẨU ROOT *@
    <div style="display:flex;flex-direction:column;gap:20px;">
        @if (_selectedUser == null)
        {
            <div class="tf-card" style="padding:48px 24px;text-align:center;">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color:var(--tf-text-muted);margin:0 auto 12px;">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                </svg>
                <h3 style="margin:0 0 6px;font-size:16px;color:var(--tf-text-primary);">Chưa chọn tài khoản</h3>
                <p style="margin:0;font-size:13px;color:var(--tf-text-muted);">Vui lòng chọn một người dùng từ danh sách bên trái để xem thông tin xác thực và thiết lập mật khẩu mới.</p>
            </div>
        }
        else
        {
            @* THẺ THÔNG TIN TÀI KHOẢN & MẬT KHẨU HIỆN TẠI *@
            <div class="tf-card" style="border-top:3px solid var(--tf-primary, #4f46e5);">
                <div class="tf-card-body" style="padding:20px;">
                    <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:12px;margin-bottom:16px;">
                        <div>
                            <div style="display:flex;align-items:center;gap:8px;">
                                <h2 style="margin:0;font-size:18px;font-weight:700;color:var(--tf-text-primary);">@_selectedUser.FullName</h2>
                                @if (_selectedUser.UserName == "admin")
                                {
                                    <span style="background:#fef3c7;color:#b45309;border:1px solid #fde68a;font-size:11px;padding:2px 8px;border-radius:4px;font-weight:700;">ROOT ADMIN</span>
                                }
                            </div>
                            <div style="font-size:13px;color:var(--tf-text-muted);margin-top:2px;">
                                Tên đăng nhập: <strong style="color:var(--tf-text-primary);font-family:monospace;">@_selectedUser.UserName</strong> &bull; Email: @_selectedUser.Email
                            </div>
                        </div>

                        <div style="display:flex;gap:6px;align-items:center;">
                            @if (_selectedUserRoles.Any())
                            {
                                foreach (var r in _selectedUserRoles)
                                {
                                    <span style="font-size:11px;background:#e0e7ff;color:#4338ca;padding:3px 8px;border-radius:4px;font-weight:600;">@r</span>
                                }
                            }
                        </div>
                    </div>

                    @* KHUNG HIỂN THỊ MẬT KHẨU HIỆN TẠI VỚI CON MẮT XEM / ẨN *@
                    <div style="background:var(--tf-bg-subtle, #f8fafc);border:1px solid var(--tf-border, #e2e8f0);border-radius:10px;padding:16px;margin-bottom:16px;">
                        <div style="font-size:12px;font-weight:700;color:var(--tf-text-secondary, #475569);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:8px;display:flex;align-items:center;gap:6px;">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                                <path d="M7 11V7a5 5 0 0110 0v4"/>
                            </svg>
                            <span>Mật khẩu hiện tại của tài khoản (Đặc quyền ROOT)</span>
                        </div>

                        <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
                            <div style="font-family:monospace;font-size:16px;font-weight:700;background:var(--tf-surface, #fff);padding:8px 14px;border-radius:6px;border:1px solid var(--tf-border, #cbd5e1);min-width:220px;display:flex;align-items:center;justify-content:space-between;">
                                @if (_showCurrentPassword)
                                {
                                    <span style="color:#0f172a;letter-spacing:0.5px;">@(_decryptedCurrentPassword ?? "Chưa lưu trong kho mã hóa")</span>
                                }
                                else
                                {
                                    <span style="color:#94a3b8;letter-spacing:2px;">••••••••••••</span>
                                }
                            </div>

                            @* NÚT CON MẮT ẨN / HIỆN MẬT KHẨU *@
                            <button type="button"
                                    class="tf-btn tf-btn-secondary tf-btn-sm"
                                    id="btn-toggle-eye-password"
                                    @onclick="ToggleCurrentPasswordEye"
                                    title="@(_showCurrentPassword ? "Ẩn mật khẩu" : "Nhấn con mắt để xem mật khẩu hiện tại")"
                                    style="display:flex;align-items:center;gap:6px;">
                                @if (_showCurrentPassword)
                                {
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
                                        <line x1="1" y1="1" x2="23" y2="23"/>
                                    </svg>
                                    <span>Ẩn mật khẩu</span>
                                }
                                else
                                {
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                                    </svg>
                                    <span>Xem mật khẩu hiện tại</span>
                                }
                            </button>

                            @if (_showCurrentPassword && !string.IsNullOrEmpty(_decryptedCurrentPassword))
                            {
                                <button type="button"
                                        class="tf-btn tf-btn-ghost tf-btn-sm"
                                        @onclick="() => CopyToClipboard(_decryptedCurrentPassword)"
                                        title="Sao chép mật khẩu hiện tại">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                                        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                                    </svg>
                                    <span>@(_copiedText == _decryptedCurrentPassword ? "Đã sao chép!" : "Sao chép")</span>
                                </button>
                            }
                        </div>

                        <div style="display:flex;gap:18px;margin-top:12px;font-size:12px;color:var(--tf-text-muted);flex-wrap:wrap;">
                            <div>
                                Lần đổi MK gần nhất:
                                <strong style="color:var(--tf-text-primary);">
                                    @(_selectedUser.PasswordChangedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") ?? "Mật khẩu khởi tạo ban đầu")
                                </strong>
                            </div>
                            <div>
                                Buộc đổi mật khẩu:
                                @if (_selectedUser.MustChangePassword)
                                {
                                    <span style="color:#b45309;background:#fef3c7;padding:1px 6px;border-radius:4px;font-weight:600;">Có (Chờ đổi)</span>
                                }
                                else
                                {
                                    <span style="color:#16a34a;background:#dcfce7;padding:1px 6px;border-radius:4px;font-weight:600;">Không</span>
                                }
                            </div>
                            <div>
                                Đăng nhập cuối:
                                <strong style="color:var(--tf-text-primary);">
                                    @(_selectedUser.LastLoginAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Chưa đăng nhập")
                                </strong>
                            </div>
                        </div>
                    </div>

                    @* CÁC THAO TÁC BẢO MẬT NHANH (Revoke Sessions / Lock / Unlock / Disable) *@
                    <div style="display:flex;gap:8px;flex-wrap:wrap;padding-top:12px;border-top:1px solid var(--tf-border, #e2e8f0);">
                        <button class="tf-btn tf-btn-ghost tf-btn-sm"
                                id="btn-revoke-sessions"
                                style="color:#dc2626;"
                                @onclick="RevokeSelectedUserSessions"
                                title="Đăng xuất tài khoản này khỏi tất cả thiết bị">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M18.36 6.64a9 9 0 1 1-12.73 0"></path>
                                <line x1="12" y1="2" x2="12" y2="12"></line>
                            </svg>
                            <span>Thu hồi toàn bộ phiên (Đăng xuất all)</span>
                        </button>

                        @if (_selectedUser.Status == UserStatus.Locked)
                        {
                            <button class="tf-btn tf-btn-ghost tf-btn-sm"
                                    id="btn-unlock-user"
                                    style="color:#16a34a;"
                                    @onclick="UnlockSelectedUser">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                                    <path d="M7 11V7a5 5 0 0 1 9.9-1"/>
                                </svg>
                                <span>Mở khóa tài khoản</span>
                            </button>
                        }
                        else
                        {
                            <button class="tf-btn tf-btn-ghost tf-btn-sm"
                                    id="btn-lock-user"
                                    style="color:#d97706;"
                                    @onclick="LockSelectedUser"
                                    disabled="@(_selectedUser.UserName == "admin")">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                                </svg>
                                <span>Khóa tài khoản</span>
                            </button>
                        }

                        @if (_selectedUser.Status == UserStatus.Disabled)
                        {
                            <button class="tf-btn tf-btn-ghost tf-btn-sm" style="color:#16a34a;" @onclick="EnableSelectedUser">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="20 6 9 17 4 12"/>
                                </svg>
                                <span>Kích hoạt lại tài khoản</span>
                            </button>
                        }
                        else
                        {
                            <button class="tf-btn tf-btn-ghost tf-btn-sm" style="color:#64748b;" @onclick="DisableSelectedUser" disabled="@(_selectedUser.UserName == "admin")">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
                                </svg>
                                <span>Vô hiệu hóa tài khoản</span>
                            </button>
                        }
                    </div>
                </div>
            </div>

            @* BIỂU MẪU ĐẶT LẠI MẬT KHẨU ROOT VỚI XÁC THỰC LẠI ADMIN *@
            <div class="tf-card">
                <div class="tf-card-header">
                    <h2 class="tf-card-title" style="font-size:15px;margin:0;">2. Thiết lập mật khẩu mới (Admin Reset)</h2>
                </div>
                <div class="tf-card-body">
                    @* Tùy chọn mật khẩu: Nhập tay hoặc Sinh ngẫu nhiên *@
                    <div class="tf-field tf-mb-4">
                        <label class="tf-label">Mật khẩu mới</label>
                        <div style="display:flex;gap:8px;">
                            <div style="position:relative;flex:1;">
                                <input type="@(_showNewPasswordInput ? "text" : "password")"
                                       class="tf-input"
                                       id="input-new-password"
                                       style="padding-right:40px;font-family:monospace;"
                                       placeholder="Nhập mật khẩu mới hoặc bấm nút Sinh ngẫu nhiên"
                                       @bind="_formNewPassword" />
                                <button type="button"
                                        @onclick="() => _showNewPasswordInput = !_showNewPasswordInput"
                                        style="position:absolute;right:8px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:var(--tf-text-secondary);padding:4px;">
                                    @if (_showNewPasswordInput)
                                    {
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                                    }
                                    else
                                    {
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                    }
                                </button>
                            </div>
                            <button type="button"
                                    class="tf-btn tf-btn-secondary"
                                    id="btn-generate-password"
                                    @onclick="GenerateStrongPassword"
                                    title="Sinh chuỗi mật khẩu mạnh ngẫu nhiên">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="23 4 23 10 17 10"></polyline>
                                    <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
                                </svg>
                                <span>Sinh ngẫu nhiên</span>
                            </button>
                        </div>
                        <div style="font-size:12px;color:var(--tf-text-muted);margin-top:4px;">
                            Yêu cầu: Tối thiểu 8 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt (!@@#$%^&*).
                        </div>
                    </div>

                    @* Checkbox tùy chọn *@
                    <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:16px;">
                        <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:13px;color:var(--tf-text-primary);">
                            <input type="checkbox" class="tf-checkbox" @bind="_formIsTemporary" />
                            <span><strong>Mật khẩu tạm thời:</strong> Buộc người dùng phải đổi mật khẩu khi đăng nhập lần tiếp theo</span>
                        </label>
                        <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:13px;color:var(--tf-text-primary);">
                            <input type="checkbox" class="tf-checkbox" @bind="_formRevokeSessions" />
                            <span><strong>Thu hồi phiên:</strong> Đăng xuất tài khoản này khỏi tất cả các thiết bị và trình duyệt ngay lập tức</span>
                        </label>
                    </div>

                    @* Lý do thao tác *@
                    <div class="tf-field tf-mb-4">
                        <label class="tf-label">Lý do thiết lập mật khẩu (Lưu kiểm toán)</label>
                        <input type="text"
                               class="tf-input"
                               placeholder="VD: Khôi phục mật khẩu theo yêu cầu nhân viên, bảo đảm an ninh..."
                               @bind="_formReason" />
                    </div>

                    @* XÁC THỰC LẠI ADMIN (ADMIN RE-AUTHENTICATION) *@
                    <div style="background:#fef2f2;border:1px solid #fecaca;border-radius:8px;padding:14px;margin-bottom:16px;">
                        <div style="display:flex;align-items:center;gap:8px;font-size:13px;font-weight:700;color:#991b1b;margin-bottom:8px;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                            </svg>
                            <span>Xác thực lại Quản trị viên ROOT</span>
                        </div>
                        <p style="margin:0 0 8px;font-size:12px;color:#7f1d1d;">
                            Để ngăn chặn hành vi vượt quyền trái phép, vui lòng nhập mật khẩu tài khoản Admin hiện tại của bạn để ký duyệt lệnh:
                        </p>
                        <div style="position:relative;max-width:320px;">
                            <input type="password"
                                   class="tf-input"
                                   id="input-admin-verify-password"
                                   placeholder="Nhập mật khẩu Admin của bạn"
                                   @bind="_adminVerifyPassword" />
                        </div>
                    </div>

                    <div style="display:flex;justify-content:flex-end;gap:10px;">
                        <button class="tf-btn tf-btn-primary"
                                id="btn-submit-reset-password"
                                disabled="@_isSubmitting"
                                @onclick="ExecuteResetPassword">
                            @if (_isSubmitting)
                            {
                                <span>Đang xử lý...</span>
                            }
                            else
                            {
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="20 6 9 17 4 12"/>
                                </svg>
                                <span>Xác nhận đặt mật khẩu</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@* LỊCH SỬ BẢO MẬT & KIỂM TOÁN TÀI KHOẢN *@
<div class="tf-card">
    <div class="tf-card-header" style="display:flex;justify-content:space-between;align-items:center;">
        <div>
            <h2 class="tf-card-title" style="font-size:16px;margin:0;">Lịch sử bảo mật &amp; Kiểm toán thông tin xác thực</h2>
            <p style="font-size:12px;color:var(--tf-text-muted);margin:2px 0 0;">
                Theo dõi 10 loại sự kiện an ninh: Đổi MK, Đặt lại MK, Cấp MK tạm, Buộc đổi MK, Thu hồi phiên, Khóa, Mở khóa, Vô hiệu hóa, Đăng nhập thất bại, Đăng nhập đáng ngờ
            </p>
        </div>
        <button class="tf-btn tf-btn-ghost tf-btn-sm" @onclick="LoadSecurityAuditsAsync">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="23 4 23 10 17 10"></polyline>
                <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
            </svg>
            Làm mới
        </button>
    </div>
    <div class="tf-card-body" style="padding:0;">
        <table class="tf-table">
            <thead>
                <tr>
                    <th style="width:160px;">Thời điểm</th>
                    <th style="width:140px;">Người thực hiện</th>
                    <th style="width:140px;">Người bị tác động</th>
                    <th>Hành động bảo mật</th>
                    <th>Lý do &amp; Chi tiết thao tác</th>
                    <th style="text-align:center;width:110px;">Kết quả</th>
                </tr>
            </thead>
            <tbody>
                @if (_securityAudits == null || !_securityAudits.Any())
                {
                    <tr>
                        <td colspan="6" style="text-align:center;padding:24px;color:var(--tf-text-muted);">
                            Chưa có sự kiện bảo mật nào được ghi nhận.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var a in _securityAudits)
                    {
                        <tr>
                            <td style="font-size:12px;color:var(--tf-text-muted);">
                                @a.OccurredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")
                            </td>
                            <td>
                                <strong style="font-size:13px;color:var(--tf-text-primary);">@a.PerformedBy</strong>
                            </td>
                            <td>
                                <span style="font-family:monospace;font-size:12px;background:rgba(0,0,0,0.04);padding:2px 6px;border-radius:4px;">
                                    @(string.IsNullOrEmpty(a.TargetId) ? a.TargetEntity : a.TargetId)
                                </span>
                            </td>
                            <td>
                                @FormatAuditEventBadge(a.EventType)
                            </td>
                            <td style="font-size:12px;color:var(--tf-text-secondary);max-width:320px;">
                                @(a.Details ?? "Thao tác an ninh hệ thống")
                            </td>
                            <td style="text-align:center;">
                                <span style="font-size:11px;background:#dcfce7;color:#16a34a;padding:2px 8px;border-radius:12px;font-weight:600;">
                                    Thành công
                                </span>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    [Parameter] public string? UserId { get; set; }

    private record UserItem(ApplicationUser User, IList<string> Roles);

    private List<UserItem>? _allUsers;
    private string _userSearchQuery = "";
    private ApplicationUser? _selectedUser;
    private IList<string> _selectedUserRoles = [];

    private string? _globalMessage;
    private bool _globalSuccess;
    private string? _copiedText;

    private bool _showCurrentPassword = false;
    private string? _decryptedCurrentPassword;

    private string _formNewPassword = "";
    private bool _showNewPasswordInput = true;
    private bool _formIsTemporary = true;
    private bool _formRevokeSessions = true;
    private string _formReason = "Quản trị viên ROOT đặt lại thông tin xác thực";
    private string _adminVerifyPassword = "";
    private bool _isSubmitting = false;

    private PasswordResetResult? _latestResetResult;
    private List<AuditLog>? _securityAudits;
    private string? _currentAdminUsername;

    private IEnumerable<UserItem> FilteredUsers
    {
        get
        {
            if (_allUsers == null) return Enumerable.Empty<UserItem>();
            if (string.IsNullOrWhiteSpace(_userSearchQuery)) return _allUsers;
            var q = _userSearchQuery.Trim().ToLower();
            return _allUsers.Where(u =>
                (u.User.UserName?.ToLower().Contains(q) ?? false) ||
                (u.User.FullName?.ToLower().Contains(q) ?? false) ||
                (u.User.Email?.ToLower().Contains(q) ?? false) ||
                u.Roles.Any(r => r.ToLower().Contains(q))
            );
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _currentAdminUsername = authState.User.Identity?.Name ?? "admin";

        await LoadUsersAsync();
        await LoadSecurityAuditsAsync();

        if (!string.IsNullOrEmpty(UserId) && _allUsers != null)
        {
            var match = _allUsers.FirstOrDefault(u => u.User.Id == UserId);
            if (match != null)
            {
                await SelectUser(match.User);
            }
        }
        else if (_allUsers != null && _allUsers.Any())
        {
            // Mặc định chọn tài khoản nv01 hoặc tài khoản đầu tiên
            var defaultUser = _allUsers.FirstOrDefault(u => u.User.UserName == "nv01") ?? _allUsers.First();
            await SelectUser(defaultUser.User);
        }
    }

    private async Task LoadUsersAsync()
    {
        var users = await UserManager.Users
            .OrderBy(u => u.UserName)
            .ToListAsync();

        var list = new List<UserItem>();
        foreach (var u in users)
        {
            var roles = await UserManager.GetRolesAsync(u);
            list.Add(new UserItem(u, roles));
        }
        _allUsers = list;
    }

    private async Task SelectUser(ApplicationUser user)
    {
        _selectedUser = user;
        _selectedUserRoles = await UserManager.GetRolesAsync(user);
        _showCurrentPassword = false;
        _decryptedCurrentPassword = null;
        _formNewPassword = "";
        _adminVerifyPassword = "";
        _latestResetResult = null;

        // Tự động giải mã sẵn mật khẩu trong bộ nhớ để khi bấm con mắt là hiện ngay
        if (!string.IsNullOrEmpty(user.EncryptedPassword))
        {
            _decryptedCurrentPassword = VaultService.DecryptPassword(user.EncryptedPassword);
        }
    }

    private void ToggleCurrentPasswordEye()
    {
        _showCurrentPassword = !_showCurrentPassword;
        if (_showCurrentPassword && _selectedUser != null && string.IsNullOrEmpty(_decryptedCurrentPassword))
        {
            if (!string.IsNullOrEmpty(_selectedUser.EncryptedPassword))
            {
                _decryptedCurrentPassword = VaultService.DecryptPassword(_selectedUser.EncryptedPassword);
            }
        }
    }

    private void GenerateStrongPassword()
    {
        const string upper = "ABCDEFGHJKLMNPQRSTUVWXYZ";
        const string lower = "abcdefghijkmnpqrstuvwxyz";
        const string digits = "23456789";
        const string special = "!@#$%^&*";

        var sb = new System.Text.StringBuilder("TF#");
        sb.Append(upper[System.Security.Cryptography.RandomNumberGenerator.GetInt32(upper.Length)]);
        sb.Append(lower[System.Security.Cryptography.RandomNumberGenerator.GetInt32(lower.Length)]);
        sb.Append(digits[System.Security.Cryptography.RandomNumberGenerator.GetInt32(digits.Length)]);
        sb.Append(special[System.Security.Cryptography.RandomNumberGenerator.GetInt32(special.Length)]);

        string allChars = upper + lower + digits + special;
        for (int i = 0; i < 5; i++)
        {
            sb.Append(allChars[System.Security.Cryptography.RandomNumberGenerator.GetInt32(allChars.Length)]);
        }
        _formNewPassword = sb.ToString();
    }

    private async Task CopyToClipboard(string? text)
    {
        if (string.IsNullOrEmpty(text)) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            _copiedText = text;
            StateHasChanged();
        }
        catch
        {
            _copiedText = text;
        }
    }

    private async Task ExecuteResetPassword()
    {
        if (_selectedUser == null) return;
        _globalMessage = null;
        _latestResetResult = null;

        if (string.IsNullOrWhiteSpace(_adminVerifyPassword))
        {
            _globalMessage = "Vui lòng nhập mật khẩu Quản trị viên (Admin) của bạn để xác thực quyền ROOT.";
            _globalSuccess = false;
            return;
        }

        _isSubmitting = true;
        try
        {
            var result = await SecurityService.AdminResetPasswordCustomAsync(
                _selectedUser.Id,
                string.IsNullOrWhiteSpace(_formNewPassword) ? null : _formNewPassword.Trim(),
                _formIsTemporary,
                _formRevokeSessions,
                _formReason,
                _currentAdminUsername ?? "admin",
                _adminVerifyPassword
            );

            if (!result.Succeeded)
            {
                _globalMessage = result.ErrorMessage ?? "Thao tác đặt lại mật khẩu thất bại.";
                _globalSuccess = false;
                return;
            }

            _latestResetResult = result;
            _globalMessage = $"Đã đặt lại mật khẩu thành công cho {_selectedUser.UserName}.";
            _globalSuccess = true;

            // Cập nhật lại mật khẩu đã giải mã cho view
            _decryptedCurrentPassword = result.TempPassword;
            _adminVerifyPassword = "";
            _formNewPassword = "";

            await LoadUsersAsync();
            if (_allUsers != null)
            {
                var refreshed = _allUsers.FirstOrDefault(u => u.User.Id == _selectedUser.Id);
                if (refreshed != null) _selectedUser = refreshed.User;
            }
            await LoadSecurityAuditsAsync();
        }
        catch (Exception ex)
        {
            _globalMessage = "Lỗi hệ thống: " + ex.Message;
            _globalSuccess = false;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task RevokeSelectedUserSessions()
    {
        if (_selectedUser == null) return;
        _globalMessage = null;
        var ok = await SecurityService.RevokeAllUserSessionsAsync(_selectedUser.Id, "Yêu cầu an ninh từ ROOT", _currentAdminUsername ?? "admin");
        if (ok)
        {
            _globalMessage = $"Đã thu hồi tất cả phiên làm việc và đăng xuất tài khoản {_selectedUser.UserName} khỏi mọi thiết bị.";
            _globalSuccess = true;
            await LoadSecurityAuditsAsync();
        }
        else
        {
            _globalMessage = "Không thể thu hồi phiên tài khoản này.";
            _globalSuccess = false;
        }
    }

    private async Task LockSelectedUser()
    {
        if (_selectedUser == null) return;
        var ok = await SecurityService.SetUserStatusAsync(_selectedUser.Id, UserStatus.Locked, "Khóa tài khoản bởi Admin", _currentAdminUsername ?? "admin");
        if (ok)
        {
            _selectedUser.Status = UserStatus.Locked;
            _globalMessage = $"Đã khóa tài khoản {_selectedUser.UserName}.";
            _globalSuccess = true;
            await LoadUsersAsync();
            await LoadSecurityAuditsAsync();
        }
    }

    private async Task UnlockSelectedUser()
    {
        if (_selectedUser == null) return;
        var ok = await SecurityService.SetUserStatusAsync(_selectedUser.Id, UserStatus.Active, "Mở khóa tài khoản bởi Admin", _currentAdminUsername ?? "admin");
        if (ok)
        {
            _selectedUser.Status = UserStatus.Active;
            _globalMessage = $"Đã mở khóa tài khoản {_selectedUser.UserName}.";
            _globalSuccess = true;
            await LoadUsersAsync();
            await LoadSecurityAuditsAsync();
        }
    }

    private async Task DisableSelectedUser()
    {
        if (_selectedUser == null) return;
        var ok = await SecurityService.SetUserStatusAsync(_selectedUser.Id, UserStatus.Disabled, "Vô hiệu hóa tài khoản bởi Admin", _currentAdminUsername ?? "admin");
        if (ok)
        {
            _selectedUser.Status = UserStatus.Disabled;
            _globalMessage = $"Đã vô hiệu hóa tài khoản {_selectedUser.UserName}.";
            _globalSuccess = true;
            await LoadUsersAsync();
            await LoadSecurityAuditsAsync();
        }
    }

    private async Task EnableSelectedUser()
    {
        if (_selectedUser == null) return;
        var ok = await SecurityService.SetUserStatusAsync(_selectedUser.Id, UserStatus.Active, "Cấp lại quyền truy cập bởi Admin", _currentAdminUsername ?? "admin");
        if (ok)
        {
            _selectedUser.Status = UserStatus.Active;
            _globalMessage = $"Đã kích hoạt lại quyền truy cập cho tài khoản {_selectedUser.UserName}.";
            _globalSuccess = true;
            await LoadUsersAsync();
            await LoadSecurityAuditsAsync();
        }
    }

    private async Task LoadSecurityAuditsAsync()
    {
        var securityTypes = new[]
        {
            AuditEventType.PasswordChanged,
            AuditEventType.PasswordReset,
            AuditEventType.TemporaryPasswordIssued,
            AuditEventType.ForcedPasswordChange,
            AuditEventType.SessionRevoked,
            AuditEventType.UserLocked,
            AuditEventType.UserUnlocked,
            AuditEventType.AccountDisabled,
            AuditEventType.LoginFailed,
            AuditEventType.SuspiciousLogin
        };

        _securityAudits = await DbContext.AuditLogs
            .Where(a => securityTypes.Contains(a.EventType))
            .OrderByDescending(a => a.OccurredAt)
            .Take(30)
            .ToListAsync();
    }

    private RenderFragment FormatAuditEventBadge(AuditEventType type) => builder =>
    {
        string color = type switch
        {
            AuditEventType.PasswordChanged => "#0284c7",
            AuditEventType.PasswordReset or AuditEventType.TemporaryPasswordIssued => "#4f46e5",
            AuditEventType.SessionRevoked => "#d97706",
            AuditEventType.UserLocked or AuditEventType.AccountDisabled => "#dc2626",
            AuditEventType.UserUnlocked => "#16a34a",
            AuditEventType.LoginFailed or AuditEventType.SuspiciousLogin => "#e11d48",
            _ => "#64748b"
        };
        string label = type switch
        {
            AuditEventType.PasswordChanged => "Đổi mật khẩu",
            AuditEventType.PasswordReset => "Đặt lại mật khẩu",
            AuditEventType.TemporaryPasswordIssued => "Cấp MK tạm thời",
            AuditEventType.ForcedPasswordChange => "Buộc đổi MK",
            AuditEventType.SessionRevoked => "Thu hồi phiên",
            AuditEventType.UserLocked => "Khóa tài khoản",
            AuditEventType.UserUnlocked => "Mở khóa tài khoản",
            AuditEventType.AccountDisabled => "Vô hiệu hóa",
            AuditEventType.LoginFailed => "Đăng nhập thất bại",
            AuditEventType.SuspiciousLogin => "Đăng nhập đáng ngờ",
            _ => type.ToString()
        };

        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "style", $"font-size:11px;font-weight:600;color:{color};background:{color}18;padding:2px 8px;border-radius:4px;border:1px solid {color}30;");
        builder.AddContent(2, label);
        builder.CloseElement();
    };
}
