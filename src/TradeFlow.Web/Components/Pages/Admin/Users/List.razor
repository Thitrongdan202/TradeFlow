@page "/cai-dat/nguoi-dung"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Domain.Enums
@using TradeFlow.Infrastructure.Persistence
@attribute [Authorize(Policy = "Permission:Users:View")]

@inject UserManager<ApplicationUser> UserManager
@inject IAuditService AuditService
@inject ISecurityService SecurityService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Quản lý người dùng — TradeFlow</PageTitle>

<div class="tf-page-header">
    <div class="tf-page-header-left">
        <h1 class="tf-page-title">Người dùng</h1>
        <p class="tf-page-subtitle">Quản lý tài khoản và phân quyền người dùng</p>
    </div>
    <div class="tf-page-actions">
        <AuthorizeView Policy="Permission:Users:Create">
            <a href="/cai-dat/nguoi-dung/them-moi" class="tf-btn tf-btn-primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M16 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/>
                </svg>
                Thêm người dùng
            </a>
        </AuthorizeView>
    </div>
</div>

@if (!string.IsNullOrEmpty(_actionMessage))
{
    <div class="tf-alert @(_actionSuccess ? "tf-alert-success" : "tf-alert-error") tf-mb-4">
        @_actionMessage
    </div>
}

@if (_resetPasswordInfo != null)
{
    <div class="tf-alert tf-alert-success tf-mb-4" style="flex-direction:column;align-items:flex-start;gap:8px;">
        <div style="font-weight:600;">✅ Mật khẩu đã được đặt lại</div>
        <div>Tài khoản: <strong>@_resetPasswordInfo.Value.Username</strong></div>
        <div style="font-family:monospace;background:rgba(0,0,0,0.05);padding:6px 12px;border-radius:6px;">
            Mật khẩu mới: <strong>@_resetPasswordInfo.Value.TempPassword</strong>
        </div>
        <div style="font-size:12px;color:var(--tf-text-muted);">Gửi mật khẩu này cho người dùng. Khuyến khích đổi ngay sau khi đăng nhập.</div>
        <button class="tf-btn tf-btn-ghost tf-btn-sm" @onclick="() => _resetPasswordInfo = null">Đóng</button>
    </div>
}

<div class="tf-card">
    <div class="tf-card-body" style="padding:0;">
        @if (_users == null)
        {
            <Skeleton Type="table" Rows="5" Columns="6" />
        }
        else
        {
            <table class="tf-table">
                <thead>
                    <tr>
                        <th>Tên đăng nhập</th>
                        <th>Họ và tên</th>
                        <th>Vai trò</th>
                        <th style="text-align:center;">Trạng thái</th>
                        <th>Đăng nhập cuối</th>
                        <th style="text-align:right;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!_users.Any())
                    {
                        <tr><td colspan="6"><div class="tf-empty"><div class="tf-empty-title">Chưa có người dùng</div></div></td></tr>
                    }
                    else
                    {
                    foreach (var entry in _users)
                    {
                        <tr>
                            <td>
                                <div class="tf-font-medium">@entry.User.UserName</div>
                                <div style="font-size:12px;color:var(--tf-text-muted);">@entry.User.Email</div>
                            </td>
                            <td>@entry.User.FullName</td>
                            <td>
                                @if (entry.Roles.Any())
                                {
                                    foreach (var role in entry.Roles)
                                    {
                                        <span class="tf-badge tf-badge-primary" style="margin-right:4px;margin-bottom:2px;">@role</span>
                                    }
                                }
                                else
                                {
                                    <span style="color:var(--tf-text-muted);font-size:13px;">—</span>
                                }
                            </td>
                            <td style="text-align:center;">
                                @if (entry.User.Status == UserStatus.Active)
                                {
                                    <span class="tf-badge tf-badge-success">Hoạt động</span>
                                }
                                else if (entry.User.Status == UserStatus.Locked)
                                {
                                    <span class="tf-badge tf-badge-error">Bị khóa</span>
                                }
                                else
                                {
                                    <span class="tf-badge tf-badge-gray">Vô hiệu hóa</span>
                                }
                            </td>
                            <td style="color:var(--tf-text-muted);font-size:13px;">
                                @(entry.User.LastLoginAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Chưa đăng nhập")
                            </td>
                            <td style="text-align:right;">
                                <div style="display:flex;gap:4px;justify-content:flex-end;flex-wrap:wrap;">
                                    <AuthorizeView Policy="Permission:Users:Edit">
                                        <a href="/cai-dat/nguoi-dung/sua/@entry.User.Id"
                                           class="tf-btn tf-btn-ghost tf-btn-sm" title="Sửa">
                                            Sửa
                                        </a>
                                        <a href="/cai-dat/nguoi-dung/@entry.User.Id/quyen"
                                           class="tf-btn tf-btn-ghost tf-btn-sm" title="Xem quyền">
                                            Quyền
                                        </a>
                                        @if (entry.User.Status == UserStatus.Locked || entry.User.Status == UserStatus.Disabled)
                                        {
                                            <button class="tf-btn tf-btn-ghost tf-btn-sm"
                                                    style="color:var(--tf-success);"
                                                    @onclick="() => UnlockUser(entry.User)"
                                                    title="Mở khóa tài khoản">
                                                Mở khóa
                                            </button>
                                        }
                                        else if (_currentUsername != entry.User.UserName)
                                        {
                                            <button class="tf-btn tf-btn-ghost tf-btn-sm"
                                                    style="color:var(--tf-warning);"
                                                    @onclick="() => LockUser(entry.User)"
                                                    title="Khóa tài khoản">
                                                Khóa
                                            </button>
                                        }
                                        <button class="tf-btn tf-btn-ghost tf-btn-sm"
                                                style="color:var(--tf-error);"
                                                @onclick="() => ResetPassword(entry.User)"
                                                title="Đặt lại mật khẩu">
                                            Đặt lại MK
                                        </button>
                                        @if (_currentUsername != entry.User.UserName)
                                        {
                                            <button class="tf-btn tf-btn-ghost tf-btn-sm"
                                                    style="color:var(--tf-error);"
                                                    @onclick="() => RevokeSessions(entry.User)"
                                                    title="Thu hồi tất cả phiên đăng nhập">
                                                Thu hồi phiên
                                            </button>
                                            @if (entry.User.Status != UserStatus.Disabled)
                                            {
                                                <button class="tf-btn tf-btn-ghost tf-btn-sm"
                                                        style="color:#dc2626;font-weight:600;"
                                                        @onclick="() => PromptOffboard(entry.User)"
                                                        title="Quy trình thôi việc nhân viên">
                                                    Thôi việc
                                                </button>
                                            }
                                        }
                                    </AuthorizeView>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        }
    </div>
</div>

@if (_showOffboardModal && _offboardUser != null)
{
    <div style="position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1000; display:flex; align-items:center; justify-content:center;">
        <div style="background:white; padding:24px; border-radius:8px; width:520px; max-width:95%; box-shadow:0 10px 25px rgba(0,0,0,0.2);">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
                <h3 style="margin:0; font-size:18px; color:#dc2626;">⚠️ Xác nhận quy trình thôi việc</h3>
                <button type="button" class="tf-btn tf-btn-ghost tf-btn-sm" @onclick="CancelOffboard">✕</button>
            </div>

            <div class="tf-alert tf-alert-warning tf-mb-4" style="font-size:13px; line-height:1.5;">
                <strong>Lưu ý quan trọng:</strong> Quy trình thôi việc sẽ thực hiện:
                <ul style="margin:6px 0 0 18px; padding:0;">
                    <li>Vô hiệu hóa tài khoản đăng nhập của nhân viên.</li>
                    <li>Thu hồi tức thì mọi phiên làm việc hiện tại (Security Stamp).</li>
                    <li>Thu hồi toàn bộ chứng thư ký số đang hoạt động của nhân viên.</li>
                    <li>Hủy tất cả mã kích hoạt chữ ký số chưa sử dụng.</li>
                    <li>Lịch sử chứng từ và hóa đơn đã ký trước đây vẫn được lưu trữ toàn vẹn.</li>
                </ul>
            </div>

            <div style="margin-bottom:16px; font-size:14px;">
                <div>Nhân viên: <strong>@_offboardUser.FullName</strong></div>
                <div>Tài khoản: <strong>@_offboardUser.UserName</strong> (@_offboardUser.Email)</div>
            </div>

            <div class="tf-form-group tf-mb-4">
                <label class="tf-form-label" style="font-weight:600;">Lý do thôi việc <span style="color:var(--tf-error);">*</span></label>
                <textarea class="tf-form-control" rows="3" placeholder="Nhập lý do thôi việc (nghỉ việc, chấm dứt hợp đồng, chuyển công tác...)" @bind="_offboardReason"></textarea>
                @if (_offboardError != null)
                {
                    <div style="color:var(--tf-error); font-size:12px; margin-top:4px;">@_offboardError</div>
                }
            </div>

            <div style="display:flex; justify-content:flex-end; gap:8px;">
                <button type="button" class="tf-btn tf-btn-secondary" @onclick="CancelOffboard" disabled="@_isOffboarding">Hủy</button>
                <LoadingButton Variant="danger"
                               IsLoading="@_isOffboarding"
                               LoadingText="Đang xử lý..."
                               Text="Xác nhận thôi việc"
                               OnClick="ExecuteOffboard" />
            </div>
        </div>
    </div>
}

@code {
    private record UserEntry(ApplicationUser User, IList<string> Roles);

    private List<UserEntry>? _users;
    private string? _actionMessage;
    private bool _actionSuccess;
    private string? _currentUsername;
    private (string Username, string TempPassword)? _resetPasswordInfo;

    private bool _showOffboardModal;
    private ApplicationUser? _offboardUser;
    private string _offboardReason = string.Empty;
    private string? _offboardError;
    private bool _isOffboarding;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _currentUsername = authState.User.Identity?.Name;
        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        var users = await UserManager.Users
            .OrderBy(u => u.UserName)
            .ToListAsync();

        var entries = new List<UserEntry>();
        foreach (var u in users)
        {
            var roles = await UserManager.GetRolesAsync(u);
            entries.Add(new UserEntry(u, roles));
        }
        _users = entries;
    }

    private async Task LockUser(ApplicationUser user)
    {
        _actionMessage = null;
        try
        {
            user.Status = UserStatus.Locked;
            await UserManager.SetLockoutEndDateAsync(user, DateTimeOffset.UtcNow.AddYears(100));
            await UserManager.UpdateAsync(user);
            await AuditService.LogAsync(AuditEventType.UserLocked, _currentUsername, "User", user.UserName, "Administrator locked account");
            _actionMessage = $"Đã khóa tài khoản {user.UserName}.";
            _actionSuccess = true;
            await LoadUsersAsync();
        }
        catch (Exception ex)
        {
            _actionMessage = "Lỗi: " + ex.Message;
            _actionSuccess = false;
        }
    }

    private async Task UnlockUser(ApplicationUser user)
    {
        _actionMessage = null;
        try
        {
            user.Status = UserStatus.Active;
            await UserManager.SetLockoutEndDateAsync(user, null);
            await UserManager.ResetAccessFailedCountAsync(user);
            await UserManager.UpdateAsync(user);
            await AuditService.LogAsync(AuditEventType.UserUnlocked, _currentUsername, "User", user.UserName, "Administrator unlocked account");
            _actionMessage = $"Đã mở khóa tài khoản {user.UserName}.";
            _actionSuccess = true;
            await LoadUsersAsync();
        }
        catch (Exception ex)
        {
            _actionMessage = "Lỗi: " + ex.Message;
            _actionSuccess = false;
        }
    }

    private async Task ResetPassword(ApplicationUser user)
    {
        _actionMessage = null;
        try
        {
            var res = await SecurityService.AdminResetPasswordAsync(user.Id, _currentUsername);
            if (!res.Succeeded)
            {
                _actionMessage = res.ErrorMessage;
                _actionSuccess = false;
                return;
            }
            _resetPasswordInfo = (res.UserName ?? user.UserName ?? user.Id, res.TempPassword ?? "");
        }
        catch (Exception ex)
        {
            _actionMessage = "Lỗi: " + ex.Message;
            _actionSuccess = false;
        }
    }

    private void PromptOffboard(ApplicationUser user)
    {
        _offboardUser = user;
        _offboardReason = string.Empty;
        _offboardError = null;
        _showOffboardModal = true;
    }

    private void CancelOffboard()
    {
        _showOffboardModal = false;
        _offboardUser = null;
        _offboardReason = string.Empty;
        _offboardError = null;
    }

    private async Task ExecuteOffboard()
    {
        if (_offboardUser == null) return;
        if (string.IsNullOrWhiteSpace(_offboardReason))
        {
            _offboardError = "Vui lòng nhập lý do thôi việc.";
            return;
        }

        _isOffboarding = true;
        _offboardError = null;
        try
        {
            var result = await SecurityService.OffboardEmployeeAsync(_offboardUser.Id, _offboardReason, _currentUsername ?? "Admin");
            if (!result.Succeeded)
            {
                _offboardError = result.ErrorMessage;
                return;
            }

            _actionMessage = $"Đã hoàn tất quy trình thôi việc cho nhân viên {result.UserName}. Đã thu hồi {result.RevokedSignerIdentitiesCount} chứng thư ký số liên quan.";
            _actionSuccess = true;
            CancelOffboard();
            await LoadUsersAsync();
        }
        catch (Exception ex)
        {
            _offboardError = "Lỗi xử lý thôi việc: " + ex.Message;
        }
        finally
        {
            _isOffboarding = false;
        }
    }

    private async Task RevokeSessions(ApplicationUser user)
    {
        _actionMessage = null;
        try
        {
            // Updating SecurityStamp invalidates all active sessions
            await UserManager.UpdateSecurityStampAsync(user);
            await AuditService.LogAsync(AuditEventType.UserUpdated, _currentUsername, "User", user.UserName, "Administrator revoked all active sessions");
            _actionMessage = $"Đã thu hồi tất cả phiên đăng nhập của {user.UserName}.";
            _actionSuccess = true;
        }
        catch (Exception ex)
        {
            _actionMessage = "Lỗi: " + ex.Message;
            _actionSuccess = false;
        }
    }
}
