    private async Task ExecuteReviewConfirmationAsync()
    {
        if (_isSubmittingConfirm) return;
        _isSubmittingConfirm = true;
        try
        {
            bool success = false;
            if (_confirmCategory == "adjustment")
            {
                success = await AttendanceService.ReviewAdjustmentRequestAsync(_userId, new ReviewRequestCommand { RequestId = _confirmReqId, IsApproved = _confirmIsApprove, ReviewNotes = _confirmNotes });
            }
            else if (_confirmCategory == "leave")
            {
                success = await AttendanceService.ReviewLeaveRequestAsync(_userId, new ReviewRequestCommand { RequestId = _confirmReqId, IsApproved = _confirmIsApprove, ReviewNotes = _confirmNotes });
            }
            else if (_confirmCategory == "shift")
            {
                success = await AttendanceService.ReviewShiftChangeRequestAsync(_userId, new ReviewRequestCommand { RequestId = _confirmReqId, IsApproved = _confirmIsApprove, ReviewNotes = _confirmNotes });
            }

            if (success)
            {
                CloseReviewConfirmModal();
                await LoadTabSpecificDataAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error executing review confirmation");
        }
        finally
        {
            _isSubmittingConfirm = false;
        }
    }

    private void OpenUndoModal(string category, int id, string empName, string reqType, string priorDecision, string reviewerName, DateTime reviewedAt, DateTime? leaveStartDate)
    {
        _undoCategory = category;
        _undoReqId = id;
        _undoEmpName = empName;
        _undoReqType = reqType;
        _undoPriorDecision = priorDecision;
        _undoReviewerName = reviewerName;
        _undoReviewedTimeDisplay = reviewedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm");
        _undoReason = "";
        _undoErrorMessage = null;

        var nowUtc = DateTime.UtcNow;
        var revUtc = reviewedAt.Kind == DateTimeKind.Utc ? reviewedAt : DateTime.SpecifyKind(reviewedAt, DateTimeKind.Utc);
        int maxHours = 24;
        if (category == "leave" && leaveStartDate.HasValue && (leaveStartDate.Value.Date - reviewedAt.Date).TotalDays >= 3)
        {
            maxHours = 72;
        }
        var deadline = revUtc.AddHours(maxHours);
        if (category == "leave" && leaveStartDate.HasValue && leaveStartDate.Value.Date < deadline)
        {
            deadline = leaveStartDate.Value.Date;
        }

        var remaining = deadline - nowUtc;
        if (remaining.TotalMinutes > 0)
        {
            _undoRemainingTimeDisplay = $"Còn {Math.Floor(remaining.TotalHours)} giờ {remaining.Minutes} phút";
        }
        else
        {
            _undoRemainingTimeDisplay = "Đã hết thời hạn hoàn tác";
        }

        _showUndoModal = true;
    }

    private void CloseUndoModal()
    {
        _showUndoModal = false;
        _undoErrorMessage = null;
        _isSubmittingUndo = false;
    }

    private async Task SubmitUndoAsync()
    {
        if (string.IsNullOrWhiteSpace(_undoReason))
        {
            _undoErrorMessage = "Vui lòng nhập lý do hoàn tác quyết định.";
            return;
        }

        _isSubmittingUndo = true;
        _undoErrorMessage = null;
        try
        {
            var cmd = new UndoReviewCommand
            {
                RequestType = _undoCategory,
                RequestId = _undoReqId,
                Reason = _undoReason
            };

            var success = await AttendanceService.UndoReviewRequestAsync(_userId, cmd);
            if (success)
            {
                CloseUndoModal();
                await LoadTabSpecificDataAsync();
            }
            else
            {
                _undoErrorMessage = "Không thể hoàn tác quyết định. Vui lòng kiểm tra thời hạn và quyền hạn.";
            }
        }
        catch (Exception ex)
        {
            _undoErrorMessage = ex.Message;
        }
        finally
        {
            _isSubmittingUndo = false;
        }
    }

