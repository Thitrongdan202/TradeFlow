    private async Task SubmitRequestModal()

    {

        _isSubmittingModal = true;

        _modalErrorMessage = null;



        try

        {

            if (_reqSubTab == "adjustment")

            {

                if (string.IsNullOrWhiteSpace(_adjReason))

                {

                    _modalErrorMessage = "Vui lòng nhập lý do giải trình giờ công!";

                    return;

                }



                var cmd = new CreateAdjustmentRequestCommand

                {

                    EmployeeId = _currentEmployeeId,

                    RequestType = _adjType,

                    TargetDate = _adjTargetDate,

                    ProposedClockIn = _adjProposedInTime,

                    ProposedClockOut = _adjProposedOutTime,

                    Reason = _adjReason

                };

                await AttendanceService.SubmitAdjustmentRequestAsync(_userId, cmd);

            }

            else if (_reqSubTab == "leave")

            {

                if (string.IsNullOrWhiteSpace(_leaveReason))

                {

                    _modalErrorMessage = "Vui lòng nhập lý do xin nghỉ phép!";

                    return;

                }

                var cmd = new CreateLeaveRequestCommand

                {

                    EmployeeId = _currentEmployeeId,

                    LeaveType = _leaveType,

                    StartDate = _leaveStartDate,

                    EndDate = _leaveEndDate,

                    Reason = _leaveReason

                };

                await AttendanceService.SubmitLeaveRequestAsync(_userId, cmd);

            }

            else if (_reqSubTab == "shift")

            {

                var cmd = new CreateShiftChangeRequestCommand

                {

                    EmployeeId = _currentEmployeeId,

                    TargetDate = _shiftTargetDate,

                    CurrentWorkShiftId = _shiftCurrentId,

                    ProposedWorkShiftId = _shiftProposedId,

                    Reason = _shiftReason

                };

                await AttendanceService.SubmitShiftChangeRequestAsync(_userId, cmd);

            }



            CloseRequestModal();

            await RefreshDataAsync();

        }

        catch (Exception ex)

        {

            _modalErrorMessage = ex.Message;

        }

        finally

        {

            _isSubmittingModal = false;

        }

    }



