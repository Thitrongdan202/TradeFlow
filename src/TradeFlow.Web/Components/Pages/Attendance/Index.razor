    private void CalculateLeadingDays()

    {

        var firstDayOfMonth = new DateTime(_selectedYear, _selectedMonth, 1);

        // Monday = 1, Sunday = 0 -> in Vi culture: Monday=0, Sunday=6

        var dow = (int)firstDayOfMonth.DayOfWeek;

        _leadingEmptyDays = (dow == 0) ? 6 : dow - 1;

    }



