@code {

    // Confirmation modal state
    private bool _showReviewConfirmModal = false;
    private int _confirmReqId;
    private string _confirmEmpName = "";
    private string _confirmReqType = "";
    private string _confirmCategory = "";
    private bool _confirmIsApprove = true;
    private string _confirmNotes = "";
    private bool _isSubmittingConfirm = false;

    // Undo review modal state
    private bool _showUndoModal = false;
    private int _undoReqId;
    private string _undoCategory = "";
    private string _undoEmpName = "";
    private string _undoReqType = "";
    private string _undoPriorDecision = "";
    private string _undoReviewerName = "";
    private string _undoReviewedTimeDisplay = "";
    private string _undoRemainingTimeDisplay = "";
    private string _undoReason = "";
    private string? _undoErrorMessage;
    private bool _isSubmittingUndo = false;

    // Restore leave modal state
    private bool _showRestoreLeaveModal = false;
    private int _restoreEmployeeId = 0;
    private decimal _restoreDays = 1.0m;
    private string _restoreReason = "";
    private string _restoreNotes = "";
    private int? _restoreRelatedRequestId;
    private string? _restoreErrorMessage;
    private bool _isSubmittingRestore = false;
    private List<EmployeeDto> _allEmployeesForRestore = new();
    private List<LeaveRequestDto> _restoreEmpLeaves = new();
    private LeaveBalanceSummaryDto? _restoreSummary;

    // Employee monitoring accordion state
    private int? _expandedEmpId;
    private EmployeeMonitoringDetailDto? _expandedDetail;
    private bool _isLoadingMonitoringDetail = false;
    private string _monitoringMonthMode = "current";
    private int _monitoringMonth = DateTime.Today.Month;
    private int _monitoringYear = DateTime.Today.Year;
    private string _monSubTab = "work";

    private bool IsEligibleForUndo(string category, DateTime createdAt, DateTime? reviewedAt, DateTime? leaveStartDate)
    {
        if (!reviewedAt.HasValue) return false;
        var nowUtc = DateTime.UtcNow;
        var reviewedUtc = reviewedAt.Value.Kind == DateTimeKind.Utc ? reviewedAt.Value : DateTime.SpecifyKind(reviewedAt.Value, DateTimeKind.Utc);
        
        var hoursPassed = (nowUtc - reviewedUtc).TotalHours;

        if (category == "leave" && leaveStartDate.HasValue)
        {
            var startUtc = leaveStartDate.Value.Date;
            if (nowUtc.Date >= startUtc) return false;

            var isAdvanceNotice = (leaveStartDate.Value.Date - createdAt.Date).TotalDays >= 3;
            var maxHours = isAdvanceNotice ? 72 : 24;
            return hoursPassed <= maxHours;
        }

        return hoursPassed <= 24;
    }

    private void PromptConfirmApprove(int id, string empName, string reqType, string category)
    {
        _confirmReqId = id;
        _confirmEmpName = empName;
        _confirmReqType = reqType;
        _confirmCategory = category;
        _confirmIsApprove = true;
        _confirmNotes = "";
        _showReviewConfirmModal = true;
    }

    private void PromptConfirmReject(int id, string empName, string reqType, string category)
    {
        _confirmReqId = id;
        _confirmEmpName = empName;
        _confirmReqType = reqType;
        _confirmCategory = category;
