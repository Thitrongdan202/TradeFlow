                                    <span>Quản lý Ca làm việc</span>
                                </span>
                            </button>
                            <button type="button" class="tf-dropdown-item @(_currentTab == "reports" ? "active" : "")" @onclick='() => SetTab("reports")'>
                                <span class="tf-drop-item-left">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.21 15.89A10 10 0 1 1 8 2.83"></path><path d="M22 12A10 10 0 0 0 12 2v10z"></path></svg>
                                    <span>Báo cáo Bảng công</span>
                                </span>
                            </button>
                            <button type="button" class="tf-dropdown-item @(_currentTab == "leave-ledger" ? "active" : "")" @onclick='() => SetTab("leave-ledger")'>
                                <span class="tf-drop-item-left">
