                </svg>
                <span>Tạo đơn yêu cầu</span>
            </button>
            <button type="button" class="tf-btn-icon" @onclick="RefreshDataAsync" title="Làm mới dữ liệu">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="@(_isRefreshing ? "spin" : "")">
                    <polyline points="23 4 23 10 17 10"></polyline>
                    <polyline points="1 20 1 14 7 14"></polyline>
                    <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
                </svg>
            </button>
        </div>
    </div>

    @* --- TAB CONTENTS --- *@
    <div class="tf-att-content" id="tf-att-tab-content">
        @if (_isLoading)
        {
            <div class="tf-loading-state">
                <div class="tf-spinner"></div>
                <p>Đang tải dữ liệu chấm công hệ thống...</p>
            </div>
        }
        else
        {
            @* === TAB 1: PERSONAL CLOCK & CALENDAR === *@
            @if (_currentTab == "personal")
            {
                @if (_isUserExempt)
                {
                    <div class="tf-admin-exempt-banner">
                        <div class="tf-exempt-icon">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                            </svg>
                        </div>
                        <div class="tf-exempt-content">
                            <h4>Tài khoản Quản trị viên cấp cao (Owner / Administrator)</h4>
                            <p>Thuộc diện miễn chấm công vào/ra theo quy chế quản trị TradeFlow ERP. Tài khoản có toàn quyền quản trị, phân ca, phê duyệt yêu cầu và tra cứu audit toàn hệ thống.</p>
                        </div>
                    </div>
                }

                
                @* Automated Overtime Alert Banner *@
                @if (_widgetData != null && _widgetData.IsOvertimeAlert)
                {
                    <div class="tf-overtime-alert-card">
                        <div class="tf-ot-alert-header">
                            <div class="tf-ot-alert-badge">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                                <span>THÔNG BÁO TĂNG CA</span>
                            </div>
                            <button type="button" class="tf-ot-close-btn" @onclick="() => _widgetData.IsOvertimeAlert = false" title="Đóng thông báo">✕</button>
                        </div>
                        <div class="tf-ot-alert-title">@_widgetData.OvertimeAlertTitle</div>
                        <div class="tf-ot-alert-desc">@_widgetData.OvertimeAlertMessage</div>
                        <div class="tf-ot-meta-grid">
                            <div class="tf-ot-meta-item">
                                <span class="tf-ot-label">Ca làm việc</span>
                                <span class="tf-ot-val">@_widgetData.ShiftName (@_widgetData.ShiftStartTime:hh\:mm - @_widgetData.ShiftEndTime:hh\:mm)</span>
                            </div>
                            <div class="tf-ot-meta-item">
                                <span class="tf-ot-label">Giờ kết thúc theo lịch</span>
                                <span class="tf-ot-val">@_widgetData.ShiftEndTime.ToString(@"hh\:mm")</span>
                            </div>
                            <div class="tf-ot-meta-item">
                                <span class="tf-ot-label">Giờ chấm ra thực tế</span>
                                <span class="tf-ot-val">@_widgetData.ClockOutDisplay</span>
                            </div>
                            <div class="tf-ot-meta-item">
                                <span class="tf-ot-label">Thời lượng tăng ca dự kiến</span>
                                <span class="tf-ot-val highlight">@(_widgetData.OvertimeMinutes / 60)h @(_widgetData.OvertimeMinutes % 60)m</span>
                            </div>
                            <div class="tf-ot-meta-item">
                                <span class="tf-ot-label">Tăng ca hợp lệ (tối đa 2h/ngày)</span>
                                <span class="tf-ot-val success">@_widgetData.ValidOvertimeHours giờ</span>
                            </div>
                            <div class="tf-ot-meta-item">
                                <span class="tf-ot-label">Hạn mức còn lại trong ngày</span>
                                <span class="tf-ot-val">@_widgetData.OvertimeRemainingLimitDisplay</span>
                            </div>
                        </div>
                        @if (_widgetData.ExcessOvertimeHours > 0)
                        {
                            <div class="tf-ot-excess-notice">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                                <span><strong>Cảnh báo vượt hạn mức:</strong> Phát hiện vượt quá @_widgetData.ExcessOvertimeHours giờ tăng ca. Phần vượt 2 giờ/ngày không tự động xác nhận, cần HR/Quản lý phê duyệt xét duyệt riêng. Giờ chấm thực tế vẫn được bảo toàn nguyên vẹn.</span>
                            </div>
                        }
                    </div>
                }

                <div class="tf-personal-grid">
                    @* Column 1: Live Clocking Action Widget *@
                    <div class="tf-clock-widget-col">
                        <div class="tf-clock-widget-card" id="tf-clock-widget">
                            <div class="tf-widget-header">
                                <span class="tf-widget-badge">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <polyline points="12 6 12 12 16 14"></polyline>
                                    </svg>
                                    Chấm công hôm nay
                                </span>
                                <span class="tf-shift-badge">
                                    @_widgetData.ShiftName (@_widgetData.ShiftTimeRange)
                                </span>
                            </div>

                            @* Digital Clock Display *@
                            <div class="tf-big-clock">
                                <div class="tf-clock-digits">@_liveServerTime.ToString("HH:mm:ss")</div>
                                <div class="tf-clock-date">@_liveServerTime.ToString("dddd, 'ngày' dd 'tháng' MM 'năm' yyyy", new System.Globalization.CultureInfo("vi-VN"))</div>
                            </div>

                            @* Status and In/Out Timeline *@
                            <div class="tf-clock-status-box @_widgetData.StatusCssClass">
                                <div class="tf-status-indicator">
                                    <span class="tf-pulse-dot"></span>
                                    <span class="tf-status-text">@_widgetData.StatusLabel</span>
                                </div>
                                <div class="tf-work-duration">
                                    <span class="tf-duration-label">Đã tích lũy:</span>
                                    <span class="tf-duration-val">@_widgetData.WorkingDurationDisplay</span>
                                </div>
                            </div>

                            @* In/Out Time Badges *@
                            <div class="tf-stamp-row">
                                <div class="tf-stamp-box">
                                    <div class="tf-stamp-label">Giờ vào ca</div>
                                    <div class="tf-stamp-val in">@_widgetData.ClockInDisplay</div>
                                </div>
                                <div class="tf-stamp-divider">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <line x1="5" y1="12" x2="19" y2="12"></line>
                                        <polyline points="12 5 19 12 12 19"></polyline>
                                    </svg>
                                </div>
                                <div class="tf-stamp-box">
                                    <div class="tf-stamp-label">Giờ ra ca</div>
                                    <div class="tf-stamp-val out">@_widgetData.ClockOutDisplay</div>
                                </div>
                            </div>

                            @* Clock Notes Input *@
                            <div class="tf-notes-field">
                                <input type="text" class="tf-input-sm" placeholder="Ghi chú ca làm (tùy chọn)..." @bind="_clockNotes" />
                            </div>

                            @* Single State-aware Action Button *@
                            <div class="tf-clock-action-container">
                                @if (_widgetData.CanClockIn)
                                {
                                    <button type="button" 
                                            class="tf-btn-state-action clock-in" 
                                            id="btn-clock-in"
                                            disabled="@_isClocking" 
                                            @onclick="HandleClockIn">
                                        @if (_isClocking)
                                        {
                                            <span class="tf-spinner-btn"></span>
                                            <span>ĐANG XÁC THỰC VÀO CA...</span>
                                        }
                                        else
                                        {
                                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                                <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                                                <polyline points="10 17 15 12 10 7"></polyline>
                                                <line x1="15" y1="12" x2="3" y2="12"></line>
                                            </svg>
                                            <span>VÀO CA LÀM VIỆC</span>
                                        }
                                    </button>
                                }
                                else if (_widgetData.CanClockOut)
                                {
                                    <button type="button" 
                                            class="tf-btn-state-action clock-out" 
                                            id="btn-clock-out"
                                            disabled="@_isClocking" 
                                            @onclick="HandleClockOut">
                                        @if (_isClocking)
                                        {
                                            <span class="tf-spinner-btn"></span>
                                            <span>ĐANG XÁC THỰC RA CA...</span>
                                        }
                                        else
                                        {
                                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                                <polyline points="16 17 21 12 16 7"></polyline>
                                                <line x1="21" y1="12" x2="9" y2="12"></line>
                                            </svg>
                                            <span>KẾT THÚC / RA CA</span>
                                        }
                                    </button>
                                }
                                else if (_widgetData.IsCompleted)
                                {
                                    <div class="tf-state-completed-card" id="card-clock-completed">
                                        <div class="tf-completed-badge">
                                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                                <polyline points="22 4 12 14.01 9 11.01"></polyline>
                                            </svg>
                                            <span>HOÀN THÀNH CA HÔM NAY</span>
                                        </div>
                                        <span class="tf-completed-summary">Tổng thời gian: <strong>@_widgetData.WorkingDurationDisplay</strong></span>
                                    </div>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(_clockErrorMessage))
                            {
                                <div class="tf-clock-alert error">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <line x1="12" y1="8" x2="12" y2="12"></line>
                                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                                    </svg>
                                    <span>@_clockErrorMessage</span>
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(_clockSuccessMessage))
                            {
                                <div class="tf-clock-alert success">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                                    </svg>
                                    <span>@_clockSuccessMessage</span>
                                </div>
                            }

                            <div class="tf-clock-footer">
                                <span class="tf-footer-hint">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:middle; margin-right:4px;">
                                        <rect x="2" y="3" width="20" height="14" rx="2"/>
                                        <line x1="8" y1="21" x2="16" y2="21"/>
                                        <line x1="12" y1="17" x2="12" y2="21"/>
                                    </svg>
                                    Thiết bị: Trình duyệt Web TradeFlow
                                </span>
                            </div>
                        </div>

                        @* Personal Leave Balance Mini-Summary *@
                        <div class="tf-card tf-leave-mini-card">
                            <div class="tf-leave-mini-header">
                                <h4 class="tf-leave-mini-title">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="4" width="18" height="18" rx="2"/>
                                        <line x1="16" y1="2" x2="16" y2="6"/>
                                        <line x1="8" y1="2" x2="8" y2="6"/>
                                    </svg>
                                    Phép năm @_selectedYear (Điều 113 BLLĐ)
                                </h4>
                                <button type="button" class="tf-btn-sm tf-btn-link" @onclick='() => SetTab("leave-ledger")'>Xem sổ cái &rarr;</button>
                            </div>
                            <div class="tf-leave-mini-grid">
                                <div class="tf-leave-mini-item">
                                    <div class="tf-leave-mini-lbl">Tiêu chuẩn</div>
                                    <div class="tf-leave-mini-val">@_leaveSummary.TotalEntitlement n</div>
                                </div>
                                <div class="tf-leave-mini-item">
                                    <div class="tf-leave-mini-lbl text-primary">Tích lũy</div>
                                    <div class="tf-leave-mini-val text-primary">@_leaveSummary.AccruedDays n</div>
                                </div>
                                <div class="tf-leave-mini-item">
                                    <div class="tf-leave-mini-lbl text-success">Đã dùng</div>
                                    <div class="tf-leave-mini-val text-success">@_leaveSummary.UsedDays n</div>
                                </div>
                                <div class="tf-leave-mini-item highlight">
                                    <div class="tf-leave-mini-lbl text-success">Còn lại</div>
                                    <div class="tf-leave-mini-val text-success font-bold">@_leaveSummary.RemainingDays n</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* Column 2: Personal Metric Strip & Side-by-Side Calendar *@
                    <div class="tf-personal-calendar-col">
                        @* Compact Metric Strip *@
                        <div class="tf-personal-metric-strip" id="tf-personal-kpis">
                            <div class="tf-metric-card">
                                <div class="tf-metric-label">
                                    <span class="tf-metric-dot ontime"></span>
                                    CÔNG THỰC TẾ
                                </div>
                                <div class="tf-metric-val-row">
                                    <span class="tf-metric-val">@(_personalKpis?.TotalWorkDays ?? 0)</span>
                                    <span class="tf-metric-unit">ngày</span>
                                </div>
                                <div class="tf-metric-sub">Tổng: @(_personalKpis?.TotalWorkingHours ?? 0) giờ làm</div>
                            </div>

                            <div class="tf-metric-divider"></div>

                            <div class="tf-metric-card">
                                <div class="tf-metric-label">
                                    <span class="tf-metric-dot late"></span>
                                    ĐI MUỘN
                                </div>
                                <div class="tf-metric-val-row">
                                    <span class="tf-metric-val @((_personalKpis?.TotalLateDays ?? 0) > 0 ? "warn" : "")">@(_personalKpis?.TotalLateDays ?? 0)</span>
                                    <span class="tf-metric-unit">lần</span>
                                </div>
                                <div class="tf-metric-sub">Tháng @_selectedMonth/@_selectedYear</div>
                            </div>

                            <div class="tf-metric-divider"></div>

                            <div class="tf-metric-card">
                                <div class="tf-metric-label">
                                    <span class="tf-metric-dot missing"></span>
                                    QUÊN CHẤM RA
                                </div>
                                <div class="tf-metric-val-row">
                                    <span class="tf-metric-val @((_personalKpis?.TotalMissedClockOuts ?? 0) > 0 ? "danger" : "")">@(_personalKpis?.TotalMissedClockOuts ?? 0)</span>
                                    <span class="tf-metric-unit">lần</span>
                                </div>
                                <div class="tf-metric-sub">@((_personalKpis?.TotalMissedClockOuts ?? 0) > 0 ? "Cần giải trình" : "Bình thường")</div>
                            </div>

                            <div class="tf-metric-divider"></div>

                            <div class="tf-metric-card">
                                <div class="tf-metric-label">
                                    <span class="tf-metric-dot leave"></span>
                                    NGHỈ PHÉP
                                </div>
                                <div class="tf-metric-val-row">
                                    <span class="tf-metric-val">@(_personalKpis?.TotalLeaveDays ?? 0)</span>
                                    <span class="tf-metric-unit">ngày</span>
                                </div>
                                <div class="tf-metric-sub">Đã được phê duyệt</div>
                            </div>

                            <div class="tf-metric-divider"></div>

                            <div class="tf-metric-card">
                                <div class="tf-metric-label">
                                    <span class="tf-metric-dot balance"></span>
                                    PHÉP NĂM CÒN
                                </div>
                                <div class="tf-metric-val-row">
                                    <span class="tf-metric-val highlight">@_leaveSummary.RemainingDays</span>
                                    <span class="tf-metric-unit">ngày</span>
                                </div>
                                <div class="tf-metric-sub">Tổng cấp: @_leaveSummary.TotalEntitlement ngày</div>
                            </div>
                        </div>

                        @* Calendar Card (Week View / Month View Switchable) *@
                        <div class="tf-card tf-calendar-card">
                            <div class="tf-card-header">
                                <div class="tf-cal-title-wrap">
                                    <div class="tf-cal-title-row">
                                        <h3 class="tf-card-title">Bảng chấm công Lịch tháng @_selectedMonth/@_selectedYear</h3>
                                        @* Mode switcher: Lịch tuần vs Lịch tháng *@
                                        <div class="tf-cal-view-switcher">
                                            <button type="button" class="tf-view-btn @(_calViewMode == "week" ? "active" : "")" @onclick='() => _calViewMode = "week"'>
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                                                <span>Tuần</span>
                                            </button>
                                            <button type="button" class="tf-view-btn @(_calViewMode == "month" ? "active" : "")" @onclick='() => _calViewMode = "month"'>
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                                <span>Tháng</span>
                                            </button>
                                        </div>
                                    </div>
                                    <span class="tf-cal-legend">
                                        <span class="dot ontime"></span>Đúng giờ
                                        <span class="dot late"></span>Đi muộn
                                        <span class="dot early"></span>Về sớm
                                        <span class="dot leave"></span>Nghỉ phép
                                        <span class="dot absent"></span>Vắng mặt
                                    </span>
                                </div>

                                <div class="tf-cal-nav-buttons">
                                    <button type="button" class="tf-btn-cal-step" @onclick="PrevMonth" title="Tháng trước">&lt;</button>
                                    <span class="tf-cal-cur-label">Tháng @_selectedMonth, @_selectedYear</span>
                                    <button type="button" class="tf-btn-cal-step" @onclick="NextMonth" title="Tháng sau">&gt;</button>
                                    <button type="button" class="tf-btn-sm" @onclick="GoCurrentMonth">Hôm nay</button>
                                </div>
                            </div>

                            @if (_calViewMode == "week")
                            {
                                @* --- WEEK VIEW (Compact Strip) --- *@
                                <div class="tf-week-view-strip">
                                    @foreach (var day in GetCurrentWeekDays())
                                    {
                                        var dowName = day.Date.ToString("ddd", new System.Globalization.CultureInfo("vi-VN")).ToUpper();
                                        <div class="tf-week-day-card @(day.IsToday ? "today" : "") @(day.IsWeekend ? "weekend" : "") @(day == _selectedDay ? "selected" : "")" 
                                             @onclick="() => SelectCalendarDay(day)">
                                            <div class="tf-week-day-top">
                                                <span class="tf-week-dow">@dowName</span>
                                                <span class="tf-week-dot" style="background-color: @day.DotColor;"></span>
                                            </div>
                                            <div class="tf-week-date-num">@day.DayNumber</div>
                                            <div class="tf-week-day-info">
                                                @if (day.HasRecord)
                                                {
                                                    <span class="tf-week-time">@day.ClockInDisplay - @day.ClockOutDisplay</span>
                                                    <span class="tf-week-pill @day.BadgeClass">@day.StatusLabel</span>
                                                }
                                                else if (day.IsWeekend)
                                                {
                                                    <span class="tf-week-sub muted">Nghỉ tuần</span>
                                                }
                                                else
                                                {
                                                    <span class="tf-week-sub">@day.StatusLabel</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                @* --- MONTH VIEW (7-Column Grid) --- *@
                                <div class="tf-calendar-grid">
                                    <div class="tf-cal-weekday">T2</div>
                                    <div class="tf-cal-weekday">T3</div>
                                    <div class="tf-cal-weekday">T4</div>
                                    <div class="tf-cal-weekday">T5</div>
                                    <div class="tf-cal-weekday">T6</div>
                                    <div class="tf-cal-weekday sat">T7</div>
                                    <div class="tf-cal-weekday sun">CN</div>

                                    @* Pad leading empty cells *@
                                    @for (int p = 0; p < _leadingEmptyDays; p++)
                                    {
                                        <div class="tf-cal-cell empty"></div>
                                    }

                                    @* Days of Month *@
                                    @foreach (var day in _calendarDays)
                                    {
                                        <div class="tf-cal-cell @(day.IsToday ? "today" : "") @(day.IsWeekend ? "weekend" : "") @(day == _selectedDay ? "selected" : "") @day.BadgeClass" 
                                             @onclick="() => SelectCalendarDay(day)">
                                            <div class="tf-cal-day-header">
                                                <span class="tf-cal-day-num">@day.DayNumber</span>
                                                @if (day.HasRecord || day.IsToday)
                                                {
                                                    <span class="tf-cal-dot" style="background-color: @day.DotColor;"></span>
                                                }
                                            </div>

                                            <div class="tf-cal-day-body">
                                                @if (day.HasRecord)
                                                {
                                                    <div class="tf-cal-time-range">@day.ClockInDisplay - @day.ClockOutDisplay</div>
                                                    <div class="tf-cal-badge-pill">@day.StatusLabel</div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }


            @* === TAB 2: PERSONAL HISTORY & REQUESTS === *@

            @if (_currentTab == "history")

            {

                <div class="tf-history-container">

                    <div class="tf-card">

                        <div class="tf-card-header flex-wrap">

                            <div>

                                <h3 class="tf-card-title">Lịch sử Chấm công cá nhân</h3>

                                <p class="tf-card-desc">Bản ghi giờ vào, giờ ra và tính toán số giờ làm chi tiết theo từng ngày</p>

                            </div>

                            <div class="tf-filter-controls">

                                <button type="button" class="tf-btn-primary" @onclick="OpenRequestModal">

                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">

                                        <line x1="12" y1="5" x2="12" y2="19"></line>

                                        <line x1="5" y1="12" x2="19" y2="12"></line>

                                    </svg>

                                    Tạo đơn giải trình mới

                                </button>

                            </div>

                        </div>



                        <div class="tf-table-responsive">

                            <table class="tf-table">

                                <thead>

                                    <tr>

                                        <th>Ngày làm việc</th>

                                        <th>Ca làm</th>

                                        <th>Giờ vào</th>

                                        <th>Giờ ra</th>

                                        <th>Thời lượng</th>

                                        <th>Đi muộn / Về sớm</th>

                                        <th>Trạng thái</th>

                                        <th>Ghi chú</th>

                                        <th>Thao tác</th>

                                    </tr>

                                </thead>

                                <tbody>

                                    @if (_personalHistory.Count == 0)

                                    {

                                        <tr>

                                            <td colspan="9" class="tf-empty-table">Không tìm thấy bản ghi chấm công nào trong tháng.</td>

                                        </tr>

                                    }

                                    else

                                    {

                                        @foreach (var rec in _personalHistory)

                                        {

                                            <tr>

                                                <td>

                                                    <strong>@rec.WorkDateDisplay</strong>

                                                    <span class="tf-sub-text">(@rec.DayOfWeekName)</span>

                                                </td>

                                                <td>

                                                    <span class="tf-shift-pill" style="border-left-color: @rec.ShiftColor;">@rec.WorkShiftName</span>

                                                </td>

                                                <td><span class="tf-time in">@rec.ClockInDisplay</span></td>

                                                <td><span class="tf-time out">@rec.ClockOutDisplay</span></td>

                                                <td><strong>@rec.WorkingHoursDisplay</strong></td>

                                                <td>

                                                    @if (rec.LateMinutes > 0)

                                                    {

                                                        <span class="tf-badge-warn">Muộn @(rec.LateMinutes)p</span>

                                                    }

                                                    @if (rec.EarlyLeaveMinutes > 0)

                                                    {

                                                        <span class="tf-badge-warn">Sớm @(rec.EarlyLeaveMinutes)p</span>

                                                    }

                                                    @if (rec.LateMinutes == 0 && rec.EarlyLeaveMinutes == 0)

                                                    {

                                                        <span class="text-muted">--</span>

                                                    }

                                                </td>

                                                <td>

                                                    <span class="tf-status-badge @rec.StatusCssClass">@rec.StatusLabel</span>

                                                </td>

                                                <td class="tf-notes-cell">@(string.IsNullOrWhiteSpace(rec.Notes) ? "--" : rec.Notes)</td>

                                                <td>

                                                    @if (rec.Status == AttendanceStatus.Late || rec.Status == AttendanceStatus.EarlyLeave || rec.Status == AttendanceStatus.MissingClockOut)

                                                    {

                                                        <button type="button" class="tf-btn-link" @onclick="() => RequestAdjustmentForRecord(rec)">Giải trình</button>

                                                    }

                                                </td>

                                            </tr>

                                        }

                                    }

                                </tbody>

                            </table>

                        </div>

                    </div>



                    @* My Sent Requests Section *@

                    <div class="tf-card mt-4">

                        <div class="tf-card-header">

                            <div>

                                <h3 class="tf-card-title">Danh sách Đơn từ &amp; Yêu cầu đã gửi</h3>

                                <p class="tf-card-desc">Theo dõi tiến độ phê duyệt đơn giải trình, đơn xin nghỉ phép và đổi ca làm việc</p>

                            </div>

                        </div>



                        <div class="tf-table-responsive">

                            <table class="tf-table">

                                <thead>

                                    <tr>

                                        <th>Loại đơn</th>

                                        <th>Ngày áp dụng</th>

                                        <th>Chi tiết / Lý do</th>

                                        <th>Ngày gửi</th>

                                        <th>Trạng thái duyệt</th>

                                        <th>Phản hồi / Người duyệt</th>

                                    </tr>

                                </thead>

                                <tbody>

                                    @if (_myAdjustmentRequests.Count == 0 && _myLeaveRequests.Count == 0 && _myShiftRequests.Count == 0)

                                    {

                                        <tr>

                                            <td colspan="6" class="tf-empty-table">Bạn chưa gửi đơn yêu cầu nào gần đây.</td>

                                        </tr>

                                    }

                                    else

                                    {

                                        @foreach (var adj in _myAdjustmentRequests)

                                        {

                                            <tr>

                                                <td><span class="tf-req-pill adj">Giải trình: @adj.RequestTypeLabel</span></td>

                                                <td>@adj.TargetDateDisplay</td>

                                                <td>@adj.Reason</td>

                                                <td>@adj.CreatedAtDisplay</td>

                                                <td><span class="tf-req-badge @adj.StatusCssClass">@adj.StatusLabel</span></td>

                                                <td>@(adj.ReviewedByUserName ?? "--") @(string.IsNullOrWhiteSpace(adj.ReviewNotes) ? "" : $"({adj.ReviewNotes})")</td>

                                            </tr>

                                        }

                                        @foreach (var l in _myLeaveRequests)

                                        {

                                            <tr>

                                                <td><span class="tf-req-pill leave">Nghỉ phép: @l.LeaveTypeLabel</span></td>

                                                <td>@l.DateRangeDisplay (@l.TotalDays ngày)</td>

                                                <td>@l.Reason</td>

                                                <td>@l.CreatedAtDisplay</td>

                                                <td><span class="tf-req-badge @l.StatusCssClass">@l.StatusLabel</span></td>

                                                <td>@(l.ReviewedByUserName ?? "--") @(string.IsNullOrWhiteSpace(l.ReviewNotes) ? "" : $"({l.ReviewNotes})")</td>

                                            </tr>

                                        }

                                        @foreach (var sc in _myShiftRequests)

                                        {

                                            <tr>

                                                <td><span class="tf-req-pill shift">Đổi ca: @sc.CurrentWorkShiftName -> @sc.ProposedWorkShiftName</span></td>

                                                <td>@sc.TargetDateDisplay</td>

                                                <td>@sc.Reason</td>

                                                <td>@sc.CreatedAtDisplay</td>

                                                <td><span class="tf-req-badge @sc.StatusCssClass">@sc.StatusLabel</span></td>

                                                <td>@(sc.ReviewedByUserName ?? "--")</td>

                                            </tr>

                                        }

                                    }

                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>

            }



            @* === TAB 3: MANAGER TEAM TRACKING === *@

            @if (_currentTab == "team")

            {

                <div class="tf-team-container">

                    <div class="tf-kpi-summary-grid">

                        <div class="tf-att-kpi-card">

                            <div class="tf-kpi-top">

                                <span class="tf-kpi-title">Quân số theo dõi</span>

                                <div class="tf-kpi-icon-wrap team">

                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">

                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>

                                        <circle cx="9" cy="7" r="4"></circle>

                                    </svg>

                                </div>

                            </div>

                            <div class="tf-kpi-value">@(_teamKpis?.TotalEligibleEmployees ?? 0) <span class="tf-unit">nhân viên</span></div>

                            <div class="tf-kpi-sub">Thuộc phạm vi quản lý</div>

                        </div>



                        <div class="tf-att-kpi-card ontime">

                            <div class="tf-kpi-top">

                                <span class="tf-kpi-title">Đang làm việc</span>

                                <div class="tf-kpi-icon-wrap ontime">

                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">

                                        <polyline points="20 6 9 17 4 12"></polyline>

                                    </svg>

                                </div>

                            </div>

                            <div class="tf-kpi-value">@(_teamKpis?.ClockedInCount ?? 0) <span class="tf-unit">nhân sự</span></div>

                            <div class="tf-kpi-sub">Đã chấm công vào hôm nay</div>

                        </div>



                        <div class="tf-att-kpi-card late">

                            <div class="tf-kpi-top">

                                <span class="tf-kpi-title">Đi muộn / Về sớm</span>

                                <div class="tf-kpi-icon-wrap late">

                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">

                                        <circle cx="12" cy="12" r="10"></circle>

                                        <polyline points="12 6 12 12 16 14"></polyline>

                                    </svg>

                                </div>

                            </div>

                            <div class="tf-kpi-value">@((_teamKpis?.LateCount ?? 0) + (_teamKpis?.EarlyLeaveCount ?? 0)) <span class="tf-unit">lượt</span></div>

                            <div class="tf-kpi-sub">Cần nhắc nhở / xác minh</div>

                        </div>



                        <div class="tf-att-kpi-card leave">

                            <div class="tf-kpi-top">

                                <span class="tf-kpi-title">Nghỉ phép / Vắng mặt</span>

                                <div class="tf-kpi-icon-wrap leave">

                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">

                                        <circle cx="12" cy="12" r="10"></circle>

                                        <line x1="12" y1="8" x2="12" y2="12"></line>

                                        <line x1="12" y1="16" x2="12.01" y2="16"></line>

                                    </svg>

                                </div>

                            </div>

                            <div class="tf-kpi-value">@((_teamKpis?.OnLeaveCount ?? 0) + (_teamKpis?.NotClockedInCount ?? 0)) <span class="tf-unit">nhân sự</span></div>

                            <div class="tf-kpi-sub">@(_teamKpis?.OnLeaveCount ?? 0) nghỉ phép, @(_teamKpis?.NotClockedInCount ?? 0) chưa vào</div>

                        </div>

                    </div>



                    <div class="tf-card mt-4">

                        <div class="tf-card-header">

                            <div>

                                <h3 class="tf-card-title">Theo dõi nhân viên & Chấm công — Ngày @_selectedDate.ToString("dd/MM/yyyy")</h3>

                                <p class="tf-card-desc">Cập nhật trực tiếp trạng thái nhân viên thuộc quyền quản lý</p>

                            </div>

                        </div>



                        <div class="tf-table-responsive">

                            <table class="tf-table">

                                <thead>

                                    <tr>

                                        <th>Nhân viên</th>

                                        <th>Phòng ban</th>

                                        <th>Ca làm</th>

                                        <th>Giờ vào</th>

                                        <th>Giờ ra</th>

                                        <th>Thời lượng</th>

                                        <th>Trạng thái</th>

                                        <th>Thao tác</th>

                                    </tr>

                                </thead>

                                <tbody>

                                    @if (_teamAttendance.Count == 0)

                                    {

                                        <tr><td colspan="8" class="tf-empty-table">Không có dữ liệu đội nhóm.</td></tr>

                                    }

                                    else

                                    {

                                        @foreach (var item in _teamAttendance)

                                        {

                                            <tr>

                                                <td>

                                                    <div class="tf-emp-cell">

                                                        <div class="tf-emp-avatar">

                                                            @if (!string.IsNullOrWhiteSpace(item.AvatarPath))

                                                            {

                                                                <img src="@item.AvatarPath" alt="@item.EmployeeName" />

                                                            }

                                                            else

                                                            {

                                                                <div class="tf-avatar-placeholder">@GetInitials(item.EmployeeName)</div>

                                                            }

                                                        </div>

                                                        <div>

                                                            <div class="tf-emp-name">@item.EmployeeName</div>

                                                            <div class="tf-emp-code">@item.EmployeeCode</div>

                                                        </div>

                                                    </div>

                                                </td>

                                                <td>@item.DepartmentName</td>

                                                <td><span class="tf-shift-pill" style="border-left-color:@item.ShiftColor;">@item.WorkShiftName</span></td>

                                                <td><span class="tf-time in">@item.ClockInDisplay</span></td>

                                                <td><span class="tf-time out">@item.ClockOutDisplay</span></td>

                                                <td>@item.WorkingHoursDisplay</td>

                                                <td><span class="tf-status-badge @item.StatusCssClass">@item.StatusLabel</span></td>

                                                <td>

                                                    <button type="button" class="tf-btn-sm @(_expandedEmpId == item.EmployeeId ? "active" : "")" @onclick="() => ToggleEmployeeAccordionAsync(item.EmployeeId)" style="display:inline-flex; align-items:center; gap:0.35rem; font-weight:600;">
    <span>@(_expandedEmpId == item.EmployeeId ? "Thu gọn ▲" : "Chi tiết ▼")</span>
</button>

                                                </td>

                                            </tr>

                                                @if (_expandedEmpId == item.EmployeeId)
                                                {
                                                    <tr class="tf-accordion-row">
                                                        <td colspan="8" class="tf-accordion-cell">
                                                            @if (_isLoadingMonitoringDetail)
                                                            {
                                                                <div style="padding: 1.5rem; text-align: center; color: var(--tf-text-secondary, #64748b);">
                                                                    <span class="tf-spinner"></span> Đang tải thông tin chi tiết nhân viên...
                                                                </div>
                                                            }
                                                            else if (_expandedDetail != null)
                                                            {
                                                                <div class="tf-accordion-panel">
                                                                    <!-- Top bar: Thông tin nhân viên & Bộ lọc thời gian -->
                                                                    <div class="tf-accordion-top-bar">
                                                                        <div class="tf-accordion-profile-badge">
                                                                            <strong style="font-size: 1rem;">@_expandedDetail.EmployeeName</strong>
                                                                            <span class="tf-emp-code">@_expandedDetail.EmployeeCode • @_expandedDetail.DepartmentName • @_expandedDetail.PositionName</span>
                                                                            <span class="tf-shift-pill" style="margin-left: 0.5rem;">@_expandedDetail.ShiftName (@_expandedDetail.ShiftTimeRange)</span>
                                                                            <span class="tf-status-badge tf-status-on-time">@_expandedDetail.RoleName</span>
                                                                        </div>
                                                                        <div class="tf-accordion-filter-group">
                                                                            <button type="button" class="tf-mon-filter-btn @(_monitoringMonthMode == "current" ? "active" : "")" @onclick='() => ChangeMonitoringMonthAsync("current")'>Tháng hiện tại</button>
                                                                            <button type="button" class="tf-mon-filter-btn @(_monitoringMonthMode == "prev" ? "active" : "")" @onclick='() => ChangeMonitoringMonthAsync("prev")'>Tháng trước</button>
                                                                            <div style="display:inline-flex; align-items:center; gap:0.35rem; margin-left: 0.25rem;">
                                                                                <select class="tf-mon-filter-btn" value="@_monitoringMonth" @onchange="OnCustomMonthChanged">
                                                                                    @for (int m = 1; m <= 12; m++)
                                                                                    {
                                                                                        <option value="@m">Tháng @m</option>
                                                                                    }
                                                                                </select>
                                                                                <select class="tf-mon-filter-btn" value="@_monitoringYear" @onchange="OnCustomYearChanged">
                                                                                    <option value="2025">2025</option>
                                                                                    <option value="2026">2026</option>
                                                                                    <option value="2027">2027</option>
                                                                                </select>
                                                                            </div>
                                                                        </div>
                                                                    </div>

                                                                    <!-- Sub tabs: Công / Phép / Bất thường -->
                                                                    <div class="tf-mon-sub-tabs">
                                                                        <button type="button" class="tf-mon-sub-tab @(_monSubTab == "work" ? "active" : "")" @onclick='() => _monSubTab = "work"'>Theo dõi công (@_expandedDetail.MonthlyWorkdays ngày)</button>
                                                                        <button type="button" class="tf-mon-sub-tab @(_monSubTab == "leave" ? "active" : "")" @onclick='() => _monSubTab = "leave"'>Theo dõi phép (Còn @_expandedDetail.LeaveRemainingDays ngày)</button>
                                                                        <button type="button" class="tf-mon-sub-tab @(_monSubTab == "anomalies" ? "active" : "")" @onclick='() => _monSubTab = "anomalies"'>Bất thường &amp; Vi phạm (@_expandedDetail.Anomalies.Count)</button>
                                                                    </div>

                                                                    @if (_monSubTab == "work")
                                                                    {
                                                                        <div class="tf-mon-stat-grid">
                                                                            <div class="tf-mon-stat-card">
                                                                                <div class="label">Ngày công trong tháng</div>
                                                                                <div class="val">@_expandedDetail.MonthlyWorkdays</div>
                                                                            </div>
                                                                            <div class="tf-mon-stat-card">
                                                                                <div class="label">Đã chấm đầy đủ</div>
                                                                                <div class="val text-success">@_expandedDetail.FullAttendanceDays</div>
                                                                            </div>
                                                                            <div class="tf-mon-stat-card">
                                                                                <div class="label">Chưa chấm công</div>
                                                                                <div class="val text-danger">@_expandedDetail.MissingWorkdays</div>
                                                                            </div>
                                                                            <div class="tf-mon-stat-card">
                                                                                <div class="label">Đi muộn</div>
                                                                                <div class="val text-warning">@_expandedDetail.LateCount</div>
                                                                            </div>
                                                                            <div class="tf-mon-stat-card">
                                                                                <div class="label">Về sớm</div>
                                                                                <div class="val text-warning">@_expandedDetail.EarlyCount</div>
                                                                            </div>
                                                                            <div class="tf-mon-stat-card">
                                                                                <div class="label">Thiếu check-in</div>
                                                                                <div class="val text-danger">@_expandedDetail.MissingCheckInCount</div>
                                                                            </div>
                                                                            <div class="tf-mon-stat-card">
                                                                                <div class="label">Thiếu check-out</div>
                                                                                <div class="val text-danger">@_expandedDetail.MissingCheckOutCount</div>
                                                                            </div>
                                                                            <div class="tf-mon-stat-card">
                                                                                <div class="label">Tổng giờ làm việc</div>
                                                                                <div class="val">@_expandedDetail.TotalWorkingHoursDisplay</div>
                                                                            </div>
                                                                            <div class="tf-mon-stat-card">
                                                                                <div class="label">Tăng ca ghi nhận (≤2h/ng)</div>
                                                                                <div class="val" style="color: #6366f1;">@_expandedDetail.TotalOvertimeHoursDisplay</div>
                                                                            </div>
                                                                        </div>
                                                                    }
                                                                    else if (_monSubTab == "leave")
                                                                    {
                                                                        <div class="tf-mon-stat-grid">
                                                                            <div class="tf-mon-stat-card">
                                                                                <div class="label">Tổng phép được cấp</div>
                                                                                <div class="val" style="color: #0284c7;">@_expandedDetail.TotalLeaveEntitled ngày</div>
                                                                            </div>
                                                                            <div class="tf-mon-stat-card">
                                                                                <div class="label">Đã sử dụng</div>
                                                                                <div class="val text-danger">@_expandedDetail.LeaveUsedDays ngày</div>
                                                                            </div>
                                                                            <div class="tf-mon-stat-card">
                                                                                <div class="label">Đang chờ duyệt</div>
                                                                                <div class="val text-warning">@_expandedDetail.LeavePendingDays ngày</div>
                                                                            </div>
                                                                            <div class="tf-mon-stat-card">
                                                                                <div class="label">Số ngày còn lại</div>
                                                                                <div class="val text-success">@_expandedDetail.LeaveRemainingDays ngày</div>
                                                                            </div>
                                                                            <div class="tf-mon-stat-card">
                                                                                <div class="label">Đã khôi phục / điều chỉnh</div>
                                                                                <div class="val" style="color: #8b5cf6;">@_expandedDetail.LeaveAdjustedOrRestoredDays ngày</div>
                                                                            </div>
                                                                        </div>
                                                                    }
                                                                    else if (_monSubTab == "anomalies")
                                                                    {
                                                                        @if (_expandedDetail.Anomalies.Count == 0)
                                                                        {
                                                                            <div style="padding: 1.5rem; text-align: center; color: var(--tf-text-secondary, #64748b);">
                                                                                Không có vi phạm hoặc bất thường nào trong tháng này.
                                                                            </div>
                                                                        }
                                                                        else
                                                                        {
                                                                            <div class="tf-table-responsive" style="margin-top: 0.5rem;">
                                                                                <table class="tf-table">
