    private async Task ChangeMonitoringMonthAsync(string mode)
    {
        _monitoringMonthMode = mode;
        if (mode == "current")
        {
            _monitoringMonth = DateTime.Today.Month;
            _monitoringYear = DateTime.Today.Year;
        }
        else if (mode == "prev")
        {
            var prev = DateTime.Today.AddMonths(-1);
            _monitoringMonth = prev.Month;
            _monitoringYear = prev.Year;
        }

        if (_expandedEmpId.HasValue)
        {
            _isLoadingMonitoringDetail = true;
            try
            {
                _expandedDetail = await AttendanceService.GetEmployeeMonitoringDetailAsync(_expandedEmpId.Value, _monitoringMonth, _monitoringYear);
            }
            finally
            {
                _isLoadingMonitoringDetail = false;
            }
        }
    }

