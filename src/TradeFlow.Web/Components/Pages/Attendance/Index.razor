    private async Task ExportCsv()

    {

        var csvHeader = "Mã NV,Họ tên,Phòng ban,Công chuẩn,Công thực tế,Tổng giờ làm,Số lần muộn,Tổng phút muộn,Số lần về sớm,Nghỉ phép (ngày),Điểm chuyên cần\n";

        var lines = _monthlyReports.Select(r => $"\"{r.EmployeeCode}\",\"{r.EmployeeName}\",\"{r.DepartmentName}\",{r.StandardWorkDays},{r.ActualWorkDays},{r.TotalWorkingHours},{r.LateTimes},{r.LateTotalMinutes},{r.EarlyLeaveTimes},{r.PaidLeaveDays + r.UnpaidLeaveDays},{r.AttendanceScore}");

        var csvContent = csvHeader + string.Join("\n", lines);



        var bytes = System.Text.Encoding.UTF8.GetPreamble().Concat(System.Text.Encoding.UTF8.GetBytes(csvContent)).ToArray();

        var base64 = Convert.ToBase64String(bytes);

        var filename = $"Bang_Cham_Cong_Thang_{_selectedMonth}_{_selectedYear}.csv";



        try

        {

            await JS.InvokeVoidAsync("downloadFileFromBase64", filename, "text/csv;charset=utf-8", base64);

        }

        catch

        {

            // Fallback

            await JS.InvokeVoidAsync("alert", $"Đã xuất báo cáo bảng công {_monthlyReports.Count} nhân viên.");

        }

    }



