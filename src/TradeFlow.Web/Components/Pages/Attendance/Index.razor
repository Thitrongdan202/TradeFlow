                    </div>

                    <div class="tf-form-group col-6">

                        <label>Giờ kết thúc</label>

                        <input type="time" class="tf-input" value="@_editingShift.EndTime.ToString(@"hh\:mm")" @onchange='(ChangeEventArgs e) => { if (TimeSpan.TryParse(e.Value?.ToString(), out var t)) _editingShift.EndTime = t; }' />

                    </div>

                </div>



                <div class="tf-form-row">

                    <div class="tf-form-group col-6">

                        <label>Nghỉ giữa ca (phút)</label>

                        <input type="number" class="tf-input" @bind="_editingShift.BreakMinutes" />

                    </div>

                    <div class="tf-form-group col-6">

                        <label>Thời gian ân hạn đi muộn (phút)</label>

                        <input type="number" class="tf-input" @bind="_editingShift.GracePeriodMinutes" />

                    </div>

                </div>



                <div class="tf-form-row">

                    <div class="tf-form-group col-6">

                        <label>Màu đại diện (Hex)</label>

                        <input type="text" class="tf-input" @bind="_editingShift.Color" />

                    </div>

                    <div class="tf-form-group col-6">

