                                            </td>

                                            <td><span class="tf-req-pill adj">@item.RequestTypeLabel</span></td>

                                            <td>@item.TargetDateDisplay</td>

                                            <td>@item.ProposedClockInDisplay - @item.ProposedClockOutDisplay</td>

                                            <td>@item.Reason</td>

                                            <td>

                                                <button type="button" class="tf-btn-appr-ok" @onclick="() => ReviewAdjustment(item.Id, true)">Duyệt</button>

                                                <button type="button" class="tf-btn-appr-rej" @onclick="() => ReviewAdjustment(item.Id, false)">Từ chối</button>

                                            </td>

                                        </tr>

                                    }

                                }

                            </tbody>

                        </table>

                    }

                    else if (_apprSubTab == "leave")

                    {

                        <table class="tf-table">

                            <thead>

                                <tr>

                                    <th>Nhân viên</th>

                                    <th>Loại phép</th>

                                    <th>Thời gian</th>

                                    <th>Số ngày</th>

                                    <th>Lý do</th>

                                    <th>Hành động</th>

                                </tr>

                            </thead>

                            <tbody>

                                @if (_pendingLeaves.Count == 0)

                                {

                                    <tr><td colspan="6" class="tf-empty-table">Không có đơn xin nghỉ phép nào đang chờ duyệt.</td></tr>

                                }

                                else

                                {

                                    @foreach (var item in _pendingLeaves)

                                    {

                                        <tr>

                                            <td>

                                                <strong>@item.EmployeeName</strong> (@item.EmployeeCode)

                                                <div class="text-muted smaller">@item.DepartmentName</div>

                                            </td>

                                            <td><span class="tf-req-pill leave">@item.LeaveTypeLabel</span></td>

                                            <td>@item.DateRangeDisplay</td>

                                            <td><strong>@item.TotalDays</strong> ngày</td>

                                            <td>@item.Reason</td>

                                            <td>

                                                <button type="button" class="tf-btn-appr-ok" @onclick="() => ReviewLeave(item.Id, true)">Duyệt</button>

                                                <button type="button" class="tf-btn-appr-rej" @onclick="() => ReviewLeave(item.Id, false)">Từ chối</button>

                                            </td>

                                        </tr>

                                    }

                                }

                            </tbody>

                        </table>

                    }

                    else if (_apprSubTab == "shift")

                    {

                        <table class="tf-table">

                            <thead>

                                <tr>

                                    <th>Nhân viên</th>

                                    <th>Ngày đổi</th>

                                    <th>Ca hiện tại</th>

                                    <th>Ca đề xuất</th>

                                    <th>Lý do</th>

                                    <th>Hành động</th>

                                </tr>

                            </thead>

                            <tbody>

                                @if (_pendingShifts.Count == 0)

                                {

                                    <tr><td colspan="6" class="tf-empty-table">Không có đơn đổi ca nào đang chờ duyệt.</td></tr>

                                }

                                else

                                {

                                    @foreach (var item in _pendingShifts)

                                    {

                                        <tr>

                                            <td>

                                                <strong>@item.EmployeeName</strong> (@item.EmployeeCode)

                                                <div class="text-muted smaller">@item.DepartmentName</div>

                                            </td>

                                            <td>@item.TargetDateDisplay</td>

                                            <td>@item.CurrentWorkShiftName</td>

                                            <td><span class="text-primary font-weight-bold">@item.ProposedWorkShiftName</span></td>

                                            <td>@item.Reason</td>

                                            <td>

                                                <button type="button" class="tf-btn-appr-ok" @onclick="() => ReviewShift(item.Id, true)">Duyệt</button>

                                                <button type="button" class="tf-btn-appr-rej" @onclick="() => ReviewShift(item.Id, false)">Từ chối</button>

                                            </td>

                                        </tr>

                                    }

                                }

                            </tbody>

                        </table>

                    }

                </div>

            </div>



            <div class="tf-modal-footer">

                <button type="button" class="tf-btn-secondary" @onclick="CloseApprovalCenter">Đóng</button>

            </div>

        </div>

    </div>

    }



    @* --- MODAL: WORK SHIFT FORM (ADD / EDIT) --- *@

    @if (_showShiftFormModal)

    {

        <div class="tf-modal-overlay-container" @onclick="() => _showShiftFormModal = false">

            <div class="tf-modal-dialog" role="dialog" aria-modal="true" @onclick:stopPropagation="true">

