@page "/cham-cong"

@using Microsoft.AspNetCore.Authorization

@using Microsoft.AspNetCore.Components.Authorization

@using TradeFlow.Application.Common.Interfaces

@using TradeFlow.Application.Common.Models.Attendance

@using TradeFlow.Application.Common.Models.Employees

@using TradeFlow.Domain.Entities.Attendance

@using TradeFlow.Domain.Enums

@rendermode InteractiveServer



@inject IAttendanceService AttendanceService

@inject ICurrentUserService CurrentUserService

@inject IEmployeeService EmployeeService

@inject AuthenticationStateProvider AuthStateProvider

@inject IJSRuntime JS

@inject NavigationManager NavManager

@inject ILogger<Index> Logger



<PageTitle>Quản lý Chấm công &amp; Ca làm việc — TradeFlow ERP</PageTitle>



<div class="tf-attendance-page" id="tf-attendance-root">

    @* --- TOP HEADER & IDENTITY BAR --- *@

    <div class="tf-att-header">

        <div class="tf-att-header-left">

            <div class="tf-att-icon-badge">

                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">

                    <circle cx="12" cy="12" r="10" />

                    <polyline points="12 6 12 12 16 14" />

                </svg>

            </div>

            <div>

                <h1 class="tf-att-title">Hệ thống Chấm công &amp; Quản trị Ca làm việc</h1>

                <p class="tf-att-subtitle">

                    Theo dõi chấm công thời gian thực, quản lý ca làm, phê duyệt giải trình và báo cáo bảng công

                </p>

            </div>

        </div>



        <div class="tf-att-header-right">

            @* Live Vietnam Server Time Clock *@

            <div class="tf-server-clock" title="Giờ máy chủ chuẩn Việt Nam (UTC+7)">

                <span class="tf-clock-pulse"></span>

                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">

                    <circle cx="12" cy="12" r="10"/>

                    <polyline points="12 6 12 12 15 15"/>

                </svg>

                <span class="tf-clock-time">@_liveServerTime.ToString("HH:mm:ss")</span>

                <span class="tf-clock-tz">VN (UTC+7)</span>

            </div>



            @* Current User Profile & Role Pill *@

            @if (_isAdmin)

            {

                <div class="tf-owner-admin-card" id="tf-attendance-admin-identity" title="Danh tính Quản trị viên hệ thống cấp cao (Owner / Admin)">

                    <div class="tf-admin-shield-icon">

                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">

                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>

                            <polyline points="9 12 11 14 15 10"/>

                        </svg>

                    </div>

                    <div class="tf-admin-meta">

                        <div class="tf-admin-title-row">

                            <span class="tf-admin-primary-label">OWNER / ADMIN</span>

                            <span class="tf-admin-super-badge">System Owner</span>

                        </div>

                        <span class="tf-admin-sub-label">Toàn quyền hệ thống</span>

                    </div>

                </div>

            }

            else

            {

                <div class="tf-user-role-card" id="tf-attendance-user-identity">

                    <div class="tf-user-avatar-mini">

                        @if (!string.IsNullOrWhiteSpace(_currentEmpAvatar))

                        {

                            <img src="@_currentEmpAvatar" alt="@_currentEmpName" />

                        }

                        else

                        {

                            <div class="tf-avatar-placeholder">@GetInitials(_currentEmpName)</div>

                        }

                    </div>

                    <div class="tf-user-meta">

                        <span class="tf-user-name">@_currentEmpName</span>

                        <span class="tf-user-role-tag tf-role-@_activeRole.ToLower()">@_activeRoleLabel</span>

                    </div>

                </div>

            }

        </div>

    </div>



        @* --- ROLE-AWARE TAB NAVIGATION (Categorized & Zero Overflow) --- *@
    <div class="tf-att-nav-bar">
        <div class="tf-att-tabs">
            @* Primary Tab 1: Always Personal *@
            <button type="button" class="tf-tab-btn @(_currentTab == "personal" ? "active" : "")" @onclick='() => SetTab("personal")'>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                </svg>
                <span>Cá nhân &amp; Chấm công</span>
            </button>

            @if (_isAdmin)
            {
                @* Admin Primary Tabs: Personal, HR, Approvals, Audit *@
                <button type="button" class="tf-tab-btn @(_currentTab == "hr" ? "active" : "")" @onclick='() => SetTab("hr")'>
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                        <line x1="8" y1="21" x2="16" y2="21"></line>
                        <line x1="12" y1="17" x2="12" y2="21"></line>
                    </svg>
                    <span>HR Dashboard</span>
                    @if (_hrKpis != null && _hrKpis.PendingRequestsCount > 0)
                    {
                        <span class="tf-tab-badge alert">@_hrKpis.PendingRequestsCount</span>
                    }
                </button>

                <button type="button" class="tf-tab-btn @(_currentTab == "approvals" ? "active" : "")" @onclick='() => SetTab("approvals")'>
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="9 11 12 14 22 4"></polyline>
                        <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                    </svg>
                    <span>Duyệt đơn</span>
                    @if ((_pendingAdjustments.Count + _pendingLeaves.Count + _pendingShifts.Count) > 0)
                    {
                        <span class="tf-tab-badge alert">@(_pendingAdjustments.Count + _pendingLeaves.Count + _pendingShifts.Count)</span>
                    }
                </button>

                <button type="button" class="tf-tab-btn @(_currentTab == "audit" ? "active" : "")" @onclick='() => SetTab("audit")'>
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
