                        <span class="tf-tab-badge alert">@_hrKpis.PendingRequestsCount</span>
                    }
                </button>

                <button type="button" class="tf-tab-btn @(_currentTab == "team" ? "active" : "")" @onclick='() => SetTab("team")'>
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                    </svg>
                    <span>Theo dõi nhân viên</span>
                </button>

                <button type="button" class="tf-tab-btn @(_currentTab == "approvals" ? "active" : "")" @onclick='() => SetTab("approvals")'>
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="9 11 12 14 22 4"></polyline>
                        <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                    </svg>
                    <span>Duyệt đơn</span>
                    @if ((_pendingAdjustments.Count + _pendingLeaves.Count + _pendingShifts.Count) > 0)
                    {
                        <span class="tf-tab-badge alert">@(_pendingAdjustments.Count + _pendingLeaves.Count + _pendingShifts.Count)</span>
                    }
                </button>

                @* HR Dropdown *@
                <div class="tf-tab-dropdown-wrapper">
                    <button type="button" class="tf-tab-btn dropdown-trigger @(IsActiveTabInDropdown() ? "active" : "")" @onclick="ToggleNavDropdown" id="btn-nav-dropdown">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="3" width="7" height="7"></rect>
                            <rect x="14" y="3" width="7" height="7"></rect>
                            <rect x="14" y="14" width="7" height="7"></rect>
                            <rect x="3" y="14" width="7" height="7"></rect>
                        </svg>
                        <span>@GetDropdownTriggerLabel()</span>
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="tf-chevron @(_showNavDropdown ? "open" : "")">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </button>

                    @if (_showNavDropdown)
                    {
                        <div class="tf-dropdown-backdrop" @onclick="CloseNavDropdown"></div>
                        <div class="tf-dropdown-menu" id="tf-nav-dropdown-menu">
                            <button type="button" class="tf-dropdown-item @(_currentTab == "shifts" ? "active" : "")" @onclick='() => SetTab("shifts")'>
                                <span class="tf-drop-item-left">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/></svg>
                                    <span>Quản lý Ca làm việc</span>
                                </span>
                            </button>
                            <button type="button" class="tf-dropdown-item @(_currentTab == "reports" ? "active" : "")" @onclick='() => SetTab("reports")'>
                                <span class="tf-drop-item-left">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.21 15.89A10 10 0 1 1 8 2.83"></path><path d="M22 12A10 10 0 0 0 12 2v10z"></path></svg>
                                    <span>Báo cáo Bảng công</span>
                                </span>
                            </button>
                            <button type="button" class="tf-dropdown-item @(_currentTab == "leave-ledger" ? "active" : "")" @onclick='() => SetTab("leave-ledger")'>
                                <span class="tf-drop-item-left">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                    <span>Số dư phép &amp; Sổ cái</span>
                                </span>
