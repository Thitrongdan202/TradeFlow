                                        <th>Đi muộn (lần/phút)</th>

                                        <th>Về sớm</th>

                                        <th>Nghỉ phép</th>

                                        <th>Điểm chuyên cần</th>

                                    </tr>

                                </thead>

                                <tbody>

                                    @if (_monthlyReports.Count == 0)

                                    {

                                        <tr><td colspan="10" class="tf-empty-table">Không có dữ liệu báo cáo trong tháng này.</td></tr>

                                    }

                                    else

                                    {

                                        @foreach (var rep in _monthlyReports)

                                        {

                                            <tr>

                                                <td><strong>@rep.EmployeeCode</strong></td>

                                                <td>@rep.EmployeeName</td>

                                                <td>@rep.DepartmentName</td>

                                                <td>@rep.StandardWorkDays</td>

                                                <td><strong class="text-primary">@rep.ActualWorkDays</strong></td>

                                                <td>@rep.TotalWorkingHours h</td>

                                                <td>

                                                    @if (rep.LateTimes > 0)

                                                    {

                                                        <span class="tf-badge-warn">@rep.LateTimes lần (@rep.LateTotalMinutes p)</span>

                                                    }

                                                    else

                                                    {

                                                        <span class="text-muted">0</span>

                                                    }

                                                </td>

                                                <td>@rep.EarlyLeaveTimes lần</td>

