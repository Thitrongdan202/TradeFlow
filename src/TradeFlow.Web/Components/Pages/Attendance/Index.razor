                        <input type="text" class="tf-input" @bind="_editingShift.AppliesTo" placeholder="Khối văn phòng, Kho, POS..." />

                    </div>

                </div>



                <div class="tf-form-group">

                    <label class="tf-checkbox-label">

                        <input type="checkbox" @bind="_editingShift.IsOvernight" />

