                <button type="button" class="tf-modal-close" @onclick="() => _showShiftFormModal = false">&times;</button>

            </div>

            <div class="tf-modal-body">

                <div class="tf-form-row">

                    <div class="tf-form-group col-6">

                        <label>Mã ca (VD: CA-HC) <span class="text-danger">*</span></label>

                        <input type="text" class="tf-input" @bind="_editingShift.Code" />

                    </div>

                    <div class="tf-form-group col-6">

                        <label>Tên ca làm việc <span class="text-danger">*</span></label>

                        <input type="text" class="tf-input" @bind="_editingShift.Name" />

                    </div>

                </div>



                <div class="tf-form-row">

                    <div class="tf-form-group col-6">

