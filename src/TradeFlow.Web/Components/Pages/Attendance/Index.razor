    protected override async Task OnInitializedAsync()

    {

        _liveServerTime = DateTime.UtcNow.AddHours(7);

        _clockTimer = new System.Threading.Timer(_ =>

        {

            _liveServerTime = DateTime.UtcNow.AddHours(7);

            InvokeAsync(StateHasChanged);

        }, null, 1000, 1000);



        await ResolveCurrentUserContextAsync();



        if (!string.IsNullOrWhiteSpace(QueryView))

        {

            _currentTab = QueryView.ToLower();

        }



        await LoadDataAsync();

    }



    private async Task ResolveCurrentUserContextAsync()

    {

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();

        var user = authState.User;



        if (user.Identity?.IsAuthenticated == true)

        {

            _userName = user.Identity.Name ?? "";

            _userId = CurrentUserService.UserId ?? "";



            if (user.IsInRole("Administrator") || string.Equals(_userName, "admin", StringComparison.OrdinalIgnoreCase))

            {

                _isAdmin = true;

                _canViewTeam = true;

                _canViewHr = true;

                _activeRole = "Administrator";

                _activeRoleLabel = "Owner / Admin";

                _currentEmployeeId = null;

                _currentEmpName = "Owner / Admin";

                _currentEmpAvatar = null;

            }

            else if (user.IsInRole("HR"))

            {

                _canViewHr = true;

                _canViewTeam = true;

                _activeRole = "HR";

                _activeRoleLabel = "Nhân sự HR";

            }

            else if (user.IsInRole("Manager"))

            {

                _canViewTeam = true;

                _activeRole = "Manager";

                _activeRoleLabel = "Quản lý nhóm";

            }

            else

            {

                _activeRole = "Employee";

                _activeRoleLabel = "Nhân viên";

            }



            _isUserExempt = await AttendanceService.IsUserExemptFromAttendanceAsync(_userId);

            if (!_isAdmin)

            {

                _currentEmployeeId = await AttendanceService.ResolveEmployeeIdForUserAsync(_userId);

                if (_currentEmployeeId.HasValue)

                {

                    var emp = await EmployeeService.GetEmployeeByIdAsync(_currentEmployeeId.Value);

                    if (emp != null)

                    {

                        _currentEmpName = emp.FullName;

                        _currentEmpAvatar = emp.AvatarPath;

                    }

                }

            }

        }

    }



