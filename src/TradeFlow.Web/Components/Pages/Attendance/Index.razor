    private List<AttendanceCalendarDayDto> GetCurrentWeekDays()
    {
        if (_calendarDays == null || _calendarDays.Count == 0)
            return new List<AttendanceCalendarDayDto>();

        var today = DateTime.UtcNow.AddHours(7).Date;
        var refDay = _calendarDays.FirstOrDefault(d => d.Date == today) ?? _selectedDay ?? _calendarDays.FirstOrDefault();
        if (refDay == null)
            return _calendarDays.Take(7).ToList();

        var refDate = refDay.Date;
        var dow = (int)refDate.DayOfWeek;
        int daysFromMon = (dow == 0) ? 6 : dow - 1;
        var monday = refDate.AddDays(-daysFromMon);

        var week = new List<AttendanceCalendarDayDto>();
        for (int i = 0; i < 7; i++)
        {
            var d = monday.AddDays(i);
            var existing = _calendarDays.FirstOrDefault(cd => cd.Date == d);
            if (existing != null)
            {
                week.Add(existing);
            }
            else
            {
                var isWeekend = d.DayOfWeek == DayOfWeek.Saturday || d.DayOfWeek == DayOfWeek.Sunday;
                week.Add(new AttendanceCalendarDayDto
                {
                    Date = d,
                    IsCurrentMonth = (d.Month == _selectedMonth && d.Year == _selectedYear),
                    IsToday = (d == today),
                    StatusLabel = isWeekend ? "Cuối tuần" : "Chưa có dữ liệu",
                    BadgeClass = isWeekend ? "tf-cal-badge-weekend" : "tf-cal-badge-future",
                    DotColor = isWeekend ? "#94a3b8" : "#cbd5e1"
                });
            }
        }
        return week;
    }

