    private bool IsActiveTabInDropdown()
    {
        if (_isAdmin)
        {
            return _currentTab is "team" or "shifts" or "reports" or "leave-ledger" or "history";
        }
        if (_canViewHr)
        {
            return _currentTab is "shifts" or "reports" or "leave-ledger" or "history";
