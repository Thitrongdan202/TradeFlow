                                <span class="tf-drop-item-left">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/></svg>
                                    <span>Lịch sử &amp; Đơn cá nhân</span>
                                </span>
                            </button>
                        </div>
                    }
                </div>
            }
            else if (_canViewTeam)
            {
                @* Manager Primary Tabs: Personal, Team, Approvals *@
                <button type="button" class="tf-tab-btn @(_currentTab == "team" ? "active" : "")" @onclick='() => SetTab("team")'>
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
