    private static bool IsAdminActor(string? nameOrUser)

    {

        if (string.IsNullOrWhiteSpace(nameOrUser)) return false;

        var clean = nameOrUser.Trim().ToLowerInvariant();

        return clean == "admin" || clean == "administrator" || clean == "quản trị viên" || clean.Contains("owner");

    }

    private static string GetInitials(string? name)

    {

        if (string.IsNullOrWhiteSpace(name)) return "TF";

        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length == 1) return parts[0][0].ToString().ToUpper();

        return $"{parts[0][0]}{parts[^1][0]}".ToUpper();

    }



