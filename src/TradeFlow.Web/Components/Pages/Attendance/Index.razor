    private async Task SubmitGrantLeaveAsync()

    {

        if (_grantEmployeeId <= 0 || _grantDays <= 0 || string.IsNullOrWhiteSpace(_grantReason))

        {

            _grantErrorMessage = "Vui lòng chọn nhân viên, số ngày (>0) và ghi rõ lý do cấp phép bổ sung.";

            return;

        }



        _isSubmittingModal = true;

        _grantErrorMessage = null;



        try

        {

            var cmd = new GrantExtraLeaveCommand

            {

                EmployeeId = _grantEmployeeId,

                Days = _grantDays,

                Reason = _grantReason,

                Notes = _grantNotes

            };



            var success = await AttendanceService.GrantExtraLeaveAsync(cmd, _userId, _currentEmpName, _isAdmin);

            if (success)

            {

                _showGrantLeaveModal = false;

                await LoadTabSpecificDataAsync();

            }

            else

            {

                _grantErrorMessage = "Không thể ghi sổ phát sinh phép. Vui lòng kiểm tra lại.";

            }

        }

        catch (Exception ex)

        {

            _grantErrorMessage = ex.Message;

        }

        finally

        {

            _isSubmittingModal = false;

        }

    }



