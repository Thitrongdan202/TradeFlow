                            </div>

                        </div>



                        <div class="tf-table-responsive">

                            <table class="tf-table">

                                <thead>

                                    <tr>

                                        <th>Thời điểm (VN)</th>

                                        <th>Hành động</th>

                                        <th>Mô tả chi tiết</th>

                                        <th>Người thực hiện</th>

                                        <th>Địa chỉ IP</th>

                                    </tr>

                                </thead>

                                <tbody>

                                    @if (_auditLogs.Count == 0)

                                    {

                                        <tr><td colspan="5" class="tf-empty-table">Không có bản ghi nhật ký nào.</td></tr>

                                    }

                                    else

                                    {

                                        @foreach (var log in _auditLogs)

                                        {

                                            <tr>

                                                <td><span class="tf-time">@log.ChangedAtDisplay</span></td>

                                                <td><span class="tf-log-action @log.Action.ToLower()">@log.Action</span></td>

                                                <td>@log.Description</td>

                                                <td>

    @if (IsAdminActor(log.ChangedByUserName))

    {

        <span class="tf-admin-actor-badge">

            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">

                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>

            </svg>

            Owner / Admin

        </span>

    }

    else

    {

        <strong>@log.ChangedByUserName</strong>

    }

</td>

                                                <td><span class="text-muted">@(log.IpAddress ?? "Internal")</span></td>

                                            </tr>

                                        }

                                    }

                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>

            }

        }

    </div>



    @* --- MODAL: CREATE REQUEST (ADJUSTMENT / LEAVE / SHIFT) --- *@

    @if (_showRequestModal)

    {

        <div class="tf-modal-overlay-container" @onclick="CloseRequestModal">

            <div class="tf-modal-dialog" role="dialog" aria-modal="true" id="tf-request-dialog" @onclick:stopPropagation="true">

            <div class="tf-modal-header">

                <div class="tf-modal-title">

                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">

                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>

                        <line x1="12" y1="11" x2="12" y2="17"></line>

                        <line x1="9" y1="14" x2="15" y2="14"></line>

                    </svg>

                    Tạo đơn Yêu cầu / Giải trình Chấm công

                </div>

                <button type="button" class="tf-modal-close" @onclick="CloseRequestModal">&times;</button>

            </div>



            <div class="tf-modal-body">

                @* Modal Type Tabs *@

                <div class="tf-modal-tabs">

                    <button type="button" class="tf-m-tab @(_reqSubTab == "adjustment" ? "active" : "")" @onclick='() => _reqSubTab = "adjustment"'>Giải trình giờ công</button>

                    <button type="button" class="tf-m-tab @(_reqSubTab == "leave" ? "active" : "")" @onclick='() => _reqSubTab = "leave"'>Xin nghỉ phép</button>

                    <button type="button" class="tf-m-tab @(_reqSubTab == "shift" ? "active" : "")" @onclick='() => _reqSubTab = "shift"'>Đổi ca làm việc</button>

                </div>



                @if (_reqSubTab == "adjustment")

                {

                    <div class="tf-form-group">

                        <label>Loại giải trình <span class="text-danger">*</span></label>

                        <select class="tf-input" @bind="_adjType">

                            <option value="@AttendanceAdjustmentType.MissedClockIn">Quên chấm công vào ca</option>

                            <option value="@AttendanceAdjustmentType.MissedClockOut">Quên chấm công ra ca</option>

                            <option value="@AttendanceAdjustmentType.TimeCorrection">Sai lệch giờ (cần sửa giờ)</option>

                            <option value="@AttendanceAdjustmentType.DeviceError">Lỗi thiết bị / sự cố kỹ thuật</option>

                            <option value="@AttendanceAdjustmentType.BusinessTrip">Công tác bên ngoài văn phòng</option>

                        </select>

                    </div>



                    <div class="tf-form-group">

                        <label>Ngày cần điều chỉnh <span class="text-danger">*</span></label>

                        <input type="date" class="tf-input" @bind="_adjTargetDate" />

                    </div>



                    <div class="tf-form-row">

                        <div class="tf-form-group col-6">

                            <label>Giờ vào đề xuất</label>

                            <input type="time" class="tf-input" @bind="_adjProposedInTime" />

                        </div>

                        <div class="tf-form-group col-6">

                            <label>Giờ ra đề xuất</label>

                            <input type="time" class="tf-input" @bind="_adjProposedOutTime" />

                        </div>

                    </div>



                    <div class="tf-form-group">

                        <label>Lý do giải trình cụ thể <span class="text-danger">*</span></label>

                        <textarea class="tf-input" rows="3" placeholder="Nêu rõ lý do quên chấm hoặc sai lệch giờ..." @bind="_adjReason"></textarea>

                    </div>

                }

                else if (_reqSubTab == "leave")

                {

                    <div class="tf-form-group">

                        <label>Loại nghỉ phép <span class="text-danger">*</span></label>

                        <select class="tf-input" @bind="_leaveType">

                            <option value="@LeaveType.AnnualLeave">Nghỉ phép thường niên (hưởng nguyên lương)</option>

                            <option value="@LeaveType.SickLeave">Nghỉ ốm đau / BHXH</option>

                            <option value="@LeaveType.UnpaidLeave">Nghỉ việc riêng không hưởng lương</option>

                            <option value="@LeaveType.WeddingLeave">Nghỉ việc cưới (hưởng lương theo BLLĐ)</option>

                            <option value="@LeaveType.FuneralLeave">Nghỉ việc tang (hưởng lương theo BLLĐ)</option>

                        </select>

                    </div>



                    <div class="tf-form-row">

                        <div class="tf-form-group col-6">

                            <label>Từ ngày <span class="text-danger">*</span></label>

                            <input type="date" class="tf-input" @bind="_leaveStartDate" />

                        </div>

                        <div class="tf-form-group col-6">

                            <label>Đến hết ngày <span class="text-danger">*</span></label>

                            <input type="date" class="tf-input" @bind="_leaveEndDate" />

                        </div>

                    </div>



                    <div class="tf-form-group">

                        <label>Lý do xin nghỉ phép <span class="text-danger">*</span></label>

                        <textarea class="tf-input" rows="3" placeholder="Mô tả lý do nghỉ phép..." @bind="_leaveReason"></textarea>

                    </div>

                }

                else if (_reqSubTab == "shift")

                {

                    <div class="tf-form-group">

                        <label>Ngày muốn đổi ca <span class="text-danger">*</span></label>

                        <input type="date" class="tf-input" @bind="_shiftTargetDate" />

                    </div>



                    <div class="tf-form-row">

                        <div class="tf-form-group col-6">

                            <label>Ca hiện tại</label>

                            <select class="tf-input" @bind="_shiftCurrentId">

                                @foreach (var s in _workShifts)

                                {

                                    <option value="@s.Id">@s.Name</option>

                                }

                            </select>

                        </div>

                        <div class="tf-form-group col-6">

                            <label>Ca mong muốn chuyển sang</label>

                            <select class="tf-input" @bind="_shiftProposedId">

                                @foreach (var s in _workShifts)

                                {

                                    <option value="@s.Id">@s.Name</option>

                                }

                            </select>

                        </div>

                    </div>



                    <div class="tf-form-group">

                        <label>Lý do đổi ca</label>

                        <textarea class="tf-input" rows="2" placeholder="Ghi chú lý do..." @bind="_shiftReason"></textarea>

                    </div>

                }



                @if (!string.IsNullOrWhiteSpace(_modalErrorMessage))

                {

                    <div class="tf-modal-alert error">@_modalErrorMessage</div>

                }

            </div>



            <div class="tf-modal-footer">

                <button type="button" class="tf-btn-secondary" @onclick="CloseRequestModal">Hủy</button>

                <button type="button" class="tf-btn-primary" @onclick="SubmitRequestModal" disabled="@_isSubmittingModal">

                    @if (_isSubmittingModal)

                    {

                        <span class="tf-spinner-btn"></span>

                    }

                    <span>GỬI ĐƠN YÊU CẦU</span>

                </button>

            </div>

        </div>

    </div>

    }



    @* --- MODAL: APPROVAL CENTER (HR & MANAGER) --- *@

    @if (_showApprovalModal)

    {

        <div class="tf-modal-overlay-container" @onclick="CloseApprovalCenter">

