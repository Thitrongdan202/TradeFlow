@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public ContractDto? Contract { get; set; }
    [Parameter] public string InitialVersion { get; set; } = "auto";
    [Parameter] public EventCallback OnRequestSign { get; set; }

    // Chrome Print Controls State
    private string Destination { get; set; } = "printer";
    private string SelectedVersion { get; set; } = "unsigned";
    private string OrientationValue { get; set; } = "portrait";
    private bool IsLandscape => OrientationValue == "landscape";
    private string PageSelectionMode { get; set; } = "all";
    private string CustomPageRange { get; set; } = "1";
    private string MarginMode { get; set; } = "default";
    private string ScaleMode { get; set; } = "100";
    private bool ShowDocumentFooter { get; set; } = true;

    private bool isDownloading = false;
    private bool isPrinting = false;
    private int? _lastContractId;
    private bool _wasOpen;
    private bool _shouldAnimateEntrance;

    protected override void OnParametersSet()
    {
        if (IsOpen && Contract != null && (!_wasOpen || _lastContractId != Contract.Id))
        {
            _lastContractId = Contract.Id;
            _shouldAnimateEntrance = true;
            if (InitialVersion == "unsigned")
                SelectedVersion = "unsigned";
            else if (InitialVersion == "signed")
                SelectedVersion = "signed";
            else
                SelectedVersion = Contract.IsDigitallySigned ? "signed" : "unsigned";

            OrientationValue = "portrait";
            PageSelectionMode = "all";
            MarginMode = "default";
            ScaleMode = "100";
            ShowDocumentFooter = true;
        }
        _wasOpen = IsOpen;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsOpen && Contract != null && _shouldAnimateEntrance)
        {
            _shouldAnimateEntrance = false;
            try
            {
                await JS.InvokeVoidAsync("TradeFlowMotion.animateModalEnter", "#tf-contract-preview-modal", ".tf-contract-preview-backdrop");
            }
            catch { }
        }
    }

    private async Task SwitchVersionAsync(string version)
    {
        if (SelectedVersion == version) return;
        SelectedVersion = version;
        StateHasChanged();
        try
        {
            await JS.InvokeVoidAsync("TradeFlowMotion.animateTabContent", "#tf-contract-preview-stage");
        }
        catch { }
    }

    private void OnVersionChanged()
    {
        StateHasChanged();
    }

    private void OnOrientationChanged()
    {
        StateHasChanged();
    }

    private int GetVisiblePageCount(int totalPages)
    {
        if (PageSelectionMode != "custom" || string.IsNullOrWhiteSpace(CustomPageRange))
            return totalPages;

        var set = ParsePageRange(CustomPageRange, totalPages);
        return set != null && set.Count > 0 ? set.Count : totalPages;
    }

    private static HashSet<int>? ParsePageRange(string? range, int totalPages)
    {
        if (string.IsNullOrWhiteSpace(range) || range.Trim().Equals("all", StringComparison.OrdinalIgnoreCase))
            return null;

        var result = new HashSet<int>();
        var parts = range.Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries);
        foreach (var part in parts)
        {
            var trimmed = part.Trim();
            if (trimmed.Contains('-'))
            {
                var bounds = trimmed.Split('-');
                if (bounds.Length == 2 && int.TryParse(bounds[0], out int start) && int.TryParse(bounds[1], out int end))
                {
                    for (int i = Math.Max(1, start); i <= Math.Min(totalPages, end); i++)
                        result.Add(i);
                }
            }
            else if (int.TryParse(trimmed, out int single) && single >= 1 && single <= totalPages)
            {
                result.Add(single);
            }
        }

        return result.Count > 0 ? result : null;
    }

    private async Task ExecutePrintOrPdfActionAsync()
    {
        if (Destination == "pdf")
        {
            await DownloadCurrentVersionPdfAsync();
        }
        else
        {
            await PrintCurrentVersionAsync();
        }
    }

    private async Task PrintCurrentVersionAsync()
    {
        if (Contract == null || isPrinting) return;
        if (SelectedVersion == "signed" && !Contract.IsDigitallySigned) return;

        try
        {
            isPrinting = true;
            StateHasChanged();

            // When custom page range or landscape is selected, print via styled HTML iframe
            if (PageSelectionMode == "custom" || IsLandscape || MarginMode != "default")
            {
                await JS.InvokeVoidAsync("tradeflow.printDocument", "tf-modal-contract-sheet", Contract.ContractNumber);
            }
            else
            {
                var pdfUrl = $"/api/contracts/{Contract.Id}/export-pdf?version={SelectedVersion}&inline=true";
                await JS.InvokeVoidAsync("tradeflow.printPdfUrl", pdfUrl);
            }
        }
        catch { }
        finally
        {
            isPrinting = false;
            StateHasChanged();
        }
    }

    private async Task DownloadCurrentVersionPdfAsync()
    {
        if (Contract == null || isDownloading) return;
        if (SelectedVersion == "signed" && !Contract.IsDigitallySigned) return;

        try
        {
            isDownloading = true;
            StateHasChanged();
            var rawNumber = string.IsNullOrWhiteSpace(Contract.ContractNumber) ? $"HD-{Contract.Id}" : Contract.ContractNumber.Trim();
            var safeCode = string.Concat(rawNumber.Split(System.IO.Path.GetInvalidFileNameChars())).Replace(" ", "_");
            var suffix = SelectedVersion == "unsigned" ? "_Ban_chua_ky" : "_Ban_da_ky_so";
            var filename = $"Hop_dong_{safeCode}{suffix}.pdf";
            var url = $"/api/contracts/{Contract.Id}/export-pdf?version={SelectedVersion}";
            await JS.InvokeVoidAsync("tradeflow.downloadPdf", url, filename);
        }
        catch { }
        finally
        {
            isDownloading = false;
            StateHasChanged();
        }
    }

    private async Task TriggerSignAsync()
    {
        await CloseAsync();
        if (OnRequestSign.HasDelegate)
        {
            await OnRequestSign.InvokeAsync();
        }
    }

    private async Task CloseAsync()
    {
        IsOpen = false;
        try
        {
            await JS.InvokeVoidAsync("TradeFlowMotion.unlockScroll", true);
        }
        catch { }
        await IsOpenChanged.InvokeAsync(false);
    }

    private static string GetStatusVietnamese(ContractStatus status) => status switch
    {
        ContractStatus.Draft => "Bản nháp",
        ContractStatus.PendingSignature => "Chờ ký",
        ContractStatus.Signed => "Đã ký",
        ContractStatus.Printed => "Đã in giấy",
        ContractStatus.Liquidated => "Đã thanh lý",
        ContractStatus.Cancelled => "Đã hủy",
        _ => status.ToString()
    };

    private static string GetStatusBadgeClass(ContractStatus status) => status switch
    {
        ContractStatus.Draft => "bg-secondary text-white",
        ContractStatus.PendingSignature => "bg-warning text-dark",
        ContractStatus.Signed => "bg-success text-white",
        ContractStatus.Printed => "bg-info text-dark",
        ContractStatus.Liquidated => "bg-primary text-white",
        ContractStatus.Cancelled => "bg-danger text-white",
        _ => "bg-light text-dark"
    };
}
