@using TradeFlow.Application.Common.Helpers
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Application.Common.Models.Contracts
@using TradeFlow.Domain.Enums
@implements IAsyncDisposable
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IContractService ContractService

<div class="tf-contract-gallery-wrapper" @ref="galleryContainer">
    <!-- Gallery Controls (Light Theme) -->
    <div class="tf-gallery-controls">
        <div class="tf-controls-top">
            <div class="tf-search-box">
                <svg class="tf-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"/>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
                <input type="text"
                       class="tf-search-input"
                       placeholder="Tìm kiếm theo tên mẫu hợp đồng, căn cứ pháp lý, đối tượng..."
                       value="@searchQuery"
                       @oninput="OnSearchInput" />
                @if (!string.IsNullOrEmpty(searchQuery))
                {
                    <button type="button" class="tf-search-clear" @onclick="ClearSearch" title="Xóa tìm kiếm">✕</button>
                }
            </div>
            <div class="tf-gallery-counter">
                Hiển thị <span class="tf-counter-val">@_cachedFilteredTemplates.Count</span>/@(Templates?.Count ?? 0) mẫu hợp đồng
            </div>
        </div>

        <!-- Category Filter Pills (Light Theme) -->
        <div class="tf-category-bar" role="tablist" aria-label="Bộ lọc danh mục hợp đồng">
            <button type="button"
                    class="tf-cat-pill @(selectedCategory == null ? "active" : "")"
                    @onclick="() => SelectCategory(null)"
                    role="tab"
                    aria-selected="@(selectedCategory == null)">
                <span class="tf-cat-name">Tất cả mẫu</span>
                <span class="tf-cat-count">@(Templates?.Count ?? 0)</span>
            </button>
            @foreach (var catItem in _categoriesWithCount)
            {
                var isCatActive = selectedCategory == catItem.Category;
                <button type="button"
                        class="tf-cat-pill @(isCatActive ? "active" : "")"
                        @onclick="() => SelectCategory(catItem.Category)"
                        role="tab"
                        aria-selected="@isCatActive">
                    <span class="tf-cat-name">@catItem.Category</span>
                    <span class="tf-cat-count">@catItem.Count</span>
                </button>
            }
        </div>
    </div>

    <!-- Gallery Grid of Miniature A4 Documents -->
    <div class="tf-gallery-grid-container">
        @if (!_cachedFilteredTemplates.Any())
        {
            <div class="tf-gallery-empty">
                <div class="tf-empty-icon">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5">
                        <circle cx="11" cy="11" r="8"/>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                </div>
                <div class="tf-empty-title">Không tìm thấy mẫu hợp đồng phù hợp</div>
                <div class="tf-empty-sub">Vui lòng thử từ khóa tìm kiếm khác hoặc chọn lại "Tất cả mẫu".</div>
                <button type="button" class="tf-btn tf-btn-sm tf-btn-secondary mt-3" @onclick="ResetFilters">
                    Đặt lại bộ lọc
                </button>
            </div>
        }
        else
        {
            <div class="tf-gallery-grid" role="list">
                @foreach (var t in _cachedFilteredTemplates)
                {
                    var isSelected = SelectedTemplateCode == t.Code;
                    var isActive = activeCardCode == t.Code;

                    <div class="tf-gallery-card @(isSelected ? "is-selected" : "") @(isActive ? "is-active" : "")"
                         tabindex="0"
                         role="listitem"
                         aria-label="@t.Title"
                         @onkeydown="(e) => OnCardKeyDown(e, t)">

                        <!-- Isolated GPU-Composited Cursor Highlight (Zero cascade to children) -->
                        <div class="tf-card-highlight-overlay" aria-hidden="true">
                            <div class="tf-highlight-spot"></div>
                        </div>

                        <!-- 1. The Miniature Pure White A4 Contract Sheet -->
                        <div class="tf-card-paper-wrapper" @onclick="() => OnCardClicked(t)">
                            <div class="tf-a4-sheet" role="document" aria-label="Bản xem trước A4 của @t.Title">
                                <div class="tf-a4-page-content">
                                    <!-- National Header -->
                                    <div class="tf-a4-national-header">
                                        <div class="tf-a4-nat-name">CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</div>
                                        <div class="tf-a4-nat-motto">Độc lập - Tự do - Hạnh phúc</div>
                                        <div class="tf-a4-nat-line"></div>
                                        <div class="tf-a4-nat-date">@signingLocation, ngày @DateTime.Now.ToString("dd") tháng @DateTime.Now.ToString("MM") năm @DateTime.Now.ToString("yyyy")</div>
                                    </div>

                                    <!-- Document Title & Number -->
                                    <div class="tf-a4-doc-header">
                                        <div class="tf-a4-doc-title">@GetTemplateDocTitle(t.Code)</div>
                                        <div class="tf-a4-doc-num">Số: @GetSampleContractNumber(t.Code)</div>
                                    </div>

                                    <!-- Legal Basis -->
                                    <div class="tf-a4-legal-basis">
                                        @foreach (var basis in GetLegalBasisLines(t.Code))
                                        {
                                            <div class="tf-a4-basis-line">- @basis</div>
                                        }
                                    </div>

                                    <!-- Preamble & Parties -->
                                    <div class="tf-a4-preamble">
                                        Hôm nay, tại văn phòng LACASA, chúng tôi gồm các bên:
                                    </div>
                                    <div class="tf-a4-party-block">
                                        <div class="tf-a4-party-title">BÊN A (BÊN BÁN): CÔNG TY TNHH THIẾT BỊ VỆ SINH LACASA VIỆT NAM</div>
                                        <div class="tf-a4-party-detail">MST: 0316899999 | Địa chỉ: 123 Nguyễn Văn Cừ, P. An Khánh, Q. Ninh Kiều, Cần Thơ</div>
                                    </div>
                                    <div class="tf-a4-party-block">
                                        <div class="tf-a4-party-title">@GetPartyBHeader(t.Code)</div>
                                        <div class="tf-a4-party-detail">@GetPartyBDetail(t.Code)</div>
                                    </div>

                                    <!-- Sample Line Items Table if applicable -->
                                    @if (HasItemsTable(t.Code))
                                    {
                                        <div class="tf-a4-table-wrapper">
                                            <table class="tf-a4-mini-table">
                                                <thead>
                                                    <tr>
                                                        <th>STT</th>
                                                        <th>Tên thiết bị / Hạng mục</th>
                                                        <th>ĐVT</th>
                                                        <th>SL</th>
                                                        <th>Thành tiền (đ)</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var row in GetSampleItems(t.Code))
                                                    {
                                                        <tr>
                                                            <td>@row.Stt</td>
                                                            <td class="text-start">@row.Name</td>
                                                            <td>@row.Unit</td>
                                                            <td>@row.Qty</td>
                                                            <td class="text-end">@row.Total</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }

                                    <!-- Numbered Articles / Clauses -->
                                    <div class="tf-a4-clauses-wrapper">
                                        @foreach (var clause in GetPreviewClauses(t.Code))
                                        {
                                            <div class="tf-a4-clause-item">
                                                <span class="tf-a4-clause-num">@clause.Num: @clause.Title.</span>
                                                <span class="tf-a4-clause-text">@clause.Summary</span>
                                            </div>
                                        }
                                    </div>

                                    <!-- Signatures Block -->
                                    <div class="tf-a4-signatures">
                                        <div class="tf-a4-sig-col">
                                            <div class="tf-a4-sig-label">ĐẠI DIỆN BÊN A</div>
                                            <div class="tf-a4-sig-space"></div>
                                            <div class="tf-a4-sig-name">Nguyễn Văn An</div>
                                        </div>
                                        <div class="tf-a4-sig-col">
                                            <div class="tf-a4-sig-label">@GetPartyBSigLabel(t.Code)</div>
                                            <div class="tf-a4-sig-space"></div>
                                            <div class="tf-a4-sig-name">@GetPartyBSigName(t.Code)</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Selected Corner Badge -->
                            @if (isSelected)
                            {
                                <div class="tf-selected-badge" title="Mẫu đang được chọn">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                                        <polyline points="20 6 9 17 4 12"/>
                                    </svg>
                                </div>
                            }
                        </div>

                        <!-- 2. Responsive Action Area Below A4 Preview (Zero Clipping, Smooth Reveal) -->
                        <div class="tf-card-actions-wrapper">
                            <div class="tf-card-idle-hint" aria-hidden="true">
                                <span class="tf-hint-dot"></span>
                                <span class="tf-hint-text">Xem mẫu &amp; Soạn thảo</span>
                            </div>
                            <div class="tf-card-actions">
                                <button type="button"
                                        id="@($"btn-preview-{t.Code}")"
                                        class="tf-btn-preview"
                                        title="Xem chi tiết toàn văn mẫu A4"
                                        @onclick='() => OpenPreviewModal(t, "btn-preview-" + t.Code)'
                                        @onclick:stopPropagation="true">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                        <circle cx="12" cy="12" r="3"/>
                                    </svg>
                                    <span>Xem mẫu</span>
                                </button>
                                <button type="button"
                                        class="tf-btn-compose"
                                        title="Soạn thảo hợp đồng từ mẫu này"
                                        @onclick="() => HandleSelectTemplate(t)"
                                        @onclick:stopPropagation="true">
                                    <span>@(string.IsNullOrEmpty(ActionButtonText) ? "Soạn hợp đồng" : ActionButtonText)</span>
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                        <line x1="5" y1="12" x2="19" y2="12"/>
                                        <polyline points="12 5 19 12 12 19"/>
                                    </svg>
                                </button>
                            </div>
                        </div>

                        <!-- 2. Clean Caption & Metadata Beneath A4 Preview -->
                        <div class="tf-card-caption" @onclick="() => OnCardClicked(t)">
                            <div class="tf-card-meta-tags">
                                <span class="tf-meta-cat">@t.Category</span>
                                <span class="tf-meta-party">@GetPartyBBadgeText(t.TargetPartyType)</span>
                            </div>
                            <h3 class="tf-card-title" title="@t.Title">@t.Title</h3>
                            <p class="tf-card-desc">@GetCuratedDescription(t)</p>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- 3. Full-Scale A4 Inspection Modal ("Xem mẫu hợp đồng") -->
    @if (inspectTemplate != null)
    {
        <div class="@(IsEmbeddedInModal ? "tf-inspect-embedded-viewer" : "modal fade show d-block tf-inspect-modal-backdrop")"
             tabindex="-1"
             role="dialog"
             aria-modal="true"
             aria-labelledby="tf-inspect-title"
             @onclick="HandleInspectBackdropClick"
             @onkeydown="HandleInspectKeyDown"
             @ref="_inspectBackdropRef">
            <div class="@(IsEmbeddedInModal ? "tf-inspect-embedded-inner" : "modal-dialog modal-dialog-centered modal-xl tf-inspect-modal-dialog")"
                 @onclick:stopPropagation="true">
                <div class="@(IsEmbeddedInModal ? "tf-inspect-embedded-content" : "modal-content tf-inspect-modal-content")"
                     @onclick:stopPropagation="true">
                    <!-- Modal Header -->
                    <div class="modal-header tf-inspect-header">
                        <div class="d-flex align-items-center gap-3 flex-grow-1" style="min-width: 0;">
                            <div class="tf-inspect-icon flex-shrink-0">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                    <polyline points="14 2 14 8 20 8"/>
                                    <line x1="16" y1="13" x2="8" y2="13"/>
                                    <line x1="16" y1="17" x2="8" y2="17"/>
                                </svg>
                            </div>
                            <div style="min-width: 0; flex: 1 1 auto;">
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <h5 id="tf-inspect-title" class="modal-title fw-bold text-dark mb-0">@inspectTemplate.Title</h5>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-0.5 small">@inspectTemplate.Category</span>
                                    <span class="badge bg-secondary-subtle text-secondary border px-2 py-0.5 small">@GetPartyBBadgeText(inspectTemplate.TargetPartyType)</span>
                                </div>
                                <div class="text-muted small mt-1 text-truncate" title="@inspectTemplate.LegalBasis">
                                    Căn cứ pháp lý: @inspectTemplate.LegalBasis
                                </div>
                            </div>
                        </div>
                        <button type="button"
                                class="tf-modal-close-btn flex-shrink-0 ms-3"
                                @onclick="CloseInspectModalAsync"
                                aria-label="Đóng xem trước (Esc)"
                                title="Đóng xem trước (Esc)">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                <line x1="6" y1="6" x2="18" y2="18"></line>
                            </svg>
                        </button>
                    </div>

                    <!-- Document Toolbar (Standard A4, Zoom Controls, Fit Width, Print & PDF, Legal Compliance) -->
                    <div class="tf-inspect-toolbar">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1 small fw-semibold d-inline-flex align-items-center gap-1.5">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                </svg>
                                Khổ A4 (210 × 297 mm)
                            </span>
                            <span class="tf-toolbar-sep d-none d-sm-inline-block"></span>
                            <button type="button"
                                    class="tf-toolbar-btn @(_isFitWidth ? "is-active" : "")"
                                    @onclick="ToggleFitWidth"
                                    title="Vừa chiều ngang">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="4 14 10 14 10 20"></polyline>
                                    <polyline points="20 10 14 10 14 4"></polyline>
                                    <line x1="14" y1="10" x2="21" y2="3"></line>
                                    <line x1="3" y1="21" x2="10" y2="14"></line>
                                </svg>
                                <span>Vừa chiều ngang</span>
                            </button>
                            <span class="tf-toolbar-sep d-none d-sm-inline-block"></span>
                            <button type="button"
                                    class="tf-toolbar-btn @(showCompliancePanel ? "is-active" : "")"
                                    @onclick="ToggleCompliancePanel"
                                    title="Xem đánh giá tuân thủ 8 tiêu chí pháp lý">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                    <polyline points="9 12 11 14 15 10"/>
                                </svg>
                                <span>Tuân thủ: @(inspectCompliance?.PassedCount ?? 8)/8 tiêu chuẩn</span>
                            </button>
                        </div>

                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <!-- Zoom Controls -->
                            <div class="tf-zoom-group">
                                <button type="button"
                                        class="tf-zoom-btn"
                                        @onclick="ZoomOut"
                                        disabled="@(_zoomLevel <= 60)"
                                        title="Thu nhỏ (-10%)">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <line x1="5" y1="12" x2="19" y2="12"></line>
                                    </svg>
                                </button>
                                <span class="tf-zoom-level font-monospace" title="Tỷ lệ thu phóng">@($"{_zoomLevel}%")</span>
                                <button type="button"
                                        class="tf-zoom-btn"
                                        @onclick="ZoomIn"
                                        disabled="@(_zoomLevel >= 150)"
                                        title="Phóng to (+10%)">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <line x1="12" y1="5" x2="12" y2="19"></line>
                                        <line x1="5" y1="12" x2="19" y2="12"></line>
                                    </svg>
                                </button>
                                <button type="button"
                                        class="tf-zoom-btn tf-zoom-reset"
                                        @onclick="ResetZoom"
                                        title="Đặt lại 100%">
                                    100%
                                </button>
                            </div>

                            <span class="tf-toolbar-sep d-none d-sm-inline-block"></span>

                            <!-- Print Document -->
                            <button type="button" class="tf-toolbar-action-btn" @onclick="PrintInspectDocument" title="In trực tiếp tài liệu chuẩn in ấn A4 (Mẹo: Bỏ chọn 'Headers and footers' trong hộp thoại in để tránh chèn URL trình duyệt)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="6 9 6 2 18 2 18 9"></polyline>
                                    <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                                    <rect x="6" y="14" width="12" height="8"></rect>
                                </svg>
                                <span>In tài liệu</span>
                            </button>

                            <!-- Download PDF -->
                            <button type="button" class="tf-toolbar-action-btn" @onclick="DownloadPdf" title="Tải trực tiếp file PDF chính thức về máy (Không có header/footer trình duyệt)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                    <polyline points="7 10 12 15 17 10"></polyline>
                                    <line x1="12" y1="15" x2="12" y2="3"></line>
                                </svg>
                                <span>Tải PDF</span>
                            </button>
                        </div>
                    </div>

                    <!-- Modal Body: High-Resolution Authentic Multi-Page A4 Document -->
                    <div class="modal-body tf-inspect-body">
                        @if (showCompliancePanel && inspectCompliance != null)
                        {
                            <div class="tf-compliance-panel no-print mb-4">
                                <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-success-subtle text-success border border-success px-2.5 py-1 fw-bold fs-7">
                                            ✔ Hợp chuẩn Pháp lý 100% (@inspectCompliance.PassedCount/8 tiêu chí Đạt)
                                        </span>
                                        <span class="small text-muted">BLDS 2015, Luật Thương mại 2005 (Đ301), Luật BVQLNTD 2023 &amp; Luật GDĐT 2023</span>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-link text-muted p-0 text-decoration-none" @onclick="ToggleCompliancePanel">✕ Thu gọn</button>
                                </div>
                                <div class="row g-2">
                                    @foreach (var check in inspectCompliance.Items)
                                    {
                                        <div class="col-md-6">
                                            <div class="p-2.5 border rounded bg-white dark:bg-dark small h-100 shadow-2xs">
                                                <div class="d-flex align-items-center justify-content-between mb-1">
                                                    <span class="fw-bold text-dark">@check.Title</span>
                                                    <span class="badge @(check.Status == LegalCheckItemStatus.Passed ? "bg-success-subtle text-success border border-success-subtle" : "bg-warning-subtle text-warning border border-warning-subtle") px-1.5 py-0.5">
                                                        @(check.Status == LegalCheckItemStatus.Passed ? "Đạt" : "Cảnh báo")
                                                    </span>
                                                </div>
                                                <div class="text-primary small fw-semibold" style="font-size: 0.8rem;">@check.LegalReference</div>
                                                <div class="text-muted smaller mt-0.5" style="line-height: 1.4;">@check.Details</div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <div class="tf-inspect-sheet-wrapper @(_isFitWidth ? "is-fit-width" : "")" style="transform: scale(@((double)_zoomLevel / 100.0)); transform-origin: top center;">
                            <div id="tf-inspect-document-sheet" class="d-flex flex-column align-items-center w-100">
                                
                                <!-- PAGE 1 OF MULTI-PAGE CONTRACT -->
                                <div class="tf-inspect-a4-sheet tf-a4-page tf-a4-page-1" role="document" aria-label="Trang 1 của mẫu hợp đồng" style="font-size: @(inspectTemplate.Code == "B2C_RETAIL" ? "16px" : "14.5px");">
                                    <!-- National Header (Decree 30/2020/ND-CP Standard Block - PAGE 1 ONLY) -->
                                    <div class="tf-doc-national-header text-center mb-4" style="display: flex; flex-direction: column; align-items: center; text-align: center; width: 100%;">
                                        <div class="tf-doc-nat-title fw-bold" style="font-size: 13pt; text-transform: uppercase; letter-spacing: 0.2pt; line-height: 1.25; margin: 0;">CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</div>
                                        <div class="tf-doc-nat-motto fw-bold" style="font-size: 13pt; line-height: 1.25; margin-top: 3pt; margin-bottom: 0;">Độc lập - Tự do - Hạnh phúc</div>
                                        <div class="tf-doc-nat-line" style="width: 140px; height: 1.5px; background-color: #000000; margin: 4pt auto 5pt auto;"></div>
                                        <div class="tf-doc-nat-date fst-italic" style="font-size: 13pt; line-height: 1.25; margin: 0;">@signingLocation, ngày @DateTime.Now.ToString("dd") tháng @DateTime.Now.ToString("MM") năm @DateTime.Now.ToString("yyyy")</div>
                                    </div>

                                    <!-- Document Title & Number (PAGE 1 ONLY) -->
                                    <div class="text-center mb-4">
                                        <div class="fw-bold fs-5 text-uppercase">@GetTemplateDocTitle(inspectTemplate.Code)</div>
                                        <div class="fw-semibold">Số: @GetSampleContractNumber(inspectTemplate.Code)</div>
                                    </div>

                                    <!-- Legal Basis (PAGE 1 ONLY) -->
                                    <div class="mb-3 fst-italic" style="font-size: 13px;">
                                        @foreach (var basis in GetLegalBasisLines(inspectTemplate.Code))
                                        {
                                            <div>- @basis</div>
                                        }
                                    </div>

                                    <div class="mb-3 fst-italic">
