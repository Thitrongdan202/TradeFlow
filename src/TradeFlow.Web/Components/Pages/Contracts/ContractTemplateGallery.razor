@code {
    [Parameter] public List<ContractTemplateDto>? Templates { get; set; }
    [Parameter] public string? SelectedTemplateCode { get; set; }
    [Parameter] public EventCallback<ContractTemplateDto> OnSelect { get; set; }
    [Parameter] public string ActionButtonText { get; set; } = "Soạn hợp đồng";
    [Parameter] public bool IsEmbeddedInModal { get; set; } = false;
    [Parameter] public EventCallback<ContractTemplateDto?> OnInspectChanged { get; set; }

    private string? selectedCategory;
    private string searchQuery = string.Empty;
    private string? activeCardCode;
    private ContractTemplateDto? inspectTemplate;
    private string signingLocation = "TP. Cần Thơ";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var partyA = await ContractService.GetPartyASettingsAsync();
            if (!string.IsNullOrWhiteSpace(partyA?.DefaultSigningLocation))
            {
                signingLocation = partyA.DefaultSigningLocation;
            }
        }
        catch { }
    }

    private List<(string Category, int Count)> _categoriesWithCount = new();
    private List<ContractTemplateDto> _cachedFilteredTemplates = new();
    private List<ContractTemplateDto>? _lastTemplates;

    protected override void OnParametersSet()
    {
        if (Templates != _lastTemplates)
        {
            _lastTemplates = Templates;
            ComputeCategories();
            ComputeFilteredTemplates();
        }
    }

    private void ComputeCategories()
    {
        if (Templates == null || Templates.Count == 0)
        {
            _categoriesWithCount.Clear();
            return;
        }

        _categoriesWithCount = Templates
            .GroupBy(t => t.Category)
            .Select(g => (Category: g.Key, Count: g.Count()))
            .OrderBy(g => g.Category)
            .ToList();
    }

    private void ComputeFilteredTemplates()
    {
        if (Templates == null)
        {
            _cachedFilteredTemplates = new List<ContractTemplateDto>();
            return;
        }

        IEnumerable<ContractTemplateDto> list = Templates;

        if (!string.IsNullOrWhiteSpace(selectedCategory))
        {
            list = list.Where(t => t.Category.Equals(selectedCategory, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var q = searchQuery.Trim().ToLowerInvariant();
            list = list.Where(t =>
                t.Title.ToLowerInvariant().Contains(q) ||
                t.Category.ToLowerInvariant().Contains(q) ||
                t.Description.ToLowerInvariant().Contains(q) ||
                t.TypicalUseCase.ToLowerInvariant().Contains(q) ||
                t.LegalBasis.ToLowerInvariant().Contains(q) ||
                t.Code.ToLowerInvariant().Contains(q)
            );
        }

        _cachedFilteredTemplates = list.OrderBy(t => t.DisplayOrder).ToList();
    }

    private void SelectCategory(string? category)
    {
        if (selectedCategory == category) return;
        selectedCategory = category;
        activeCardCode = null;
        ComputeFilteredTemplates();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? string.Empty;
        activeCardCode = null;
    }

    private void ClearSearch()
    {
        searchQuery = string.Empty;
        activeCardCode = null;
    }

    private void ResetFilters()
    {
        selectedCategory = null;
        searchQuery = string.Empty;
        activeCardCode = null;
    }

    private ElementReference _inspectBackdropRef;
    private bool _wasInspectOpen;
    private string? _lastInspectTriggerId;
    private int _zoomLevel = 100;
    private bool _isFitWidth = false;

    private void ZoomIn() => _zoomLevel = Math.Min(150, _zoomLevel + 10);
    private void ZoomOut() => _zoomLevel = Math.Max(60, _zoomLevel - 10);
    private void ResetZoom()
    {
        _zoomLevel = 100;
        _isFitWidth = false;
    }

    private void ToggleFitWidth()
    {
        _isFitWidth = !_isFitWidth;
        if (_isFitWidth)
        {
            _zoomLevel = 100;
        }
    }

    private async Task PrintInspectDocument()
    {
        try
        {
            await JS.InvokeVoidAsync("tradeflow.printDocument", "tf-inspect-document-sheet", inspectTemplate?.Title ?? "Mau_Hop_Dong");
        }
        catch { }
    }

    private async Task DownloadPdf()
    {
        if (inspectTemplate == null) return;
        try
        {
            var code = inspectTemplate.Code;
            var safeCode = string.Concat(code.Split(System.IO.Path.GetInvalidFileNameChars())).Replace(" ", "_");
            var filename = $"Mau_hop_dong_{safeCode}.pdf";
            await JS.InvokeVoidAsync("tradeflow.downloadPdf", $"/api/contracts/templates/{code}/export-pdf", filename);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ContractTemplateGallery.DownloadPdf] Error: {ex.Message}");
        }
    }

    private bool showCompliancePanel = false;
    private ContractLegalComplianceReportDto? inspectCompliance;

    private void ToggleCompliancePanel()
    {
        showCompliancePanel = !showCompliancePanel;
    }

    private void UpdateInspectCompliance()
    {
        if (inspectTemplate == null)
        {
            inspectCompliance = null;
            return;
        }

        var clausesList = GetFullClauses(inspectTemplate.Code)
            .Select(c => new ContractClauseDto
            {
                ClauseNumber = c.Num,
                Title = c.Title,
                Content = c.Summary
            }).ToList();

        var sampleItems = GetSampleItems(inspectTemplate.Code)
            .Select(it => new ContractItemDto
            {
                ProductName = it.Name,
                Unit = it.Unit,
                Quantity = decimal.TryParse(it.Qty, out var q) ? q : 1,
                LineTotal = 100_000_000m
            }).ToList();

        inspectCompliance = ContractLegalComplianceEvaluator.EvaluateCommercialContract(
            title: GetTemplateDocTitle(inspectTemplate.Code),
            templateCode: inspectTemplate.Code,
            partyBType: inspectTemplate.TargetPartyType ?? (inspectTemplate.Code == "B2C_RETAIL" ? ContractPartyBType.Individual : ContractPartyBType.Company),
            partyAName: "CÔNG TY TNHH THIẾT BỊ VỆ SINH LACASA VIỆT NAM",
            partyATaxCode: "0316899999",
            partyAAddress: "123 Nguyễn Văn Cừ, Cần Thơ",
            partyARepresentative: "Nguyễn Văn An",
            partyAPosition: "Giám đốc",
            partyAAuthority: "Người đại diện theo pháp luật",
            partyBName: inspectTemplate.Code == "B2C_RETAIL" ? "Nguyễn Hoàng Long" : "CÔNG TY CP ĐẦU TƯ XÂY DỰNG MINH ĐỨC",
            partyBTaxCode: inspectTemplate.Code == "B2C_RETAIL" ? "" : "0108998877",
            partyBIdCardNumber: inspectTemplate.Code == "B2C_RETAIL" ? "079085012345" : "",
            partyBAddress: "Biệt thự BT-12, KĐT Nam Cần Thơ",
            partyBRepresentative: inspectTemplate.Code == "B2C_RETAIL" ? "Nguyễn Hoàng Long" : "Trần Minh Đức",
            partyBPosition: inspectTemplate.Code == "B2C_RETAIL" ? "" : "Tổng Giám đốc",
            partyBAuthority: inspectTemplate.Code == "B2C_RETAIL" ? "" : "Người đại diện theo pháp luật",
            totalAmount: 307500000m,
            amountInWords: "Ba trăm lẻ bảy triệu năm trăm nghìn đồng chẵn",
            items: sampleItems,
            clauses: clausesList,
            executionMethod: ContractExecutionMethod.Both
        );
    }

    private async Task OpenPreviewModal(ContractTemplateDto t, string? triggerId = null)
    {
        _lastInspectTriggerId = triggerId;
        inspectTemplate = t;
        _zoomLevel = 100;
        _isFitWidth = false;
        showCompliancePanel = false;
        UpdateInspectCompliance();

        if (OnInspectChanged.HasDelegate)
        {
            await OnInspectChanged.InvokeAsync(inspectTemplate);
        }
        try
        {
            await JS.InvokeVoidAsync("TradeFlowMotion.lockScroll");
        }
        catch { }
    }

    private async Task CloseInspectModalAsync()
    {
        if (inspectTemplate != null)
        {
            inspectTemplate = null;
            _wasInspectOpen = false;
            _zoomLevel = 100;
            _isFitWidth = false;
            if (OnInspectChanged.HasDelegate)
            {
                await OnInspectChanged.InvokeAsync(null);
            }
            try
            {
                await JS.InvokeVoidAsync("TradeFlowMotion.unlockScroll");
            }
            catch { }

            if (!string.IsNullOrEmpty(_lastInspectTriggerId))
            {
                try
                {
                    await JS.InvokeVoidAsync("TradeFlowMotion.restoreFocus", $"#{_lastInspectTriggerId}");
                }
                catch { }
            }
        }
    }

    private async Task HandleInspectBackdropClick()
    {
        await CloseInspectModalAsync();
    }

    private async Task HandleInspectKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await CloseInspectModalAsync();
        }
    }

    private async Task OnCardClicked(ContractTemplateDto t)
    {
        if (activeCardCode == t.Code)
        {
            await OpenPreviewModal(t, $"btn-preview-{t.Code}");
        }
        else
        {
            activeCardCode = t.Code;
        }
    }

    private async Task OnCardKeyDown(KeyboardEventArgs e, ContractTemplateDto t)
    {
        if (e.Key == "Enter" || e.Key == " ")
        {
            await HandleSelectTemplate(t);
        }
        else if (e.Key == "Escape")
        {
            activeCardCode = null;
            await CloseInspectModalAsync();
        }
    }

    private async Task HandleSelectTemplate(ContractTemplateDto t)
    {
        await CloseInspectModalAsync();
        activeCardCode = null;
        if (OnSelect.HasDelegate)
        {
            await OnSelect.InvokeAsync(t);
        }
        else
        {
            Nav.NavigateTo($"/hop-dong/tao-moi/{t.Code}");
        }
    }

