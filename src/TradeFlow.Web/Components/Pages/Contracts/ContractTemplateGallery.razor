@using TradeFlow.Application.Common.Models.Contracts
@using TradeFlow.Domain.Enums
@implements IAsyncDisposable
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="tf-contract-gallery-wrapper" @ref="galleryContainer">
    <!-- Gallery Controls (Light Theme) -->
    <div class="tf-gallery-controls">
        <div class="tf-controls-top">
            <div class="tf-search-box">
                <svg class="tf-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"/>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
                <input type="text"
                       class="tf-search-input"
                       placeholder="Tìm kiếm theo tên mẫu hợp đồng, căn cứ pháp lý, đối tượng..."
                       value="@searchQuery"
                       @oninput="OnSearchInput" />
                @if (!string.IsNullOrEmpty(searchQuery))
                {
                    <button type="button" class="tf-search-clear" @onclick="ClearSearch" title="Xóa tìm kiếm">✕</button>
                }
            </div>
            <div class="tf-gallery-counter">
                Hiển thị <span class="tf-counter-val">@FilteredTemplates.Count()</span>/@(Templates?.Count ?? 0) mẫu hợp đồng
            </div>
        </div>

        <!-- Category Filter Pills (Light Theme) -->
        <div class="tf-category-bar" role="tablist" aria-label="Bộ lọc danh mục hợp đồng">
            <button type="button"
                    class="tf-cat-pill @(selectedCategory == null ? "active" : "")"
                    @onclick="() => SelectCategory(null)"
                    role="tab"
                    aria-selected="@(selectedCategory == null)">
                <span class="tf-cat-name">Tất cả mẫu</span>
                <span class="tf-cat-count">@(Templates?.Count ?? 0)</span>
            </button>
            @foreach (var cat in AvailableCategories)
            {
                var count = Templates?.Count(t => t.Category == cat) ?? 0;
                <button type="button"
                        class="tf-cat-pill @(selectedCategory == cat ? "active" : "")"
                        @onclick="() => SelectCategory(cat)"
                        role="tab"
                        aria-selected="@(selectedCategory == cat)">
                    <span class="tf-cat-name">@cat</span>
                    <span class="tf-cat-count">@count</span>
                </button>
            }
        </div>
    </div>

    <!-- Gallery Grid of Miniature A4 Documents -->
    <div class="tf-gallery-grid-container">
        @if (!FilteredTemplates.Any())
        {
            <div class="tf-gallery-empty">
                <div class="tf-empty-icon">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5">
                        <circle cx="11" cy="11" r="8"/>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                </div>
                <div class="tf-empty-title">Không tìm thấy mẫu hợp đồng phù hợp</div>
                <div class="tf-empty-sub">Vui lòng thử từ khóa tìm kiếm khác hoặc chọn lại "Tất cả mẫu".</div>
                <button type="button" class="btn btn-sm btn-outline-secondary mt-3" @onclick="ResetFilters">
                    Đặt lại bộ lọc
                </button>
            </div>
        }
        else
        {
            <div class="tf-gallery-grid" role="list">
                @foreach (var t in FilteredTemplates)
                {
                    var isSelected = SelectedTemplateCode == t.Code;
                    var isActive = activeCardCode == t.Code;

                    <div class="tf-gallery-card @(isSelected ? "is-selected" : "") @(isActive ? "is-active" : "")"
                         tabindex="0"
                         role="listitem"
                         aria-label="@t.Title"
                         @onkeydown="(e) => OnCardKeyDown(e, t)">

                        <!-- Isolated GPU-Composited Cursor Highlight (Zero cascade to children) -->
                        <div class="tf-card-highlight-overlay" aria-hidden="true">
                            <div class="tf-highlight-spot"></div>
                        </div>

                        <!-- 1. The Miniature Pure White A4 Contract Sheet -->
                        <div class="tf-card-paper-wrapper" @onclick="() => OnCardClicked(t)">
                            <div class="tf-a4-sheet" role="document" aria-label="Bản xem trước A4 của @t.Title">
                                <div class="tf-a4-page-content">
                                    <!-- National Header -->
                                    <div class="tf-a4-national-header">
                                        <div class="tf-a4-nat-name">CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</div>
                                        <div class="tf-a4-nat-motto">Độc lập - Tự do - Hạnh phúc</div>
                                        <div class="tf-a4-nat-line"></div>
                                        <div class="tf-a4-nat-date">TP. Cần Thơ, ngày @DateTime.Now.ToString("dd") tháng @DateTime.Now.ToString("MM") năm @DateTime.Now.ToString("yyyy")</div>
                                    </div>

                                    <!-- Document Title & Number -->
                                    <div class="tf-a4-doc-header">
                                        <div class="tf-a4-doc-title">@GetTemplateDocTitle(t.Code)</div>
                                        <div class="tf-a4-doc-num">Số: @GetSampleContractNumber(t.Code)</div>
                                    </div>

                                    <!-- Legal Basis -->
                                    <div class="tf-a4-legal-basis">
                                        @foreach (var basis in GetLegalBasisLines(t.Code))
                                        {
                                            <div class="tf-a4-basis-line">- @basis</div>
                                        }
                                    </div>

                                    <!-- Preamble & Parties -->
                                    <div class="tf-a4-preamble">
                                        Hôm nay, tại văn phòng LACASA, chúng tôi gồm các bên:
                                    </div>
                                    <div class="tf-a4-party-block">
                                        <div class="tf-a4-party-title">BÊN A (BÊN BÁN): CÔNG TY TNHH THIẾT BỊ VỆ SINH LACASA VIỆT NAM</div>
                                        <div class="tf-a4-party-detail">MST: 0316899999 | Địa chỉ: 123 Nguyễn Văn Cừ, P. An Khánh, Q. Ninh Kiều, Cần Thơ</div>
                                    </div>
                                    <div class="tf-a4-party-block">
                                        <div class="tf-a4-party-title">@GetPartyBHeader(t.Code)</div>
                                        <div class="tf-a4-party-detail">@GetPartyBDetail(t.Code)</div>
                                    </div>

                                    <!-- Sample Line Items Table if applicable -->
                                    @if (HasItemsTable(t.Code))
                                    {
                                        <div class="tf-a4-table-wrapper">
                                            <table class="tf-a4-mini-table">
                                                <thead>
                                                    <tr>
                                                        <th>STT</th>
                                                        <th>Tên thiết bị / Hạng mục</th>
                                                        <th>ĐVT</th>
                                                        <th>SL</th>
                                                        <th>Thành tiền (đ)</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var row in GetSampleItems(t.Code))
                                                    {
                                                        <tr>
                                                            <td>@row.Stt</td>
                                                            <td class="text-start">@row.Name</td>
                                                            <td>@row.Unit</td>
                                                            <td>@row.Qty</td>
                                                            <td class="text-end">@row.Total</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }

                                    <!-- Numbered Articles / Clauses -->
                                    <div class="tf-a4-clauses-wrapper">
                                        @foreach (var clause in GetPreviewClauses(t.Code))
                                        {
                                            <div class="tf-a4-clause-item">
                                                <span class="tf-a4-clause-num">@clause.Num: @clause.Title.</span>
                                                <span class="tf-a4-clause-text">@clause.Summary</span>
                                            </div>
                                        }
                                    </div>

                                    <!-- Signatures Block -->
                                    <div class="tf-a4-signatures">
                                        <div class="tf-a4-sig-col">
                                            <div class="tf-a4-sig-label">ĐẠI DIỆN BÊN A</div>
                                            <div class="tf-a4-sig-space"></div>
                                            <div class="tf-a4-sig-name">Nguyễn Văn An</div>
                                        </div>
                                        <div class="tf-a4-sig-col">
                                            <div class="tf-a4-sig-label">@GetPartyBSigLabel(t.Code)</div>
                                            <div class="tf-a4-sig-space"></div>
                                            <div class="tf-a4-sig-name">@GetPartyBSigName(t.Code)</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Selected Corner Badge -->
                            @if (isSelected)
                            {
                                <div class="tf-selected-badge" title="Mẫu đang được chọn">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                                        <polyline points="20 6 9 17 4 12"/>
                                    </svg>
                                </div>
                            }
                        </div>

                        <!-- 2. Responsive Action Area Below A4 Preview (Zero Clipping, Smooth Reveal) -->
                        <div class="tf-card-actions-wrapper">
                            <div class="tf-card-idle-hint" aria-hidden="true">
                                <span class="tf-hint-dot"></span>
                                <span class="tf-hint-text">Xem mẫu &amp; Soạn thảo</span>
                            </div>
                            <div class="tf-card-actions">
                                <button type="button"
                                        class="tf-btn-preview"
                                        title="Xem chi tiết toàn văn mẫu A4"
                                        @onclick="() => OpenPreviewModal(t)"
                                        @onclick:stopPropagation="true">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                        <circle cx="12" cy="12" r="3"/>
                                    </svg>
                                    <span>Xem mẫu</span>
                                </button>
                                <button type="button"
                                        class="tf-btn-compose"
                                        title="Soạn thảo hợp đồng từ mẫu này"
                                        @onclick="() => HandleSelectTemplate(t)"
                                        @onclick:stopPropagation="true">
                                    <span>@(string.IsNullOrEmpty(ActionButtonText) ? "Soạn hợp đồng" : ActionButtonText)</span>
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                        <line x1="5" y1="12" x2="19" y2="12"/>
                                        <polyline points="12 5 19 12 12 19"/>
                                    </svg>
                                </button>
                            </div>
                        </div>

                        <!-- 2. Clean Caption & Metadata Beneath A4 Preview -->
                        <div class="tf-card-caption" @onclick="() => OnCardClicked(t)">
                            <div class="tf-card-meta-tags">
                                <span class="tf-meta-cat">@t.Category</span>
                                <span class="tf-meta-party">@GetPartyBBadgeText(t.TargetPartyType)</span>
                            </div>
                            <h3 class="tf-card-title" title="@t.Title">@t.Title</h3>
                            <p class="tf-card-desc">@GetCuratedDescription(t)</p>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- 3. Full-Scale A4 Inspection Modal ("Xem mẫu hợp đồng") -->
    @if (inspectTemplate != null)
    {
        <div class="modal fade show d-block tf-inspect-modal-backdrop" tabindex="-1" role="dialog" aria-modal="true">
            <div class="modal-dialog modal-dialog-centered modal-xl tf-inspect-modal-dialog">
                <div class="modal-content tf-inspect-modal-content">
                    <!-- Modal Header -->
                    <div class="modal-header tf-inspect-header">
                        <div class="d-flex align-items-center gap-2">
                            <div class="tf-inspect-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                    <polyline points="14 2 14 8 20 8"/>
                                    <line x1="16" y1="13" x2="8" y2="13"/>
                                    <line x1="16" y1="17" x2="8" y2="17"/>
                                </svg>
                            </div>
                            <div>
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <h5 class="modal-title fw-bold text-dark mb-0">@inspectTemplate.Title</h5>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle small">@inspectTemplate.Category</span>
                                    <span class="badge bg-secondary-subtle text-secondary border small">@GetPartyBBadgeText(inspectTemplate.TargetPartyType)</span>
                                </div>
                                <div class="text-muted small mt-1">@inspectTemplate.LegalBasis</div>
                            </div>
                        </div>
                        <button type="button" class="btn-close" @onclick="CloseInspectModal" aria-label="Đóng"></button>
                    </div>

                    <!-- Modal Body: High-Resolution A4 Document Sheet -->
                    <div class="modal-body tf-inspect-body">
                        <div class="tf-inspect-a4-sheet">
                            <!-- National Header -->
                            <div class="text-center mb-4">
                                <div class="fw-bold" style="font-size: 15px;">CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</div>
                                <div class="fw-bold" style="font-size: 14px;">Độc lập - Tự do - Hạnh phúc</div>
                                <div class="mx-auto my-1" style="width: 140px; height: 1px; background-color: #333;"></div>
                                <div class="fst-italic" style="font-size: 13px;">TP. Cần Thơ, ngày @DateTime.Now.ToString("dd") tháng @DateTime.Now.ToString("MM") năm @DateTime.Now.ToString("yyyy")</div>
                            </div>

                            <!-- Document Title & Number -->
                            <div class="text-center mb-4">
                                <div class="fw-bold fs-5 text-uppercase">@GetTemplateDocTitle(inspectTemplate.Code)</div>
                                <div class="fw-semibold">Số: @GetSampleContractNumber(inspectTemplate.Code)</div>
                            </div>

                            <!-- Legal Basis -->
                            <div class="mb-3 fst-italic" style="font-size: 13.5px;">
                                @foreach (var basis in GetLegalBasisLines(inspectTemplate.Code))
                                {
                                    <div>- @basis</div>
                                }
                            </div>

                            <div class="mb-3 fst-italic">
                                Hôm nay, ngày @DateTime.Now.ToString("dd/MM/yyyy"), tại Showroom Công ty TNHH Thiết bị Vệ sinh LACASA Việt Nam, chúng tôi gồm có:
                            </div>

                            <!-- Party A -->
                            <div class="mb-3 p-3 border rounded bg-light bg-opacity-50">
                                <div class="fw-bold text-uppercase mb-1">BÊN A (BÊN BÁN): CÔNG TY TNHH THIẾT BỊ VỆ SINH LACASA VIỆT NAM</div>
                                <div>Địa chỉ: Số 123 Đường Nguyễn Văn Cừ, Phường An Khánh, Quận Ninh Kiều, TP. Cần Thơ</div>
                                <div>Mã số thuế: 0316899999 | Điện thoại: 0909 123 456 | Email: hopdong@lacasavietnam.vn</div>
                                <div>Người đại diện: <strong>Nguyễn Văn An</strong> - Chức vụ: Giám đốc (Người đại diện theo pháp luật)</div>
                                <div>Tài khoản ngân hàng: 0071000999888 tại Ngân hàng Ngoại thương Việt Nam (Vietcombank) - CN Cần Thơ</div>
                            </div>

                            <!-- Party B -->
                            <div class="mb-3 p-3 border rounded bg-light bg-opacity-50">
                                <div class="fw-bold text-uppercase mb-1">@GetPartyBHeader(inspectTemplate.Code)</div>
                                <div>@GetPartyBDetail(inspectTemplate.Code)</div>
                            </div>

                            <div class="mb-3 fst-italic">
                                Hai bên cùng thống nhất ký kết hợp đồng theo các điều khoản cụ thể sau đây:
                            </div>

                            <!-- Sample Items Table -->
                            @if (HasItemsTable(inspectTemplate.Code))
                            {
                                <table class="table table-bordered table-sm mb-3 text-center" style="font-size: 13.5px;">
                                    <thead class="table-light">
                                        <tr>
                                            <th>STT</th>
                                            <th>Tên thiết bị / Hạng mục quy cách</th>
                                            <th>ĐVT</th>
                                            <th>SL</th>
                                            <th>Thành tiền (VNĐ)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in GetSampleItems(inspectTemplate.Code))
                                        {
                                            <tr>
                                                <td>@row.Stt</td>
                                                <td class="text-start">@row.Name</td>
                                                <td>@row.Unit</td>
                                                <td>@row.Qty</td>
                                                <td class="text-end fw-semibold">@row.Total</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }

                            <!-- Full Clauses -->
                            @foreach (var clause in GetFullClauses(inspectTemplate.Code))
                            {
                                <div class="mb-3">
                                    <div class="fw-bold">@clause.Num: @clause.Title</div>
                                    <div style="text-align: justify;">@clause.Summary</div>
                                </div>
                            }

                            <!-- Signatures Box -->
                            <div class="row mt-5 pt-4 text-center">
                                <div class="col-6">
                                    <div class="fw-bold">ĐẠI DIỆN BÊN A</div>
                                    <div class="fst-italic small mb-2">(Ký, ghi rõ họ tên và đóng dấu)</div>
                                    <div style="height: 70px;"></div>
                                    <div class="fw-bold">Nguyễn Văn An</div>
                                </div>
                                <div class="col-6">
                                    <div class="fw-bold">@GetPartyBSigLabel(inspectTemplate.Code)</div>
                                    <div class="fst-italic small mb-2">(Ký, ghi rõ họ tên)</div>
                                    <div style="height: 70px;"></div>
                                    <div class="fw-bold">@GetPartyBSigName(inspectTemplate.Code)</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Modal Footer -->
                    <div class="modal-footer tf-inspect-footer">
                        <div class="text-muted small me-auto d-none d-md-block">
                            <span>Văn bản mẫu chuẩn A4, phông Times New Roman theo thể thức NĐ 30/2020/NĐ-CP và BLDS 2015.</span>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary px-3" @onclick="CloseInspectModal">Đóng xem trước</button>
                        <button type="button" class="btn btn-sm btn-primary px-4 d-flex align-items-center gap-1" @onclick="() => HandleSelectTemplate(inspectTemplate)">
                            <span>Soạn hợp đồng từ mẫu này</span>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                <line x1="5" y1="12" x2="19" y2="12"/>
                                <polyline points="12 5 19 12 12 19"/>
                            </svg>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public List<ContractTemplateDto>? Templates { get; set; }
    [Parameter] public string? SelectedTemplateCode { get; set; }
    [Parameter] public EventCallback<ContractTemplateDto> OnSelect { get; set; }
    [Parameter] public string ActionButtonText { get; set; } = "Soạn hợp đồng";

    private string? selectedCategory;
    private string searchQuery = string.Empty;
    private string? activeCardCode;
    private ContractTemplateDto? inspectTemplate;

    private IEnumerable<string> AvailableCategories =>
        Templates?.Select(t => t.Category).Distinct().ToList() ?? Enumerable.Empty<string>();

    private IEnumerable<ContractTemplateDto> FilteredTemplates
    {
        get
        {
            if (Templates == null) return Enumerable.Empty<ContractTemplateDto>();

            var list = Templates.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(selectedCategory))
            {
                list = list.Where(t => t.Category.Equals(selectedCategory, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var q = searchQuery.Trim().ToLowerInvariant();
                list = list.Where(t =>
                    t.Title.ToLowerInvariant().Contains(q) ||
                    t.Category.ToLowerInvariant().Contains(q) ||
                    t.Description.ToLowerInvariant().Contains(q) ||
                    t.TypicalUseCase.ToLowerInvariant().Contains(q) ||
                    t.LegalBasis.ToLowerInvariant().Contains(q) ||
                    t.Code.ToLowerInvariant().Contains(q)
                );
            }

            return list.OrderBy(t => t.DisplayOrder);
        }
    }

    private void SelectCategory(string? category)
    {
        selectedCategory = category;
        activeCardCode = null;
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? string.Empty;
        activeCardCode = null;
    }

    private void ClearSearch()
    {
        searchQuery = string.Empty;
        activeCardCode = null;
    }

    private void ResetFilters()
    {
        selectedCategory = null;
        searchQuery = string.Empty;
        activeCardCode = null;
    }

    private void OpenPreviewModal(ContractTemplateDto t)
    {
        inspectTemplate = t;
    }

    private void CloseInspectModal()
    {
        inspectTemplate = null;
    }

    private void OnCardClicked(ContractTemplateDto t)
    {
        if (activeCardCode == t.Code)
        {
            OpenPreviewModal(t);
        }
        else
        {
            activeCardCode = t.Code;
        }
    }

    private async Task OnCardKeyDown(KeyboardEventArgs e, ContractTemplateDto t)
    {
        if (e.Key == "Enter" || e.Key == " ")
        {
            await HandleSelectTemplate(t);
        }
        else if (e.Key == "Escape")
        {
            activeCardCode = null;
            inspectTemplate = null;
        }
    }

    private async Task HandleSelectTemplate(ContractTemplateDto t)
    {
        inspectTemplate = null;
        activeCardCode = null;
        if (OnSelect.HasDelegate)
        {
            await OnSelect.InvokeAsync(t);
        }
        else
        {
            Nav.NavigateTo($"/hop-dong/tao-moi/{t.Code}");
        }
    }

    private string GetPartyBBadgeText(ContractPartyBType? type) => type switch
    {
        ContractPartyBType.Company => "Bên B: Doanh nghiệp",
        ContractPartyBType.Individual => "Bên B: Cá nhân",
        _ => "Bên B: Doanh nghiệp / Cá nhân"
    };

    private string GetCuratedDescription(ContractTemplateDto t) => t.Code switch
    {
        "B2B_SALE" => "Hợp đồng cung cấp thiết bị vệ sinh quy mô lớn cho chủ đầu tư, tổng thầu xây dựng và hệ thống đại lý ủy quyền.",
        "B2C_RETAIL" => "Hợp đồng bán lẻ và hoàn thiện thiết bị vệ sinh phòng tắm cho khách hàng cá nhân, chủ nhà, căn hộ và biệt thự.",
        "SUPPLY_INSTALL" => "Hợp đồng trọn gói từ cung ứng thiết bị đến thi công lắp đặt, đấu nối kỹ thuật, thử áp lực nước và bàn giao hoàn thiện.",
        "PRINCIPLE_AGREEMENT" => "Hợp đồng khung nguyên tắc cung ứng định kỳ theo năm, áp dụng hạn mức công nợ và chiết khấu theo từng đơn đặt hàng (PO).",
