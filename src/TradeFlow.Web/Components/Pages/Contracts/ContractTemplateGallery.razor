    private ElementReference galleryContainer;
    private IJSObjectReference? motionModule;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                motionModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/contract-gallery-motion.js");
                await motionModule.InvokeVoidAsync("initGalleryMotion", galleryContainer);
            }

            if (inspectTemplate != null && !_wasInspectOpen)
            {
                _wasInspectOpen = true;
                try
                {
                    await _inspectBackdropRef.FocusAsync();
                }
                catch { }
            }
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
        catch (Exception) { }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_wasInspectOpen || inspectTemplate != null)
            {
                try
                {
                    await JS.InvokeVoidAsync("TradeFlowMotion.unlockScroll");
                }
                catch { }
            }

            if (motionModule != null)
            {
                await motionModule.InvokeVoidAsync("disposeGalleryMotion", galleryContainer);
                await motionModule.DisposeAsync();
                motionModule = null;
            }
        }
        catch { }
    }
}
