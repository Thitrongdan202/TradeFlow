@page "/hop-dong/tao-moi"
@page "/hop-dong/tao-moi/{TemplateCode}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Permission:Contracts:Create")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using TradeFlow.Application.Common.Helpers
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Application.Common.Models.Contracts
@using TradeFlow.Domain.Entities.MasterData
@using TradeFlow.Domain.Enums
@using TradeFlow.Infrastructure.Persistence
@inject IContractService ContractService
@inject TradeFlowDbContext DbContext
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Soạn thảo Hợp đồng mới — TradeFlow</PageTitle>

<div class="container-fluid p-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <a href="/hop-dong" class="btn btn-sm btn-outline-secondary">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="15 18 9 12 15 6"/>
                    </svg>
                </a>
                <h1 class="h4 mb-0 fw-bold text-dark">Soạn thảo Hợp đồng mới</h1>
            </div>
            <p class="text-muted small mb-0 mt-1">
                Quy trình lập hợp đồng tuân thủ Bộ luật Dân sự 2015, Luật Thương mại 2005 &amp; Luật Giao dịch điện tử 2023.
            </p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick='() => Nav.NavigateTo("/hop-dong")'>Hủy</button>
            <button type="button" class="btn btn-sm btn-secondary" @onclick="SaveDraftAsync" disabled="@isSaving">
                Lưu bản nháp
            </button>
            <button type="button" class="btn btn-sm btn-primary px-3" @onclick="FinalizeAsync" disabled="@isSaving">
                Chốt nội dung &amp; Ký kết
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger py-2 px-3 small mb-3">@errorMessage</div>
    }

    <!-- Stepper Navigation -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-2">
            <div class="d-flex justify-content-between text-center overflow-auto">
                <button type="button" class="btn btn-sm @(currentStep == 1 ? "btn-primary" : "btn-light text-dark") flex-fill mx-1 py-2" @onclick="() => currentStep = 1">
                    <span class="badge bg-white text-primary me-1">1</span> Mẫu hợp đồng
                </button>
                <button type="button" class="btn btn-sm @(currentStep == 2 ? "btn-primary" : "btn-light text-dark") flex-fill mx-1 py-2" @onclick="() => currentStep = 2">
                    <span class="badge bg-white text-primary me-1">2</span> Bên A (Bên bán)
                </button>
                <button type="button" class="btn btn-sm @(currentStep == 3 ? "btn-primary" : "btn-light text-dark") flex-fill mx-1 py-2" @onclick="() => currentStep = 3">
                    <span class="badge bg-white text-primary me-1">3</span> Bên B (Khách hàng)
                </button>
                <button type="button" class="btn btn-sm @(currentStep == 4 ? "btn-primary" : "btn-light text-dark") flex-fill mx-1 py-2" @onclick="() => currentStep = 4">
                    <span class="badge bg-white text-primary me-1">4</span> Hàng hóa &amp; Điều khoản
                </button>
                <button type="button" class="btn btn-sm @(currentStep == 5 ? "btn-primary" : "btn-light text-dark") flex-fill mx-1 py-2" @onclick="() => currentStep = 5">
                    <span class="badge bg-white text-primary me-1">5</span> Xem trước văn bản
                </button>
            </div>
        </div>
    </div>

    <!-- Step Content -->
    <div class="card border-0 shadow-sm p-4">
        @if (currentStep == 1)
        {
            <!-- STEP 1: CHỌN MẪU HỢP ĐỒNG (PORTRAIT CARD GALLERY) -->
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
                <div>
                    <h5 class="fw-bold text-dark mb-0">Bước 1: Chọn Mẫu Hợp đồng Thương mại</h5>
                    <div class="text-muted small">Di chuột lên từng thẻ để xem chi tiết điều khoản, đối tượng và phạm vi áp dụng</div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    @if (!string.IsNullOrEmpty(model.TemplateCode))
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 small">
                            Đã chọn: @model.Title
                        </span>
                    }
                </div>
            </div>

            <div class="p-3 rounded mb-3 bg-light bg-opacity-50 border shadow-sm" style="border-radius: 12px;">
                <ContractTemplateGallery Templates="@availableTemplates"
                                        SelectedTemplateCode="@model.TemplateCode"
                                        OnSelect="ApplyTemplateAndAdvance"
                                        ActionButtonText="Chọn mẫu này" />
            </div>

            <div class="d-flex justify-content-between align-items-center mt-3">
                <div class="small text-muted">
                    @if (!string.IsNullOrEmpty(model.TemplateCode))
                    {
                        <span>Mẫu đang chọn: <strong class="text-primary">@model.Title</strong></span>
                    }
                    else
                    {
                        <span>Vui lòng chọn 1 mẫu hợp đồng để tiếp tục.</span>
                    }
                </div>
                <button type="button" class="btn btn-primary btn-sm px-4" @onclick="() => currentStep = 2" disabled="@string.IsNullOrEmpty(model.TemplateCode)">
                    Tiếp tục: Bên A <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                </button>
            </div>
        }
        else if (currentStep == 2)
        {
            <!-- STEP 2: THÔNG TIN BÊN A -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-dark mb-0">Bước 2: Thông tin Bên A (Đơn vị bán hàng / Cung cấp)</h5>
                <span class="badge bg-info-subtle text-info border">Tự động tải từ Thiết lập Bên A</span>
            </div>
            <div class="row g-3">
                <div class="col-md-8">
                    <label class="form-label small fw-semibold text-secondary">Tên doanh nghiệp Bên A <span class="text-danger">*</span></label>
                    <input type="text" class="form-control form-control-sm" @bind="model.PartyAName" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-secondary">Mã số thuế <span class="text-danger">*</span></label>
                    <input type="text" class="form-control form-control-sm" @bind="model.PartyATaxCode" />
                </div>
                <div class="col-12">
                    <label class="form-label small fw-semibold text-secondary">Địa chỉ trụ sở</label>
                    <input type="text" class="form-control form-control-sm" @bind="model.PartyAAddress" />
                </div>
                <div class="col-md-5">
                    <label class="form-label small fw-semibold text-secondary">Người đại diện ký kết</label>
                    <input type="text" class="form-control form-control-sm" @bind="model.PartyARepresentative" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-secondary">Chức vụ</label>
                    <input type="text" class="form-control form-control-sm" @bind="model.PartyAPosition" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-secondary">Thẩm quyền</label>
                    <input type="text" class="form-control form-control-sm" @bind="model.PartyAAuthority" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-semibold text-secondary">Số điện thoại</label>
                    <input type="text" class="form-control form-control-sm" @bind="model.PartyAPhone" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-semibold text-secondary">Email</label>
                    <input type="email" class="form-control form-control-sm" @bind="model.PartyAEmail" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-semibold text-secondary">Số tài khoản ngân hàng</label>
                    <input type="text" class="form-control form-control-sm" @bind="model.PartyABankAccount" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-semibold text-secondary">Tên ngân hàng &amp; Chi nhánh</label>
                    <input type="text" class="form-control form-control-sm" @bind="model.PartyABankName" />
                </div>
            </div>
            <div class="d-flex justify-content-between mt-4">
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => currentStep = 1">Quay lại</button>
                <button type="button" class="btn btn-primary btn-sm px-4" @onclick="() => currentStep = 3">
                    Tiếp tục: Bên B <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                </button>
            </div>
        }
        else if (currentStep == 3)
        {
            <!-- STEP 3: THÔNG TIN BÊN B -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-dark mb-0">Bước 3: Thông tin Bên B (Khách hàng / Đối tác)</h5>
                <div class="d-flex align-items-center gap-2">
                    <span class="small text-secondary fw-semibold">Chọn nhanh từ danh bạ:</span>
                    <select class="form-select form-select-sm" style="width: 250px;" @onchange="OnQuickPickCustomer">
                        <option value="">-- Chọn khách hàng sẵn có --</option>
                        @foreach (var cust in customersList)
                        {
                            <option value="@cust.Id">@cust.Code - @cust.Name</option>
                        }
                    </select>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-secondary">Loại chủ thể Bên B <span class="text-danger">*</span></label>
                    <select class="form-select form-select-sm" @bind="model.PartyBType">
                        <option value="@ContractPartyBType.Company">Doanh nghiệp / Tổ chức</option>
                        <option value="@ContractPartyBType.Individual">Cá nhân / Hộ gia đình</option>
                    </select>
                </div>
                <div class="col-md-8">
                    <label class="form-label small fw-semibold text-secondary">
                        @(model.PartyBType == ContractPartyBType.Company ? "Tên doanh nghiệp / Đơn vị mua" : "Họ và tên khách hàng") <span class="text-danger">*</span>
                    </label>
                    <input type="text" class="form-control form-control-sm" @bind="model.PartyBName" placeholder="Nhập tên đối tác..." />
                </div>

                @if (model.PartyBType == ContractPartyBType.Company)
                {
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-secondary">Mã số thuế doanh nghiệp <span class="text-danger">*</span></label>
                        <input type="text" class="form-control form-control-sm" @bind="model.PartyBTaxCode" placeholder="Mã số thuế..." />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-secondary">Người đại diện pháp luật</label>
                        <input type="text" class="form-control form-control-sm" @bind="model.PartyBRepresentative" placeholder="Họ và tên người đại diện..." />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-secondary">Chức vụ người đại diện</label>
                        <input type="text" class="form-control form-control-sm" @bind="model.PartyBPosition" placeholder="Giám đốc, Tổng giám đốc..." />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-secondary">Thẩm quyền ký kết</label>
                        <input type="text" class="form-control form-control-sm" @bind="model.PartyBAuthority" placeholder="Theo điều lệ hoặc giấy ủy quyền..." />
                    </div>
                }
                else
                {
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold text-secondary">Số CCCD / Hộ chiếu <span class="text-danger">*</span></label>
                        <input type="text" class="form-control form-control-sm" @bind="model.PartyBIdCardNumber" placeholder="Số căn cước công dân..." />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold text-secondary">Ngày cấp</label>
                        <input type="text" class="form-control form-control-sm" @bind="model.PartyBIdCardDate" placeholder="dd/MM/yyyy" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold text-secondary">Nơi cấp</label>
                        <input type="text" class="form-control form-control-sm" @bind="model.PartyBIdCardPlace" placeholder="Cục CSQLHC về TTXH..." />
                    </div>
                }

                <div class="col-12">
                    <label class="form-label small fw-semibold text-secondary">Địa chỉ trụ sở / Địa chỉ thường trú <span class="text-danger">*</span></label>
                    <input type="text" class="form-control form-control-sm" @bind="model.PartyBAddress" placeholder="Địa chỉ đối tác..." />
                </div>
                <div class="col-12">
                    <label class="form-label small fw-semibold text-secondary">Địa chỉ giao hàng / Công trình lắp đặt</label>
                    <input type="text" class="form-control form-control-sm" @bind="model.PartyBDeliveryAddress" placeholder="Địa chỉ nhận hàng (nếu khác địa chỉ trên)..." />
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-semibold text-secondary">Số điện thoại liên hệ <span class="text-danger">*</span></label>
                    <input type="text" class="form-control form-control-sm" @bind="model.PartyBPhone" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-semibold text-secondary">Email nhận thông báo</label>
                    <input type="email" class="form-control form-control-sm" @bind="model.PartyBEmail" />
                </div>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => currentStep = 2">Quay lại</button>
                <button type="button" class="btn btn-primary btn-sm px-4" @onclick="() => currentStep = 4">
                    Tiếp tục: Hàng hóa &amp; Điều khoản <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                </button>
            </div>
        }
        else if (currentStep == 4)
        {
            <!-- STEP 4: DANH MỤC HÀNG HÓA & ĐIỀU KHOẢN -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-dark mb-0">Bước 4: Danh mục Thiết bị &amp; Điều khoản Thương mại</h5>
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddNewItem">
                    + Thêm thiết bị / hàng hóa
                </button>
            </div>

            <!-- Items Table -->
            <div class="table-responsive border rounded mb-4">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th style="width: 30px;">#</th>
                            <th style="width: 130px;">Mã SP</th>
                            <th>Tên thiết bị &amp; Quy cách</th>
                            <th style="width: 70px;">ĐVT</th>
                            <th style="width: 80px;" class="text-end">SL</th>
                            <th style="width: 120px;" class="text-end">Đơn giá</th>
                            <th style="width: 70px;" class="text-center">VAT%</th>
                            <th style="width: 130px;" class="text-end">Thành tiền</th>
                            <th style="width: 40px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (model.Items.Count == 0)
                        {
                            <tr>
                                <td colspan="9" class="text-center py-4 text-muted small">
                                    Chưa có thiết bị nào trong danh mục hợp đồng. Bấm "+ Thêm thiết bị / hàng hóa" để thêm.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @for (int i = 0; i < model.Items.Count; i++)
                            {
                                var item = model.Items[i];
                                <tr>
                                    <td class="text-muted small">@(i + 1)</td>
                                    <td>
                                        <input type="text" class="form-control form-control-sm" @bind="item.ProductCode" placeholder="Mã..." />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control form-control-sm" @bind="item.ProductName" placeholder="Tên sản phẩm..." />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control form-control-sm text-center" @bind="item.Unit" />
                                    </td>
                                    <td>
                                        <input type="number" class="form-control form-control-sm text-end" @bind="item.Quantity" @bind:after="RecalculateTotals" min="1" />
                                    </td>
                                    <td>
                                        <input type="number" class="form-control form-control-sm text-end" @bind="item.UnitPrice" @bind:after="RecalculateTotals" step="1000" />
                                    </td>
                                    <td>
                                        <input type="number" class="form-control form-control-sm text-center" @bind="item.VatRate" @bind:after="RecalculateTotals" />
                                    </td>
                                    <td class="text-end fw-semibold">
                                        @item.LineTotal.ToString("N0")
                                    </td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-link text-danger p-0" @onclick="() => RemoveItem(item)">
                                            ✕
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Financial Summary Box -->
            <div class="row g-3 mb-4 bg-light p-3 rounded border">
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-secondary">Tiền hàng chưa VAT</label>
                    <div class="fs-6 fw-bold text-dark">@model.SubTotal.ToString("N0") đ</div>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-secondary">Tiền thuế VAT</label>
                    <div class="fs-6 fw-bold text-dark">@model.TaxAmount.ToString("N0") đ</div>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-secondary">Tổng giá trị Hợp đồng</label>
                    <div class="fs-5 fw-bold text-primary">@model.TotalAmount.ToString("N0") đ</div>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-secondary">Số tiền đặt cọc (nếu có)</label>
                    <input type="number" class="form-control form-control-sm" @bind="model.DepositAmount" @bind:after="RecalculateTotals" step="100000" />
                </div>
                <div class="col-12 border-top pt-2">
                    <span class="small fw-semibold text-secondary">Số tiền viết bằng chữ: </span>
                    <span class="small fw-bold text-dark fst-italic">@model.AmountInWords</span>
                </div>
            </div>

            <!-- Clauses and Terms -->
            <h6 class="fw-bold text-dark mb-2">Các Điều khoản Hợp đồng</h6>
            @foreach (var clause in model.Clauses)
            {
                <div class="card mb-2 p-3 bg-white border">
                    <div class="row g-2">
                        <div class="col-md-3">
                            <input type="text" class="form-control form-control-sm fw-bold" @bind="clause.ClauseNumber" placeholder="Điều X" />
                        </div>
                        <div class="col-md-9">
                            <input type="text" class="form-control form-control-sm fw-bold" @bind="clause.Title" placeholder="Tiêu đề điều khoản..." />
                        </div>
                        <div class="col-12">
                            <textarea class="form-control form-control-sm" rows="2" @bind="clause.Content"></textarea>
                        </div>
                    </div>
                </div>
            }

            <div class="d-flex justify-content-between mt-4">
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => currentStep = 3">Quay lại</button>
                <button type="button" class="btn btn-primary btn-sm px-4" @onclick="() => currentStep = 5">
                    Xem trước văn bản <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                </button>
            </div>
        }
        else if (currentStep == 5)
        {
            <!-- STEP 5: XEM TRƯỚC VĂN BẢN (PREVIEW TIMES NEW ROMAN) -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-dark mb-0">Bước 5: Xem trước Văn bản Hợp đồng (Times New Roman)</h5>
                <span class="badge bg-secondary-subtle text-secondary border">Định dạng A4 chuẩn Pháp lý</span>
            </div>

            <div class="p-4 bg-white border shadow-sm mx-auto" style="max-width: 820px; font-family: 'Times New Roman', Times, serif; font-size: 14px; line-height: 1.5; color: #111;">
                <!-- Header -->
                <div class="text-center mb-4">
                    <div class="fw-bold" style="font-size: 15px;">CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</div>
                    <div class="fw-bold" style="font-size: 14px;">Độc lập - Tự do - Hạnh phúc</div>
                    <div class="mx-auto my-1" style="width: 140px; height: 1px; background-color: #333;"></div>
                    <div class="fst-italic" style="font-size: 13px;">@model.ContractPlace, ngày @model.ContractDate.ToString("dd") tháng @model.ContractDate.ToString("MM") năm @model.ContractDate.ToString("yyyy")</div>
                </div>

                <div class="text-center mb-4">
                    <div class="fw-bold fs-5 text-uppercase">@model.Title</div>
                    <div class="fw-semibold">Số: [Sẽ tạo tự động khi lưu]</div>
                </div>

                <div class="mb-3 fst-italic" style="font-size: 13px;">
                    <div>- Căn cứ Bộ luật Dân sự số 91/2015/QH13 được Quốc hội ban hành ngày 24/11/2015;</div>
                    <div>- Căn cứ Luật Thương mại số 36/2005/QH11 được Quốc hội ban hành ngày 14/06/2005;</div>
                    <div>- Căn cứ Luật Giao dịch điện tử số 20/2023/QH15 có hiệu lực thi hành từ ngày 01/07/2024;</div>
                    <div>- Căn cứ vào năng lực và nhu cầu thực tế của hai bên.</div>
                </div>

                <!-- Parties -->
                <div class="mb-3 border p-3">
                    <div class="fw-bold text-uppercase mb-1">BÊN A (BÊN BÁN): @model.PartyAName</div>
                    <div>Địa chỉ: @model.PartyAAddress</div>
                    <div>Mã số thuế: @model.PartyATaxCode | Điện thoại: @model.PartyAPhone</div>
                    <div>Đại diện: @model.PartyARepresentative - Chức vụ: @model.PartyAPosition</div>
                    <div>Tài khoản: @model.PartyABankAccount tại @model.PartyABankName</div>
                </div>

                <div class="mb-3 border p-3">
                    <div class="fw-bold text-uppercase mb-1">BÊN B (BÊN MUA): @model.PartyBName</div>
                    <div>Địa chỉ: @model.PartyBAddress</div>
                    <div>@(model.PartyBType == ContractPartyBType.Company ? $"Mã số thuế: {model.PartyBTaxCode}" : $"Số CCCD: {model.PartyBIdCardNumber}") | Điện thoại: @model.PartyBPhone</div>
                    @if (!string.IsNullOrEmpty(model.PartyBRepresentative))
                    {
                        <div>Đại diện: @model.PartyBRepresentative - Chức vụ: @model.PartyBPosition</div>
                    }
                </div>

                <!-- Items Table -->
                @if (model.Items.Count > 0)
                {
                    <table class="table table-bordered table-sm mb-3 text-center" style="font-size: 13px;">
                        <thead class="table-light">
                            <tr>
                                <th>STT</th>
                                <th>Mã hàng</th>
                                <th>Tên hàng hóa</th>
                                <th>ĐVT</th>
                                <th>SL</th>
                                <th>Đơn giá (đ)</th>
                                <th>Thành tiền (đ)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < model.Items.Count; i++)
                            {
                                var item = model.Items[i];
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td>@item.ProductCode</td>
                                    <td class="text-start">@item.ProductName</td>
                                    <td>@item.Unit</td>
                                    <td class="text-end">@item.Quantity.ToString("N0")</td>
                                    <td class="text-end">@item.UnitPrice.ToString("N0")</td>
                                    <td class="text-end">@item.LineTotal.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                <div class="mb-3 p-2 bg-light border">
                    <div class="fw-bold">Tổng giá trị hợp đồng: @model.TotalAmount.ToString("N0") đ</div>
                    <div class="fst-italic">Bằng chữ: @model.AmountInWords</div>
                </div>

                <!-- Clauses -->
                @foreach (var c in model.Clauses)
                {
                    <div class="mb-2">
                        <div class="fw-bold">@c.ClauseNumber: @c.Title</div>
                        <div style="text-align: justify;">@c.Content</div>
                    </div>
                }

                <!-- Signatures -->
                <div class="row mt-4 pt-3 text-center">
                    <div class="col-6">
                        <div class="fw-bold">ĐẠI DIỆN BÊN A</div>
                        <div class="fst-italic small">(Ký, ghi rõ họ tên và đóng dấu)</div>
                        <div style="height: 70px;"></div>
                        <div class="fw-bold">@model.PartyARepresentative</div>
                    </div>
                    <div class="col-6">
                        <div class="fw-bold">ĐẠI DIỆN BÊN B</div>
                        <div class="fst-italic small">(Ký, ghi rõ họ tên và đóng dấu)</div>
                        <div style="height: 70px;"></div>
                        <div class="fw-bold">@(model.PartyBRepresentative ?? model.PartyBName)</div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => currentStep = 4">Quay lại sửa</button>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="SaveDraftAsync" disabled="@isSaving">
                        Lưu bản nháp (Draft)
                    </button>
                    <button type="button" class="btn btn-primary btn-sm px-4 fw-semibold" @onclick="FinalizeAsync" disabled="@isSaving">
                        Chốt nội dung &amp; Ký kết
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string? TemplateCode { get; set; }

    private int currentStep = 1;
    private bool isSaving = false;
    private string? errorMessage;

    private CreateContractDto model = new();
    private List<ContractTemplateDto> availableTemplates = new();
    private List<Customer> customersList = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadTemplatesAndPartyAAsync();
        await LoadCustomersAsync();

        if (!string.IsNullOrEmpty(TemplateCode))
        {
            var match = availableTemplates.FirstOrDefault(t => string.Equals(t.Code, TemplateCode, StringComparison.OrdinalIgnoreCase));
            if (match != null)
            {
                ApplyTemplate(match);
                currentStep = 2; // Jump to Party A review
            }
        }
    }

    private async Task LoadTemplatesAndPartyAAsync()
    {
        try
        {
            var tList = await ContractService.GetTemplatesAsync();
            availableTemplates = tList.ToList();

            var partyA = await ContractService.GetPartyASettingsAsync();
            model.PartyAName = partyA.CompanyName;
            model.PartyATaxCode = partyA.TaxCode;
            model.PartyAAddress = partyA.RegisteredAddress;
            model.PartyAContactAddress = partyA.ContactAddress;
            model.PartyARepresentative = partyA.RepresentativeName;
            model.PartyAPosition = partyA.RepresentativePosition;
            model.PartyAAuthority = partyA.RepresentativeAuthority;
            model.PartyAPhone = partyA.Phone;
            model.PartyAEmail = partyA.Email;
            model.PartyABankName = partyA.BankName;
            model.PartyABankAccount = partyA.BankAccount;
            model.PartyABankAccountHolder = partyA.BankAccountHolder;
            model.PartyABankBranch = partyA.BankBranch;
            model.PaymentTerms = partyA.DefaultPaymentInstructions;
            model.DeliveryTerms = partyA.DefaultDeliveryTerms;
            model.WarrantyTerms = partyA.DefaultWarrantyTerms;

            if (availableTemplates.Count > 0 && string.IsNullOrEmpty(TemplateCode))
            {
                ApplyTemplate(availableTemplates[0]);
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Lỗi khi nạp dữ liệu: " + ex.Message;
        }
    }

    private async Task LoadCustomersAsync()
    {
        try
        {
            customersList = await DbContext.Customers.Where(c => c.IsActive).OrderBy(c => c.Name).Take(100).ToListAsync();
        }
        catch { }
    }

    private void ApplyTemplate(ContractTemplateDto t)
    {
        model.TemplateCode = t.Code;
        model.Title = t.Title;
        if (t.TargetPartyType.HasValue)
        {
            model.PartyBType = t.TargetPartyType.Value;
        }
        model.Clauses = t.Clauses.Select(c => new ContractClauseDto
        {
            ClauseNumber = c.ClauseNumber,
            Title = c.Title,
            Content = c.Content
        }).ToList();
    }

    private void ApplyTemplateAndAdvance(ContractTemplateDto t)
    {
        ApplyTemplate(t);
        currentStep = 2;
    }

    private void OnQuickPickCustomer(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            var c = customersList.FirstOrDefault(x => x.Id == id);
            if (c != null)
            {
                model.PartnerId = c.Id;
                model.PartyBName = !string.IsNullOrEmpty(c.CompanyName) ? c.CompanyName : c.Name;
                model.PartyBTaxCode = c.TaxCode;
                model.PartyBAddress = c.Address;
                model.PartyBPhone = c.Phone;
                model.PartyBEmail = c.Email;
                model.PartyBRepresentative = c.ContactPerson;
                model.PartyBType = !string.IsNullOrEmpty(c.TaxCode) ? ContractPartyBType.Company : ContractPartyBType.Individual;
            }
        }
    }

    private void AddNewItem()
    {
        model.Items.Add(new ContractItemDto
        {
            ProductCode = "SP-001",
            ProductName = "Bồn cầu thông minh LACASA",
            Unit = "Bộ",
            Quantity = 1,
            UnitPrice = 8500000,
            VatRate = 10,
            LineTotal = 9350000,
            SortOrder = model.Items.Count + 1
        });
        RecalculateTotals();
    }

    private void RemoveItem(ContractItemDto item)
    {
        model.Items.Remove(item);
        RecalculateTotals();
    }

    private void RecalculateTotals()
    {
        decimal subTotal = 0;
        decimal totalTax = 0;

        foreach (var item in model.Items)
        {
            var line = (item.Quantity * item.UnitPrice) - item.DiscountAmount;
            var tax = Math.Round(line * (item.VatRate / 100m), 0);
            item.TaxAmount = tax;
            item.LineTotal = line + tax;

            subTotal += line;
            totalTax += tax;
        }

        model.SubTotal = subTotal;
        model.TaxAmount = totalTax;
        model.TotalAmount = subTotal + totalTax;
        model.RemainingAmount = Math.Max(0, model.TotalAmount - model.DepositAmount);
        model.AmountInWords = VietnameseNumberToWords.ConvertToWords(model.TotalAmount);
    }

    private async Task SaveDraftAsync()
    {
        await SaveContractAsync(false);
    }

    private async Task FinalizeAsync()
    {
        await SaveContractAsync(true);
    }

    private async Task SaveContractAsync(bool finalize)
    {
        if (string.IsNullOrWhiteSpace(model.Title) || string.IsNullOrWhiteSpace(model.PartyBName))
        {
            errorMessage = "Vui lòng nhập Tiêu đề hợp đồng và Thông tin Tên Bên B.";
            return;
        }

        isSaving = true;
        errorMessage = null;

        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            var userId = auth.User.Identity?.Name ?? "admin";
            var userName = auth.User.Identity?.Name ?? "Quản trị viên";

            var created = await ContractService.CreateContractAsync(model, userId, userName);

            if (finalize)
            {
                await ContractService.FinalizeContractAsync(created.Id, userId, userName);
            }

            Nav.NavigateTo($"/hop-dong/{created.Id}");
        }
        catch (Exception ex)
        {
            errorMessage = "Lỗi khi lưu hợp đồng: " + ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }
}
