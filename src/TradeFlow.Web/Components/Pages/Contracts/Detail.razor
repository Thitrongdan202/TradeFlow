@page "/hop-dong/{Id:int}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Permission:Contracts:View")]
@using Microsoft.AspNetCore.Authorization
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Application.Common.Models.Contracts
@using TradeFlow.Domain.Enums
@inject IContractService ContractService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

<PageTitle>@(contract?.ContractNumber ?? "Hợp đồng") — TradeFlow</PageTitle>

<div class="container-fluid p-4">
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <div class="text-muted small mt-2">Đang tải văn bản hợp đồng...</div>
        </div>
    }
    else if (contract == null)
    {
        <div class="alert alert-warning">
            Không tìm thấy thông tin hợp đồng ID: @Id. <a href="/hop-dong" class="alert-link">Quay lại danh sách</a>.
        </div>
    }
    else
    {
        var isSignedContract = contract.IsDigitallySigned;
        var canExportSelectedVersion = selectedVersion == "unsigned" || isSignedContract;

        <!-- Action Toolbar -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 tf-card p-3 rounded shadow-sm border no-print">
            <div class="d-flex align-items-center gap-2">
                <a href="/hop-dong" class="btn btn-sm btn-outline-secondary" title="Quay lại danh sách hợp đồng">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="15 18 9 12 15 6"/>
                    </svg>
                </a>
                <div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="fs-5 fw-bold font-monospace" style="color:var(--tf-text-primary, #0f172a);">@contract.ContractNumber</span>
                        <span class="badge @GetStatusBadgeClass(contract.Status)">@GetStatusVietnamese(contract.Status)</span>
                        @if (contract.ExecutionMethod == ContractExecutionMethod.Electronic || contract.IsDigitallySigned)
                        {
                            <span class="badge bg-primary-subtle text-primary border small">Ký điện tử (Luật GDĐT 2023)</span>
                        }
                        else if (contract.ExecutionMethod == ContractExecutionMethod.PaperPrinted)
                        {
                            <span class="badge bg-secondary-subtle text-secondary border small">Bản in giấy</span>
                        }
                    </div>
                    <div class="text-muted small">@contract.Title</div>
                </div>
            </div>

            <div class="d-flex flex-wrap align-items-center gap-2">
                <!-- Bộ chuyển đổi 2 phiên bản: Bản chưa ký & Bản đã ký số -->
                <div class="btn-group btn-group-sm me-1" role="group" aria-label="Chọn phiên bản hợp đồng">
                    <button type="button"
                            class="btn @(selectedVersion == "unsigned" ? "btn-primary fw-semibold" : "btn-outline-secondary")"
                            @onclick='() => SelectVersion("unsigned")'>
                        Bản chưa ký
                    </button>
                    <button type="button"
                            class="btn @(selectedVersion == "signed" ? "btn-primary fw-semibold" : "btn-outline-secondary")"
                            @onclick='() => SelectVersion("signed")'>
                        Bản đã ký số
                        @if (isSignedContract)
                        {
                            <span class="ms-1 badge bg-success-subtle text-success border-0" style="font-size: 0.65rem;">✓</span>
                        }
                    </button>
                </div>

                <!-- Nút mở Popup Xem trước chuẩn A4 -->
                <button type="button"
                        class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1.5"
                        @onclick="() => showPreviewModal = true"
                        title="Mở cửa sổ Xem trước hợp đồng chuẩn A4">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                    <span>Xem trước A4</span>
                </button>

                <button type="button"
                        class="btn btn-sm btn-primary d-flex align-items-center gap-1.5 shadow-xs"
                        @onclick="DownloadPdfAsync"
                        disabled="@(isDownloading || !canExportSelectedVersion)"
                        title="Tải xuống PDF đúng phiên bản đang chọn">
                    @if (isDownloading)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span>Đang tải...</span>
                    }
                    else
                    {
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                            <polyline points="7 10 12 15 17 10"/>
                            <line x1="12" y1="15" x2="12" y2="3"/>
                        </svg>
                        <span>@(selectedVersion == "unsigned" ? "Tải PDF (Chưa ký)" : "Tải PDF (Đã ký số)")</span>
                    }
                </button>

                <button type="button"
                        class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1.5"
                        @onclick="PrintContractAsync"
                        disabled="@(isPrinting || !canExportSelectedVersion)"
                        title="In trực tiếp ra khổ A4 chuẩn (không dính URL trình duyệt)">
                    @if (isPrinting)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span>Đang in...</span>
                    }
                    else
                    {
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="6 9 6 2 18 2 18 9"></polyline>
                            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                            <rect x="6" y="14" width="12" height="8"></rect>
                        </svg>
                        <span>@(selectedVersion == "unsigned" ? "In Bản chưa ký" : "In Bản đã ký số")</span>
                    }
                </button>

                @if (contract.Status == ContractStatus.Draft)
                {
                    <button type="button" class="btn btn-sm btn-warning d-flex align-items-center gap-1 text-dark" @onclick="FinalizeContractAsync">
                        <span>Chốt nội dung (Chờ ký)</span>
                    </button>
                }

                @if (contract.Status == ContractStatus.Draft || contract.Status == ContractStatus.PendingSignature)
                {
                    <button type="button" class="btn btn-sm btn-success d-flex align-items-center gap-1" @onclick="() => showSignModal = true">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 19l7-7 3 3-7 7-3-3z"/>
                            <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/>
                        </svg>
                        <span>Ký điện tử</span>
                    </button>

                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="RecordPrintedAsync">
                        Ghi nhận in giấy
                    </button>
                }

                @if (contract.Status == ContractStatus.Signed)
                {
                    <button type="button" class="btn btn-sm btn-outline-info" @onclick='() => Nav.NavigateTo($"/hop-dong/tao-moi/CONTRACT_APPENDIX")'>
                        + Tạo Phụ lục
                    </button>

                    <button type="button" class="btn btn-sm btn-outline-success" @onclick="() => showLiquidationModal = true">
                        Biên bản thanh lý
                    </button>
                }
            </div>
        </div>

        <div class="row g-4">
            <!-- Left: Multi-page A4 Document Workspace -->
            <div class="col-12 col-lg-8">
                <div class="p-3 p-md-4 rounded-3 border" style="background: var(--tf-bg-subtle, #e2e8f0);">
                    @if (selectedVersion == "signed" && !isSignedContract)
                    {
                        <div class="card border-0 shadow-sm p-4 text-center mx-auto my-4" style="max-width: 580px; background: var(--tf-bg-card, #ffffff);">
                            <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle"
                                 style="width: 52px; height: 52px; background: rgba(245, 158, 11, 0.14); color: #d97706;">
                                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                    <line x1="12" y1="8" x2="12" y2="12"></line>
                                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                                </svg>
                            </div>
                            <h5 class="fw-bold mb-2" style="color: var(--tf-text-primary, #0f172a);">Hợp đồng này chưa có Bản đã ký số</h5>
                            <p class="text-muted small mb-3">
                                Hợp đồng <strong>@contract.ContractNumber</strong> hiện chưa được ký số / ký điện tử.
                                Hệ thống không tạo chữ ký số giả khi hợp đồng chưa ký.
                                Vui lòng chuyển sang <strong>Bản chưa ký</strong> để xem, in văn bản ký tay hoặc bấm <strong>Ký điện tử</strong>.
                            </p>
                            <div class="d-flex justify-content-center gap-2 flex-wrap">
                                <button type="button" class="btn btn-sm btn-outline-primary fw-semibold" @onclick='() => SelectVersion("unsigned")'>
                                    Xem Bản chưa ký
                                </button>
                                @if (contract.Status == ContractStatus.Draft || contract.Status == ContractStatus.PendingSignature)
                                {
                                    <button type="button" class="btn btn-sm btn-success fw-semibold" @onclick="() => showSignModal = true">
                                        Thực hiện Ký điện tử
                                    </button>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <ContractA4DocumentView Contract="@contract"
                                                IncludeSignatures="@(selectedVersion == "signed")"
                                                ContainerId="tf-contract-sheet" />
                    }
                </div>
            </div>

            <!-- Right: Meta, Legal & Audit Trail -->
            <div class="col-lg-4 no-print">
                <!-- Phiên bản tài liệu Card -->
                <div class="card border-0 shadow-sm p-3 mb-3 tf-card" style="background-color:var(--tf-bg-card, #ffffff); border:1px solid var(--tf-border, #e2e8f0) !important;">
                    <h6 class="fw-bold border-bottom pb-2 mb-3 d-flex align-items-center justify-content-between" style="color:var(--tf-text-primary, #0f172a);">
                        <span>Phiên bản tài liệu A4</span>
                        <span class="badge @(selectedVersion == "unsigned" ? "bg-secondary-subtle text-secondary border" : "bg-success-subtle text-success border")">
                            @(selectedVersion == "unsigned" ? "Bản chưa ký" : "Bản đã ký số")
                        </span>
                    </h6>
                    <div class="small text-muted mb-3">
                        @if (selectedVersion == "unsigned")
                        {
                            <span>Hiển thị văn bản hợp đồng sạch, chưa chèn con dấu ký số, dùng để kiểm tra nội dung trước khi ký hoặc in ra giấy ký tay.</span>
                        }
                        else
                        {
                            <span>Hiển thị văn bản hợp đồng kèm thông tin chữ ký điện tử, người ký, thời điểm ký và mã băm xác thực toàn vẹn SHA-256.</span>
                        }
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-primary w-100 fw-semibold" @onclick="() => showPreviewModal = true">
                        Mở cửa sổ Xem trước &amp; In chuẩn A4
                    </button>
                </div>

                <!-- Integrity & Security Card -->
                <div class="card border-0 shadow-sm p-3 mb-3 tf-card" style="background-color:var(--tf-bg-card, #ffffff); border:1px solid var(--tf-border, #e2e8f0) !important;">
                    <h6 class="fw-bold border-bottom pb-2 mb-3 d-flex align-items-center gap-1" style="color:var(--tf-text-primary, #0f172a);">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                        </svg>
                        Xác thực Toàn vẹn &amp; Pháp lý
                    </h6>
                    <div class="small mb-2">
                        <span class="text-secondary fw-semibold">Mã băm SHA-256 toàn vẹn:</span>
                        <div class="font-monospace text-break p-2 rounded border mt-1" style="font-size: 0.75rem; background-color:var(--tf-bg-subtle, #f8fafc); color:var(--tf-text-primary, #0f172a);">
                            @contract.DocumentHash
                        </div>
                    </div>
                    <div class="small mb-2">
                        <span class="text-secondary fw-semibold">Tuân thủ pháp luật:</span>
                        <div class="text-muted mt-1">
                            Bộ luật Dân sự 2015; Luật Thương mại 2005 (Điều 301, 306); Luật Giao dịch điện tử 20/2023/QH15; Nghị định 23/2025/NĐ-CP.
                        </div>
                    </div>
                    <div class="small">
                        <span class="text-secondary fw-semibold">Phương thức ký kết:</span>
                        <div class="mt-1">
                            @if (contract.ExecutionMethod == ContractExecutionMethod.Electronic)
                            {
                                <span class="badge bg-primary-subtle text-primary border">Ký điện tử nội bộ</span>
                            }
                            else if (contract.ExecutionMethod == ContractExecutionMethod.PaperPrinted)
                            {
                                <span class="badge bg-secondary-subtle text-secondary border">In &amp; Ký văn bản giấy</span>
                            }
                            else if (contract.ExecutionMethod == ContractExecutionMethod.Both)
                            {
                                <span class="badge bg-success-subtle text-success border">Kết hợp Điện tử &amp; Giấy</span>
                            }
                            else
                            {
                                <span class="text-muted">Chưa xác định</span>
                            }
                        </div>
                    </div>
                </div>

                <!-- Audit Log Card -->
                <div class="card border-0 shadow-sm p-3 tf-card" style="background-color:var(--tf-bg-card, #ffffff); border:1px solid var(--tf-border, #e2e8f0) !important;">
                    <h6 class="fw-bold border-bottom pb-2 mb-3 d-flex align-items-center gap-1" style="color:var(--tf-text-primary, #0f172a);">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="12 6 12 12 16 14"/>
                            <circle cx="12" cy="12" r="10"/>
                        </svg>
                        Nhật ký Vết kiểm toán
                    </h6>
                    <ul class="list-unstyled small mb-0">
                        <li class="mb-2 pb-2 border-bottom">
                            <div class="text-secondary fw-semibold">Khởi tạo hợp đồng:</div>
                            <div style="color:var(--tf-text-primary, #0f172a);">Bởi @contract.CreatedByUserName lúc @contract.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                        </li>
                        @if (contract.FinalizedAt.HasValue)
                        {
                            <li class="mb-2 pb-2 border-bottom">
                                <div class="text-secondary fw-semibold">Chốt nội dung:</div>
                                <div style="color:var(--tf-text-primary, #0f172a);">Bởi @contract.FinalizedBy lúc @contract.FinalizedAt.Value.ToString("dd/MM/yyyy HH:mm")</div>
                            </li>
                        }
                        @if (contract.PartyASignedAt.HasValue)
                        {
                            <li class="mb-2 pb-2 border-bottom">
                                <div class="text-secondary fw-semibold">Bên A ký điện tử:</div>
                                <div class="text-success fw-semibold">@contract.PartyASignedBy lúc @contract.PartyASignedAt.Value.ToString("dd/MM/yyyy HH:mm")</div>
                            </li>
                        }
                        @if (contract.PartyBSignedAt.HasValue)
                        {
                            <li class="mb-2 pb-2 border-bottom">
                                <div class="text-secondary fw-semibold">Bên B ký điện tử:</div>
                                <div class="text-success fw-semibold">@contract.PartyBSignedBy lúc @contract.PartyBSignedAt.Value.ToString("dd/MM/yyyy HH:mm")</div>
                            </li>
                        }
                        @if (contract.IsPaperPrinted)
                        {
                            <li class="mb-2 pb-2 border-bottom">
                                <div class="text-secondary fw-semibold">In ấn văn bản giấy:</div>
                                <div style="color:var(--tf-text-primary, #0f172a);">Bởi @contract.PrintedBy lúc @contract.PrintedAt?.ToString("dd/MM/yyyy HH:mm")</div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modals -->
<ContractPreviewModal @bind-IsOpen="showPreviewModal"
                      Contract="@contract"
                      InitialVersion="@selectedVersion"
                      OnRequestSign="() => showSignModal = true" />

<ElectronicSignatureModal @bind-IsOpen="showSignModal"
                          ContractId="@(contract?.Id ?? 0)"
                          ContractNumber="@(contract?.ContractNumber ?? "")"
                          DefaultPartyASigner="@(contract?.PartyARepresentative ?? "")"
                          DefaultPartyBSigner="@(contract?.PartyBRepresentative ?? contract?.PartyBName ?? "")"
                          OnSigned="OnContractChanged" />

<LiquidationModal @bind-IsOpen="showLiquidationModal"
                  ContractId="@(contract?.Id ?? 0)"
                  ContractNumber="@(contract?.ContractNumber ?? "")"
                  OnLiquidated="OnContractChanged" />

@code {
    [Parameter] public int Id { get; set; }

    private ContractDto? contract;
    private string selectedVersion = "unsigned";
    private bool isLoading = true;
    private bool isDownloading = false;
    private bool isPrinting = false;
    private bool showPreviewModal = false;
    private bool showSignModal = false;
    private bool showLiquidationModal = false;

    protected override async Task OnParametersSetAsync()
    {
        await LoadContractAsync();
    }

    private void SelectVersion(string version)
    {
        selectedVersion = version;
    }

    private async Task DownloadPdfAsync()
    {
        if (contract == null || isDownloading) return;
        if (selectedVersion == "signed" && !contract.IsDigitallySigned) return;

        try
        {
            isDownloading = true;
            StateHasChanged();
            var rawNumber = string.IsNullOrWhiteSpace(contract.ContractNumber) ? $"HD-{contract.Id}" : contract.ContractNumber.Trim();
            var safeCode = string.Concat(rawNumber.Split(System.IO.Path.GetInvalidFileNameChars())).Replace(" ", "_");
            var suffix = selectedVersion == "unsigned" ? "_Ban_chua_ky" : "_Ban_da_ky_so";
            var filename = $"Hop_dong_{safeCode}{suffix}.pdf";
            await JS.InvokeVoidAsync("tradeflow.downloadPdf", $"/api/contracts/{contract.Id}/export-pdf?version={selectedVersion}", filename);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Detail.DownloadPdfAsync] Error: {ex.Message}");
        }
        finally
        {
            isDownloading = false;
            StateHasChanged();
        }
    }

    private async Task PrintContractAsync()
    {
        if (contract == null || isPrinting) return;
        if (selectedVersion == "signed" && !contract.IsDigitallySigned) return;

        try
        {
            isPrinting = true;
            StateHasChanged();
            var pdfUrl = $"/api/contracts/{contract.Id}/export-pdf?version={selectedVersion}&inline=true";
            await JS.InvokeVoidAsync("tradeflow.printPdfUrl", pdfUrl);
        }
        catch { }
        finally
        {
            isPrinting = false;
            StateHasChanged();
        }
    }

    private async Task LoadContractAsync()
    {
        isLoading = true;
        try
        {
            contract = await ContractService.GetContractByIdAsync(Id);
            if (contract != null)
            {
                selectedVersion = contract.IsDigitallySigned ? "signed" : "unsigned";
            }
        }
        catch (Exception) { }
        finally
        {
            isLoading = false;
        }
    }

    private async Task FinalizeContractAsync()
    {
        if (contract == null) return;
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var userName = auth.User.Identity?.Name ?? "Quản lý";
        await ContractService.FinalizeContractAsync(contract.Id, "admin", userName);
        await LoadContractAsync();
    }

    private async Task RecordPrintedAsync()
    {
        if (contract == null) return;
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var userName = auth.User.Identity?.Name ?? "Nhân viên";
        await ContractService.RecordPrintedAsync(contract.Id, userName);
        await LoadContractAsync();
    }

    private async Task OnContractChanged()
    {
        await LoadContractAsync();
    }

    private static string GetStatusVietnamese(ContractStatus status) => status switch
    {
        ContractStatus.Draft => "Bản nháp",
        ContractStatus.PendingSignature => "Chờ ký",
        ContractStatus.Signed => "Đã ký",
        ContractStatus.Printed => "Đã in giấy",
        ContractStatus.Liquidated => "Đã thanh lý",
        ContractStatus.Cancelled => "Đã hủy",
        _ => status.ToString()
    };

    private static string GetStatusBadgeClass(ContractStatus status) => status switch
    {
        ContractStatus.Draft => "bg-secondary text-white",
        ContractStatus.PendingSignature => "bg-warning text-dark",
        ContractStatus.Signed => "bg-success text-white",
        ContractStatus.Printed => "bg-info text-dark",
        ContractStatus.Liquidated => "bg-primary text-white",
        ContractStatus.Cancelled => "bg-danger text-white",
        _ => "bg-light text-dark"
    };
}
