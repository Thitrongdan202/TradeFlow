@using TradeFlow.Application.Common.Helpers
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Application.Common.Models.Contracts
@using TradeFlow.Domain.Enums
@inject IEmploymentContractService EmploymentContractService
@inject IJSRuntime JS

@if (isOpen && contract != null)
{
    var isSignedContract = contract.EmployeeSignedAt.HasValue || contract.EmployerSignedAt.HasValue;
    var canExportSelectedVersion = selectedVersion == "unsigned" || isSignedContract;
    var allPages = ContractA4PreviewPaginator.PaginateEmploymentContract(contract);
    int totalPages = allPages.Count;
    int visiblePages = GetVisiblePageCount(totalPages);

    <div class="tf-emp-preview-backdrop tf-modal-overlay no-print" @onclick="CloseAsync">
        <div id="tf-emp-contract-detail-modal"
             class="tf-emp-preview-dialog tf-chrome-dialog"
             @onclick:stopPropagation="true"
             role="dialog"
             aria-modal="true">

            <!-- 1. Header phong cách Chrome Print Preview kèm Workflow Actions -->
            <header class="tf-chrome-header">
                <div class="tf-chrome-header-left">
                    <div class="tf-chrome-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="6 9 6 2 18 2 18 9"></polyline>
                            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                            <rect x="6" y="14" width="12" height="8"></rect>
                        </svg>
                    </div>
                    <div class="tf-chrome-title-wrap">
                        <span class="tf-chrome-main-title">In HĐ lao động</span>
                        <span class="tf-chrome-sep">·</span>
                        <span class="tf-chrome-code font-monospace">@contract.ContractNumber</span>
                        <span class="tf-chrome-docname text-truncate d-none d-md-inline" title="@contract.Title">(@contract.EmployeeFullName)</span>
                        <span class="badge @GetStatusBadgeClass(contract.Status) ms-1">@GetStatusDisplayText(contract.Status)</span>
                        <span class="badge @(empCompliance?.IsFullyCompliant == true ? "bg-success-subtle text-success border border-success" : "bg-warning-subtle text-warning border border-warning") px-2 py-0.5 small fw-semibold ms-1">
                            ✔ @(empCompliance?.ComplianceScore ?? 100)% Hợp chuẩn BLLĐ 2019
                        </span>
                    </div>
                </div>

                <!-- Workflow Actions (Sửa, Ký kết, Gia hạn, Chấm dứt) + Nút đóng -->
                <div class="tf-chrome-header-right d-flex align-items-center gap-2">
                    @if (contract.Status == EmploymentContractStatus.Draft)
                    {
                        <AuthorizeView Policy="Permission:EmploymentContracts:Edit">
                            <button type="button" class="btn btn-outline-primary btn-sm d-flex align-items-center gap-1" @onclick="() => OnEdit.InvokeAsync(contract.Id)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                </svg>
                                <span>Sửa</span>
                            </button>
                        </AuthorizeView>
                    }

                    @if (contract.Status == EmploymentContractStatus.Draft || contract.Status == EmploymentContractStatus.PendingSignature)
                    {
                        <AuthorizeView Policy="Permission:EmploymentContracts:Approve">
                            <button type="button" class="btn btn-success btn-sm d-flex align-items-center gap-1" @onclick="OpenSigningModal">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                    <polyline points="9 12 11 14 15 10"/>
                                </svg>
                                <span>Ký kết</span>
                            </button>
                        </AuthorizeView>
                    }

                    @if (contract.Status == EmploymentContractStatus.Active || contract.Status == EmploymentContractStatus.ExpiringSoon || contract.Status == EmploymentContractStatus.Expired)
                    {
                        <AuthorizeView Policy="Permission:EmploymentContracts:Create">
                            <button type="button" class="btn btn-info btn-sm text-white d-flex align-items-center gap-1" @onclick="OpenRenewModal">
                                <span>Gia hạn</span>
                            </button>
                        </AuthorizeView>
                    }

                    @if (contract.Status == EmploymentContractStatus.Active)
                    {
                        <AuthorizeView Policy="Permission:EmploymentContracts:Delete">
                            <button type="button" class="btn btn-outline-danger btn-sm d-flex align-items-center gap-1" @onclick="OpenTerminateModal">
                                <span>Chấm dứt HĐ</span>
                            </button>
                        </AuthorizeView>
                    }

                    <button type="button" class="tf-chrome-close-btn" @onclick="CloseAsync" title="Đóng cửa sổ in (Esc)">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
            </header>

            <!-- 2. Bố cục hai phần: Cột trái (Thiết lập in) + Cột phải (Vùng xem trước A4) -->
            <div class="tf-chrome-content-split">
                <!-- Cột trái: Bảng điều khiển thiết lập in (Sidebar 280px) -->
                <aside class="tf-chrome-sidebar">
                    <div class="tf-sidebar-section-title">THIẾT LẬP IN</div>

                    <!-- 1. Đích đến -->
                    <div class="tf-setting-group">
                        <label class="tf-setting-label" for="selEmpDestination">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="6 9 6 2 18 2 18 9"></polyline>
                                <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                                <rect x="6" y="14" width="12" height="8"></rect>
                            </svg>
                            <span>Đích đến (Destination)</span>
                        </label>
                        <select id="selEmpDestination" class="form-select form-select-sm" @bind="destination">
                            <option value="printer">Máy in hệ thống</option>
                            <option value="pdf">Lưu dưới dạng PDF</option>
                        </select>
                    </div>

                    <!-- 2. Phiên bản -->
                    <div class="tf-setting-group">
                        <label class="tf-setting-label" for="selEmpVersion">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                <polyline points="14 2 14 8 20 8"></polyline>
                            </svg>
                            <span>Phiên bản (Version)</span>
                        </label>
                        <select id="selEmpVersion" class="form-select form-select-sm" @bind="selectedVersion" @bind:after="OnVersionChanged">
                            <option value="unsigned">Bản chưa ký (Văn bản sạch)</option>
                            <option value="signed">Bản đã ký số @(isSignedContract ? "✔" : "(Chưa ký)")</option>
                        </select>
                        @if (selectedVersion == "signed" && !isSignedContract)
                        {
                            <div class="tf-setting-warn">⚠ HĐ chưa có chữ ký số điện tử</div>
                        }
                    </div>

                    <!-- 3. Khổ giấy -->
                    <div class="tf-setting-group">
                        <label class="tf-setting-label">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                            </svg>
                            <span>Khổ giấy (Paper size)</span>
                        </label>
                        <select class="form-select form-select-sm" disabled>
                            <option selected>A4 (210 × 297 mm)</option>
                        </select>
                        <div class="tf-setting-hint">Tiêu chuẩn BLLĐ 2019 &amp; NĐ 145/2020</div>
                    </div>

                    <!-- 4. Hướng giấy -->
                    <div class="tf-setting-group">
                        <label class="tf-setting-label" for="selEmpOrientation">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="5" y="2" width="14" height="20" rx="2"></rect>
                            </svg>
                            <span>Hướng giấy (Orientation)</span>
                        </label>
                        <select id="selEmpOrientation" class="form-select form-select-sm" @bind="orientationValue" @bind:after="OnOrientationChanged">
                            <option value="portrait">Dọc (Portrait)</option>
                            <option value="landscape">Ngang (Landscape)</option>
                        </select>
                    </div>

                    <!-- 5. Trang in -->
                    <div class="tf-setting-group">
                        <label class="tf-setting-label" for="selEmpPages">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path>
                                <polyline points="13 2 13 9 20 9"></polyline>
                            </svg>
                            <span>Trang in (Pages)</span>
                        </label>
                        <select id="selEmpPages" class="form-select form-select-sm" @bind="pageSelectionMode">
                            <option value="all">Tất cả (@totalPages trang)</option>
                            <option value="custom">Tùy chỉnh</option>
                        </select>

                        @if (pageSelectionMode == "custom")
                        {
                            <div class="mt-1.5">
                                <input type="text"
                                       class="form-control form-control-sm"
                                       placeholder="ví dụ: 1, 1-2"
                                       @bind="customPageRange"
                                       @bind:event="oninput" />
                                <div class="tf-setting-hint">Tổng số: @totalPages trang (VD: 1 hoặc 1-2)</div>
                            </div>
                        }
                    </div>

                    <!-- 6. Lề trang -->
                    <div class="tf-setting-group">
                        <label class="tf-setting-label" for="selEmpMargins">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                                <path d="M9 3v18"></path>
                            </svg>
                            <span>Lề trang (Margins)</span>
                        </label>
                        <select id="selEmpMargins" class="form-select form-select-sm" @bind="marginMode">
                            <option value="default">Mặc định (28mm trái, 20mm lề khác)</option>
                            <option value="minimum">Tối thiểu (15mm đều)</option>
                        </select>
                    </div>

                    <!-- 7. Tỷ lệ -->
                    <div class="tf-setting-group">
                        <label class="tf-setting-label" for="selEmpScale">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="11" cy="11" r="8"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                <line x1="11" y1="8" x2="11" y2="14"></line>
                                <line x1="8" y1="11" x2="14" y2="11"></line>
                            </svg>
                            <span>Tỷ lệ (Scale)</span>
                        </label>
                        <select id="selEmpScale" class="form-select form-select-sm" @bind="scaleMode">
                            <option value="100">100% (Khổ chuẩn A4)</option>
                            <option value="fit">Vừa khung nhìn (Fit width)</option>
                        </select>
                    </div>

                    <!-- 8. Tùy chọn khác -->
                    <div class="tf-setting-group">
                        <label class="tf-setting-label">Tùy chọn (Options)</label>
                        <div class="form-check form-check-sm mb-1.5">
                            <input class="form-check-input" type="checkbox" id="chkEmpShowFooter" @bind="showDocumentFooter" />
                            <label class="form-check-label small" for="chkEmpShowFooter">
                                Chân trang hợp đồng (Mã HĐ &amp; Trang X/Y)
                            </label>
                        </div>
                    </div>

                    <!-- Quick Metadata Badge -->
                    <div class="tf-sidebar-doc-card">
                        <div class="tf-doc-card-title">Thông tin nhân sự</div>
                        <div class="tf-doc-card-row">
                            <span class="text-muted">Nhân viên:</span>
                            <span class="fw-semibold text-truncate" title="@contract.EmployeeFullName">@contract.EmployeeFullName</span>
                        </div>
                        <div class="tf-doc-card-row">
                            <span class="text-muted">Chức danh:</span>
                            <span class="fw-semibold text-truncate" title="@contract.JobTitle">@contract.JobTitle</span>
                        </div>
                        <div class="tf-doc-card-row">
                            <span class="text-muted">Lương cơ bản:</span>
                            <span class="fw-semibold">@((contract.BasicSalary ?? 0).ToString("N0")) VNĐ</span>
                        </div>
                    </div>
                </aside>

                <!-- Cột phải: Vùng hiển thị tài liệu hợp đồng (A4 Preview Stage) -->
                <main id="tf-emp-preview-stage" class="tf-chrome-stage">
                    <div class="tf-stage-page-counter no-print">
                        <span>Trang hiển thị: <strong>@visiblePages</strong> / <strong>@totalPages</strong></span>
                        @if (pageSelectionMode == "custom")
                        {
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-1">Bộ lọc trang</span>
                        }
                    </div>

                    @if (selectedVersion == "signed" && !isSignedContract)
                    {
                        <div class="tf-unsigned-notice-card">
                            <div class="tf-unsigned-notice-icon">
                                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                    <line x1="12" y1="8" x2="12" y2="12"></line>
                                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                                </svg>
                            </div>
                            <h5 class="fw-bold mb-2">Hợp đồng lao động này chưa có Bản đã ký số</h5>
                            <p class="text-muted mb-3" style="max-width: 520px;">
                                Hợp đồng <strong>@contract.ContractNumber</strong> hiện chưa được ký điện tử bởi Người lao động và Người sử dụng lao động.
                                Hệ thống không tạo chữ ký số giả khi hợp đồng chưa ký.
                                Bạn có thể chuyển sang <strong>Bản chưa ký</strong> để xem, in văn bản ký tay hoặc thực hiện ký kết.
                            </p>
                            <div class="d-flex justify-content-center gap-2 flex-wrap">
                                <button type="button" class="btn btn-sm btn-outline-primary fw-semibold" @onclick='() => SwitchVersionAsync("unsigned")'>
                                    Xem Bản chưa ký
                                </button>
                                @if (contract.Status == EmploymentContractStatus.Draft || contract.Status == EmploymentContractStatus.PendingSignature)
                                {
                                    <button type="button" class="btn btn-sm btn-success fw-semibold" @onclick="OpenSigningModal">
                                        Thực hiện Ký kết ngay
                                    </button>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <EmploymentContractA4DocumentView Contract="@contract"
                                                          IncludeSignatures="@(selectedVersion == "signed")"
                                                          ContainerId="print-employment-contract"
                                                          PageRange="@(pageSelectionMode == "custom" ? customPageRange : "all")"
                                                          IsLandscape="@IsLandscape"
                                                          MarginMode="@marginMode"
                                                          ShowDocumentFooter="@showDocumentFooter"
                                                          ScaleMode="@scaleMode" />
                    }
                </main>
            </div>

            <!-- 3. Thanh công cụ Footer chuẩn Google Chrome -->
            <footer class="tf-chrome-footer">
                <div class="tf-chrome-footer-left">
                    <span class="badge bg-secondary-subtle text-secondary border">A4 · @(IsLandscape ? "297 × 210 mm (Ngang)" : "210 × 297 mm (Dọc)")</span>
                    <span class="badge @(selectedVersion == "signed" ? (isSignedContract ? "bg-success-subtle text-success border" : "bg-warning-subtle text-warning-emphasis border") : "bg-info-subtle text-info border")">
                        @(selectedVersion == "signed" ? (isSignedContract ? "Bản đã ký số" : "Chưa ký số") : "Bản chưa ký (Văn bản sạch)")
                    </span>
                    <span class="text-muted small d-none d-md-inline">
                        Hiển thị @visiblePages / @totalPages trang
                    </span>
                </div>

                <div class="tf-chrome-footer-right">
                    <button type="button" class="btn btn-sm btn-light border px-3" @onclick="CloseAsync">
                        Hủy
                    </button>

                    <button type="button"
                            class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1.5"
                            disabled="@(!canExportSelectedVersion || isDownloading)"
                            @onclick="DownloadPdfAsync">
                        @if (isDownloading)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span>Đang tải...</span>
                        }
                        else
                        {
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                                <polyline points="7 10 12 15 17 10"/>
                                <line x1="12" y1="15" x2="12" y2="3"/>
                            </svg>
                            <span>Tải PDF</span>
                        }
                    </button>

                    <button type="button"
                            class="btn btn-sm btn-primary d-flex align-items-center gap-1.5"
                            disabled="@(!canExportSelectedVersion || isPrinting)"
                            @onclick="ExecutePrintOrPdfActionAsync">
                        @if (isPrinting)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span>Đang chuẩn bị...</span>
                        }
                        else
                        {
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="6 9 6 2 18 2 18 9"/>
                                <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/>
                                <rect x="6" y="14" width="12" height="8"/>
                            </svg>
                            <span>@(destination == "pdf" ? "Lưu PDF" : "In tài liệu")</span>
                        }
                    </button>
                </div>
            </footer>
        </div>
    </div>
}

<style>
    .tf-emp-preview-backdrop {
        position: fixed;
        inset: 0;
        z-index: 10050;
        background: rgba(15, 23, 42, 0.68);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
    }

    .tf-emp-preview-dialog {
        width: 95vw;
        max-width: 1240px;
        height: 90vh;
        background: var(--tf-bg-card, #ffffff);
        border: 1px solid var(--tf-border, #cbd5e1);
        border-radius: 12px;
        box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.45);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    /* Dark Mode */
    html[data-bs-theme="dark"] .tf-emp-preview-dialog {
        background: #0f172a;
        border-color: #334155;
    }
</style>

<!-- Nested Modals -->
<EmploymentContractSigningModal @ref="signingModal" OnSigned="HandleSignedAsync" />
<EmploymentContractRenewModal @ref="renewModal" OnRenewed="HandleRenewedAsync" />

@code {
    [Parameter] public EventCallback<int> OnEdit { get; set; }
    [Parameter] public EventCallback OnStatusChanged { get; set; }

    private bool isOpen = false;
    private bool isDownloading = false;
    private bool isPrinting = false;

    // Chrome Print Settings State
    private string destination = "printer";
    private string selectedVersion = "unsigned";
    private string orientationValue = "portrait";
    private bool IsLandscape => orientationValue == "landscape";
    private string pageSelectionMode = "all";
    private string customPageRange = "1";
    private string marginMode = "default";
    private string scaleMode = "100";
    private bool showDocumentFooter = true;

    private EmploymentContractDto? contract;
    private ContractLegalComplianceReportDto? empCompliance;

    private EmploymentContractSigningModal? signingModal;
    private EmploymentContractRenewModal? renewModal;

    public async Task OpenAsync(int contractId)
    {
        try
        {
            contract = await EmploymentContractService.GetContractByIdAsync(contractId, canViewSensitiveData: true);
            if (contract != null)
            {
                empCompliance = ContractLegalComplianceEvaluator.EvaluateEmploymentContract(contract);
                selectedVersion = (contract.EmployeeSignedAt.HasValue || contract.EmployerSignedAt.HasValue) ? "signed" : "unsigned";
                orientationValue = "portrait";
                pageSelectionMode = "all";
                marginMode = "default";
                scaleMode = "100";
                showDocumentFooter = true;
                isOpen = true;
                StateHasChanged();
                try
                {
                    await JS.InvokeVoidAsync("TradeFlowMotion.animateModalEnter", "#tf-emp-contract-detail-modal", ".tf-emp-preview-backdrop");
                }
                catch { }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[EmploymentContractDetailModal.OpenAsync] Error: {ex.Message}");
        }
    }

    public async Task CloseAsync()
    {
        isOpen = false;
        contract = null;
        try
        {
            await JS.InvokeVoidAsync("TradeFlowMotion.unlockScroll", true);
        }
        catch { }
        StateHasChanged();
    }

    private async Task SwitchVersionAsync(string version)
    {
        if (selectedVersion == version) return;
        selectedVersion = version;
        StateHasChanged();
        try
        {
            await JS.InvokeVoidAsync("TradeFlowMotion.animateTabContent", "#tf-emp-preview-stage");
        }
        catch { }
    }

    private void OnVersionChanged()
    {
        StateHasChanged();
    }

    private void OnOrientationChanged()
    {
        StateHasChanged();
    }

    private int GetVisiblePageCount(int totalPages)
    {
        if (pageSelectionMode != "custom" || string.IsNullOrWhiteSpace(customPageRange))
            return totalPages;

        var set = ParsePageRange(customPageRange, totalPages);
        return set != null && set.Count > 0 ? set.Count : totalPages;
    }

    private static HashSet<int>? ParsePageRange(string? range, int totalPages)
    {
        if (string.IsNullOrWhiteSpace(range) || range.Trim().Equals("all", StringComparison.OrdinalIgnoreCase))
            return null;

        var result = new HashSet<int>();
        var parts = range.Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries);
        foreach (var part in parts)
        {
            var trimmed = part.Trim();
            if (trimmed.Contains('-'))
            {
                var bounds = trimmed.Split('-');
                if (bounds.Length == 2 && int.TryParse(bounds[0], out int start) && int.TryParse(bounds[1], out int end))
                {
                    for (int i = Math.Max(1, start); i <= Math.Min(totalPages, end); i++)
                        result.Add(i);
                }
            }
            else if (int.TryParse(trimmed, out int single) && single >= 1 && single <= totalPages)
            {
                result.Add(single);
            }
        }

        return result.Count > 0 ? result : null;
    }

    private async Task ExecutePrintOrPdfActionAsync()
    {
        if (destination == "pdf")
        {
            await DownloadPdfAsync();
        }
        else
        {
            await PrintDocument();
        }
    }

    private async Task DownloadPdfAsync()
    {
        if (contract == null || isDownloading) return;
        var isSigned = contract.EmployeeSignedAt.HasValue || contract.EmployerSignedAt.HasValue;
        if (selectedVersion == "signed" && !isSigned) return;

        isDownloading = true;
        try
        {
            var rawNumber = string.IsNullOrWhiteSpace(contract.ContractNumber) ? $"HDLD-{contract.Id}" : contract.ContractNumber.Trim();
            var safeCode = string.Concat(rawNumber.Split(System.IO.Path.GetInvalidFileNameChars())).Replace(" ", "_");
            var suffix = selectedVersion == "unsigned" ? "_Ban_chua_ky" : "_Ban_da_ky_so";
            var filename = $"Hop_dong_lao_dong_{safeCode}{suffix}.pdf";
            await JS.InvokeVoidAsync("tradeflow.downloadPdf", $"/api/contracts/employment/{contract.Id}/export-pdf?version={selectedVersion}", filename);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[EmploymentContractDetailModal.DownloadPdfAsync] Error: {ex.Message}");
        }
        finally
        {
            isDownloading = false;
            StateHasChanged();
        }
    }

    private async Task PrintDocument()
    {
        if (contract == null || isPrinting) return;
        var isSigned = contract.EmployeeSignedAt.HasValue || contract.EmployerSignedAt.HasValue;
        if (selectedVersion == "signed" && !isSigned) return;

        isPrinting = true;
        try
        {
            if (pageSelectionMode == "custom" || IsLandscape || marginMode != "default")
            {
                await JS.InvokeVoidAsync("tradeflow.printDocument", "print-employment-contract", contract.ContractNumber);
            }
            else
            {
                var pdfUrl = $"/api/contracts/employment/{contract.Id}/export-pdf?version={selectedVersion}&inline=true";
                await JS.InvokeVoidAsync("tradeflow.printPdfUrl", pdfUrl);
            }
        }
        catch { }
        finally
        {
            isPrinting = false;
            StateHasChanged();
        }
    }

    private void OpenSigningModal()
    {
        if (contract == null) return;
        signingModal?.Open(contract.Id, contract.ContractNumber, contract.EmployerRepresentativeName, contract.EmployeeFullName);
    }

    private void OpenRenewModal()
    {
        if (contract == null) return;
        renewModal?.Open(contract);
    }

    private async Task OpenTerminateModal()
    {
        if (contract == null) return;
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Bạn có chắc chắn muốn tiến hành thủ tục chấm dứt hợp đồng lao động này?");
        if (confirmed)
        {
            await EmploymentContractService.TerminateContractAsync(contract.Id, DateTime.UtcNow, "Chấm dứt theo thỏa thuận", "admin", "Admin");
            await OpenAsync(contract.Id);
            await OnStatusChanged.InvokeAsync();
        }
    }

    private async Task HandleSignedAsync()
    {
        if (contract != null)
        {
            await OpenAsync(contract.Id);
            await OnStatusChanged.InvokeAsync();
        }
    }

    private async Task HandleRenewedAsync()
    {
        if (contract != null)
        {
            await OpenAsync(contract.Id);
            await OnStatusChanged.InvokeAsync();
        }
    }

    private static string GetStatusDisplayText(EmploymentContractStatus status) => status switch
    {
        EmploymentContractStatus.Draft => "Bản nháp",
        EmploymentContractStatus.PendingSignature => "Chờ ký kết",
        EmploymentContractStatus.Active => "Đang hiệu lực",
        EmploymentContractStatus.ExpiringSoon => "Sắp hết hạn",
        EmploymentContractStatus.Expired => "Đã hết hạn",
        EmploymentContractStatus.Terminated => "Đã chấm dứt",
        _ => status.ToString()
    };

    private static string GetStatusBadgeClass(EmploymentContractStatus status) => status switch
    {
        EmploymentContractStatus.Draft => "bg-secondary text-white",
        EmploymentContractStatus.PendingSignature => "bg-warning text-dark",
        EmploymentContractStatus.Active => "bg-success text-white",
        EmploymentContractStatus.ExpiringSoon => "bg-warning text-dark",
        EmploymentContractStatus.Expired => "bg-danger text-white",
        EmploymentContractStatus.Terminated => "bg-dark text-white",
        _ => "bg-light text-dark"
    };
}
