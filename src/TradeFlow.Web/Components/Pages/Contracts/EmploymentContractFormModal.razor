    private static readonly string[] WizardSteps = { "info", "remuneration", "clauses", "preview" };

    private int GetCurrentStepIndex() => activeTab switch
    {
        "remuneration" => 1,
        "clauses" => 2,
        "preview" => 3,
        _ => 0
    };

    private async Task GoNextStep()
    {
        var idx = GetCurrentStepIndex();
        if (idx < WizardSteps.Length - 1)
        {
            await SwitchModalTab(WizardSteps[idx + 1]);
        }
    }

    private async Task GoPrevStep()
    {
        var idx = GetCurrentStepIndex();
        if (idx > 0)
        {
            await SwitchModalTab(WizardSteps[idx - 1]);
        }
    }

    private async Task SwitchModalTab(string tab)
    {
        if (activeTab == tab) return;
        errorMessage = string.Empty;
        activeTab = tab;
        StateHasChanged();
        try
        {
            await JS.InvokeVoidAsync("TradeFlowMotion.animateTabContent", $"#emp-tab-{tab}");
        }
        catch { }
    }

