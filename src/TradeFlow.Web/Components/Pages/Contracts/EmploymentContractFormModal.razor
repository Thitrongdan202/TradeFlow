    private void OnContractTypeChanged()
    {
        if (model.ContractType == EmploymentContractType.IndefiniteTerm)
        {
            model.EndDate = null;
            model.Title = "HỢP ĐỒNG LAO ĐỘNG (KHÔNG XÁC ĐỊNH THỜI HẠN)";
        }
        else if (model.ContractType == EmploymentContractType.FixedTerm)
        {
            model.EndDate = model.StartDate.AddYears(1);
            model.Title = "HỢP ĐỒNG LAO ĐỘNG (XÁC ĐỊNH THỜI HẠN)";
        }
        else if (model.ContractType == EmploymentContractType.Probation)
        {
            model.ProbationDurationDays = 60;
            model.ProbationSalaryPercentage = 85m;
            model.EndDate = model.StartDate.AddDays(60);
            model.Title = "HỢP ĐỒNG THỬ VIỆC";
        }
        else if (model.ContractType == EmploymentContractType.Internship)
        {
            model.EndDate = model.StartDate.AddMonths(3);
            model.Title = "THỎA THUẬN THỰC TẬP SINH";
            if (string.IsNullOrWhiteSpace(model.JobTitle))
                model.JobTitle = "Thực tập sinh nghiệp vụ";
        }
        else if (model.ContractType == EmploymentContractType.VocationalTraining)
        {
            model.EndDate = model.StartDate.AddMonths(6);
            model.Title = "HỢP ĐỒNG ĐÀO TẠO NGHỀ (ĐIỀU 61 BLLĐ)";
            if (string.IsNullOrWhiteSpace(model.JobTitle))
                model.JobTitle = "Học viên tập nghề kỹ thuật";
        }

        RegenerateClauses(force: true);
    }

