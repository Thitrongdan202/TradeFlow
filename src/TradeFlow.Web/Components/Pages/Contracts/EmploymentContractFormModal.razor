    private int GetCurrentStepIndex() => activeTab switch
    {
        "remuneration" => 1,
        "clauses" => 2,
        "preview" => 3,
        _ => 0
    };

    private async Task GoNextStep()
    {
        var idx = GetCurrentStepIndex();
        if (idx == 0)
        {
            if (model.EmployeeId <= 0 && employees.Any())
            {
                model.EmployeeId = employees[0].Id;
                OnEmployeeSelected();
            }
            if (string.IsNullOrWhiteSpace(model.JobTitle))
            {
                model.JobTitle = selectedEmployee?.Position?.Name ?? "Chuyên viên nghiệp vụ";
            }
        }

        if (idx < WizardSteps.Length - 1)
        {
            await SwitchModalTab(WizardSteps[idx + 1]);
        }
    }

    private async Task GoPrevStep()
    {
        var idx = GetCurrentStepIndex();
        if (idx > 0)
        {
            await SwitchModalTab(WizardSteps[idx - 1]);
        }
    }

