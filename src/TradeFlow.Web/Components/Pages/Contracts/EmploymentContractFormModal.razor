    {
        if (!force && model.Clauses != null && model.Clauses.Count > 0)
        {
            return;
        }

        var tempDto = new EmploymentContractDto
        {
            ContractType = model.ContractType,
            Title = model.Title,
            ContractDate = model.ContractDate,
            ContractPlace = string.IsNullOrWhiteSpace(model.ContractPlace) ? GetDefaultCity() : model.ContractPlace,
            StartDate = model.StartDate,
            EndDate = model.EndDate,
            ProbationDurationDays = model.ProbationDurationDays,
            ProbationSalaryPercentage = model.ProbationSalaryPercentage,
            JobTitle = string.IsNullOrWhiteSpace(model.JobTitle) ? (selectedEmployee?.Position?.Name ?? "Chuyên viên") : model.JobTitle,
            DepartmentName = string.IsNullOrWhiteSpace(model.DepartmentName) ? (selectedEmployee?.Department?.Name ?? "Khối Nghiệp vụ") : model.DepartmentName,
            Workplace = string.IsNullOrWhiteSpace(model.Workplace) ? (partyASettings?.RegisteredAddress ?? "Showroom & Văn phòng LACASA, Số 123 Đường Nguyễn Văn Cừ, TP. Cần Thơ") : model.Workplace,
            JobDescription = model.JobDescription,
            WorkingHoursPerWeek = model.WorkingHoursPerWeek,
            WorkingSchedule = model.WorkingSchedule,
            AnnualLeaveDays = model.AnnualLeaveDays,
            BasicSalary = model.BasicSalary,
            SalaryClauseText = model.SalaryClauseText,
            SalaryType = model.SalaryType,
            PaymentPeriod = model.PaymentPeriod,
            PaymentMethod = model.PaymentMethod,
            PositionAllowance = model.PositionAllowance,
            LunchAllowance = model.LunchAllowance,
            OtherAllowances = model.OtherAllowances,
            SalaryReviewPolicy = model.SalaryReviewPolicy,
            SocialInsuranceRate = model.SocialInsuranceRate,
            LaborProtection = model.LaborProtection,
            TrainingSupervisor = model.TrainingSupervisor,
            TrainingObjectives = model.TrainingObjectives,
            InternshipProgramme = model.InternshipProgramme,
            HasNonDisclosureAgreement = model.HasNonDisclosureAgreement,
            NdaClauseDetails = model.NdaClauseDetails,
            HasTrainingReimbursement = model.HasTrainingReimbursement,
            TrainingClauseDetails = model.TrainingClauseDetails,
            HasSpecialBenefits = model.HasSpecialBenefits,
            SpecialBenefitsDetails = model.SpecialBenefitsDetails,
            CustomTerms = model.CustomTerms
        };

        model.Clauses = EmploymentContractClauseDefaults.GenerateDefaultClauses(tempDto);
    }

    private void ResetAllClausesToDefault()
    {
        RegenerateClauses(force: true);
    }

    private void AddNewClause()
    {
        model.Clauses ??= new();
        int nextNum = model.Clauses.Count + 1;
        model.Clauses.Add(new EmploymentContractClauseDto
        {
            Id = Guid.NewGuid().ToString("N"),
            ArticleNumber = $"Điều {nextNum}",
            Title = "Thỏa thuận bổ sung đặc thù",
            Content = "Nội dung điều khoản thỏa thuận bổ sung được sự nhất trí của hai bên...",
            IsMandatory = false,
            IsOptional = true,
            DisplayOrder = nextNum
        });
    }

    private void RemoveClause(int index)
    {
        if (model.Clauses != null && index >= 0 && index < model.Clauses.Count)
        {
            var clause = model.Clauses[index];
            if (clause.IsOptional)
            {
                model.Clauses.RemoveAt(index);
                // Renumber display order
                for (int i = 0; i < model.Clauses.Count; i++)
                {
                    model.Clauses[i].DisplayOrder = i + 1;
                }
            }
        }
    }

    private async Task HandleSubmitAsync()
    {
        isSubmitting = true;
        errorMessage = string.Empty;

        try
        {
            // Client validation for draft
            if (model.EmployeeId <= 0)
            {
                errorMessage = "Vui lòng chọn nhân viên từ danh bạ trước khi lưu hợp đồng.";
                activeTab = "info";
                return;
            }

            if (string.IsNullOrWhiteSpace(model.JobTitle))
            {
                errorMessage = $"Vui lòng nhập {GetJobTitleLabel().ToLower()} trước khi lưu.";
                activeTab = "info";
                return;
            }

            if (model.ContractType != EmploymentContractType.IndefiniteTerm && !model.EndDate.HasValue)
            {
                errorMessage = "Loại hợp đồng này yêu cầu phải có ngày kết thúc.";
                activeTab = "info";
                return;
            }

            if (model.EndDate.HasValue && model.EndDate.Value <= model.StartDate)
            {
                errorMessage = "Ngày kết thúc phải lớn hơn ngày bắt đầu hợp đồng.";
                activeTab = "info";
                return;
            }

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userName = authState.User.Identity?.Name ?? "system";
            var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0";

            // Sync edited salary clause text to Clause 3 if specified
            if (!string.IsNullOrWhiteSpace(model.SalaryClauseText) && model.Clauses != null)
            {
                var clause3 = model.Clauses.FirstOrDefault(c => c.ArticleNumber == "Điều 3" || c.Id == "clause_3");
                if (clause3 != null)
                {
                    clause3.Content = model.SalaryClauseText;
                }
            }

            if (IsEditMode)
            {
                var updateDto = new UpdateEmploymentContractDto
                {
                    Id = EditContractId!.Value,
                    EmployeeId = model.EmployeeId,
                    ContractType = model.ContractType,
                    Title = model.Title,
                    ContractDate = model.ContractDate,
                    ContractPlace = model.ContractPlace,
                    StartDate = model.StartDate,
                    EndDate = model.EndDate,
                    ProbationDurationDays = model.ProbationDurationDays,
                    ProbationSalaryPercentage = model.ProbationSalaryPercentage,
                    JobTitle = model.JobTitle,
                    DepartmentName = model.DepartmentName,
                    Workplace = model.Workplace,
                    JobDescription = model.JobDescription,
                    WorkingHoursPerWeek = model.WorkingHoursPerWeek,
                    WorkingSchedule = model.WorkingSchedule,
                    AnnualLeaveDays = model.AnnualLeaveDays,
                    BasicSalary = model.BasicSalary,
                    SalaryClauseText = model.SalaryClauseText,
                    SalaryType = model.SalaryType,
                    PaymentPeriod = model.PaymentPeriod,
                    PaymentMethod = model.PaymentMethod,
                    PositionAllowance = model.PositionAllowance,
                    LunchAllowance = model.LunchAllowance,
                    OtherAllowances = model.OtherAllowances,
                    SalaryReviewPolicy = model.SalaryReviewPolicy,
                    SocialInsuranceRate = model.SocialInsuranceRate,
                    LaborProtection = model.LaborProtection,
                    TrainingSupervisor = model.TrainingSupervisor,
                    TrainingObjectives = model.TrainingObjectives,
                    InternshipProgramme = model.InternshipProgramme,
                    HasNonDisclosureAgreement = model.HasNonDisclosureAgreement,
                    NdaClauseDetails = model.NdaClauseDetails,
                    HasTrainingReimbursement = model.HasTrainingReimbursement,
                    TrainingClauseDetails = model.TrainingClauseDetails,
                    HasSpecialBenefits = model.HasSpecialBenefits,
                    SpecialBenefitsDetails = model.SpecialBenefitsDetails,
                    CustomTerms = model.CustomTerms,
                    Notes = model.Notes,
                    Clauses = model.Clauses ?? new()
                };

                await EmploymentContractService.UpdateContractAsync(updateDto, userId, userName);
            }
            else
            {
                await EmploymentContractService.CreateContractAsync(model, userId, userName);
            }

            _wasOpen = false;
            _isClosing = false;
            IsOpen = false;
            await IsOpenChanged.InvokeAsync(false);
            try
            {
                await JS.InvokeVoidAsync("TradeFlowMotion.unlockScroll", true);
            }
            catch { }
            StateHasChanged();
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private bool _showDiscardConfirm = false;

    private bool IsModalDirty =>
        model.EmployeeId > 0 ||
        !string.IsNullOrWhiteSpace(model.JobTitle) ||
        model.BasicSalary > 0;

    private async Task RequestCloseModal()
    {
        if (isSubmitting) return;

        if (IsModalDirty)
        {
            _showDiscardConfirm = true;
            return;
        }

        await CloseAsync();
    }

    private async Task HandleModalBackdropClick()
    {
        if (isSubmitting) return;

        if (IsModalDirty)
        {
            _showDiscardConfirm = true;
            return;
        }

        await CloseAsync();
    }

    private async Task HandleModalKeyDown(KeyboardEventArgs e)
    {
        if (isSubmitting) return;

        if (e.Key == "Escape")
        {
            if (_showDiscardConfirm)
            {
                _showDiscardConfirm = false;
                return;
            }

            await RequestCloseModal();
        }
    }

    private async Task ConfirmDiscardAsync()
    {
        _showDiscardConfirm = false;
        await CloseAsync();
    }

    private async Task CloseAsync()
    {
        if (_isClosing) return;

        bool reduced = false;
        try
        {
            reduced = await JS.InvokeAsync<bool>("TradeFlowMotion.isReducedMotion");
        }
        catch { }

        if (!reduced)
        {
            _isClosing = true;
            StateHasChanged();
            try
            {
                await JS.InvokeVoidAsync("TradeFlowMotion.animateModalExit", ".modal-dialog", ".modal");
            }
            catch
            {
                await Task.Delay(160);
            }
        }

        _showDiscardConfirm = false;
        _isClosing = false;
        _wasOpen = false;
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
        try
        {
            await JS.InvokeVoidAsync("TradeFlowMotion.unlockScroll", true);
        }
        catch { }
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("TradeFlowMotion.unlockScroll", true);
        }
        catch { }
    }
}
