@using TradeFlow.Application.Common.Helpers
@using Microsoft.EntityFrameworkCore
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Application.Common.Models.Contracts
@using TradeFlow.Domain.Entities.Employees
@using TradeFlow.Domain.Entities.Contracts
@using TradeFlow.Domain.Enums
@using TradeFlow.Infrastructure.Persistence
@using TradeFlow.Web.Components.Shared.Forms

@inject IEmploymentContractService EmploymentContractService
@inject IContractService ContractService
@inject IDbContextFactory<TradeFlowDbContext> DbContextFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (IsOpen)
{
    <div class="modal fade show d-block @(_isClosing ? "is-closing" : "")"
         style="background-color: rgba(15, 23, 42, 0.65); z-index: 1055; backdrop-filter: blur(4px);"
         tabindex="-1"
         role="dialog"
         aria-modal="true"
         @onclick="HandleModalBackdropClick"
         @onkeydown="HandleModalKeyDown">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable @(_isClosing ? "is-closing" : "")" style="max-width: 1100px; max-height: 92vh;" @onclick:stopPropagation="true">
            <div class="modal-content shadow-2xl border-0 rounded-4 overflow-hidden" style="max-height: 92vh; display: flex; flex-direction: column; position: relative;">
                <!-- Modal Header with Segmented Tabs -->
                <div class="modal-header tf-contract-modal-header px-4 pt-3.5 pb-2.5 flex-column align-items-stretch gap-2.5 flex-shrink-0">
                    <div class="d-flex align-items-center justify-content-between w-100">
                        <div class="d-flex align-items-center gap-3">
                            <div class="d-flex align-items-center justify-content-center rounded-3 bg-primary bg-opacity-10 text-primary shadow-2xs border border-primary border-opacity-20" style="width: 44px; height: 44px;">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                                    <circle cx="9" cy="7" r="4"/>
                                    <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
                                    <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                                </svg>
                            </div>
                            <div>
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <h5 class="modal-title fw-bold tf-contract-modal-title mb-0">
                                        @(IsEditMode ? $"Chỉnh sửa Hợp đồng lao động: {ContractNumber}" : "Soạn thảo Hợp đồng lao động mới")
                                    </h5>
                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-0.5 small">
                                        Quy chuẩn 2026
                                    </span>
                                </div>
                                <div class="text-muted smaller mt-0.5">
                                    Bộ luật Lao động (VB hợp nhất 18/VBHN-VPQH) &amp; NĐ 337/2025/NĐ-CP bảo đảm toàn vẹn pháp lý
                                </div>
                            </div>
                        </div>
                        <button type="button"
                                class="tf-modal-close-btn"
                                @onclick="RequestCloseModal"
                                disabled="@isSubmitting"
                                aria-label="Đóng"
                                title="Đóng">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                <line x1="6" y1="6" x2="18" y2="18"></line>
                            </svg>
                        </button>
                    </div>

                    <!-- Professional ERP Stepper Navigation -->
                    <nav class="tf-modal-stepper w-100 mt-1" aria-label="Các bước soạn thảo hợp đồng">
                        <button type="button"
                                class="tf-stepper-item @(activeTab == "info" ? "is-active" : (GetCurrentStepIndex() > 0 ? "is-complete" : "is-pending"))"
                                @onclick='() => SwitchModalTab("info")'>
                            <div class="tf-stepper-indicator">
                                @if (GetCurrentStepIndex() > 0)
                                {
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                }
                                else
                                {
                                    <span>1</span>
                                }
                            </div>
                            <div class="tf-stepper-content">
                                <span class="tf-stepper-step-label">Bước 1</span>
                                <span class="tf-stepper-title">Bên B &amp; Thông tin chung</span>
                            </div>
                        </button>

                        <div class="tf-stepper-divider @(GetCurrentStepIndex() > 0 ? "is-complete" : "")"></div>

                        <button type="button"
                                class="tf-stepper-item @(activeTab == "remuneration" ? "is-active" : (GetCurrentStepIndex() > 1 ? "is-complete" : "is-pending"))"
                                @onclick='() => SwitchModalTab("remuneration")'>
                            <div class="tf-stepper-indicator">
                                @if (GetCurrentStepIndex() > 1)
                                {
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                }
                                else
                                {
                                    <span>2</span>
                                }
                            </div>
                            <div class="tf-stepper-content">
                                <span class="tf-stepper-step-label">Bước 2</span>
                                <span class="tf-stepper-title">Tiền lương &amp; Chế độ</span>
                            </div>
                        </button>

                        <div class="tf-stepper-divider @(GetCurrentStepIndex() > 1 ? "is-complete" : "")"></div>

                        <button type="button"
                                class="tf-stepper-item @(activeTab == "clauses" ? "is-active" : (GetCurrentStepIndex() > 2 ? "is-complete" : "is-pending"))"
                                @onclick='() => SwitchModalTab("clauses")'>
                            <div class="tf-stepper-indicator">
                                @if (GetCurrentStepIndex() > 2)
                                {
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                }
                                else
                                {
                                    <span>3</span>
                                }
                            </div>
                            <div class="tf-stepper-content">
                                <span class="tf-stepper-step-label">Bước 3</span>
                                <span class="tf-stepper-title">Điều khoản (@(model.Clauses?.Count ?? 0))</span>
                            </div>
                        </button>

                        <div class="tf-stepper-divider @(GetCurrentStepIndex() > 2 ? "is-complete" : "")"></div>

                        <button type="button"
                                class="tf-stepper-item @(activeTab == "preview" ? "is-active" : "is-pending")"
                                @onclick='() => SwitchModalTab("preview")'>
                            <div class="tf-stepper-indicator">
                                <span>4</span>
                            </div>
                            <div class="tf-stepper-content">
                                <span class="tf-stepper-step-label">Bước 4</span>
                                <span class="tf-stepper-title">Xem trước văn bản A4</span>
                            </div>
                        </button>
                    </nav>
                </div>

                <!-- Modal Body -->
                <div class="modal-body tf-contract-modal-body p-4" style="overflow-y: auto; flex: 1 1 auto; min-height: 0; overscroll-behavior: contain;">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger py-2.5 px-3 small mb-3 d-flex align-items-center gap-2 rounded-3 shadow-2xs border border-danger border-opacity-25">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-danger flex-shrink-0">
                                <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                            </svg>
                            <span class="fw-medium">@errorMessage</span>
                        </div>
                    }

                    <div id="emp-modal-tab-content">
                        <!-- TAB 1: THÔNG TIN CHUNG & NHÂN SỰ -->
                        <div id="emp-tab-info" class="tf-contract-tab-pane @(activeTab == "info" ? "is-active" : "")" style="display: @(activeTab == "info" ? "block" : "none");">
                            <!-- Section 1: Bên B - Nhân viên -->
                            <div class="tf-form-section">
                                <div class="tf-form-section-header">
                                    <h6 class="tf-form-section-title">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                            <circle cx="12" cy="7" r="4"/>
                                        </svg>
                                        <span>1. Người lao động (Bên B)</span>
                                    </h6>
                                    <span class="badge bg-slate-100 text-secondary border small px-2 py-1">Hồ sơ nhân sự LACASA</span>
                                </div>
                                <div class="row g-3">
                                    <div class="col-12 col-md-6">
                                        <label class="form-label small fw-semibold text-slate-700 mb-1">
                                            Chọn nhân sự tiếp nhận <span class="text-danger">*</span>
                                        </label>
                                        @if (IsEditMode)
                                        {
                                            <input type="text" class="tf-custom-input w-100" value="@selectedEmployeeDisplay" readonly />
                                        }
                                        else
                                        {
                                            <select class="tf-custom-select w-100" @bind="model.EmployeeId" @bind:after="OnEmployeeSelected">
                                                <option value="0">-- Chọn nhân viên từ danh bạ nhân sự --</option>
                                                @foreach (var emp in employees)
                                                {
                                                    <option value="@emp.Id">@emp.Code — @emp.FullName (@(emp.Department?.Name ?? "Chưa phân phòng"))</option>
                                                }
                                            </select>
                                        }
                                    </div>
                                    <div class="col-12 col-md-3">
                                        <label class="form-label small fw-semibold text-slate-700 mb-1">Số CCCD / Định danh</label>
                                        <input type="text" class="tf-custom-input w-100" value="@selectedEmployee?.NationalId" readonly placeholder="Tự động nạp từ hồ sơ" />
                                    </div>
                                    <div class="col-12 col-md-3">
                                        <label class="form-label small fw-semibold text-slate-700 mb-1">Ngày sinh</label>
                                        <input type="text" class="tf-custom-input w-100" value="@(selectedEmployee?.DateOfBirth?.ToString("dd/MM/yyyy") ?? "")" readonly placeholder="dd/MM/yyyy" />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label small fw-semibold text-slate-700 mb-1">Địa chỉ thường trú / Chỗ ở hiện nay</label>
                                        <input type="text" class="tf-custom-input w-100" value="@selectedEmployee?.Address" readonly placeholder="Tự động nạp từ hồ sơ nhân sự" />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label small fw-semibold text-slate-700 mb-1">Tài khoản ngân hàng nhận lương</label>
                                        <input type="text" class="tf-custom-input w-100" value="@selectedEmployee?.BankInformation" readonly placeholder="Số TK, Ngân hàng, Chi nhánh..." />
                                    </div>
                                </div>
                            </div>

                            <!-- Section 2: Loại hợp đồng & Thời hạn -->
                            <div class="tf-form-section">
                                <div class="tf-form-section-header">
                                    <h6 class="tf-form-section-title">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                                            <line x1="16" y1="2" x2="16" y2="6"/>
                                            <line x1="8" y1="2" x2="8" y2="6"/>
                                            <line x1="3" y1="10" x2="21" y2="10"/>
                                        </svg>
                                        <span>2. Loại hợp đồng &amp; Thời hạn (Bộ luật Lao động)</span>
                                    </h6>
                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 small px-2 py-1">Điều 20 &amp; 21 BLLĐ</span>
                                </div>
                                <div class="row g-3">
                                    <div class="col-12 col-md-5">
                                        <label class="form-label small fw-semibold text-slate-700 mb-1">Loại hợp đồng / văn bản <span class="text-danger">*</span></label>
                                        <select class="tf-custom-select w-100" @bind="model.ContractType" @bind:after="OnContractTypeChanged">
                                            <option value="@EmploymentContractType.FixedTerm">Hợp đồng xác định thời hạn (&le; 36 tháng)</option>
                                            <option value="@EmploymentContractType.IndefiniteTerm">Hợp đồng không xác định thời hạn</option>
                                            <option value="@EmploymentContractType.Probation">Hợp đồng thử việc riêng biệt (&le; 180 ngày)</option>
                                            <option value="@EmploymentContractType.Internship">Thỏa thuận thực tập sinh</option>
                                            <option value="@EmploymentContractType.VocationalTraining">Hợp đồng đào tạo nghề (Điều 61 BLLĐ)</option>
                                        </select>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label class="form-label small fw-semibold text-slate-700 mb-1">Tiêu đề văn bản <span class="text-danger">*</span></label>
                                        <input type="text" class="tf-custom-input w-100" @bind="model.Title" />
                                    </div>
                                    <div class="col-12 col-md-3">
                                        <label class="form-label small fw-semibold text-slate-700 mb-1">Địa điểm lập văn bản</label>
                                        <input type="text" class="tf-custom-input w-100" @bind="model.ContractPlace" placeholder="TP. Cần Thơ, Hà Nội..." />
                                    </div>

                                    <div class="col-12 col-md-3">
                                        <label class="form-label small fw-semibold text-slate-700 mb-1">Ngày lập hợp đồng</label>
                                        <TfDateInput @bind-Value="ContractDateWrapper" />
                                    </div>
                                    <div class="col-12 col-md-3">
                                        <label class="form-label small fw-semibold text-slate-700 mb-1">Ngày bắt đầu hiệu lực <span class="text-danger">*</span></label>
                                        <TfDateInput @bind-Value="StartDateWrapper" />
                                    </div>
                                    <div class="col-12 col-md-3">
                                        <label class="form-label small fw-semibold text-slate-700 mb-1">
                                            Ngày kết thúc
                                            @if (model.ContractType != EmploymentContractType.IndefiniteTerm)
                                            {
                                                <span class="text-danger">*</span>
                                            }
                                        </label>
                                        <TfDateInput @bind-Value="model.EndDate" Disabled="@(model.ContractType == EmploymentContractType.IndefiniteTerm)" />
                                    </div>

                                    @if (model.ContractType == EmploymentContractType.Probation)
                                    {
                                        <div class="col-12 col-md-3">
                                            <label class="form-label small fw-semibold text-slate-700 mb-1">Thời gian thử việc (ngày)</label>
                                            <input type="number" class="tf-custom-input w-100" @bind="model.ProbationDurationDays" placeholder="60 hoặc 180" />
                                            <div class="form-text smaller text-muted">Điều 25: Tối đa 180 ngày (quản lý), 60 ngày (CĐ/ĐH).</div>
                                        </div>
                                        <div class="col-12 col-md-3">
                                            <label class="form-label small fw-semibold text-slate-700 mb-1">Tỷ lệ lương thử việc (%)</label>
                                            <input type="number" class="tf-custom-input w-100" @bind="model.ProbationSalaryPercentage" min="85" max="100" />
                                            <div class="form-text smaller text-muted">Điều 26: Tối thiểu 85% lương chính.</div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Section 3: Vị trí, Địa điểm & Chương trình đào tạo/thực tập -->
                            <div class="tf-form-section">
                                <div class="tf-form-section-header">
                                    <h6 class="tf-form-section-title">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
                                            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
                                        </svg>
                                        <span>3. Chức danh, Vị trí &amp; Địa điểm làm việc</span>
                                    </h6>
                                </div>
                                <div class="row g-3">
                                    <div class="col-12 col-md-6">
                                        <label class="form-label small fw-semibold text-slate-700 mb-1">
                                            @GetJobTitleLabel() <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" class="tf-custom-input w-100" @bind="model.JobTitle" placeholder="@GetJobTitlePlaceholder()" />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label small fw-semibold text-slate-700 mb-1">Phòng ban / Đơn vị công tác <span class="text-danger">*</span></label>
                                        <input type="text" class="tf-custom-input w-100" @bind="model.DepartmentName" />
                                    </div>

                                    @if (model.ContractType == EmploymentContractType.Internship || model.ContractType == EmploymentContractType.VocationalTraining)
                                    {
                                        <div class="col-12 col-md-6">
                                            <label class="form-label small fw-semibold text-slate-700 mb-1">
                                                @(model.ContractType == EmploymentContractType.Internship ? "Chương trình thực tập sinh" : "Đề cương đào tạo nghề")
                                            </label>
                                            <input type="text" class="tf-custom-input w-100" @bind="model.InternshipProgramme" placeholder="VD: Chương trình thực tập nghiệp vụ kinh doanh thiết bị LACASA..." />
                                        </div>
                                        <div class="col-12 col-md-6">
                                            <label class="form-label small fw-semibold text-slate-700 mb-1">Cán bộ / Người hướng dẫn chuyên môn</label>
                                            <input type="text" class="tf-custom-input w-100" @bind="model.TrainingSupervisor" placeholder="VD: Nguyễn Văn An - Trưởng phòng kỹ thuật" />
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label small fw-semibold text-slate-700 mb-1">Mục tiêu đào tạo / Kỹ năng cần đạt</label>
                                            <textarea class="form-control rounded-3" rows="2" @bind="model.TrainingObjectives" placeholder="Nêu rõ các mục tiêu kiến thức, kỹ năng và kết quả mong đợi..."></textarea>
                                        </div>
                                    }

                                    <div class="col-12">
                                        <label class="form-label small fw-semibold text-slate-700 mb-1">Địa điểm làm việc cụ thể <span class="text-danger">*</span></label>
                                        <input type="text" class="tf-custom-input w-100" @bind="model.Workplace" />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label small fw-semibold text-slate-700 mb-1">Mô tả tóm tắt nhiệm vụ công việc</label>
                                        <textarea class="form-control rounded-3" rows="2" @bind="model.JobDescription" placeholder="Mô tả quyền hạn và trách nhiệm trọng tâm..."></textarea>
                                    </div>
                                    <div class="col-12 col-md-3">
                                        <label class="form-label small fw-semibold text-slate-700 mb-1">Số giờ làm việc / tuần (Max 48h)</label>
                                        <input type="number" class="tf-custom-input w-100" @bind="model.WorkingHoursPerWeek" max="48" min="20" />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label small fw-semibold text-slate-700 mb-1">Lịch làm việc chi tiết</label>
                                        <input type="text" class="tf-custom-input w-100" @bind="model.WorkingSchedule" />
                                    </div>
                                    <div class="col-12 col-md-3">
                                        <label class="form-label small fw-semibold text-slate-700 mb-1">Số ngày phép năm (Điều 113)</label>
                                        <input type="number" class="tf-custom-input w-100" @bind="model.AnnualLeaveDays" min="12" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- TAB 2: TIỀN LƯƠNG & CHẾ ĐỘ -->
                        <div id="emp-tab-remuneration" class="tf-contract-tab-pane @(activeTab == "remuneration" ? "is-active" : "")" style="display: @(activeTab == "remuneration" ? "block" : "none");">
                            <div class="tf-form-section">
                                <div class="tf-form-section-header">
                                    <h6 class="tf-form-section-title">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                                        </svg>
                                        <span>Thỏa thuận tiền lương &amp; Chế độ thù lao</span>
                                    </h6>
                                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 small px-2 py-1">Linh hoạt theo thỏa thuận</span>
                                </div>
                                <div class="row g-3">
                                    <div class="col-12 col-md-6">
                                        <label class="form-label small fw-semibold text-slate-700 mb-1">
                                            Mức lương số học (VND) <span class="badge bg-secondary bg-opacity-10 text-muted border ms-1">Tùy chọn</span>
                                        </label>
                                        <input type="number" class="tf-custom-input w-100" @bind="model.BasicSalary" placeholder="Bỏ trống nếu thỏa thuận riêng theo Phụ lục..." step="500000" />
                                        <div class="form-text smaller text-muted">
                                            Không bắt buộc nhập số tiền để lưu bản nháp. Nếu để trống, hệ thống hiển thị "—" hoặc "Theo thỏa thuận", không hiển thị "0 đ".
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label small fw-semibold text-slate-700 mb-1">Hình thức lương</label>
                                        <input type="text" class="tf-custom-input w-100" @bind="model.SalaryType" placeholder="Lương thời gian, Lương khoán, Thù lao hỗ trợ..." />
                                    </div>

                                    <!-- Direct Multiline Salary Clause Text Editor -->
                                    <div class="col-12">
                                        <div class="d-flex align-items-center justify-content-between mb-1.5">
                                            <label class="form-label small fw-bold text-dark mb-0">
                                                Nội dung thỏa thuận thù lao / tiền lương trong hợp đồng (Điều 3)
                                            </label>
                                            <button type="button" class="btn btn-xs btn-outline-primary py-1 px-2.5 rounded-2 d-inline-flex align-items-center gap-1" @onclick="GenerateSalaryClauseFromFields">
                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
                                                <span>Tạo mẫu chữ từ thông số</span>
                                            </button>
                                        </div>
                                        <textarea class="form-control rounded-3 font-monospace" rows="3" @bind="model.SalaryClauseText" placeholder="VD: Mức lương theo thỏa thuận tại Phụ lục chi tiết và Quy chế tài chính của Công ty..."></textarea>
                                        <div class="form-text smaller text-muted">
                                            Bạn có thể biên soạn trực tiếp câu từ thỏa thuận tiền lương tại đây. Nội dung này sẽ được ưu tiên hiển thị trên bản in/PDF.
                                        </div>
                                    </div>

                                    <div class="col-12 col-md-4">
                                        <label class="form-label small fw-semibold text-slate-700 mb-1">Phụ cấp chức vụ (VND)</label>
                                        <input type="number" class="tf-custom-input w-100" @bind="model.PositionAllowance" step="100000" placeholder="0" />
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label class="form-label small fw-semibold text-slate-700 mb-1">Trợ cấp cơm trưa (VND)</label>
                                        <input type="number" class="tf-custom-input w-100" @bind="model.LunchAllowance" step="50000" placeholder="0" />
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label class="form-label small fw-semibold text-slate-700 mb-1">Phụ cấp khác (VND)</label>
                                        <input type="number" class="tf-custom-input w-100" @bind="model.OtherAllowances" step="100000" placeholder="0" />
                                    </div>

                                    <div class="col-12 col-md-6">
                                        <label class="form-label small fw-semibold text-slate-700 mb-1">Kỳ hạn chi trả</label>
                                        <input type="text" class="tf-custom-input w-100" @bind="model.PaymentPeriod" />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label small fw-semibold text-slate-700 mb-1">Hình thức thanh toán</label>
                                        <input type="text" class="tf-custom-input w-100" @bind="model.PaymentMethod" />
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label class="form-label small fw-semibold text-slate-700 mb-1">Tỷ lệ đóng BHXH, BHYT, BHTN (%)</label>
                                        <input type="number" class="tf-custom-input w-100" @bind="model.SocialInsuranceRate" step="0.5" />
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label class="form-label small fw-semibold text-slate-700 mb-1">Chính sách xét nâng lương</label>
                                        <input type="text" class="tf-custom-input w-100" @bind="model.SalaryReviewPolicy" />
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label class="form-label small fw-semibold text-slate-700 mb-1">Trang bị bảo hộ lao động</label>
                                        <input type="text" class="tf-custom-input w-100" @bind="model.LaborProtection" />
                                    </div>
                                </div>
                            </div>

                            <!-- Section: Cam kết phụ trợ -->
                            <div class="tf-form-section">
                                <div class="tf-form-section-header">
                                    <h6 class="tf-form-section-title">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                        </svg>
                                        <span>Các thỏa thuận cam kết phụ trợ</span>
                                    </h6>
                                </div>
                                <div class="row g-3">
                                    <div class="col-12">
                                        <div class="form-check form-switch mb-1">
                                            <input class="form-check-input" type="checkbox" id="ndaCheck" @bind="model.HasNonDisclosureAgreement" />
                                            <label class="form-check-label small fw-bold text-dark" for="ndaCheck">
                                                Thỏa thuận bảo mật thông tin &amp; Bí mật kinh doanh (NDA)
                                            </label>
                                        </div>
                                        @if (model.HasNonDisclosureAgreement)
                                        {
                                            <textarea class="form-control rounded-3 mt-1.5" rows="2" @bind="model.NdaClauseDetails"></textarea>
                                        }
                                    </div>

                                    <div class="col-12">
                                        <div class="form-check form-switch mb-1">
                                            <input class="form-check-input" type="checkbox" id="trainingCheck" @bind="model.HasTrainingReimbursement" />
                                            <label class="form-check-label small fw-bold text-dark" for="trainingCheck">
                                                Cam kết đào tạo &amp; Hoàn trả chi phí đào tạo nghề
                                            </label>
                                        </div>
                                        @if (model.HasTrainingReimbursement)
                                        {
                                            <textarea class="form-control rounded-3 mt-1.5" rows="2" @bind="model.TrainingClauseDetails" placeholder="Quy định thời gian cam kết phục vụ và tỷ lệ bồi hoàn nếu vi phạm..."></textarea>
                                        }
                                    </div>

                                    <div class="col-12">
                                        <div class="form-check form-switch mb-1">
                                            <input class="form-check-input" type="checkbox" id="benefitsCheck" @bind="model.HasSpecialBenefits" />
                                            <label class="form-check-label small fw-bold text-dark" for="benefitsCheck">
                                                Chế độ phúc lợi nội bộ LACASA
                                            </label>
                                        </div>
                                        @if (model.HasSpecialBenefits)
                                        {
                                            <textarea class="form-control rounded-3 mt-1.5" rows="2" @bind="model.SpecialBenefitsDetails"></textarea>
                                        }
                                    </div>

                                    <div class="col-12">
                                        <label class="form-label small fw-semibold text-slate-700 mb-1">Ghi chú nội bộ</label>
                                        <input type="text" class="tf-custom-input w-100" @bind="model.Notes" placeholder="Ghi chú nội bộ cho bộ phận nhân sự..." />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- TAB 3: SOẠN THẢO ĐIỀU KHOẢN (CLAUSE EDITOR) -->
                        <div id="emp-tab-clauses" class="tf-contract-tab-pane @(activeTab == "clauses" ? "is-active" : "")" style="display: @(activeTab == "clauses" ? "block" : "none");">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <div>
                                    <h6 class="fw-bold tf-contract-modal-title mb-0">Danh mục điều khoản văn bản hợp đồng</h6>
                                    <div class="text-muted smaller">Bạn có thể chỉnh sửa trực tiếp nội dung từng điều, thêm điều khoản mới hoặc xóa điều khoản tùy chọn.</div>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <button type="button" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1 rounded-2" @onclick="ResetAllClausesToDefault">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>
                                        </svg>
                                        <span>Khôi phục mẫu mặc định</span>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-primary d-flex align-items-center gap-1 rounded-2 shadow-2xs" @onclick="AddNewClause">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                                        </svg>
                                        <span>+ Thêm điều khoản mới</span>
                                    </button>
                                </div>
                            </div>

                            @if (model.Clauses != null)
                            {
                                <div class="d-flex flex-column gap-3">
                                    @for (int i = 0; i < model.Clauses.Count; i++)
                                    {
                                        var index = i;
                                        var clause = model.Clauses[i];
                                        <div class="tf-form-section p-3 mb-0" @key="clause">
                                            <div class="d-flex align-items-center justify-content-between mb-2">
                                                <div class="d-flex align-items-center gap-2 flex-grow-1 me-3">
                                                    <input type="text" class="tf-custom-input fw-bold" style="max-width: 95px;" @bind="clause.ArticleNumber" />
                                                    <input type="text" class="tf-custom-input fw-semibold flex-grow-1" @bind="clause.Title" />
                                                </div>
                                                <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                                    @if (clause.IsMandatory)
                                                    {
                                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border small px-2 py-1">Bắt buộc</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-info bg-opacity-10 text-info border small px-2 py-1">Tùy chọn</span>
                                                        <button type="button" class="btn btn-xs btn-outline-danger py-1 px-2 rounded-2" title="Xóa điều khoản này" @onclick="() => RemoveClause(index)">
                                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                                <polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                                            </svg>
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                            <div>
                                                <textarea class="form-control rounded-3 font-monospace" rows="4" @bind="clause.Content" style="font-size: 13px; line-height: 1.55;"></textarea>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <!-- TAB 4: LIVE PREVIEW A4 & KIỂM ĐỊNH PHÁP LÝ BLLĐ 2026 -->
                        @if (activeTab == "preview")
                        {
                        <div id="emp-tab-preview" class="tf-contract-tab-pane is-active">
                            <!-- Real-time Legal Compliance Summary -->
                            <div class="card border-0 shadow-sm p-3 mb-3 bg-light bg-opacity-50 border">
                                <div class="d-flex align-items-center justify-content-between mb-2 pb-1 border-bottom">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge @(GetEmpCompliance().IsFullyCompliant ? "bg-success-subtle text-success border border-success" : "bg-warning-subtle text-warning border border-warning") px-2.5 py-1 fw-bold fs-7">
                                            ✔ @GetEmpCompliance().ComplianceScore% Hợp chuẩn BLLĐ 2026 (@GetEmpCompliance().PassedCount/9 tiêu chuẩn Đạt)
                                        </span>
                                        <span class="text-muted smaller d-none d-md-inline">Bộ luật Lao động (VBHN 18/VBHN-VPQH ngày 12/02/2026) &amp; NĐ 337/2025/NĐ-CP</span>
                                    </div>
                                    <span class="text-secondary smaller fw-semibold">02 bản chính (Đ14 BLLĐ)</span>
                                </div>
                                <div class="row g-2">
                                    @foreach (var check in GetEmpCompliance().Items)
                                    {
                                        <div class="col-md-4 col-sm-6">
                                            <div class="p-2 border rounded bg-white small h-100 shadow-2xs">
                                                <div class="d-flex align-items-center justify-content-between mb-0.5">
                                                    <span class="fw-bold text-dark text-truncate" title="@check.Title">@check.Title</span>
                                                    <span class="badge @(check.Status == LegalCheckItemStatus.Passed ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning") px-1 py-0.5">
                                                        @(check.Status == LegalCheckItemStatus.Passed ? "Đạt" : "Lưu ý")
                                                    </span>
                                                </div>
                                                <div class="text-primary smaller fw-semibold" style="font-size: 0.75rem;">@check.LegalReference</div>
                                                <div class="text-muted smaller mt-0.5" style="line-height: 1.3; font-size: 0.75rem;">@check.Details</div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Document Zoom Toolbar -->
                            <div class="tf-preview-toolbar d-flex align-items-center justify-content-between mb-3">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2.5 py-1 small fw-semibold d-inline-flex align-items-center gap-1.5">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                            <polyline points="14 2 14 8 20 8"></polyline>
                                        </svg>
                                        Khổ giấy chuẩn A4 (210 × 297 mm) — Bản chưa ký
                                    </span>
                                    <span class="text-muted smaller d-none d-md-inline">Xem trước văn bản đa trang chuẩn A4, ngắt trang tự động</span>
                                </div>
                                <div class="d-flex align-items-center gap-1.5">
                                    <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2 rounded-2" @onclick="ZoomOut" title="Thu nhỏ (-10%)" disabled="@(_previewZoom <= 0.8)">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <circle cx="11" cy="11" r="8"></circle>
                                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                            <line x1="8" y1="11" x2="14" y2="11"></line>
                                        </svg>
                                    </button>
                                    <span class="badge bg-light text-dark border px-2.5 py-1.5 fw-bold font-monospace small">
                                        @($"{Math.Round(_previewZoom * 100)}%")
                                    </span>
                                    <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2 rounded-2" @onclick="ZoomIn" title="Phóng to (+10%)" disabled="@(_previewZoom >= 1.2)">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <circle cx="11" cy="11" r="8"></circle>
                                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                            <line x1="11" y1="8" x2="11" y2="14"></line>
                                            <line x1="8" y1="11" x2="14" y2="11"></line>
                                        </svg>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2 rounded-2" @onclick="ResetZoom" title="Đặt lại 100%">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
                                            <polyline points="3 3 3 8 8 8"></polyline>
                                        </svg>
                                    </button>
                                </div>
                            </div>

                            <div class="tf-preview-viewport-scroll">
                                <div class="tf-preview-zoom-wrapper" style="transform: scale(@_previewZoom); transform-origin: top center;">
                                    <EmploymentContractA4DocumentView Contract="@BuildDraftDto()"
                                                                      IncludeSignatures="false"
                                                                      ContainerId="print-employment-contract" />
                                </div>
                            </div>
                        </div>
                        }
                    </div>
                </div>
                <!-- Footer Actions (Step-by-Step Wizard Navigation) -->
                <div class="modal-footer tf-contract-modal-footer px-4 py-3 d-flex align-items-center justify-content-between flex-shrink-0">
                    <div class="d-flex align-items-center">
                        @if (GetCurrentStepIndex() > 0)
                        {
                            <button type="button" class="tf-btn tf-btn-secondary tf-btn-sm d-inline-flex align-items-center gap-1.5" @onclick="GoPrevStep" disabled="@isSubmitting">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="19" y1="12" x2="5" y2="12"></line>
                                    <polyline points="12 19 5 12 12 5"></polyline>
                                </svg>
                                <span>Quay lại</span>
                            </button>
                        }
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        @if (activeTab != "preview")
                        {
                            <button type="button" class="tf-btn tf-btn-secondary tf-btn-sm" @onclick="HandleSubmitAsync" disabled="@isSubmitting">
                                <span>Lưu bản nháp</span>
                            </button>
                            <button type="button" class="tf-btn tf-btn-primary tf-btn-sm d-inline-flex align-items-center gap-1.5" @onclick="GoNextStep" disabled="@isSubmitting">
                                <span>Tiếp tục</span>
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                    <polyline points="12 5 19 12 12 19"></polyline>
                                </svg>
                            </button>
                        }
                        else
                        {
                            <button type="button" class="tf-btn tf-btn-secondary tf-btn-sm d-inline-flex align-items-center gap-1.5" @onclick="PrintContract" title="In hợp đồng trực tiếp (Không có header/footer URL trình duyệt)">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="6 9 6 2 18 2 18 9"></polyline>
                                    <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                                    <rect x="6" y="14" width="12" height="8"></rect>
                                </svg>
                                <span>In hợp đồng</span>
                            </button>
                            <button type="button" class="tf-btn tf-btn-secondary tf-btn-sm d-inline-flex align-items-center gap-1.5" @onclick="DownloadContractPdf" disabled="@isDownloadingPdf" title="Tải xuống file PDF chính thức về máy">
                                @if (isDownloadingPdf)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                    <span>Đang tạo PDF...</span>
                                }
                                else
                                {
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                        <polyline points="7 10 12 15 17 10"></polyline>
                                        <line x1="12" y1="15" x2="12" y2="3"></line>
                                    </svg>
                                    <span>Tải xuống PDF</span>
                                }
                            </button>
                            <button type="button" class="tf-btn tf-btn-primary tf-btn-sm d-inline-flex align-items-center gap-1.5" @onclick="HandleSubmitAsync" disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                    <span>Đang lưu...</span>
                                }
                                else
                                {
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                                        <polyline points="17 21 17 13 7 13 7 21"></polyline>
                                        <polyline points="7 3 7 8 15 8"></polyline>
                                    </svg>
                                    <span>@(IsEditMode ? "Cập nhật hợp đồng" : "Lưu hợp đồng")</span>
                                }
                            </button>
                        }
                    </div>
                </div>

@* Unsaved Changes Confirm Dialog *@
                @if (_showDiscardConfirm)
                {
                    <div class="tf-modal-confirm-overlay" @onclick:stopPropagation="true">
                        <div class="tf-modal-confirm-box text-center">
                            <div class="tw-w-12 tw-h-12 tw-rounded-full tw-bg-amber-100 tw-text-amber-600 tw-flex tw-items-center tw-justify-center tw-mx-auto tw-mb-3">
                                <svg class="tw-w-6 tw-h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                                </svg>
                            </div>
                            <h4 class="tw-text-base tw-font-bold tw-text-slate-900 tw-mb-1.5">Bạn có thay đổi chưa lưu</h4>
                            <p class="tw-text-xs tw-text-slate-500 tw-mb-5 tw-leading-relaxed">
                                Bạn có chắc muốn đóng và hủy thay đổi? Các điều khoản và thông tin hợp đồng bạn vừa soạn thảo sẽ không được lưu lại.
                            </p>
                            <div class="tw-flex tw-items-center tw-justify-center tw-gap-2.5">
                                <button type="button" class="tf-btn tf-btn-secondary tf-btn-sm px-3" @onclick="() => _showDiscardConfirm = false">
                                    Tiếp tục chỉnh sửa
                                </button>
                                <button type="button" class="tf-btn tf-btn-danger tf-btn-sm px-3" @onclick="ConfirmDiscardAsync">
                                    Hủy thay đổi
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private string activeTab = "info";
    private bool IsEditMode => EditContractId.HasValue && EditContractId.Value > 0;
    public int? EditContractId { get; set; }
    public string ContractNumber { get; set; } = string.Empty;

    private CreateEmploymentContractDto model = new();
    private List<Employee> employees = new();
    private Employee? selectedEmployee;
    private string selectedEmployeeDisplay = string.Empty;
    private ContractPartyASettingsDto? partyASettings;

    private bool isSubmitting = false;
    private string errorMessage = string.Empty;
    private bool _isClosing = false;
    private bool _wasOpen = false;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && !_wasOpen)
        {
            _wasOpen = true;
            _isClosing = false;
            _showDiscardConfirm = false;
            try
            {
                await JS.InvokeVoidAsync("TradeFlowMotion.lockScroll");
            }
            catch { }
        }
        else if (!IsOpen && _wasOpen)
        {
            _wasOpen = false;
            try
            {
                await JS.InvokeVoidAsync("TradeFlowMotion.unlockScroll", true);
            }
            catch { }
        }

        if (IsOpen && employees.Count == 0)
        {
            await LoadEmployeesAsync();
            await LoadPartyASettingsAsync();
        }
    }

    private async Task LoadEmployeesAsync()
    {
        try
        {
            using var ctx = await DbContextFactory.CreateDbContextAsync();
            employees = await ctx.Employees
                .Include(e => e.Department)
                .Include(e => e.Position)
                .Where(e => e.Status == EmployeeStatus.Active)
                .OrderBy(e => e.FullName)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            errorMessage = "Lỗi khi tải danh sách nhân viên: " + ex.Message;
        }
    }

