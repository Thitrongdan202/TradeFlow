    private string GetDefaultCity()
    {
        if (partyASettings != null && !string.IsNullOrWhiteSpace(partyASettings.RegisteredAddress))
        {
            var parts = partyASettings.RegisteredAddress.Split(',');
            if (parts.Length > 0)
            {
                var city = parts[^1].Trim();
                if (!string.IsNullOrWhiteSpace(city))
                    return city;
            }
        }
        return "TP. Cần Thơ";
    }

