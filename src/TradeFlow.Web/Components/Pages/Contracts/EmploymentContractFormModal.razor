                    CustomTerms = model.CustomTerms,
                    Notes = model.Notes,
                    Clauses = model.Clauses ?? new()
                };

                await EmploymentContractService.UpdateContractAsync(updateDto, userId, userName);
            }
            else
            {
                await EmploymentContractService.CreateContractAsync(model, userId, userName);
            }

            _wasOpen = false;
            _isClosing = false;
            IsOpen = false;
            await IsOpenChanged.InvokeAsync(false);
            try
            {
                await JS.InvokeVoidAsync("TradeFlowMotion.unlockScroll", true);
            }
            catch { }
            StateHasChanged();
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private bool _showDiscardConfirm = false;

    private bool IsModalDirty =>
        model.EmployeeId > 0 ||
        !string.IsNullOrWhiteSpace(model.JobTitle) ||
        model.BasicSalary > 0;

    private async Task RequestCloseModal()
    {
        if (isSubmitting) return;

        if (IsModalDirty)
        {
            _showDiscardConfirm = true;
            return;
        }

        await CloseAsync();
    }

    private async Task HandleModalBackdropClick()
    {
        if (isSubmitting) return;

        if (IsModalDirty)
        {
            _showDiscardConfirm = true;
            return;
        }

        await CloseAsync();
    }

    private async Task HandleModalKeyDown(KeyboardEventArgs e)
    {
        if (isSubmitting) return;

        if (e.Key == "Escape")
        {
            if (_showDiscardConfirm)
            {
                _showDiscardConfirm = false;
                return;
            }

            await RequestCloseModal();
        }
    }

    private async Task ConfirmDiscardAsync()
    {
        _showDiscardConfirm = false;
        await CloseAsync();
    }

    private async Task CloseAsync()
    {
        if (_isClosing) return;

        bool reduced = false;
        try
        {
            reduced = await JS.InvokeAsync<bool>("TradeFlowMotion.isReducedMotion");
        }
        catch { }

        if (!reduced)
        {
            _isClosing = true;
            StateHasChanged();
            try
            {
                await JS.InvokeVoidAsync("TradeFlowMotion.animateModalExit", ".modal-dialog", ".modal");
            }
            catch
            {
                await Task.Delay(160);
            }
        }

        _showDiscardConfirm = false;
        _isClosing = false;
        _wasOpen = false;
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
        try
        {
            await JS.InvokeVoidAsync("TradeFlowMotion.unlockScroll", true);
        }
        catch { }
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("TradeFlowMotion.unlockScroll", true);
        }
        catch { }
    }

