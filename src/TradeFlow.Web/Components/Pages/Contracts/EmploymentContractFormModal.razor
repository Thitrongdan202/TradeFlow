    private void GenerateSalaryClauseFromFields()
    {
        if (model.ContractType == EmploymentContractType.Internship)
        {
            model.SalaryClauseText = model.BasicSalary.HasValue && model.BasicSalary.Value > 0
                ? $"Hỗ trợ kinh phí thực tập sinh: {model.BasicSalary.Value:N0} đ/tháng. Hỗ trợ cơm trưa và phương tiện làm việc tại công ty."
                : "Phụ cấp hỗ trợ thực tập sinh chi trả theo thỏa thuận và quy chế đào tạo sinh viên của Công ty.";
        }
        else if (model.ContractType == EmploymentContractType.VocationalTraining)
        {
            model.SalaryClauseText = model.BasicSalary.HasValue && model.BasicSalary.Value > 0
                ? $"Tiền công trong thời gian học nghề, tập nghề: {model.BasicSalary.Value:N0} đ/tháng theo Điều 61 BLLĐ. Doanh nghiệp đài thọ tài liệu và trang bị thực hành."
                : "Hưởng thù lao học việc theo thỏa thuận phù hợp với quy định tại Khoản 5 Điều 61 Bộ luật Lao động.";
        }
        else if (model.BasicSalary.HasValue && model.BasicSalary.Value > 0)
        {
            var text = $"Mức lương cơ bản: {model.BasicSalary.Value:N0} đồng/tháng ({model.SalaryType}).";
            if (model.ContractType == EmploymentContractType.Probation && model.ProbationSalaryPercentage.HasValue)
            {
                var prob = model.BasicSalary.Value * (model.ProbationSalaryPercentage.Value / 100m);
                text += $" Lương thời gian thử việc bằng {model.ProbationSalaryPercentage.Value}% lương chính, tương đương {prob:N0} đồng/tháng theo Điều 26 BLLĐ.";
            }
            if ((model.PositionAllowance ?? 0) > 0 || (model.LunchAllowance ?? 0) > 0 || (model.OtherAllowances ?? 0) > 0)
            {
                text += $" Phụ cấp chức vụ: {(model.PositionAllowance ?? 0):N0} đ; Tiền ăn trưa: {(model.LunchAllowance ?? 0):N0} đ; Phụ cấp khác: {(model.OtherAllowances ?? 0):N0} đ.";
            }
            model.SalaryClauseText = text;
        }
        else
        {
            model.SalaryClauseText = "Mức lương và chế độ đãi ngộ thực hiện theo thỏa thuận chi tiết tại Phụ lục hợp đồng và Quy chế lương thưởng nội bộ của Công ty.";
        }

        // Also update clause 3 in model.Clauses
        var clause3 = model.Clauses?.FirstOrDefault(c => c.ArticleNumber == "Điều 3" || c.Id == "clause_3");
        if (clause3 != null)
        {
            clause3.Content = model.SalaryClauseText;
        }
    }

