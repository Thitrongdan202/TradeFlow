    private EmploymentContractDto? existingContract;
    private bool isDownloadingPdf = false;

    private string GetEmployeePhone() => selectedEmployee?.Phone ?? "—";
    private string GetEmployeeEmail() => selectedEmployee?.Email ?? "—";

    private string GetContractPrefixText()
    {
        var num = string.IsNullOrEmpty(ContractNumber) ? "HDLD-2026-DRAFT (Dự thảo)" : ContractNumber;
        if (num.StartsWith("HDTV", StringComparison.OrdinalIgnoreCase) || model.ContractType == EmploymentContractType.Probation)
            return $"HĐTV số: {num}";
        if (num.StartsWith("TTTT", StringComparison.OrdinalIgnoreCase) || model.ContractType == EmploymentContractType.Internship)
            return $"TTTT số: {num}";
        if (num.StartsWith("HDDT", StringComparison.OrdinalIgnoreCase) || model.ContractType == EmploymentContractType.VocationalTraining)
            return $"HĐĐT số: {num}";
        return $"HĐLĐ số: {num}";
    }

    private string GetEmployerRepName()
    {
        if (!string.IsNullOrWhiteSpace(model.EmployerRepresentativeName))
            return model.EmployerRepresentativeName;
        var defaultRep = partyASettings?.RepresentativeName ?? "Trần Thị Mai Phương";
        var empName = GetEmployeeName();
        if (!string.IsNullOrWhiteSpace(empName) && string.Equals(empName.Trim(), defaultRep.Trim(), StringComparison.OrdinalIgnoreCase))
        {
            return "Trần Thị Mai Phương";
        }
        return defaultRep;
    }

    private string GetEmployerRepPosition()
    {
        if (!string.IsNullOrWhiteSpace(model.EmployerRepresentativePosition))
            return model.EmployerRepresentativePosition;
        var repName = GetEmployerRepName();
        if (repName == "Trần Thị Mai Phương")
            return "Chủ tịch Hội đồng thành viên (Đại diện ủy quyền)";
        return partyASettings?.RepresentativePosition ?? "Giám đốc (Đại diện theo pháp luật)";
    }

    private async Task DownloadContractPdf()
    {
        if (isDownloadingPdf) return;
        isDownloadingPdf = true;
        try
        {
            var rawNumber = string.IsNullOrWhiteSpace(ContractNumber) ? "HDLD-2026-DRAFT" : ContractNumber.Trim();
            var safeCode = string.Concat(rawNumber.Split(System.IO.Path.GetInvalidFileNameChars())).Replace(" ", "_");
            var filename = $"Hop_dong_lao_dong_{safeCode}.pdf";

            if ((EditContractId ?? 0) > 0)
            {
                await JS.InvokeVoidAsync("tradeflow.downloadPdf", $"/api/contracts/employment/{EditContractId.Value}/export-pdf", filename);
            }
            else
            {
                var dto = BuildDraftDto();
                await JS.InvokeVoidAsync("tradeflow.downloadPdfFromPost", "/api/contracts/employment/export-draft-pdf", dto, filename);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[DownloadContractPdf] Error: {ex.Message}");
        }
        finally
        {
            isDownloadingPdf = false;
            StateHasChanged();
        }
    }

