    private async Task DownloadContractPdf(int id, string? contractNumber)
    {
        try
        {
            var rawNumber = string.IsNullOrWhiteSpace(contractNumber) ? $"HD-{id}" : contractNumber.Trim();
            var safeCode = string.Concat(rawNumber.Split(System.IO.Path.GetInvalidFileNameChars())).Replace(" ", "_");
            var filename = $"Hop_dong_{safeCode}.pdf";
            await JS.InvokeVoidAsync("tradeflow.downloadPdf", $"/api/contracts/{id}/export-pdf", filename);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Index.DownloadContractPdf] Error: {ex.Message}");
        }
    }

    private async Task DownloadEmploymentContractPdf(int id, string? contractNumber)
    {
        try
        {
            var rawNumber = string.IsNullOrWhiteSpace(contractNumber) ? $"HDLD-{id}" : contractNumber.Trim();
            var safeCode = string.Concat(rawNumber.Split(System.IO.Path.GetInvalidFileNameChars())).Replace(" ", "_");
            var filename = $"Hop_dong_lao_dong_{safeCode}.pdf";
            await JS.InvokeVoidAsync("tradeflow.downloadPdf", $"/api/contracts/employment/{id}/export-pdf", filename);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Index.DownloadEmploymentContractPdf] Error: {ex.Message}");
        }
    }
