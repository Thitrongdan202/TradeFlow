@page "/hop-dong"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Permission:Contracts:View")]
@using Microsoft.AspNetCore.Authorization
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Application.Common.Models.Contracts
@using TradeFlow.Domain.Enums
@inject IContractService ContractService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Quản lý Hợp đồng &amp; Phụ lục — TradeFlow</PageTitle>

<div class="container-fluid p-3 p-sm-4 tf-contracts-page">
    <!-- Header Section -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <h1 class="tf-header-title mb-0">Quản lý Hợp đồng &amp; Phụ lục</h1>
                <span class="tf-legal-badge">
                    BLDS 2015 &amp; Luật GDĐT 2023
                </span>
            </div>
            <p class="tf-header-subtitle mb-0 mt-1">
                Lập, quản lý, ký điện tử và lưu trữ toàn vẹn hợp đồng mua bán, cung cấp lắp đặt thiết bị vệ sinh LACASA.
            </p>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <button type="button" class="tf-header-btn"
                    @onclick="() => showPartyASettingsModal = true"
                    title="Cấu hình thông tin pháp nhân Bên A mặc định cho hợp đồng">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-secondary">
                    <circle cx="12" cy="12" r="3"/>
                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                </svg>
                <span>Thiết lập Bên A</span>
            </button>
            <a href="/hop-dong/mau-hop-dong" class="tf-header-btn"
               title="Xem tuyển tập 7 mẫu hợp đồng tiêu chuẩn A4">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-secondary">
                    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                    <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
                </svg>
                <span>Thư viện mẫu HĐ</span>
            </a>
            <AuthorizeView Policy="Permission:Contracts:Create">
                <button type="button" class="tf-primary-btn"
                        @onclick="() => showTemplateSelectorModal = true"
                        title="Soạn thảo hợp đồng mới theo mẫu quy chuẩn">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <line x1="12" y1="5" x2="12" y2="19"/>
                        <line x1="5" y1="12" x2="19" y2="12"/>
                    </svg>
                    <span>Tạo hợp đồng mới</span>
                </button>
            </AuthorizeView>
        </div>
    </div>

    <!-- Quick Stats Cards (KPI) -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="tf-kpi-card tf-kpi-blue">
                <div>
                    <div class="tf-kpi-header">
                        <span class="tf-kpi-label">Tổng số hợp đồng</span>
                        <div class="tf-kpi-icon-badge">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                <polyline points="14 2 14 8 20 8"/>
                            </svg>
                        </div>
                    </div>
                    <div class="tf-kpi-value">@contracts.Count</div>
                </div>
                <div class="tf-kpi-subtext">
                    Giá trị: <strong class="text-dark">@contracts.Sum(c => c.TotalAmount).ToString("N0") đ</strong>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="tf-kpi-card tf-kpi-warning">
                <div>
                    <div class="tf-kpi-header">
                        <span class="tf-kpi-label">Chờ ký kết</span>
                        <div class="tf-kpi-icon-badge">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"/>
                                <polyline points="12 6 12 12 16 14"/>
                            </svg>
                        </div>
                    </div>
                    <div class="tf-kpi-value">@contracts.Count(c => c.Status == ContractStatus.PendingSignature)</div>
                </div>
                <div class="tf-kpi-subtext">
                    Đã sẵn sàng ký điện tử / giấy
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="tf-kpi-card tf-kpi-success">
                <div>
                    <div class="tf-kpi-header">
                        <span class="tf-kpi-label">Đã hoàn tất ký</span>
                        <div class="tf-kpi-icon-badge">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                                <polyline points="22 4 12 14.01 9 11.01"/>
                            </svg>
                        </div>
                    </div>
                    <div class="tf-kpi-value">@contracts.Count(c => c.Status == ContractStatus.Signed)</div>
                </div>
                <div class="tf-kpi-subtext">
                    Có đầy đủ hiệu lực pháp lý
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="tf-kpi-card tf-kpi-info">
                <div>
                    <div class="tf-kpi-header">
                        <span class="tf-kpi-label">Đã thanh lý</span>
                        <div class="tf-kpi-icon-badge">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                        </div>
                    </div>
                    <div class="tf-kpi-value">@contracts.Count(c => c.Status == ContractStatus.Liquidated)</div>
                </div>
                <div class="tf-kpi-subtext">
                    Hoàn tất mọi quyền và nghĩa vụ
                </div>
            </div>
        </div>
    </div>

    <!-- Filter & Search Toolbar Card -->
    <div class="tf-filter-card">
        <!-- Status Navigation Tabs -->
        <div class="tf-status-container mb-3">
            <button type="button" class="tf-status-tab @(selectedStatus == null ? "active" : "")"
                    @onclick="() => FilterByStatus(null)">
                <span>Tất cả</span>
                <span class="tf-tab-count">@contracts.Count</span>
            </button>
            <button type="button" class="tf-status-tab @(selectedStatus == ContractStatus.Draft ? "active" : "")"
                    @onclick="() => FilterByStatus(ContractStatus.Draft)">
                <span>Bản nháp</span>
                <span class="tf-tab-count">@contracts.Count(c => c.Status == ContractStatus.Draft)</span>
            </button>
            <button type="button" class="tf-status-tab @(selectedStatus == ContractStatus.PendingSignature ? "active" : "")"
                    @onclick="() => FilterByStatus(ContractStatus.PendingSignature)">
                <span>Chờ ký</span>
                <span class="tf-tab-count">@contracts.Count(c => c.Status == ContractStatus.PendingSignature)</span>
            </button>
            <button type="button" class="tf-status-tab @(selectedStatus == ContractStatus.Signed ? "active" : "")"
                    @onclick="() => FilterByStatus(ContractStatus.Signed)">
                <span>Đã ký</span>
                <span class="tf-tab-count">@contracts.Count(c => c.Status == ContractStatus.Signed)</span>
            </button>
            <button type="button" class="tf-status-tab @(selectedStatus == ContractStatus.Printed ? "active" : "")"
                    @onclick="() => FilterByStatus(ContractStatus.Printed)">
                <span>Đã in giấy</span>
                <span class="tf-tab-count">@contracts.Count(c => c.Status == ContractStatus.Printed)</span>
            </button>
            <button type="button" class="tf-status-tab @(selectedStatus == ContractStatus.Liquidated ? "active" : "")"
                    @onclick="() => FilterByStatus(ContractStatus.Liquidated)">
                <span>Đã thanh lý</span>
                <span class="tf-tab-count">@contracts.Count(c => c.Status == ContractStatus.Liquidated)</span>
            </button>
            <button type="button" class="tf-status-tab @(selectedStatus == ContractStatus.Cancelled ? "active" : "")"
                    @onclick="() => FilterByStatus(ContractStatus.Cancelled)">
                <span>Đã hủy</span>
                <span class="tf-tab-count">@contracts.Count(c => c.Status == ContractStatus.Cancelled)</span>
            </button>
        </div>

        <!-- Filter Controls Row -->
        <div class="row g-2 align-items-center">
            <div class="col-12 col-md-5 col-lg-5">
                <div class="tf-contract-search-group">
                    <svg class="tf-contract-search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"/>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                    <input type="text" class="form-control tf-contract-search-input"
                           placeholder="Tìm theo Số HĐ, Tiêu đề, Tên Bên B, MST, SĐT..."
                           value="@searchTerm" @oninput="OnSearchInput" />
                    @if (!string.IsNullOrEmpty(searchTerm))
                    {
                        <button type="button" class="tf-contract-search-clear" @onclick="() => searchTerm = string.Empty" title="Xóa từ khóa tìm kiếm">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="18" y1="6" x2="6" y2="18"/>
                                <line x1="6" y1="6" x2="18" y2="18"/>
                            </svg>
                        </button>
                    }
                </div>
            </div>
            <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                <select class="form-select tf-filter-select" @bind="selectedTemplateCode">
                    <option value="">Tất cả mẫu hợp đồng</option>
                    <option value="B2B_SALE">Mua bán thương mại (B2B)</option>
                    <option value="B2C_RETAIL">Bán lẻ tiêu dùng (B2C)</option>
                    <option value="SUPPLY_INSTALL">Cung cấp &amp; Lắp đặt</option>
                    <option value="PRINCIPLE_AGREEMENT">Hợp đồng nguyên tắc</option>
                    <option value="DEPOSIT_AGREEMENT">Thỏa thuận đặt cọc</option>
                    <option value="CONTRACT_LIQUIDATION">Biên bản thanh lý</option>
                    <option value="CONTRACT_APPENDIX">Phụ lục hợp đồng</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-md-2 col-lg-2">
                <select class="form-select tf-filter-select" @bind="selectedPartyType">
                    <option value="">Mọi chủ thể Bên B</option>
                    <option value="Company">Doanh nghiệp</option>
                    <option value="Individual">Cá nhân</option>
                </select>
            </div>
            <div class="col-12 col-md-2 col-lg-2 text-md-end d-flex align-items-center justify-content-between justify-content-md-end gap-2">
                @if (HasActiveFilters)
                {
                    <button type="button" class="btn btn-sm btn-link text-decoration-none text-muted p-0 small" @onclick="ClearFilters" title="Đặt lại bộ lọc về mặc định">
                        Đặt lại
                    </button>
                }
                <span class="tf-counter-badge">
                    Hiển thị <strong>@FilteredContracts.Count()</strong> / @contracts.Count
                </span>
            </div>
        </div>
    </div>

    <!-- Contracts Table Card -->
    <div class="tf-table-card">
        <div class="table-responsive">
            <table class="table tf-table align-middle">
                <thead>
                    <tr>
                        <th class="ps-3" style="width: 150px;">Số hợp đồng</th>
                        <th>Tiêu đề &amp; Mẫu hợp đồng</th>
                        <th>Bên B (Khách hàng / Đối tác)</th>
                        <th class="text-end" style="width: 150px;">Tổng giá trị</th>
                        <th class="text-center" style="width: 130px;">Phương thức</th>
                        <th class="text-center" style="width: 130px;">Trạng thái</th>
                        <th class="pe-3 text-end" style="width: 120px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <div class="spinner-border text-primary spinner-border-sm" role="status"></div>
                                <span class="text-muted small ms-2">Đang tải danh sách hợp đồng...</span>
                            </td>
                        </tr>
                    }
                    else if (!FilteredContracts.Any())
                    {
                        <tr>
                            <td colspan="7">
                                <div class="tf-empty-state">
                                    <div class="tf-empty-icon-wrap">
                                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                            <polyline points="14 2 14 8 20 8"/>
                                            <line x1="16" y1="13" x2="8" y2="13"/>
                                            <line x1="16" y1="17" x2="8" y2="17"/>
                                        </svg>
                                    </div>
                                    <div class="tf-empty-title">Không tìm thấy hợp đồng phù hợp</div>
                                    <div class="tf-empty-desc">
                                        @if (HasActiveFilters)
                                        {
                                            <span>Không có bản ghi nào khớp với điều kiện lọc hiện tại. Bấm <a href="javascript:void(0)" @onclick="ClearFilters" class="text-primary fw-semibold text-decoration-none">Đặt lại bộ lọc</a> để xem tất cả.</span>
                                        }
                                        else
                                        {
                                            <span>Hệ thống chưa có hợp đồng nào. Bấm "Tạo hợp đồng mới" để bắt đầu soạn thảo văn bản.</span>
                                        }
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var c in FilteredContracts)
                        {
                            <tr class="tf-table-row">
                                <td class="ps-3">
                                    <a href="/hop-dong/@c.Id" class="tf-contract-number">
                                        @c.ContractNumber
                                    </a>
                                    <div class="tf-contract-date">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                                            <line x1="16" y1="2" x2="16" y2="6"/>
                                            <line x1="8" y1="2" x2="8" y2="6"/>
                                            <line x1="3" y1="10" x2="21" y2="10"/>
                                        </svg>
                                        <span>@c.ContractDate.ToString("dd/MM/yyyy")</span>
                                    </div>
                                </td>
                                <td>
                                    <a href="/hop-dong/@c.Id" class="tf-contract-title-link">
                                        @c.Title
                                    </a>
                                    <span class="tf-template-badge">
                                        @GetTemplateTitle(c.TemplateCode)
                                    </span>
                                </td>
                                <td>
                                    <div class="tf-party-name">@c.PartyBName</div>
                                    <div class="tf-party-sub">
                                        @if (!string.IsNullOrEmpty(c.PartyBTaxCode))
                                        {
                                            <span class="tf-party-tag">MST: @c.PartyBTaxCode</span>
                                        }
                                        else if (!string.IsNullOrEmpty(c.PartyBIdCardNumber))
                                        {
                                            <span class="tf-party-tag">CCCD: @c.PartyBIdCardNumber</span>
                                        }
                                        @if (!string.IsNullOrEmpty(c.PartyBPhone))
                                        {
                                            <span>SĐT: @c.PartyBPhone</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-end">
                                    <div class="tf-amount-main">@c.TotalAmount.ToString("N0") @c.CurrencyCode</div>
                                    @if (c.DepositAmount > 0)
                                    {
                                        <div class="tf-amount-deposit">
                                            Cọc: @c.DepositAmount.ToString("N0") @c.CurrencyCode
                                        </div>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (c.ExecutionMethod == ContractExecutionMethod.Electronic)
                                    {
                                        <span class="tf-method-badge tf-method-electronic">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                            </svg>
                                            <span>Ký điện tử</span>
                                        </span>
                                    }
                                    else if (c.ExecutionMethod == ContractExecutionMethod.PaperPrinted)
                                    {
                                        <span class="tf-method-badge tf-method-paper">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <polyline points="6 9 6 2 18 2 18 9"/>
                                                <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/>
                                                <rect x="6" y="14" width="12" height="8"/>
                                            </svg>
                                            <span>Bản in giấy</span>
                                        </span>
                                    }
                                    else if (c.ExecutionMethod == ContractExecutionMethod.Both)
                                    {
                                        <span class="tf-method-badge tf-method-both">
                                            <span>Điện tử &amp; Giấy</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">---</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="tf-status-pill @GetStatusPillClass(c.Status)">
                                        <span class="tf-status-dot"></span>
                                        <span>@GetStatusVietnamese(c.Status)</span>
                                    </span>
                                </td>
                                <td class="pe-3 text-end">
                                    <div class="tf-action-group">
                                        <a href="/hop-dong/@c.Id" class="tf-action-btn" title="Xem chi tiết">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8z"/>
                                                <circle cx="12" cy="12" r="3"/>
                                            </svg>
                                        </a>
                                        <a href="/api/contracts/@c.Id/export-pdf" target="_blank" class="tf-action-btn" title="Xuất PDF (Times New Roman)">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                                                <polyline points="7 10 12 15 17 10"/>
                                                <line x1="12" y1="15" x2="12" y2="3"/>
                                            </svg>
                                        </a>
                                        @if (c.Status == ContractStatus.Draft)
                                        {
                                            <button type="button" class="tf-action-btn tf-action-btn-danger" title="Xóa bản nháp" @onclick="() => DeleteContract(c.Id)">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <polyline points="3 6 5 6 21 6"/>
                                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                                </svg>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Components -->
<PartyASettingsModal @bind-IsOpen="showPartyASettingsModal" OnSaved="OnPartyASaved" />
<TemplateSelectorModal @bind-IsOpen="showTemplateSelectorModal" />

@code {
    private List<ContractDto> contracts = new();
    private bool isLoading = true;
    private bool showPartyASettingsModal = false;
    private bool showTemplateSelectorModal = false;

    private string searchTerm = string.Empty;
    private ContractStatus? selectedStatus;
    private string selectedTemplateCode = string.Empty;
    private string selectedPartyType = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadContractsAsync();
    }

    private async Task LoadContractsAsync()
    {
        isLoading = true;
        try
        {
            contracts = await ContractService.GetContractsAsync();
        }
        catch (Exception) { }
        finally
        {
            isLoading = false;
        }
    }

    private void FilterByStatus(ContractStatus? status)
    {
        selectedStatus = status;
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;
    }

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(searchTerm) ||
        selectedStatus.HasValue ||
        !string.IsNullOrWhiteSpace(selectedTemplateCode) ||
        !string.IsNullOrWhiteSpace(selectedPartyType);

    private void ClearFilters()
    {
        searchTerm = string.Empty;
        selectedStatus = null;
        selectedTemplateCode = string.Empty;
        selectedPartyType = string.Empty;
    }

    private IEnumerable<ContractDto> FilteredContracts
    {
        get
        {
            var query = contracts.AsEnumerable();

            if (selectedStatus.HasValue)
            {
                query = query.Where(c => c.Status == selectedStatus.Value);
            }

            if (!string.IsNullOrWhiteSpace(selectedTemplateCode))
            {
                query = query.Where(c => c.TemplateCode == selectedTemplateCode);
            }

            if (!string.IsNullOrWhiteSpace(selectedPartyType))
            {
                if (Enum.TryParse<ContractPartyBType>(selectedPartyType, out var pt))
                {
                    query = query.Where(c => c.PartyBType == pt);
                }
            }

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.Trim().ToLower();
                query = query.Where(c => c.ContractNumber.ToLower().Contains(term)
                    || c.Title.ToLower().Contains(term)
                    || c.PartyBName.ToLower().Contains(term)
                    || (c.PartyBTaxCode != null && c.PartyBTaxCode.ToLower().Contains(term))
                    || (c.PartyBPhone != null && c.PartyBPhone.ToLower().Contains(term)));
            }

            return query;
        }
    }

    private async Task DeleteContract(int id)
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var userName = auth.User.Identity?.Name ?? "Admin";
        var success = await ContractService.DeleteContractAsync(id, "admin", userName);
        if (success)
        {
            contracts.RemoveAll(c => c.Id == id);
        }
    }

    private async Task OnPartyASaved()
    {
        await LoadContractsAsync();
    }

