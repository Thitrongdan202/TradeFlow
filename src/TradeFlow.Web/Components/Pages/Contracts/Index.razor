@page "/hop-dong"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Permission:Contracts:View")]
@using Microsoft.AspNetCore.Authorization
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Application.Common.Models.Contracts
@using TradeFlow.Domain.Enums
@inject IContractService ContractService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Quản lý Hợp đồng &amp; Phụ lục — TradeFlow</PageTitle>

<div class="container-fluid p-4">
    <!-- Header Section -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <h1 class="h4 mb-0 fw-bold text-dark">Quản lý Hợp đồng &amp; Phụ lục</h1>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 small">
                    BLDS 2015 &amp; Luật GDĐT 2023
                </span>
            </div>
            <p class="text-muted small mb-0 mt-1">
                Lập, quản lý, ký điện tử và lưu trữ toàn vẹn hợp đồng mua bán, cung cấp lắp đặt thiết bị vệ sinh LACASA.
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1 bg-white shadow-sm"
                    @onclick="() => showPartyASettingsModal = true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="3"/>
                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                </svg>
                <span>Thiết lập Bên A</span>
            </button>
            <button type="button" class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1 bg-white shadow-sm"
                    @onclick="() => showTemplateSelectorModal = true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                    <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
                </svg>
                <span>Thư viện mẫu HĐ</span>
            </button>
            <AuthorizeView Policy="Permission:Contracts:Create">
                <button type="button" class="btn btn-sm btn-primary d-flex align-items-center gap-1 shadow-sm px-3"
                        @onclick="() => showTemplateSelectorModal = true">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="12" y1="5" x2="12" y2="19"/>
                        <line x1="5" y1="12" x2="19" y2="12"/>
                    </svg>
                    <span>Tạo hợp đồng mới</span>
                </button>
            </AuthorizeView>
        </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm p-3 bg-white">
                <div class="text-secondary small fw-semibold">Tổng số hợp đồng</div>
                <div class="fs-4 fw-bold text-dark mt-1">@contracts.Count</div>
                <div class="text-muted small mt-1">Giá trị: @contracts.Sum(c => c.TotalAmount).ToString("N0") đ</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm p-3 bg-white border-start border-warning border-4">
                <div class="text-secondary small fw-semibold">Chờ ký kết</div>
                <div class="fs-4 fw-bold text-warning mt-1">@contracts.Count(c => c.Status == ContractStatus.PendingSignature)</div>
                <div class="text-muted small mt-1">Đã sẵn sàng ký điện tử / giấy</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm p-3 bg-white border-start border-success border-4">
                <div class="text-secondary small fw-semibold">Đã hoàn tất ký</div>
                <div class="fs-4 fw-bold text-success mt-1">@contracts.Count(c => c.Status == ContractStatus.Signed)</div>
                <div class="text-muted small mt-1">Có hiệu lực pháp lý</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm p-3 bg-white border-start border-info border-4">
                <div class="text-secondary small fw-semibold">Đã thanh lý</div>
                <div class="fs-4 fw-bold text-info mt-1">@contracts.Count(c => c.Status == ContractStatus.Liquidated)</div>
                <div class="text-muted small mt-1">Hoàn thành nghĩa vụ</div>
            </div>
        </div>
    </div>

    <!-- Filter & Search Toolbar -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <!-- Status Tabs -->
            <ul class="nav nav-pills gap-1 mb-3 border-bottom pb-2">
                <li class="nav-item">
                    <button class="nav-link py-1 px-3 small @(selectedStatus == null ? "active" : "")"
                            @onclick="() => FilterByStatus(null)">
                        Tất cả (@contracts.Count)
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link py-1 px-3 small @(selectedStatus == ContractStatus.Draft ? "active" : "")"
                            @onclick="() => FilterByStatus(ContractStatus.Draft)">
                        Bản nháp (@contracts.Count(c => c.Status == ContractStatus.Draft))
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link py-1 px-3 small @(selectedStatus == ContractStatus.PendingSignature ? "active" : "")"
                            @onclick="() => FilterByStatus(ContractStatus.PendingSignature)">
                        Chờ ký (@contracts.Count(c => c.Status == ContractStatus.PendingSignature))
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link py-1 px-3 small @(selectedStatus == ContractStatus.Signed ? "active" : "")"
                            @onclick="() => FilterByStatus(ContractStatus.Signed)">
                        Đã ký (@contracts.Count(c => c.Status == ContractStatus.Signed))
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link py-1 px-3 small @(selectedStatus == ContractStatus.Printed ? "active" : "")"
                            @onclick="() => FilterByStatus(ContractStatus.Printed)">
                        Đã in giấy (@contracts.Count(c => c.Status == ContractStatus.Printed))
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link py-1 px-3 small @(selectedStatus == ContractStatus.Liquidated ? "active" : "")"
                            @onclick="() => FilterByStatus(ContractStatus.Liquidated)">
                        Đã thanh lý (@contracts.Count(c => c.Status == ContractStatus.Liquidated))
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link py-1 px-3 small @(selectedStatus == ContractStatus.Cancelled ? "active" : "")"
                            @onclick="() => FilterByStatus(ContractStatus.Cancelled)">
                        Đã hủy (@contracts.Count(c => c.Status == ContractStatus.Cancelled))
                    </button>
                </li>
            </ul>

            <div class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light text-muted border-end-0">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="11" cy="11" r="8"/>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                            </svg>
                        </span>
                        <input type="text" class="form-control border-start-0" placeholder="Tìm theo Số HĐ, Tiêu đề, Tên Bên B, Mã số thuế, SĐT..."
                               @bind="searchTerm" @bind:event="oninput" />
                    </div>
                </div>
                <div class="col-md-3">
                    <select class="form-select form-select-sm" @bind="selectedTemplateCode">
                        <option value="">Tất cả mẫu hợp đồng</option>
                        <option value="B2B_SALE">Mua bán thương mại (B2B)</option>
                        <option value="B2C_RETAIL">Bán lẻ tiêu dùng (B2C)</option>
                        <option value="SUPPLY_INSTALL">Cung cấp &amp; Lắp đặt</option>
                        <option value="PRINCIPLE_AGREEMENT">Hợp đồng nguyên tắc</option>
                        <option value="DEPOSIT_AGREEMENT">Thỏa thuận đặt cọc</option>
                        <option value="CONTRACT_LIQUIDATION">Biên bản thanh lý</option>
                        <option value="CONTRACT_APPENDIX">Phụ lục hợp đồng</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <select class="form-select form-select-sm" @bind="selectedPartyType">
                        <option value="">Mọi chủ thể Bên B</option>
                        <option value="Company">Doanh nghiệp</option>
                        <option value="Individual">Cá nhân</option>
                    </select>
                </div>
                <div class="col-md-2 text-end">
                    <span class="text-muted small">
                        Hiển thị <strong>@FilteredContracts.Count()</strong> / @contracts.Count
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Contracts Table -->
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary small">
                    <tr>
                        <th class="ps-3" style="width: 140px;">Số hợp đồng</th>
                        <th>Tiêu đề &amp; Mẫu hợp đồng</th>
                        <th>Bên B (Khách hàng / Đối tác)</th>
                        <th class="text-end" style="width: 140px;">Tổng giá trị</th>
                        <th class="text-center" style="width: 120px;">Phương thức</th>
                        <th class="text-center" style="width: 120px;">Trạng thái</th>
                        <th class="pe-3 text-end" style="width: 140px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <div class="spinner-border text-primary spinner-border-sm" role="status"></div>
                                <span class="text-muted small ms-2">Đang tải danh sách hợp đồng...</span>
                            </td>
                        </tr>
                    }
                    else if (!FilteredContracts.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <div class="text-muted mb-2">
                                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-secondary opacity-50">
                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                        <polyline points="14 2 14 8 20 8"/>
                                        <line x1="16" y1="13" x2="8" y2="13"/>
                                        <line x1="16" y1="17" x2="8" y2="17"/>
                                    </svg>
                                </div>
                                <div class="fw-semibold text-secondary">Chưa có hợp đồng nào phù hợp</div>
                                <div class="text-muted small mt-1">Bấm "Tạo hợp đồng mới" để bắt đầu soạn thảo văn bản.</div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var c in FilteredContracts)
                        {
                            <tr>
                                <td class="ps-3">
                                    <a href="/hop-dong/@c.Id" class="fw-bold text-primary text-decoration-none font-monospace">
                                        @c.ContractNumber
                                    </a>
                                    <div class="text-muted small" style="font-size: 0.75rem;">
                                        @c.ContractDate.ToString("dd/MM/yyyy")
                                    </div>
                                </td>
                                <td>
                                    <a href="/hop-dong/@c.Id" class="text-dark fw-semibold text-decoration-none d-block">
                                        @c.Title
                                    </a>
                                    <span class="badge bg-light text-secondary border small" style="font-size: 0.72rem;">
                                        @GetTemplateTitle(c.TemplateCode)
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@c.PartyBName</div>
                                    <div class="text-muted small" style="font-size: 0.75rem;">
                                        @if (!string.IsNullOrEmpty(c.PartyBTaxCode))
                                        {
                                            <span>MST: @c.PartyBTaxCode</span>
                                        }
                                        else if (!string.IsNullOrEmpty(c.PartyBIdCardNumber))
                                        {
                                            <span>CCCD: @c.PartyBIdCardNumber</span>
                                        }
                                        @if (!string.IsNullOrEmpty(c.PartyBPhone))
                                        {
                                            <span class="ms-2">SĐT: @c.PartyBPhone</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-end">
                                    <div class="fw-bold text-dark">@c.TotalAmount.ToString("N0") @c.CurrencyCode</div>
                                    @if (c.DepositAmount > 0)
                                    {
                                        <div class="text-muted small" style="font-size: 0.72rem;">
                                            Cọc: @c.DepositAmount.ToString("N0") @c.CurrencyCode
                                        </div>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (c.ExecutionMethod == ContractExecutionMethod.Electronic)
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle small">
                                            Ký điện tử
                                        </span>
                                    }
                                    else if (c.ExecutionMethod == ContractExecutionMethod.PaperPrinted)
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border small">
                                            Bản in giấy
                                        </span>
                                    }
                                    else if (c.ExecutionMethod == ContractExecutionMethod.Both)
                                    {
                                        <span class="badge bg-success-subtle text-success border small">
                                            Điện tử &amp; Giấy
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">---</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge @GetStatusBadgeClass(c.Status) px-2 py-1">
                                        @GetStatusVietnamese(c.Status)
                                    </span>
                                </td>
                                <td class="pe-3 text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a href="/hop-dong/@c.Id" class="btn btn-outline-secondary" title="Xem chi tiết">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                                <circle cx="12" cy="12" r="3"/>
                                            </svg>
                                        </a>
                                        <a href="/api/contracts/@c.Id/export-pdf" target="_blank" class="btn btn-outline-secondary" title="Xuất PDF (Times New Roman)">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                                                <polyline points="7 10 12 15 17 10"/>
                                                <line x1="12" y1="15" x2="12" y2="3"/>
                                            </svg>
                                        </a>
                                        @if (c.Status == ContractStatus.Draft)
                                        {
                                            <button type="button" class="btn btn-outline-danger" title="Xóa bản nháp" @onclick="() => DeleteContract(c.Id)">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <polyline points="3 6 5 6 21 6"/>
                                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                                </svg>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Components -->
<PartyASettingsModal @bind-IsOpen="showPartyASettingsModal" OnSaved="OnPartyASaved" />
<TemplateSelectorModal @bind-IsOpen="showTemplateSelectorModal" />

@code {
    private List<ContractDto> contracts = new();
    private bool isLoading = true;
    private bool showPartyASettingsModal = false;
    private bool showTemplateSelectorModal = false;

    private string searchTerm = string.Empty;
    private ContractStatus? selectedStatus;
    private string selectedTemplateCode = string.Empty;
    private string selectedPartyType = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadContractsAsync();
    }

    private async Task LoadContractsAsync()
    {
        isLoading = true;
        try
        {
            contracts = await ContractService.GetContractsAsync();
        }
        catch (Exception) { }
        finally
        {
            isLoading = false;
        }
    }

    private void FilterByStatus(ContractStatus? status)
    {
        selectedStatus = status;
    }

    private IEnumerable<ContractDto> FilteredContracts
    {
        get
        {
            var query = contracts.AsEnumerable();

            if (selectedStatus.HasValue)
            {
                query = query.Where(c => c.Status == selectedStatus.Value);
            }

            if (!string.IsNullOrWhiteSpace(selectedTemplateCode))
            {
                query = query.Where(c => c.TemplateCode == selectedTemplateCode);
            }

            if (!string.IsNullOrWhiteSpace(selectedPartyType))
            {
                if (Enum.TryParse<ContractPartyBType>(selectedPartyType, out var pt))
                {
                    query = query.Where(c => c.PartyBType == pt);
                }
            }

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.Trim().ToLower();
                query = query.Where(c => c.ContractNumber.ToLower().Contains(term)
                    || c.Title.ToLower().Contains(term)
                    || c.PartyBName.ToLower().Contains(term)
                    || (c.PartyBTaxCode != null && c.PartyBTaxCode.ToLower().Contains(term))
                    || (c.PartyBPhone != null && c.PartyBPhone.ToLower().Contains(term)));
            }

            return query;
        }
    }

    private async Task DeleteContract(int id)
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var userName = auth.User.Identity?.Name ?? "Admin";
        var success = await ContractService.DeleteContractAsync(id, "admin", userName);
        if (success)
        {
            contracts.RemoveAll(c => c.Id == id);
        }
    }

    private async Task OnPartyASaved()
    {
        await LoadContractsAsync();
    }

    private static string GetTemplateTitle(string code) => code switch
    {
        "B2B_SALE" => "Mua bán thương mại (B2B)",
        "B2C_RETAIL" => "Bán lẻ tiêu dùng (B2C)",
        "SUPPLY_INSTALL" => "Cung cấp & Lắp đặt",
        "PRINCIPLE_AGREEMENT" => "Hợp đồng nguyên tắc",
        "DEPOSIT_AGREEMENT" => "Thỏa thuận đặt cọc",
        "CONTRACT_LIQUIDATION" => "Biên bản thanh lý",
        "CONTRACT_APPENDIX" => "Phụ lục hợp đồng",
        _ => code
    };

    private static string GetStatusVietnamese(ContractStatus status) => status switch
    {
        ContractStatus.Draft => "Bản nháp",
        ContractStatus.PendingSignature => "Chờ ký",
        ContractStatus.Signed => "Đã ký",
        ContractStatus.Printed => "Đã in giấy",
        ContractStatus.Liquidated => "Đã thanh lý",
        ContractStatus.Cancelled => "Đã hủy",
        _ => status.ToString()
    };

    private static string GetStatusBadgeClass(ContractStatus status) => status switch
    {
        ContractStatus.Draft => "bg-secondary text-white",
        ContractStatus.PendingSignature => "bg-warning text-dark",
        ContractStatus.Signed => "bg-success text-white",
        ContractStatus.Printed => "bg-info text-dark",
        ContractStatus.Liquidated => "bg-primary text-white",
        ContractStatus.Cancelled => "bg-danger text-white",
        _ => "bg-light text-dark"
    };
}
