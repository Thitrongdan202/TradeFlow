@page "/tai-lieu/danh-muc"
@using Microsoft.AspNetCore.Authorization
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Application.Common.Models.Documents
@using TradeFlow.Domain.Enums
@inject IDocumentService DocumentService
@inject NavigationManager Nav
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Permission:Documents:View")]

<PageTitle>Danh mục loại chứng từ | TradeFlow</PageTitle>

<div class="tf-page-header">
    <div class="tf-page-header-content">
        <h1 class="tf-page-title">Danh mục loại chứng từ & Hồ sơ</h1>
        <p class="tf-page-subtitle">Phân loại các loại tài liệu thương mại, hợp đồng, chứng từ kế toán và hồ sơ đính kèm.</p>
    </div>
    <div class="tf-page-header-actions" style="display:flex; gap:8px;">
        <a href="/tai-lieu" class="tf-btn tf-btn-outline-secondary">
            ← Danh sách tài liệu
        </a>
        <AuthorizeView Policy="Permission:Documents:Create">
            <button type="button" class="tf-btn tf-btn-primary" @onclick="OpenCreateModal">
                + Thêm loại chứng từ
            </button>
        </AuthorizeView>
    </div>
</div>

@if (!string.IsNullOrEmpty(_statusMessage))
{
    <div class="tf-alert tf-alert-success tf-mb-3">
        @_statusMessage
        <button type="button" style="float:right; background:none; border:none; cursor:pointer;" @onclick="() => _statusMessage = null">✕</button>
    </div>
}

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="tf-alert tf-alert-danger tf-mb-3">
        @_errorMessage
        <button type="button" style="float:right; background:none; border:none; cursor:pointer;" @onclick="() => _errorMessage = null">✕</button>
    </div>
}

@if (_isLoading)
{
    <div class="tf-loading">Đang tải danh mục chứng từ...</div>
}
else
{
    <div class="tf-card">
        <div class="tf-table-responsive">
            <table class="tf-table" style="font-size:13px;">
                <thead>
                    <tr>
                        <th style="width:50px; text-align:center;">STT</th>
                        <th style="width:120px;">Mã loại</th>
                        <th>Tên loại chứng từ</th>
                        <th style="width:180px;">Nhóm chứng từ</th>
                        <th style="width:90px; text-align:center;">Thứ tự</th>
                        <th style="width:110px; text-align:center;">Tài liệu</th>
                        <th style="width:110px; text-align:center;">Trạng thái</th>
                        <th style="width:100px; text-align:center;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int idx = 1;
                        foreach (var cat in _categories)
                        {
                            <tr>
                                <td style="text-align:center; color:#64748b;">@idx</td>
                                <td>
                                    <strong>@cat.Code</strong>
                                    @if (cat.IsSystem)
                                    {
                                        <span class="tf-badge tf-badge-secondary" style="font-size:10px; margin-left:4px;" title="Loại chứng từ mặc định của hệ thống">Hệ thống</span>
                                    }
                                </td>
                                <td>
                                    <div style="font-weight:600; color:#1e293b;">@cat.Name</div>
                                    @if (!string.IsNullOrEmpty(cat.Description))
                                    {
                                        <div style="font-size:12px; color:#64748b;">@cat.Description</div>
                                    }
                                </td>
                                <td>
                                    @GetGroupBadge(cat.Group)
                                </td>
                                <td style="text-align:center; color:#64748b;">@cat.DisplayOrder</td>
                                <td style="text-align:center;">
                                    <span class="tf-badge tf-badge-info" style="font-size:11px;">@cat.AttachmentCount tệp</span>
                                </td>
                                <td style="text-align:center;">
                                    @if (cat.IsActive)
                                    {
                                        <span class="tf-badge tf-badge-success" style="font-size:11px;">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="tf-badge tf-badge-secondary" style="font-size:11px;">Tạm khóa</span>
                                    }
                                </td>
                                <td style="text-align:center;">
                                    <AuthorizeView Policy="Permission:Documents:Edit">
                                        <button type="button" class="tf-btn tf-btn-sm tf-btn-outline-primary" style="padding:2px 10px; font-size:12px;" @onclick="() => OpenEditModal(cat)">
                                            Sửa
                                        </button>
                                    </AuthorizeView>
                                </td>
                            </tr>
                            idx++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@* Create / Edit Modal *@
@if (_showModal)
{
    <div style="position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1050; display:flex; align-items:center; justify-content:center;">
        <div style="background:white; padding:24px; border-radius:8px; width:480px; max-width:92%; box-shadow:0 10px 25px rgba(0,0,0,0.2);">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; border-bottom:1px solid #e2e8f0; padding-bottom:12px;">
                <h3 style="margin:0; font-size:17px; font-weight:600; color:#1e293b;">
                    @(_isEditing ? "Chỉnh sửa loại chứng từ" : "Thêm loại chứng từ mới")
                </h3>
                <button type="button" style="background:none; border:none; font-size:18px; cursor:pointer; color:#64748b;" @onclick="() => _showModal = false">✕</button>
            </div>

            @if (!string.IsNullOrEmpty(_modalError))
            {
                <div class="tf-alert tf-alert-danger tf-mb-3" style="font-size:13px;">@_modalError</div>
            }

            <div class="tf-form-group tf-mb-3">
                <label class="tf-form-label" style="font-weight:600;">Mã loại chứng từ <span style="color:red">*</span></label>
                <input type="text" class="tf-form-control" placeholder="VD: HOP_DONG, BIEN_BAN..." @bind="_editingCategory.Code" disabled="@(_isEditing && _editingCategory.IsSystem)" />
                @if (_isEditing && _editingCategory.IsSystem)
                {
                    <div style="font-size:11.5px; color:#64748b; margin-top:2px;">Mã loại của hệ thống không thể thay đổi.</div>
                }
            </div>

            <div class="tf-form-group tf-mb-3">
                <label class="tf-form-label" style="font-weight:600;">Tên loại chứng từ <span style="color:red">*</span></label>
                <input type="text" class="tf-form-control" placeholder="Tên hiển thị..." @bind="_editingCategory.Name" />
            </div>

            <div class="tf-form-group tf-mb-3">
                <label class="tf-form-label" style="font-weight:600;">Nhóm chứng từ</label>
                <select class="tf-form-control" @bind="_editingCategory.Group">
                    <option value="@DocumentTypeCategory.Commercial">Thương mại & Bán hàng</option>
                    <option value="@DocumentTypeCategory.Accounting">Kế toán & Thuế</option>
                    <option value="@DocumentTypeCategory.Internal">Nội bộ & Hành chính</option>
                    <option value="@DocumentTypeCategory.Attachment">Tài liệu đính kèm khác</option>
                </select>
            </div>

            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:12px;" class="tf-mb-3">
                <div class="tf-form-group">
                    <label class="tf-form-label" style="font-weight:600;">Thứ tự hiển thị</label>
                    <input type="number" class="tf-form-control" @bind="_editingCategory.DisplayOrder" />
                </div>
                <div class="tf-form-group">
                    <label class="tf-form-label" style="font-weight:600;">Trạng thái</label>
                    <select class="tf-form-control" @bind="_editingCategory.IsActive">
                        <option value="true">Hoạt động</option>
                        <option value="false">Tạm khóa</option>
                    </select>
                </div>
            </div>

            <div class="tf-form-group tf-mb-4">
                <label class="tf-form-label" style="font-weight:600;">Mô tả / Diễn giải</label>
                <textarea class="tf-form-control" rows="2" placeholder="Mô tả mục đích lưu trữ của loại tài liệu này..." @bind="_editingCategory.Description"></textarea>
            </div>

            <div style="display:flex; justify-content:flex-end; gap:10px; border-top:1px solid #e2e8f0; padding-top:16px;">
                <button type="button" class="tf-btn tf-btn-outline-secondary" @onclick="() => _showModal = false" disabled="@_isSaving">Hủy</button>
                <button type="button" class="tf-btn tf-btn-primary" @onclick="SaveCategory" disabled="@_isSaving">
                    @if (_isSaving)
                    {
                        <span>Đang lưu...</span>
                    }
                    else
                    {
                        <span>Lưu thông tin</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<DocumentCategoryDto> _categories = new();
    private bool _isLoading = true;
    private bool _isSaving = false;
    private string? _statusMessage;
    private string? _errorMessage;

    // Modal state
    private bool _showModal = false;
    private bool _isEditing = false;
    private DocumentCategoryDto _editingCategory = new();
    private string? _modalError;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            _isLoading = true;
            _categories = await DocumentService.GetCategoriesAsync(activeOnly: false);
        }
        catch (Exception ex)
        {
            _errorMessage = "Lỗi khi tải danh mục: " + ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenCreateModal()
    {
        _isEditing = false;
        _editingCategory = new DocumentCategoryDto
        {
            DisplayOrder = _categories.Count + 1,
            IsActive = true,
            Group = DocumentTypeCategory.Commercial
        };
        _modalError = null;
        _showModal = true;
    }

    private void OpenEditModal(DocumentCategoryDto cat)
    {
        _isEditing = true;
        _editingCategory = new DocumentCategoryDto
        {
            Id = cat.Id,
            Code = cat.Code,
            Name = cat.Name,
            Group = cat.Group,
            Description = cat.Description,
            IsActive = cat.IsActive,
            DisplayOrder = cat.DisplayOrder,
            IsSystem = cat.IsSystem
        };
        _modalError = null;
        _showModal = true;
    }

    private async Task SaveCategory()
    {
        if (string.IsNullOrWhiteSpace(_editingCategory.Code))
        {
            _modalError = "Vui lòng nhập mã loại chứng từ.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_editingCategory.Name))
        {
            _modalError = "Vui lòng nhập tên loại chứng từ.";
            return;
        }

        try
        {
            _isSaving = true;
            _modalError = null;

            if (_isEditing)
            {
                var ok = await DocumentService.UpdateCategoryAsync(_editingCategory);
                if (ok)
                {
                    _statusMessage = $"Đã cập nhật loại chứng từ '{_editingCategory.Name}'.";
                    _showModal = false;
                    await LoadDataAsync();
                }
            }
            else
            {
                var created = await DocumentService.CreateCategoryAsync(_editingCategory);
                _statusMessage = $"Đã tạo mới loại chứng từ '{created.Name}'.";
                _showModal = false;
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            _modalError = "Lỗi: " + ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private RenderFragment GetGroupBadge(DocumentTypeCategory group) => __builder =>
    {
        switch (group)
        {
            case DocumentTypeCategory.Commercial:
                __builder.OpenElement(0, "span");
                __builder.AddAttribute(1, "class", "tf-badge tf-badge-primary");
                __builder.AddContent(2, "Thương mại & Bán hàng");
                __builder.CloseElement();
                break;
            case DocumentTypeCategory.Accounting:
                __builder.OpenElement(0, "span");
                __builder.AddAttribute(1, "class", "tf-badge tf-badge-warning");
                __builder.AddContent(2, "Kế toán & Thuế");
                __builder.CloseElement();
                break;
            case DocumentTypeCategory.Internal:
                __builder.OpenElement(0, "span");
                __builder.AddAttribute(1, "class", "tf-badge tf-badge-info");
                __builder.AddContent(2, "Nội bộ & Hành chính");
                __builder.CloseElement();
                break;
            default:
                __builder.OpenElement(0, "span");
                __builder.AddAttribute(1, "class", "tf-badge tf-badge-secondary");
                __builder.AddContent(2, "Đính kèm khác");
                __builder.CloseElement();
                break;
        }
    };
}
