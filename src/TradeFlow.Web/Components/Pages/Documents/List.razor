@page "/tai-lieu"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Application.Common.Models.Documents
@using TradeFlow.Domain.Enums
@inject IDocumentService DocumentService
@inject NavigationManager Nav
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Permission:Documents:View")]

<PageTitle>Quản lý tài liệu & chứng từ | TradeFlow</PageTitle>

<div class="tf-page-header">
    <div class="tf-page-header-content">
        <h1 class="tf-page-title">Hồ sơ & Chứng từ lưu trữ</h1>
        <p class="tf-page-subtitle">Quản lý toàn bộ tài liệu đính kèm, chứng từ giao dịch, hợp đồng và hóa đơn trong hệ thống.</p>
    </div>
    <div class="tf-page-header-actions" style="display:flex; gap:8px;">
        <a href="/tai-lieu/danh-muc" class="tf-btn tf-btn-outline-secondary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:6px;">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
            </svg>
            Danh mục chứng từ
        </a>
        <AuthorizeView Policy="Permission:Documents:Create">
            <button type="button" class="tf-btn tf-btn-primary" @onclick="OpenUploadModal">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:6px;">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                Tải lên tài liệu
            </button>
        </AuthorizeView>
    </div>
</div>

@* Filter Bar *@
<div class="tf-card tf-mb-4" style="padding:16px 20px;">
    <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap:12px; align-items:end;">
        <div>
            <label class="tf-form-label" style="font-size:12px; font-weight:600; margin-bottom:4px;">Tìm kiếm</label>
            <input type="text" class="tf-form-control" placeholder="Tên tệp tin, mô tả..." @bind="_filter.SearchTerm" @bind:event="oninput" @onkeyup="HandleSearch" />
        </div>
        <div>
            <label class="tf-form-label" style="font-size:12px; font-weight:600; margin-bottom:4px;">Nhóm chứng từ</label>
            <select class="tf-form-control" @bind="_selectedGroup" @bind:after="ApplyFilter">
                <option value="">-- Tất cả nhóm --</option>
                <option value="Commercial">Thương mại & Bán hàng</option>
                <option value="Accounting">Kế toán & Thuế</option>
                <option value="Internal">Nội bộ & Hành chính</option>
                <option value="Attachment">Tài liệu đính kèm khác</option>
            </select>
        </div>
        <div>
            <label class="tf-form-label" style="font-size:12px; font-weight:600; margin-bottom:4px;">Loại chứng từ</label>
            <select class="tf-form-control" @bind="_filter.CategoryId" @bind:after="ApplyFilter">
                <option value="">-- Tất cả loại --</option>
                @foreach (var cat in _categories)
                {
                    <option value="@cat.Id">@cat.Name (@cat.Code)</option>
                }
            </select>
        </div>
        <div>
            <label class="tf-form-label" style="font-size:12px; font-weight:600; margin-bottom:4px;">Thực thể liên kết</label>
            <select class="tf-form-control" @bind="_filter.RelatedEntityType" @bind:after="ApplyFilter">
                <option value="">-- Tất cả đối tượng --</option>
                <option value="General">Tài liệu chung</option>
                <option value="Quotation">Báo giá</option>
                <option value="SalesOrder">Đơn bán hàng</option>
                <option value="Invoice">Hóa đơn</option>
                <option value="Customer">Khách hàng</option>
                <option value="Supplier">Nhà cung cấp</option>
                <option value="Product">Sản phẩm</option>
            </select>
        </div>
        <div>
            <button type="button" class="tf-btn tf-btn-outline-secondary" style="width:100%;" @onclick="ResetFilter">
                Đặt lại bộ lọc
            </button>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_statusMessage))
{
    <div class="tf-alert tf-alert-success tf-mb-3">
        @_statusMessage
        <button type="button" style="float:right; background:none; border:none; cursor:pointer;" @onclick="() => _statusMessage = null">✕</button>
    </div>
}

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="tf-alert tf-alert-danger tf-mb-3">
        @_errorMessage
        <button type="button" style="float:right; background:none; border:none; cursor:pointer;" @onclick="() => _errorMessage = null">✕</button>
    </div>
}

@if (_isLoading)
{
    <div class="tf-loading">Đang tải danh sách tài liệu...</div>
}
else if (!_documents.Any())
{
    <div class="tf-empty-state">
        <div class="tf-empty-icon">📁</div>
        <h3>Không tìm thấy tài liệu nào</h3>
        <p>Hệ thống chưa có tệp tin tài liệu nào phù hợp với bộ lọc hiện tại.</p>
        <button type="button" class="tf-btn tf-btn-primary" style="margin-top:12px;" @onclick="OpenUploadModal">
            + Tải lên tệp tài liệu mới
        </button>
    </div>
}
else
{
    <div class="tf-card">
        <div class="tf-table-responsive">
            <table class="tf-table" style="font-size:13px;">
                <thead>
                    <tr>
                        <th style="width:35px; text-align:center;">#</th>
                        <th>Tên tệp tin</th>
                        <th style="width:150px;">Loại chứng từ</th>
                        <th style="width:140px;">Liên kết</th>
                        <th style="width:90px; text-align:right;">Dung lượng</th>
                        <th style="width:110px;">Người tải</th>
                        <th style="width:120px;">Ngày tải</th>
                        <th>Mô tả / Ghi chú</th>
                        <th style="width:140px; text-align:center;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int idx = 1;
                        foreach (var doc in _documents)
                        {
                            <tr>
                                <td style="text-align:center; color:#64748b;">@idx</td>
                                <td>
                                    <div style="display:flex; align-items:center; gap:8px;">
                                        @GetFileIcon(doc.FileName)
                                        <a href="/api/documents/@doc.Id/download" target="_blank" style="font-weight:600; color:#1d4ed8; text-decoration:none;" title="@doc.FileName">
                                            @doc.FileName
                                        </a>
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(doc.CategoryName))
                                    {
                                        <span class="tf-badge tf-badge-info" style="font-size:11.5px;">@doc.CategoryName</span>
                                    }
                                    else
                                    {
                                        <span style="color:#94a3b8; font-size:12px;">Chung</span>
                                    }
                                </td>
                                <td>
                                    @GetEntityBadge(doc.RelatedEntityType, doc.RelatedEntityId)
                                </td>
                                <td style="text-align:right; color:#475569;">@doc.FormattedFileSize</td>
                                <td style="color:#475569;">@(doc.CreatedBy ?? "—")</td>
                                <td style="color:#475569;">@doc.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td style="color:#64748b; font-size:12px;">@(doc.Description ?? "—")</td>
                                <td style="text-align:center; white-space:nowrap;">
                                    <a href="/api/documents/@doc.Id/preview" target="_blank" class="tf-btn tf-btn-sm tf-btn-outline-primary" style="padding:2px 8px; font-size:11.5px; margin-right:4px;">
                                        Xem
                                    </a>
                                    <a href="/api/documents/@doc.Id/download" class="tf-btn tf-btn-sm tf-btn-outline-secondary" style="padding:2px 8px; font-size:11.5px; margin-right:4px;" download>
                                        Tải
                                    </a>
                                    <AuthorizeView Policy="Permission:Documents:Delete">
                                        <button type="button" class="tf-btn tf-btn-sm tf-btn-outline-danger" style="padding:2px 8px; font-size:11.5px;" @onclick="() => ConfirmDelete(doc.Id, doc.FileName)">
                                            ✕
                                        </button>
                                    </AuthorizeView>
                                </td>
                            </tr>
                            idx++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@* Upload Modal *@
@if (_showUploadModal)
{
    <div style="position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1050; display:flex; align-items:center; justify-content:center;">
        <div style="background:white; padding:24px; border-radius:8px; width:520px; max-width:92%; box-shadow:0 10px 25px rgba(0,0,0,0.2);">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; border-bottom:1px solid #e2e8f0; padding-bottom:12px;">
                <h3 style="margin:0; font-size:17px; font-weight:600; color:#1e293b;">Tải lên tài liệu mới</h3>
                <button type="button" style="background:none; border:none; font-size:18px; cursor:pointer; color:#64748b;" @onclick="CloseUploadModal">✕</button>
            </div>

            @if (!string.IsNullOrEmpty(_uploadError))
            {
                <div class="tf-alert tf-alert-danger tf-mb-3" style="font-size:13px;">@_uploadError</div>
            }

            <div class="tf-form-group tf-mb-3">
                <label class="tf-form-label" style="font-weight:600;">Chọn tệp tin <span style="color:red">*</span></label>
                <InputFile OnChange="HandleFileSelected" class="tf-form-control" accept=".pdf,.docx,.doc,.xlsx,.xls,.png,.jpg,.jpeg" />
                <div style="font-size:11.5px; color:#64748b; margin-top:4px;">
                    Hỗ trợ: PDF, Word (docx, doc), Excel (xlsx, xls), Ảnh (png, jpg, jpeg). Dung lượng tối đa: 20MB.
                </div>
                @if (_selectedFile != null)
                {
                    <div style="margin-top:6px; font-size:12.5px; color:#16a34a; font-weight:500;">
                        ✓ Đã chọn: @_selectedFile.Name (@((_selectedFile.Size / 1024.0).ToString("N0")) KB)
                    </div>
                }
            </div>

            <div class="tf-form-group tf-mb-3">
                <label class="tf-form-label" style="font-weight:600;">Loại chứng từ</label>
                <select class="tf-form-control" @bind="_selectedCategoryId">
                    <option value="">-- Không phân loại (Tài liệu chung) --</option>
                    @foreach (var cat in _categories)
                    {
                        <option value="@cat.Id">@cat.Name (@cat.Code)</option>
                    }
                </select>
            </div>

            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:12px;" class="tf-mb-3">
                <div class="tf-form-group">
                    <label class="tf-form-label" style="font-weight:600;">Đối tượng liên kết</label>
                    <select class="tf-form-control" @bind="_uploadEntityType">
                        <option value="General">Tài liệu chung</option>
                        <option value="Quotation">Báo giá</option>
                        <option value="SalesOrder">Đơn bán hàng</option>
                        <option value="Invoice">Hóa đơn</option>
                        <option value="Customer">Khách hàng</option>
                        <option value="Supplier">Nhà cung cấp</option>
                    </select>
                </div>
                <div class="tf-form-group">
                    <label class="tf-form-label" style="font-weight:600;">ID đối tượng (nếu có)</label>
                    <input type="number" class="tf-form-control" placeholder="Mã ID (số)..." @bind="_uploadEntityId" disabled="@(_uploadEntityType == "General")" />
                </div>
            </div>

            <div class="tf-form-group tf-mb-4">
                <label class="tf-form-label" style="font-weight:600;">Ghi chú / Diễn giải</label>
                <textarea class="tf-form-control" rows="2" placeholder="Ghi chú thêm về nội dung tài liệu..." @bind="_description"></textarea>
            </div>

            <div style="display:flex; justify-content:flex-end; gap:10px; border-top:1px solid #e2e8f0; padding-top:16px;">
                <button type="button" class="tf-btn tf-btn-outline-secondary" @onclick="CloseUploadModal" disabled="@_isUploading">Hủy</button>
                <button type="button" class="tf-btn tf-btn-primary" @onclick="SubmitUpload" disabled="@(_isUploading || _selectedFile == null)">
                    @if (_isUploading)
                    {
                        <span>Đang tải lên...</span>
                    }
                    else
                    {
                        <span>Tải lên ngay</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@* Delete Modal *@
@if (_showDeleteModal)
{
    <div style="position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1050; display:flex; align-items:center; justify-content:center;">
        <div style="background:white; padding:24px; border-radius:8px; width:400px; max-width:90%; box-shadow:0 10px 25px rgba(0,0,0,0.2);">
            <h3 style="margin-top:0; margin-bottom:12px; font-size:17px; color:var(--tf-danger);">Xác nhận xóa tài liệu</h3>
            <p style="margin-bottom:16px; font-size:13.5px; color:#334155;">
                Bạn có chắc chắn muốn xóa tệp <strong>@_deletingFileName</strong> không? Thao tác này không thể hoàn tác.
            </p>
            <div style="display:flex; justify-content:flex-end; gap:10px;">
                <button type="button" class="tf-btn tf-btn-outline-secondary" @onclick="() => _showDeleteModal = false">Hủy</button>
                <button type="button" class="tf-btn tf-btn-danger" @onclick="ExecuteDelete">Xóa</button>
            </div>
        </div>
    </div>
}

@code {
    private List<DocumentAttachmentDto> _documents = new();
    private List<DocumentCategoryDto> _categories = new();
    private DocumentFilterDto _filter = new();
    private string _selectedGroup = "";
    private bool _isLoading = true;
    private string? _statusMessage;
    private string? _errorMessage;

    // Upload state
    private bool _showUploadModal = false;
    private bool _isUploading = false;
    private IBrowserFile? _selectedFile;
    private int? _selectedCategoryId;
    private string _uploadEntityType = "General";
    private int? _uploadEntityId;
    private string? _description;
    private string? _uploadError;

    // Delete state
    private bool _showDeleteModal = false;
    private int _deletingId;
    private string _deletingFileName = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _categories = await DocumentService.GetCategoriesAsync(activeOnly: false);
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = "Lỗi khởi tạo: " + ex.Message;
            _isLoading = false;
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            _isLoading = true;
            _documents = await DocumentService.GetDocumentsAsync(_filter);
        }
        catch (Exception ex)
        {
            _errorMessage = "Lỗi khi tải danh sách tài liệu: " + ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleSearch()
    {
        await LoadDataAsync();
    }

    private async Task ApplyFilter()
    {
        if (Enum.TryParse<DocumentTypeCategory>(_selectedGroup, out var group))
        {
            _filter.Group = group;
        }
        else
        {
            _filter.Group = null;
        }
        await LoadDataAsync();
    }

    private async Task ResetFilter()
    {
        _filter = new DocumentFilterDto();
        _selectedGroup = "";
        await LoadDataAsync();
    }

    private void OpenUploadModal()
    {
        _selectedFile = null;
        _selectedCategoryId = null;
        _uploadEntityType = "General";
        _uploadEntityId = null;
        _description = null;
        _uploadError = null;
        _showUploadModal = true;
    }

    private void CloseUploadModal()
    {
        _showUploadModal = false;
        _selectedFile = null;
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
        _uploadError = null;

        if (_selectedFile != null && _selectedFile.Size > 20 * 1024 * 1024)
        {
            _uploadError = "Dung lượng tệp vượt quá 20MB.";
            _selectedFile = null;
        }
    }

    private async Task SubmitUpload()
    {
        if (_selectedFile == null)
        {
            _uploadError = "Vui lòng chọn tệp tin.";
            return;
        }

        try
        {
            _isUploading = true;
            _uploadError = null;

            using var stream = _selectedFile.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
            await DocumentService.UploadDocumentAsync(
                stream,
                _selectedFile.Name,
                _selectedFile.ContentType,
                _selectedFile.Size,
                _uploadEntityType,
                _uploadEntityType == "General" ? null : _uploadEntityId,
                _selectedCategoryId,
                _description);

            _statusMessage = $"Đã tải lên tệp '{_selectedFile.Name}' thành công.";
            _showUploadModal = false;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _uploadError = "Lỗi tải lên: " + ex.Message;
        }
        finally
        {
            _isUploading = false;
        }
    }

    private void ConfirmDelete(int id, string fileName)
    {
        _deletingId = id;
        _deletingFileName = fileName;
        _showDeleteModal = true;
    }

    private async Task ExecuteDelete()
    {
        try
        {
            var ok = await DocumentService.DeleteDocumentAsync(_deletingId);
            if (ok)
            {
                _statusMessage = $"Đã xóa tài liệu '{_deletingFileName}'.";
                _showDeleteModal = false;
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Lỗi khi xóa: " + ex.Message;
        }
    }

    private RenderFragment GetEntityBadge(string entityType, int? entityId) => __builder =>
    {
        if (string.IsNullOrEmpty(entityType) || entityType == "General" || !entityId.HasValue)
        {
            __builder.OpenElement(0, "span");
            __builder.AddAttribute(1, "class", "tf-badge tf-badge-secondary");
            __builder.AddContent(2, "Chung");
            __builder.CloseElement();
            return;
        }

        string url = entityType switch
        {
            "Quotation" => $"/ban-hang/bao-gia/chi-tiet/{entityId}",
            "SalesOrder" => $"/ban-hang/don-ban-hang/chi-tiet/{entityId}",
            "Invoice" => $"/hoa-don/chi-tiet/{entityId}",
            "Customer" => $"/doi-tac/khach-hang/chinh-sua/{entityId}",
            "Supplier" => $"/doi-tac/nha-cung-cap/chinh-sua/{entityId}",
            _ => ""
        };

        string label = entityType switch
        {
            "Quotation" => $"Báo giá #{entityId}",
            "SalesOrder" => $"Đơn hàng #{entityId}",
            "Invoice" => $"Hóa đơn #{entityId}",
            "Customer" => $"Khách hàng #{entityId}",
            "Supplier" => $"Nhà cung cấp #{entityId}",
            _ => $"{entityType} #{entityId}"
        };

        if (!string.IsNullOrEmpty(url))
        {
            __builder.OpenElement(3, "a");
            __builder.AddAttribute(4, "href", url);
            __builder.AddAttribute(5, "class", "tf-badge tf-badge-primary");
            __builder.AddAttribute(6, "style", "text-decoration:none;");
            __builder.AddContent(7, label);
            __builder.CloseElement();
        }
        else
        {
            __builder.OpenElement(8, "span");
            __builder.AddAttribute(9, "class", "tf-badge tf-badge-primary");
            __builder.AddContent(10, label);
            __builder.CloseElement();
        }
    };

    private RenderFragment GetFileIcon(string fileName) => __builder =>
    {
        var ext = System.IO.Path.GetExtension(fileName).ToLowerInvariant();
        string color = ext switch
        {
            ".pdf" => "#ef4444",
            ".docx" or ".doc" => "#2563eb",
            ".xlsx" or ".xls" => "#16a34a",
            ".png" or ".jpg" or ".jpeg" => "#8b5cf6",
            _ => "#64748b"
        };

        __builder.OpenElement(0, "svg");
        __builder.AddAttribute(1, "width", "16");
        __builder.AddAttribute(2, "height", "16");
        __builder.AddAttribute(3, "viewBox", "0 0 24 24");
        __builder.AddAttribute(4, "fill", "none");
        __builder.AddAttribute(5, "stroke", color);
        __builder.AddAttribute(6, "stroke-width", "2");
        __builder.AddAttribute(7, "stroke-linecap", "round");
        __builder.AddAttribute(8, "stroke-linejoin", "round");
        __builder.OpenElement(9, "path");
        __builder.AddAttribute(10, "d", "M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z");
        __builder.CloseElement();
        __builder.OpenElement(11, "polyline");
        __builder.AddAttribute(12, "points", "14 2 14 8 20 8");
        __builder.CloseElement();
        __builder.CloseElement();
    };
}
