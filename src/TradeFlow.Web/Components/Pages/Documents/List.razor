    }

    private async Task ApplyFilter()
    {
        await LoadDataOnlyAsync();
    }

    private async Task SelectBusinessCategory(string category)
    {
        _filter.BusinessCategory = category;
        await LoadDataOnlyAsync();
    }

    private async Task SelectQuickPeriod(string period)
    {
        _filter.QuickPeriod = period;
        await LoadDataOnlyAsync();
