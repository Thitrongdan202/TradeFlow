            </h3>
            <p style="margin: 0 0 20px 0; font-size: 13px; color: var(--tf-text-secondary, #64748b); text-align: center; line-height: 1.45;">
                Bạn có chắc chắn muốn xóa vĩnh viễn tệp <strong style="color: var(--tf-text-primary, #0f172a);">@_deletingFileName</strong> không? Thao tác này sẽ xóa tệp tin và không thể phục hồi.
            </p>
            <div style="display: flex; gap: 10px; justify-content: center;">
                <button type="button" class="tf-btn tf-btn-secondary" @onclick="() => _showDeleteModal = false" disabled="@_isDeleting">
                    Hủy bỏ
                </button>
                <button type="button" class="tf-btn tf-btn-danger" @onclick="ExecuteDelete" disabled="@_isDeleting">
                    @if (_isDeleting)
                    {
                        <span class="tf-spinner-sm"></span>
                        <span>Đang xóa...</span>
                    }
                    else
                    {
                        <span>Xác nhận xóa</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@* Shared Receipt / Payment Voucher Modal *@
<DebtPaymentModal @bind-IsOpen="_isVoucherModalOpen"
                  PartnerType="_voucherPartnerType"
                  PartnerId="0"
                  OnPaymentRecorded="HandleVoucherRecorded" />

@code {
    // Voucher Modal State
    private bool _isVoucherModalOpen = false;
    private PartnerType _voucherPartnerType = PartnerType.Customer;

    private void OpenVoucherModal(PartnerType partnerType)
    {
        _voucherPartnerType = partnerType;
        _isVoucherModalOpen = true;
    }

    private async Task HandleVoucherRecorded(RecordDebtPaymentResult result)
    {
        _statusMessage = $"Đã lập thành công chứng từ {result.PaymentCode}.";
        await RefreshAllAsync();
    }

    // Document Data State
    private List<DocumentAttachmentDto> _documents = new();
    private List<DocumentCategoryDto> _categories = new();
    private DocumentSummaryKpiDto _kpi = new();
    private DocumentFilterDto _filter = new() { BusinessCategory = "all", QuickPeriod = "all" };
    private bool _isLoading = true;
    private string? _statusMessage;
    private string? _errorMessage;

    // Action Menu State (Single Active Dropdown)
    private int? _activeMenuDocId = null;

    private void ToggleActionMenu(int docId)
    {
        if (_activeMenuDocId == docId)
            _activeMenuDocId = null;
        else
            _activeMenuDocId = docId;
    }

    private void CloseActionMenu()
    {
        _activeMenuDocId = null;
    }

    // Preview Modal State
    private bool _showPreviewModal = false;
    private DocumentAttachmentDto? _previewDoc;
    private DocumentValidationDto? _validationResult;

    // Upload Modal State
    private bool _showUploadModal = false;
    private bool _isUploading = false;
    private IBrowserFile? _selectedFile;
    private int? _selectedCategoryId;
    private string _uploadEntityType = "General";
    private int? _uploadEntityId;
    private string? _description;
    private string? _uploadError;

    // Delete Modal State
    private bool _showDeleteModal = false;
    private bool _isDeleting = false;
    private int _deletingId;
    private string _deletingFileName = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _categories = await DocumentService.GetCategoriesAsync(activeOnly: false);
            await RefreshAllAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = "Lỗi khởi tạo trung tâm chứng từ: " + ex.Message;
            _isLoading = false;
        }
    }

    private async Task RefreshAllAsync()
    {
        try
        {
            _isLoading = true;
            _kpi = await DocumentService.GetDocumentSummaryKpiAsync();
            _documents = await DocumentService.GetDocumentsAsync(_filter);
        }
        catch (Exception ex)
        {
            _errorMessage = "Lỗi khi tải dữ liệu: " + ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

