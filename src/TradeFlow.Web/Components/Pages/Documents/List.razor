    private async Task ResetFilter()
    {
        _filter = new DocumentFilterDto { BusinessCategory = "all", QuickPeriod = "all" };
        await RefreshAllAsync();
    }

    private async Task LoadDataOnlyAsync()
    {
        try
        {
            _isLoading = true;
            _documents = await DocumentService.GetDocumentsAsync(_filter);
        }
        catch (Exception ex)
        {
            _errorMessage = "Lỗi khi lọc tài liệu: " + ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private int GetCount(string key)
    {
        if (_kpi.BusinessGroupCounts.TryGetValue(key, out var count))
            return count;
        return 0;
    }

    // In-Modal Preview Management
    private async Task OpenPreviewModal(DocumentAttachmentDto doc)
    {
        _previewDoc = doc;
        _activeMenuDocId = null;
        _showPreviewModal = true;
        _validationResult = new DocumentValidationDto
        {
            Status = DocumentPreviewStatus.Loading,
            FormattedFileSize = doc.FormattedFileSize
        };

        try
        {
            await JS.InvokeVoidAsync("TradeFlowMotion.lockScroll");
        }
        catch { }

        StateHasChanged();

        try
        {
            _validationResult = await DocumentService.ValidateDocumentForPreviewAsync(doc.Id);
        }
        catch (Exception ex)
        {
            _validationResult = new DocumentValidationDto
            {
                Status = DocumentPreviewStatus.FileNotFound,
                Message = "Không thể kiểm tra tệp tin",
                Details = ex.Message,
                CanDownload = false
            };
        }

        StateHasChanged();
    }

    private async Task ClosePreviewModal()
    {
        _showPreviewModal = false;
        _previewDoc = null;
        _validationResult = null;

        try
        {
            await JS.InvokeVoidAsync("TradeFlowMotion.unlockScroll");
        }
        catch { }
    }

    private async Task HandleModalKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            if (_showPreviewModal)
            {
                await ClosePreviewModal();
            }
            if (_activeMenuDocId.HasValue)
            {
                CloseActionMenu();
            }
        }
    }

    // Upload
    private void OpenUploadModal()
    {
        _selectedFile = null;
        _selectedCategoryId = null;
        _uploadEntityType = "General";
        _uploadEntityId = null;
        _description = null;
        _uploadError = null;
        _showUploadModal = true;
    }

    private void CloseUploadModal()
    {
        _showUploadModal = false;
        _selectedFile = null;
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
        _uploadError = null;

        if (_selectedFile != null && _selectedFile.Size > 20 * 1024 * 1024)
        {
            _uploadError = "Dung lượng tệp vượt quá giới hạn 20MB.";
            _selectedFile = null;
        }
    }

    private async Task SubmitUpload()
    {
        if (_selectedFile == null)
        {
            _uploadError = "Vui lòng chọn một tệp tin.";
            return;
        }

        try
        {
            _isUploading = true;
            _uploadError = null;

            using var stream = _selectedFile.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
            await DocumentService.UploadDocumentAsync(
                stream,
                _selectedFile.Name,
                _selectedFile.ContentType,
                _selectedFile.Size,
                _uploadEntityType,
                _uploadEntityType == "General" ? null : _uploadEntityId,
                _selectedCategoryId,
                _description);

            _statusMessage = $"Đã tải lên tệp '{_selectedFile.Name}' thành công.";
            _showUploadModal = false;
            await RefreshAllAsync();
        }
        catch (Exception ex)
        {
            _uploadError = "Lỗi tải lên: " + ex.Message;
        }
        finally
        {
            _isUploading = false;
        }
    }

    // Delete
    private void ConfirmDelete(int id, string fileName)
    {
        _deletingId = id;
        _deletingFileName = fileName;
        _showDeleteModal = true;
    }

    private async Task ExecuteDelete()
    {
        _isDeleting = true;
        try
        {
            var ok = await DocumentService.DeleteDocumentAsync(_deletingId);
            if (ok)
            {
                _statusMessage = $"Đã xóa tài liệu '{_deletingFileName}'.";
                _showDeleteModal = false;
                await RefreshAllAsync();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Lỗi khi xóa: " + ex.Message;
        }
        finally
        {
            _isDeleting = false;
        }
    }

