@page "/tai-lieu"
@page "/chung-tu"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Application.Common.Models.Documents
@using TradeFlow.Application.Common.Models.Partners
@using TradeFlow.Domain.Enums
@using TradeFlow.Web.Components.Pages.Partners.Components
@inject IDocumentService DocumentService
@inject NavigationManager Nav
@inject IJSRuntime JS
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Permission:Documents:View")]

<PageTitle>Hồ sơ & Chứng từ | TradeFlow ERP</PageTitle>

@* Level 0: Enterprise Page Header *@
<div class="tf-doc-header">
    <div class="tf-doc-header-content">
        <h1 class="tf-doc-title">
            <span class="tf-doc-title-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                    <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
            </span>
            Hồ sơ & Chứng từ
        </h1>
        <p class="tf-doc-subtitle">Trung tâm quản lý, tra cứu và liên kết tài liệu nghiệp vụ trong TradeFlow.</p>
    </div>

    <div class="tf-doc-header-actions">
        <a href="/hop-dong" class="tf-btn tf-btn-outline-primary" title="Xem danh sách hợp đồng">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:6px;">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
            </svg>
            Hợp đồng đã tạo
        </a>

        <a href="/tai-lieu/danh-muc" class="tf-btn tf-btn-outline-secondary" title="Quản lý danh mục loại chứng từ">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:6px;">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
            </svg>
            Danh mục chứng từ
        </a>

        <AuthorizeView Policy="Permission:Customers:Edit">
            <button type="button" class="tf-btn tf-btn-outline-primary" @onclick="() => OpenVoucherModal(PartnerType.Customer)" title="Lập phiếu thu tiền khách hàng">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:4px;">
                    <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                </svg>
                <span>Lập phiếu thu</span>
            </button>
        </AuthorizeView>

        <AuthorizeView Policy="Permission:Suppliers:Edit">
            <button type="button" class="tf-btn tf-btn-outline-secondary" @onclick="() => OpenVoucherModal(PartnerType.Supplier)" title="Lập phiếu chi tiền nhà cung cấp">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:4px;">
                    <rect x="2" y="5" width="20" height="14" rx="2"/>
                    <line x1="2" y1="10" x2="22" y2="10"/>
                </svg>
                <span>Lập phiếu chi</span>
            </button>
        </AuthorizeView>

        <AuthorizeView Policy="Permission:Documents:Create">
            <button type="button" class="tf-btn tf-btn-primary" @onclick="OpenUploadModal" title="Tải lên tệp chứng từ mới">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:6px;">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                Tải lên tài liệu
            </button>
        </AuthorizeView>
    </div>
</div>

@* Level 1: Summary KPI Metrics Grid (Real Aggregated Data) *@
<div class="tf-doc-kpi-grid">
    <div class="tf-doc-kpi-card @(_filter.BusinessCategory == "all" ? "active" : "")" @onclick="@(() => SelectBusinessCategory("all"))" title="Nhấn để xem tất cả">
        <div class="tf-doc-kpi-icon-wrap tf-doc-kpi-icon-blue">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
            </svg>
        </div>
        <div class="tf-doc-kpi-info">
            <span class="tf-doc-kpi-label">Tổng số tài liệu</span>
            <span class="tf-doc-kpi-value">@_kpi.TotalDocuments</span>
            <span class="tf-doc-kpi-sub">Lưu trữ trên hệ thống</span>
        </div>
    </div>

    <div class="tf-doc-kpi-card @(_filter.BusinessCategory == "linked" ? "active" : "")" @onclick="@(() => SelectBusinessCategory("linked"))" title="Nhấn để xem tài liệu đã liên kết nghiệp vụ">
        <div class="tf-doc-kpi-icon-wrap tf-doc-kpi-icon-green">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
            </svg>
        </div>
        <div class="tf-doc-kpi-info">
            <span class="tf-doc-kpi-label">Liên kết nghiệp vụ</span>
            <span class="tf-doc-kpi-value">@_kpi.LinkedDocuments</span>
            <span class="tf-doc-kpi-sub">Gắn kèm thực thể kinh doanh</span>
        </div>
    </div>

    <div class="tf-doc-kpi-card @(_filter.BusinessCategory == "unlinked" ? "active" : "")" @onclick="@(() => SelectBusinessCategory("unlinked"))" title="Nhấn để xem tài liệu chưa liên kết">
        <div class="tf-doc-kpi-icon-wrap tf-doc-kpi-icon-amber">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
        </div>
        <div class="tf-doc-kpi-info">
            <span class="tf-doc-kpi-label">Chưa liên kết / Chung</span>
            <span class="tf-doc-kpi-value">@_kpi.UnlinkedDocuments</span>
            <span class="tf-doc-kpi-sub">Tài liệu tự do & lưu trữ chung</span>
        </div>
    </div>

    <div class="tf-doc-kpi-card @(_filter.QuickPeriod == "30d" ? "active" : "")" @onclick="@(() => SelectQuickPeriod("30d"))" title="Nhấn để lọc tài liệu 30 ngày qua">
        <div class="tf-doc-kpi-icon-wrap tf-doc-kpi-icon-purple">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
        </div>
        <div class="tf-doc-kpi-info">
            <span class="tf-doc-kpi-label">Mới tải lên</span>
            <span class="tf-doc-kpi-value">@_kpi.RecentUploads</span>
            <span class="tf-doc-kpi-sub">Trong 30 ngày qua</span>
        </div>
    </div>
</div>

@* Level 2: Business Category Navigation Pills Bar *@
<div class="tf-doc-nav-bar">
    <button type="button" class="tf-doc-nav-pill @(_filter.BusinessCategory == "all" ? "active" : "")" @onclick="@(() => SelectBusinessCategory("all"))">
        <span>Tất cả</span>
        <span class="tf-doc-nav-badge">@GetCount("all")</span>
    </button>
    <button type="button" class="tf-doc-nav-pill @(_filter.BusinessCategory == "contracts" ? "active" : "")" @onclick="@(() => SelectBusinessCategory("contracts"))">
        <span>Hợp đồng & Pháp lý</span>
        <span class="tf-doc-nav-badge">@GetCount("contracts")</span>
    </button>
    <button type="button" class="tf-doc-nav-pill @(_filter.BusinessCategory == "invoices" ? "active" : "")" @onclick="@(() => SelectBusinessCategory("invoices"))">
        <span>Hóa đơn & Kế toán</span>
        <span class="tf-doc-nav-badge">@GetCount("invoices")</span>
    </button>
    <button type="button" class="tf-doc-nav-pill @(_filter.BusinessCategory == "hr" ? "active" : "")" @onclick="@(() => SelectBusinessCategory("hr"))">
        <span>Hồ sơ nhân sự</span>
        <span class="tf-doc-nav-badge">@GetCount("hr")</span>
    </button>
    <button type="button" class="tf-doc-nav-pill @(_filter.BusinessCategory == "warehouse" ? "active" : "")" @onclick="@(() => SelectBusinessCategory("warehouse"))">
        <span>Kho bãi & Vận hành</span>
        <span class="tf-doc-nav-badge">@GetCount("warehouse")</span>
    </button>
    <button type="button" class="tf-doc-nav-pill @(_filter.BusinessCategory == "commercial" ? "active" : "")" @onclick="@(() => SelectBusinessCategory("commercial"))">
        <span>Báo giá & Đơn hàng</span>
        <span class="tf-doc-nav-badge">@GetCount("commercial")</span>
    </button>
    <button type="button" class="tf-doc-nav-pill @(_filter.BusinessCategory == "technical" ? "active" : "")" @onclick="@(() => SelectBusinessCategory("technical"))">
        <span>Kỹ thuật & CO/CQ</span>
        <span class="tf-doc-nav-badge">@GetCount("technical")</span>
    </button>
    <button type="button" class="tf-doc-nav-pill @(_filter.BusinessCategory == "unlinked" ? "active" : "")" @onclick="@(() => SelectBusinessCategory("unlinked"))">
        <span>Chưa liên kết</span>
        <span class="tf-doc-nav-badge">@GetCount("unlinked")</span>
    </button>
</div>

@* Level 3: Search & Filter Toolbar *@
<div class="tf-doc-toolbar">
    <div class="tf-doc-form-group">
        <label class="tf-doc-label">Tìm kiếm tài liệu</label>
        <input type="text" class="tf-doc-input" placeholder="Tên tệp tin, mô tả, từ khóa..." @bind="_filter.SearchTerm" @bind:event="oninput" @onkeyup="HandleSearch" />
    </div>

    <div class="tf-doc-form-group">
        <label class="tf-doc-label">Thời gian tải</label>
        <select class="tf-doc-select" @bind="_filter.QuickPeriod" @bind:after="ApplyFilter">
            <option value="all">Tất cả thời gian</option>
            <option value="today">Hôm nay</option>
            <option value="7d">7 ngày qua</option>
            <option value="30d">30 ngày qua</option>
            <option value="this_month">Tháng này</option>
        </select>
    </div>

    <div class="tf-doc-form-group">
        <label class="tf-doc-label">Loại chứng từ cụ thể</label>
        <select class="tf-doc-select" @bind="_filter.CategoryId" @bind:after="ApplyFilter">
            <option value="">-- Tất cả loại --</option>
            @foreach (var cat in _categories)
            {
                <option value="@cat.Id">@cat.Name (@cat.Code)</option>
            }
        </select>
    </div>

    <div class="tf-doc-form-group">
        <label class="tf-doc-label">Thực thể liên kết</label>
        <select class="tf-doc-select" @bind="_filter.RelatedEntityType" @bind:after="ApplyFilter">
            <option value="">-- Tất cả đối tượng --</option>
            <option value="General">Tài liệu chung (Chưa gắn)</option>
            <option value="Contract">Hợp đồng thương mại</option>
            <option value="SalesOrder">Đơn bán hàng</option>
            <option value="Quotation">Báo giá</option>
            <option value="Invoice">Hóa đơn</option>
            <option value="Customer">Khách hàng</option>
            <option value="Supplier">Nhà cung cấp</option>
            <option value="Employee">Hồ sơ nhân viên</option>
            <option value="EmployeeRequest">Yêu cầu nhân sự</option>
            <option value="WarehouseVoucher">Phiếu kho</option>
        </select>
    </div>

    <div class="tf-doc-form-group">
        <label class="tf-doc-label">&nbsp;</label>
        <button type="button" class="tf-doc-btn-reset" @onclick="ResetFilter" title="Xóa toàn bộ bộ lọc và đặt lại ban đầu">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
                <path d="M3 3v5h5"/>
            </svg>
            Đặt lại
        </button>
    </div>
</div>

@* Status & Error Alerts *@
@if (!string.IsNullOrEmpty(_statusMessage))
{
    <div class="tf-alert tf-alert-success tf-mb-3">
        <span>@_statusMessage</span>
        <button type="button" style="float:right; background:none; border:none; cursor:pointer;" @onclick="() => _statusMessage = null">✕</button>
    </div>
}

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="tf-alert tf-alert-danger tf-mb-3">
        <span>@_errorMessage</span>
        <button type="button" style="float:right; background:none; border:none; cursor:pointer;" @onclick="() => _errorMessage = null">✕</button>
    </div>
}

@* Level 4: Document List Table *@
@if (_isLoading)
{
    <div class="tf-doc-table-card" style="padding: 24px;">
        <Skeleton Type="table" Rows="6" Columns="9" />
    </div>
}
else if (!_documents.Any())
{
    <div class="tf-doc-table-card tf-doc-empty-state">
        <div class="tf-doc-empty-icon">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
            </svg>
        </div>
        <h3 class="tf-doc-empty-title">Không tìm thấy tài liệu phù hợp</h3>
        <p class="tf-doc-empty-desc">Không có tệp tin nào khớp với tiêu chí tìm kiếm hoặc phân nhóm hiện tại. Bạn có thể thay đổi bộ lọc hoặc tải lên tài liệu mới.</p>
        <button type="button" class="tf-btn tf-btn-primary" @onclick="OpenUploadModal">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:6px;">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Tải lên tài liệu ngay
        </button>
    </div>
}
else
{
    <div class="tf-doc-table-card">
        <div class="tf-doc-table-responsive">
            <table class="tf-doc-table">
                <thead>
                    <tr>
                        <th style="width: 40px; text-align: center;">#</th>
                        <th>Tên tệp tin</th>
                        <th style="width: 150px;">Loại chứng từ</th>
                        <th style="width: 220px;">Thực thể liên kết</th>
                        <th style="width: 95px; text-align: right;">Dung lượng</th>
                        <th style="width: 120px;">Người tải</th>
                        <th style="width: 130px;">Ngày tải</th>
                        <th>Mô tả / Diễn giải</th>
                        <th style="width: 140px; text-align: center;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int idx = 1;
                        foreach (var doc in _documents)
                        {
                            <tr>
                                <td style="text-align: center; color: var(--tf-text-muted, #94a3b8); font-weight: 500;">@idx</td>
                                <td>
                                    <div class="tf-doc-file-cell">
                                        <div class="tf-doc-file-icon-box @GetFileExtClass(doc.FileName)">
                                            @GetMimeIcon(doc.FileName)
                                        </div>
                                        <div class="tf-doc-file-title-wrap">
                                            <a href="javascript:void(0)" class="tf-doc-file-name" @onclick="() => OpenPreviewModal(doc)" title="Nhấn để xem trước tài liệu: @doc.FileName">
                                                @doc.FileName
                                            </a>
                                            <span class="tf-doc-file-ext-badge">@System.IO.Path.GetExtension(doc.FileName).TrimStart('.').ToUpperInvariant()</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(doc.CategoryName))
                                    {
                                        <span class="tf-doc-cat-badge">@doc.CategoryName</span>
                                    }
                                    else
                                    {
                                        <span class="tf-doc-entity-unlinked">Tài liệu chung</span>
                                    }
                                </td>
                                <td>
                                    @GetRelatedEntityMarkup(doc)
                                </td>
                                <td style="text-align: right; font-family: monospace; font-size: 12px; color: var(--tf-text-secondary, #475569);">
                                    @doc.FormattedFileSize
                                </td>
                                <td>
                                    <span style="font-size: 12.5px; color: var(--tf-text-primary, #1e293b); font-weight: 500;">
                                        @(doc.CreatedBy ?? "Hệ thống")
                                    </span>
                                </td>
                                <td>
                                    <span style="font-size: 12px; color: var(--tf-text-secondary, #475569);">
                                        @doc.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                </td>
                                <td>
                                    <span style="font-size: 12px; color: var(--tf-text-muted, #64748b);" title="@doc.Description">
                                        @(string.IsNullOrWhiteSpace(doc.Description) ? "—" : (doc.Description.Length > 40 ? doc.Description.Substring(0, 40) + "..." : doc.Description))
                                    </span>
                                </td>
                                <td style="text-align: center; position: relative;">
                                    @* Redesigned Action Button Group *@
                                    <div class="tf-doc-action-group">
                                        <!-- Primary: Preview (Eye) -->
                                        <button type="button" class="tf-act-btn tf-act-preview" @onclick="() => OpenPreviewModal(doc)" title="Xem trước tài liệu" aria-label="Xem trước">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                                <circle cx="12" cy="12" r="3"></circle>
                                            </svg>
                                        </button>

                                        <!-- Secondary: Download -->
                                        <a href="/api/documents/@doc.Id/download" class="tf-act-btn tf-act-download" title="Tải xuống tài liệu" aria-label="Tải xuống" download>
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                                <polyline points="7 10 12 15 17 10"></polyline>
                                                <line x1="12" y1="15" x2="12" y2="3"></line>
                                            </svg>
                                        </a>

                                        <!-- More: Ellipsis Dropdown Trigger -->
                                        <div class="tf-act-more-wrap">
                                            <button type="button" class="tf-act-btn tf-act-more @(_activeMenuDocId == doc.Id ? "active" : "")" @onclick="() => ToggleActionMenu(doc.Id)" title="Thao tác khác" aria-label="Thao tác khác">
                                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <circle cx="12" cy="12" r="1.5"></circle>
                                                    <circle cx="19" cy="12" r="1.5"></circle>
                                                    <circle cx="5" cy="12" r="1.5"></circle>
                                                </svg>
                                            </button>

                                            @if (_activeMenuDocId == doc.Id)
                                            {
                                                <div class="tf-act-dropdown-backdrop" @onclick="CloseActionMenu"></div>
                                                <div class="tf-act-menu @(idx > _documents.Count - 2 ? "menu-upwards" : "")" @onclick:stopPropagation="true">
                                                    <button type="button" class="tf-act-menu-item" @onclick="async () => { CloseActionMenu(); await OpenPreviewModal(doc); }">
                                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                                            <circle cx="12" cy="12" r="3"></circle>
                                                        </svg>
                                                        <span>Xem chi tiết</span>
                                                    </button>

                                                    <a href="/api/documents/@doc.Id/preview" target="_blank" class="tf-act-menu-item" @onclick="CloseActionMenu">
                                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                                                            <polyline points="15 3 21 3 21 9"></polyline>
                                                            <line x1="10" y1="14" x2="21" y2="3"></line>
                                                        </svg>
                                                        <span>Mở tab mới</span>
                                                    </a>

                                                    <a href="/api/documents/@doc.Id/download" class="tf-act-menu-item" @onclick="CloseActionMenu" download>
                                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                                            <polyline points="7 10 12 15 17 10"></polyline>
                                                            <line x1="12" y1="15" x2="12" y2="3"></line>
                                                        </svg>
                                                        <span>Tải tệp tin</span>
                                                    </a>

                                                    <AuthorizeView Policy="Permission:Documents:Delete">
                                                        <div class="tf-act-menu-divider"></div>
                                                        <button type="button" class="tf-act-menu-item danger" @onclick="() => { CloseActionMenu(); ConfirmDelete(doc.Id, doc.FileName); }">
                                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                                <polyline points="3 6 5 6 21 6"></polyline>
                                                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                                            </svg>
                                                            <span>Xóa tài liệu</span>
                                                        </button>
                                                    </AuthorizeView>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            idx++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@* ============================================================
   DOCUMENT PREVIEW MODAL — FULL VIEWPORT CENTERED POPUP
   ============================================================ *@
@if (_showPreviewModal && _previewDoc != null)
{
    <div class="tf-modal-backdrop" @onclick="ClosePreviewModal" @onkeydown="HandleModalKeyDown" tabindex="-1">
        <div class="tf-preview-modal-dialog" @onclick:stopPropagation="true">
            @* Modal Header *@
            <div class="tf-preview-modal-header">
                <div class="tf-preview-header-left">
                    <div class="tf-doc-file-icon-box @GetFileExtClass(_previewDoc.FileName)">
                        @GetMimeIcon(_previewDoc.FileName)
                    </div>
                    <div style="min-width: 0;">
                        <h3 class="tf-preview-title" title="@_previewDoc.FileName">
                            @_previewDoc.FileName
                        </h3>
                        <div class="tf-preview-subtitle">
                            @if (!string.IsNullOrEmpty(_previewDoc.CategoryName))
                            {
                                <span class="tf-doc-cat-badge">@_previewDoc.CategoryName</span>
                            }
                            <span>@(_validationResult?.FormattedFileSize ?? _previewDoc.FormattedFileSize)</span>
                            <span>•</span>
                            <span>Tải lên: @_previewDoc.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                            @if (!string.IsNullOrEmpty(_previewDoc.CreatedBy))
                            {
                                <span>• Bởi: @_previewDoc.CreatedBy</span>
                            }
                        </div>
                    </div>
                </div>
                <button type="button" class="tf-act-btn" @onclick="ClosePreviewModal" aria-label="Đóng popup xem trước" title="Đóng (Esc)">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            @* Modal Body with 4 Preview States *@
            <div class="tf-preview-modal-body">
                @if (_validationResult == null || _validationResult.Status == DocumentPreviewStatus.Loading)
                {
                    @* State 1: Loading *@
                    <div class="tf-preview-state-box">
                        <span class="tf-spinner-sm" style="width: 28px; height: 28px; border-width: 3px;"></span>
                        <div class="tf-preview-state-title">Đang kiểm tra và tải tài liệu...</div>
                        <div class="tf-preview-state-desc">Hệ thống đang xác thực tính toàn vẹn của tệp tin và chuẩn bị viewer hiển thị.</div>
                    </div>
                }
                else if (_validationResult.Status == DocumentPreviewStatus.InvalidPlaceholder)
                {
                    @* State 2: Invalid Demo Placeholder Warning *@
                    <div class="tf-preview-state-box">
                        <div class="tf-preview-state-icon warning">
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                <line x1="12" y1="9" x2="12" y2="13"></line>
                                <line x1="12" y1="17" x2="12.01" y2="17"></line>
                            </svg>
                        </div>
                        <h4 class="tf-preview-state-title">Tài liệu mẫu chưa có nội dung xem trước hợp lệ</h4>
                        <p class="tf-preview-state-desc">
                            @_validationResult.Details
                        </p>
                        <p class="tf-preview-state-desc" style="font-size: 12px; color: var(--tf-text-muted);">
                            Hệ thống đã nhận diện tệp tin mẫu dạng văn bản thuần không có cấu trúc nhị phân để render trực tiếp. Bạn vẫn có thể tải tệp gốc về máy để kiểm tra dữ liệu mẫu bên trong.
                        </p>
                        @if (_validationResult.CanDownload)
                        {
                            <a href="/api/documents/@_previewDoc.Id/download" class="tf-btn tf-btn-primary" download style="margin-top: 8px;">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 6px;">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                    <polyline points="7 10 12 15 17 10"></polyline>
                                    <line x1="12" y1="15" x2="12" y2="3"></line>
                                </svg>
                                Tải tệp tin về máy
                            </a>
                        }
                    </div>
                }
                else if (_validationResult.Status == DocumentPreviewStatus.FileNotFound)
                {
                    @* State 3: Missing File / Storage Error *@
                    <div class="tf-preview-state-box">
                        <div class="tf-preview-state-icon danger">
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="12" y1="8" x2="12" y2="12"></line>
                                <line x1="12" y1="16" x2="12.01" y2="16"></line>
                            </svg>
                        </div>
                        <h4 class="tf-preview-state-title">@_validationResult.Message</h4>
                        <p class="tf-preview-state-desc">@_validationResult.Details</p>
                    </div>
                }
                else if (_validationResult.Status == DocumentPreviewStatus.UnsupportedFormat)
                {
                    @* State 4: Unsupported Format *@
                    <div class="tf-preview-state-box">
                        <div class="tf-preview-state-icon info">
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                <polyline points="14 2 14 8 20 8"></polyline>
                            </svg>
                        </div>
                        <h4 class="tf-preview-state-title">@_validationResult.Message</h4>
                        <p class="tf-preview-state-desc">@_validationResult.Details</p>
                        @if (_validationResult.CanDownload)
                        {
                            <a href="/api/documents/@_previewDoc.Id/download" class="tf-btn tf-btn-primary" download style="margin-top: 8px;">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 6px;">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                    <polyline points="7 10 12 15 17 10"></polyline>
                                    <line x1="12" y1="15" x2="12" y2="3"></line>
                                </svg>
                                Tải tệp tin về máy
                            </a>
                        }
                    </div>
                }
                else
                {
                    @* State 5: Success — Valid PDF or Valid Image *@
                    <div class="tf-preview-frame-container">
                        @{
                            var ext = System.IO.Path.GetExtension(_previewDoc.FileName).ToLowerInvariant();
                            if (ext == ".pdf")
                            {
                                <iframe src="/api/documents/@_previewDoc.Id/preview#view=FitH" class="tf-preview-iframe" title="@_previewDoc.FileName"></iframe>
                            }
                            else if (ext is ".png" or ".jpg" or ".jpeg" or ".webp")
                            {
                                <div class="tf-preview-image-wrap">
                                    <img src="/api/documents/@_previewDoc.Id/preview" alt="@_previewDoc.FileName" class="tf-preview-image" />
                                </div>
                            }
                        }
                    </div>
                }

                @* Metadata Panel (Always Visible for Complete Auditability) *@
                <div class="tf-preview-metadata-panel">
                    <div class="tf-preview-meta-item">
                        <span class="tf-preview-meta-label">Loại chứng từ</span>
                        <span class="tf-preview-meta-val">@(_previewDoc.CategoryName ?? "Tài liệu chung")</span>
                    </div>

                    <div class="tf-preview-meta-item">
                        <span class="tf-preview-meta-label">Thực thể liên kết</span>
                        <span class="tf-preview-meta-val">
                            @if (!string.IsNullOrEmpty(_previewDoc.RelatedEntityTitle))
                            {
                                <span>@_previewDoc.RelatedEntityTitle</span>
                            }
                            else
                            {
                                <span style="color: var(--tf-text-muted);">Chưa liên kết</span>
                            }
                        </span>
                    </div>

                    <div class="tf-preview-meta-item">
                        <span class="tf-preview-meta-label">Người tải lên</span>
                        <span class="tf-preview-meta-val">@(_previewDoc.CreatedBy ?? "Hệ thống")</span>
                    </div>

                    <div class="tf-preview-meta-item">
                        <span class="tf-preview-meta-label">Dung lượng thực</span>
                        <span class="tf-preview-meta-val">@(_validationResult?.FormattedFileSize ?? _previewDoc.FormattedFileSize)</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_previewDoc.Description))
                    {
                        <div class="tf-preview-meta-item" style="grid-column: 1 / -1;">
                            <span class="tf-preview-meta-label">Ghi chú & Diễn giải</span>
                            <span class="tf-preview-meta-val" style="font-weight: 400; line-height: 1.4;">@_previewDoc.Description</span>
                        </div>
                    }
                </div>
            </div>

            @* Modal Footer *@
            <div class="tf-preview-modal-footer">
                <button type="button" class="tf-btn tf-btn-secondary" @onclick="ClosePreviewModal">
                    Đóng (Esc)
                </button>
                <div style="display: flex; gap: 8px;">
                    @if (_validationResult?.Status == DocumentPreviewStatus.Valid)
                    {
                        <a href="/api/documents/@_previewDoc.Id/preview" target="_blank" class="tf-btn tf-btn-outline-primary" title="Mở tệp tin trong tab trình duyệt riêng">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 4px;">
                                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                                <polyline points="15 3 21 3 21 9"></polyline>
                                <line x1="10" y1="14" x2="21" y2="3"></line>
                            </svg>
                            Mở tab mới
                        </a>
                    }
                    <a href="/api/documents/@_previewDoc.Id/download" class="tf-btn tf-btn-primary" download>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 4px;">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                            <polyline points="7 10 12 15 17 10"></polyline>
                            <line x1="12" y1="15" x2="12" y2="3"></line>
                        </svg>
                        Tải tài liệu
                    </a>
                </div>
            </div>
        </div>
    </div>
}

@* Refactored Modern Upload Modal *@
@if (_showUploadModal)
{
    <div class="tf-modal-backdrop" @onclick="CloseUploadModal" tabindex="-1">
        <div class="tf-upload-dialog" @onclick:stopPropagation="true">
            <div class="tf-modal-header">
                <div style="display: flex; align-items: center; gap: 10px;">
                    <div style="width: 38px; height: 38px; border-radius: 8px; background: rgba(37, 99, 235, 0.1); color: #2563eb; display: flex; align-items: center; justify-content: center;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                            <polyline points="17 8 12 3 7 8"></polyline>
                            <line x1="12" y1="3" x2="12" y2="15"></line>
                        </svg>
                    </div>
                    <div>
                        <h3 class="tf-modal-title" style="font-size: 16px; margin: 0;">Tải lên tài liệu mới</h3>
                        <p style="margin: 2px 0 0 0; font-size: 12px; color: var(--tf-text-secondary, #64748b);">Thêm tệp tin lưu trữ và liên kết với đối tượng nghiệp vụ</p>
                    </div>
                </div>
                <button type="button" class="tf-act-btn" @onclick="CloseUploadModal" aria-label="Đóng">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            <div class="tf-modal-body" style="padding: 20px; overflow-y: auto; overscroll-behavior: contain; display: flex; flex-direction: column; gap: 14px;">
                @if (!string.IsNullOrEmpty(_uploadError))
                {
                    <div class="tf-alert tf-alert-danger" style="font-size: 13px;">
                        @_uploadError
                    </div>
                }

                @* Dropzone File Selector *@
                <div class="tf-upload-dropzone">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="var(--tf-primary, #2563eb)" stroke-width="1.8" style="margin-bottom: 8px;">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="12" y1="18" x2="12" y2="12"></line>
                        <polyline points="9 15 12 12 15 15"></polyline>
                    </svg>
                    <div style="font-size: 13.5px; font-weight: 600; color: var(--tf-text-primary, #0f172a); margin-bottom: 4px;">
                        Chọn tệp tin từ máy tính
                    </div>
                    <div style="font-size: 11.5px; color: var(--tf-text-secondary, #64748b); margin-bottom: 12px;">
                        Hỗ trợ PDF, Word (docx), Excel (xlsx), Ảnh (png, jpg). Tối đa 20MB.
                    </div>
                    <InputFile OnChange="HandleFileSelected" class="tf-doc-input" accept=".pdf,.docx,.doc,.xlsx,.xls,.png,.jpg,.jpeg" style="max-width: 320px; margin: 0 auto;" />
                    @if (_selectedFile != null)
                    {
                        <div style="margin-top: 10px; font-size: 12.5px; color: #16a34a; font-weight: 600; background: rgba(22, 163, 74, 0.1); padding: 6px 12px; border-radius: 6px; display: inline-block;">
                            ✓ Đã chọn: @_selectedFile.Name (@((_selectedFile.Size / 1024.0).ToString("N0")) KB)
                        </div>
                    }
                </div>

                <div class="tf-form-group">
                    <label class="tf-doc-label">Loại chứng từ phân loại:</label>
                    <select class="tf-doc-select" @bind="_selectedCategoryId">
                        <option value="">-- Không phân loại (Tài liệu chung) --</option>
                        @foreach (var cat in _categories)
                        {
                            <option value="@cat.Id">@cat.Name (@cat.Code)</option>
                        }
                    </select>
                </div>

                <div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 12px;">
                    <div class="tf-form-group">
                        <label class="tf-doc-label">Đối tượng liên kết:</label>
                        <select class="tf-doc-select" @bind="_uploadEntityType">
                            <option value="General">Tài liệu chung (Chưa gắn)</option>
                            <option value="Contract">Hợp đồng thương mại</option>
                            <option value="SalesOrder">Đơn bán hàng</option>
                            <option value="Quotation">Báo giá</option>
                            <option value="Invoice">Hóa đơn</option>
                            <option value="Customer">Khách hàng</option>
                            <option value="Supplier">Nhà cung cấp</option>
                            <option value="Employee">Hồ sơ nhân viên</option>
                            <option value="EmployeeRequest">Yêu cầu nhân sự</option>
                            <option value="WarehouseVoucher">Phiếu kho</option>
                        </select>
                    </div>
                    <div class="tf-form-group">
                        <label class="tf-doc-label">Mã ID thực thể:</label>
                        <input type="number" class="tf-doc-input" placeholder="Nhập số ID..." @bind="_uploadEntityId" disabled="@(_uploadEntityType == "General")" />
                    </div>
                </div>

                <div class="tf-form-group">
                    <label class="tf-doc-label">Ghi chú / Diễn giải bổ sung:</label>
                    <textarea class="tf-doc-input" rows="2" style="height: auto; resize: vertical;" placeholder="Nhập ghi chú đối soát, số hợp đồng gốc hoặc nội dung tài liệu..." @bind="_description"></textarea>
                </div>
            </div>

            <div class="tf-modal-footer" style="padding: 14px 20px; display: flex; justify-content: flex-end; gap: 10px; border-top: 1px solid var(--tf-border, #e2e8f0);">
                <button type="button" class="tf-btn tf-btn-secondary" @onclick="CloseUploadModal" disabled="@_isUploading">
                    Hủy bỏ
                </button>
                <button type="button" class="tf-btn tf-btn-primary" @onclick="SubmitUpload" disabled="@(_selectedFile == null || _isUploading)">
                    @if (_isUploading)
                    {
                        <span class="tf-spinner-sm"></span>
                        <span>Đang tải lên...</span>
                    }
                    else
                    {
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 4px;">
                            <polyline points="17 8 12 3 7 8"></polyline>
                            <line x1="12" y1="3" x2="12" y2="15"></line>
                        </svg>
                        <span>Tải lên ngay</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@* Refactored Modern Delete Confirmation Modal *@
@if (_showDeleteModal)
{
    <div class="tf-modal-backdrop" @onclick="() => _showDeleteModal = false" tabindex="-1">
        <div class="tf-modal-dialog" style="max-width: 420px; background: var(--tf-bg-card, #ffffff); border: 1px solid var(--tf-border, #cbd5e1); border-radius: 12px; padding: 20px 24px; margin: auto;" @onclick:stopPropagation="true">
            <div style="width: 44px; height: 44px; border-radius: 50%; background: #fee2e2; color: #dc2626; display: flex; align-items: center; justify-content: center; margin: 0 auto 12px auto;">
