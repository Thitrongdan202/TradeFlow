    // Helper: File Extension Class
    private string GetFileExtClass(string fileName)
    {
        var ext = System.IO.Path.GetExtension(fileName).ToLowerInvariant();
        return ext switch
        {
            ".pdf" => "pdf",
            ".docx" or ".doc" => "word",
            ".xlsx" or ".xls" => "excel",
            ".png" or ".jpg" or ".jpeg" or ".webp" => "image",
            _ => "other"
        };
    }

