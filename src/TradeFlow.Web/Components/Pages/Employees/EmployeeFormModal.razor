@using System.ComponentModel.DataAnnotations
@using System.Text
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Application.Common.Models.Documents
@using TradeFlow.Application.Common.Models.Employees
@using TradeFlow.Application.Common.Models.Users
@using TradeFlow.Domain.Entities.Employees
@using TradeFlow.Domain.Enums
@using TradeFlow.Infrastructure.Persistence
@using TradeFlow.Web.Components.Shared.Forms
@inject IEmployeeService EmployeeService
@inject IDocumentService DocumentService
@inject TradeFlowDbContext DbContext
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (IsOpen)
{
    <div class="tf-modal-overlay" @onclick="HandleBackdropClick" @onkeydown="HandleKeyDown" tabindex="-1">
        <div class="tf-modal tf-modal-lg employee-modal"
             style="max-width: 860px; max-height: calc(100dvh - 32px); min-height: 0; display: flex; flex-direction: column; overflow: hidden; position: relative;"
             @onclick:stopPropagation="true">

            @* Fixed Header *@
            <div class="tf-modal-header employee-modal-header" style="flex: 0 0 auto;">
                <div>
                    <h3 class="tf-modal-title" style="display:flex; align-items:center; gap:8px;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--tf-primary);">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                            <circle cx="8.5" cy="7" r="4"/>
                            <line x1="20" y1="8" x2="20" y2="14"/>
                            <line x1="23" y1="11" x2="17" y2="11"/>
                        </svg>
                        @(IsResubmitMode ? "Bổ sung hồ sơ & Gửi lại duyệt" : IsCloneMode ? "Tạo yêu cầu nhân sự mới từ hồ sơ cũ" : _isDirectCreate ? "Thêm nhân viên mới" : "Gửi yêu cầu phê duyệt nhân sự")
                    </h3>
                    <p style="margin:2px 0 0 0; font-size:13px; color:var(--tf-text-muted);">
                        @(_isDirectCreate ? "Nhập thông tin chi tiết để tạo hồ sơ nhân viên trong hệ thống" : "Đề xuất thông tin nhân sự và đính kèm hồ sơ cá nhân gửi ban quản lý xét duyệt")
                    </p>
                </div>
                <button type="button" class="tf-modal-close-btn" @onclick="RequestCloseAsync" aria-label="Đóng" title="Đóng">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"/>
                        <line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                </button>
            </div>

            @if (IsResubmitMode && PreloadedRequest != null)
            {
                <div style="background-color: rgba(217, 119, 6, 0.1); border-bottom: 1px solid rgba(217, 119, 6, 0.3); padding: 10px 20px; font-size: 13px; color: var(--tf-text-primary); display: flex; align-items: flex-start; gap: 8px;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2" style="flex-shrink:0; margin-top:2px;">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="8" x2="12" y2="12"/>
                        <line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                    <div>
                        <div><strong>Hồ sơ đang yêu cầu bổ sung thông tin hoặc tài liệu đính kèm:</strong></div>
                        <div style="margin-top:2px; color:#b45309; font-weight:600;">@PreloadedRequest.ReviewNotes</div>
                    </div>
                </div>
            }
            else if (IsCloneMode && PreloadedRequest != null)
            {
                <div style="background-color: rgba(2, 132, 199, 0.1); border-bottom: 1px solid rgba(2, 132, 199, 0.3); padding: 10px 20px; font-size: 13px; color: var(--tf-text-primary); display: flex; align-items: flex-start; gap: 8px;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="2" style="flex-shrink:0; margin-top:2px;">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="16" x2="12" y2="12"/>
                        <line x1="12" y1="8" x2="12.01" y2="8"/>
                    </svg>
                    <div>
                        <div><strong>Tạo yêu cầu mới từ hồ sơ bị từ chối (@(PreloadedRequest.Code ?? $"YC-{PreloadedRequest.Id:D4}")):</strong></div>
                        <div style="margin-top:2px; color:var(--tf-text-muted); font-size:12px;">Thông tin ứng viên đã được tự động điền sẵn. Bạn có thể cập nhật và đính kèm thêm hồ sơ phù hợp.</div>
                    </div>
                </div>
            }

            @* Fixed Mode Selector Subheader (Segmented Control) *@
            <AuthorizeView Policy="Permission:Employees:Create">
                <Authorized>
                    <div class="tf-mode-selector-bar">
                        <span class="tf-mode-selector-label">Phương thức thực hiện:</span>
                        <div class="tf-mode-segmented-control">
                            <button type="button" class="tf-mode-tab @(_isDirectCreate ? "active" : "")" @onclick="() => SwitchMode(true)">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                    <circle cx="8.5" cy="7" r="4"/>
                                    <line x1="20" y1="8" x2="20" y2="14"/>
                                    <line x1="23" y1="11" x2="17" y2="11"/>
                                </svg>
                                <span>Tạo hồ sơ trực tiếp</span>
                            </button>
                            <button type="button" class="tf-mode-tab @(!_isDirectCreate ? "active" : "")" @onclick="() => SwitchMode(false)">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                    <polyline points="14 2 14 8 20 8"/>
                                    <line x1="16" y1="13" x2="8" y2="13"/>
                                    <line x1="16" y1="17" x2="8" y2="17"/>
                                    <polyline points="10 9 9 9 8 9"/>
                                </svg>
                                <span>Gửi yêu cầu phê duyệt</span>
                                <span class="tf-badge tf-badge-info" style="font-size: 10px; padding: 1px 6px; margin-left: 4px;">Kèm hồ sơ</span>
                            </button>
                        </div>
                    </div>
                </Authorized>
            </AuthorizeView>

            <EditForm Model="_model" OnValidSubmit="HandleSubmit" class="tf-modal-form" style="display: flex; flex-direction: column; flex: 1 1 auto; min-height: 0; overflow: hidden;">
                <DataAnnotationsValidator />

                @* Scrollable Body *@
                <div class="tf-modal-body employee-modal-body" style="flex: 1 1 auto; min-height: 0; overflow-y: auto; overscroll-behavior: contain; padding: 20px; display: flex; flex-direction: column; gap: 20px;">
                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="tf-alert tf-alert-error">
                            @_errorMessage
                        </div>
                    }

                    @* Group 1: Thông tin cơ bản *@
                    <div class="tf-form-section-card">
                        <div style="font-weight: 600; font-size: 14px; color: var(--tf-text-primary, #1e293b); margin-bottom: 14px; display: flex; align-items: center; gap: 8px;">
                            <span style="width: 4px; height: 16px; background-color: var(--tf-primary); border-radius: 2px;"></span>
                            Thông tin cơ bản
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 2fr 1fr; gap: 16px;">
                            <div class="tf-form-group">
                                <label class="tf-label">Mã nhân viên</label>
                                <InputText class="tf-input" @bind-Value="_model.Code" placeholder="NV00001" />
                                <span class="tf-text-muted" style="font-size: 11px;">Mặc định tự sinh</span>
                            </div>

                            <div class="tf-form-group">
                                <label class="tf-label">Họ và tên <span class="tf-text-danger">*</span></label>
                                <InputText class="tf-input" @bind-Value="_model.FullName" placeholder="Ví dụ: Nguyễn Văn An" />
                                <ValidationMessage For="@(() => _model.FullName)" class="tf-field-error" />
                            </div>

                            <div class="tf-form-group">
                                <label class="tf-label">Giới tính</label>
                                <InputSelect class="tf-input" @bind-Value="_model.Gender">
                                    <option value="Nam">Nam</option>
                                    <option value="Nữ">Nữ</option>
                                    <option value="Khác">Khác</option>
                                </InputSelect>
                            </div>
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; margin-top: 14px;">
                            <div class="tf-form-group">
                                <label class="tf-label">Ngày sinh (dd/MM/yyyy)</label>
                                <TfDateInput @bind-Value="_model.DateOfBirth" Placeholder="dd/MM/yyyy" />
                            </div>

                            <div class="tf-form-group">
                                <label class="tf-label">Số CMND / CCCD</label>
                                <InputText class="tf-input" @bind-Value="_model.NationalId" placeholder="001200001234" />
                            </div>

                            <div class="tf-form-group">
                                <label class="tf-label">Mã chấm công</label>
                                <InputText class="tf-input" @bind-Value="_model.AttendanceCode" placeholder="CC001" />
                            </div>
                        </div>
                    </div>

                    @* Group 2: Vị trí & Bộ phận làm việc *@
                    <div class="tf-form-section-card">
                        <div style="font-weight: 600; font-size: 14px; color: var(--tf-text-primary, #1e293b); margin-bottom: 14px; display: flex; align-items: center; gap: 8px;">
                            <span style="width: 4px; height: 16px; background-color: var(--tf-primary); border-radius: 2px;"></span>
                            Vị trí &amp; Bộ phận làm việc
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                            <div class="tf-form-group">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                                    <label class="tf-label" style="margin: 0;">Phòng ban</label>
                                    <button type="button" class="tf-btn-link" @onclick="() => _showQuickDept = true" style="font-size: 12px; color: var(--tf-primary); text-decoration: none; border: none; background: transparent; cursor: pointer; padding: 0;">
                                        + Tạo mới
                                    </button>
                                </div>
                                <InputSelect class="tf-input" @bind-Value="_model.DepartmentId">
                                    <option value="">-- Chọn phòng ban --</option>
                                    @foreach (var dept in _activeDepartments)
                                    {
                                        <option value="@dept.Id">@dept.Name (@dept.Code)</option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="tf-form-group">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                                    <label class="tf-label" style="margin: 0;">Chức danh</label>
                                    <button type="button" class="tf-btn-link" @onclick="() => _showQuickPos = true" style="font-size: 12px; color: var(--tf-primary); text-decoration: none; border: none; background: transparent; cursor: pointer; padding: 0;">
                                        + Tạo mới
                                    </button>
                                </div>
                                <InputSelect class="tf-input" @bind-Value="_model.PositionId">
                                    <option value="">-- Chọn chức danh --</option>
                                    @foreach (var pos in _activePositions)
                                    {
                                        <option value="@pos.Id">@pos.Name (@pos.Code)</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; margin-top: 14px;">
                            <div class="tf-form-group">
                                <label class="tf-label">Chi nhánh làm việc</label>
                                <InputText class="tf-input" @bind-Value="_model.WorkingBranch" placeholder="Chi nhánh trung tâm" />
                            </div>

                            <div class="tf-form-group">
                                <label class="tf-label">Chi nhánh tính lương</label>
                                <InputText class="tf-input" @bind-Value="_model.PayrollBranch" placeholder="Chi nhánh trung tâm" />
                            </div>

                            <div class="tf-form-group">
                                <label class="tf-label">Ngày bắt đầu làm việc</label>
                                <TfDateInput @bind-Value="_model.StartDate" Placeholder="dd/MM/yyyy" />
                            </div>
                        </div>
                    </div>

                    @* Group 3: Liên hệ & Tài khoản hệ thống *@
                    <div class="tf-form-section-card">
                        <div style="font-weight: 600; font-size: 14px; color: var(--tf-text-primary, #1e293b); margin-bottom: 14px; display: flex; align-items: center; gap: 8px;">
                            <span style="width: 4px; height: 16px; background-color: var(--tf-primary); border-radius: 2px;"></span>
                            Liên hệ &amp; Tài khoản TradeFlow
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px;">
                            <div class="tf-form-group">
                                <label class="tf-label">Số điện thoại</label>
                                <InputText class="tf-input" @bind-Value="_model.Phone" placeholder="0901 234 567" />
                            </div>

                            <div class="tf-form-group">
                                <label class="tf-label">Email</label>
                                <InputText class="tf-input" @bind-Value="_model.Email" placeholder="nhanvien@congty.vn" />
                            </div>

                            <div class="tf-form-group">
                                <label class="tf-label">Tài khoản TradeFlow</label>
                                <InputSelect class="tf-input" @bind-Value="_model.UserId">
                                    <option value="">-- Chưa liên kết tài khoản --</option>
                                    @foreach (var user in _availableUsers)
                                    {
                                        <option value="@user.Id">@user.UserName (@user.FullName)</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>

                        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 16px; margin-top: 14px;">
                            <div class="tf-form-group">
                                <label class="tf-label">Địa chỉ</label>
                                <InputText class="tf-input" @bind-Value="_model.Address" placeholder="Địa chỉ thường trú hoặc tạm trú..." />
                            </div>

                            <div class="tf-form-group">
                                <label class="tf-label">Facebook / Liên hệ khác</label>
                                <InputText class="tf-input" @bind-Value="_model.Facebook" placeholder="https://facebook.com/..." />
                            </div>
                        </div>
                    </div>

                    @* Group 4: Tài khoản ngân hàng & Ghi chú *@
                    <div class="tf-form-section-card">
                        <div style="font-weight: 600; font-size: 14px; color: var(--tf-text-primary, #1e293b); margin-bottom: 14px; display: flex; align-items: center; gap: 8px;">
                            <span style="width: 4px; height: 16px; background-color: var(--tf-primary); border-radius: 2px;"></span>
                            Ngân hàng &amp; Ghi chú
                        </div>

                        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 16px;">
                            <div class="tf-form-group">
                                <label class="tf-label">Thông tin tài khoản ngân hàng</label>
                                <InputText class="tf-input" @bind-Value="_model.BankInformation" placeholder="Số TK, Tên Ngân hàng (VD: 1903... - Techcombank CN Hà Nội)" />
                            </div>

                            @if (_isDirectCreate)
                            {
                                <div class="tf-form-group tf-mode-animated-section">
                                    <label class="tf-label">Nợ &amp; tạm ứng ban đầu (VNĐ)</label>
                                    <InputNumber class="tf-input" @bind-Value="_model.DebtAndAdvance" />
                                </div>
                            }
                        </div>

                        <div class="tf-form-group" style="margin-top: 14px;">
                            <label class="tf-label">Ghi chú</label>
                            <InputTextArea class="tf-input" rows="2" @bind-Value="_model.Notes" placeholder="Ghi chú thêm về nhân sự..." />
                        </div>
                    </div>

                    @* Group 5: Hồ sơ cá nhân & Tài liệu đính kèm (khi Gửi yêu cầu phê duyệt) *@
                    @if (!_isDirectCreate)
                    {
                        <div class="tf-form-section-card tf-mode-animated-section">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                                <div style="font-weight: 600; font-size: 14px; color: var(--tf-text-primary, #1e293b); display: flex; align-items: center; gap: 8px;">
                                    <span style="width: 4px; height: 16px; background-color: var(--tf-primary); border-radius: 2px;"></span>
                                    Hồ sơ cá nhân &amp; Tài liệu đính kèm
                                    <span class="tf-badge tf-badge-info" style="font-size: 11px;">@_pendingAttachments.Count tệp</span>
                                </div>

                                <button type="button" class="tf-btn tf-btn-sm tf-btn-outline-primary" @onclick="AttachDemoDocuments" style="display: flex; align-items: center; gap: 6px;">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                        <polyline points="14 2 14 8 20 8"/>
                                        <line x1="12" y1="18" x2="12" y2="12"/>
                                        <line x1="9" y1="15" x2="15" y2="15"/>
                                    </svg>
                                    <span>+ Đính kèm hồ sơ mẫu DEMO</span>
                                </button>
                            </div>

                            <p style="font-size: 12.5px; color: var(--tf-text-muted); margin: 0 0 14px 0; line-height: 1.5;">
                                Đính kèm hồ sơ nhân sự (CV, Bằng cấp, Giấy tờ tùy thân) để người xét duyệt kiểm tra đối chiếu trước khi phê duyệt hồ sơ.
                            </p>

                            @* Upload box *@
                            <div class="tf-dossier-upload-zone">
                                <div style="margin-bottom: 10px; display: flex; gap: 12px; align-items: center; justify-content: center; flex-wrap: wrap;">
                                    <div style="width: 220px; text-align: left;">
                                        <label class="tf-label" style="font-size: 11.5px; margin-bottom: 2px;">Phân loại hồ sơ:</label>
                                        <select class="tf-input" style="height: 32px; font-size: 12px;" @bind="_selectedAttachmentCategory">
                                            @foreach (var cat in _dossierCategories)
                                            {
                                                <option value="@cat">@cat</option>
                                            }
                                        </select>
                                    </div>
                                    <div style="flex: 1; min-width: 200px; text-align: left;">
                                        <label class="tf-label" style="font-size: 11.5px; margin-bottom: 2px;">Ghi chú tệp:</label>
                                        <input type="text" class="tf-input" style="height: 32px; font-size: 12px;" placeholder="Ví dụ: Bản scan có công chứng..." @bind="_attachmentDescription" />
                                    </div>
                                </div>

                                <div style="display: flex; align-items: center; justify-content: center; gap: 10px; margin-top: 8px;">
                                    <label class="tf-btn tf-btn-sm tf-btn-outline-primary" style="cursor: pointer; display: inline-flex; align-items: center; gap: 6px; margin: 0;">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                                            <polyline points="17 8 12 3 7 8"/>
                                            <line x1="12" y1="3" x2="12" y2="15"/>
                                        </svg>
                                        <span>Chọn tệp tải lên (PDF, DOCX, JPG, PNG)</span>
                                        <InputFile OnChange="HandleFileSelected" multiple accept=".pdf,.docx,.doc,.jpg,.jpeg,.png" style="display: none;" />
                                    </label>
                                </div>
                                <span style="font-size: 11px; color: var(--tf-text-muted); display: block; margin-top: 6px;">
                                    Hỗ trợ định dạng PDF, Word, Ảnh (tối đa 20MB/tệp).
                                </span>
                            </div>

                            @* List of pending attached files *@
                            @if (_pendingAttachments.Any())
                            {
                                <div class="tf-dossier-list">
                                    @for (int i = 0; i < _pendingAttachments.Count; i++)
                                    {
                                        int itemIndex = i;
                                        var att = _pendingAttachments[i];
                                        <div class="tf-dossier-item" @key="att.FileName">
                                            <div style="display: flex; align-items: center; gap: 10px; flex: 1; min-width: 0;">
                                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--tf-primary); flex-shrink: 0;">
                                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                                    <polyline points="14 2 14 8 20 8"/>
                                                </svg>
                                                <div style="min-width: 0;">
                                                    <div style="display: flex; align-items: center; gap: 6px;">
                                                        <span style="font-weight: 600; color: var(--tf-text-primary); text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">
                                                            @att.FileName
                                                        </span>
                                                        @if (att.IsDemo)
                                                        {
                                                            <span class="tf-dossier-demo-tag">DEMO DATA — NOT A REAL PERSONAL DOCUMENT</span>
                                                        }
                                                    </div>
                                                    <div style="font-size: 11.5px; color: var(--tf-text-muted); margin-top: 2px;">
                                                        <span class="tf-badge tf-badge-info" style="font-size: 10.5px; padding: 1px 6px;">@att.Category</span>
                                                        <span> • @att.FormattedSize</span>
                                                        @if (!string.IsNullOrEmpty(att.Description))
                                                        {
                                                            <span> • @att.Description</span>
                                                        }
                                                    </div>
                                                </div>
                                            </div>

                                            <button type="button" class="tf-btn tf-btn-ghost tf-btn-sm" style="color: var(--tf-danger, #ef4444); padding: 4px 8px;" @onclick="() => RemovePendingAttachment(itemIndex)" title="Xóa tài liệu">
                                                ✕
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                @* Fixed Footer *@
                <div class="tf-modal-footer employee-modal-footer" style="flex: 0 0 auto; padding: 14px 20px; border-top: 1px solid var(--tf-border); display: flex; justify-content: flex-end; gap: 12px; background: var(--tf-bg-card);">
                    <button type="button" class="tf-btn tf-btn-ghost" @onclick="RequestCloseAsync" disabled="@_isSubmitting">
                        Hủy
                    </button>
                    <button type="submit" class="tf-btn tf-btn-primary" disabled="@_isSubmitting" style="display: flex; align-items: center; gap: 6px; min-width: 140px; justify-content: center;">
                        @if (_isSubmitting)
                        {
                            <span class="tf-spinner-sm"></span>
                            <span>Đang lưu...</span>
                        }
                        else
                        {
                            @if (_isDirectCreate)
                            {
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="20 6 9 17 4 12"/>
                                </svg>
                                <span>Lưu nhân viên</span>
                            }
                            else
                            {
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <line x1="22" y1="2" x2="11" y2="13"/>
                                    <polygon points="22 2 15 22 11 13 2 9 22 2"/>
                                </svg>
                                <span>Gửi yêu cầu phê duyệt</span>
                            }
                        }
                    </button>
                </div>
            </EditForm>

            @* Unsaved Changes Confirmation Modal Overlay *@
            @if (_showDirtyConfirm)
            {
                <div class="tf-modal-confirm-overlay" @onclick:stopPropagation="true">
                    <div class="tf-modal-confirm-box text-center">
                        <div class="tw-w-12 tw-h-12 tw-rounded-full tw-bg-amber-100 tw-text-amber-600 tw-flex tw-items-center tw-justify-center tw-mx-auto tw-mb-3">
                            <svg class="tw-w-6 tw-h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                            </svg>
                        </div>
                        <h4 class="tw-text-base tw-font-bold tw-text-slate-900 tw-mb-1.5" style="color: var(--tf-text-primary);">Bạn có thay đổi chưa lưu</h4>
                        <p class="tw-text-xs tw-text-slate-500 tw-mb-5 tw-leading-relaxed" style="color: var(--tf-text-secondary);">
                            Bạn có chắc muốn đóng và hủy thay đổi? Dữ liệu hồ sơ nhân sự bạn vừa nhập sẽ không được lưu.
                        </p>
                        <div class="tw-flex tw-items-center tw-justify-center tw-gap-2.5">
                            <button type="button" class="tf-btn tf-btn-ghost tw-text-xs" @onclick="() => _showDirtyConfirm = false">
                                Tiếp tục chỉnh sửa
                            </button>
                            <button type="button" class="tf-btn tf-btn-danger tw-text-xs" @onclick="ConfirmDiscardAsync">
                                Hủy thay đổi
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@* Quick Add Department Modal *@
<QuickDepartmentModal @bind-IsOpen="_showQuickDept" OnDepartmentCreated="HandleDepartmentCreated" />

@* Quick Add Position Modal *@
<QuickPositionModal @bind-IsOpen="_showQuickPos" OnPositionCreated="HandlePositionCreated" />

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback<EmployeeDto?> OnEmployeeSaved { get; set; }
    [Parameter] public EventCallback<EmployeeDto> OnEmployeeCreated { get; set; }
    [Parameter] public EmployeeRequestDto? PreloadedRequest { get; set; }
    [Parameter] public bool IsResubmitMode { get; set; }
    [Parameter] public bool IsCloneMode { get; set; }
    [Parameter] public List<DepartmentDto>? PreloadedDepartments { get; set; }
    [Parameter] public List<PositionDto>? PreloadedPositions { get; set; }

    private FormModel _model = new();
    private bool _isDirectCreate = true;
    private bool _isSubmitting;
    private bool _showDirtyConfirm;
    private string? _errorMessage;

    private List<DepartmentDto> _departments = new();
    private List<PositionDto> _positions = new();
    private List<UserLookupDto> _availableUsers = new();

    private bool _showQuickDept;
    private bool _showQuickPos;

    // Dossier Attachment state
    private string _selectedAttachmentCategory = "Sơ yếu lý lịch / CV";
    private string? _attachmentDescription;
    private List<PendingAttachment> _pendingAttachments = new();

    private readonly List<string> _dossierCategories = new()
    {
        "Hồ sơ cá nhân",
        "Giấy tờ tùy thân",
        "Sơ yếu lý lịch / CV",
        "Bằng cấp / Chứng chỉ",
        "Tài liệu liên quan đến công việc",
        "Tài liệu khác"
    };

    private bool IsDirty =>
        !string.IsNullOrWhiteSpace(_model.FullName) ||
        !string.IsNullOrWhiteSpace(_model.Phone) ||
        !string.IsNullOrWhiteSpace(_model.Email) ||
        !string.IsNullOrWhiteSpace(_model.NationalId) ||
        _model.DepartmentId.HasValue ||
        _model.PositionId.HasValue ||
        _pendingAttachments.Any();

    private bool _wasOpen;
    private List<DepartmentDto> _activeDepartments = new();
    private List<PositionDto> _activePositions = new();

    private void SwitchMode(bool direct)
    {
        if (_isDirectCreate == direct) return;
        _isDirectCreate = direct;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && !_wasOpen)
        {
            _wasOpen = true;
            try
            {
                await JS.InvokeVoidAsync("TradeFlowMotion.lockScroll");
            }
            catch { }

            _errorMessage = null;
            _isSubmitting = false;
            _showDirtyConfirm = false;
            _pendingAttachments.Clear();
            _attachmentDescription = null;

            if (PreloadedRequest != null)
            {
                _isDirectCreate = false;
                _model = new FormModel
                {
                    FullName = PreloadedRequest.FullName,
                    Code = PreloadedRequest.Code,
                    AttendanceCode = PreloadedRequest.AttendanceCode,
                    NationalId = PreloadedRequest.NationalId,
                    DateOfBirth = PreloadedRequest.DateOfBirth,
                    Gender = PreloadedRequest.Gender ?? "Nam",
                    Phone = PreloadedRequest.Phone,
                    Email = PreloadedRequest.Email,
                    Address = PreloadedRequest.Address,
                    DepartmentId = PreloadedRequest.DepartmentId,
                    PositionId = PreloadedRequest.PositionId,
                    WorkingBranch = PreloadedRequest.WorkingBranch ?? "Chi nhánh trung tâm",
                    PayrollBranch = PreloadedRequest.PayrollBranch ?? "Chi nhánh trung tâm",
                    StartDate = PreloadedRequest.StartDate ?? DateTime.Today,
                    BankInformation = PreloadedRequest.BankInformation,
                    Notes = IsCloneMode
                        ? $"Tạo lại từ yêu cầu bị từ chối [{(string.IsNullOrWhiteSpace(PreloadedRequest.Code) ? $"YC-{PreloadedRequest.Id:D4}" : PreloadedRequest.Code)}]: {PreloadedRequest.ReviewNotes}"
                        : PreloadedRequest.Notes,
                    UserId = PreloadedRequest.ProposedUserId
                };
            }
            else
            {
                _model = new FormModel
                {
                    StartDate = DateTime.Today,
                    WorkingBranch = "Chi nhánh trung tâm",
                    PayrollBranch = "Chi nhánh trung tâm",
                    Gender = "Nam"
                };
            }

            await LoadDataAsync();
        }
        else if (!IsOpen && _wasOpen)
        {
            _wasOpen = false;
            try
            {
                await JS.InvokeVoidAsync("TradeFlowMotion.unlockScroll");
            }
            catch { }
        }
        else if (!IsOpen)
        {
            _wasOpen = false;
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            if (PreloadedDepartments != null && PreloadedDepartments.Count > 0)
            {
                _departments = PreloadedDepartments;
            }
            else if (_departments.Count == 0)
            {
                _departments = await EmployeeService.GetDepartmentsAsync();
            }

            if (PreloadedPositions != null && PreloadedPositions.Count > 0)
            {
                _positions = PreloadedPositions;
            }
            else if (_positions.Count == 0)
            {
                _positions = await EmployeeService.GetPositionsAsync();
            }

            _activeDepartments = _departments.Where(d => d.IsActive).ToList();
            _activePositions = _positions.Where(p => p.IsActive).ToList();

            if (_availableUsers.Count == 0)
            {
                _availableUsers = await EmployeeService.GetAvailableUsersAsync();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Lỗi nạp dữ liệu danh mục: " + ex.Message;
        }
    }

    private async Task HandleBackdropClick()
    {
        if (_isSubmitting) return;

        if (IsDirty)
        {
            _showDirtyConfirm = true;
            return;
        }

        await CloseAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (_isSubmitting) return;

        if (e.Key == "Escape")
        {
            if (_showDirtyConfirm)
            {
                _showDirtyConfirm = false;
                return;
            }

            await RequestCloseAsync();
        }
    }

    public async Task RequestCloseAsync()
    {
        if (_isSubmitting) return;

        if (IsDirty)
        {
            _showDirtyConfirm = true;
            return;
        }

        await CloseAsync();
    }

    private async Task ConfirmDiscardAsync()
    {
        _showDirtyConfirm = false;
        await CloseAsync();
    }

    private async Task CloseAsync()
    {
        IsOpen = false;
        try
        {
            await JS.InvokeVoidAsync("TradeFlowMotion.unlockScroll");
        }
        catch { }
        await IsOpenChanged.InvokeAsync(false);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("TradeFlowMotion.unlockScroll");
        }
        catch { }
    }

    private void HandleDepartmentCreated(DepartmentDto dept)
    {
        _departments.Add(dept);
        _activeDepartments = _departments.Where(d => d.IsActive).ToList();
        _model.DepartmentId = dept.Id;
    }

    private void HandlePositionCreated(PositionDto pos)
    {
        _positions.Add(pos);
        _activePositions = _positions.Where(p => p.IsActive).ToList();
        _model.PositionId = pos.Id;
    }

    private void AttachDemoDocuments()
    {
        // Add 3 clearly marked harmless demonstration attachments
        string candidateName = string.IsNullOrWhiteSpace(_model.FullName) ? "Ứng viên" : _model.FullName.Trim();

        _pendingAttachments.Add(new PendingAttachment
        {
            FileName = $"DEMO_CV_{candidateName.Replace(" ", "_")}.pdf",
            ContentType = "application/pdf",
            Category = "Sơ yếu lý lịch / CV",
            Description = "Bản sơ yếu lý lịch mẫu — DEMO DATA — NOT A REAL PERSONAL DOCUMENT",
            Bytes = Encoding.UTF8.GetBytes("%PDF-1.4\n%DEMO DATA — NOT A REAL PERSONAL DOCUMENT\nCandidate: " + candidateName + "\nDate: " + DateTime.Now.ToString("dd/MM/yyyy")),
            IsDemo = true
        });

        _pendingAttachments.Add(new PendingAttachment
        {
            FileName = "DEMO_Bang_Tot_Nghiep.pdf",
            ContentType = "application/pdf",
            Category = "Bằng cấp / Chứng chỉ",
            Description = "Bằng cử nhân chuyên ngành mẫu — DEMO DATA — NOT A REAL PERSONAL DOCUMENT",
            Bytes = Encoding.UTF8.GetBytes("%PDF-1.4\n%DEMO DATA — NOT A REAL PERSONAL DOCUMENT\nDegree: Bachelor of Business Administration\nDate: " + DateTime.Now.ToString("dd/MM/yyyy")),
            IsDemo = true
        });

        _pendingAttachments.Add(new PendingAttachment
        {
            FileName = "DEMO_Giay_To_Tuy_Than.png",
            ContentType = "image/png",
            Category = "Giấy tờ tùy thân",
            Description = "Bản scan giấy tờ tùy thân mẫu — DEMO DATA — NOT A REAL PERSONAL DOCUMENT",
            Bytes = Encoding.UTF8.GetBytes("PNG_MOCK_DEMO_DATA_NOT_A_REAL_PERSONAL_DOCUMENT"),
            IsDemo = true
        });
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        const long maxFileSize = 20 * 1024 * 1024; // 20 MB

        foreach (var file in e.GetMultipleFiles(10))
        {
            if (file.Size > maxFileSize)
            {
                _errorMessage = $"Tệp '{file.Name}' vượt quá dung lượng tối đa cho phép (20MB).";
                continue;
            }

            try
            {
                using var stream = file.OpenReadStream(maxFileSize);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);

                _pendingAttachments.Add(new PendingAttachment
                {
                    FileName = file.Name,
                    ContentType = file.ContentType,
                    Category = _selectedAttachmentCategory,
                    Description = _attachmentDescription,
                    Bytes = ms.ToArray(),
                    IsDemo = false
                });
            }
            catch (Exception ex)
            {
                _errorMessage = $"Không thể tải tệp '{file.Name}': {ex.Message}";
            }
        }

        _attachmentDescription = null;
    }

    private void RemovePendingAttachment(int index)
    {
        if (index >= 0 && index < _pendingAttachments.Count)
        {
            _pendingAttachments.RemoveAt(index);
        }
    }

    private async Task HandleSubmit()
    {
        _isSubmitting = true;
        _errorMessage = null;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name ?? "Admin";

            if (IsResubmitMode && PreloadedRequest != null)
            {
                var resubmitCmd = new ResubmitEmployeeRequestCommand
                {
                    RequestId = PreloadedRequest.Id,
                    FullName = _model.FullName.Trim(),
                    Code = _model.Code?.Trim(),
                    AttendanceCode = _model.AttendanceCode?.Trim(),
                    Phone = _model.Phone?.Trim(),
                    Email = _model.Email?.Trim(),
                    NationalId = _model.NationalId?.Trim(),
                    DateOfBirth = _model.DateOfBirth,
                    Gender = _model.Gender?.Trim(),
                    Address = _model.Address?.Trim(),
                    DepartmentId = _model.DepartmentId,
                    PositionId = _model.PositionId,
                    WorkingBranch = _model.WorkingBranch?.Trim(),
                    PayrollBranch = _model.PayrollBranch?.Trim(),
                    StartDate = _model.StartDate,
                    BankInformation = _model.BankInformation?.Trim(),
                    Notes = _model.Notes?.Trim(),
                    ProposedUserId = !string.IsNullOrWhiteSpace(_model.UserId) ? _model.UserId.Trim() : null,
                    ResubmitNotes = "Đã cập nhật thông tin và bổ sung hồ sơ theo yêu cầu."
                };

                await EmployeeService.ResubmitEmployeeRequestAsync(resubmitCmd, username);

                if (_pendingAttachments.Any())
                {
                    var categories = await DocumentService.GetCategoriesAsync();

                    foreach (var att in _pendingAttachments)
                    {
                        var matchedCat = categories.FirstOrDefault(c => c.Name.Equals(att.Category, StringComparison.OrdinalIgnoreCase));
                        int? catId = matchedCat?.Id;

                        using var fileStream = new MemoryStream(att.Bytes);
                        await DocumentService.UploadDocumentAsync(
                            fileStream,
                            att.FileName,
                            att.ContentType,
                            att.Bytes.Length,
                            "EmployeeRequest",
                            PreloadedRequest.Id,
                            catId,
                            att.Description);
                    }
                }

                if (OnEmployeeSaved.HasDelegate)
                {
                    await OnEmployeeSaved.InvokeAsync(null);
                }
            }
            else if (_isDirectCreate)
            {
                var command = new CreateEmployeeCommand
                {
                    Code = _model.Code?.Trim(),
                    AttendanceCode = _model.AttendanceCode?.Trim(),
                    FullName = _model.FullName.Trim(),
                    NationalId = _model.NationalId?.Trim(),
                    DateOfBirth = _model.DateOfBirth,
                    Gender = _model.Gender?.Trim(),
                    Phone = _model.Phone?.Trim(),
                    Email = _model.Email?.Trim(),
                    Address = _model.Address?.Trim(),
                    Facebook = _model.Facebook?.Trim(),
                    DepartmentId = _model.DepartmentId,
                    PositionId = _model.PositionId,
                    WorkingBranch = _model.WorkingBranch?.Trim(),
                    PayrollBranch = _model.PayrollBranch?.Trim(),
                    StartDate = _model.StartDate,
                    BankInformation = _model.BankInformation?.Trim(),
                    DebtAndAdvance = _model.DebtAndAdvance,
                    Notes = _model.Notes?.Trim(),
                    UserId = !string.IsNullOrWhiteSpace(_model.UserId) ? _model.UserId.Trim() : null
                };

                var result = await EmployeeService.CreateEmployeeAsync(command, username);
                if (OnEmployeeCreated.HasDelegate)
                {
                    await OnEmployeeCreated.InvokeAsync(result);
                }
                if (OnEmployeeSaved.HasDelegate)
                {
                    await OnEmployeeSaved.InvokeAsync(result);
                }
            }
            else
            {
                var reqCmd = new CreateEmployeeRequestCommand
                {
                    FullName = _model.FullName.Trim(),
                    Code = _model.Code?.Trim(),
                    AttendanceCode = _model.AttendanceCode?.Trim(),
                    Phone = _model.Phone?.Trim(),
                    Email = _model.Email?.Trim(),
                    NationalId = _model.NationalId?.Trim(),
                    DateOfBirth = _model.DateOfBirth,
                    Gender = _model.Gender?.Trim(),
                    Address = _model.Address?.Trim(),
                    DepartmentId = _model.DepartmentId,
                    PositionId = _model.PositionId,
                    WorkingBranch = _model.WorkingBranch?.Trim(),
                    PayrollBranch = _model.PayrollBranch?.Trim(),
                    StartDate = _model.StartDate,
                    BankInformation = _model.BankInformation?.Trim(),
                    Notes = _model.Notes?.Trim(),
                    ProposedUserId = !string.IsNullOrWhiteSpace(_model.UserId) ? _model.UserId.Trim() : null
                };

                var createdReq = await EmployeeService.SubmitEmployeeRequestAsync(reqCmd, username);

                // Upload pending dossier attachments linked to this EmployeeRequest
                if (_pendingAttachments.Any())
                {
                    var categories = await DocumentService.GetCategoriesAsync();

                    foreach (var att in _pendingAttachments)
                    {
                        var matchedCat = categories.FirstOrDefault(c => c.Name.Equals(att.Category, StringComparison.OrdinalIgnoreCase));
                        int? catId = matchedCat?.Id;

                        using var fileStream = new MemoryStream(att.Bytes);
                        await DocumentService.UploadDocumentAsync(
                            fileStream,
                            att.FileName,
                            att.ContentType,
                            att.Bytes.Length,
                            "EmployeeRequest",
                            createdReq.Id,
                            catId,
                            att.Description);
                    }
                }

                if (OnEmployeeSaved.HasDelegate)
                {
                    await OnEmployeeSaved.InvokeAsync(null);
                }
            }

            await CloseAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private class PendingAttachment
    {
        public string FileName { get; set; } = string.Empty;
        public string ContentType { get; set; } = "application/pdf";
        public string Category { get; set; } = "Hồ sơ cá nhân";
        public string? Description { get; set; }
        public byte[] Bytes { get; set; } = Array.Empty<byte>();
        public bool IsDemo { get; set; }

        public string FormattedSize =>
            Bytes.Length < 1024 ? $"{Bytes.Length} B" :
            Bytes.Length < 1024 * 1024 ? $"{Bytes.Length / 1024.0:F1} KB" :
            $"{Bytes.Length / (1024.0 * 1024.0):F1} MB";
    }

    private class FormModel
    {
        public string? Code { get; set; }
        public string? AttendanceCode { get; set; }

        [Required(ErrorMessage = "Vui lòng nhập họ và tên")]
        [MaxLength(100, ErrorMessage = "Họ và tên tối đa 100 ký tự")]
        public string FullName { get; set; } = string.Empty;

        public string? NationalId { get; set; }
        public DateTime? DateOfBirth { get; set; }
        public string? Gender { get; set; }

        public string? Phone { get; set; }
        public string? Email { get; set; }
        public string? Address { get; set; }
        public string? Facebook { get; set; }

        public int? DepartmentId { get; set; }
        public int? PositionId { get; set; }
        public string? WorkingBranch { get; set; }
        public string? PayrollBranch { get; set; }
        public DateTime? StartDate { get; set; }

        public string? BankInformation { get; set; }
        public decimal DebtAndAdvance { get; set; }
        public string? Notes { get; set; }

        public string? UserId { get; set; }
    }
}
