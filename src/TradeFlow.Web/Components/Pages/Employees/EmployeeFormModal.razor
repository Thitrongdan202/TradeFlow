@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Application.Common.Models.Employees
@using TradeFlow.Domain.Entities.Employees
@using TradeFlow.Domain.Enums
@using TradeFlow.Infrastructure.Persistence
@inject IEmployeeService EmployeeService
@inject TradeFlowDbContext DbContext
@inject AuthenticationStateProvider AuthStateProvider

@if (IsOpen)
{
    <div class="tf-modal-overlay" @onclick="HandleBackdropClick">
        <div class="tf-modal tf-modal-lg" style="max-width: 860px; max-height: 90vh;" @onclick:stopPropagation="true">
            <div class="tf-modal-header">
                <div>
                    <h3 class="tf-modal-title" style="display:flex; align-items:center; gap:8px;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--tf-primary);">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                            <circle cx="8.5" cy="7" r="4"/>
                            <line x1="20" y1="8" x2="20" y2="14"/>
                            <line x1="23" y1="11" x2="17" y2="11"/>
                        </svg>
                        @(_isDirectCreate ? "Thêm nhân viên mới" : "Gửi yêu cầu thêm nhân viên")
                    </h3>
                    <p style="margin:2px 0 0 0; font-size:13px; color:var(--tf-text-muted);">
                        @(_isDirectCreate ? "Nhập thông tin chi tiết để tạo hồ sơ nhân viên trong hệ thống" : "Đề xuất thông tin nhân sự gửi ban quản lý xét duyệt")
                    </p>
                </div>
                <button type="button" class="tf-btn-icon" @onclick="Close">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"/>
                        <line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                </button>
            </div>

            <AuthorizeView Policy="Permission:Employees:Create">
                <Authorized>
                    @* Mode selector if user has permission to direct create *@
                    <div style="padding: 10px 20px; background-color: #f8fafc; border-bottom: 1px solid var(--tf-border); display: flex; align-items: center; gap: 20px;">
                        <span style="font-size: 13px; font-weight: 600; color: #475569;">Phương thức:</span>
                        <label style="display: flex; align-items: center; gap: 6px; cursor: pointer; font-size: 13px;">
                            <input type="radio" name="empCreateMode" checked="@_isDirectCreate" @onchange="() => _isDirectCreate = true" />
                            <span>Tạo hồ sơ trực tiếp</span>
                        </label>
                        <label style="display: flex; align-items: center; gap: 6px; cursor: pointer; font-size: 13px;">
                            <input type="radio" name="empCreateMode" checked="@(!_isDirectCreate)" @onchange="() => _isDirectCreate = false" />
                            <span>Gửi yêu cầu phê duyệt</span>
                        </label>
                    </div>
                </Authorized>
            </AuthorizeView>

            <EditForm Model="_model" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                <div class="tf-modal-body" style="padding: 20px; display: flex; flex-direction: column; gap: 20px;">
                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="tf-alert tf-alert-error">
                            @_errorMessage
                        </div>
                    }

                    @* Group 1: Thông tin cơ bản *@
                    <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px;">
                        <div style="font-weight: 600; font-size: 14px; color: #1e293b; margin-bottom: 14px; display: flex; align-items: center; gap: 8px;">
                            <span style="width: 4px; height: 16px; background-color: var(--tf-primary); border-radius: 2px;"></span>
                            Thông tin cơ bản
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 2fr 1fr; gap: 16px;">
                            <div class="tf-form-group">
                                <label class="tf-label">Mã nhân viên</label>
                                <InputText class="tf-input" @bind-Value="_model.Code" placeholder="NV00001" />
                                <span class="tf-text-muted" style="font-size: 11px;">Mặc định tự sinh</span>
                            </div>

                            <div class="tf-form-group">
                                <label class="tf-label">Họ và tên <span class="tf-text-danger">*</span></label>
                                <InputText class="tf-input" @bind-Value="_model.FullName" placeholder="Ví dụ: Nguyễn Văn An" />
                                <ValidationMessage For="@(() => _model.FullName)" class="tf-field-error" />
                            </div>

                            <div class="tf-form-group">
                                <label class="tf-label">Giới tính</label>
                                <InputSelect class="tf-input" @bind-Value="_model.Gender">
                                    <option value="Nam">Nam</option>
                                    <option value="Nữ">Nữ</option>
                                    <option value="Khác">Khác</option>
                                </InputSelect>
                            </div>
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; margin-top: 14px;">
                            <div class="tf-form-group">
                                <label class="tf-label">Ngày sinh</label>
                                <InputDate class="tf-input" @bind-Value="_model.DateOfBirth" />
                            </div>

                            <div class="tf-form-group">
                                <label class="tf-label">Số CMND / CCCD</label>
                                <InputText class="tf-input" @bind-Value="_model.NationalId" placeholder="001200001234" />
                            </div>

                            <div class="tf-form-group">
                                <label class="tf-label">Mã chấm công</label>
                                <InputText class="tf-input" @bind-Value="_model.AttendanceCode" placeholder="CC001" />
                            </div>
                        </div>
                    </div>

                    @* Group 2: Vị trí & Công việc *@
                    <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px;">
                        <div style="font-weight: 600; font-size: 14px; color: #1e293b; margin-bottom: 14px; display: flex; align-items: center; gap: 8px;">
                            <span style="width: 4px; height: 16px; background-color: var(--tf-primary); border-radius: 2px;"></span>
                            Vị trí &amp; Bộ phận làm việc
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                            <div class="tf-form-group">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                                    <label class="tf-label" style="margin: 0;">Phòng ban</label>
                                    <button type="button" class="tf-btn-link" @onclick="() => _showQuickDept = true" style="font-size: 12px; color: var(--tf-primary); text-decoration: none; border: none; background: transparent; cursor: pointer; padding: 0;">
                                        + Tạo mới
                                    </button>
                                </div>
                                <InputSelect class="tf-input" @bind-Value="_model.DepartmentId">
                                    <option value="">-- Chọn phòng ban --</option>
                                    @foreach (var dept in _departments)
                                    {
                                        <option value="@dept.Id">@dept.Name (@dept.Code)</option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="tf-form-group">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                                    <label class="tf-label" style="margin: 0;">Chức danh</label>
                                    <button type="button" class="tf-btn-link" @onclick="() => _showQuickPos = true" style="font-size: 12px; color: var(--tf-primary); text-decoration: none; border: none; background: transparent; cursor: pointer; padding: 0;">
                                        + Tạo mới
                                    </button>
                                </div>
                                <InputSelect class="tf-input" @bind-Value="_model.PositionId">
                                    <option value="">-- Chọn chức danh --</option>
                                    @foreach (var pos in _positions)
                                    {
                                        <option value="@pos.Id">@pos.Name (@pos.Code)</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; margin-top: 14px;">
                            <div class="tf-form-group">
                                <label class="tf-label">Chi nhánh làm việc</label>
                                <InputText class="tf-input" @bind-Value="_model.WorkingBranch" placeholder="Chi nhánh trung tâm" />
                            </div>

                            <div class="tf-form-group">
                                <label class="tf-label">Chi nhánh tính lương</label>
                                <InputText class="tf-input" @bind-Value="_model.PayrollBranch" placeholder="Chi nhánh trung tâm" />
                            </div>

                            <div class="tf-form-group">
                                <label class="tf-label">Ngày bắt đầu làm việc</label>
                                <InputDate class="tf-input" @bind-Value="_model.StartDate" />
                            </div>
                        </div>
                    </div>

                    @* Group 3: Liên hệ & Tài khoản hệ thống *@
                    <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px;">
                        <div style="font-weight: 600; font-size: 14px; color: #1e293b; margin-bottom: 14px; display: flex; align-items: center; gap: 8px;">
                            <span style="width: 4px; height: 16px; background-color: var(--tf-primary); border-radius: 2px;"></span>
                            Liên hệ &amp; Tài khoản TradeFlow
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px;">
                            <div class="tf-form-group">
                                <label class="tf-label">Số điện thoại</label>
                                <InputText class="tf-input" @bind-Value="_model.Phone" placeholder="0901 234 567" />
                            </div>

                            <div class="tf-form-group">
                                <label class="tf-label">Email</label>
                                <InputText class="tf-input" @bind-Value="_model.Email" placeholder="nhanvien@congty.vn" />
                            </div>

                            <div class="tf-form-group">
                                <label class="tf-label">Tài khoản TradeFlow</label>
                                <InputSelect class="tf-input" @bind-Value="_model.UserId">
                                    <option value="">-- Chưa liên kết tài khoản --</option>
                                    @foreach (var user in _availableUsers)
                                    {
                                        <option value="@user.Id">@user.UserName (@user.FullName)</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>

                        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 16px; margin-top: 14px;">
                            <div class="tf-form-group">
                                <label class="tf-label">Địa chỉ</label>
                                <InputText class="tf-input" @bind-Value="_model.Address" placeholder="Địa chỉ thường trú hoặc tạm trú..." />
                            </div>

                            <div class="tf-form-group">
                                <label class="tf-label">Facebook / Liên hệ khác</label>
                                <InputText class="tf-input" @bind-Value="_model.Facebook" placeholder="https://facebook.com/..." />
                            </div>
                        </div>
                    </div>

                    @* Group 4: Tài khoản ngân hàng & Ghi chú *@
                    <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px;">
                        <div style="font-weight: 600; font-size: 14px; color: #1e293b; margin-bottom: 14px; display: flex; align-items: center; gap: 8px;">
                            <span style="width: 4px; height: 16px; background-color: var(--tf-primary); border-radius: 2px;"></span>
                            Ngân hàng &amp; Ghi chú
                        </div>

                        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 16px;">
                            <div class="tf-form-group">
                                <label class="tf-label">Thông tin tài khoản ngân hàng</label>
                                <InputText class="tf-input" @bind-Value="_model.BankInformation" placeholder="Số TK, Tên Ngân hàng (VD: 1903... - Techcombank CN Hà Nội)" />
                            </div>

                            @if (_isDirectCreate)
                            {
                                <div class="tf-form-group">
                                    <label class="tf-label">Nợ &amp; tạm ứng ban đầu (VNĐ)</label>
                                    <InputNumber class="tf-input" @bind-Value="_model.DebtAndAdvance" />
                                </div>
                            }
                        </div>

                        <div class="tf-form-group" style="margin-top: 14px;">
                            <label class="tf-label">Ghi chú</label>
                            <InputTextArea class="tf-input" rows="2" @bind-Value="_model.Notes" placeholder="Ghi chú thêm về nhân viên..." />
                        </div>
                    </div>
                </div>

                <div class="tf-modal-footer">
                    <button type="button" class="tf-btn tf-btn-ghost" @onclick="Close" disabled="@_isSubmitting">Hủy</button>
                    <LoadingButton Type="submit"
                                   Class="tf-btn tf-btn-primary"
                                   IsLoading="@_isSubmitting"
                                   LoadingText="Đang xử lý...">
                        <span>@(_isDirectCreate ? "Lưu nhân viên" : "Gửi yêu cầu phê duyệt")</span>
                    </LoadingButton>
                </div>
            </EditForm>
        </div>
    </div>
}

@* Quick creation child modals *@
<QuickDepartmentModal @bind-IsOpen="_showQuickDept" OnDepartmentCreated="HandleDepartmentCreated" />
<QuickPositionModal @bind-IsOpen="_showQuickPos" OnPositionCreated="HandlePositionCreated" />

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback<EmployeeDto> OnEmployeeSaved { get; set; }

    private FormModel _model = new();
    private List<DepartmentDto> _departments = new();
    private List<PositionDto> _positions = new();
    private List<UserInfo> _availableUsers = new();

    private bool _isDirectCreate = true;
    private bool _isSubmitting;
    private string? _errorMessage;

    private bool _showQuickDept;
    private bool _showQuickPos;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen)
        {
            _errorMessage = null;
            _isSubmitting = false;
            await LoadMasterDataAsync();
        }
    }

    private async Task LoadMasterDataAsync()
    {
        try
        {
            _departments = await EmployeeService.GetDepartmentsAsync();
            _positions = await EmployeeService.GetPositionsAsync();

            var nextCode = await EmployeeService.GetNextEmployeeCodeAsync();
            _model = new FormModel
            {
                Code = nextCode,
                Gender = "Nam",
                WorkingBranch = "Chi nhánh trung tâm",
                PayrollBranch = "Chi nhánh trung tâm",
                StartDate = DateTime.Today
            };

            // Query unlinked users
            var assignedUserIds = await DbContext.Employees
                .Where(e => e.UserId != null)
                .Select(e => e.UserId!)
                .ToListAsync();

            _availableUsers = await DbContext.Users
                .Where(u => !assignedUserIds.Contains(u.Id))
                .Select(u => new UserInfo { Id = u.Id, UserName = u.UserName ?? "", FullName = u.FullName ?? "" })
                .ToListAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Không thể tải dữ liệu danh mục: {ex.Message}";
        }
    }

    private void HandleDepartmentCreated(DepartmentDto dept)
    {
        _departments.Add(dept);
        _model.DepartmentId = dept.Id;
    }

    private void HandlePositionCreated(PositionDto pos)
    {
        _positions.Add(pos);
        _model.PositionId = pos.Id;
    }

    private async Task HandleBackdropClick()
    {
        if (!_isSubmitting)
        {
            await Close();
        }
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task HandleSubmit()
    {
        _isSubmitting = true;
        _errorMessage = null;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name ?? "Admin";

            if (_isDirectCreate)
            {
                var cmd = new CreateEmployeeCommand
                {
                    Code = string.IsNullOrWhiteSpace(_model.Code) ? null : _model.Code.Trim(),
                    AttendanceCode = string.IsNullOrWhiteSpace(_model.AttendanceCode) ? null : _model.AttendanceCode.Trim(),
                    FullName = _model.FullName.Trim(),
                    NationalId = string.IsNullOrWhiteSpace(_model.NationalId) ? null : _model.NationalId.Trim(),
                    DateOfBirth = _model.DateOfBirth,
                    Gender = _model.Gender,
                    Phone = string.IsNullOrWhiteSpace(_model.Phone) ? null : _model.Phone.Trim(),
                    Email = string.IsNullOrWhiteSpace(_model.Email) ? null : _model.Email.Trim(),
                    Address = string.IsNullOrWhiteSpace(_model.Address) ? null : _model.Address.Trim(),
                    Facebook = string.IsNullOrWhiteSpace(_model.Facebook) ? null : _model.Facebook.Trim(),
                    DepartmentId = _model.DepartmentId,
                    PositionId = _model.PositionId,
                    WorkingBranch = _model.WorkingBranch,
                    PayrollBranch = _model.PayrollBranch,
                    StartDate = _model.StartDate,
                    BankInformation = string.IsNullOrWhiteSpace(_model.BankInformation) ? null : _model.BankInformation.Trim(),
                    DebtAndAdvance = _model.DebtAndAdvance,
                    Notes = string.IsNullOrWhiteSpace(_model.Notes) ? null : _model.Notes.Trim(),
                    UserId = string.IsNullOrWhiteSpace(_model.UserId) ? null : _model.UserId
                };

                var created = await EmployeeService.CreateEmployeeAsync(cmd, username);
                await OnEmployeeSaved.InvokeAsync(created);
                await Close();
            }
            else
            {
                var reqCmd = new CreateEmployeeRequestCommand
                {
                    Code = string.IsNullOrWhiteSpace(_model.Code) ? null : _model.Code.Trim(),
                    AttendanceCode = string.IsNullOrWhiteSpace(_model.AttendanceCode) ? null : _model.AttendanceCode.Trim(),
                    FullName = _model.FullName.Trim(),
                    NationalId = string.IsNullOrWhiteSpace(_model.NationalId) ? null : _model.NationalId.Trim(),
                    DateOfBirth = _model.DateOfBirth,
                    Gender = _model.Gender,
                    Phone = string.IsNullOrWhiteSpace(_model.Phone) ? null : _model.Phone.Trim(),
                    Email = string.IsNullOrWhiteSpace(_model.Email) ? null : _model.Email.Trim(),
                    Address = string.IsNullOrWhiteSpace(_model.Address) ? null : _model.Address.Trim(),
                    DepartmentId = _model.DepartmentId,
                    PositionId = _model.PositionId,
                    WorkingBranch = _model.WorkingBranch,
                    PayrollBranch = _model.PayrollBranch,
                    StartDate = _model.StartDate,
                    BankInformation = string.IsNullOrWhiteSpace(_model.BankInformation) ? null : _model.BankInformation.Trim(),
                    Notes = string.IsNullOrWhiteSpace(_model.Notes) ? null : _model.Notes.Trim(),
                    ProposedUserId = string.IsNullOrWhiteSpace(_model.UserId) ? null : _model.UserId
                };

                await EmployeeService.SubmitEmployeeRequestAsync(reqCmd, username);
                await OnEmployeeSaved.InvokeAsync(null);
                await Close();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private class UserInfo
    {
        public string Id { get; set; } = string.Empty;
        public string UserName { get; set; } = string.Empty;
        public string FullName { get; set; } = string.Empty;
    }

    private class FormModel
    {
        public string? Code { get; set; }
        public string? AttendanceCode { get; set; }

        [Required(ErrorMessage = "Vui lòng nhập họ và tên nhân viên")]
        [MaxLength(200, ErrorMessage = "Họ và tên tối đa 200 ký tự")]
        public string FullName { get; set; } = string.Empty;

        public string? NationalId { get; set; }
        public DateTime? DateOfBirth { get; set; }
        public string? Gender { get; set; } = "Nam";

        public string? Phone { get; set; }
        public string? Email { get; set; }
        public string? Address { get; set; }
        public string? Facebook { get; set; }

        public int? DepartmentId { get; set; }
        public int? PositionId { get; set; }
        public string? WorkingBranch { get; set; } = "Chi nhánh trung tâm";
        public string? PayrollBranch { get; set; } = "Chi nhánh trung tâm";
        public DateTime? StartDate { get; set; } = DateTime.Today;

        public string? BankInformation { get; set; }
        public decimal DebtAndAdvance { get; set; }
        public string? Notes { get; set; }

        public string? UserId { get; set; }
    }
}
