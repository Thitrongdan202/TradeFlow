@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Application.Common.Models.Documents
@using TradeFlow.Application.Common.Models.Employees
@using TradeFlow.Domain.Enums
@inject IEmployeeService EmployeeService
@inject AuthenticationStateProvider AuthStateProvider
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService

@if (IsOpen)
{
    <div class="tf-modal-overlay" @onclick="HandleBackdropClick">
        <div class="tf-modal tf-modal-lg" style="max-width: 920px; max-height: calc(100dvh - 32px); min-height: 0; display: flex; flex-direction: column; overflow: hidden; position: relative;" @onclick:stopPropagation="true">
            @* Fixed Header *@
            <div class="tf-modal-header" style="flex: 0 0 auto;">
                <div>
                    <h3 class="tf-modal-title" style="display:flex; align-items:center; gap:8px;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--tf-primary);">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                            <polyline points="14 2 14 8 20 8"/>
                            <path d="M9 15l2 2 4-4"/>
                        </svg>
                        Xét duyệt yêu cầu nhân sự &amp; Hồ sơ đính kèm
                    </h3>
                    <p style="margin:2px 0 0 0; font-size:13px; color:var(--tf-text-muted);">
                        Xem xét, thẩm định hồ sơ đính kèm, phê duyệt hoặc yêu cầu bổ sung thông tin nhân sự
                    </p>
                </div>
                <div style="display:flex; align-items:center; gap:8px;">
                    <button type="button" class="tf-modal-close-btn" @onclick="() => LoadRequestsAsync(true)" aria-label="Làm mới" title="Tải lại danh sách" disabled="@_isLoading">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="@(_isLoading ? "tf-spin" : "")">
                            <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/>
                        </svg>
                    </button>
                    <button type="button" class="tf-modal-close-btn" @onclick="Close" aria-label="Đóng" title="Đóng">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18"/>
                            <line x1="6" y1="6" x2="18" y2="18"/>
                        </svg>
                    </button>
                </div>
            </div>

            @* Filter tabs bar (Fixed) *@
            <div class="tf-req-filter-bar">
                <button type="button" class="tf-tab-btn @(_selectedStatus == EmployeeRequestStatus.Pending ? "active" : "")" @onclick="() => FilterByStatus(EmployeeRequestStatus.Pending)">
                    <span>Chờ duyệt</span>
                    @if (_pendingCount > 0)
                    {
                        <span class="tf-badge tf-badge-warning" style="margin-left:6px; font-size:11px; padding:2px 6px;">@_pendingCount</span>
                    }
                </button>
                <button type="button" class="tf-tab-btn @(_selectedStatus == EmployeeRequestStatus.NeedAdditionalDocs ? "active" : "")" @onclick="() => FilterByStatus(EmployeeRequestStatus.NeedAdditionalDocs)">
                    <span>Cần bổ sung hồ sơ</span>
                    @if (_needDocsCount > 0)
                    {
                        <span class="tf-badge tf-badge-info" style="margin-left:6px; font-size:11px; padding:2px 6px;">@_needDocsCount</span>
                    }
                </button>
                <button type="button" class="tf-tab-btn @(_selectedStatus == EmployeeRequestStatus.Approved ? "active" : "")" @onclick="() => FilterByStatus(EmployeeRequestStatus.Approved)">
                    <span>Đã duyệt</span>
                </button>
                <button type="button" class="tf-tab-btn @(_selectedStatus == EmployeeRequestStatus.Rejected ? "active" : "")" @onclick="() => FilterByStatus(EmployeeRequestStatus.Rejected)">
                    <span>Từ chối</span>
                </button>
                <button type="button" class="tf-tab-btn @(_selectedStatus == null ? "active" : "")" @onclick="() => FilterByStatus(null)">
                    <span>Tất cả</span>
                    <span class="tf-badge" style="margin-left:6px; font-size:11px; padding:2px 6px;">@_allRequests.Count</span>
                </button>
            </div>

            @* Scrollable Body *@
            <div class="tf-modal-body tf-req-body" style="flex: 1 1 auto; min-height: 0; overflow-y: auto; overscroll-behavior: contain;">
                @if (!string.IsNullOrEmpty(_alertMessage))
                {
                    <div class="tf-alert @(_alertIsSuccess ? "tf-alert-success" : "tf-alert-error") tf-mb-4">
                        @_alertMessage
                    </div>
                }

                @if (_isLoading && _allRequests.Count == 0)
                {
                    <div style="padding:40px; text-align:center; color:var(--tf-text-muted);">
                        <span class="tf-spinner-sm"></span> Đang tải danh sách yêu cầu...
                    </div>
                }
                else if (!_filteredRequests.Any())
                {
                    <div class="tf-empty tf-req-empty">
                        <div class="tf-empty-icon">
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"/>
                                <path d="m9 12 2 2 4-4"/>
                            </svg>
                        </div>
                        <div class="tf-empty-title">Không có yêu cầu nào</div>
                        <div class="tf-empty-desc">
                            @(_selectedStatus == EmployeeRequestStatus.Pending
                                ? "Hiện không có yêu cầu thêm nhân viên nào đang chờ duyệt."
                                : "Không tìm thấy yêu cầu phù hợp với bộ lọc hiện tại.")
                        </div>
                    </div>
                }
                else
                {
                    <div style="display:flex; flex-direction:column; gap:16px;">
                        @foreach (var req in _filteredRequests)
                        {
                            <div id="@($"req-item-{req.Id}")" class="tf-req-card @(req.Id == TargetRequestId ? "highlighted-target" : "")" @key="req.Id">
                                @* Header of card *@
                                <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:12px;">
                                    <div style="display:flex; align-items:center; gap:12px;">
                                        <div class="tf-req-avatar">
                                            @GetInitials(req.FullName)
                                        </div>
                                        <div>
                                            <div class="tf-req-name">
                                                @req.FullName
                                                @if (!string.IsNullOrEmpty(req.Code))
                                                {
                                                    <span class="tf-req-code">[@req.Code]</span>
                                                }
                                            </div>
                                            <div class="tf-req-meta">
                                                Đề xuất bởi: <strong>@req.RequestedBy</strong> • @req.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                            </div>
                                        </div>
                                    </div>
                                    <div>
                                        @switch (req.Status)
                                        {
                                            case EmployeeRequestStatus.Pending:
                                                <span class="tf-badge tf-badge-warning" style="display:flex; align-items:center; gap:4px;">
                                                    <span style="width:6px; height:6px; border-radius:50%; background:#d97706;"></span>
                                                    Chờ duyệt
                                                </span>
                                                break;
                                            case EmployeeRequestStatus.NeedAdditionalDocs:
                                                <span class="tf-badge tf-badge-info" style="display:flex; align-items:center; gap:4px;">
                                                    <span style="width:6px; height:6px; border-radius:50%; background:#0284c7;"></span>
                                                    Cần bổ sung hồ sơ
                                                </span>
                                                break;
                                            case EmployeeRequestStatus.Approved:
                                                <span class="tf-badge tf-badge-success" style="display:flex; align-items:center; gap:4px;">
                                                    <span style="width:6px; height:6px; border-radius:50%; background:#16a34a;"></span>
                                                    Đã duyệt
                                                </span>
                                                break;
                                            case EmployeeRequestStatus.Rejected:
                                                <span class="tf-badge tf-badge-danger" style="display:flex; align-items:center; gap:4px;">
                                                    <span style="width:6px; height:6px; border-radius:50%; background:#dc2626;"></span>
                                                    Đã từ chối
                                                </span>
                                                break;
                                            default:
                                                <span class="tf-badge">@req.Status</span>
                                                break;
                                        }
                                    </div>
                                </div>

                                @* Info grid *@
                                <div class="tf-req-grid">
                                    <div>
                                        <span class="tf-req-grid-label">Phòng ban:</span>
                                        <strong>@(req.DepartmentName ?? "—")</strong>
                                    </div>
                                    <div>
                                        <span class="tf-req-grid-label">Chức danh:</span>
                                        <strong>@(req.PositionName ?? "—")</strong>
                                    </div>
                                    <div>
                                        <span class="tf-req-grid-label">Điện thoại:</span>
                                        <strong>@(req.Phone ?? "—")</strong>
                                    </div>
                                    <div>
                                        <span class="tf-req-grid-label">Email:</span>
                                        <strong>@(req.Email ?? "—")</strong>
                                    </div>
                                    <div>
                                        <span class="tf-req-grid-label">CMND / CCCD:</span>
                                        <strong>@(req.NationalId ?? "—")</strong>
                                    </div>
                                    <div>
                                        <span class="tf-req-grid-label">Ngày bắt đầu:</span>
                                        <strong>@(req.StartDate?.ToString("dd/MM/yyyy") ?? "—")</strong>
                                    </div>
                                </div>

                                @if (!string.IsNullOrEmpty(req.Notes))
                                {
                                    <div class="tf-req-notes" style="margin-top: 8px;">
                                        <span class="tf-req-grid-label">Ghi chú đề xuất:</span> @req.Notes
                                    </div>
                                }

                                @* Attached Personal Dossier Section *@
                                <div class="tf-req-attachments-box">
                                    <div class="tf-req-attachments-title">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/>
                                        </svg>
                                        <span>Hồ sơ cá nhân &amp; Tài liệu đính kèm (@req.Attachments.Count tệp)</span>
                                    </div>

                                    @if (req.Attachments.Any())
                                    {
                                        <div class="tf-req-attachments-list">
                                            @foreach (var doc in req.Attachments)
                                            {
                                                <div class="tf-req-att-item">
                                                    <span class="tf-badge tf-badge-info" style="font-size:10.5px; padding: 1px 6px;">
                                                        @(doc.CategoryName ?? "Hồ sơ cá nhân")
                                                    </span>
                                                    <span class="tf-req-att-name" title="@doc.FileName">
                                                        @doc.FileName
                                                    </span>
                                                    @if (doc.FileName.Contains("DEMO", StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <span class="tf-dossier-demo-tag">DEMO DATA — NOT A REAL PERSONAL DOCUMENT</span>
                                                    }
                                                    <span class="tf-req-att-size">(@doc.FormattedFileSize)</span>

                                                    <div class="tf-req-att-actions">
                                                        <a href="/api/documents/@doc.Id/preview" target="_blank" class="tf-btn tf-btn-sm tf-btn-outline-primary" style="padding:2px 8px; font-size:11px;" title="Xem trước tài liệu">
                                                            Xem
                                                        </a>
                                                        <a href="/api/documents/@doc.Id/download" class="tf-btn tf-btn-sm tf-btn-outline-secondary" style="padding:2px 8px; font-size:11px;" title="Tải về" download>
                                                            Tải
                                                        </a>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div style="font-size: 12px; color: var(--tf-text-muted); font-style: italic;">
                                            Chưa có hồ sơ đính kèm trong yêu cầu này.
                                        </div>
                                    }
                                </div>

                                @* Review History / Status Notes *@
                                @if (req.Status == EmployeeRequestStatus.Approved)
                                {
                                    <div class="tf-req-status-box tf-req-approved" style="margin-top: 10px;">
                                        Đã phê duyệt bởi <strong>@req.ApprovedBy</strong> vào @req.ApprovedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                        @if (!string.IsNullOrEmpty(req.ReviewNotes))
                                        {
                                            <span> — Ý kiến: @req.ReviewNotes</span>
                                        }
                                    </div>
                                }
                                else if (req.Status == EmployeeRequestStatus.Rejected)
                                {
                                    <div class="tf-req-status-box tf-req-rejected" style="margin-top: 10px;">
                                        Từ chối bởi <strong>@req.ApprovedBy</strong> vào @req.ApprovedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                        @if (!string.IsNullOrEmpty(req.ReviewNotes))
                                        {
                                            <span> — Lý do: <strong>@req.ReviewNotes</strong></span>
                                        }
                                        <div style="display:flex; justify-content:flex-end; margin-top:8px;">
                                            <button type="button" class="tf-btn tf-btn-outline-primary tf-btn-sm" style="font-size:12px; padding:4px 10px;" @onclick="() => CloneRequest(req)">
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:4px;">
                                                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                                                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                                                </svg>
                                                Tạo yêu cầu mới từ hồ sơ này
                                            </button>
                                        </div>
                                    </div>
                                }
                                else if (req.Status == EmployeeRequestStatus.NeedAdditionalDocs)
                                {
                                    <div class="tf-req-status-box" style="margin-top: 10px; background-color: rgba(2, 132, 199, 0.1); border: 1px solid rgba(2, 132, 199, 0.3); color: var(--tf-text-primary); border-radius: 6px; padding: 8px 12px; font-size: 12.5px;">
                                        Yêu cầu bổ sung hồ sơ bởi <strong>@req.ApprovedBy</strong> vào @req.ApprovedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                        @if (!string.IsNullOrEmpty(req.ReviewNotes))
                                        {
                                            <span> — Nội dung cần bổ sung: <strong>@req.ReviewNotes</strong></span>
                                        }
                                        <div style="display:flex; justify-content:flex-end; margin-top:8px;">
                                            <button type="button" class="tf-btn tf-btn-warning tf-btn-sm" style="font-size:12px; padding:4px 10px;" @onclick="() => RequestResubmit(req)">
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:4px;">
                                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                                </svg>
                                                Bổ sung hồ sơ &amp; Gửi lại
                                            </button>
                                        </div>
                                    </div>
                                }

                                @* Approval Actions for Pending or NeedAdditionalDocs *@
                                @if (req.Status == EmployeeRequestStatus.Pending || req.Status == EmployeeRequestStatus.NeedAdditionalDocs)
                                {
                                    @if (_canApprove)
                                    {
                                        <div class="tf-req-actions" style="margin-top: 12px; padding-top: 12px; border-top: 1px dashed var(--tf-border);">
                                            @if (_processingRequestId == req.Id)
                                            {
                                                <div style="display:flex; flex-direction:column; gap:8px; width:100%;">
                                                    <input type="text" class="tf-input" placeholder="Nhập ghi chú phê duyệt hoặc nội dung yêu cầu bổ sung / lý do từ chối..." @bind="_reviewNotes" style="width:100%; height:34px; font-size:13px;" />
                                                    <div style="display:flex; justify-content:flex-end; gap:8px;">
                                                        <button type="button" class="tf-btn tf-btn-ghost tf-btn-sm" @onclick="CancelReview">Hủy</button>
                                                        <button type="button" class="tf-btn tf-btn-danger tf-btn-sm" @onclick="() => ConfirmReview(req.Id, false)" disabled="@_isSubmittingAction">
                                                            Xác nhận từ chối
                                                        </button>
                                                        <button type="button" class="tf-btn tf-btn-outline-warning tf-btn-sm" @onclick="() => ConfirmRequestDocs(req.Id)" disabled="@_isSubmittingAction">
                                                            Yêu cầu bổ sung hồ sơ
                                                        </button>
                                                        <button type="button" class="tf-btn tf-btn-primary tf-btn-sm" @onclick="() => ConfirmReview(req.Id, true)" disabled="@_isSubmittingAction">
                                                            Phê duyệt &amp; Tạo hồ sơ
                                                        </button>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div style="display:flex; justify-content:flex-end; gap:8px; width:100%;">
                                                    <button type="button" class="tf-btn tf-btn-outline-danger tf-btn-sm" @onclick="() => StartReview(req.Id)">
                                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:4px;">
                                                            <line x1="18" y1="6" x2="6" y2="18"/>
                                                            <line x1="6" y1="6" x2="18" y2="18"/>
                                                        </svg>
                                                        Từ chối
                                                    </button>
                                                    <button type="button" class="tf-btn tf-btn-outline-warning tf-btn-sm" @onclick="() => StartReview(req.Id)">
                                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:4px;">
                                                            <circle cx="12" cy="12" r="10"/>
                                                            <line x1="12" y1="8" x2="12" y2="12"/>
                                                            <line x1="12" y1="16" x2="12.01" y2="16"/>
                                                        </svg>
                                                        Yêu cầu bổ sung
                                                    </button>
                                                    <button type="button" class="tf-btn tf-btn-primary tf-btn-sm" @onclick="() => StartReview(req.Id)">
                                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:4px;">
                                                            <polyline points="20 6 9 17 4 12"/>
                                                        </svg>
                                                        Phê duyệt hồ sơ
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            @* Fixed Footer *@
            <div class="tf-modal-footer" style="flex: 0 0 auto;">
                <button type="button" class="tf-btn tf-btn-ghost" @onclick="Close">Đóng</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public int? TargetRequestId { get; set; }
    [Parameter] public EventCallback OnRequestsChanged { get; set; }
    [Parameter] public EventCallback OnApproved { get; set; }
    [Parameter] public EventCallback<EmployeeRequestDto> OnResubmitRequested { get; set; }
    [Parameter] public EventCallback<EmployeeRequestDto> OnCloneRequested { get; set; }

    private readonly Dictionary<EmployeeRequestStatus, List<EmployeeRequestDto>> _requestsByStatus = new();
    private List<EmployeeRequestDto> _allRequests = new();
    private bool _canApprove;
    private List<EmployeeRequestDto> _filteredRequests = new();
    private EmployeeRequestStatus? _selectedStatus = EmployeeRequestStatus.Pending;

    private int _pendingCount;
    private int _needDocsCount;
    private bool _isLoading;
    private bool _isSubmittingAction;
    private string? _alertMessage;
    private bool _alertIsSuccess;

    private int? _processingRequestId;
    private string _reviewNotes = string.Empty;
    private bool _wasOpen;
    private int? _lastTargetRequestId;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen)
        {
            bool justOpened = !_wasOpen;
            bool targetChanged = TargetRequestId != _lastTargetRequestId;
            _wasOpen = true;
            _lastTargetRequestId = TargetRequestId;

            if (justOpened || targetChanged)
            {
                _alertMessage = null;
                _processingRequestId = null;
                _reviewNotes = string.Empty;

                var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                var authResult = await AuthorizationService.AuthorizeAsync(authState.User, "Permission:EmployeeRequests:Approve");
                _canApprove = authResult.Succeeded;

                if (!TargetRequestId.HasValue && justOpened && _selectedStatus == null)
                {
                    _selectedStatus = EmployeeRequestStatus.Pending;
                }

                if (_allRequests.Count > 0 && !targetChanged)
                {
                    ApplyFilter();
                }
                else
                {
                    await LoadRequestsAsync(true);
                }
            }
        }
        else
        {
            _wasOpen = false;
        }
    }

    private async Task LoadRequestsAsync(bool force = false)
    {
        if (!force && _allRequests.Count > 0 && !TargetRequestId.HasValue)
        {
            ApplyFilter();
            return;
        }

        _isLoading = true;
        try
        {
            _allRequests = await EmployeeService.GetEmployeeRequestsAsync();
            _pendingCount = _allRequests.Count(r => r.Status == EmployeeRequestStatus.Pending);
            _needDocsCount = _allRequests.Count(r => r.Status == EmployeeRequestStatus.NeedAdditionalDocs);

            _requestsByStatus.Clear();
            _requestsByStatus[EmployeeRequestStatus.Pending] = _allRequests.Where(r => r.Status == EmployeeRequestStatus.Pending).ToList();
            _requestsByStatus[EmployeeRequestStatus.NeedAdditionalDocs] = _allRequests.Where(r => r.Status == EmployeeRequestStatus.NeedAdditionalDocs).ToList();
            _requestsByStatus[EmployeeRequestStatus.Approved] = _allRequests.Where(r => r.Status == EmployeeRequestStatus.Approved).ToList();
            _requestsByStatus[EmployeeRequestStatus.Rejected] = _allRequests.Where(r => r.Status == EmployeeRequestStatus.Rejected).ToList();

            if (TargetRequestId.HasValue)
            {
                var target = _allRequests.FirstOrDefault(r => r.Id == TargetRequestId.Value);
                if (target != null)
                {
                    _selectedStatus = target.Status;
                }
            }
            ApplyFilter();
        }
        catch (Exception ex)
        {
            _alertMessage = "Lỗi nạp yêu cầu: " + ex.Message;
            _alertIsSuccess = false;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void FilterByStatus(EmployeeRequestStatus? status)
    {
        if (_selectedStatus == status) return;
        _selectedStatus = status;
        _processingRequestId = null;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (_selectedStatus.HasValue && _requestsByStatus.TryGetValue(_selectedStatus.Value, out var list))
        {
            _filteredRequests = list;
        }
        else
        {
            _filteredRequests = _allRequests;
        }
    }

    private void StartReview(int requestId)
    {
        _processingRequestId = requestId;
        _reviewNotes = string.Empty;
    }

    private void CancelReview()
    {
        _processingRequestId = null;
        _reviewNotes = string.Empty;
    }

    private async Task ConfirmReview(int requestId, bool approve)
    {
        _isSubmittingAction = true;
        _alertMessage = null;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name ?? "Admin";

            var command = new ReviewEmployeeRequestCommand
            {
                RequestId = requestId,
                Approve = approve,
                RequestAdditionalDocs = false,
                ReviewNotes = _reviewNotes
            };

            var result = await EmployeeService.ReviewEmployeeRequestAsync(command, username);

            _alertIsSuccess = true;
            _alertMessage = approve
                ? $"Đã phê duyệt thành công yêu cầu và tạo hồ sơ nhân viên '{result?.Code}'!"
                : "Đã từ chối yêu cầu thành công.";

            _processingRequestId = null;
            _reviewNotes = string.Empty;

            await LoadRequestsAsync(true);

            if (approve && OnApproved.HasDelegate)
            {
                await OnApproved.InvokeAsync();
            }

            if (OnRequestsChanged.HasDelegate)
            {
                await OnRequestsChanged.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            _alertIsSuccess = false;
            _alertMessage = "Lỗi xử lý yêu cầu: " + ex.Message;
        }
        finally
        {
            _isSubmittingAction = false;
        }
    }

    private async Task ConfirmRequestDocs(int requestId)
    {
        _isSubmittingAction = true;
        _alertMessage = null;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name ?? "Admin";

            var command = new ReviewEmployeeRequestCommand
            {
                RequestId = requestId,
                Approve = false,
                RequestAdditionalDocs = true,
                ReviewNotes = string.IsNullOrWhiteSpace(_reviewNotes) ? "Cần bổ sung thêm hồ sơ tài liệu xác minh" : _reviewNotes.Trim()
            };

            await EmployeeService.ReviewEmployeeRequestAsync(command, username);

            _alertIsSuccess = true;
            _alertMessage = "Đã gửi yêu cầu bổ sung hồ sơ nhân sự.";

            _processingRequestId = null;
            _reviewNotes = string.Empty;

            await LoadRequestsAsync();
        }
        catch (Exception ex)
        {
            _alertIsSuccess = false;
            _alertMessage = "Lỗi xử lý: " + ex.Message;
        }
        finally
        {
            _isSubmittingAction = false;
        }
    }

    private async Task HandleBackdropClick()
    {
        await Close();
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "NV";
        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpperInvariant();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }

    private async Task RequestResubmit(EmployeeRequestDto req)
    {
        await Close();
        if (OnResubmitRequested.HasDelegate)
        {
            await OnResubmitRequested.InvokeAsync(req);
        }
    }

    private async Task CloneRequest(EmployeeRequestDto req)
    {
        await Close();
        if (OnCloneRequested.HasDelegate)
        {
            await OnCloneRequested.InvokeAsync(req);
        }
    }
}
