@code {
    [SupplyParameterFromQuery(Name = "tab")]
    public string? TabParam { get; set; }

    [SupplyParameterFromQuery(Name = "requestId")]
    public int? RequestIdParam { get; set; }

    private int? _targetRequestId;
    private List<EmployeeDto> _employees = new();
    private List<DepartmentDto> _departments = new();
    private List<PositionDto> _positions = new();
    private List<UserSelectDto> _availableUsersForEdit = new();

    private EmployeeStatus _selectedStatus = EmployeeStatus.Active;
    private int? _selectedDepartmentId;
    private int? _selectedPositionId;
    private string _searchTerm = string.Empty;

    private int _totalCount;
    private int _activeCount;
    private int _retiredCount;
    private int _pendingRequestCount;
    private bool _isLoading;

    // Inline row expansion & edit states
    private int? _expandedEmployeeId;
    private List<DocumentAttachmentDto> _expandedAttachments = new();
    private int? _editingEmployeeId;
    private UpdateEmployeeCommand? _inlineEditModel;
    private bool _isSavingInline;

    // Table Row Action Menu State
    private int? _activeActionMenuEmpId;

    // Kebab Action Menus
    private int? _openDeptKebabId;
    private int? _openPosKebabId;

    // Department CRUD & Safe Deletion state
    private DepartmentDto? _departmentToEdit;
    private DepartmentDto? _departmentToDelete;
    private bool _showDeleteDeptModal;

    // Position CRUD & Safe Deletion state
    private PositionDto? _positionToEdit;
    private PositionDto? _positionToDelete;
    private bool _showDeletePosModal;
    private bool _isDeleting;

    // Modals
    private bool _showCreateModal;
    private bool _showRequestModal;
    private EmployeeRequestDto? _formPreloadedRequest;
    private bool _isFormResubmitMode;
    private bool _isFormCloneMode;
    private bool _showRetireModal;
    private bool _showQuickDeptModal;
    private bool _showQuickPosModal;
    private EmployeeDto? _selectedEmployeeForRetire;

    // Notification banner
    private string? _notificationMessage;
    private bool _notificationIsSuccess = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("TradeFlowMotion.animateModuleEntrance", ".tf-employee-layout", new
                {
                    kpiSelector = ".tf-filter-card",
                    sectionSelector = ".tf-employee-sidebar, .tf-employee-main, .tf-card, .tf-employee-table"
                });
            }
            catch { }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadMasterDataAsync();
        await LoadEmployeesAsync();
        await LoadCountsAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (string.Equals(TabParam, "requests", StringComparison.OrdinalIgnoreCase) || RequestIdParam.HasValue)
        {
            _targetRequestId = RequestIdParam;
            _showRequestModal = true;
            StateHasChanged();
        }
    }

    private void OpenCreateModal()
    {
        if (_showCreateModal) return;
        _formPreloadedRequest = null;
        _isFormResubmitMode = false;
        _isFormCloneMode = false;
        _showCreateModal = true;
    }

    private void HandleResubmitRequested(EmployeeRequestDto req)
    {
        _formPreloadedRequest = req;
        _isFormResubmitMode = true;
        _isFormCloneMode = false;
        _showCreateModal = true;
    }

    private void HandleCloneRequested(EmployeeRequestDto req)
    {
        _formPreloadedRequest = req;
        _isFormResubmitMode = false;
        _isFormCloneMode = true;
        _showCreateModal = true;
    }

    private void OpenRequestModal()
    {
        if (_showRequestModal) return;
        _targetRequestId = null;
        _showRequestModal = true;
    }

    private void HandleRequestModalClosed(bool isOpen)
    {
        _showRequestModal = isOpen;
        if (!isOpen)
        {
        _targetRequestId = null;
            if (!string.IsNullOrEmpty(TabParam) || RequestIdParam.HasValue)
            {
                Navigation.NavigateTo("/nhan-vien", replace: true);
            }
        }
    }

    private async Task LoadMasterDataAsync()
    {
        try
        {
            _departments = await EmployeeService.GetDepartmentsAsync(includeInactive: true);
            _positions = await EmployeeService.GetPositionsAsync(includeInactive: true);
        }
        catch (Exception ex)
        {
            _notificationMessage = $"Lỗi tải dữ liệu phòng ban: {ex.Message}";
            _notificationIsSuccess = false;
        }
    }

    private async Task LoadCountsAsync()
    {
        try
        {
            _activeCount = await EmployeeService.GetEmployeeCountAsync(EmployeeStatus.Active);
            _retiredCount = await EmployeeService.GetEmployeeCountAsync(EmployeeStatus.Retired);
            _pendingRequestCount = await EmployeeService.GetPendingRequestCountAsync();
            _totalCount = _selectedStatus == EmployeeStatus.Active ? _activeCount : _retiredCount;
        }
        catch
        {
            // Ignore count load error
        }
    }

    private async Task LoadEmployeesAsync()
    {
        _isLoading = true;
        try
        {
            var filter = new EmployeeFilterDto
            {
                SearchTerm = string.IsNullOrWhiteSpace(_searchTerm) ? null : _searchTerm.Trim(),
                Status = _selectedStatus,
                DepartmentId = _selectedDepartmentId,
                PositionId = _selectedPositionId,
                PageIndex = 1,
                PageSize = 200
            };

            _employees = await EmployeeService.GetEmployeesAsync(filter);
            _totalCount = _employees.Count;
        }
        catch (Exception ex)
        {
            _notificationMessage = $"Lỗi tải danh sách nhân viên: {ex.Message}";
            _notificationIsSuccess = false;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SetStatusFilter(EmployeeStatus status)
    {
        if (_selectedStatus != status)
        {
            _selectedStatus = status;
            _expandedEmployeeId = null;
            _editingEmployeeId = null;
            await LoadEmployeesAsync();
        }
    }

    private async Task SetDepartmentFilter(int? deptId)
    {
        if (_selectedDepartmentId != deptId)
        {
            _selectedDepartmentId = deptId;
            await LoadEmployeesAsync();
        }
    }

    private async Task SetPositionFilter(int? posId)
    {
        if (_selectedPositionId != posId)
        {
            _selectedPositionId = posId;
            await LoadEmployeesAsync();
        }
    }

    private async Task HandleSearchChanged(string val)
    {
        _searchTerm = val;
        await LoadEmployeesAsync();
    }

    private async Task HandleSearchInput(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? "";
        await LoadEmployeesAsync();
    }

    private async Task ClearSearch()
    {
        _searchTerm = string.Empty;
        await LoadEmployeesAsync();
    }

    private async Task ToggleExpand(int employeeId)
    {
        if (_expandedEmployeeId == employeeId)
        {
            _expandedEmployeeId = null;
            _editingEmployeeId = null;
            _expandedAttachments.Clear();
        }
        else
        {
            _expandedEmployeeId = employeeId;
            _editingEmployeeId = null;
            _expandedAttachments.Clear();
            try
            {
                _expandedAttachments = await EmployeeService.GetEmployeeAttachmentsAsync(employeeId);
            }
            catch
            {
                _expandedAttachments = new();
            }
        }
    }

    private void ToggleActionMenu(int empId)
    {
        if (_activeActionMenuEmpId == empId)
        {
            _activeActionMenuEmpId = null;
        }
        else
        {
            _activeActionMenuEmpId = empId;
        }
    }

    private void CloseActionMenu()
    {
        _activeActionMenuEmpId = null;
    }

    private async Task HandleEditFromMenu(EmployeeDto emp)
    {
        CloseActionMenu();
        if (_expandedEmployeeId != emp.Id)
        {
            await ToggleExpand(emp.Id);
        }
        await StartInlineEdit(emp);
    }

    private void HandleRetireFromMenu(EmployeeDto emp)
    {
        CloseActionMenu();
        OpenRetireModal(emp);
    }

    private void NavigateToContract(EmployeeDto emp)
    {
        CloseActionMenu();
        Navigation.NavigateTo($"/hop-dong?employeeId={emp.Id}&name={Uri.EscapeDataString(emp.FullName)}");
    }

    private async Task StartInlineEdit(EmployeeDto emp)
    {
        _editingEmployeeId = emp.Id;
        _inlineEditModel = new UpdateEmployeeCommand
        {
            Id = emp.Id,
            FullName = emp.FullName,
            AttendanceCode = emp.AttendanceCode,
            NationalId = emp.NationalId,
            DateOfBirth = emp.DateOfBirth,
            Gender = emp.Gender ?? "Nam",
            AvatarPath = emp.AvatarPath,
            Phone = emp.Phone,
            Email = emp.Email,
            Address = emp.Address,
            Facebook = emp.Facebook,
            MobileDevice = emp.MobileDevice,
            DepartmentId = emp.DepartmentId,
            PositionId = emp.PositionId,
            WorkingBranch = emp.WorkingBranch,
            PayrollBranch = emp.PayrollBranch,
            StartDate = emp.StartDate,
            BankInformation = emp.BankInformation,
            DebtAndAdvance = emp.DebtAndAdvance,
            Notes = emp.Notes,
            UserId = emp.UserId
        };

        // Query available users for linking
        try
        {
            var assignedUserIds = await DbContext.Employees
                .Where(e => e.UserId != null && e.Id != emp.Id)
                .Select(e => e.UserId!)
                .ToListAsync();

            _availableUsersForEdit = await DbContext.Users
                .Where(u => !assignedUserIds.Contains(u.Id))
                .Select(u => new UserSelectDto { Id = u.Id, UserName = u.UserName ?? "", FullName = u.FullName ?? "" })
                .ToListAsync();
        }
        catch
        {
            _availableUsersForEdit = new();
        }
    }

    private void CancelInlineEdit()
    {
        _editingEmployeeId = null;
        _inlineEditModel = null;
    }

    private async Task SaveInlineEdit()
    {
        if (_inlineEditModel == null) return;

        _isSavingInline = true;
        _notificationMessage = null;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name ?? "Admin";

            var updated = await EmployeeService.UpdateEmployeeAsync(_inlineEditModel, username);
            _notificationMessage = $"Cập nhật thông tin nhân viên {updated.FullName} thành công!";
            _notificationIsSuccess = true;
            _editingEmployeeId = null;
            _inlineEditModel = null;

            await LoadEmployeesAsync();
            await LoadCountsAsync();
        }
        catch (Exception ex)
        {
            _notificationMessage = $"Cập nhật thất bại: {ex.Message}";
            _notificationIsSuccess = false;
        }
        finally
        {
            _isSavingInline = false;
        }
    }

    private void OpenRetireModal(EmployeeDto emp)
    {
        if (_showRetireModal) return;
        _selectedEmployeeForRetire = emp;
        _showRetireModal = true;
    }

    private async Task HandleEmployeeSaved(EmployeeDto? employee)
    {
        if (employee != null)
        {
            _notificationMessage = $"Thêm mới nhân viên {employee.FullName} ({employee.Code}) thành công!";
            _notificationIsSuccess = true;
            _expandedEmployeeId = employee.Id;
        }
        else
        {
            _notificationMessage = "Đã gửi yêu cầu thêm nhân viên tới ban quản lý!";
            _notificationIsSuccess = true;
        }

        await LoadEmployeesAsync();
        await LoadCountsAsync();
    }

    private async Task HandleRequestsChanged()
    {
        await LoadEmployeesAsync();
        await LoadCountsAsync();
    }

    private async Task HandleEmployeeRetired(bool success)
    {
        _notificationMessage = $"Đã xác nhận thôi việc cho nhân viên {_selectedEmployeeForRetire?.FullName}.";
        _notificationIsSuccess = true;
        _expandedEmployeeId = null;
        _selectedEmployeeForRetire = null;

        await LoadEmployeesAsync();
        await LoadCountsAsync();
    }

    private void ToggleDeptKebab(int deptId)
    {
        _openPosKebabId = null;
        _openDeptKebabId = _openDeptKebabId == deptId ? null : deptId;
    }

    private void TogglePosKebab(int posId)
    {
        _openDeptKebabId = null;
        _openPosKebabId = _openPosKebabId == posId ? null : posId;
    }

    private void CloseAllKebabs()
    {
        _openDeptKebabId = null;
        _openPosKebabId = null;
    }

    private void OpenCreateDepartmentModal()
    {
        _departmentToEdit = null;
        _showQuickDeptModal = true;
        CloseAllKebabs();
    }

    private void OpenEditDepartmentModal(DepartmentDto dept)
    {
        _departmentToEdit = dept;
        _showQuickDeptModal = true;
        CloseAllKebabs();
    }

    private async Task HandleDepartmentSaved(DepartmentDto dept)
    {
        await LoadMasterDataAsync();
        _notificationMessage = $"Lưu thông tin phòng ban '{dept.Name}' thành công!";
        _notificationIsSuccess = true;
        await LoadEmployeesAsync();
    }

    private async Task ToggleDepartmentActiveAsync(DepartmentDto dept)
    {
        CloseAllKebabs();
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name ?? "Admin";

            if (dept.IsActive)
            {
                await EmployeeService.DeactivateDepartmentAsync(dept.Id, username);
                _notificationMessage = $"Đã ngừng sử dụng phòng ban '{dept.Name}'.";
            }
            else
            {
                await EmployeeService.ReactivateDepartmentAsync(dept.Id, username);
                _notificationMessage = $"Đã kích hoạt lại phòng ban '{dept.Name}'.";
            }
            _notificationIsSuccess = true;
            await LoadMasterDataAsync();
            await LoadEmployeesAsync();
        }
        catch (Exception ex)
        {
            _notificationMessage = $"Thao tác thất bại: {ex.Message}";
            _notificationIsSuccess = false;
        }
    }

    private void PromptDeleteDepartment(DepartmentDto dept)
    {
        _departmentToDelete = dept;
        _showDeleteDeptModal = true;
        CloseAllKebabs();
    }

    private async Task DeactivateDepartmentFromModal(DepartmentDto dept)
    {
        _showDeleteDeptModal = false;
        await ToggleDepartmentActiveAsync(dept);
    }

    private async Task ConfirmDeleteDepartmentAsync()
    {
        if (_departmentToDelete == null) return;
        _isDeleting = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name ?? "Admin";

            await EmployeeService.DeleteDepartmentAsync(_departmentToDelete.Id, username);
            _notificationMessage = $"Đã xóa vĩnh viễn phòng ban '{_departmentToDelete.Name}'.";
            _notificationIsSuccess = true;
            _showDeleteDeptModal = false;
            if (_selectedDepartmentId == _departmentToDelete.Id)
            {
                _selectedDepartmentId = null;
            }
            _departmentToDelete = null;

            await LoadMasterDataAsync();
            await LoadEmployeesAsync();
        }
        catch (Exception ex)
        {
            _notificationMessage = $"Không thể xóa phòng ban: {ex.Message}";
            _notificationIsSuccess = false;
            _showDeleteDeptModal = false;
        }
        finally
        {
            _isDeleting = false;
        }
    }

    // === Position Management Methods ===
    private void OpenCreatePositionModal()
    {
        _positionToEdit = null;
        _showQuickPosModal = true;
        CloseAllKebabs();
    }

    private void OpenEditPositionModal(PositionDto pos)
    {
        _positionToEdit = pos;
        _showQuickPosModal = true;
        CloseAllKebabs();
    }

    private async Task HandlePositionSaved(PositionDto pos)
    {
        await LoadMasterDataAsync();
        _notificationMessage = $"Lưu thông tin chức danh '{pos.Name}' thành công!";
        _notificationIsSuccess = true;
        await LoadEmployeesAsync();
    }

    private async Task TogglePositionActiveAsync(PositionDto pos)
    {
        CloseAllKebabs();
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name ?? "Admin";

            if (pos.IsActive)
            {
                await EmployeeService.DeactivatePositionAsync(pos.Id, username);
                _notificationMessage = $"Đã ngừng sử dụng chức danh '{pos.Name}'.";
            }
            else
            {
                await EmployeeService.ReactivatePositionAsync(pos.Id, username);
                _notificationMessage = $"Đã kích hoạt lại chức danh '{pos.Name}'.";
            }
            _notificationIsSuccess = true;
            await LoadMasterDataAsync();
            await LoadEmployeesAsync();
        }
        catch (Exception ex)
        {
            _notificationMessage = $"Thao tác thất bại: {ex.Message}";
            _notificationIsSuccess = false;
        }
    }

    private void PromptDeletePosition(PositionDto pos)
    {
        _positionToDelete = pos;
        _showDeletePosModal = true;
        CloseAllKebabs();
    }

    private async Task DeactivatePositionFromModal(PositionDto pos)
    {
        _showDeletePosModal = false;
        await TogglePositionActiveAsync(pos);
    }

    private async Task ConfirmDeletePositionAsync()
    {
        if (_positionToDelete == null) return;
        _isDeleting = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name ?? "Admin";

            await EmployeeService.DeletePositionAsync(_positionToDelete.Id, username);
            _notificationMessage = $"Đã xóa vĩnh viễn chức danh '{_positionToDelete.Name}'.";
            _notificationIsSuccess = true;
            _showDeletePosModal = false;
            if (_selectedPositionId == _positionToDelete.Id)
            {
                _selectedPositionId = null;
            }
            _positionToDelete = null;

            await LoadMasterDataAsync();
            await LoadEmployeesAsync();
        }
        catch (Exception ex)
        {
            _notificationMessage = $"Không thể xóa chức danh: {ex.Message}";
            _notificationIsSuccess = false;
            _showDeletePosModal = false;
        }
        finally
        {
            _isDeleting = false;
        }
    }

    private string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "NV";
        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][0].ToString().ToUpperInvariant();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }

    private class UserSelectDto
    {
        public string Id { get; set; } = string.Empty;
        public string UserName { get; set; } = string.Empty;
        public string FullName { get; set; } = string.Empty;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var uri = Navigation.ToAbsoluteUri(e.Location);
        var query = uri.Query;
        if (!string.IsNullOrEmpty(query))
        {
            bool hasTab = query.Contains("tab=requests", StringComparison.OrdinalIgnoreCase);
            var reqMatch = System.Text.RegularExpressions.Regex.Match(query, @"requestId=(\d+)");
            if (hasTab || reqMatch.Success)
            {
                if (reqMatch.Success && int.TryParse(reqMatch.Groups[1].Value, out var rId))
                {
                    _targetRequestId = rId;
                }
                _showRequestModal = true;
                InvokeAsync(StateHasChanged);
            }
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }

}
