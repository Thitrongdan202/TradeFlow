@using TradeFlow.Application.Common.Models.Documents;
@page "/nhan-vien"
@rendermode InteractiveServer
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Application.Common.Models.Employees
@using TradeFlow.Domain.Entities.Employees
@using TradeFlow.Domain.Enums
@using TradeFlow.Infrastructure.Persistence
@attribute [Authorize(Policy = "Permission:Employees:View")]

@inject IEmployeeService EmployeeService
@inject TradeFlowDbContext DbContext
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Danh sách nhân viên — TradeFlow</PageTitle>

@* Top Page Header *@
<div class="tf-page-header">
    <div class="tf-page-header-left">
        <div style="display:flex; align-items:center; gap:12px;">
            <h1 class="tf-page-title" style="margin:0;">Danh sách nhân viên</h1>
            <span class="tf-badge tf-badge-info" style="font-size:12px; font-weight:600; padding:3px 8px;">
                @_totalCount nhân viên
            </span>
        </div>
        <p class="tf-page-subtitle">Quản lý hồ sơ nhân sự, phòng ban, chức danh và yêu cầu tuyển dụng</p>
    </div>

    <div class="tf-page-actions">
        <div style="width:260px;">
            <DebouncedSearchInput Placeholder="Theo mã, tên, SĐT..."
                                  Value="@_searchTerm"
                                  ValueChanged="HandleSearchChanged"
                                  IsSearching="@_isLoading" />
        </div>

        <AuthorizeView Policy="Permission:EmployeeRequests:View">
            <button type="button" class="tf-btn tf-btn-outline" @onclick="OpenRequestModal" style="display:flex; align-items:center; gap:6px; height:36px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <polyline points="14 2 14 8 20 8"/>
                    <path d="M9 15l2 2 4-4"/>
                </svg>
                <span>Duyệt yêu cầu</span>
                @if (_pendingRequestCount > 0)
                {
                    <span class="tf-badge tf-badge-warning" style="margin-left:2px; font-size:11px; padding:1px 6px;">
                        @_pendingRequestCount
                    </span>
                }
            </button>
        </AuthorizeView>

        <AuthorizeView Policy="Permission:Employees:Create">
            <Authorized>
                <button type="button" class="tf-btn tf-btn-primary" @onclick="OpenCreateModal" style="display:flex; align-items:center; gap:6px; height:36px;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"/>
                        <line x1="5" y1="12" x2="19" y2="12"/>
                    </svg>
                    <span>Nhân viên</span>
                </button>
            </Authorized>
            <NotAuthorized>
                <AuthorizeView Policy="Permission:EmployeeRequests:Create" Context="reqCreateAuth">
                    <button type="button" class="tf-btn tf-btn-primary" @onclick="OpenCreateModal" style="display:flex; align-items:center; gap:6px; height:36px;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="12" y1="5" x2="12" y2="19"/>
                            <line x1="5" y1="12" x2="19" y2="12"/>
                        </svg>
                        <span>Gửi yêu cầu</span>
                    </button>
                </AuthorizeView>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

@if (!string.IsNullOrEmpty(_notificationMessage))
{
    <div class="tf-alert @(_notificationIsSuccess ? "tf-alert-success" : "tf-alert-error") tf-mb-4" style="display:flex; justify-content:space-between; align-items:center;">
        <span>@_notificationMessage</span>
        <button type="button" class="tf-btn-icon" @onclick="() => _notificationMessage = null" style="background:none; border:none; cursor:pointer;">✕</button>
    </div>
}

@* Main Container: Left Filter Panel + Right Table *@
<div class="tf-employee-layout" @onclick="CloseAllKebabs">
    @* Left Filter Sidebar *@
    <div class="tf-employee-sidebar">
        @* Xét duyệt hồ sơ nhanh *@
        <AuthorizeView Policy="Permission:EmployeeRequests:View">
            <div class="tf-filter-card tf-mb-4" style="background:var(--tf-bg-subtle); border-color:var(--tf-border);">
                <div class="tf-filter-header" style="display:flex; justify-content:space-between; align-items:center;">
                    <span class="tf-filter-title" style="color:var(--tf-text-primary); font-weight:600;">Xét duyệt hồ sơ</span>
                </div>
                <div class="tf-filter-body" style="padding-top:4px;">
                    <button type="button" class="tf-filter-option w-100 text-start" style="background:none; border:none; width:100%; cursor:pointer; display:flex; justify-content:space-between; align-items:center; padding:8px 10px; border-radius:6px;" @onclick="OpenRequestModal">
                        <span style="font-weight:500; color:var(--tf-primary); display:flex; align-items:center; gap:6px;">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                <path d="M9 15l2 2 4-4"/>
                            </svg>
                            Yêu cầu chờ duyệt
                        </span>
                        @if (_pendingRequestCount > 0)
                        {
                            <span class="tf-badge tf-badge-warning" style="font-size:11px; padding:2px 7px;">@_pendingRequestCount</span>
                        }
                    </button>
                </div>
            </div>
        </AuthorizeView>

        @* 1. Bộ lọc Trạng thái *@
        <div class="tf-filter-card tf-mb-4">
            <div class="tf-filter-header">
                <span class="tf-filter-title">Trạng thái</span>
            </div>
            <div class="tf-filter-body">
                <label class="tf-filter-option @(_selectedStatus == EmployeeStatus.Active ? "selected" : "")" @onclick="() => SetStatusFilter(EmployeeStatus.Active)">
                    <input type="radio" name="empStatus" checked="@(_selectedStatus == EmployeeStatus.Active)" />
                    <span>Đang làm việc</span>
                    <span class="tf-filter-count">@_activeCount</span>
                </label>
                <label class="tf-filter-option @(_selectedStatus == EmployeeStatus.Retired ? "selected" : "")" @onclick="() => SetStatusFilter(EmployeeStatus.Retired)">
                    <input type="radio" name="empStatus" checked="@(_selectedStatus == EmployeeStatus.Retired)" />
                    <span>Đã nghỉ</span>
                    <span class="tf-filter-count">@_retiredCount</span>
                </label>
            </div>
        </div>

        @* 2. Bộ lọc Phòng ban *@
        <div class="tf-filter-card tf-mb-4">
            <div class="tf-filter-header" style="display:flex; justify-content:space-between; align-items:center;">
                <span class="tf-filter-title">Phòng ban</span>
                <AuthorizeView Policy="Permission:Departments:Create">
                    <button type="button" class="tf-link-action" @onclick="OpenCreateDepartmentModal">
                        + Tạo mới
                    </button>
                </AuthorizeView>
            </div>
            <div class="tf-filter-body">
                <div class="tf-filter-item-row @(_selectedDepartmentId == null ? "selected" : "")" @onclick="() => SetDepartmentFilter(null)">
                    <div class="tf-filter-item-name">
                        <span>Tất cả phòng ban</span>
                    </div>
                </div>
                @foreach (var dept in _departments)
                {
                    <div class="tf-filter-item-row @(_selectedDepartmentId == dept.Id ? "selected" : "")">
                        <div class="tf-filter-item-name" @onclick="() => SetDepartmentFilter(dept.Id)" title="@dept.Name">
                            <span style="@(!dept.IsActive ? "opacity:0.6; text-decoration:line-through;" : "")">@dept.Name</span>
                            @if (!dept.IsActive)
                            {
                                <span class="tf-badge tf-badge-secondary" style="font-size:10px; padding:1px 5px; margin-left:4px;">Ngừng</span>
                            }
                            @if (dept.EmployeeCount > 0)
                            {
                                <span class="tf-filter-count" style="margin-left:auto;">@dept.EmployeeCount</span>
                            }
                        </div>
                        <div class="tf-kebab-container" @onclick:stopPropagation="true">
                            <button type="button" class="tf-kebab-btn @(_openDeptKebabId == dept.Id ? "active" : "")"
                                    title="Tùy chọn @dept.Name"
                                    aria-label="Tùy chọn @dept.Name"
                                    @onclick="() => ToggleDeptKebab(dept.Id)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                                    <circle cx="12" cy="5" r="2"/>
                                    <circle cx="12" cy="12" r="2"/>
                                    <circle cx="12" cy="19" r="2"/>
                                </svg>
                            </button>
                            @if (_openDeptKebabId == dept.Id)
                            {
                                <div class="tf-kebab-menu" @onclick:stopPropagation="true">
                                    <button type="button" class="tf-kebab-menu-item" @onclick="() => OpenEditDepartmentModal(dept)">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M12 20h9"/>
                                            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
                                        </svg>
                                        <span>Chỉnh sửa</span>
                                    </button>
                                    @if (dept.IsActive)
                                    {
                                        <button type="button" class="tf-kebab-menu-item" @onclick="() => ToggleDepartmentActiveAsync(dept)">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <circle cx="12" cy="12" r="10"/>
                                                <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
                                            </svg>
                                            <span>Ngừng sử dụng</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="tf-kebab-menu-item" @onclick="() => ToggleDepartmentActiveAsync(dept)">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <polyline points="20 6 9 17 4 12"/>
                                            </svg>
                                            <span style="color:var(--tf-success, #16a34a);">Kích hoạt lại</span>
                                        </button>
                                    }
                                    <button type="button" class="tf-kebab-menu-item tf-kebab-menu-item-danger" @onclick="() => PromptDeleteDepartment(dept)">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <polyline points="3 6 5 6 21 6"/>
                                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                        </svg>
                                        <span>Xóa phòng ban</span>
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* 3. Bộ lọc Chức danh *@
        <div class="tf-filter-card">
            <div class="tf-filter-header" style="display:flex; justify-content:space-between; align-items:center;">
                <span class="tf-filter-title">Chức danh</span>
                <AuthorizeView Policy="Permission:Positions:Create">
                    <button type="button" class="tf-link-action" @onclick="OpenCreatePositionModal">
                        + Tạo mới
                    </button>
                </AuthorizeView>
            </div>
            <div class="tf-filter-body">
                <div class="tf-filter-item-row @(_selectedPositionId == null ? "selected" : "")" @onclick="() => SetPositionFilter(null)">
                    <div class="tf-filter-item-name">
                        <span>Tất cả chức danh</span>
                    </div>
                </div>
                @foreach (var pos in _positions)
                {
                    <div class="tf-filter-item-row @(_selectedPositionId == pos.Id ? "selected" : "")">
                        <div class="tf-filter-item-name" @onclick="() => SetPositionFilter(pos.Id)" title="@pos.Name">
                            <span style="@(!pos.IsActive ? "opacity:0.6; text-decoration:line-through;" : "")">@pos.Name</span>
                            @if (!pos.IsActive)
                            {
                                <span class="tf-badge tf-badge-secondary" style="font-size:10px; padding:1px 5px; margin-left:4px;">Ngừng</span>
                            }
                            @if (pos.EmployeeCount > 0)
                            {
                                <span class="tf-filter-count" style="margin-left:auto;">@pos.EmployeeCount</span>
                            }
                        </div>
                        <div class="tf-kebab-container" @onclick:stopPropagation="true">
                            <button type="button" class="tf-kebab-btn @(_openPosKebabId == pos.Id ? "active" : "")"
                                    title="Tùy chọn @pos.Name"
                                    aria-label="Tùy chọn @pos.Name"
                                    @onclick="() => TogglePosKebab(pos.Id)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                                    <circle cx="12" cy="5" r="2"/>
                                    <circle cx="12" cy="12" r="2"/>
                                    <circle cx="12" cy="19" r="2"/>
                                </svg>
                            </button>
                            @if (_openPosKebabId == pos.Id)
                            {
                                <div class="tf-kebab-menu" @onclick:stopPropagation="true">
                                    <button type="button" class="tf-kebab-menu-item" @onclick="() => OpenEditPositionModal(pos)">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M12 20h9"/>
                                            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
                                        </svg>
                                        <span>Chỉnh sửa</span>
                                    </button>
                                    @if (pos.IsActive)
                                    {
                                        <button type="button" class="tf-kebab-menu-item" @onclick="() => TogglePositionActiveAsync(pos)">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <circle cx="12" cy="12" r="10"/>
                                                <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
                                            </svg>
                                            <span>Ngừng sử dụng</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="tf-kebab-menu-item" @onclick="() => TogglePositionActiveAsync(pos)">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <polyline points="20 6 9 17 4 12"/>
                                            </svg>
                                            <span style="color:var(--tf-success, #16a34a);">Kích hoạt lại</span>
                                        </button>
                                    }
                                    <button type="button" class="tf-kebab-menu-item tf-kebab-menu-item-danger" @onclick="() => PromptDeletePosition(pos)">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <polyline points="3 6 5 6 21 6"/>
                                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                        </svg>
                                        <span>Xóa chức danh</span>
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    @* Right Main Employee Table *@
    <div class="tf-employee-main">
        <div class="tf-card" style="margin-bottom:0; overflow:hidden;">
            <div class="tf-card-body" style="padding:0; overflow-x:auto;">
                @if (_isLoading && _employees.Count == 0)
                {
                    <div style="padding:16px;">
                        <Skeleton Type="table" Rows="8" Columns="10" />
                    </div>
                }
                else if (!_employees.Any())
                {
                    <div class="tf-empty" style="padding:60px 20px;">
                        <div class="tf-empty-icon">
                            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="7" r="4"/>
                                <path d="M6 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"/>
                            </svg>
                        </div>
                        <div class="tf-empty-title">Chưa có dữ liệu nhân viên</div>
                        <div class="tf-empty-desc">
                            Không tìm thấy nhân viên nào phù hợp với bộ lọc và điều kiện tìm kiếm.
                        </div>
                    </div>
                }
                else
                {
                    <TableLoadingOverlay IsLoading="@_isLoading" LoadingText="Đang cập nhật danh sách nhân viên...">
                    <table class="tf-table tf-employee-table">
                        <thead>
                            <tr>
                                <th style="width:36px; text-align:center;">
                                    <input type="checkbox" />
                                </th>
                                <th style="width:40px; text-align:center;"></th>
                                <th style="width:110px;">Mã NV</th>
                                <th style="width:110px;">Mã chấm công</th>
                                <th>Tên nhân viên</th>
                                <th style="width:120px;">Điện thoại</th>
                                <th style="width:130px;">CMND/CCCD</th>
                                <th style="width:130px; text-align:right;">Nợ &amp; tạm ứng</th>
                                <th>Ghi chú</th>
                                <th style="width:80px; text-align:center;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int empIndex = 0; empIndex < _employees.Count; empIndex++)
                            {
                                var emp = _employees[empIndex];
                                bool isExpanded = _expandedEmployeeId == emp.Id;
                                bool isEditing = _editingEmployeeId == emp.Id;
                                bool isMenuOpen = _activeActionMenuEmpId == emp.Id;
                                bool isNearBottom = empIndex >= _employees.Count - 2;

                                <tr class="tf-emp-row @(isExpanded ? "is-expanded" : "")" @onclick="() => ToggleExpand(emp.Id)">
                                    <td style="text-align:center;" @onclick:stopPropagation="true">
                                        <input type="checkbox" />
                                    </td>
                                    <td style="text-align:center; padding:6px 0;">
                                        <div class="tf-emp-avatar">
                                            @GetInitials(emp.FullName)
                                        </div>
                                    </td>
                                    <td>
                                        <span class="tf-emp-code">@emp.Code</span>
                                    </td>
                                    <td>
                                        <span class="tf-emp-attendance">@(emp.AttendanceCode ?? "—")</span>
                                    </td>
                                    <td>
                                        <div style="font-weight:600; color:var(--tf-text-primary);">@emp.FullName</div>
                                        @if (!string.IsNullOrEmpty(emp.PositionName) || !string.IsNullOrEmpty(emp.DepartmentName))
                                        {
                                            <div style="font-size:12px; color:var(--tf-text-muted);">
                                                @(emp.PositionName ?? "")@(!string.IsNullOrEmpty(emp.PositionName) && !string.IsNullOrEmpty(emp.DepartmentName) ? " • " : "")@(emp.DepartmentName ?? "")
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <span>@(emp.Phone ?? "—")</span>
                                    </td>
                                    <td>
                                        <span>@(emp.NationalId ?? "—")</span>
                                    </td>
                                    <td style="text-align:right; font-variant-numeric:tabular-nums; font-weight:500;">
                                        @emp.DebtAndAdvance.ToString("N0") ₫
                                    </td>
                                    <td>
                                        <span class="tf-truncate" title="@emp.Notes">@(emp.Notes ?? "—")</span>
                                    </td>
                                    <td class="tf-table-act-cell" style="text-align:center;" @onclick:stopPropagation="true">
                                        <div class="tf-table-act-wrap">
                                            <button type="button" class="tf-table-act-btn @(isMenuOpen ? "is-active" : "")" 
                                                    title="Thao tác" 
                                                    aria-label="Thao tác cho @emp.FullName"
                                                    aria-expanded="@isMenuOpen.ToString().ToLowerInvariant()"
                                                    @onclick="() => ToggleActionMenu(emp.Id)">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <circle cx="12" cy="12" r="1.5" fill="currentColor"/>
                                                    <circle cx="12" cy="5" r="1.5" fill="currentColor"/>
                                                    <circle cx="12" cy="19" r="1.5" fill="currentColor"/>
                                                </svg>
                                            </button>

                                            @if (isMenuOpen)
                                            {
                                                <div class="tf-table-act-backdrop" @onclick="CloseActionMenu"></div>
                                                <div class="tf-table-act-menu @(isNearBottom ? "menu-upwards" : "")" role="menu" @onclick:stopPropagation="true">
                                                    <button type="button" class="tf-table-act-item" role="menuitem" @onclick="async () => { await ToggleExpand(emp.Id); CloseActionMenu(); }">
                                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                                            <circle cx="12" cy="12" r="3"/>
                                                        </svg>
                                                        <span>@(isExpanded ? "Thu gọn chi tiết" : "Xem chi tiết hồ sơ")</span>
                                                    </button>

                                                    <AuthorizeView Policy="Permission:Employees:Edit">
                                                        <button type="button" class="tf-table-act-item" role="menuitem" @onclick="() => HandleEditFromMenu(emp)">
                                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                <path d="M12 20h9"/>
                                                                <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
                                                            </svg>
                                                            <span>Chỉnh sửa thông tin</span>
                                                        </button>
                                                    </AuthorizeView>

                                                    <button type="button" class="tf-table-act-item" role="menuitem" @onclick="() => NavigateToContract(emp)">
                                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                                            <polyline points="14 2 14 8 20 8"/>
                                                            <line x1="16" y1="13" x2="8" y2="13"/>
                                                            <line x1="16" y1="17" x2="8" y2="17"/>
                                                        </svg>
                                                        <span>Soạn hợp đồng lao động</span>
                                                    </button>

                                                    @if (emp.Status == EmployeeStatus.Active)
                                                    {
                                                        <AuthorizeView Policy="Permission:Employees:Edit">
                                                            <div class="tf-table-act-divider"></div>
                                                            <button type="button" class="tf-table-act-item is-danger" role="menuitem" @onclick="() => HandleRetireFromMenu(emp)">
                                                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                    <circle cx="12" cy="12" r="10"/>
                                                                    <line x1="15" y1="9" x2="9" y2="15"/>
                                                                    <line x1="9" y1="9" x2="15" y2="15"/>
                                                                </svg>
                                                                <span>Thôi việc nhân viên</span>
                                                            </button>
                                                        </AuthorizeView>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </td>
                                </tr>

                                @* Inline Expanded Row *@
                                @if (isExpanded)
                                {
                                    <tr class="tf-emp-detail-tr">
                                        <td colspan="10" class="tf-emp-expanded-td" style="padding:0; background-color:var(--tf-bg-card); border-bottom:2px solid var(--tf-border);">
                                            <div class="tf-emp-expanded-box">
                                                @* Expanded Header Bar *@
                                                <div class="tf-emp-expanded-header">
                                                    <div style="display:flex; align-items:center; gap:16px;">
                                                        <div class="tf-emp-avatar-lg">
                                                            @GetInitials(emp.FullName)
                                                        </div>
                                                        <div>
                                                            <div style="display:flex; align-items:center; gap:10px;">
                                                                <h2 style="margin:0; font-size:18px; font-weight:700; color:var(--tf-text-primary);">@emp.FullName</h2>
                                                                <span class="tf-emp-badge-code">@emp.Code</span>
                                                                @if (emp.Status == EmployeeStatus.Active)
                                                                {
                                                                    <span class="tf-badge tf-badge-success" style="display:flex; align-items:center; gap:4px; font-size:12px;">
                                                                        <span style="width:6px; height:6px; border-radius:50%; background:#16a34a;"></span>
                                                                        Đang làm việc
                                                                    </span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="tf-badge tf-badge-secondary" style="display:flex; align-items:center; gap:4px; font-size:12px;">
                                                                        <span style="width:6px; height:6px; border-radius:50%; background:#64748b;"></span>
                                                                        Đã nghỉ
                                                                    </span>
                                                                }
                                                            </div>
                                                            <div style="font-size:13px; color:var(--tf-text-muted); margin-top:4px;">
                                                                @(emp.DepartmentName ?? "Chưa phân phòng ban")
                                                                @if (!string.IsNullOrEmpty(emp.PositionName))
                                                                {
                                                                    <span> • @emp.PositionName</span>
                                                                }
                                                                @if (!string.IsNullOrEmpty(emp.UserName))
                                                                {
                                                                    <span> • Tài khoản: <strong style="color:var(--tf-primary);">@emp.UserName</strong></span>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="tf-emp-expanded-actions">
                                                        @if (isEditing)
                                                        {
                                                            <button type="button" class="tf-btn tf-btn-ghost tf-btn-sm" @onclick="CancelInlineEdit" disabled="@_isSavingInline">
                                                                Hủy
                                                            </button>
                                                            <LoadingButton Class="tf-btn tf-btn-primary tf-btn-sm"
                                                                           IsLoading="@_isSavingInline"
                                                                           LoadingText="Đang lưu..."
                                                                           OnClick="SaveInlineEdit">
                                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:4px;">
                                                                    <polyline points="20 6 9 17 4 12"/>
                                                                </svg>
                                                                <span>Lưu thay đổi</span>
                                                            </LoadingButton>
                                                        }
                                                        else
                                                        {
                                                            <AuthorizeView Policy="Permission:Employees:Edit">
                                                                <button type="button" class="tf-btn tf-btn-outline tf-btn-sm" @onclick="() => StartInlineEdit(emp)" style="display:flex; align-items:center; gap:4px;">
                                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                        <path d="M12 20h9"/>
                                                                        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
                                                                    </svg>
                                                                    Chỉnh sửa
                                                                </button>
                                                            </AuthorizeView>

                                                            @if (emp.Status == EmployeeStatus.Active)
                                                            {
                                                                <AuthorizeView Policy="Permission:Employees:Edit">
                                                                    <button type="button" class="tf-btn tf-btn-outline-danger tf-btn-sm" @onclick="() => OpenRetireModal(emp)" style="display:flex; align-items:center; gap:4px;">
                                                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                            <circle cx="12" cy="12" r="10"/>
                                                                            <line x1="15" y1="9" x2="9" y2="15"/>
                                                                            <line x1="9" y1="9" x2="15" y2="15"/>
                                                                        </svg>
                                                                        Thôi việc
                                                                    </button>
                                                                </AuthorizeView>
                                                            }

                                                            <button type="button" class="tf-btn tf-btn-ghost tf-btn-sm" @onclick="() => ToggleExpand(emp.Id)">
                                                                Đóng
                                                            </button>
                                                        }
                                                    </div>
                                                </div>

                                                @* Inline Mode Switch: View vs Edit *@
                                                @if (isEditing && _inlineEditModel != null)
                                                {
                                                    @* 3 Columns Edit Mode *@
                                                    <div class="tf-emp-detail-grid">
                                                        @* Col 1 Edit *@
                                                        <div class="tf-emp-detail-col">
                                                            <div class="tf-emp-section-heading">Thông tin nhân sự</div>
                                                            <div class="tf-form-group tf-mb-3">
                                                                <label class="tf-label">Họ và tên <span class="tf-text-danger">*</span></label>
                                                                <input type="text" class="tf-input" @bind="_inlineEditModel.FullName" />
                                                            </div>
                                                            <div class="tf-form-group tf-mb-3">
                                                                <label class="tf-label">Điện thoại</label>
                                                                <input type="text" class="tf-input" @bind="_inlineEditModel.Phone" />
                                                            </div>
                                                            <div class="tf-form-group tf-mb-3">
                                                                <label class="tf-label">Phòng ban</label>
                                                                <select class="tf-input" @bind="_inlineEditModel.DepartmentId">
                                                                    <option value="">-- Chọn phòng ban --</option>
                                                                    @foreach (var d in _departments.Where(d => d.IsActive || d.Id == _inlineEditModel.DepartmentId))
                                                                    {
                                                                        <option value="@d.Id">@d.Name</option>
                                                                    }
                                                                </select>
                                                            </div>
                                                            <div class="tf-form-group tf-mb-3">
                                                                <label class="tf-label">Số CMND / CCCD</label>
                                                                <input type="text" class="tf-input" @bind="_inlineEditModel.NationalId" />
                                                            </div>
                                                            <div class="tf-form-group tf-mb-3">
                                                                <label class="tf-label">Địa chỉ</label>
                                                                <input type="text" class="tf-input" @bind="_inlineEditModel.Address" />
                                                            </div>
                                                            <div class="tf-form-group tf-mb-3">
                                                                <label class="tf-label">Ngày bắt đầu làm việc</label>
                                                                <TfDateInput @bind-Value="_inlineEditModel.StartDate" Placeholder="dd/MM/yyyy" />
                                                            </div>
                                                            <div class="tf-form-group">
                                                                <label class="tf-label">Thông tin ngân hàng</label>
                                                                <input type="text" class="tf-input" @bind="_inlineEditModel.BankInformation" placeholder="Số TK, Ngân hàng, Chi nhánh" />
                                                            </div>
                                                        </div>

                                                        @* Col 2 Edit *@
                                                        <div class="tf-emp-detail-col">
                                                            <div class="tf-emp-section-heading">Vị trí &amp; Tổ chức</div>
                                                            <div class="tf-form-group tf-mb-3">
                                                                <label class="tf-label">Chức danh</label>
                                                                <select class="tf-input" @bind="_inlineEditModel.PositionId">
                                                                    <option value="">-- Chọn chức danh --</option>
                                                                    @foreach (var p in _positions.Where(p => p.IsActive || p.Id == _inlineEditModel.PositionId))
                                                                    {
                                                                        <option value="@p.Id">@p.Name</option>
                                                                    }
                                                                </select>
                                                            </div>
                                                            <div class="tf-form-group tf-mb-3">
                                                                <label class="tf-label">Chi nhánh tính lương</label>
                                                                <input type="text" class="tf-input" @bind="_inlineEditModel.PayrollBranch" />
                                                            </div>
                                                            <div class="tf-form-group tf-mb-3">
                                                                <label class="tf-label">Ngày sinh</label>
                                                                <TfDateInput @bind-Value="_inlineEditModel.DateOfBirth" Placeholder="dd/MM/yyyy" />
                                                            </div>
                                                            <div class="tf-form-group tf-mb-3">
                                                                <label class="tf-label">Email</label>
                                                                <input type="email" class="tf-input" @bind="_inlineEditModel.Email" />
                                                            </div>
                                                            <div class="tf-form-group tf-mb-3">
                                                                <label class="tf-label">Mã chấm công</label>
                                                                <input type="text" class="tf-input" @bind="_inlineEditModel.AttendanceCode" />
                                                            </div>
                                                            <div class="tf-form-group">
                                                                <label class="tf-label">Ghi chú</label>
                                                                <textarea class="tf-input" rows="2" @bind="_inlineEditModel.Notes"></textarea>
                                                            </div>
                                                        </div>

                                                        @* Col 3 Edit *@
                                                        <div class="tf-emp-detail-col">
                                                            <div class="tf-emp-section-heading">Hệ thống &amp; Khác</div>
                                                            <div class="tf-form-group tf-mb-3">
                                                                <label class="tf-label">Chi nhánh làm việc</label>
                                                                <input type="text" class="tf-input" @bind="_inlineEditModel.WorkingBranch" />
                                                            </div>
                                                            <div class="tf-form-group tf-mb-3">
                                                                <label class="tf-label">Tài khoản TradeFlow</label>
                                                                <select class="tf-input" @bind="_inlineEditModel.UserId">
                                                                    <option value="">-- Chưa liên kết tài khoản --</option>
                                                                    @foreach (var u in _availableUsersForEdit)
                                                                    {
                                                                        <option value="@u.Id">@u.UserName (@u.FullName)</option>
                                                                    }
                                                                </select>
                                                            </div>
                                                            <div class="tf-form-group tf-mb-3">
                                                                <label class="tf-label">Giới tính</label>
                                                                <select class="tf-input" @bind="_inlineEditModel.Gender">
                                                                    <option value="Nam">Nam</option>
                                                                    <option value="Nữ">Nữ</option>
                                                                    <option value="Khác">Khác</option>
                                                                </select>
                                                            </div>
                                                            <div class="tf-form-group tf-mb-3">
                                                                <label class="tf-label">Facebook</label>
                                                                <input type="text" class="tf-input" @bind="_inlineEditModel.Facebook" />
                                                            </div>
                                                            <div class="tf-form-group">
                                                                <label class="tf-label">Nợ &amp; tạm ứng (VNĐ)</label>
                                                                <input type="number" class="tf-input" @bind="_inlineEditModel.DebtAndAdvance" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    @* 3 Columns View Mode *@
                                                    <div class="tf-emp-detail-grid">
                                                        @* Col 1 View *@
                                                        <div class="tf-emp-detail-col">
                                                            <div class="tf-emp-section-heading">Thông tin nhân sự</div>
                                                            <div class="tf-emp-field">
                                                                <span class="tf-emp-field-label">Điện thoại:</span>
                                                                <span class="tf-emp-field-value">@(emp.Phone ?? "—")</span>
                                                            </div>
                                                            <div class="tf-emp-field">
                                                                <span class="tf-emp-field-label">Phòng ban:</span>
                                                                <span class="tf-emp-field-value">@(emp.DepartmentName ?? "—")</span>
                                                            </div>
                                                            <div class="tf-emp-field">
                                                                <span class="tf-emp-field-label">Số CMND / CCCD:</span>
                                                                <span class="tf-emp-field-value">@(emp.NationalId ?? "—")</span>
                                                            </div>
                                                            <div class="tf-emp-field">
                                                                <span class="tf-emp-field-label">Địa chỉ:</span>
                                                                <span class="tf-emp-field-value">@(emp.Address ?? "—")</span>
                                                            </div>
                                                            <div class="tf-emp-field">
                                                                <span class="tf-emp-field-label">Ngày bắt đầu làm việc:</span>
                                                                <span class="tf-emp-field-value">@(emp.StartDate?.ToString("dd/MM/yyyy") ?? "—")</span>
                                                            </div>
                                                            <div class="tf-emp-field">
                                                                <span class="tf-emp-field-label">Tài khoản ngân hàng:</span>
                                                                <span class="tf-emp-field-value">@(emp.BankInformation ?? "—")</span>
                                                            </div>
                                                        </div>

                                                        @* Col 2 View *@
                                                        <div class="tf-emp-detail-col">
                                                            <div class="tf-emp-section-heading">Vị trí &amp; Tổ chức</div>
                                                            <div class="tf-emp-field">
                                                                <span class="tf-emp-field-label">Chi nhánh tính lương:</span>
                                                                <span class="tf-emp-field-value">@(emp.PayrollBranch ?? "—")</span>
                                                            </div>
                                                            <div class="tf-emp-field">
                                                                <span class="tf-emp-field-label">Chức danh:</span>
                                                                <span class="tf-emp-field-value">@(emp.PositionName ?? "—")</span>
                                                            </div>
                                                            <div class="tf-emp-field">
                                                                <span class="tf-emp-field-label">Ngày sinh:</span>
                                                                <span class="tf-emp-field-value">@(emp.DateOfBirth?.ToString("dd/MM/yyyy") ?? "—")</span>
                                                            </div>
                                                            <div class="tf-emp-field">
                                                                <span class="tf-emp-field-label">Email:</span>
                                                                <span class="tf-emp-field-value">@(emp.Email ?? "—")</span>
                                                            </div>
                                                            <div class="tf-emp-field">
                                                                <span class="tf-emp-field-label">Mã chấm công:</span>
                                                                <span class="tf-emp-field-value">@(emp.AttendanceCode ?? "—")</span>
                                                            </div>
                                                            <div class="tf-emp-field">
                                                                <span class="tf-emp-field-label">Ghi chú:</span>
                                                                <span class="tf-emp-field-value">@(emp.Notes ?? "—")</span>
                                                            </div>
                                                        </div>

                                                        @* Col 3 View *@
                                                        <div class="tf-emp-detail-col">
                                                            <div class="tf-emp-section-heading">Hệ thống &amp; Khác</div>
                                                            <div class="tf-emp-field">
                                                                <span class="tf-emp-field-label">Chi nhánh làm việc:</span>
                                                                <span class="tf-emp-field-value">@(emp.WorkingBranch ?? "—")</span>
                                                            </div>
                                                            <div class="tf-emp-field">
                                                                <span class="tf-emp-field-label">Tài khoản TradeFlow:</span>
                                                                <span class="tf-emp-field-value">
                                                                    @if (!string.IsNullOrEmpty(emp.UserName))
                                                                    {
                                                                        <strong style="color:var(--tf-primary);">@emp.UserName</strong>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span style="color:#94a3b8;">Chưa liên kết</span>
                                                                    }
                                                                </span>
                                                            </div>
                                                            <div class="tf-emp-field">
                                                                <span class="tf-emp-field-label">Giới tính:</span>
                                                                <span class="tf-emp-field-value">@(emp.Gender ?? "—")</span>
                                                            </div>
                                                            <div class="tf-emp-field">
                                                                <span class="tf-emp-field-label">Facebook:</span>
                                                                <span class="tf-emp-field-value">@(emp.Facebook ?? "—")</span>
                                                            </div>
                                                            <div class="tf-emp-field">
                                                                <span class="tf-emp-field-label">Nợ &amp; tạm ứng:</span>
                                                                <span class="tf-emp-field-value" style="font-weight:600;">@emp.DebtAndAdvance.ToString("N0") ₫</span>
                                                            </div>
                                                            @if (emp.Status == EmployeeStatus.Retired)
                                                            {
                                                                <div class="tf-emp-field" style="background:rgba(239, 68, 68, 0.12); border:1px solid rgba(239, 68, 68, 0.25); padding:8px 12px; border-radius:6px; margin-top:8px;">
                                                                    <span class="tf-emp-field-label" style="color:var(--tf-danger, #ef4444); font-weight:600;">Ngày thôi việc:</span>
                                                                    <span class="tf-emp-field-value" style="color:var(--tf-danger, #ef4444); font-weight:600;">
                                                                        @(emp.TerminationDate?.ToString("dd/MM/yyyy") ?? "—")
                                                                    </span>
                                                                </div>
                                                                @if (!string.IsNullOrEmpty(emp.TerminationReason))
                                                                {
                                                                    <div class="tf-emp-field" style="background:rgba(239, 68, 68, 0.08); border:1px solid rgba(239, 68, 68, 0.2); padding:8px 12px; border-radius:6px; margin-top:4px;">
                                                                        <span class="tf-emp-field-label" style="color:var(--tf-danger, #ef4444);">Lý do:</span>
                                                                        <span class="tf-emp-field-value" style="color:var(--tf-text-primary);">@emp.TerminationReason</span>
                                                                    </div>
                                                                }
                                                            }
                                                        </div>
                                                    </div>

                                                    @* Hồ sơ cá nhân & Tài liệu đính kèm *@
                                                    <div style="margin-top: 14px; padding: 12px 16px; border-radius: 8px; background: var(--tf-bg-surface, #1e2028); border: 1px solid var(--tf-border, #2e3542);">
                                                        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
                                                            <div style="font-weight: 600; font-size: 13.5px; color: var(--tf-text-primary); display: flex; align-items: center; gap: 8px;">
                                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--tf-primary);">
                                                                    <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/>
                                                                </svg>
                                                                <span>Hồ sơ cá nhân &amp; Tài liệu đính kèm</span>
                                                                <span class="tf-badge tf-badge-info" style="font-size: 11px;">@(_expandedAttachments.Count) tệp</span>
                                                            </div>
                                                        </div>

                                                        @if (_expandedAttachments.Any())
                                                        {
                                                            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 8px;">
                                                                @foreach (var doc in _expandedAttachments)
                                                                {
                                                                    <div style="display: flex; align-items: center; justify-content: space-between; padding: 8px 12px; background: var(--tf-bg-card); border: 1px solid var(--tf-border); border-radius: 6px; font-size: 12.5px;">
                                                                        <div style="min-width: 0; flex: 1; margin-right: 8px;">
                                                                            <div style="display: flex; align-items: center; gap: 6px;">
                                                                                <span class="tf-badge tf-badge-info" style="font-size: 10px; padding: 1px 5px;">
                                                                                    @(doc.CategoryName ?? "Hồ sơ cá nhân")
                                                                                </span>
                                                                                <span style="font-weight: 600; color: var(--tf-text-primary); text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">
                                                                                    @doc.FileName
                                                                                </span>
                                                                            </div>
                                                                            <div style="font-size: 11px; color: var(--tf-text-muted); margin-top: 2px;">
                                                                                @doc.FormattedFileSize • @doc.CreatedAt.ToString("dd/MM/yyyy")
                                                                            </div>
                                                                        </div>
                                                                        <div style="display: flex; gap: 4px; flex-shrink: 0;">
                                                                            <a href="/api/documents/@doc.Id/preview" target="_blank" class="tf-btn tf-btn-sm tf-btn-outline-primary" style="padding: 2px 8px; font-size: 11px;" title="Xem trước tài liệu">Xem</a>
                                                                            <a href="/api/documents/@doc.Id/download" class="tf-btn tf-btn-sm tf-btn-outline-secondary" style="padding: 2px 8px; font-size: 11px;" title="Tải về" download>Tải</a>
                                                                        </div>
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div style="font-size: 12px; color: var(--tf-text-muted); font-style: italic;">
                                                                Chưa có hồ sơ tài liệu đính kèm nào được lưu trữ cho nhân viên này.
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                    </TableLoadingOverlay>
                }
            </div>
        </div>
    </div>
</div>

@* Child Modals *@
    <EmployeeFormModal @bind-IsOpen="_showCreateModal" OnEmployeeSaved="HandleEmployeeSaved" PreloadedRequest="_formPreloadedRequest" IsResubmitMode="_isFormResubmitMode" IsCloneMode="_isFormCloneMode" PreloadedDepartments="_departments" PreloadedPositions="_positions" />
    <EmployeeRequestModal IsOpen="_showRequestModal" IsOpenChanged="HandleRequestModalClosed" TargetRequestId="_targetRequestId" OnRequestsChanged="HandleRequestsChanged" OnResubmitRequested="HandleResubmitRequested" OnCloneRequested="HandleCloneRequested" />
<RetireEmployeeModal @bind-IsOpen="_showRetireModal" Employee="_selectedEmployeeForRetire" OnEmployeeRetired="HandleEmployeeRetired" />
<QuickDepartmentModal @bind-IsOpen="_showQuickDeptModal" DepartmentToEdit="_departmentToEdit" OnDepartmentSaved="HandleDepartmentSaved" />
<QuickPositionModal @bind-IsOpen="_showQuickPosModal" PositionToEdit="_positionToEdit" OnPositionSaved="HandlePositionSaved" />

@* Safe Deletion Confirmation Modal for Department *@
@if (_showDeleteDeptModal && _departmentToDelete != null)
{
    <div class="tf-modal-overlay" @onclick="() => _showDeleteDeptModal = false">
        <div class="tf-modal tf-modal-md" @onclick:stopPropagation="true">
            <div class="tf-modal-header" style="background-color: @(_departmentToDelete.EmployeeCount > 0 ? "rgba(245, 158, 11, 0.1)" : "rgba(239, 68, 68, 0.1)"); border-bottom: 1px solid var(--tf-border);">
                <h3 class="tf-modal-title" style="color: @(_departmentToDelete.EmployeeCount > 0 ? "var(--tf-warning, #d97706)" : "var(--tf-danger, #dc2626)"); display:flex; align-items:center; gap:8px;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        @if (_departmentToDelete.EmployeeCount > 0)
                        {
                            <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                        }
                        else
                        {
                            <polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                        }
                    </svg>
                    @(_departmentToDelete.EmployeeCount > 0 ? "Không thể xóa phòng ban" : "Xác nhận xóa phòng ban")
                </h3>
                <button type="button" class="tf-modal-close-btn" @onclick="() => _showDeleteDeptModal = false" aria-label="Đóng" title="Đóng">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                </button>
            </div>
            <div class="tf-modal-body">
                @if (_departmentToDelete.EmployeeCount > 0)
                {
                    <div style="padding: 12px 16px; background-color: var(--tf-bg-subtle); border-radius: 8px; border: 1px solid var(--tf-border); margin-bottom: 16px;">
                        <p style="margin: 0; font-size: 14px; color: var(--tf-text-primary); line-height: 1.6;">
                            Phòng ban <strong>@_departmentToDelete.Name</strong> hiện đang có <strong style="color:var(--tf-primary);">@_departmentToDelete.EmployeeCount nhân viên</strong> trực thuộc.
                        </p>
                    </div>
                    <p style="font-size: 13px; color: var(--tf-text-secondary); line-height: 1.5; margin: 0 0 16px 0;">
                        Để đảm bảo tính toàn vẹn dữ liệu hồ sơ nhân sự, hệ thống không cho phép xóa vĩnh viễn phòng ban đang được liên kết. Bạn có thể chọn <strong>Ngừng sử dụng</strong> để ẩn phòng ban này khỏi danh sách tạo mới nhân viên mà vẫn bảo lưu đầy đủ lịch sử dữ liệu.
                    </p>
                }
                else
                {
                    <p style="font-size: 14px; color: var(--tf-text-primary); line-height: 1.6; margin: 0 0 16px 0;">
                        Bạn có chắc chắn muốn xóa vĩnh viễn phòng ban <strong>@_departmentToDelete.Name</strong> (Mã: <code>@_departmentToDelete.Code</code>) không?
                    </p>
                    <p style="font-size: 12px; color: var(--tf-text-muted); margin: 0;">
                        Hành động này không thể hoàn tác sau khi xác nhận.
                    </p>
                }
            </div>
            <div class="tf-modal-footer">
                <button type="button" class="tf-btn tf-btn-ghost" @onclick="() => _showDeleteDeptModal = false">Đóng</button>
                @if (_departmentToDelete.EmployeeCount > 0)
                {
                    <button type="button" class="tf-btn tf-btn-warning" @onclick="() => DeactivateDepartmentFromModal(_departmentToDelete)">
                        Ngừng sử dụng phòng ban này
                    </button>
                }
                else
                {
                    <button type="button" class="tf-btn tf-btn-danger" @onclick="ConfirmDeleteDepartmentAsync" disabled="@_isDeleting">
                        @if (_isDeleting)
                        {
                            <span class="tf-spinner-sm tf-mr-2"></span>
                            <span>Đang xóa...</span>
                        }
                        else
                        {
                            <span>Xác nhận xóa</span>
                        }
                    </button>
                }
            </div>
        </div>
    </div>
}

