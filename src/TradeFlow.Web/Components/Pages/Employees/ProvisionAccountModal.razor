@using Microsoft.AspNetCore.Components.Authorization
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Application.Common.Models.Employees

@inject IEmployeeAccountService EmployeeAccountService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

@if (IsOpen && Employee != null)
{
    <div class="tf-modal-backdrop" @onclick="CloseModal">
        <div class="tf-modal-dialog" style="max-width: 540px;" @onclick:stopPropagation="true">
            <div class="tf-modal-content">
                @* Modal Header *@
                <div class="tf-modal-header" style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--tf-border); padding:16px 20px;">
                    <div style="display:flex; align-items:center; gap:10px;">
                        <div style="width:36px; height:36px; border-radius:8px; background:rgba(37,99,235,0.12); color:var(--tf-primary, #2563eb); display:flex; align-items:center; justify-content:center;">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                <circle cx="8.5" cy="7" r="4"/>
                                <line x1="20" y1="8" x2="20" y2="14"/>
                                <line x1="23" y1="11" x2="17" y2="11"/>
                            </svg>
                        </div>
                        <div>
                            <h3 style="margin:0; font-size:16px; font-weight:700; color:var(--tf-text-primary);">Cấp tài khoản đăng nhập TradeFlow</h3>
                            <div style="font-size:12.5px; color:var(--tf-text-secondary); margin-top:2px;">
                                Nhân viên: <strong>@Employee.FullName</strong> (@Employee.Code)
                            </div>
                        </div>
                    </div>
                    <button type="button" class="tf-modal-close-btn" @onclick="CloseModal" aria-label="Đóng" style="background:none; border:none; color:var(--tf-text-muted); cursor:pointer; font-size:18px;">
                        ✕
                    </button>
                </div>

                @* Modal Body *@
                <div class="tf-modal-body" style="padding:20px;">
                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="tf-alert tf-alert-error tf-mb-4" style="background:rgba(239,68,68,0.12); border:1px solid rgba(239,68,68,0.3); color:#ef4444; padding:10px 14px; border-radius:6px; font-size:13px; display:flex; align-items:center; gap:8px;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                            <span>@_errorMessage</span>
                        </div>
                    }

                    @if (_provisionResult != null && _provisionResult.Succeeded)
                    {
                        @* One-Time Password Display Screen *@
                        <div style="background:rgba(16,185,129,0.08); border:1px solid rgba(16,185,129,0.3); border-radius:8px; padding:16px; margin-bottom:16px;">
                            <div style="display:flex; align-items:center; gap:8px; color:#10b981; font-weight:700; font-size:14px; margin-bottom:12px;">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                                <span>Cấp tài khoản thành công!</span>
                            </div>

                            <div style="display:grid; grid-template-columns: 140px 1fr; row-gap:10px; font-size:13.5px; margin-bottom:14px;">
                                <span style="color:var(--tf-text-secondary);">Tên đăng nhập:</span>
                                <strong style="color:var(--tf-text-primary); font-family:monospace; font-size:14px;">@_provisionResult.UserName</strong>

                                <span style="color:var(--tf-text-secondary);">Vai trò:</span>
                                <div><span class="tf-badge tf-badge-info" style="font-size:11px;">@_provisionResult.Role</span></div>

                                <span style="color:var(--tf-text-secondary); align-self:center;">Mật khẩu tạm thời:</span>
                                <div style="display:flex; align-items:center; gap:8px;">
                                    <div id="display-temp-password" style="background:var(--tf-bg-card, #1e293b); border:1px solid var(--tf-border, #334155); border-radius:6px; padding:6px 12px; font-family:monospace; font-size:15px; font-weight:700; color:#38bdf8; letter-spacing:1px; flex:1;">
                                        @(_showPassword ? _provisionResult.TemporaryPassword : "••••••••••••")
                                    </div>
                                    <button type="button" class="tf-btn tf-btn-sm tf-btn-outline" @onclick="() => _showPassword = !_showPassword" title="@(_showPassword ? "Ẩn" : "Hiện")" style="padding:6px 10px;">
                                        @if (_showPassword)
                                        {
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                                        }
                                        else
                                        {
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                        }
                                    </button>
                                    <button type="button" class="tf-btn tf-btn-sm tf-btn-primary" @onclick="CopyPasswordAsync" style="padding:6px 12px; display:flex; align-items:center; gap:4px;" id="btn-copy-temp-password">
                                        @if (_copied)
                                        {
                                            <span>✓ Đã chép</span>
                                        }
                                        else
                                        {
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                                            <span>Sao chép</span>
                                        }
                                    </button>
                                </div>
                            </div>

                            @* Security Warning Notice *@
                            <div style="background:rgba(245,158,11,0.12); border-left:3px solid #f59e0b; padding:10px 12px; border-radius:4px; font-size:12.5px; color:var(--tf-text-secondary); line-height:1.5;">
                                <strong style="color:#d97706; display:block; margin-bottom:2px;">Lưu ý bảo mật quan trọng:</strong>
                                Mật khẩu tạm thời này <strong>chỉ hiển thị một lần duy nhất</strong> và không bao giờ được lưu dưới dạng có thể đọc lại. Quản trị viên vui lòng sao chép và gửi trực tiếp cho nhân viên qua kênh an toàn. Nhân viên sẽ <strong>bắt buộc phải đổi mật khẩu mới</strong> ngay khi đăng nhập lần đầu.
                            </div>
                        </div>

                        <div style="display:flex; justify-content:flex-end;">
                            <button type="button" class="tf-btn tf-btn-primary" @onclick="HandleDone">
                                Hoàn tất &amp; Đóng
                            </button>
                        </div>
                    }
                    else
                    {
                        @* Input Form Screen *@
                        <div class="tf-form-group tf-mb-3">
                            <label class="tf-label" style="font-weight:600; margin-bottom:6px; display:block;">
                                Tên đăng nhập (Username) <span style="color:#ef4444;">*</span>
                            </label>
                            <input type="text"
                                   class="tf-input"
                                   @bind="_username"
                                   placeholder="Ví dụ: nv00001, an.nguyen..."
                                   style="font-family:monospace; font-size:14px;"
                                   id="input-provision-username" />
                            <div style="font-size:11.5px; color:var(--tf-text-muted); margin-top:4px;">
                                Viết thường không dấu, số, dấu chấm, gạch ngang (tối thiểu 3 ký tự).
                            </div>
                        </div>

                        <div class="tf-form-group tf-mb-3">
                            <label class="tf-label" style="font-weight:600; margin-bottom:6px; display:block;">
                                Vai trò &amp; Cấp quyền truy cập <span style="color:#ef4444;">*</span>
                            </label>
                            <select class="tf-input" @bind="_selectedRole" id="select-provision-role">
                                @foreach (var r in _assignableRoles)
                                {
                                    <option value="@r">@r</option>
                                }
                            </select>
                            <div style="font-size:11.5px; color:var(--tf-text-muted); margin-top:4px;">
                                Nhân viên chỉ được thao tác các chức năng thuộc vai trò được cấp (Chấm công, Bán hàng, Hồ sơ...).
                            </div>
                        </div>

                        <div class="tf-form-group tf-mb-4">
                            <label class="tf-label" style="font-weight:600; margin-bottom:6px; display:block;">
                                Ghi chú cấp quyền
                            </label>
                            <textarea class="tf-input" @bind="_notes" rows="2" placeholder="Ghi chú bổ sung (tùy chọn)"></textarea>
                        </div>

                        <div style="background:rgba(37,99,235,0.06); border:1px solid rgba(37,99,235,0.2); border-radius:6px; padding:12px; font-size:12px; color:var(--tf-text-secondary); margin-bottom:20px; line-height:1.5;">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--tf-primary); vertical-align:middle; margin-right:4px;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                            Hệ thống sẽ tự động sinh mật khẩu ngẫu nhiên có độ phức tạp cao được băm bảo mật một chiều (PBKDF2) và đặt cờ bắt buộc đổi mật khẩu khi nhân viên đăng nhập lần đầu.
                        </div>

                        <div style="display:flex; justify-content:flex-end; gap:10px;">
                            <button type="button" class="tf-btn tf-btn-ghost" @onclick="CloseModal" disabled="@_isSubmitting">
                                Hủy
                            </button>
                            <button type="button" class="tf-btn tf-btn-primary" @onclick="SubmitProvisionAsync" disabled="@_isSubmitting" id="btn-provision-submit">
                                @if (_isSubmitting)
                                {
                                    <span class="tf-spinner" style="width:14px; height:14px; border-width:2px; display:inline-block; margin-right:6px;"></span>
                                    <span>Đang tạo tài khoản...</span>
                                }
                                else
                                {
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:6px;">
                                        <polyline points="20 6 9 17 4 12"/>
                                    </svg>
                                    <span>Cấp tài khoản &amp; Sinh mật khẩu tạm</span>
                                }
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EmployeeDto? Employee { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback<ProvisionAccountResultDto> OnAccountProvisioned { get; set; }

    private string _username = "";
    private string _selectedRole = "Employee";
    private string _notes = "";
    private List<string> _assignableRoles = [];
    private bool _isSubmitting;
    private string? _errorMessage;
    private ProvisionAccountResultDto? _provisionResult;
    private bool _showPassword = false;
    private bool _copied = false;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && Employee != null && _provisionResult == null)
        {
            _errorMessage = null;
            _copied = false;
            _showPassword = false;

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var currentUser = authState.User.Identity?.Name ?? "admin";

            _assignableRoles = await EmployeeAccountService.GetAssignableRolesAsync(currentUser);
            if (!_assignableRoles.Contains(_selectedRole))
            {
                _selectedRole = _assignableRoles.FirstOrDefault(r => r == "Employee")
                    ?? _assignableRoles.FirstOrDefault(r => r == "Sales")
                    ?? _assignableRoles.FirstOrDefault() ?? "Employee";
            }

            _username = await EmployeeAccountService.SuggestUsernameAsync(Employee.Id);
        }
    }

    private async Task SubmitProvisionAsync()
    {
        if (_isSubmitting || Employee == null) return;
        _isSubmitting = true;
        _errorMessage = null;

        try
        {
            if (string.IsNullOrWhiteSpace(_username))
            {
                _errorMessage = "Vui lòng nhập tên đăng nhập.";
                return;
            }

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var currentUser = authState.User.Identity?.Name ?? "admin";

            var cmd = new ProvisionEmployeeAccountCommand
            {
                EmployeeId = Employee.Id,
                UserName = _username.Trim(),
                Role = _selectedRole,
                Notes = _notes
            };

            var result = await EmployeeAccountService.ProvisionAccountAsync(cmd, currentUser);
            if (!result.Succeeded)
            {
                _errorMessage = result.ErrorMessage ?? "Không thể cấp tài khoản cho nhân viên.";
            }
            else
            {
                _provisionResult = result;
                await OnAccountProvisioned.InvokeAsync(result);
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task CopyPasswordAsync()
    {
        if (_provisionResult?.TemporaryPassword != null)
        {
            try
            {
                await JS.InvokeVoidAsync("navigator.clipboard.writeText", _provisionResult.TemporaryPassword);
                _copied = true;
                StateHasChanged();
                await Task.Delay(3000);
                _copied = false;
                StateHasChanged();
            }
            catch
            {
                _showPassword = true;
            }
        }
    }

    private async Task HandleDone()
    {
        _provisionResult = null;
        await OnClose.InvokeAsync();
    }

    private async Task CloseModal()
    {
        _provisionResult = null;
        await OnClose.InvokeAsync();
    }
}
