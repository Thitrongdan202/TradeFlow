@using Microsoft.AspNetCore.Components.Authorization
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Application.Common.Models.Employees

@inject IEmployeeAccountService EmployeeAccountService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

@if (IsOpen && Employee != null)
{
    <div class="tf-modal-backdrop" @onclick="CloseModal">
        <div class="tf-modal-dialog" style="max-width: 520px;" @onclick:stopPropagation="true">
            <div class="tf-modal-content">
                @* Modal Header *@
                <div class="tf-modal-header" style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--tf-border); padding:16px 20px;">
                    <div style="display:flex; align-items:center; gap:10px;">
                        <div style="width:36px; height:36px; border-radius:8px; background:rgba(245,158,11,0.12); color:#d97706; display:flex; align-items:center; justify-content:center;">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                            </svg>
                        </div>
                        <div>
                            <h3 style="margin:0; font-size:16px; font-weight:700; color:var(--tf-text-primary);">Đặt lại mật khẩu tài khoản</h3>
                            <div style="font-size:12.5px; color:var(--tf-text-secondary); margin-top:2px;">
                                Tài khoản: <strong>@Employee.UserName</strong> — Nhân viên: @Employee.FullName
                            </div>
                        </div>
                    </div>
                    <button type="button" class="tf-modal-close-btn" @onclick="CloseModal" aria-label="Đóng" style="background:none; border:none; color:var(--tf-text-muted); cursor:pointer; font-size:18px;">
                        ✕
                    </button>
                </div>

                @* Modal Body *@
                <div class="tf-modal-body" style="padding:20px;">
                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="tf-alert tf-alert-error tf-mb-4" style="background:rgba(239,68,68,0.12); border:1px solid rgba(239,68,68,0.3); color:#ef4444; padding:10px 14px; border-radius:6px; font-size:13px; display:flex; align-items:center; gap:8px;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                            <span>@_errorMessage</span>
                        </div>
                    }

                    @if (_resetResult != null && _resetResult.Succeeded)
                    {
                        @* One-Time New Password Display Screen *@
                        <div style="background:rgba(16,185,129,0.08); border:1px solid rgba(16,185,129,0.3); border-radius:8px; padding:16px; margin-bottom:16px;">
                            <div style="display:flex; align-items:center; gap:8px; color:#10b981; font-weight:700; font-size:14px; margin-bottom:12px;">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                                <span>Đặt lại mật khẩu thành công!</span>
                            </div>

                            <div style="display:grid; grid-template-columns: 140px 1fr; row-gap:10px; font-size:13.5px; margin-bottom:14px;">
                                <span style="color:var(--tf-text-secondary);">Tên đăng nhập:</span>
                                <strong style="color:var(--tf-text-primary); font-family:monospace; font-size:14px;">@_resetResult.UserName</strong>

                                <span style="color:var(--tf-text-secondary); align-self:center;">Mật khẩu tạm mới:</span>
                                <div style="display:flex; align-items:center; gap:8px;">
                                    <div id="display-reset-password" style="background:var(--tf-bg-card, #1e293b); border:1px solid var(--tf-border, #334155); border-radius:6px; padding:6px 12px; font-family:monospace; font-size:15px; font-weight:700; color:#38bdf8; letter-spacing:1px; flex:1;">
                                        @(_showPassword ? _resetResult.TemporaryPassword : "••••••••••••")
                                    </div>
                                    <button type="button" class="tf-btn tf-btn-sm tf-btn-outline" @onclick="() => _showPassword = !_showPassword" title="@(_showPassword ? "Ẩn" : "Hiện")" style="padding:6px 10px;">
                                        @if (_showPassword)
                                        {
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                                        }
                                        else
                                        {
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                        }
                                    </button>
                                    <button type="button" class="tf-btn tf-btn-sm tf-btn-primary" @onclick="CopyPasswordAsync" style="padding:6px 12px; display:flex; align-items:center; gap:4px;" id="btn-copy-reset-password">
                                        @if (_copied)
                                        {
                                            <span>✓ Đã chép</span>
                                        }
                                        else
                                        {
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                                            <span>Sao chép</span>
                                        }
                                    </button>
                                </div>
                            </div>

                            <div style="background:rgba(245,158,11,0.12); border-left:3px solid #f59e0b; padding:10px 12px; border-radius:4px; font-size:12.5px; color:var(--tf-text-secondary); line-height:1.5;">
                                <strong style="color:#d97706; display:block; margin-bottom:2px;">Lưu ý:</strong>
                                Mật khẩu này chỉ xuất hiện một lần duy nhất. Tất cả các phiên đăng nhập trước đây của tài khoản này đã bị thu hồi. Nhân viên sẽ phải đổi mật khẩu khi đăng nhập lại.
                            </div>
                        </div>

                        <div style="display:flex; justify-content:flex-end;">
                            <button type="button" class="tf-btn tf-btn-primary" @onclick="HandleDone">
                                Hoàn tất &amp; Đóng
                            </button>
                        </div>
                    }
                    else
                    {
                        <p style="font-size:14px; color:var(--tf-text-primary); line-height:1.5; margin-bottom:16px;">
                            Bạn có chắc chắn muốn đặt lại mật khẩu cho tài khoản <strong>@Employee.UserName</strong> của nhân viên <strong>@Employee.FullName</strong>?
                        </p>

                        <div style="background:rgba(239,68,68,0.08); border:1px solid rgba(239,68,68,0.25); border-radius:6px; padding:12px; font-size:12.5px; color:#ef4444; margin-bottom:20px; line-height:1.5;">
                            <strong>Cảnh báo hành động:</strong>
                            <ul style="margin:4px 0 0 16px; padding:0;">
                                <li>Mật khẩu cũ của nhân viên sẽ bị hủy bỏ vĩnh viễn ngay lập tức.</li>
                                <li>Mọi phiên đăng nhập hiện tại trên các thiết bị của nhân viên sẽ bị thu hồi tức thời.</li>
                                <li>Hệ thống sẽ sinh mật khẩu tạm thời ngẫu nhiên và yêu cầu nhân viên đổi mật khẩu ở lần đăng nhập tiếp theo.</li>
                            </ul>
                        </div>

                        <div style="display:flex; justify-content:flex-end; gap:10px;">
                            <button type="button" class="tf-btn tf-btn-ghost" @onclick="CloseModal" disabled="@_isSubmitting">
                                Hủy
                            </button>
                            <button type="button" class="tf-btn tf-btn-warning" @onclick="SubmitResetAsync" disabled="@_isSubmitting" id="btn-reset-password-confirm" style="background:#d97706; color:#fff; border:none;">
                                @if (_isSubmitting)
                                {
                                    <span class="tf-spinner" style="width:14px; height:14px; border-width:2px; display:inline-block; margin-right:6px;"></span>
                                    <span>Đang đặt lại...</span>
                                }
                                else
                                {
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:6px;">
                                        <polyline points="23 4 23 10 17 10"/>
                                        <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
                                    </svg>
                                    <span>Xác nhận đặt lại mật khẩu</span>
                                }
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EmployeeDto? Employee { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback<ResetEmployeePasswordResultDto> OnPasswordReset { get; set; }

    private bool _isSubmitting;
    private string? _errorMessage;
    private ResetEmployeePasswordResultDto? _resetResult;
    private bool _showPassword = false;
    private bool _copied = false;

    protected override void OnParametersSet()
    {
        if (IsOpen && _resetResult == null)
        {
            _errorMessage = null;
            _copied = false;
            _showPassword = false;
        }
    }

    private async Task SubmitResetAsync()
    {
        if (_isSubmitting || Employee == null) return;
        _isSubmitting = true;
        _errorMessage = null;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var currentUser = authState.User.Identity?.Name ?? "admin";

            var result = await EmployeeAccountService.ResetEmployeePasswordAsync(Employee.Id, currentUser);
            if (!result.Succeeded)
            {
                _errorMessage = result.ErrorMessage ?? "Không thể đặt lại mật khẩu.";
            }
            else
            {
                _resetResult = result;
                await OnPasswordReset.InvokeAsync(result);
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task CopyPasswordAsync()
    {
        if (_resetResult?.TemporaryPassword != null)
        {
            try
            {
                await JS.InvokeVoidAsync("navigator.clipboard.writeText", _resetResult.TemporaryPassword);
                _copied = true;
                StateHasChanged();
                await Task.Delay(3000);
                _copied = false;
                StateHasChanged();
            }
            catch
            {
                _showPassword = true;
            }
        }
    }

    private async Task HandleDone()
    {
        _resetResult = null;
        await OnClose.InvokeAsync();
    }

    private async Task CloseModal()
    {
        _resetResult = null;
        await OnClose.InvokeAsync();
    }
}
