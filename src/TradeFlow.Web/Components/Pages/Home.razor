    private static string FormatAuditEventDescription(AuditLog log)
    {
        if (string.IsNullOrWhiteSpace(log.Details))
        {
            return string.Empty;
        }

        var text = log.Details.Trim();

        // Check if Details is a JSON string
        if ((text.StartsWith("{") && text.EndsWith("}")) || (text.StartsWith("[") && text.EndsWith("]")))
        {
            try
            {
                using var doc = JsonDocument.Parse(text);
                var root = doc.RootElement;

                if (root.ValueKind == JsonValueKind.Object)
                {
                    // Special case: DatabaseBackupRestored
                    if (log.EventType == AuditEventType.DatabaseBackupRestored || root.TryGetProperty("NewRecordsImported", out _))
                    {
                        int newRec = root.TryGetProperty("NewRecordsImported", out var np) && np.TryGetInt32(out var nv) ? nv : 0;
                        int retRec = root.TryGetProperty("ExistingRecordsRetained", out var rp) && rp.TryGetInt32(out var rv) ? rv : 0;
                        int overRec = root.TryGetProperty("RecordsOverwritten", out var op) && op.TryGetInt32(out var ov) ? ov : 0;
                        int files = root.TryGetProperty("FilesImported", out var fp) && fp.TryGetInt32(out var fv) ? fv : 0;

                        var parts = new List<string>
                        {
                            $"Khôi phục dữ liệu: {newRec:N0} bản ghi mới",
                            $"{retRec:N0} bản ghi giữ nguyên",
                            $"{overRec:N0} bản ghi ghi đè"
                        };
                        if (files > 0)
                        {
                            parts.Add($"{files} tệp đính kèm");
                        }
                        return string.Join(", ", parts);
                    }

                    // Special case: DatabaseBackupCreated
                    if (log.EventType == AuditEventType.DatabaseBackupCreated || root.TryGetProperty("FileSizeBytes", out _) || root.TryGetProperty("FileName", out _))
                    {
                        string fileName = root.TryGetProperty("FileName", out var fn) ? fn.GetString() ?? "" : "";
                        long size = root.TryGetProperty("FileSizeBytes", out var sz) && sz.TryGetInt64(out var sv) ? sv : 0;
                        int tables = root.TryGetProperty("TablesCount", out var tb) && tb.TryGetInt32(out var tv) ? tv : 0;

                        var result = "Tạo tệp sao lưu";
                        if (!string.IsNullOrEmpty(fileName))
                        {
                            result += $": {fileName}";
                        }
                        if (size > 0)
                        {
                            result += $" ({FormatFileSize(size)})";
                        }
                        if (tables > 0)
                        {
                            result += $" • {tables} bảng dữ liệu";
                        }
                        return result;
                    }

                    // Check common descriptive fields in JSON
                    if (root.TryGetProperty("Summary", out var sum) && sum.ValueKind == JsonValueKind.String)
                        return sum.GetString()!;
                    if (root.TryGetProperty("Message", out var msg) && msg.ValueKind == JsonValueKind.String)
                        return msg.GetString()!;
                    if (root.TryGetProperty("Note", out var note) && note.ValueKind == JsonValueKind.String)
                        return note.GetString()!;
                    if (root.TryGetProperty("Description", out var desc) && desc.ValueKind == JsonValueKind.String)
                        return desc.GetString()!;

                    // If object has other properties, create clean key-value summary without internal technical identifiers
                    var summaries = new List<string>();
                    foreach (var prop in root.EnumerateObject())
                    {
                        var propName = prop.Name;
                        if (propName.EndsWith("Id", StringComparison.OrdinalIgnoreCase) ||
                            propName.Equals("StagingId", StringComparison.OrdinalIgnoreCase) ||
                            propName.Equals("DurationMs", StringComparison.OrdinalIgnoreCase) ||
                            propName.Equals("Timestamp", StringComparison.OrdinalIgnoreCase) ||
                            propName.Equals("Scope", StringComparison.OrdinalIgnoreCase))
                        {
                            continue;
                        }

                        if (prop.Value.ValueKind == JsonValueKind.String)
                        {
                            summaries.Add($"{propName}: {prop.Value.GetString()}");
                        }
                        else if (prop.Value.ValueKind == JsonValueKind.Number)
                        {
                            summaries.Add($"{propName}: {prop.Value}");
                        }
                    }

                    if (summaries.Count > 0)
                    {
                        return string.Join(" • ", summaries);
                    }
                }
            }
            catch
            {
                // Fall through to text cleanup
            }
        }

        // Clean up common English or raw technical phrases into natural Vietnamese
        var cleaned = text;
        cleaned = cleaned.Replace("Manual invoice created", "Tạo hóa đơn thủ công");
        cleaned = cleaned.Replace("Invoice created from SO", "Tạo hóa đơn từ đơn bán hàng");
        cleaned = cleaned.Replace("Draft invoice updated", "Cập nhật hóa đơn nháp");
        cleaned = cleaned.Replace("Invoice issued", "Phát hành hóa đơn thành công");
        cleaned = cleaned.Replace("Draft invoice deleted", "Xóa hóa đơn nháp");
        cleaned = cleaned.Replace("PDF exported", "Xuất tệp PDF thành công");
        cleaned = cleaned.Replace("Draft order created", "Tạo đơn hàng nháp mới");
        cleaned = cleaned.Replace("Draft order updated", "Cập nhật đơn hàng nháp");
        cleaned = cleaned.Replace("Order confirmed", "Xác nhận đơn hàng thành công");
        cleaned = cleaned.Replace("Order cancelled", "Hủy đơn hàng");

        return cleaned;
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{(bytes / 1024.0):F1} KB";
        if (bytes < 1024 * 1024 * 1024) return $"{(bytes / (1024.0 * 1024.0)):F1} MB";
        return $"{(bytes / (1024.0 * 1024.0 * 1024.0)):F2} GB";
    }
