@code {
    private bool _isInitialLoading = true;
    private bool _isPeriodSwitching = false;
    private bool _isLoadingWarehouse = true;
    private bool _isLoadingActivities = true;
    private bool _isRefreshing = false;

    private string _selectedPeriod = "30d";
    private string _lastLoadedPeriod = "30d";
    private string _chartMetric = "revenue"; // "revenue" or "orders"
    private int? _hoveredPointIndex = null;
    private string? _currentUserName;
    private string? _chartErrorMessage;

    // Concurrency control for period switching
    private CancellationTokenSource? _periodCts;
    private long _periodRequestSequence = 0;

    // Custom dropdown popover state
    private bool _isCustomDropdownOpen = false;
    private DateTime? _customStartDate = DateTime.Today.AddDays(-7);
    private DateTime? _customEndDate = DateTime.Today;
    private DateTime? _tempStartDate;
    private DateTime? _tempEndDate;

    private DashboardKpiModel _kpis = new();
    private DashboardChartDataModel _chartData = new();
    private List<DashboardBestSellingProductModel> _bestSellingProducts = [];
    private DashboardWarehouseSummaryModel _warehouseSummary = new();
    private List<DashboardRecentActivityModel> _recentActivities = [];

    // Real-Time Activity Toast Stack
    private readonly List<ActivityToastNotification> _activeToasts = [];
    private readonly HashSet<string> _seenToastIds = [];

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _currentUserName = authState.User.Identity?.Name;

        // Instant render from session cache if available
        if (DashboardState.HasLoaded && DashboardState.Kpis != null)
        {
            _kpis = DashboardState.Kpis;
            _chartData = DashboardState.ChartData ?? new();
            _bestSellingProducts = DashboardState.BestSellingProducts.ToList();
            _warehouseSummary = DashboardState.WarehouseSummary ?? new();
            _recentActivities = DashboardState.EnrichedActivities.ToList();

            _isInitialLoading = false;
            _isLoadingWarehouse = false;
            _isLoadingActivities = false;
        }

        await LoadAllDashboardDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            ActivityBroadcaster.OnActivity += HandleActivityBroadcast;
            try
            {
                var (_, _, coords) = CalculateChartPaths();
                if (coords.Count > 0)
                {
                    await JS.InvokeVoidAsync("TradeFlowMotion.transitionDashboardChart", ".tf-chart-svg", coords, true, 0);
                }
                await JS.InvokeVoidAsync("TradeFlowMotion.animateDashboardEntrance", "#tf-dash-root");
            }
            catch
            {
                // Animation fallback gracefully handled
            }
        }
    }

    private async Task LoadAllDashboardDataAsync()
    {
        _chartErrorMessage = null;
        try
        {
            var kpisTask = AnalyticsService.GetKpisAsync(_selectedPeriod, _customStartDate, _customEndDate);
            var chartTask = AnalyticsService.GetSalesChartDataAsync(_selectedPeriod, _customStartDate, _customEndDate);
            var bestSellingTask = AnalyticsService.GetBestSellingProductsAsync(_selectedPeriod, 5, null, _customStartDate, _customEndDate);
            var warehouseTask = AnalyticsService.GetWarehouseOverviewAsync();
            var activitiesTask = AnalyticsService.GetRecentActivitiesAsync(6);

            await Task.WhenAll(kpisTask, chartTask, bestSellingTask, warehouseTask, activitiesTask);

            _kpis = await kpisTask;
            _chartData = await chartTask;
            _bestSellingProducts = await bestSellingTask;
            _warehouseSummary = await warehouseTask;
            _recentActivities = await activitiesTask;
            _lastLoadedPeriod = _selectedPeriod;

            // Cache to state service
            DashboardState.SetFullState(_kpis, _chartData, _bestSellingProducts, _warehouseSummary, _recentActivities);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Dashboard Error] {ex.Message}");
            _chartErrorMessage = "Không thể tải dữ liệu báo cáo. Vui lòng kiểm tra và thử lại.";
        }
        finally
        {
            _isInitialLoading = false;
            _isPeriodSwitching = false;
            _isLoadingWarehouse = false;
            _isLoadingActivities = false;
            _isRefreshing = false;
            StateHasChanged();

            try
            {
                var (_, _, coords) = CalculateChartPaths();
                if (coords.Count > 0)
                {
                    await JS.InvokeVoidAsync("TradeFlowMotion.transitionDashboardChart", ".tf-chart-svg", coords, true, 0);
                }
            }
            catch { }
        }
    }

    private async Task ChangePeriodAsync(string period, DateTime? customStart = null, DateTime? customEnd = null)
    {
        // Avoid duplicate fetch if already displaying this exact period/dates and not currently switching
        if (_selectedPeriod == period && 
            period != "custom" && 
            _lastLoadedPeriod == period && 
            !_isPeriodSwitching && 
            _chartData.Points.Count > 0)
        {
            return;
        }

        _selectedPeriod = period;
        if (period == "custom")
        {
            if (customStart.HasValue) _customStartDate = customStart;
            if (customEnd.HasValue) _customEndDate = customEnd;
        }
        else
        {
            _isCustomDropdownOpen = false;
        }

        _chartErrorMessage = null;
        _isPeriodSwitching = true;
        _hoveredPointIndex = null;

        // Cancel previous pending request to prevent race conditions
        _periodCts?.Cancel();
        _periodCts?.Dispose();
        _periodCts = new CancellationTokenSource();
        var ct = _periodCts.Token;
        var currentSeq = Interlocked.Increment(ref _periodRequestSequence);

        StateHasChanged();

        try
        {
            var kpisTask = AnalyticsService.GetKpisAsync(_selectedPeriod, _customStartDate, _customEndDate, cancellationToken: ct);
            var chartTask = AnalyticsService.GetSalesChartDataAsync(_selectedPeriod, _customStartDate, _customEndDate, cancellationToken: ct);
            var bestSellingTask = AnalyticsService.GetBestSellingProductsAsync(_selectedPeriod, 5, null, _customStartDate, _customEndDate, cancellationToken: ct);

            await Task.WhenAll(kpisTask, chartTask, bestSellingTask);

            if (ct.IsCancellationRequested || currentSeq != _periodRequestSequence)
            {
                return;
            }

            var newKpis = await kpisTask;
            var newChartData = await chartTask;
            var newBestSelling = await bestSellingTask;

            _kpis = newKpis;
            _chartData = newChartData;
            _bestSellingProducts = newBestSelling;
            _lastLoadedPeriod = period;

            DashboardState.SetFullState(_kpis, _chartData, _bestSellingProducts, _warehouseSummary, _recentActivities);

            // Trigger smooth continuous chart transition
            var (_, _, newCoords) = CalculateChartPaths();
            try
            {
                await JS.InvokeVoidAsync("TradeFlowMotion.transitionDashboardChart", ".tf-chart-svg", newCoords, false, 320);
            }
            catch { }
        }
        catch (OperationCanceledException)
        {
            // Cleanly ignored; newer request in flight
            return;
        }
        catch (Exception ex)
        {
            if (currentSeq == _periodRequestSequence)
            {
                Console.WriteLine($"[Dashboard Period Error] {ex.Message}");
                _chartErrorMessage = "Không thể tải dữ liệu báo cáo cho khoảng thời gian này.";
            }
        }
        finally
        {
            if (currentSeq == _periodRequestSequence)
            {
                _isPeriodSwitching = false;
                StateHasChanged();
            }
        }
    }

    private async Task SetChartMetricAsync(string metric)
    {
        if (_chartMetric == metric) return;
        _chartMetric = metric;
        _hoveredPointIndex = null;
        var (_, _, newCoords) = CalculateChartPaths();
        try
        {
            await JS.InvokeVoidAsync("TradeFlowMotion.transitionDashboardChart", ".tf-chart-svg", newCoords, false, 320);
        }
        catch { }
        StateHasChanged();
    }

    private void ToggleCustomDropdown()
    {
        _isCustomDropdownOpen = !_isCustomDropdownOpen;
        if (_isCustomDropdownOpen)
        {
            _tempStartDate = _customStartDate ?? DateTime.Today.AddDays(-7);
            _tempEndDate = _customEndDate ?? DateTime.Today;
        }
    }

    private void CloseCustomDropdown()
    {
        _isCustomDropdownOpen = false;
    }

    private void ResetCustomDates()
    {
        var nowVn = DateTime.UtcNow.AddHours(7).Date;
        _tempStartDate = nowVn;
        _tempEndDate = nowVn;
    }

    private void SelectPreset(string preset)
    {
        var nowVn = DateTime.UtcNow.AddHours(7).Date;
        switch (preset)
        {
            case "yesterday":
                _tempStartDate = nowVn.AddDays(-1);
                _tempEndDate = nowVn.AddDays(-1);
                break;
            case "today":
                _tempStartDate = nowVn;
                _tempEndDate = nowVn;
                break;
            case "7d":
                _tempStartDate = nowVn.AddDays(-6);
                _tempEndDate = nowVn;
                break;
            case "30d":
                _tempStartDate = nowVn.AddDays(-29);
                _tempEndDate = nowVn;
                break;
            case "this_month":
                _tempStartDate = new DateTime(nowVn.Year, nowVn.Month, 1);
                _tempEndDate = nowVn;
                break;
        }
    }

    private async Task ApplyCustomDateDropdownAsync()
    {
        if (!_tempStartDate.HasValue || !_tempEndDate.HasValue) return;

        if (_tempStartDate > _tempEndDate)
        {
            var temp = _tempStartDate;
            _tempStartDate = _tempEndDate;
            _tempEndDate = temp;
        }

        _customStartDate = _tempStartDate;
        _customEndDate = _tempEndDate;
        _isCustomDropdownOpen = false;

        await ChangePeriodAsync("custom", _customStartDate, _customEndDate);
    }

    private string GetCustomButtonLabel()
    {
        if (_selectedPeriod == "custom" && _customStartDate.HasValue && _customEndDate.HasValue)
        {
            if (_customStartDate.Value.Date == _customEndDate.Value.Date)
            {
                return _customStartDate.Value.ToString("dd/MM/yyyy");
            }
            return $"{_customStartDate.Value:dd/MM} – {_customEndDate.Value:dd/MM/yyyy}";
        }
        return "Tùy chỉnh";
    }

    private async Task RefreshDataAsync()
    {
        _isRefreshing = true;
        DashboardState.Invalidate();
        await LoadAllDashboardDataAsync();
    }

    // Chart SVG Calculations
    private record PointCoord(double X, double Y);

    private (string areaD, string lineD, List<PointCoord> pointCoords) CalculateChartPaths()
    {
        var points = _chartData.Points;
        if (points.Count == 0) return (string.Empty, string.Empty, []);

        const double left = 55.0;
        const double right = 785.0;
        const double top = 20.0;
        const double bottom = 188.0;
        double usableWidth = right - left;
        double usableHeight = bottom - top;

        double maxValue = _chartMetric == "revenue" ? (double)_chartData.MaxDailyRevenue : (double)_chartData.MaxDailyOrders;
        if (maxValue <= 0) maxValue = 1.0;

        var coords = new List<PointCoord>();
        for (int i = 0; i < points.Count; i++)
        {
            double x = points.Count == 1 ? (left + right) / 2 : left + (i * usableWidth / (points.Count - 1));
            double val = _chartMetric == "revenue" ? (double)points[i].Revenue : (double)points[i].OrderCount;
            double y = bottom - ((val / maxValue) * usableHeight);
            coords.Add(new PointCoord(x, y));
        }

        static string Inv(double val) => val.ToString("F1", CultureInfo.InvariantCulture);

        // Build smooth curved line path
        if (coords.Count == 1)
        {
            var c = coords[0];
            return ($"M {Inv(c.X - 20)} {Inv(bottom)} L {Inv(c.X - 20)} {Inv(c.Y)} L {Inv(c.X + 20)} {Inv(c.Y)} L {Inv(c.X + 20)} {Inv(bottom)} Z",
                    $"M {Inv(c.X - 20)} {Inv(c.Y)} L {Inv(c.X + 20)} {Inv(c.Y)}",
                    coords);
        }

        // Zero transaction baseline: draw flat horizontal line at bottom
        bool allZero = _chartMetric == "revenue" ? _chartData.TotalPeriodRevenue == 0 : _chartData.TotalPeriodOrders == 0;
        if (allZero)
        {
            var flatLine = $"M {Inv(coords[0].X)} {Inv(bottom)} L {Inv(coords[^1].X)} {Inv(bottom)}";
            return (string.Empty, flatLine, coords);
        }

        var lineSb = new System.Text.StringBuilder();
        lineSb.Append($"M {Inv(coords[0].X)} {Inv(coords[0].Y)}");

        for (int i = 0; i < coords.Count - 1; i++)
        {
            var p0 = coords[i];
            var p1 = coords[i + 1];
            double midX = (p0.X + p1.X) / 2.0;
            lineSb.Append($" C {Inv(midX)} {Inv(p0.Y)}, {Inv(midX)} {Inv(p1.Y)}, {Inv(p1.X)} {Inv(p1.Y)}");
        }

        var lineD = lineSb.ToString();
        var areaD = $"{lineD} L {Inv(coords[^1].X)} {Inv(bottom)} L {Inv(coords[0].X)} {Inv(bottom)} Z";

        return (areaD, lineD, coords);
    }

    private PointCoord GetPointCoords(int index)
    {
        var (_, _, coords) = CalculateChartPaths();
        if (index >= 0 && index < coords.Count) return coords[index];
        return new PointCoord(400, 100);
    }

    private void SetChartHover(int index) => _hoveredPointIndex = index;
