    // Real-Time Activity Toast Notification Handlers
    private void HandleActivityBroadcast(ActivityToastNotification notif)
    {
        // Never notify the user of their own actions
        if (!string.IsNullOrEmpty(_currentUserName) && 
            string.Equals(notif.PerformedBy, _currentUserName, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        // Deduplication
        if (!_seenToastIds.Add(notif.EventId))
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            try
            {
                if (_activeToasts.Count >= 2)
                {
                    _activeToasts.RemoveAt(0);
                }
                _activeToasts.Add(notif);
                StateHasChanged();

                try
                {
                    await JS.InvokeVoidAsync("TradeFlowMotion.animateToastEntrance", $"#toast-{notif.EventId}");
                }
                catch { }

                // Auto-dismiss after 6 seconds
                _ = Task.Run(async () =>
                {
                    await Task.Delay(6000);
                    await InvokeAsync(() => DismissToast(notif.EventId));
                });
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[Toast Dispatch Error] {ex.Message}");
            }
        });
    }

    private async void DismissToast(string eventId)
    {
        var toast = _activeToasts.FirstOrDefault(t => t.EventId == eventId);
        if (toast != null)
        {
            try
            {
                await JS.InvokeVoidAsync("TradeFlowMotion.animateToastExit", $"#toast-{eventId}");
            }
            catch { }

            _activeToasts.Remove(toast);
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        ActivityBroadcaster.OnActivity -= HandleActivityBroadcast;
        _periodCts?.Cancel();
        _periodCts?.Dispose();
    }
