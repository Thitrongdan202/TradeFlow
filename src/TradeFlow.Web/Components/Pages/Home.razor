@code {
    private bool _isLoadingKpis = true;
    private bool _isLoadingChart = true;
    private bool _isLoadingBestSelling = true;
    private bool _isLoadingWarehouse = true;
    private bool _isLoadingActivities = true;
    private bool _isRefreshing = false;

    private string _selectedPeriod = "30d";
    private string _chartMetric = "revenue"; // "revenue" or "orders"
    private int? _hoveredPointIndex = null;
    private string? _currentUserName;

    private DashboardKpiModel _kpis = new();
    private DashboardChartDataModel _chartData = new();
    private List<DashboardBestSellingProductModel> _bestSellingProducts = [];
    private DashboardWarehouseSummaryModel _warehouseSummary = new();
    private List<DashboardRecentActivityModel> _recentActivities = [];

    // Real-Time Activity Toast Stack
    private readonly List<ActivityToastNotification> _activeToasts = [];
    private readonly HashSet<string> _seenToastIds = [];

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _currentUserName = authState.User.Identity?.Name;

        // Instant render from session cache if available
        if (DashboardState.HasLoaded && DashboardState.Kpis != null)
        {
            _kpis = DashboardState.Kpis;
            _chartData = DashboardState.ChartData ?? new();
            _bestSellingProducts = DashboardState.BestSellingProducts.ToList();
            _warehouseSummary = DashboardState.WarehouseSummary ?? new();
            _recentActivities = DashboardState.EnrichedActivities.ToList();

            _isLoadingKpis = false;
            _isLoadingChart = false;
            _isLoadingBestSelling = false;
            _isLoadingWarehouse = false;
            _isLoadingActivities = false;
        }

        await LoadAllDashboardDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            ActivityBroadcaster.OnActivity += HandleActivityBroadcast;
            try
            {
                await JS.InvokeVoidAsync("TradeFlowMotion.animateDashboardEntrance", "#tf-dash-root");
            }
            catch
            {
                // Animation fallback gracefully handled
            }
        }
    }

    private async Task LoadAllDashboardDataAsync()
    {
        try
        {
            var kpisTask = AnalyticsService.GetKpisAsync();
            var chartTask = AnalyticsService.GetSalesChartDataAsync(_selectedPeriod);
            var bestSellingTask = AnalyticsService.GetBestSellingProductsAsync(_selectedPeriod, 5);
            var warehouseTask = AnalyticsService.GetWarehouseOverviewAsync();
            var activitiesTask = AnalyticsService.GetRecentActivitiesAsync(6);

            await Task.WhenAll(kpisTask, chartTask, bestSellingTask, warehouseTask, activitiesTask);

            _kpis = await kpisTask;
            _chartData = await chartTask;
            _bestSellingProducts = await bestSellingTask;
            _warehouseSummary = await warehouseTask;
            _recentActivities = await activitiesTask;

            // Cache to state service
            DashboardState.SetFullState(_kpis, _chartData, _bestSellingProducts, _warehouseSummary, _recentActivities);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Dashboard Error] {ex.Message}");
        }
        finally
        {
            _isLoadingKpis = false;
            _isLoadingChart = false;
            _isLoadingBestSelling = false;
            _isLoadingWarehouse = false;
            _isLoadingActivities = false;
            _isRefreshing = false;
            StateHasChanged();
        }
    }

    private async Task ChangePeriodAsync(string period)
    {
        if (_selectedPeriod == period) return;

        _selectedPeriod = period;
        _isLoadingChart = true;
        _hoveredPointIndex = null;
        StateHasChanged();

        try
        {
            _chartData = await AnalyticsService.GetSalesChartDataAsync(_selectedPeriod);
            _bestSellingProducts = await AnalyticsService.GetBestSellingProductsAsync(_selectedPeriod, 5);
            DashboardState.SetFullState(_kpis, _chartData, _bestSellingProducts, _warehouseSummary, _recentActivities);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Dashboard Period Error] {ex.Message}");
        }
        finally
        {
            _isLoadingChart = false;
            StateHasChanged();
        }
    }

    private async Task RefreshDataAsync()
    {
        _isRefreshing = true;
        DashboardState.Invalidate();
        await LoadAllDashboardDataAsync();
    }

    // Chart SVG Calculations
    private record PointCoord(double X, double Y);

    private (string areaD, string lineD, List<PointCoord> pointCoords) CalculateChartPaths()
    {
        var points = _chartData.Points;
        if (points.Count == 0) return (string.Empty, string.Empty, []);

        const double left = 55.0;
        const double right = 785.0;
        const double top = 20.0;
        const double bottom = 188.0;
        double usableWidth = right - left;
        double usableHeight = bottom - top;

        double maxValue = _chartMetric == "revenue" ? (double)_chartData.MaxDailyRevenue : (double)_chartData.MaxDailyOrders;
        if (maxValue <= 0) maxValue = 1.0;

        var coords = new List<PointCoord>();
        for (int i = 0; i < points.Count; i++)
        {
            double x = points.Count == 1 ? (left + right) / 2 : left + (i * usableWidth / (points.Count - 1));
            double val = _chartMetric == "revenue" ? (double)points[i].Revenue : (double)points[i].OrderCount;
            double y = bottom - ((val / maxValue) * usableHeight);
            coords.Add(new PointCoord(x, y));
        }

        static string Inv(double val) => val.ToString("F1", CultureInfo.InvariantCulture);

        // Build smooth curved line path
        if (coords.Count == 1)
        {
            var c = coords[0];
            return ($"M {Inv(c.X - 20)} {Inv(bottom)} L {Inv(c.X - 20)} {Inv(c.Y)} L {Inv(c.X + 20)} {Inv(c.Y)} L {Inv(c.X + 20)} {Inv(bottom)} Z",
                    $"M {Inv(c.X - 20)} {Inv(c.Y)} L {Inv(c.X + 20)} {Inv(c.Y)}",
                    coords);
        }

        var lineSb = new System.Text.StringBuilder();
        lineSb.Append($"M {Inv(coords[0].X)} {Inv(coords[0].Y)}");

        for (int i = 0; i < coords.Count - 1; i++)
        {
            var p0 = coords[i];
            var p1 = coords[i + 1];
            double midX = (p0.X + p1.X) / 2.0;
            lineSb.Append($" C {Inv(midX)} {Inv(p0.Y)}, {Inv(midX)} {Inv(p1.Y)}, {Inv(p1.X)} {Inv(p1.Y)}");
        }

        var lineD = lineSb.ToString();
        var areaD = $"{lineD} L {Inv(coords[^1].X)} {Inv(bottom)} L {Inv(coords[0].X)} {Inv(bottom)} Z";

        return (areaD, lineD, coords);
    }

    private PointCoord GetPointCoords(int index)
    {
        var (_, _, coords) = CalculateChartPaths();
        if (index >= 0 && index < coords.Count) return coords[index];
        return new PointCoord(400, 100);
    }

    private void SetChartHover(int index) => _hoveredPointIndex = index;
    private void ClearChartHover() => _hoveredPointIndex = null;

    private static string FormatShortMoney(decimal amount)
    {
        if (amount >= 1_000_000_000) return $"{amount / 1_000_000_000m:F1}B";
        if (amount >= 1_000_000) return $"{amount / 1_000_000m:F1}M";
        if (amount >= 1_000) return $"{amount / 1_000m:N0}k";
        return amount.ToString("N0");
    }

    private static string GetPeriodLabel(string period) => period switch
    {
        "7d" => "7 ngày qua",
        "this_month" => "Tháng này",
        _ => "30 ngày qua"
    };

    private static string FormatRelativeTime(DateTime utcTime)
    {
        var span = DateTime.UtcNow - utcTime;
        if (span.TotalMinutes < 2) return "Vừa xong";
        if (span.TotalMinutes < 60) return $"{Math.Max(1, (int)span.TotalMinutes)} phút trước";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours} giờ trước";
        if (span.TotalDays < 7) return $"{(int)span.TotalDays} ngày trước";
        return utcTime.ToLocalTime().ToString("dd/MM/yyyy HH:mm");
    }

    private static string GetUserInitial(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "HT";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][..Math.Min(2, parts[0].Length)].ToUpper();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
    }

    private static string GetActivityIconClass(AuditEventType type) => type switch
    {
        AuditEventType.SalesOrderCreated or AuditEventType.SalesOrderConfirmed or AuditEventType.SalesOrderUpdated => "is-blue",
        AuditEventType.InvoiceCreated or AuditEventType.InvoiceIssued => "is-emerald",
        AuditEventType.WarehouseCreated or AuditEventType.WarehouseUpdated => "is-amber",
        AuditEventType.ContractCreated or AuditEventType.ContractSigned or AuditEventType.ContractFinalized => "is-purple",
        AuditEventType.CustomerCreated or AuditEventType.CustomerUpdated or AuditEventType.SupplierCreated => "is-teal",
        AuditEventType.EmployeeRequestSubmitted or AuditEventType.EmployeeRequestApproved or AuditEventType.EmployeeRequestRejected => "is-indigo",
        _ => "is-slate"
    };

    private static string GetActivityIconSvg(AuditEventType type) => type switch
    {
        AuditEventType.SalesOrderCreated or AuditEventType.SalesOrderConfirmed =>
            """<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>""",
        AuditEventType.InvoiceCreated or AuditEventType.InvoiceIssued =>
            """<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>""",
        AuditEventType.WarehouseCreated or AuditEventType.WarehouseUpdated =>
            """<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/></svg>""",
        AuditEventType.ContractCreated or AuditEventType.ContractSigned or AuditEventType.ContractFinalized =>
            """<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>""",
        AuditEventType.EmployeeRequestSubmitted or AuditEventType.EmployeeRequestApproved or AuditEventType.EmployeeRequestRejected =>
            """<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><polyline points="17 11 19 13 23 9"/></svg>""",
        _ =>
            """<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>"""
    };

    // Real-Time Activity Toast Notification Handlers
    private void HandleActivityBroadcast(ActivityToastNotification notif)
    {
        // Never notify the user of their own actions
        if (!string.IsNullOrEmpty(_currentUserName) && 
            string.Equals(notif.PerformedBy, _currentUserName, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        // Deduplication
        if (!_seenToastIds.Add(notif.EventId))
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            try
            {
                if (_activeToasts.Count >= 2)
                {
                    _activeToasts.RemoveAt(0);
                }
                _activeToasts.Add(notif);
                StateHasChanged();

                try
                {
                    await JS.InvokeVoidAsync("TradeFlowMotion.animateToastEntrance", $"#toast-{notif.EventId}");
                }
                catch { }

                // Auto-dismiss after 6 seconds
                _ = Task.Run(async () =>
                {
                    await Task.Delay(6000);
                    await InvokeAsync(() => DismissToast(notif.EventId));
                });
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[Toast Dispatch Error] {ex.Message}");
            }
        });
    }

    private async void DismissToast(string eventId)
    {
        var toast = _activeToasts.FirstOrDefault(t => t.EventId == eventId);
        if (toast != null)
        {
            try
            {
                await JS.InvokeVoidAsync("TradeFlowMotion.animateToastExit", $"#toast-{eventId}");
            }
            catch { }

            _activeToasts.Remove(toast);
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        ActivityBroadcaster.OnActivity -= HandleActivityBroadcast;
    }
}
