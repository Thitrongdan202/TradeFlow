@page "/"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Application.Common.Models.Notifications
@using TradeFlow.Domain.Entities.Users
@using TradeFlow.Domain.Enums
@using TradeFlow.Infrastructure.Persistence
@inject TradeFlowDbContext DbContext
@inject INotificationService NotificationService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Tổng quan — TradeFlow</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="tf-page-header">
            <div class="tf-page-header-left">
                <h1 class="tf-page-title">Tổng quan</h1>
                <p class="tf-page-subtitle">Chào mừng trở lại, <strong>@context.User.Identity?.Name</strong></p>
            </div>
            <div class="tf-page-actions">
                <button class="tf-btn tf-btn-secondary" disabled title="Tính năng báo cáo phân tích theo ngày đang được hoàn thiện">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/>
                        <line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/>
                        <line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>
                    </svg>
                    <span>Báo cáo hôm nay</span>
                    <span class="tf-badge-pill-dev">Đang phát triển</span>
                </button>
            </div>
        </div>

        @* Stats Grid *@
        <div class="tf-stats-grid">
            @if (_isLoading)
            {
                for (int i = 0; i < 4; i++)
                {
                    <Skeleton Type="stats" />
                }
            }
            else
            {
                @foreach (var stat in _stats)
                {
                    <div class="tf-stat-card">
                        <div class="tf-stat-label">@stat.Label</div>
                        <div class="tf-stat-value tf-text-@stat.Color">@stat.Value</div>
                        <div class="tf-stat-meta">@stat.Meta</div>
                    </div>
                }
            }
        </div>

        @* Content Grid *@
        <div class="tf-dashboard-grid">
            @* Recent Activity *@
            <div class="tf-card tf-dashboard-main">
                <div class="tf-card-header">
                    <h2 class="tf-card-title">Hoạt động gần đây</h2>
                </div>
                <div class="tf-card-body">
                    @if (_isLoading)
                    {
                        <div style="padding: 12px 0;">
                            <Skeleton Type="text" Rows="4" />
                        </div>
                    }
                    else if (_recentActivities.Any())
                    {
                        <div class="tf-activity-list">
                            @foreach (var act in _recentActivities)
                            {
                                <div class="tf-activity-item">
                                    <div class="tf-activity-dot"></div>
                                    <div class="tf-activity-content">
                                        <div class="tf-activity-header">
                                            <span class="tf-activity-title">@FormatAuditEventTitle(act)</span>
                                            <span class="tf-activity-time">@act.OccurredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(act.Details))
                                        {
                                            <div class="tf-activity-desc">@act.Details</div>
                                        }
                                        <div class="tf-activity-user">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                                <circle cx="12" cy="7" r="4"></circle>
                                            </svg>
                                            <span>@(act.PerformedBy ?? "Hệ thống")</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="tf-empty">
                            <div class="tf-empty-icon">
                                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                                    <polyline points="14 2 14 8 20 8"/>
                                    <line x1="16" y1="13" x2="8" y2="13"/>
                                    <line x1="16" y1="17" x2="8" y2="17"/>
                                    <polyline points="10 9 9 9 8 9"/>
                                </svg>
                            </div>
                            <div class="tf-empty-title">Chưa có dữ liệu</div>
                            <div class="tf-empty-desc">Các giao dịch sẽ xuất hiện ở đây sau khi hệ thống ghi nhận hoạt động.</div>
                        </div>
                    }
                </div>
            </div>

            @* Side: Quick Actions & Notifications *@
            <div class="tf-dashboard-side">
                @* Quick Actions *@
                <div class="tf-card tf-mb-4">
                    <div class="tf-card-header">
                        <h2 class="tf-card-title">Thao tác nhanh</h2>
                    </div>
                    <div class="tf-card-body" style="padding:12px;">
                        <div class="tf-quick-actions">
                            @foreach (var action in _quickActions)
                            {
                                <a href="@action.Href" class="tf-quick-action" title="@action.Label">
                                    <div class="tf-quick-action-icon">
                                        @((MarkupString)action.Icon)
                                    </div>
                                    <span>@action.Label</span>
                                </a>
                            }
                        </div>
                    </div>
                </div>

                @* System Notifications *@
                <div class="tf-card">
                    <div class="tf-card-header">
                        <h2 class="tf-card-title">Thông báo hệ thống</h2>
                    </div>
                    <div class="tf-card-body" style="padding:12px;">
                        @if (_isLoadingNotifications)
                        {
                            <div style="padding: 8px 0;">
                                <Skeleton Type="text" Rows="3" />
                            </div>
                        }
                        else if (!string.IsNullOrEmpty(_notificationError))
                        {
                            <div class="tf-alert tf-alert-warning" style="font-size:12px;margin:0;">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                                </svg>
                                <span>@_notificationError</span>
                            </div>
                        }
                        else if (_notifications.Any())
                        {
                            <div class="tf-notifications-list">
                                @foreach (var n in _notifications)
                                {
                                    <a href="@(n.TargetUrl ?? "/cai-dat")" class="tf-notification-item">
                                        <div class="tf-notification-dot @(n.IsRead ? "read" : "")"></div>
                                        <div class="tf-notification-content">
                                            <div class="tf-notification-title">@n.Title</div>
                                            <div class="tf-notification-message">@n.Message</div>
                                            <div class="tf-notification-time">@n.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                        </div>
                                    </a>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="tf-empty tf-empty-sm">
                                <div class="tf-empty-icon">
                                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                                        <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                                    </svg>
                                </div>
                                <div class="tf-empty-title" style="font-size:13px;">Chưa có thông báo mới</div>
                                <div class="tf-empty-desc" style="font-size:12px;">Thông báo mới sẽ xuất hiện tại đây khi có cập nhật.</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </Authorized>

    <NotAuthorized>
        <div class="tf-login-redirect">
            <div class="tf-brand" style="justify-content:center;padding:0;margin-bottom:24px;">
                <div class="tf-brand-logo" style="width:56px;height:56px;">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M3 3h7v7H3V3z" fill="white"/>
                        <path d="M14 3h7v7h-7V3z" fill="white" opacity="0.6"/>
                        <path d="M3 14h7v7H3v-7z" fill="white" opacity="0.6"/>
                        <path d="M14 14h7v7h-7v-7z" fill="white"/>
                    </svg>
                </div>
            </div>
            <h1 style="font-size:28px;margin-bottom:8px;">TradeFlow</h1>
            <p style="color:var(--tf-text-muted);margin-bottom:32px;font-size:15px;">Hệ thống quản lý thương mại</p>
            <a href="/Account/Login" class="tf-btn tf-btn-primary tf-btn-xl">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4"/>
                    <polyline points="10 17 15 12 10 7"/>
                    <line x1="15" y1="12" x2="3" y2="12"/>
                </svg>
                Đăng nhập để tiếp tục
            </a>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _isLoading = true;
    private bool _isLoadingNotifications = true;
    private string? _notificationError;

    private record StatItem(string Label, string Value, string Meta, string Color);
    private record QuickAction(string Label, string Href, string Icon);

    private List<StatItem> _stats = [];
    private List<SystemNotificationDto> _notifications = [];
    private List<AuditLog> _recentActivities = [];

    private static readonly QuickAction[] _quickActions =
    [
        new("Tạo báo giá", "/ban-hang/bao-gia/tao-moi",
            """<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>"""),
        new("Tạo đơn bán hàng", "/ban-hang/don-ban-hang/tao-moi",
            """<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>"""),
        new("Thêm khách hàng", "/doi-tac/khach-hang/them-moi",
            """<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>"""),
        new("Thêm sản phẩm", "/danh-muc/san-pham/them-moi",
            """<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="16.5" y1="9.4" x2="7.5" y2="4.21"/><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>""")
    ];

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        _isLoadingNotifications = true;

        try
        {
            var today = DateTime.UtcNow.Date;
            var startOfMonth = new DateTime(DateTime.UtcNow.Year, DateTime.UtcNow.Month, 1, 0, 0, 0, DateTimeKind.Utc);

            var todayOrdersCount = await DbContext.SalesOrders
                .CountAsync(o => o.OrderDate >= today);

            var monthRevenue = await DbContext.Invoices
                .Where(i => i.InvoiceDate >= startOfMonth)
                .SumAsync(i => (decimal?)i.GrandTotal) ?? 0m;

            var customersCount = await DbContext.Customers
                .CountAsync(c => c.IsActive);

            var productsCount = await DbContext.Products
                .CountAsync(p => p.IsActive);

            _stats =
            [
                new("Đơn bán hàng hôm nay", todayOrdersCount.ToString("N0"), $"{todayOrdersCount} đơn phát sinh hôm nay", "primary"),
                new("Doanh thu tháng này", monthRevenue > 0 ? $"{monthRevenue:N0} ₫" : "0 ₫", "Hóa đơn trong tháng", "success"),
                new("Khách hàng hoạt động", customersCount.ToString("N0"), $"{customersCount} đối tác đang kết nối", "info"),
                new("Sản phẩm đang bán", productsCount.ToString("N0"), $"{productsCount} mặt hàng trong danh mục", "warning")
            ];

            _recentActivities = await DbContext.AuditLogs
                .OrderByDescending(x => x.OccurredAt)
                .Take(5)
                .ToListAsync();
        }
        catch
        {
            _stats =
            [
                new("Đơn bán hàng hôm nay", "—", "Chưa có dữ liệu", "primary"),
                new("Doanh thu tháng này", "—", "Chưa có dữ liệu", "success"),
                new("Khách hàng hoạt động", "—", "Chưa có dữ liệu", "info"),
                new("Sản phẩm đang bán", "—", "Chưa có dữ liệu", "warning")
            ];
        }
        finally
        {
            _isLoading = false;
        }

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            _notifications = await NotificationService.GetNotificationsAsync(authState.User, 5);
        }
        catch
        {
            _notificationError = "Không thể tải thông báo.";
        }
        finally
        {
            _isLoadingNotifications = false;
        }
    }

    private static string FormatAuditEventTitle(AuditLog log)
    {
        return log.EventType switch
        {
            AuditEventType.DatabaseBackupCreated => "Tạo bản sao lưu dữ liệu hệ thống",
            AuditEventType.CompanySettingsChanged => "Cập nhật thông tin công ty",
            AuditEventType.Login => "Đăng nhập hệ thống",
            AuditEventType.UserLocked => "Khóa tài khoản người dùng",
            AuditEventType.UserCreated => "Thêm người dùng mới",
            AuditEventType.UserUpdated => "Cập nhật tài khoản",
            AuditEventType.ProductCreated => "Thêm sản phẩm mới",
            AuditEventType.ProductUpdated => "Cập nhật thông tin sản phẩm",
            AuditEventType.CustomerCreated => "Thêm khách hàng mới",
            AuditEventType.CustomerUpdated => "Cập nhật hồ sơ khách hàng",
            AuditEventType.SupplierCreated => "Thêm nhà cung cấp mới",
            _ => log.TargetEntity != null ? $"{log.EventType} ({log.TargetEntity})" : log.EventType.ToString()
        };
    }
}
