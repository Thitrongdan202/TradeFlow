            AuditEventType.PriceListOriginalDownloaded => "Tải file bảng giá gốc",
            AuditEventType.PriceChanged => "Điều chỉnh giá sản phẩm",
            AuditEventType.ProductImageMapped => "Gán ảnh sản phẩm",
            AuditEventType.SalesOrderCreated => "Tạo đơn bán hàng mới",
            AuditEventType.SalesOrderUpdated => "Cập nhật đơn bán hàng",
            AuditEventType.SalesOrderConfirmed => "Xác nhận đơn bán hàng",
