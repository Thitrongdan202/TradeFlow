        "30d" => "30 ngày qua",
        "this_month" => "Tháng này",
        "last_month" => "Tháng trước",
        "custom" => _customStartDate.HasValue && _customEndDate.HasValue 
            ? (_customStartDate.Value.Date == _customEndDate.Value.Date 
                ? _customStartDate.Value.ToString("dd/MM/yyyy") 
                : $"{_customStartDate:dd/MM} - {_customEndDate:dd/MM/yyyy}") 
            : "Tùy chỉnh",
        _ => "30 ngày qua"
    };

    private static string FormatRelativeTime(DateTime utcTime)
    {
        var span = DateTime.UtcNow - utcTime;
        if (span.TotalMinutes < 2) return "Vừa xong";
        if (span.TotalMinutes < 60) return $"{Math.Max(1, (int)span.TotalMinutes)} phút trước";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours} giờ trước";
        if (span.TotalDays < 7) return $"{(int)span.TotalDays} ngày trước";
        return utcTime.ToLocalTime().ToString("dd/MM/yyyy HH:mm");
    }

    private static string GetUserInitial(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "HT";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][..Math.Min(2, parts[0].Length)].ToUpper();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
    }

