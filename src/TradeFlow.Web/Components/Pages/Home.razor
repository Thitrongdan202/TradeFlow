@page "/"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Globalization
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Application.Common.Models.Dashboard
@using TradeFlow.Domain.Enums
@using TradeFlow.Web.Services
@implements IDisposable
@inject IDashboardAnalyticsService AnalyticsService
@inject IDashboardStateService DashboardState
@inject IUserActivityBroadcaster ActivityBroadcaster
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Tổng quan — TradeFlow</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="tf-dash-container" id="tf-dash-root">
            @* Level 0: Dashboard Header *@
            <div class="tf-dash-header">
                <div class="tf-dash-header-left">
                    <div class="tf-dash-badge">
                        <span class="tf-dash-badge-dot"></span>
                        <span>Hệ thống ERP trực tuyến</span>
                    </div>
                    <h1 class="tf-dash-title">Tổng quan</h1>
                    <p class="tf-dash-subtitle">
                        Chào mừng trở lại, <strong>@context.User.Identity?.Name</strong> • 
                        <span>@DateTime.Now.ToString("dddd, dd/MM/yyyy", new CultureInfo("vi-VN"))</span>
                    </p>
                </div>

                <div class="tf-dash-header-actions">
                    @* Period Switcher Pills *@
                    <div class="tf-dash-period-pills" role="group" aria-label="Bộ lọc khoảng thời gian">
                        <button type="button" 
                                class="tf-dash-pill @(_selectedPeriod == "7d" ? "is-active" : "")" 
                                @onclick="@(() => ChangePeriodAsync("7d"))"
                                disabled="@_isLoadingChart">
                            7 ngày qua
                        </button>
                        <button type="button" 
                                class="tf-dash-pill @(_selectedPeriod == "30d" ? "is-active" : "")" 
                                @onclick="@(() => ChangePeriodAsync("30d"))"
                                disabled="@_isLoadingChart">
                            30 ngày qua
                        </button>
                        <button type="button" 
                                class="tf-dash-pill @(_selectedPeriod == "this_month" ? "is-active" : "")" 
                                @onclick="@(() => ChangePeriodAsync("this_month"))"
                                disabled="@_isLoadingChart">
                            Tháng này
                        </button>
                    </div>

                    @* Refresh Button *@
                    <button type="button" 
                            class="tf-btn tf-btn-secondary tf-dash-refresh-btn @(_isRefreshing ? "is-spinning" : "")" 
                            @onclick="RefreshDataAsync" 
                            title="Làm mới dữ liệu tổng quan"
                            aria-label="Làm mới">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="23 4 23 10 17 10"></polyline>
                            <polyline points="1 20 1 14 7 14"></polyline>
                            <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
                        </svg>
                        <span class="tf-dash-refresh-label">Làm mới</span>
                    </button>
                </div>
            </div>

            @* Level 1: Modern KPI Grid (4 Cards) *@
            <div class="tf-dash-kpi-grid">
                @if (_isLoadingKpis)
                {
                    for (int i = 0; i < 4; i++)
                    {
                        <div class="tf-kpi-card is-loading">
                            <Skeleton Type="stats" />
                        </div>
                    }
                }
                else
                {
                    @* Card 1: Doanh thu *@
                    <div class="tf-kpi-card tf-kpi-revenue">
                        <div class="tf-kpi-top">
                            <span class="tf-kpi-label">Doanh thu tháng này</span>
                            <div class="tf-kpi-icon tf-kpi-icon-emerald">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="12" y1="1" x2="12" y2="23"></line>
                                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                                </svg>
                            </div>
                        </div>
                        <div class="tf-kpi-value">
                            @(_kpis.MonthRevenue > 0 ? $"{_kpis.MonthRevenue:N0} ₫" : "0 ₫")
                        </div>
                        <div class="tf-kpi-bottom">
                            @if (_kpis.RevenueGrowthPercent.HasValue)
                            {
                                var isPositive = _kpis.RevenueGrowthPercent.Value >= 0;
                                <span class="tf-kpi-trend @(isPositive ? "is-up" : "is-down")">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                        <polyline points="@(isPositive ? "18 15 12 9 6 15" : "6 9 12 15 18 9")"></polyline>
                                    </svg>
                                    @(isPositive ? "+" : "")@(_kpis.RevenueGrowthPercent.Value)%
                                </span>
                                <span class="tf-kpi-subtext">so với tháng trước</span>
                            }
                            else
                            {
                                <span class="tf-kpi-subtext">Hóa đơn phát hành trong tháng</span>
                            }
                        </div>
                    </div>

                    @* Card 2: Đơn bán hàng *@
                    <div class="tf-kpi-card tf-kpi-orders">
                        <div class="tf-kpi-top">
                            <span class="tf-kpi-label">Tổng đơn bán hàng</span>
                            <div class="tf-kpi-icon tf-kpi-icon-blue">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="9" cy="21" r="1"></circle>
                                    <circle cx="20" cy="21" r="1"></circle>
                                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                </svg>
                            </div>
                        </div>
                        <div class="tf-kpi-value">
                            @_kpis.TotalOrdersCount.ToString("N0") <span class="tf-kpi-unit">đơn</span>
                        </div>
                        <div class="tf-kpi-bottom">
                            <span class="tf-kpi-subtext">
                                <strong>@_kpis.TodayOrdersCount</strong> đơn phát sinh hôm nay • <strong>@_kpis.MonthOrdersCount</strong> trong tháng
                            </span>
                        </div>
                    </div>

                    @* Card 3: Mặt hàng lưu kho *@
                    <div class="tf-kpi-card tf-kpi-inventory">
                        <div class="tf-kpi-top">
                            <span class="tf-kpi-label">Mặt hàng lưu kho</span>
                            <div class="tf-kpi-icon tf-kpi-icon-amber">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                                    <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                                    <line x1="12" y1="22.08" x2="12" y2="12"></line>
                                </svg>
                            </div>
                        </div>
                        <div class="tf-kpi-value">
                            @_kpis.InStockItemsCount.ToString("N0") <span class="tf-kpi-unit">SKU khả dụng</span>
                        </div>
                        <div class="tf-kpi-bottom">
                            @if (_kpis.LowStockItemsCount > 0)
                            {
                                <span class="tf-kpi-badge-warning">
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <line x1="12" y1="8" x2="12" y2="12"></line>
                                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                                    </svg>
                                    @_kpis.LowStockItemsCount mặt hàng tồn thấp
                                </span>
                            }
                            else
                            {
                                <span class="tf-kpi-subtext">Đủ số dư khả dụng</span>
                            }
                        </div>
                    </div>

                    @* Card 4: Khách hàng hoạt động *@
                    <div class="tf-kpi-card tf-kpi-customers">
                        <div class="tf-kpi-top">
                            <span class="tf-kpi-label">Khách hàng hoạt động</span>
                            <div class="tf-kpi-icon tf-kpi-icon-purple">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="9" cy="7" r="4"></circle>
                                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                </svg>
                            </div>
                        </div>
                        <div class="tf-kpi-value">
                            @_kpis.ActiveCustomersCount.ToString("N0") <span class="tf-kpi-unit">đối tác</span>
                        </div>
                        <div class="tf-kpi-bottom">
                            <span class="tf-kpi-subtext">Đối tác thương mại & phân phối</span>
                        </div>
                    </div>
                }
            </div>

            @* Level 2: Analytics Row (Revenue Chart + Best Selling Products) *@
            <div class="tf-dash-analytics-grid">
                @* Chart Column (65%) *@
                <div class="tf-card tf-dash-section tf-dash-chart-card">
                    <div class="tf-dash-card-header">
                        <div>
                            <h2 class="tf-dash-card-title">Biểu đồ doanh thu & bán hàng</h2>
                            <p class="tf-dash-card-subtitle">
                                Tổng hợp biến động doanh số theo thời gian thực (@GetPeriodLabel(_selectedPeriod))
                            </p>
                        </div>

                        <div class="tf-dash-chart-controls">
                            @* Metric switch: Revenue vs Orders *@
                            <div class="tf-dash-metric-switch">
                                <button type="button" 
                                        class="tf-dash-switch-btn @(_chartMetric == "revenue" ? "is-active" : "")"
                                        @onclick="@(() => _chartMetric = "revenue")">
                                    Doanh thu (₫)
                                </button>
                                <button type="button" 
                                        class="tf-dash-switch-btn @(_chartMetric == "orders" ? "is-active" : "")"
                                        @onclick="@(() => _chartMetric = "orders")">
                                    Số đơn hàng
                                </button>
                            </div>

                            @* Summary badge *@
                            <div class="tf-dash-chart-sum-badge">
                                @if (_chartMetric == "revenue")
                                {
                                    <span>Tổng kỳ: <strong>@_chartData.TotalPeriodRevenue.ToString("N0") ₫</strong></span>
                                }
                                else
                                {
                                    <span>Tổng kỳ: <strong>@_chartData.TotalPeriodOrders đơn</strong></span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="tf-dash-chart-body">
                        @if (_isLoadingChart)
                        {
                            <div class="tf-chart-skeleton">
                                <Skeleton Type="text" Rows="6" />
                            </div>
                        }
                        else if (_chartData.Points.Count == 0)
                        {
                            <div class="tf-chart-empty">
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <line x1="18" y1="20" x2="18" y2="10"></line>
                                    <line x1="12" y1="20" x2="12" y2="4"></line>
                                    <line x1="6" y1="20" x2="6" y2="14"></line>
                                </svg>
                                <span>Chưa có dữ liệu giao dịch trong khoảng thời gian này</span>
                            </div>
                        }
                        else
                        {
                            @* High-end SVG Area Chart with interactive Hover *@
                            <div class="tf-chart-viewport-wrap" @onmouseleave="ClearChartHover">
                                <svg class="tf-chart-svg" viewBox="0 0 800 240" preserveAspectRatio="none" aria-label="Biểu đồ bán hàng">
                                    <defs>
                                        <linearGradient id="tfRevGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                                            <stop offset="0%" stop-color="var(--tf-primary, #2563eb)" stop-opacity="0.28" />
                                            <stop offset="100%" stop-color="var(--tf-primary, #2563eb)" stop-opacity="0.0" />
                                        </linearGradient>
                                        <linearGradient id="tfOrdGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                                            <stop offset="0%" stop-color="#10b981" stop-opacity="0.25" />
                                            <stop offset="100%" stop-color="#10b981" stop-opacity="0.0" />
                                        </linearGradient>
                                    </defs>

                                    @* Horizontal Grid Lines *@
                                    @for (int gridStep = 0; gridStep <= 3; gridStep++)
                                    {
                                        var yPos = 20 + gridStep * 56;
                                        <line x1="45" y1="@yPos" x2="790" y2="@yPos" class="tf-chart-gridline" />
                                    }

                                    @* Y-axis Reference Labels *@
                                    @for (int gridStep = 0; gridStep <= 3; gridStep++)
                                    {
                                        var yPos = 24 + gridStep * 56;
                                        var ratio = (3.0 - gridStep) / 3.0;
                                        var labelText = _chartMetric == "revenue"
                                            ? FormatShortMoney(_chartData.MaxDailyRevenue * (decimal)ratio)
                                            : Math.Round(_chartData.MaxDailyOrders * ratio).ToString("N0");

                                        @((MarkupString)$"<text x=\"40\" y=\"{yPos}\" text-anchor=\"end\" class=\"tf-chart-axis-text\">{labelText}</text>")
                                    }

                                    @* Render Area & Line Path *@
                                    @{
                                        var (areaD, lineD, pointCoords) = CalculateChartPaths();
                                        var gradId = _chartMetric == "revenue" ? "url(#tfRevGrad)" : "url(#tfOrdGrad)";
                                        var strokeColor = _chartMetric == "revenue" ? "var(--tf-primary, #2563eb)" : "#10b981";
                                    }

                                    @if (!string.IsNullOrEmpty(areaD))
                                    {
                                        <path d="@areaD" fill="@gradId" class="tf-chart-area-path" />
                                    }

                                    @if (!string.IsNullOrEmpty(lineD))
                                    {
                                        <path d="@lineD" fill="none" stroke="@strokeColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="tf-chart-line-path" />
                                    }

                                    @* Active Hover Indicator *@
                                    @if (_hoveredPointIndex.HasValue && _hoveredPointIndex.Value < pointCoords.Count)
                                    {
                                        var hp = pointCoords[_hoveredPointIndex.Value];
                                        var hpX = hp.X.ToString("F1", CultureInfo.InvariantCulture);
                                        var hpY = hp.Y.ToString("F1", CultureInfo.InvariantCulture);
                                        <line x1="@hpX" y1="20" x2="@hpX" y2="188" class="tf-chart-crosshair" />
                                        <circle cx="@hpX" cy="@hpY" r="5" fill="@strokeColor" class="tf-chart-active-dot" />
                                        <circle cx="@hpX" cy="@hpY" r="2" fill="#ffffff" />
                                    }

                                    @* Interactive Invisible Hit-Boxes for Hover *@
                                    @for (int i = 0; i < pointCoords.Count; i++)
                                    {
                                        var pt = pointCoords[i];
                                        var index = i;
                                        var boxWidth = Math.Max(12, 745.0 / Math.Max(1, pointCoords.Count));
                                        var boxX = Math.Max(0, pt.X - boxWidth / 2);

                                        <rect x="@boxX.ToString("F1", CultureInfo.InvariantCulture)" 
                                              y="0" 
                                              width="@boxWidth.ToString("F1", CultureInfo.InvariantCulture)" 
                                              height="200" 
                                              fill="transparent" 
                                              class="tf-chart-hitbox"
                                              @onmouseover="@(() => SetChartHover(index))" />
                                    }

                                    @* X-axis Date Labels *@
                                    @{
                                        var step = Math.Max(1, (int)Math.Ceiling(pointCoords.Count / 7.0));
                                    }
                                    @for (int i = 0; i < pointCoords.Count; i += step)
                                    {
                                        var pt = pointCoords[i];
                                        @((MarkupString)$"<text x=\"{pt.X.ToString("F1", CultureInfo.InvariantCulture)}\" y=\"215\" text-anchor=\"middle\" class=\"tf-chart-axis-text\">{_chartData.Points[i].DateLabel}</text>")
                                    }
                                </svg>

                                @* Floating Rich HTML Tooltip *@
                                @if (_hoveredPointIndex.HasValue && _hoveredPointIndex.Value < _chartData.Points.Count)
                                {
                                    var pt = _chartData.Points[_hoveredPointIndex.Value];
                                    var coords = GetPointCoords(_hoveredPointIndex.Value);
                                    var leftPercent = Math.Clamp((coords.X / 800.0) * 100.0, 8.0, 92.0);

                                    <div class="tf-chart-tooltip" style="left: @(leftPercent.ToString("F1", CultureInfo.InvariantCulture))%;">
                                        <div class="tf-chart-tooltip-header">
                                            <span class="tf-chart-tooltip-date">@pt.Date.ToString("dddd, dd/MM/yyyy", new CultureInfo("vi-VN"))</span>
                                        </div>
                                        <div class="tf-chart-tooltip-metric">
                                            <span class="tf-chart-tooltip-label">Doanh thu:</span>
                                            <strong class="tf-chart-tooltip-val tf-text-emerald">@pt.Revenue.ToString("N0") ₫</strong>
                                        </div>
                                        <div class="tf-chart-tooltip-metric">
                                            <span class="tf-chart-tooltip-label">Đơn hàng:</span>
                                            <strong class="tf-chart-tooltip-val tf-text-blue">@pt.OrderCount đơn</strong>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                @* Best Selling Products Column (35%) *@
                <div class="tf-card tf-dash-section tf-dash-top-products-card">
                    <div class="tf-dash-card-header">
                        <div>
                            <h2 class="tf-dash-card-title">Sản phẩm bán chạy</h2>
                            <p class="tf-dash-card-subtitle">Top mặt hàng có doanh thu cao nhất</p>
                        </div>
                        <a href="/danh-muc/san-pham" class="tf-dash-card-link" title="Xem danh mục sản phẩm">
                            Xem tất cả &rarr;
                        </a>
                    </div>

                    <div class="tf-dash-card-body">
                        @if (_isLoadingBestSelling)
                        {
                            <Skeleton Type="text" Rows="5" />
                        }
                        else if (_bestSellingProducts.Count == 0)
                        {
                            <div class="tf-empty tf-empty-sm">
                                <div class="tf-empty-icon">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                        <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                                        <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                                    </svg>
                                </div>
                                <div class="tf-empty-title">Chưa có dữ liệu bán chạy</div>
                                <div class="tf-empty-desc">Sản phẩm sẽ được xếp hạng khi phát sinh đơn hàng.</div>
                            </div>
                        }
                        else
                        {
                            <div class="tf-top-product-list">
                                @foreach (var p in _bestSellingProducts)
                                {
                                    <div class="tf-top-product-item">
                                        @* Rank Pill *@
                                        <div class="tf-top-product-rank tf-rank-@p.Rank">
                                            <span>#@p.Rank</span>
                                        </div>

                                        @* Thumbnail / Image *@
                                        <div class="tf-top-product-thumb">
                                            @if (!string.IsNullOrEmpty(p.ImageUrl) && !p.ImageUrl.Contains("dummy_ref"))
                                            {
                                                <img src="@p.ImageUrl" alt="@p.ProductName" loading="lazy" />
                                            }
                                            else
                                            {
                                                <div class="tf-top-product-thumb-placeholder">
                                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                                                    </svg>
                                                </div>
                                            }
                                        </div>

                                        @* Info *@
                                        <div class="tf-top-product-info">
                                            <div class="tf-top-product-title" title="@p.ProductName">
                                                @p.ProductName
                                            </div>
                                            <div class="tf-top-product-meta">
                                                <span class="tf-top-product-sku">@p.ProductCode</span>
                                                <span class="tf-top-product-dot">•</span>
                                                <span class="tf-top-product-qty">Đã bán: <strong>@p.QuantitySold.ToString("N0")</strong> @p.UnitName</span>
                                            </div>

                                            @* Relative Volume Bar *@
                                            <div class="tf-top-product-bar-wrap">
                                                <div class="tf-top-product-bar" style="width: @(p.PercentageOfTop.ToString("F1", CultureInfo.InvariantCulture))%;"></div>
                                            </div>
                                        </div>

                                        @* Revenue *@
                                        <div class="tf-top-product-revenue">
                                            <span>@(p.TotalRevenue > 0 ? $"{p.TotalRevenue:N0} ₫" : "—")</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* Level 3: Operational Section (Warehouse Overview + Recent Activity) *@
            <div class="tf-dash-operations-grid">
                @* Warehouse Overview Column (50%) *@
                <div class="tf-card tf-dash-section tf-dash-warehouse-card">
                    <div class="tf-dash-card-header">
                        <div>
                            <h2 class="tf-dash-card-title">Tình trạng kho bãi</h2>
                            <p class="tf-dash-card-subtitle">
                                Giám sát mức độ an toàn hàng tồn & các kho hoạt động
                            </p>
                        </div>
                        <a href="/kho/ton-kho" class="tf-dash-card-link" title="Xem chi tiết báo cáo tồn kho">
                            Báo cáo kho &rarr;
                        </a>
                    </div>

                    <div class="tf-dash-card-body">
                        @if (_isLoadingWarehouse)
                        {
                            <Skeleton Type="text" Rows="4" />
                        }
                        else
                        {
                            var totalItems = Math.Max(1, _warehouseSummary.InStockCount + _warehouseSummary.OutOfStockCount);
                            var inStockPct = Math.Round((double)_warehouseSummary.InStockCount / totalItems * 100.0, 1);
                            var lowStockPct = Math.Round((double)_warehouseSummary.LowStockCount / totalItems * 100.0, 1);
                            var outStockPct = Math.Max(0.0, 100.0 - inStockPct);

                            <div class="tf-warehouse-health-section">
                                <div class="tf-warehouse-health-header">
                                    <span class="tf-warehouse-health-label">Phân bổ trạng thái hàng tồn</span>
                                    <span class="tf-warehouse-health-count">@_warehouseSummary.ActiveWarehouseCount kho hoạt động</span>
                                </div>
                                <div class="tf-warehouse-health-bar">
                                    <div class="tf-bar-segment is-instock" style="width: @(inStockPct.ToString("F1", CultureInfo.InvariantCulture))%;" title="Đủ hàng: @_warehouseSummary.InStockCount SKU"></div>
                                    <div class="tf-bar-segment is-lowstock" style="width: @(lowStockPct.ToString("F1", CultureInfo.InvariantCulture))%;" title="Tồn thấp: @_warehouseSummary.LowStockCount SKU"></div>
                                    <div class="tf-bar-segment is-outstock" style="width: @(outStockPct.ToString("F1", CultureInfo.InvariantCulture))%;" title="Hết hàng: @_warehouseSummary.OutOfStockCount SKU"></div>
                                </div>
                                <div class="tf-warehouse-health-legend">
                                    <span class="tf-legend-item is-instock">
                                        <span class="tf-legend-dot"></span>
                                        <span>Đủ hàng: <strong>@_warehouseSummary.InStockCount</strong> SKU</span>
                                    </span>
                                    <span class="tf-legend-item is-lowstock">
                                        <span class="tf-legend-dot"></span>
                                        <span>Tồn thấp (&lt;15): <strong>@_warehouseSummary.LowStockCount</strong> SKU</span>
                                    </span>
                                    <span class="tf-legend-item is-outstock">
                                        <span class="tf-legend-dot"></span>
                                        <span>Hết hàng: <strong>@_warehouseSummary.OutOfStockCount</strong> SKU</span>
