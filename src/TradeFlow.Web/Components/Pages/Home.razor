                @* Recent Activities Column (50%) *@
                <div class="tf-card tf-dash-section tf-dash-activity-card">
                    <div class="tf-dash-card-header">
                        <div>
                            <h2 class="tf-dash-card-title">Hoạt động gần đây</h2>
                            <p class="tf-dash-card-subtitle">Nhật ký kiểm toán & sự kiện nghiệp vụ hệ thống</p>
                        </div>
                        <a href="/cai-dat/nhat-ky-he-thong" class="tf-dash-card-link" title="Xem toàn bộ nhật ký hệ thống">
                            Tất cả nhật ký &rarr;
                        </a>
                    </div>

                    <div class="tf-dash-card-body">
                        @if (_isLoadingActivities)
                        {
                            <Skeleton Type="text" Rows="6" />
                        }
                        else if (_recentActivities.Count == 0)
                        {
                            <div class="tf-empty tf-empty-sm">
                                <div class="tf-empty-icon">
                                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <polyline points="12 6 12 12 16 14"></polyline>
                                    </svg>
                                </div>
                                <div class="tf-empty-title">Chưa có hoạt động</div>
                                <div class="tf-empty-desc">Các giao dịch phát sinh sẽ xuất hiện theo thời gian thực.</div>
                            </div>
                        }
                        else
                        {
                            <div class="tf-activity-timeline">
                                @foreach (var act in _recentActivities)
                                {
                                    <div class="tf-timeline-item">
                                        @* Category Icon *@
                                        <div class="tf-timeline-icon @GetActivityIconClass(act.EventType)">
                                            @((MarkupString)GetActivityIconSvg(act.EventType))
                                        </div>

                                        @* Content *@
                                        <div class="tf-timeline-content">
                                            <div class="tf-timeline-header">
                                                <span class="tf-timeline-title">@act.Title</span>
                                                <span class="tf-timeline-time" title="@act.OccurredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")">
                                                    @FormatRelativeTime(act.OccurredAt)
                                                </span>
                                            </div>

                                            @if (!string.IsNullOrEmpty(act.Description))
                                            {
                                                <p class="tf-timeline-desc">@act.Description</p>
                                            }

                                            <div class="tf-timeline-footer">
                                                <span class="tf-timeline-user">
                                                    <span class="tf-user-avatar-tiny">@GetUserInitial(act.PerformedBy)</span>
                                                    <span>@(act.PerformedBy ?? "Hệ thống")</span>
                                                </span>

                                                @if (!string.IsNullOrEmpty(act.TargetUrl))
                                                {
                                                    <a href="@act.TargetUrl" class="tf-timeline-action-link">
                                                        Xem chi tiết &rarr;
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* Level 4: Real-time Activity Toast Notifications (Bottom-Right) *@
            @if (_activeToasts.Count > 0)
            {
                <div class="tf-activity-toast-stack" aria-live="polite">
                    @foreach (var toast in _activeToasts)
                    {
                        <div class="tf-activity-toast" id="toast-@toast.EventId" role="status">
                            <div class="tf-toast-icon @GetActivityIconClass(toast.EventType)">
                                @((MarkupString)GetActivityIconSvg(toast.EventType))
                            </div>
                            <div class="tf-toast-body">
                                <div class="tf-toast-title">
                                    <strong>@toast.PerformedBy</strong> vừa phát sinh:
                                </div>
                                <div class="tf-toast-message">@toast.Title</div>
                                @if (!string.IsNullOrEmpty(toast.TargetUrl))
                                {
                                    <a href="@toast.TargetUrl" class="tf-toast-link">Mở chứng từ</a>
                                }
                            </div>
                            <button type="button" class="tf-toast-close" @onclick="@(() => DismissToast(toast.EventId))" aria-label="Đóng thông báo">
                                &times;
                            </button>
                        </div>
                    }
                </div>
            }
        </div>
    </Authorized>

