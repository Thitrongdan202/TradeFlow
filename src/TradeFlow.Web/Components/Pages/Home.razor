@page "/"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Globalization
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Application.Common.Models.Dashboard
@using TradeFlow.Domain.Enums
@using TradeFlow.Web.Services
@implements IDisposable
@inject IDashboardAnalyticsService AnalyticsService
@inject IDashboardStateService DashboardState
@inject IUserActivityBroadcaster ActivityBroadcaster
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Tổng quan — TradeFlow</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="tf-dash-container" id="tf-dash-root">
            @* Level 0: Dashboard Header *@
            <div class="tf-dash-header">
                <div class="tf-dash-header-left">
                    <div class="tf-dash-badge">
                        <span class="tf-dash-badge-dot"></span>
                        <span>Hệ thống ERP trực tuyến</span>
                    </div>
                    <h1 class="tf-dash-title">Tổng quan</h1>
                    <p class="tf-dash-subtitle">
                        Chào mừng trở lại, <strong>@context.User.Identity?.Name</strong> • 
                        <span>@DateTime.Now.ToString("dddd, dd/MM/yyyy", new CultureInfo("vi-VN"))</span>
                    </p>
                </div>

                <div class="tf-dash-header-actions">
                    @* Period Switcher Pills — Exact Order Requested:
                       1. Hôm qua (yesterday)
                       2. Hôm nay (today)
                       3. 7 ngày qua (7d)
                       4. 30 ngày qua (30d)
                       5. Tháng này (this_month)
                       6. Tháng trước (last_month)
                       7. Tùy chỉnh (custom dropdown) *@
                    <div class="tf-dash-period-pills" role="group" aria-label="Bộ lọc khoảng thời gian">
                        <button type="button" 
                                class="tf-dash-pill @(_selectedPeriod == "yesterday" ? "is-active" : "")" 
                                @onclick="@(() => ChangePeriodAsync("yesterday"))">
                            Hôm qua
                        </button>
                        <button type="button" 
                                class="tf-dash-pill @(_selectedPeriod == "today" ? "is-active" : "")" 
                                @onclick="@(() => ChangePeriodAsync("today"))">
                            Hôm nay
                        </button>
                        <button type="button" 
                                class="tf-dash-pill @(_selectedPeriod == "7d" ? "is-active" : "")" 
                                @onclick="@(() => ChangePeriodAsync("7d"))">
                            7 ngày qua
                        </button>
                        <button type="button" 
                                class="tf-dash-pill @(_selectedPeriod == "30d" ? "is-active" : "")" 
                                @onclick="@(() => ChangePeriodAsync("30d"))">
                            30 ngày qua
                        </button>
                        <button type="button" 
                                class="tf-dash-pill @(_selectedPeriod == "this_month" ? "is-active" : "")" 
                                @onclick="@(() => ChangePeriodAsync("this_month"))">
                            Tháng này
                        </button>
                        <button type="button" 
                                class="tf-dash-pill @(_selectedPeriod == "last_month" ? "is-active" : "")" 
                                @onclick="@(() => ChangePeriodAsync("last_month"))">
                            Tháng trước
                        </button>

                        @* Custom Date Range Popover/Dropdown Wrap *@
                        <div class="tf-dash-custom-dropdown-wrap">
                            <button type="button" 
                                    class="tf-dash-pill @(_selectedPeriod == "custom" ? "is-active" : "") @(_isCustomDropdownOpen ? "is-dropdown-open" : "")" 
                                    @onclick="ToggleCustomDropdown"
                                    title="Tùy chỉnh khoảng thời gian">
                                <span>@GetCustomButtonLabel()</span>
                                <svg class="tf-dropdown-chevron @(_isCustomDropdownOpen ? "is-rotated" : "")" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                    <polyline points="6 9 12 15 18 9"></polyline>
                                </svg>
                            </button>

                            @if (_isCustomDropdownOpen)
                            {
                                <div class="tf-popover-backdrop" @onclick="CloseCustomDropdown"></div>
                                <div class="tf-custom-date-popover" @onclick:stopPropagation="true">
                                    <div class="tf-popover-header">
                                        <span class="tf-popover-title">Tùy chỉnh khoảng thời gian</span>
                                        <button type="button" class="tf-popover-close-btn" @onclick="CloseCustomDropdown" aria-label="Đóng">&times;</button>
                                    </div>

                                    @* Quick presets *@
                                    <div class="tf-popover-presets">
                                        <span class="tf-presets-label">Preset nhanh:</span>
                                        <div class="tf-presets-chips">
                                            <button type="button" class="tf-preset-chip" @onclick="@(() => SelectPreset("yesterday"))">Hôm qua</button>
                                            <button type="button" class="tf-preset-chip" @onclick="@(() => SelectPreset("today"))">Hôm nay</button>
                                            <button type="button" class="tf-preset-chip" @onclick="@(() => SelectPreset("7d"))">7 ngày</button>
                                            <button type="button" class="tf-preset-chip" @onclick="@(() => SelectPreset("30d"))">30 ngày</button>
                                            <button type="button" class="tf-preset-chip" @onclick="@(() => SelectPreset("this_month"))">Tháng này</button>
                                        </div>
                                    </div>

                                    @* Date range inputs *@
                                    <div class="tf-popover-dates">
                                        <div class="tf-date-field">
                                            <label class="tf-date-field-label">Từ ngày:</label>
                                            <input type="date" class="tf-date-field-input" @bind="_tempStartDate" />
                                        </div>
                                        <div class="tf-date-field">
                                            <label class="tf-date-field-label">Đến ngày:</label>
                                            <input type="date" class="tf-date-field-input" @bind="_tempEndDate" />
                                        </div>
                                    </div>

                                    <div class="tf-popover-hint">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <circle cx="12" cy="12" r="10"></circle>
                                            <line x1="12" y1="16" x2="12" y2="12"></line>
                                            <line x1="12" y1="8" x2="12.01" y2="8"></line>
                                        </svg>
                                        <span>Chọn cùng một ngày để xem chi tiết 24 giờ.</span>
                                    </div>

                                    <div class="tf-popover-actions">
                                        <button type="button" class="tf-btn tf-btn-xs tf-btn-ghost" @onclick="ResetCustomDates">
                                            Xóa lựa chọn
                                        </button>
                                        <div class="tf-popover-actions-right">
                                            <button type="button" class="tf-btn tf-btn-xs tf-btn-secondary" @onclick="CloseCustomDropdown">
                                                Hủy
                                            </button>
                                            <button type="button" class="tf-btn tf-btn-xs tf-btn-primary" @onclick="ApplyCustomDateDropdownAsync" disabled="@(!_tempStartDate.HasValue || !_tempEndDate.HasValue)">
                                                Áp dụng
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    @* Refresh Button *@
                    <button type="button" 
                            class="tf-btn tf-btn-secondary tf-dash-refresh-btn @(_isRefreshing ? "is-spinning" : "")" 
                            @onclick="RefreshDataAsync" 
                            title="Làm mới dữ liệu tổng quan"
                            aria-label="Làm mới">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="23 4 23 10 17 10"></polyline>
                            <polyline points="1 20 1 14 7 14"></polyline>
                            <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
                        </svg>
                        <span class="tf-dash-refresh-label">Làm mới</span>
                    </button>
                </div>
            </div>

            @* Level 1: Modern KPI Grid (4 Cards) Synchronized with Selected Period *@
            <div class="tf-dash-kpi-grid">
                @if (_isInitialLoading && _kpis.PeriodRevenue == 0)
                {
                    for (int i = 0; i < 4; i++)
                    {
                        <div class="tf-kpi-card is-loading">
                            <Skeleton Type="stats" />
                        </div>
                    }
                }
                else
                {
                    @* Card 1: Doanh thu *@
                    <div class="tf-kpi-card tf-kpi-revenue">
                        <div class="tf-kpi-top">
                            <span class="tf-kpi-label">@(_kpis.PeriodRevenueLabel ?? "Doanh thu kỳ này")</span>
                            <div class="tf-kpi-icon tf-kpi-icon-emerald">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="12" y1="1" x2="12" y2="23"></line>
                                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                                </svg>
                            </div>
                        </div>
                        <div class="tf-kpi-value">
                            @(_kpis.PeriodRevenue > 0 ? $"{_kpis.PeriodRevenue:N0} ₫" : "0 ₫")
                        </div>
                        <div class="tf-kpi-bottom">
                            @if (_kpis.RevenueGrowthPercent.HasValue)
                            {
                                var isPositive = _kpis.RevenueGrowthPercent.Value >= 0;
                                <span class="tf-kpi-trend @(isPositive ? "is-up" : "is-down")">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                        <polyline points="@(isPositive ? "18 15 12 9 6 15" : "6 9 12 15 18 9")"></polyline>
                                    </svg>
                                    @(isPositive ? "+" : "")@(_kpis.RevenueGrowthPercent.Value)%
                                </span>
                                <span class="tf-kpi-subtext">so với @(_kpis.PreviousPeriodLabel ?? "kỳ trước")</span>
                            }
                            else
                            {
                                <span class="tf-kpi-subtext">Hóa đơn phát sinh theo kỳ đã chọn</span>
                            }
                        </div>
                    </div>

                    @* Card 2: Đơn bán hàng *@
                    <div class="tf-kpi-card tf-kpi-orders">
                        <div class="tf-kpi-top">
                            <span class="tf-kpi-label">@(_kpis.PeriodOrdersLabel ?? "Tổng đơn bán hàng")</span>
                            <div class="tf-kpi-icon tf-kpi-icon-blue">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="9" cy="21" r="1"></circle>
                                    <circle cx="20" cy="21" r="1"></circle>
                                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                </svg>
                            </div>
                        </div>
                        <div class="tf-kpi-value">
                            @_kpis.PeriodOrdersCount.ToString("N0") <span class="tf-kpi-unit">đơn</span>
                        </div>
                        <div class="tf-kpi-bottom">
                            @if (_kpis.PeriodItemsSoldCount > 0)
                            {
                                <span class="tf-kpi-subtext">
                                    Tổng <strong>@_kpis.PeriodItemsSoldCount.ToString("N0")</strong> sản phẩm xuất bán
                                </span>
                            }
                            else
                            {
                                <span class="tf-kpi-subtext">
                                    <strong>@_kpis.TodayOrdersCount</strong> đơn hôm nay • <strong>@_kpis.MonthOrdersCount</strong> trong tháng
                                </span>
                            }
                        </div>
                    </div>

                    @* Card 3: Mặt hàng lưu kho *@
                    <div class="tf-kpi-card tf-kpi-inventory">
                        <div class="tf-kpi-top">
                            <span class="tf-kpi-label">Mặt hàng lưu kho</span>
                            <div class="tf-kpi-icon tf-kpi-icon-amber">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                                    <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                                    <line x1="12" y1="22.08" x2="12" y2="12"></line>
                                </svg>
                            </div>
                        </div>
                        <div class="tf-kpi-value">
                            @_kpis.InStockItemsCount.ToString("N0") <span class="tf-kpi-unit">SKU khả dụng</span>
                        </div>
                        <div class="tf-kpi-bottom">
                            @if (_kpis.LowStockItemsCount > 0)
                            {
                                <span class="tf-kpi-badge-warning">
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <line x1="12" y1="8" x2="12" y2="12"></line>
                                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                                    </svg>
                                    @_kpis.LowStockItemsCount mặt hàng tồn thấp
                                </span>
                            }
                            else
                            {
                                <span class="tf-kpi-subtext">Đủ số dư khả dụng</span>
                            }
                        </div>
                    </div>

                    @* Card 4: Khách hàng hoạt động *@
                    <div class="tf-kpi-card tf-kpi-customers">
                        <div class="tf-kpi-top">
                            <span class="tf-kpi-label">Khách hàng hoạt động</span>
                            <div class="tf-kpi-icon tf-kpi-icon-purple">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="9" cy="7" r="4"></circle>
                                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                </svg>
                            </div>
                        </div>
                        <div class="tf-kpi-value">
                            @_kpis.ActiveCustomersCount.ToString("N0") <span class="tf-kpi-unit">đối tác</span>
                        </div>
                        <div class="tf-kpi-bottom">
                            <span class="tf-kpi-subtext">Đối tác thương mại & phân phối</span>
                        </div>
                    </div>
                }
            </div>

            @* Level 2: Analytics Row (Revenue Chart + Best Selling Products) *@
            <div class="tf-dash-analytics-grid">
                @* Chart Column (65%) *@
                <div class="tf-card tf-dash-section tf-dash-chart-card">
                    <div class="tf-dash-card-header">
                        <div>
                            <h2 class="tf-dash-card-title">@(_chartData.PeriodTitle ?? "Biểu đồ doanh thu & bán hàng")</h2>
                            <p class="tf-dash-card-subtitle">
                                Tổng hợp biến động doanh số theo thời gian thực (@GetPeriodLabel(_selectedPeriod))
                            </p>
                        </div>

                        <div class="tf-dash-chart-controls">
                            @* Metric switch: Revenue vs Orders *@
                            <div class="tf-dash-metric-switch">
                                <button type="button" 
                                        class="tf-dash-switch-btn @(_chartMetric == "revenue" ? "is-active" : "")"
                                        @onclick="@(() => SetChartMetricAsync("revenue"))">
                                    Doanh thu (₫)
                                </button>
                                <button type="button" 
                                        class="tf-dash-switch-btn @(_chartMetric == "orders" ? "is-active" : "")"
                                        @onclick="@(() => SetChartMetricAsync("orders"))">
                                    Số đơn hàng
                                </button>
                            </div>

                            @* Summary badge *@
                            <div class="tf-dash-chart-sum-badge">
                                @if (_chartMetric == "revenue")
                                {
                                    <span>Tổng kỳ: <strong>@_chartData.TotalPeriodRevenue.ToString("N0") ₫</strong></span>
                                }
                                else
                                {
                                    <span>Tổng kỳ: <strong>@_chartData.TotalPeriodOrders đơn</strong></span>
                                }
                            </div>

                            @* Sync indicator during background update *@
                            @if (_isPeriodSwitching)
                            {
                                <div class="tf-chart-sync-indicator" role="status" aria-label="Đang cập nhật">
                                    <span class="tf-sync-spinner"></span>
                                    <span class="tf-sync-text">Đang cập nhật...</span>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="tf-dash-chart-body">
                        @* Error Banner if API error occurred *@
                        @if (!string.IsNullOrEmpty(_chartErrorMessage))
                        {
                            <div class="tf-chart-error-banner">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <line x1="12" y1="8" x2="12" y2="12"></line>
                                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                                </svg>
                                <div class="tf-chart-error-content">
                                    <span class="tf-chart-error-title">Lỗi tải dữ liệu biểu đồ</span>
                                    <span class="tf-chart-error-desc">@_chartErrorMessage</span>
                                </div>
                                <button type="button" class="tf-btn tf-btn-xs tf-btn-secondary" @onclick="@(() => ChangePeriodAsync(_selectedPeriod, _customStartDate, _customEndDate))">
                                    Thử lại
                                </button>
                            </div>
                        }

                        @* Daily Overview Summary Bar (When in 1-Day Hourly Mode) *@
                        @if (_chartData.IsHourly && !_isInitialLoading && string.IsNullOrEmpty(_chartErrorMessage))
                        {
                            <div class="tf-dash-hourly-summary-bar">
                                <div class="tf-hourly-summary-item">
                                    <span class="tf-hsum-label">Doanh thu ngày</span>
                                    <strong class="tf-hsum-val tf-text-emerald">@_chartData.TotalPeriodRevenue.ToString("N0") ₫</strong>
                                </div>
                                <div class="tf-hourly-summary-divider"></div>
                                <div class="tf-hourly-summary-item">
                                    <span class="tf-hsum-label">Tổng đơn</span>
                                    <strong class="tf-hsum-val tf-text-blue">@_chartData.TotalPeriodOrders đơn</strong>
                                </div>
                                <div class="tf-hourly-summary-divider"></div>
                                <div class="tf-hourly-summary-item">
                                    <span class="tf-hsum-label">Tổng SP bán</span>
                                    <strong class="tf-hsum-val tf-text-amber">@_chartData.TotalPeriodItemsSold.ToString("N0") món</strong>
                                </div>
                                @if (!string.IsNullOrEmpty(_chartData.PeakHourLabel))
                                {
                                    <div class="tf-hourly-summary-divider"></div>
                                    <div class="tf-hourly-summary-item">
                                        <span class="tf-hsum-label">Đỉnh doanh thu</span>
                                        <strong class="tf-hsum-val tf-text-amber" title="Doanh thu đỉnh: @_chartData.PeakHourRevenue.ToString("N0") ₫">
                                            @_chartData.PeakHourLabel (@FormatShortMoney(_chartData.PeakHourRevenue))
                                        </strong>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(_chartData.PeakOrderHourLabel))
                                {
                                    <div class="tf-hourly-summary-divider"></div>
                                    <div class="tf-hourly-summary-item">
                                        <span class="tf-hsum-label">Đỉnh số đơn</span>
                                        <strong class="tf-hsum-val tf-text-purple">
                                            @_chartData.PeakOrderHourLabel (@_chartData.PeakHourlyOrders đơn)
                                        </strong>
                                    </div>
                                }
                            </div>
                        }

                        @if (_isInitialLoading && _chartData.Points.Count == 0)
                        {
                            <div class="tf-chart-skeleton">
                                <Skeleton Type="text" Rows="6" />
                            </div>
                        }
                        else if (_chartData.Points.Count == 0 && !_isPeriodSwitching)
                        {
                            <div class="tf-chart-empty">
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <line x1="18" y1="20" x2="18" y2="10"></line>
                                    <line x1="12" y1="20" x2="12" y2="4"></line>
                                    <line x1="6" y1="20" x2="6" y2="14"></line>
                                </svg>
                                <span>Chưa có dữ liệu giao dịch trong khoảng thời gian này</span>
                            </div>
                        }
                        else
                        {
                            @* High-end SVG Area Chart with interactive Hover & smooth dataset transitions *@
                            <div class="tf-chart-viewport-wrap @(_isPeriodSwitching ? "is-syncing" : "")" @onmouseleave="ClearChartHover">
                                <svg class="tf-chart-svg" viewBox="0 0 800 240" preserveAspectRatio="none" aria-label="Biểu đồ bán hàng">
                                    <defs>
                                        <linearGradient id="tfRevGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                                            <stop offset="0%" stop-color="var(--tf-primary, #2563eb)" stop-opacity="0.28" />
                                            <stop offset="100%" stop-color="var(--tf-primary, #2563eb)" stop-opacity="0.0" />
                                        </linearGradient>
                                        <linearGradient id="tfOrdGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                                            <stop offset="0%" stop-color="#10b981" stop-opacity="0.25" />
                                            <stop offset="100%" stop-color="#10b981" stop-opacity="0.0" />
                                        </linearGradient>
                                    </defs>

                                    @* Horizontal Grid Lines *@
                                    @for (int gridStep = 0; gridStep <= 3; gridStep++)
                                    {
                                        var yPos = 20 + gridStep * 56;
                                        <line x1="45" y1="@yPos" x2="790" y2="@yPos" class="tf-chart-gridline" />
                                    }

                                    @* Y-axis Reference Labels *@
                                    @for (int gridStep = 0; gridStep <= 3; gridStep++)
                                    {
                                        var yPos = 24 + gridStep * 56;
                                        var ratio = (3.0 - gridStep) / 3.0;
                                        var labelText = _chartMetric == "revenue"
                                            ? FormatShortMoney(_chartData.MaxDailyRevenue * (decimal)ratio)
                                            : Math.Round(_chartData.MaxDailyOrders * ratio).ToString("N0");

                                        @((MarkupString)$"<text x=\"40\" y=\"{yPos}\" text-anchor=\"end\" class=\"tf-chart-axis-text\">{labelText}</text>")
                                    }

                                    @* Render Area & Line Path *@
                                    @{
                                        var (areaD, lineD, pointCoords) = CalculateChartPaths();
                                        var gradId = _chartMetric == "revenue" ? "url(#tfRevGrad)" : "url(#tfOrdGrad)";
                                        var strokeColor = _chartMetric == "revenue" ? "var(--tf-primary, #2563eb)" : "#10b981";
                                    }

                                    @if (!string.IsNullOrEmpty(areaD))
                                    {
                                        <path d="@areaD" fill="@gradId" class="tf-chart-area-path" />
                                    }

                                    @if (!string.IsNullOrEmpty(lineD))
                                    {
                                        <path d="@lineD" fill="none" stroke="@strokeColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="tf-chart-line-path" />
                                    }

                                    @* Peak & Lowest Day Highlight Markers on Multi-day Line *@
                                    @if (!_chartData.IsHourly && pointCoords.Count > 1)
                                    {
                                        @for (int i = 0; i < pointCoords.Count; i++)
                                        {
                                            var ptModel = _chartData.Points[i];
                                            if (ptModel.IsPeak && ptModel.Revenue > 0)
                                            {
                                                var pCoord = pointCoords[i];
                                                <circle cx="@pCoord.X.ToString("F1", CultureInfo.InvariantCulture)" 
                                                        cy="@pCoord.Y.ToString("F1", CultureInfo.InvariantCulture)" 
                                                        r="4.5" fill="#f59e0b" stroke="#ffffff" stroke-width="1.5" class="tf-chart-peak-marker" />
                                            }
                                            else if (ptModel.IsLowest && ptModel.Revenue > 0)
                                            {
                                                var pCoord = pointCoords[i];
                                                <circle cx="@pCoord.X.ToString("F1", CultureInfo.InvariantCulture)" 
                                                        cy="@pCoord.Y.ToString("F1", CultureInfo.InvariantCulture)" 
                                                        r="3.5" fill="#94a3b8" stroke="#ffffff" stroke-width="1.5" class="tf-chart-lowest-marker" />
                                            }
                                        }
                                    }

                                    @* Active Hover Indicator *@
                                    @if (_hoveredPointIndex.HasValue && _hoveredPointIndex.Value < pointCoords.Count)
                                    {
                                        var hp = pointCoords[_hoveredPointIndex.Value];
                                        var hpX = hp.X.ToString("F1", CultureInfo.InvariantCulture);
                                        var hpY = hp.Y.ToString("F1", CultureInfo.InvariantCulture);
                                        <line x1="@hpX" y1="20" x2="@hpX" y2="188" class="tf-chart-crosshair" />
                                        <circle cx="@hpX" cy="@hpY" r="5" fill="@strokeColor" class="tf-chart-active-dot" />
                                        <circle cx="@hpX" cy="@hpY" r="2" fill="#ffffff" />
                                    }

                                    @* Interactive Invisible Hit-Boxes for Hover *@
                                    @for (int i = 0; i < pointCoords.Count; i++)
                                    {
                                        var pt = pointCoords[i];
                                        var index = i;
                                        var boxWidth = Math.Max(12, 745.0 / Math.Max(1, pointCoords.Count));
                                        var boxX = Math.Max(0, pt.X - boxWidth / 2);

                                        <rect x="@boxX.ToString("F1", CultureInfo.InvariantCulture)" 
                                              y="0" 
                                              width="@boxWidth.ToString("F1", CultureInfo.InvariantCulture)" 
                                              height="200" 
                                              fill="transparent" 
                                              class="tf-chart-hitbox"
                                              @onmouseover="@(() => SetChartHover(index))" />
                                    }

                                    @* X-axis Date Labels *@
                                    @{
                                        var step = _chartData.IsHourly ? 3 : Math.Max(1, (int)Math.Ceiling(pointCoords.Count / 7.0));
                                    }
                                    @for (int i = 0; i < pointCoords.Count; i += step)
                                    {
                                        var pt = pointCoords[i];
                                        @((MarkupString)$"<text x=\"{pt.X.ToString("F1", CultureInfo.InvariantCulture)}\" y=\"215\" text-anchor=\"middle\" class=\"tf-chart-axis-text\">{_chartData.Points[i].DateLabel}</text>")
                                    }
                                    @if ((pointCoords.Count - 1) % step != 0)
                                    {
                                        var lastPt = pointCoords[^1];
                                        @((MarkupString)$"<text x=\"{lastPt.X.ToString("F1", CultureInfo.InvariantCulture)}\" y=\"215\" text-anchor=\"middle\" class=\"tf-chart-axis-text\">{_chartData.Points[^1].DateLabel}</text>")
                                    }
                                </svg>

                                @* Floating Rich HTML Tooltip with Hourly Products Sold Table *@
                                @if (_hoveredPointIndex.HasValue && _hoveredPointIndex.Value < _chartData.Points.Count)
                                {
                                    var pt = _chartData.Points[_hoveredPointIndex.Value];
                                    var coords = GetPointCoords(_hoveredPointIndex.Value);
                                    var leftPercent = Math.Clamp((coords.X / 800.0) * 100.0, 10.0, 90.0);

                                    <div class="tf-chart-tooltip" style="left: @(leftPercent.ToString("F1", CultureInfo.InvariantCulture))%;">
                                        <div class="tf-chart-tooltip-header">
                                            @if (_chartData.IsHourly)
                                            {
                                                <div class="tf-chart-tooltip-time-row">
                                                    <span class="tf-chart-tooltip-date">Khung giờ: <strong>@pt.DateLabel – @($"{pt.Hour + 1:D2}:00")</strong></span>
                                                    @if (pt.IsPeak)
                                                    {
                                                        <span class="tf-peak-pill-sm">★ Đỉnh doanh thu</span>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="tf-chart-tooltip-time-row">
                                                    <span class="tf-chart-tooltip-date">@pt.FullDateLabel</span>
                                                    @if (pt.IsPeak)
                                                    {
                                                        <span class="tf-peak-pill-sm">★ Đỉnh doanh thu</span>
                                                    }
                                                    else if (pt.IsLowest && _chartData.Points.Count > 1 && pt.Revenue > 0)
                                                    {
                                                        <span class="tf-lowest-pill-sm">Điểm thấp nhất</span>
                                                    }
                                                </div>
                                            }
                                        </div>

                                        <div class="tf-chart-tooltip-metrics-grid">
                                            <div class="tf-chart-tooltip-metric">
                                                <span class="tf-chart-tooltip-label">Doanh thu:</span>
                                                <strong class="tf-chart-tooltip-val tf-text-emerald">@pt.Revenue.ToString("N0") ₫</strong>
                                            </div>
                                            <div class="tf-chart-tooltip-metric">
                                                <span class="tf-chart-tooltip-label">Số đơn:</span>
                                                <strong class="tf-chart-tooltip-val tf-text-blue">@pt.OrderCount đơn</strong>
                                            </div>
                                            <div class="tf-chart-tooltip-metric">
                                                <span class="tf-chart-tooltip-label">Số SP bán:</span>
                                                <strong class="tf-chart-tooltip-val tf-text-amber">@pt.ItemsSold.ToString("N0") món</strong>
                                            </div>
                                        </div>

                                        @* If Hourly and has products sold, display breakdown table *@
                                        @if (_chartData.IsHourly && pt.ProductsSold != null && pt.ProductsSold.Count > 0)
                                        {
                                            <div class="tf-tooltip-products-section">
                                                <div class="tf-tooltip-products-title">Sản phẩm xuất bán trong giờ (@pt.ProductsSold.Count):</div>
                                                <div class="tf-tooltip-table-wrap">
                                                    <table class="tf-tooltip-table">
                                                        <thead>
                                                            <tr>
                                                                <th>Sản phẩm</th>
                                                                <th class="tf-th-right">SL</th>
                                                                <th class="tf-th-right">Thành tiền</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var prod in pt.ProductsSold)
                                                            {
                                                                <tr>
                                                                    <td class="tf-td-name" title="@prod.ProductName">@prod.ProductName</td>
                                                                    <td class="tf-td-right">@prod.Quantity.ToString("N0")</td>
                                                                    <td class="tf-td-right tf-td-amount">@prod.TotalAmount.ToString("N0") ₫</td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        }
                                        else if (_chartData.IsHourly && pt.OrderCount == 0)
                                        {
                                            <div class="tf-tooltip-zero-note">Không phát sinh giao dịch trong giờ này</div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                @* Best Selling Products Column (35%) *@
                <div class="tf-card tf-dash-section tf-dash-top-products-card">
                    <div class="tf-dash-card-header">
                        <div>
                            <h2 class="tf-dash-card-title">Sản phẩm bán chạy</h2>
                            <p class="tf-dash-card-subtitle">Top mặt hàng có doanh thu cao nhất (@GetPeriodLabel(_selectedPeriod))</p>
                        </div>
                        <a href="/danh-muc/san-pham" class="tf-dash-card-link" title="Xem danh mục sản phẩm">
                            Xem tất cả &rarr;
                        </a>
                    </div>

                    <div class="tf-dash-card-body">
                        @if (_isInitialLoading && _bestSellingProducts.Count == 0)
                        {
                            <Skeleton Type="text" Rows="5" />
                        }
                        else if (_bestSellingProducts.Count == 0 && !_isPeriodSwitching)
                        {
                            <div class="tf-empty tf-empty-sm">
                                <div class="tf-empty-icon">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                        <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                                        <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                                    </svg>
                                </div>
                                <div class="tf-empty-title">Chưa có dữ liệu bán chạy</div>
                                <div class="tf-empty-desc">Sản phẩm sẽ được xếp hạng khi phát sinh đơn hàng trong kỳ này.</div>
                            </div>
                        }
                        else
                        {
                            <div class="tf-top-product-list">
                                @foreach (var p in _bestSellingProducts)
                                {
                                    <div class="tf-top-product-item">
                                        @* Rank Pill *@
                                        <div class="tf-top-product-rank tf-rank-@p.Rank">
                                            <span>#@p.Rank</span>
                                        </div>

                                        @* Thumbnail / Image *@
                                        <div class="tf-top-product-thumb">
                                            @if (!string.IsNullOrEmpty(p.ImageUrl) && !p.ImageUrl.Contains("dummy_ref"))
                                            {
                                                <img src="@p.ImageUrl" alt="@p.ProductName" loading="lazy" />
                                            }
                                            else
                                            {
                                                <div class="tf-top-product-thumb-placeholder">
                                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                                                    </svg>
                                                </div>
                                            }
                                        </div>

                                        @* Info *@
                                        <div class="tf-top-product-info">
                                            <div class="tf-top-product-title" title="@p.ProductName">
                                                @p.ProductName
                                            </div>
                                            <div class="tf-top-product-meta">
                                                <span class="tf-top-product-sku">@p.ProductCode</span>
                                                <span class="tf-top-product-dot">•</span>
                                                <span class="tf-top-product-qty">Đã bán: <strong>@p.QuantitySold.ToString("N0")</strong> @p.UnitName</span>
                                            </div>

                                            @* Relative Volume Bar *@
                                            <div class="tf-top-product-bar-wrap">
                                                <div class="tf-top-product-bar" style="width: @(p.PercentageOfTop.ToString("F1", CultureInfo.InvariantCulture))%;"></div>
                                            </div>
                                        </div>

                                        @* Revenue *@
                                        <div class="tf-top-product-revenue">
                                            <span>@(p.TotalRevenue > 0 ? $"{p.TotalRevenue:N0} ₫" : "—")</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* Level 3: Operational Section (Warehouse Overview + Recent Activity) *@
            <div class="tf-dash-operations-grid">
                @* Warehouse Overview Column (50%) *@
                <div class="tf-card tf-dash-section tf-dash-warehouse-card">
                    <div class="tf-dash-card-header">
                        <div>
                            <h2 class="tf-dash-card-title">Tình trạng kho bãi</h2>
                            <p class="tf-dash-card-subtitle">
                                Giám sát mức độ an toàn hàng tồn & các kho hoạt động
                            </p>
                        </div>
                        <a href="/kho/ton-kho" class="tf-dash-card-link" title="Xem chi tiết báo cáo tồn kho">
                            Báo cáo kho &rarr;
                        </a>
                    </div>

                    <div class="tf-dash-card-body">
                        @if (_isLoadingWarehouse)
                        {
                            <Skeleton Type="text" Rows="4" />
                        }
                        else
                        {
                            var totalItems = Math.Max(1, _warehouseSummary.InStockCount + _warehouseSummary.OutOfStockCount);
                            var inStockPct = Math.Round((double)_warehouseSummary.InStockCount / totalItems * 100.0, 1);
                            var lowStockPct = Math.Round((double)_warehouseSummary.LowStockCount / totalItems * 100.0, 1);
                            var outStockPct = Math.Max(0.0, 100.0 - inStockPct);

                            <div class="tf-warehouse-health-section">
                                <div class="tf-warehouse-health-header">
                                    <span class="tf-warehouse-health-label">Phân bổ trạng thái hàng tồn</span>
                                    <span class="tf-warehouse-health-count">@_warehouseSummary.ActiveWarehouseCount kho hoạt động</span>
                                </div>
                                <div class="tf-warehouse-health-bar">
                                    <div class="tf-bar-segment is-instock" style="width: @(inStockPct.ToString("F1", CultureInfo.InvariantCulture))%;" title="Đủ hàng: @_warehouseSummary.InStockCount SKU"></div>
                                    <div class="tf-bar-segment is-lowstock" style="width: @(lowStockPct.ToString("F1", CultureInfo.InvariantCulture))%;" title="Tồn thấp: @_warehouseSummary.LowStockCount SKU"></div>
                                    <div class="tf-bar-segment is-outstock" style="width: @(outStockPct.ToString("F1", CultureInfo.InvariantCulture))%;" title="Hết hàng: @_warehouseSummary.OutOfStockCount SKU"></div>
                                </div>
                                <div class="tf-warehouse-health-legend">
                                    <span class="tf-legend-item is-instock">
                                        <span class="tf-legend-dot"></span>
                                        <span>Đủ hàng: <strong>@_warehouseSummary.InStockCount</strong> SKU</span>
                                    </span>
                                    <span class="tf-legend-item is-lowstock">
                                        <span class="tf-legend-dot"></span>
                                        <span>Tồn thấp (&lt;15): <strong>@_warehouseSummary.LowStockCount</strong> SKU</span>
                                    </span>
                                    <span class="tf-legend-item is-outstock">
                                        <span class="tf-legend-dot"></span>
                                        <span>Hết hàng: <strong>@_warehouseSummary.OutOfStockCount</strong> SKU</span>
                                    </span>
                                </div>
                            </div>

                            @* Low Stock Alerts Table *@
                            <div class="tf-warehouse-alerts-wrap">
                                <div class="tf-warehouse-alerts-title">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                                        <line x1="12" y1="9" x2="12" y2="13"></line>
                                        <line x1="12" y1="17" x2="12.01" y2="17"></line>
                                    </svg>
                                    <span>Cảnh báo tồn kho cần lưu ý</span>
                                </div>

                                @if (_warehouseSummary.LowStockAlerts.Count > 0)
                                {
                                    <div class="tf-lowstock-list">
                                        @foreach (var alert in _warehouseSummary.LowStockAlerts)
                                        {
                                            <div class="tf-lowstock-item">
                                                <div class="tf-lowstock-info">
                                                    <span class="tf-lowstock-code">@alert.ProductCode</span>
                                                    <span class="tf-lowstock-name" title="@alert.ProductName">@alert.ProductName</span>
                                                </div>
                                                <div class="tf-lowstock-wh">
                                                    @alert.WarehouseName
                                                </div>
                                                <div class="tf-lowstock-qty">
                                                    <span class="tf-badge tf-badge-warning">
                                                        Còn: <strong>@alert.CurrentQuantity.ToString("N0")</strong> @alert.UnitName
                                                    </span>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="tf-warehouse-all-safe">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2">
                                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                                        </svg>
                                        <span>Số dư kho hiện tại an toàn, không có mặt hàng dưới ngưỡng báo động.</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                @* Recent Activity Column (50%) *@
                <div class="tf-card tf-dash-section tf-dash-activity-card">
                    <div class="tf-dash-card-header">
                        <div>
                            <h2 class="tf-dash-card-title">Nhật ký hoạt động</h2>
                            <p class="tf-dash-card-subtitle">Dòng sự kiện kinh doanh thời gian thực</p>
                        </div>
                    </div>

                    <div class="tf-dash-card-body">
                        @if (_isLoadingActivities)
                        {
                            <Skeleton Type="text" Rows="4" />
                        }
                        else if (_recentActivities.Count == 0)
                        {
                            <div class="tf-empty tf-empty-sm">
                                <div class="tf-empty-icon">
                                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <polyline points="12 6 12 12 16 14"></polyline>
                                    </svg>
                                </div>
                                <div class="tf-empty-title">Chưa có hoạt động</div>
                                <div class="tf-empty-desc">Các giao dịch phát sinh sẽ xuất hiện theo thời gian thực.</div>
                            </div>
                        }
                        else
                        {
                            <div class="tf-activity-timeline">
                                @foreach (var act in _recentActivities)
                                {
                                    <div class="tf-timeline-item">
                                        @* Category Icon *@
                                        <div class="tf-timeline-icon @GetActivityIconClass(act.EventType)">
                                            @((MarkupString)GetActivityIconSvg(act.EventType))
                                        </div>

                                        @* Content *@
                                        <div class="tf-timeline-content">
                                            <div class="tf-timeline-header">
                                                <span class="tf-timeline-title">@act.Title</span>
                                                <span class="tf-timeline-time" title="@act.OccurredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")">
                                                    @FormatRelativeTime(act.OccurredAt)
                                                </span>
                                            </div>

                                            @if (!string.IsNullOrEmpty(act.Description))
                                            {
                                                <p class="tf-timeline-desc">@act.Description</p>
                                            }

                                            <div class="tf-timeline-footer">
                                                <span class="tf-timeline-user">
                                                    <span class="tf-user-avatar-tiny">@GetUserInitial(act.PerformedBy)</span>
                                                    <span>@(act.PerformedBy ?? "Hệ thống")</span>
                                                </span>

                                                @if (!string.IsNullOrEmpty(act.TargetUrl))
                                                {
                                                    <a href="@act.TargetUrl" class="tf-timeline-action-link">
                                                        Xem chi tiết &rarr;
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* Level 4: Real-time Activity Toast Notifications (Bottom-Right) *@
            @if (_activeToasts.Count > 0)
            {
                <div class="tf-activity-toast-stack" aria-live="polite">
                    @foreach (var toast in _activeToasts)
                    {
                        <div class="tf-activity-toast" id="toast-@toast.EventId" role="status">
                            <div class="tf-toast-icon @GetActivityIconClass(toast.EventType)">
                                @((MarkupString)GetActivityIconSvg(toast.EventType))
                            </div>
                            <div class="tf-toast-body">
                                <div class="tf-toast-title">
                                    <strong>@toast.PerformedBy</strong> vừa phát sinh:
                                </div>
                                <div class="tf-toast-message">@toast.Title</div>
                                @if (!string.IsNullOrEmpty(toast.TargetUrl))
                                {
                                    <a href="@toast.TargetUrl" class="tf-toast-link">Mở chứng từ</a>
                                }
                            </div>
                            <button type="button" class="tf-toast-close" @onclick="@(() => DismissToast(toast.EventId))" aria-label="Đóng thông báo">
                                &times;
                            </button>
                        </div>
                    }
                </div>
            }
        </div>
    </Authorized>

    <NotAuthorized>
        <div class="tf-welcome-container">
            <div class="tf-welcome-card">
                <div class="tf-welcome-badge">
                    <span class="tf-welcome-badge-dot"></span>
                    <span>Cổng thông tin Doanh nghiệp</span>
                </div>

                <div class="tf-welcome-logo-wrap">
                    <div class="tf-welcome-logo">
                        <svg viewBox="0 0 24 24" width="36" height="36" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M3 3h7v7H3V3z" fill="#2563eb"/>
                            <path d="M14 3h7v7h-7V3z" fill="#3b82f6" opacity="0.7"/>
                            <path d="M3 14h7v7H3v-7z" fill="#3b82f6" opacity="0.7"/>
                            <path d="M14 14h7v7h-7v-7z" fill="#2563eb"/>
                        </svg>
                    </div>
                </div>

                <h1 class="tf-welcome-title">TradeFlow ERP</h1>
                <p class="tf-welcome-desc">
                    Hệ thống quản trị thương mại, bán hàng, kho bãi và tài chính tích hợp toàn diện cho doanh nghiệp.
                </p>

                <div class="tf-welcome-features">
                    <div class="tf-welcome-feat-pill">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                        <span>Bán hàng &amp; Báo giá</span>
                    </div>
                    <div class="tf-welcome-feat-pill">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
                        <span>Kho &amp; Tồn kho</span>
                    </div>
                    <div class="tf-welcome-feat-pill">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                        <span>Công nợ &amp; Sổ quỹ</span>
                    </div>
                    <div class="tf-welcome-feat-pill">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                        <span>Hợp đồng &amp; Nhân sự</span>
                    </div>
                </div>

                <a href="/Account/Login" class="tf-btn tf-btn-primary tf-btn-xl tf-welcome-login-btn" data-enhance="false">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
