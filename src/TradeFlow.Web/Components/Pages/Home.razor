    private static string FormatShortMoney(decimal amount)
    {
        if (amount >= 1_000_000_000) return $"{amount / 1_000_000_000m:F1}B";
        if (amount >= 1_000_000) return $"{amount / 1_000_000m:F1}M";
        if (amount >= 1_000) return $"{amount / 1_000m:N0}k";
        return amount.ToString("N0");
    }

    private string GetPeriodLabel(string period) => period switch
