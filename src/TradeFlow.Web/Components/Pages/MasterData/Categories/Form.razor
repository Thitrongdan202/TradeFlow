@page "/danh-muc/danh-muc-san-pham/them-moi"
@page "/danh-muc/danh-muc-san-pham/sua/{Id:int}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using TradeFlow.Application.Common.Constants
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Domain.Entities.MasterData
@using TradeFlow.Infrastructure.Persistence
@using TradeFlow.Domain.Enums
@attribute [Authorize]

@inject TradeFlowDbContext DbContext
@inject ISystemCodeGenerator CodeGenerator
@inject IAuditService AuditService
@inject NavigationManager Nav
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject ICurrentUserService CurrentUser

<PageTitle>@(IsEdit ? "Sửa" : "Thêm") Danh mục sản phẩm - TradeFlow</PageTitle>

<div class="tf-page-header">
    <div class="tf-page-header-left">
        <h1 class="tf-page-title">@(IsEdit ? "Sửa" : "Thêm") Danh mục sản phẩm</h1>
        <p class="tf-page-subtitle">Phân cấp và nhóm các chủng loại sản phẩm trong doanh nghiệp</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="tf-alert tf-alert-error tf-mb-4">@_errorMessage</div>
}

@if (_model == null)
{
    <div style="padding:24px;text-align:center;">Đang tải thông tin...</div>
}
else
{
    <div class="tf-card" style="max-width: 650px;">
        <div class="tf-card-body">
            <EditForm Model="_model" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />

                <div class="tf-form-group">
                    <label class="tf-label">Mã danh mục <span style="font-size:12px;color:var(--tf-text-muted);">(Tự động sinh)</span></label>
                    <input type="text" class="tf-input" value="@_displaySystemCode" readonly disabled style="background:var(--tf-gray-100);cursor:not-allowed;font-weight:600;" />
                </div>

                <div class="tf-form-group">
                    <label class="tf-label">Tên danh mục <span style="color:var(--tf-error);">*</span></label>
                    <InputText @bind-Value="_model.Name" class="tf-input" placeholder="Tên danh mục sản phẩm" />
                </div>

                <div class="tf-form-group">
                    <label class="tf-label">Danh mục cha</label>
                    <InputSelect @bind-Value="_model.ParentCategoryId" class="tf-select">
                        <option value="">-- Không có (Danh mục gốc) --</option>
                        @if (_parents != null)
                        {
                            @foreach (var p in _parents)
                            {
                                if (!IsEdit || p.Id != Id)
                                {
                                    <option value="@p.Id">@p.Name (@p.Code)</option>
                                }
                            }
                        }
                    </InputSelect>
                </div>

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                    <div class="tf-form-group">
                        <label class="tf-label">Thứ tự hiển thị</label>
                        <InputNumber @bind-Value="_model.DisplayOrder" class="tf-input" />
                    </div>
                    <div class="tf-form-group" style="display:flex;align-items:center;padding-top:28px;">
                        <label class="tf-label" style="display:flex;align-items:center;gap:8px;cursor:pointer;margin:0;">
                            <InputCheckbox @bind-Value="_model.IsActive" />
                            <span>Đang hoạt động</span>
                        </label>
                    </div>
                </div>

                <div class="tf-form-group">
                    <label class="tf-label">Mô tả</label>
                    <InputTextArea @bind-Value="_model.Description" class="tf-input" rows="2" placeholder="Mô tả phạm vi nhóm sản phẩm..." />
                </div>

                <div class="tf-form-actions" style="display: flex; gap: 12px; justify-content: flex-end; margin-top: 24px;">
                    <a href="/danh-muc/danh-muc-san-pham" class="tf-btn tf-btn-secondary">Hủy bỏ</a>
                    
                @if (IsEdit)
                {
                    <AuthorizeView Policy="Permission:ProductCategories:Delete" Context="authContext">
                        <button type="button" class="tf-btn tf-btn-danger" style="margin-left: auto;" @onclick="ConfirmDelete">Xóa</button>
                    </AuthorizeView>
                }
<button type="submit" class="tf-btn tf-btn-primary">@(IsEdit ? "Lưu thay đổi" : "Tạo danh mục")</button>
                </div>
            </EditForm>
        </div>
    </div>
}


@if (_showDeleteModal)
{
    <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center;">
        <div style="background: white; padding: 24px; border-radius: 8px; width: 400px; max-width: 90%; box-shadow: 0 10px 25px rgba(0,0,0,0.2);">
            <h3 style="margin-top: 0; margin-bottom: 16px; font-size: 18px; color: var(--tf-danger);">Xóa dữ liệu?</h3>
            <p style="margin-bottom: 24px;">Bạn có chắc chắn muốn xóa bản ghi này?</p>
            @if (!string.IsNullOrEmpty(_deleteError))
            {
                <div class="tf-alert tf-alert-danger" style="margin-bottom: 16px;">
                    @_deleteError
                </div>
            }
            <div style="display: flex; justify-content: flex-end; gap: 12px;">
                <button type="button" class="tf-btn tf-btn-outline-secondary" @onclick="CancelDelete">Hủy</button>
                <button type="button" class="tf-btn tf-btn-danger" @onclick="ExecuteDelete">Xóa</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }
    private bool IsEdit => Id.HasValue;
    private ProductCategory? _model;
    private List<ProductCategory>? _parents;
    private string _displaySystemCode = string.Empty;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        _parents = await DbContext.ProductCategories
            .Where(c => c.IsActive)
            .OrderBy(c => c.Name)
            .ToListAsync();

        if (IsEdit)
        {
            if (!CurrentUser.HasPermission("ProductCategories", "Edit"))
            {
                Nav.NavigateTo("/Account/AccessDenied");
                return;
            }
            _model = await DbContext.ProductCategories.FindAsync(Id);
            if (_model == null)
            {
                Nav.NavigateTo("/danh-muc/danh-muc-san-pham");
                return;
            }
            _displaySystemCode = _model.Code;
        }
        else
        {
            if (!CurrentUser.HasPermission("ProductCategories", "Create"))
            {
                Nav.NavigateTo("/Account/AccessDenied");
                return;
            }
            _model = new ProductCategory { IsActive = true, DisplayOrder = 0 };
            _displaySystemCode = await CodeGenerator.PeekNextCodeAsync(SystemCodeConstants.ProductCategory) + " (Tự sinh)";
        }
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            _errorMessage = null;

            if (string.IsNullOrWhiteSpace(_model!.Name))
            {
                _errorMessage = "Tên danh mục là bắt buộc.";
                return;
            }

            if (IsEdit)
            {
                _model.UpdatedAt = DateTime.UtcNow;
                _model.UpdatedBy = CurrentUser.UserName;
                DbContext.ProductCategories.Update(_model);
                await AuditService.LogAsync(AuditEventType.CategoryUpdated, CurrentUser.UserName, "ProductCategory", _model.Id.ToString());
            }
            else
            {
                _model.Code = await CodeGenerator.GenerateCodeAsync(SystemCodeConstants.ProductCategory);
                _model.CreatedAt = DateTime.UtcNow;
                _model.CreatedBy = CurrentUser.UserName;
                DbContext.ProductCategories.Add(_model);
                await AuditService.LogAsync(AuditEventType.CategoryCreated, CurrentUser.UserName, "ProductCategory", _model.Code);
            }

            await DbContext.SaveChangesAsync();
            Nav.NavigateTo("/danh-muc/danh-muc-san-pham");
        }
        catch (Exception ex)
        {
            _errorMessage = "Có lỗi xảy ra: " + ex.Message;
        }
    }

    private bool _showDeleteModal = false;
    private string? _deleteError;

    private void ConfirmDelete()
    {
        _showDeleteModal = true;
        _deleteError = null;
    }

    private void CancelDelete()
    {
        _showDeleteModal = false;
        _deleteError = null;
    }

    private async Task ExecuteDelete()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!(await AuthService.AuthorizeAsync(authState.User, "Permission:ProductCategories:Delete")).Succeeded)
        {
            _deleteError = "Bạn không có quyền thực hiện thao tác này.";
            return;
        }

        try
        {
            bool isReferenced = await DbContext.Products.AnyAsync(x => x.CategoryId == _model.Id); if(isReferenced) { _deleteError = "Không thể xóa vì dữ liệu này đang được sử dụng."; return; }
            
DbContext.ProductCategories.Remove(_model);

            await DbContext.SaveChangesAsync();
            await AuditService.LogAsync(TradeFlow.Domain.Enums.AuditEventType.CategoryDeleted, authState.User.Identity?.Name ?? "System", "ProductCategory", _model.Id.ToString(), "Xóa", authState.User.Identity?.Name);
            Nav.NavigateTo(Nav.Uri.Split('/')[1] == "danh-muc" ? "/danh-muc/" + Nav.Uri.Split('/')[2] : (Nav.Uri.Split('/')[1] == "doi-tac" ? "/doi-tac/" + Nav.Uri.Split('/')[2] : "/kho-hang"));
        }
        catch (Exception ex)
        {
            _deleteError = "Đã xảy ra lỗi: " + ex.Message;
        }
    }

}