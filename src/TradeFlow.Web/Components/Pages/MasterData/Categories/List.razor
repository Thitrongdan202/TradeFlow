@page "/danh-muc/danh-muc-san-pham"
@page "/danh-muc/nhom-san-pham"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Domain.Entities.MasterData
@using TradeFlow.Infrastructure.Persistence
@attribute [Authorize(Policy = "Permission:ProductCategories:View")]

@inject TradeFlowDbContext DbContext
@inject NavigationManager Nav
@inject IAuthorizationService AuthService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject IAuditService AuditService

<PageTitle>Danh mục sản phẩm - TradeFlow</PageTitle>

<div class="tf-page-header">
    <div class="tf-page-header-left">
        <h1 class="tf-page-title">Danh mục sản phẩm</h1>
        <p class="tf-page-subtitle">Quản lý cây phân cấp danh mục sản phẩm</p>
    </div>
    <div class="tf-page-actions">
        <AuthorizeView Policy="Permission:ProductCategories:Create">
            <a href="/danh-muc/danh-muc-san-pham/them-moi" class="tf-btn tf-btn-primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                Thêm danh mục
            </a>
        </AuthorizeView>
    </div>
</div>

@if (!string.IsNullOrEmpty(_toastMessage))
{
    <div class="tf-alert tf-alert-info tf-mb-4" style="background:#eff6ff; border:1px solid #bfdbfe; color:#1e40af; display:flex; justify-content:space-between; align-items:center; padding: 12px 16px; border-radius: 6px; margin-bottom: 16px;">
        <span>@_toastMessage</span>
        <button type="button" style="background:none; border:none; color:#1e40af; cursor:pointer; font-weight:bold;" @onclick="() => _toastMessage = null">✕</button>
    </div>
}

<div class="tf-card tf-mb-4" style="padding: 12px 16px;">
    <DebouncedSearchInput Placeholder="Tìm theo mã danh mục, tên danh mục..."
                          Value="@_searchTerm"
                          ValueChanged="OnSearchChanged" />
</div>

<div class="tf-card">
    <div class="tf-card-body" style="padding:0; overflow-x: auto;">
        
@if (_selectedItems.Count > 0)
{
    <div class="tw-bg-blue-50/80 tw-border tw-border-blue-200 tw-p-3.5 tw-rounded-lg tw-mb-4 tw-flex tw-justify-between tw-items-center tw-shadow-xs">
        <span class="tw-text-blue-900 tw-font-medium tw-text-sm">Đã chọn @_selectedItems.Count bản ghi</span>
        <AuthorizeView Policy="Permission:ProductCategories:Delete">
            <button type="button" class="tf-btn tf-btn-sm tf-btn-danger" @onclick="ConfirmBulkDelete">Xóa đã chọn</button>
        </AuthorizeView>
    </div>
}

<TfModal IsOpen="@_showBulkDeleteModal"
         Title="@($"Xóa {_selectedItems.Count} bản ghi đã chọn?")"
         Size="md"
         OnClose="CancelBulkDelete">
    <BodyContent>
        <p class="tw-text-slate-600 tw-mb-4">Hành động này không thể hoàn tác. Các bản ghi đang được sử dụng sẽ bị bỏ qua hoặc vô hiệu hóa thay vì xóa hoàn toàn.</p>
        @if (_bulkDeleteErrors.Count > 0)
        {
            <div class="tf-alert tf-alert-error tw-mb-4 tw-max-h-36 tw-overflow-y-auto">
                <ul class="tw-m-0 tw-pl-5">
                    @foreach (var err in _bulkDeleteErrors)
                    {
                        <li>@err</li>
                    }
                </ul>
            </div>
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="tf-btn tf-btn-secondary" @onclick="CancelBulkDelete">Hủy</button>
        <LoadingButton Variant="danger"
                       IsLoading="@_isBulkDeleting"
                       LoadingText="Đang xử lý..."
                       Text="Xóa tất cả"
                       OnClick="ExecuteBulkDelete" />
    </FooterContent>
</TfModal>

@if (_items == null)
{
    <Skeleton Type="table" Rows="6" Columns="7" />
}
else
{
    <div class="tf-table-loading-container">
        <TableLoadingOverlay Visible="@_isRefreshing" Message="Đang cập nhật..." />
        <table class="tf-table">
            <thead>
                <tr>
                    <th style="width: 40px; text-align: center;"><input type="checkbox" @onchange="ToggleSelectAll" checked="@(FilteredItems.Any() && _selectedItems.Count == FilteredItems.Count())" /></th>
                    <th style="min-width: 120px;">Mã danh mục</th>
                    <th style="min-width: 200px;">Tên danh mục</th>
                    <th>Danh mục cha</th>
                    <th style="text-align:center;">Thứ tự</th>
                    <th style="text-align:center;">Trạng thái</th>
                    <th style="text-align:right;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!FilteredItems.Any())
                {
                    <tr><td colspan="7"><div class="tf-empty"><div class="tf-empty-title">Chưa có danh mục phù hợp</div></div></td></tr>
                }
                else
                {
                    foreach (var item in PagedItems)
                    {
                        <tr>
                            <td style="text-align: center;"><input type="checkbox" @onchange="@(e => ToggleSelect(item.Id, e))" checked="@(_selectedItems.Contains(item.Id))" /></td>
                            <td>
                                <span class="tw-font-mono tw-font-semibold tw-text-indigo-700 tw-bg-indigo-50/70 tw-px-2 tw-py-0.5 tw-rounded tw-text-xs">@item.Code</span>
                            </td>
                            <td class="tw-font-medium tw-text-slate-900">@item.Name</td>
                            <td class="tw-text-slate-600">@(item.ParentCategory?.Name ?? "-")</td>
                            <td style="text-align:center;" class="tw-text-slate-600">@item.DisplayOrder</td>
                            <td style="text-align:center;">
                                <TfBadge Variant="@(item.IsActive ? "success" : "gray")"
                                         Dot="true"
                                         Text="@(item.IsActive ? "Hoạt động" : "Đã ngừng sử dụng")" />
                            </td>
                            <td style="text-align:right;">
                                <div class="tw-inline-flex tw-gap-1">
                                    <AuthorizeView Policy="Permission:ProductCategories:Edit">
                                        <a href="/danh-muc/danh-muc-san-pham/sua/@item.Id" class="tf-btn tf-btn-ghost tf-btn-sm">Sửa</a>
                                    </AuthorizeView>
                                    <AuthorizeView Policy="Permission:ProductCategories:Delete">
                                        <button class="tf-btn tf-btn-ghost tf-btn-sm tw-text-red-600 hover:tw-bg-red-50" @onclick="() => ConfirmDelete(item.Id, item.Name ?? string.Empty)">Xóa</button>
                                    </AuthorizeView>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        
        @if (FilteredItems.Any())
        {
            <TfPagination CurrentPage="@_currentPage"
                          PageSize="@_pageSize"
                          TotalCount="@FilteredItems.Count()"
                          ItemName="danh mục"
                          CurrentPageChanged="@(p => _currentPage = p)"
                          PageSizeChanged="@(s => { _pageSize = s; _currentPage = 1; })" />
        }
    </div>
}
    </div>
</div>

<TfModal IsOpen="@(_itemToDeleteId != null)"
         Title="Xóa dữ liệu?"
         Size="sm"
         OnClose="CancelDelete">
    <BodyContent>
        <p class="tw-text-slate-600 tw-mb-4">Bạn có chắc chắn muốn xóa "<strong>@(_itemToDeleteName)</strong>"?</p>
        @if (!string.IsNullOrEmpty(_deleteError))
        {
            <div class="tf-alert tf-alert-error tw-mb-3">
                @_deleteError
            </div>
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="tf-btn tf-btn-secondary" @onclick="CancelDelete">Hủy</button>
        <LoadingButton Variant="danger"
                       IsLoading="@_isDeleting"
                       LoadingText="Đang xóa..."
                       Text="Xóa"
                       OnClick="ExecuteDelete" />
    </FooterContent>
</TfModal>

@code {
    private int? _itemToDeleteId;
    private string _itemToDeleteName = "";
    private string? _deleteError;
    private string? _toastMessage;

    private List<ProductCategory>? _items;
    private string _searchTerm = string.Empty;
    private bool _isRefreshing = false;
    private bool _isDeleting = false;

    protected override async Task OnInitializedAsync()
    {
        _items = await DbContext.ProductCategories
            .Include(c => c.ParentCategory)
            .OrderBy(x => x.DisplayOrder)
            .ThenBy(x => x.Code)
            .ToListAsync();
    }

    private int _currentPage = 1;
    private int _pageSize = 20;

    private void OnSearchChanged(string val)
    {
        _searchTerm = val;
        _currentPage = 1;
    }

    private IEnumerable<ProductCategory> FilteredItems
    {
        get
        {
            if (_items == null) return Enumerable.Empty<ProductCategory>();

            if (string.IsNullOrWhiteSpace(_searchTerm))
            {
                return _items;
            }

            var term = _searchTerm.Trim().ToLower();
            return _items.Where(x =>
                (x.Code != null && x.Code.ToLower().Contains(term)) ||
                (x.Name != null && x.Name.ToLower().Contains(term)));
        }
    }

    private IEnumerable<ProductCategory> PagedItems =>
        FilteredItems.Skip((_currentPage - 1) * _pageSize).Take(_pageSize);

    private void ConfirmDelete(int id, string name)
    {
        _itemToDeleteId = id;
        _itemToDeleteName = name;
        _deleteError = null;
    }

    private void CancelDelete()
    {
        _itemToDeleteId = null;
        _deleteError = null;
    }

    private async Task ExecuteDelete()
    {
        if (_itemToDeleteId == null) return;
        
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!(await AuthService.AuthorizeAsync(authState.User, "Permission:ProductCategories:Delete")).Succeeded)
        {
            _deleteError = "Bạn không có quyền thực hiện thao tác này.";
            return;
        }

        _isDeleting = true;
        try
        {
            int id = _itemToDeleteId.Value;
            var entity = await DbContext.ProductCategories.FindAsync(id);
            if (entity == null)
            {
                CancelDelete();
                return;
            }

            bool isReferenced = await DbContext.Products.AnyAsync(x => x.CategoryId == id);

            if (isReferenced)
            {
                entity.IsActive = false;
                entity.UpdatedAt = DateTime.UtcNow;
                entity.UpdatedBy = authState.User.Identity?.Name;
                DbContext.ProductCategories.Update(entity);
                await DbContext.SaveChangesAsync();
                await AuditService.LogAsync(TradeFlow.Domain.Enums.AuditEventType.CategoryUpdated, authState.User.Identity?.Name ?? "System", "Category", id.ToString(), "Ngừng sử dụng danh mục do có sản phẩm liên kết", authState.User.Identity?.Name);
                _toastMessage = "Danh mục đã có sản phẩm liên kết nên không thể xóa vật lý. Danh mục đã được chuyển sang trạng thái ngừng sử dụng.";
            }
            else
            {
                DbContext.ProductCategories.Remove(entity);
                await DbContext.SaveChangesAsync();
                await AuditService.LogAsync(TradeFlow.Domain.Enums.AuditEventType.CategoryDeleted, authState.User.Identity?.Name ?? "System", "Category", id.ToString(), "Xóa danh mục", authState.User.Identity?.Name);
                _toastMessage = "Đã xóa danh mục thành công.";
            }

            CancelDelete();
            
            _isRefreshing = true;
            try
            {
                await OnInitializedAsync();
            }
            finally
            {
                _isRefreshing = false;
            }
        }
        catch (Exception ex)
        {
            _deleteError = "Đã xảy ra lỗi: " + ex.Message;
        }
        finally
        {
            _isDeleting = false;
        }
    }

    private HashSet<int> _selectedItems = new();
    private bool _showBulkDeleteModal = false;
    private List<string> _bulkDeleteErrors = new();
    private bool _isBulkDeleting = false;

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        if (e.Value is bool isChecked && isChecked)
        {
            _selectedItems = new HashSet<int>(FilteredItems.Select(x => x.Id));
        }
        else
        {
            _selectedItems.Clear();
        }
    }

    private void ToggleSelect(int id, ChangeEventArgs e)
    {
        if (e.Value is bool isChecked && isChecked)
        {
            _selectedItems.Add(id);
        }
        else
        {
            _selectedItems.Remove(id);
        }
    }

    private void ConfirmBulkDelete()
    {
        _bulkDeleteErrors.Clear();
        _showBulkDeleteModal = true;
    }

    private void CancelBulkDelete()
    {
        _showBulkDeleteModal = false;
        _isBulkDeleting = false;
    }

    private async Task ExecuteBulkDelete()
    {
        if (_selectedItems.Count == 0) return;
        _isBulkDeleting = true;
        _bulkDeleteErrors.Clear();
        StateHasChanged();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!(await AuthService.AuthorizeAsync(authState.User, "Permission:ProductCategories:Delete")).Succeeded)
        {
            _bulkDeleteErrors.Add("Bạn không có quyền thực hiện thao tác này.");
            _isBulkDeleting = false;
            return;
        }

        try
        {
            int successCount = 0;
            var idsToProcess = _selectedItems.ToList();
            
            foreach (var id in idsToProcess)
            {
                _itemToDeleteId = id; // reuse the id for the logic block
                try 
                {
                    await ProcessSingleDelete(id);
                    _selectedItems.Remove(id);
                    successCount++;
                } 
                catch (Exception ex)
                {
                    _bulkDeleteErrors.Add($"Bản ghi ID {id}: {ex.Message}");
                }
            }

            if (successCount > 0)
            {
                _isRefreshing = true;
                try
                {
                    await OnInitializedAsync();
                }
                finally
                {
                    _isRefreshing = false;
                }
            }
            
            if (_selectedItems.Count == 0)
            {
                CancelBulkDelete();
            }
        }
        finally
        {
            _isBulkDeleting = false;
            _itemToDeleteId = null;
            StateHasChanged();
        }
    }

    private async Task ProcessSingleDelete(int currentId)
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        int id = currentId;
        var entity = await DbContext.ProductCategories.FindAsync(id);
        if (entity == null) return;

        bool isReferenced = await DbContext.Products.AnyAsync(x => x.CategoryId == id);

        if (isReferenced)
        {
            entity.IsActive = false;
            entity.UpdatedAt = DateTime.UtcNow;
            entity.UpdatedBy = authState.User.Identity?.Name;
            DbContext.ProductCategories.Update(entity);
            await DbContext.SaveChangesAsync();
            await AuditService.LogAsync(TradeFlow.Domain.Enums.AuditEventType.CategoryUpdated, authState.User.Identity?.Name ?? "System", "Category", id.ToString(), "Ngừng sử dụng danh mục do có sản phẩm liên kết", authState.User.Identity?.Name);
            _toastMessage = "Danh mục đã có sản phẩm liên kết nên không thể xóa vật lý. Danh mục đã được chuyển sang trạng thái ngừng sử dụng.";
        }
        else
        {
            DbContext.ProductCategories.Remove(entity);
            await DbContext.SaveChangesAsync();
            await AuditService.LogAsync(TradeFlow.Domain.Enums.AuditEventType.CategoryDeleted, authState.User.Identity?.Name ?? "System", "Category", id.ToString(), "Xóa danh mục", authState.User.Identity?.Name);
        }
    }
}
