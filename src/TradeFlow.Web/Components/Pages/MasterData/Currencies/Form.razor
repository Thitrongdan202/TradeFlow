@page "/danh-muc/loai-tien/them-moi"
@page "/danh-muc/loai-tien/sua/{Id:int}"
@page "/danh-muc/tien-te/them-moi"
@page "/danh-muc/tien-te/sua/{Id:int}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Domain.Entities.MasterData
@using TradeFlow.Infrastructure.Persistence
@using TradeFlow.Domain.Enums
@using TradeFlow.Web.Components.Shared.Forms
@attribute [Authorize]

@inject TradeFlowDbContext DbContext
@inject IAuditService AuditService
@inject NavigationManager Nav
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject ICurrentUserService CurrentUser

<PageTitle>@(IsEdit ? "Sửa" : "Thêm") Loại tiền - TradeFlow</PageTitle>

<div class="tf-page-header">
    <div class="tf-page-header-left">
        <h1 class="tf-page-title">@(IsEdit ? "Sửa" : "Thêm") Loại tiền</h1>
        <p class="tf-page-subtitle">Quản lý đồng tiền thanh toán và tỷ giá quy đổi cơ sở VND</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="tf-alert tf-alert-error tf-mb-4">@_errorMessage</div>
}

@if (_model == null)
{
    <div style="padding:24px;text-align:center;">Đang tải thông tin...</div>
}
else
{
    <div class="tf-card" style="max-width: 650px;">
        <div class="tf-card-body">
            <EditForm Model="_model" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                    <div class="tf-form-group">
                        <label class="tf-label">Mã tiền tệ (ISO 4217) <span style="color:var(--tf-error);">*</span></label>
                        <InputText @bind-Value="_model.Code" class="tf-input" placeholder="VND, USD, EUR..." disabled="@IsEdit" />
                        <div style="font-size: 11px; color: var(--tf-text-secondary); margin-top: 2px;">Chuẩn 3 ký tự viết hoa (ví dụ: USD)</div>
                    </div>
                    <div class="tf-form-group">
                        <label class="tf-label">Ký hiệu tiền tệ</label>
                        <InputText @bind-Value="_model.Symbol" class="tf-input" placeholder="₫, $, €, ¥..." />
                    </div>
                </div>

                <div class="tf-form-group">
                    <label class="tf-label">Tên tiền tệ <span style="color:var(--tf-error);">*</span></label>
                    <InputText @bind-Value="_model.Name" class="tf-input" placeholder="Ví dụ: Việt Nam đồng, Đô la Mỹ..." />
                </div>

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                    <div class="tf-form-group">
                        <label class="tf-label">Tỷ giá so với VND (1 [Mã] = X VND) <span style="color:var(--tf-error);">*</span></label>
                        <InputNumber @bind-Value="_model.ExchangeRate" class="tf-input" disabled="@(_model.IsDefault || _model.Code == "VND")" />
                    </div>
                    <div class="tf-form-group">
                        <label class="tf-label">Số chữ số thập phân</label>
                        <InputSelect @bind-Value="_model.DecimalPlaces" class="tf-input">
                            <option value="0">0 (VND, JPY, KRW...)</option>
                            <option value="2">2 (USD, EUR, SGD...)</option>
                            <option value="3">3 (BHD, KWD...)</option>
                            <option value="4">4 (Ngoại hối vi mô)</option>
                        </InputSelect>
                    </div>
                </div>

                <div class="tf-form-group">
                    <label class="tf-label">Căn cứ / Ghi chú</label>
                    <InputText @bind-Value="_model.Notes" class="tf-input" placeholder="Căn cứ tỷ giá hoặc thông tin bổ sung..." />
                </div>

                <div style="display:flex;gap:24px;margin-top:12px;flex-wrap: wrap;">
                    @if (!_model.IsDefault && _model.Code != "VND")
                    {
                        <label class="tf-label" style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                            <InputCheckbox @bind-Value="_model.IsManualOverride" />
                            <span>Cố định tỷ giá thủ công</span>
                        </label>
                    }
                    <label class="tf-label" style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                        <InputCheckbox @bind-Value="_model.IsActive" disabled="@(_model.IsDefault || _model.Code == "VND")" />
                        <span>Đang hoạt động</span>
                    </label>
                </div>

                <div class="tf-form-actions" style="display: flex; gap: 12px; justify-content: flex-end; margin-top: 24px;">
                    <a href="/danh-muc/loai-tien" class="tf-btn tf-btn-secondary">Hủy bỏ</a>
                    
                    @if (IsEdit && !_model.IsDefault && _model.Code != "VND")
                    {
                        <AuthorizeView Policy="Permission:Currencies:Delete" Context="authContext">
                            <button type="button" class="tf-btn tf-btn-danger" style="margin-left: auto;" @onclick="ConfirmDelete">Xóa</button>
                        </AuthorizeView>
                    }
                    <button type="submit" class="tf-btn tf-btn-primary">@(IsEdit ? "Lưu thay đổi" : "Tạo loại tiền")</button>
                </div>
            </EditForm>
        </div>
    </div>
}

<TfModal IsOpen="@_showDeleteModal"
         Title="Xóa loại tiền tệ?"
         Size="sm"
         OnClose="CancelDelete">
    <BodyContent>
        <p class="tw-text-slate-600 tw-mb-4">Bạn có chắc chắn muốn xóa bản ghi này?</p>
        @if (!string.IsNullOrEmpty(_deleteError))
        {
            <div class="tf-alert tf-alert-error tw-mb-3">
                @_deleteError
            </div>
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="tf-btn tf-btn-secondary" @onclick="CancelDelete">Hủy</button>
        <button type="button" class="tf-btn tf-btn-danger" @onclick="ExecuteDelete">Xóa</button>
    </FooterContent>
</TfModal>

@code {
    [Parameter] public int? Id { get; set; }
    private bool IsEdit => Id.HasValue;
    private Currency? _model;
    private decimal _originalRate = 1m;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (IsEdit)
        {
            if (!CurrentUser.HasPermission("Currencies", "Edit"))
            {
                Nav.NavigateTo("/Account/AccessDenied");
                return;
            }
            _model = await DbContext.Currencies.FindAsync(Id);
            if (_model == null)
            {
                Nav.NavigateTo("/danh-muc/loai-tien");
                return;
            }
            _originalRate = _model.ExchangeRate;
        }
        else
        {
            if (!CurrentUser.HasPermission("Currencies", "Create"))
            {
                Nav.NavigateTo("/Account/AccessDenied");
                return;
            }
            _model = new Currency { IsActive = true, ExchangeRate = 1m, DecimalPlaces = 2, EffectiveAt = DateTime.UtcNow, RateSource = "Thủ công" };
        }
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            _errorMessage = null;

            if (string.IsNullOrWhiteSpace(_model!.Code) || string.IsNullOrWhiteSpace(_model!.Name))
            {
                _errorMessage = "Mã và Tên tiền tệ là bắt buộc.";
                return;
            }

            _model.Code = _model.Code.Trim().ToUpperInvariant();
            if (_model.ExchangeRate <= 0)
            {
                _errorMessage = "Tỷ giá quy đổi phải lớn hơn 0.";
                return;
            }

            if (await DbContext.Currencies.AnyAsync(x => x.Code == _model.Code && x.Id != _model.Id))
            {
                _errorMessage = "Mã tiền tệ này đã tồn tại trong hệ thống.";
                return;
            }

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name ?? CurrentUser.UserName;

            if (IsEdit)
            {
                _model.UpdatedAt = DateTime.UtcNow;
                _model.UpdatedBy = username;

                if (_model.ExchangeRate != _originalRate)
                {
                    _model.EffectiveAt = DateTime.UtcNow;
                    _model.RateSource = "Thủ công";
                    DbContext.ExchangeRateHistories.Add(new ExchangeRateHistory
                    {
                        CurrencyId = _model.Id,
                        CurrencyCode = _model.Code,
                        Rate = _model.ExchangeRate,
                        PreviousRate = _originalRate,
                        Source = "Thủ công",
                        EffectiveAt = DateTime.UtcNow,
                        Notes = _model.Notes,
                        ChangedBy = username,
                        CreatedAt = DateTime.UtcNow
                    });
                }

                DbContext.Currencies.Update(_model);
                await AuditService.LogAsync(AuditEventType.CurrencyUpdated, username, "Currency", _model.Id.ToString(), $"Cập nhật loại tiền {_model.Code}");
            }
            else
            {
                _model.CreatedAt = DateTime.UtcNow;
                _model.CreatedBy = username;
                _model.EffectiveAt = DateTime.UtcNow;
                _model.RateSource = "Thủ công";
                DbContext.Currencies.Add(_model);
                await DbContext.SaveChangesAsync();

                DbContext.ExchangeRateHistories.Add(new ExchangeRateHistory
                {
                    CurrencyId = _model.Id,
                    CurrencyCode = _model.Code,
                    Rate = _model.ExchangeRate,
                    PreviousRate = null,
                    Source = "Khởi tạo",
                    EffectiveAt = DateTime.UtcNow,
                    Notes = _model.Notes ?? "Khởi tạo loại tiền mới",
                    ChangedBy = username,
                    CreatedAt = DateTime.UtcNow
                });
                await AuditService.LogAsync(AuditEventType.CurrencyCreated, username, "Currency", _model.Code, $"Thêm mới loại tiền {_model.Code}");
            }

            await DbContext.SaveChangesAsync();
            Nav.NavigateTo("/danh-muc/loai-tien");
        }
        catch (Exception ex)
        {
            _errorMessage = "Có lỗi xảy ra: " + ex.Message;
        }
    }

    private bool _showDeleteModal = false;
    private string? _deleteError;

    private void ConfirmDelete()
    {
        _showDeleteModal = true;
        _deleteError = null;
    }

    private void CancelDelete()
    {
        _showDeleteModal = false;
        _deleteError = null;
    }

    private async Task ExecuteDelete()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!(await AuthService.AuthorizeAsync(authState.User, "Permission:Currencies:Delete")).Succeeded)
        {
            _deleteError = "Bạn không có quyền thực hiện thao tác này.";
            return;
        }

        try
        {
            if (_model == null) return;
            if (_model.IsDefault || _model.Code == "VND")
            {
                _deleteError = "Không thể xóa đồng tiền cơ sở mặc định (VND).";
                return;
            }

            string code = _model.Code;
            bool isReferenced = await DbContext.PriceListItems.AnyAsync(x => x.CurrencyCode == code)
                                || await DbContext.Contracts.AnyAsync(x => x.CurrencyCode == code);

            if (isReferenced)
            {
                _deleteError = "Không thể xóa vì dữ liệu này đang được sử dụng trong bảng giá hoặc đơn hàng.";
                return;
            }

            DbContext.Currencies.Remove(_model);
            await DbContext.SaveChangesAsync();
            await AuditService.LogAsync(AuditEventType.CurrencyDeleted, authState.User.Identity?.Name ?? "System", "Currency", _model.Id.ToString(), $"Xóa loại tiền {code}");
            Nav.NavigateTo("/danh-muc/loai-tien");
        }
        catch (Exception ex)
        {
            _deleteError = "Đã xảy ra lỗi: " + ex.Message;
        }
    }
}
