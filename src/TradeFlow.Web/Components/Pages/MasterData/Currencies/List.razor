                _rateEditError = "Không thể cập nhật tỷ giá. Vui lòng kiểm tra lại.";
            }
        }
        catch (Exception ex)
        {
            _rateEditError = "Lỗi khi lưu tỷ giá: " + ex.Message;
        }
        finally
        {
            _isSavingRate = false;
        }
    }

