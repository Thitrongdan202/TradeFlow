@page "/danh-muc/loai-tien"
@page "/danh-muc/tien-te"
@page "/cai-dat/tien-te"
@page "/san-pham/tien-te"
@rendermode InteractiveServer
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Application.Common.Models.Currency
@using TradeFlow.Domain.Entities.MasterData
@using TradeFlow.Domain.Enums
@using TradeFlow.Infrastructure.Persistence
@using TradeFlow.Web.Components.Shared.Forms
@attribute [Authorize(Policy = "Permission:Currencies:View")]

@inject TradeFlowDbContext DbContext
@inject ICurrencyService CurrencyService
@inject NavigationManager Nav
@inject IAuthorizationService AuthService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject IAuditService AuditService
@inject ICurrentUserService CurrentUser

<PageTitle>Tiền tệ & Tỷ giá - TradeFlow</PageTitle>

<div class="tf-page-header">
    <div class="tf-page-header-left">
        <h1 class="tf-page-title">Tiền tệ &amp; Tỷ giá</h1>
        <p class="tf-page-subtitle">Quản lý đồng tiền thanh toán, thiết lập tỷ giá cơ sở VND, đồng bộ trực tuyến an toàn và quy đổi ngoại tệ</p>
    </div>
    <div class="tf-page-actions" style="display: flex; gap: 8px; align-items: center;">
        <AuthorizeView Policy="Permission:Currencies:Edit">
            <button type="button" class="tf-btn tf-btn-secondary" @onclick="OpenApiSyncModal" title="Lấy tỷ giá mới nhất từ máy chủ API">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"/>
                </svg>
                <span>Cập nhật tỷ giá trực tuyến</span>
            </button>
        </AuthorizeView>

        <AuthorizeView Policy="Permission:Currencies:Create">
            <button type="button" class="tf-btn tf-btn-primary" @onclick="OpenAddModal">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                <span>Thêm loại tiền</span>
            </button>
        </AuthorizeView>
    </div>
</div>

@* Thông báo thành công hoặc lỗi chung *@
@if (!string.IsNullOrEmpty(_globalSuccessMessage))
{
    <div class="tf-alert tf-alert-success tf-mb-4" style="display: flex; justify-content: space-between; align-items: center;">
        <div style="display: flex; align-items: center; gap: 8px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            <span>@_globalSuccessMessage</span>
        </div>
        <button type="button" class="tf-btn tf-btn-ghost tf-btn-sm" @onclick="() => _globalSuccessMessage = null">✕</button>
    </div>
}
@if (!string.IsNullOrEmpty(_globalErrorMessage))
{
    <div class="tf-alert tf-alert-error tf-mb-4" style="display: flex; justify-content: space-between; align-items: center;">
        <div style="display: flex; align-items: center; gap: 8px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            <span>@_globalErrorMessage</span>
        </div>
        <button type="button" class="tf-btn tf-btn-ghost tf-btn-sm" @onclick="() => _globalErrorMessage = null">✕</button>
    </div>
}

@* 4 Thẻ tóm tắt thông số tỷ giá *@
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 20px;">
    <div class="tf-card" style="padding: 16px; border-left: 4px solid var(--tf-primary);">
        <div style="font-size: 12px; font-weight: 600; text-transform: uppercase; color: var(--tf-text-secondary); margin-bottom: 4px;">Tiền tệ cơ sở</div>
        <div style="display: flex; align-items: baseline; gap: 8px;">
            <span style="font-size: 22px; font-weight: 700; color: var(--tf-text-primary);">VND (₫)</span>
            <span class="tw-font-mono tw-text-xs tw-bg-indigo-50/70 tw-text-indigo-700 tw-px-2 tw-py-0.5 tw-rounded">Tỷ giá = 1.0</span>
        </div>
        <div style="font-size: 13px; color: var(--tf-text-secondary); margin-top: 4px;">Đồng Việt Nam (Mặc định)</div>
    </div>

    <div class="tf-card" style="padding: 16px; border-left: 4px solid #10b981;">
        <div style="font-size: 12px; font-weight: 600; text-transform: uppercase; color: var(--tf-text-secondary); margin-bottom: 4px;">Tổng số loại tiền</div>
        <div style="font-size: 22px; font-weight: 700; color: var(--tf-text-primary);">@(_items?.Count ?? 0)</div>
        <div style="font-size: 13px; color: var(--tf-text-secondary); margin-top: 4px;">
            <span style="color: #10b981; font-weight: 600;">@(_items?.Count(x => x.IsActive) ?? 0)</span> đang hoạt động
        </div>
    </div>

    <div class="tf-card" style="padding: 16px; border-left: 4px solid #f59e0b;">
        <div style="font-size: 12px; font-weight: 600; text-transform: uppercase; color: var(--tf-text-secondary); margin-bottom: 4px;">Cập nhật trực tuyến</div>
        <div style="font-size: 18px; font-weight: 700; color: var(--tf-text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
            @(_lastRefreshedAt.HasValue ? _lastRefreshedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "Chưa cập nhật")
        </div>
        <div style="font-size: 13px; color: var(--tf-text-secondary); margin-top: 4px;">
            Cổng: ExchangeRate-API (HTTPS)
        </div>
    </div>

    <div class="tf-card" style="padding: 16px; border-left: 4px solid #6366f1;">
        <div style="font-size: 12px; font-weight: 600; text-transform: uppercase; color: var(--tf-text-secondary); margin-bottom: 4px;">Quy ước hạch toán</div>
        <div style="font-size: 16px; font-weight: 700; color: var(--tf-text-primary);">1 [Ngoại tệ] = X VND</div>
        <div style="font-size: 13px; color: var(--tf-text-secondary); margin-top: 4px;">Bảo toàn đơn giá &amp; hóa đơn đã lập</div>
    </div>
</div>

@* Bộ công cụ quy đổi tỷ giá tương tác (Interactive Currency Converter) *@
<div class="tf-card tf-mb-4" style="padding: 18px 20px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
        <div style="display: flex; align-items: center; gap: 8px;">
            <div style="width: 28px; height: 28px; border-radius: 6px; background: rgba(99, 102, 241, 0.12); display: flex; align-items: center; justify-content: center; color: #6366f1;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                    <line x1="6" y1="8" x2="6" y2="8"></line>
                    <line x1="10" y1="8" x2="10" y2="8"></line>
                    <line x1="14" y1="8" x2="14" y2="8"></line>
                    <line x1="18" y1="8" x2="18" y2="8"></line>
                    <line x1="6" y1="12" x2="18" y2="12"></line>
                    <line x1="6" y1="16" x2="18" y2="16"></line>
                </svg>
            </div>
            <h2 style="font-size: 15px; font-weight: 600; margin: 0; color: var(--tf-text-primary);">Công cụ quy đổi ngoại tệ mô phỏng</h2>
            <span class="tw-text-xs tw-bg-emerald-50 tw-text-emerald-700 tw-px-2 tw-py-0.5 tw-rounded tw-font-medium">Xem trước an toàn</span>
        </div>
        <span style="font-size: 12px; color: var(--tf-text-secondary);">Công cụ tính toán nội bộ – Không tự ý sửa giá sản phẩm hay hóa đơn</span>
    </div>

    <div style="display: grid; grid-template-columns: 1.5fr 1fr auto 1fr; gap: 12px; align-items: end;">
        <div>
            <label class="tf-label" style="font-size: 12px; margin-bottom: 4px;">Số tiền cần đổi</label>
            <input type="number" step="any" min="0" class="tf-input"
                   value="@_calcAmount"
                   @onchange="OnCalcAmountChanged"
                   placeholder="Nhập số tiền..." />
        </div>

        <div>
            <label class="tf-label" style="font-size: 12px; margin-bottom: 4px;">Từ loại tiền</label>
            <select class="tf-input" value="@_calcFromCode" @onchange="OnCalcFromChanged">
                @if (_items != null)
                {
                    foreach (var c in _items.Where(x => x.IsActive))
                    {
                        <option value="@c.Code">@c.Code - @c.Name (@(c.Symbol ?? "-"))</option>
                    }
                }
            </select>
        </div>

        <div style="margin-bottom: 2px;">
            <button type="button" class="tf-btn tf-btn-secondary" @onclick="SwapCurrencies" title="Đảo ngược đồng tiền">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 16V4m0 0L3 8m4-4l4 4m6 4v12m0 0l4-4m-4 4l-4-4"/>
                </svg>
            </button>
        </div>

        <div>
            <label class="tf-label" style="font-size: 12px; margin-bottom: 4px;">Sang loại tiền</label>
            <select class="tf-input" value="@_calcToCode" @onchange="OnCalcToChanged">
                @if (_items != null)
                {
                    foreach (var c in _items.Where(x => x.IsActive))
                    {
                        <option value="@c.Code">@c.Code - @c.Name (@(c.Symbol ?? "-"))</option>
                    }
                }
            </select>
        </div>
    </div>

    @* Kết quả quy đổi hiển thị nổi bật *@
    @if (_calcResult != null)
    {
        <div style="margin-top: 14px; padding: 12px 16px; border-radius: 8px; background: rgba(99, 102, 241, 0.06); border: 1px solid rgba(99, 102, 241, 0.2); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
            <div>
                <div style="font-size: 12px; color: var(--tf-text-secondary); margin-bottom: 2px;">Kết quả quy đổi theo tỷ giá hiện hành:</div>
                <div style="font-size: 20px; font-weight: 700; color: #4f46e5; display: flex; align-items: baseline; gap: 6px;">
                    <span>@_calcResult.FormattedResult</span>
                    <span style="font-size: 15px; font-weight: 600; color: var(--tf-text-primary);">@_calcResult.ToCurrencyCode</span>
                </div>
            </div>
            <div style="text-align: right;">
                <div style="font-size: 12px; font-family: monospace; color: var(--tf-text-secondary);">@_calcResult.FormulaExplanation</div>
                <div style="font-size: 11px; color: var(--tf-text-secondary); margin-top: 2px;">
                    Tỷ giá chéo: 1 @_calcResult.FromCurrencyCode = @_calcResult.CrossRate.ToString("N4") @_calcResult.ToCurrencyCode
                </div>
            </div>
        </div>
    }
</div>

@* Thanh tìm kiếm & Bộ lọc *@
<div class="tf-card tf-mb-4" style="padding: 12px 16px; display: flex; gap: 12px; flex-wrap: wrap; align-items: center;">
    <div style="flex: 1; min-width: 200px;">
        <DebouncedSearchInput Placeholder="Tìm theo mã ISO, tên tiền tệ, ký hiệu..."
                              Value="@_searchTerm"
                              ValueChanged="OnSearchChanged" />
    </div>

    <div style="width: 170px;">
        <select class="tf-input" @bind="_statusFilter" @bind:after="OnFilterChanged">
            <option value="all">Tất cả trạng thái</option>
            <option value="active">Đang hoạt động</option>
            <option value="inactive">Tạm dừng</option>
        </select>
    </div>

    <div style="width: 170px;">
        <select class="tf-input" @bind="_sourceFilter" @bind:after="OnFilterChanged">
            <option value="all">Tất cả nguồn tỷ giá</option>
            <option value="manual">Thủ công</option>
            <option value="api">Trực tuyến (API)</option>
            <option value="locked">Cố định thủ công</option>
        </select>
    </div>
</div>

@* Danh sách bảng loại tiền *@
<div class="tf-card">
    <div class="tf-card-body" style="padding:0; overflow-x: auto;">
        
        @if (_selectedItems.Count > 0)
        {
            <div class="tw-bg-blue-50/80 tw-border tw-border-blue-200 tw-p-3.5 tw-rounded-lg tw-mb-4 tw-flex tw-justify-between tw-items-center tw-shadow-xs">
                <span class="tw-text-blue-900 tw-font-medium tw-text-sm">Đã chọn @_selectedItems.Count bản ghi</span>
                <AuthorizeView Policy="Permission:Currencies:Delete">
                    <button type="button" class="tf-btn tf-btn-sm tf-btn-danger" @onclick="ConfirmBulkDelete">Xóa đã chọn</button>
                </AuthorizeView>
            </div>
        }

        @if (_items == null)
        {
            <Skeleton Type="table" Rows="8" Columns="9" />
        }
        else
        {
            <div class="tf-table-loading-container">
                <TableLoadingOverlay Visible="@_isRefreshing" Message="Đang cập nhật..." />
                <table class="tf-table">
                    <thead>
                        <tr>
                            <th style="width: 40px; text-align: center;">
                                <input type="checkbox" @onchange="ToggleSelectAll" checked="@(FilteredItems.Any() && _selectedItems.Count == FilteredItems.Count())" />
                            </th>
                            <th style="min-width: 100px;">Mã tiền tệ (ISO)</th>
                            <th style="min-width: 180px;">Tên tiền tệ</th>
                            <th style="width: 80px; text-align: center;">Ký hiệu</th>
                            <th style="width: 90px; text-align: center;">Thập phân</th>
                            <th style="min-width: 160px; text-align: right;">Tỷ giá quy đổi (VND)</th>
                            <th style="min-width: 130px; text-align: center;">Nguồn tỷ giá</th>
                            <th style="min-width: 130px; text-align: center;">Ngày hiệu lực</th>
                            <th style="width: 120px; text-align: center;">Trạng thái</th>
                            <th style="min-width: 190px; text-align: right;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!FilteredItems.Any())
                        {
                            <tr>
                                <td colspan="10">
                                    <div class="tf-empty">
                                        <div class="tf-empty-title">Không tìm thấy loại tiền phù hợp</div>
                                        <p class="tf-empty-description">Thử tìm kiếm với từ khóa khác hoặc xóa bộ lọc.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in PagedItems)
                            {
                                <tr>
                                    <td style="text-align: center;">
                                        @if (!item.IsDefault && item.Code != "VND")
                                        {
                                            <input type="checkbox" @onchange="@(e => ToggleSelect(item.Id, e))" checked="@(_selectedItems.Contains(item.Id))" />
                                        }
                                        else
                                        {
                                            <span title="Tiền tệ cơ sở không thể thao tác hàng loạt" style="display:inline-flex; align-items:center; justify-content:center; color:var(--tf-text-muted);">
                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div style="display: flex; align-items: center; gap: 6px;">
                                            <span class="tw-font-mono tw-font-bold tw-text-indigo-700 tw-bg-indigo-50/80 tw-px-2.5 tw-py-1 tw-rounded tw-text-xs">@item.Code</span>
                                            @if (item.IsDefault)
                                            {
                                                <TfBadge Variant="info" Text="Cơ sở" />
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div class="tw-font-medium tw-text-slate-900" style="color: var(--tf-text-primary);">@item.Name</div>
                                        @if (!string.IsNullOrEmpty(item.Notes))
                                        {
                                            <div style="font-size: 11px; color: var(--tf-text-secondary); max-width: 240px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                                @item.Notes
                                            </div>
                                        }
                                    </td>
                                    <td style="text-align: center; font-weight: 600; color: var(--tf-text-secondary);">
                                        @(string.IsNullOrWhiteSpace(item.Symbol) ? "-" : item.Symbol)
                                    </td>
                                    <td style="text-align: center; font-family: monospace; font-size: 13px;">
                                        @item.DecimalPlaces
                                    </td>
                                    <td style="text-align: right;">
                                        <div style="font-family: monospace; font-weight: 600; font-size: 14px; color: var(--tf-text-primary);">
                                            @if (item.Code == "VND")
                                            {
                                                <span>1.0000</span>
                                            }
                                            else
                                            {
                                                <span>@item.ExchangeRate.ToString("N4")</span>
                                            }
                                        </div>
                                        <div style="font-size: 11px; color: var(--tf-text-secondary);">
                                            1 @item.Code = @(item.Code == "VND" ? "1" : item.ExchangeRate.ToString("N2")) VND
                                        </div>
                                    </td>
                                    <td style="text-align: center;">
                                        @if (item.Code == "VND")
                                        {
                                            <TfBadge Variant="info" Text="Gốc" />
                                        }
                                        else if (item.RateSource != null && item.RateSource.Contains("API"))
                                        {
                                            <TfBadge Variant="success" Text="API ExchangeRate" />
                                        }
                                        else
                                        {
                                            <TfBadge Variant="gray" Text="Thủ công" />
                                        }

                                        @if (item.IsManualOverride)
                                        {
                                            <div style="margin-top: 3px;">
                                                <span class="tw-text-xs tw-bg-amber-50 tw-text-amber-800 tw-px-1.5 tw-py-0.5 tw-rounded tw-font-medium tw-inline-flex tw-items-center tw-gap-1" title="Tỷ giá được người dùng cố định">
                                                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="17" x2="12" y2="22"></line><path d="M5 17h14v-1.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V6h1a2 2 0 0 0 0-4H8a2 2 0 0 0 0 4h1v4.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24Z"></path></svg>
                                                    <span>Cố định</span>
                                                </span>
                                            </div>
                                        }
                                    </td>
                                    <td style="text-align: center; font-size: 12px; color: var(--tf-text-secondary);">
                                        <div>@item.EffectiveAt.ToLocalTime().ToString("dd/MM/yyyy")</div>
                                        <div style="font-size: 10px;">@item.EffectiveAt.ToLocalTime().ToString("HH:mm")</div>
                                    </td>
                                    <td style="text-align: center;">
                                        <TfBadge Variant="@(item.IsActive ? "success" : "gray")"
                                                 Dot="true"
                                                 Text="@(item.IsActive ? "Hoạt động" : "Tạm dừng")" />
                                    </td>
                                    <td style="text-align: right;">
                                        <div class="tw-inline-flex tw-gap-1" style="display: inline-flex; gap: 4px; align-items: center;">
                                            @if (!item.IsDefault && item.Code != "VND")
                                            {
                                                <AuthorizeView Policy="Permission:Currencies:Edit">
                                                    <button type="button" class="tf-btn tf-btn-ghost tf-btn-sm" @onclick="() => OpenRateEditModal(item)" title="Chỉnh sửa tỷ giá quy đổi">
                                                        Sửa tỷ giá
                                                    </button>
                                                </AuthorizeView>
                                            }

                                            <button type="button" class="tf-btn tf-btn-ghost tf-btn-sm" @onclick="() => OpenHistoryModal(item.Code, item.Name)" title="Xem lịch sử điều chỉnh tỷ giá">
                                                Lịch sử
                                            </button>

                                            @if (!item.IsDefault && item.Code != "VND")
                                            {
                                                <AuthorizeView Policy="Permission:Currencies:Edit">
                                                    <button type="button" class="tf-btn tf-btn-ghost tf-btn-sm" @onclick="() => ToggleActive(item)" title="@(item.IsActive ? "Tạm dừng đồng tiền này" : "Kích hoạt đồng tiền này")">
                                                        @(item.IsActive ? "Tắt" : "Bật")
                                                    </button>
                                                </AuthorizeView>

                                                <AuthorizeView Policy="Permission:Currencies:Edit">
                                                    <button type="button" class="tf-btn tf-btn-ghost tf-btn-sm" @onclick="() => OpenEditModal(item)" title="Chỉnh sửa thông tin chung">
                                                        Sửa
                                                    </button>
                                                </AuthorizeView>

                                                <AuthorizeView Policy="Permission:Currencies:Delete">
                                                    <button class="tf-btn tf-btn-ghost tf-btn-sm tw-text-red-600 hover:tw-bg-red-50" @onclick="() => ConfirmDelete(item.Id, item.Name ?? item.Code)" title="Xóa loại tiền">
                                                        Xóa
                                                    </button>
                                                </AuthorizeView>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                
                @if (FilteredItems.Any())
                {
                    <TfPagination CurrentPage="@_currentPage"
                                  PageSize="@_pageSize"
                                  TotalCount="@FilteredItems.Count()"
                                  ItemName="loại tiền"
                                  PreferenceKey="currencies"
                                  CurrentPageChanged="@(p => _currentPage = p)"
                                  PageSizeChanged="@(s => { _pageSize = s; _currentPage = 1; })" />
                }
            </div>
        }
    </div>
</div>

@* ========================================================================= *@
@* MODAL 1: SỬA TỶ GIÁ THỦ CÔNG (MANUAL RATE EDIT)                           *@
@* ========================================================================= *@
<TfModal IsOpen="@_showRateModal"
         Title="@($"Điều chỉnh tỷ giá - {_editingRateCode}")"
         Size="md"
         OnClose="CloseRateModal">
    <BodyContent>
        @if (_editingCurrency != null)
        {
            <div style="margin-bottom: 16px; padding: 12px; background: rgba(99, 102, 241, 0.05); border-radius: 6px; border: 1px solid rgba(99, 102, 241, 0.15);">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <div>
                        <div style="font-size: 13px; font-weight: 600; color: var(--tf-text-primary);">@_editingCurrency.Name (@_editingCurrency.Code)</div>
                        <div style="font-size: 12px; color: var(--tf-text-secondary); margin-top: 2px;">
                            Tỷ giá hiện tại: <span style="font-family: monospace; font-weight: 600;">@_editingCurrency.ExchangeRate.ToString("N4") VND</span>
                        </div>
                    </div>
                    <span class="tw-font-mono tw-text-xs tw-bg-indigo-100 tw-text-indigo-800 tw-px-2 tw-py-1 tw-rounded tw-font-semibold">
                        1 @_editingCurrency.Code
                    </span>
                </div>
            </div>

            <div class="tf-form-group tf-mb-3">
                <label class="tf-label">
                    Tỷ giá quy đổi mới (1 @_editingCurrency.Code = X VND) <span style="color:var(--tf-error);">*</span>
                </label>
                <div style="position: relative;">
                    <input type="number" step="any" min="0.0001" class="tf-input"
                           @bind="_editingRateValue"
                           placeholder="Ví dụ: 25400" />
                    <span style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); font-size: 12px; color: var(--tf-text-secondary); font-weight: 500;">
                        VND
                    </span>
                </div>
                <div style="font-size: 12px; color: var(--tf-text-secondary); margin-top: 4px;">
                    Quy ước: 1 đơn vị ngoại tệ quy đổi ra số đồng Việt Nam tương ứng.
                </div>
            </div>

            <div class="tf-form-group tf-mb-3">
                <label class="tf-label">Thời điểm áp dụng</label>
                <input type="datetime-local" class="tf-input" @bind="_editingRateEffectiveAt" />
            </div>

            <div class="tf-form-group tf-mb-3">
                <label class="tf-label">Căn cứ điều chỉnh / Ghi chú</label>
                <input type="text" class="tf-input" @bind="_editingRateNotes" placeholder="Ví dụ: Theo tỷ giá bán chuyển khoản Vietcombank ngày..." />
            </div>

            <div class="tf-mb-2">
                <label class="tf-label" style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                    <input type="checkbox" @bind="_editingRateIsManualOverride" />
                    <span><strong>Cố định tỷ giá thủ công</strong> (Không tự động ghi đè khi cập nhật tỷ giá trực tuyến từ API)</span>
                </label>
            </div>

            @if (!string.IsNullOrEmpty(_rateEditError))
            {
                <div class="tf-alert tf-alert-error tf-mb-3">@_rateEditError</div>
            }
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="tf-btn tf-btn-secondary" @onclick="CloseRateModal">Hủy bỏ</button>
        <LoadingButton Variant="primary"
                       IsLoading="@_isSavingRate"
                       LoadingText="Đang lưu..."
                       Text="Lưu tỷ giá"
                       OnClick="SaveRateEditAsync" />
    </FooterContent>
</TfModal>

@* ========================================================================= *@
@* MODAL 2: CẬP NHẬT TỶ GIÁ TRỰC TUYẾN TỪ API (ON-DEMAND REFRESH PREVIEW)     *@
@* ========================================================================= *@
<TfModal IsOpen="@_showApiSyncModal"
         Title="Cập nhật tỷ giá trực tuyến từ API"
         Size="lg"
         OnClose="CloseApiSyncModal">
    <BodyContent>
        @if (_isFetchingApi)
        {
            <div style="padding: 32px; text-align: center;">
                <div class="tf-spinner" style="margin: 0 auto 12px auto; width: 32px; height: 32px; border-width: 3px;"></div>
                <div style="font-weight: 600; color: var(--tf-text-primary);">Đang kết nối tới máy chủ tỷ giá an toàn...</div>
                <div style="font-size: 13px; color: var(--tf-text-secondary); margin-top: 4px;">Thời gian chờ tối đa 8 giây qua giao thức HTTPS. Vui lòng đợi trong giây lát.</div>
            </div>
        }
        else if (_apiPreviewError != null)
        {
            <div class="tf-alert tf-alert-error tf-mb-3">
                <div style="font-weight: 600;">Không thể lấy tỷ giá trực tuyến</div>
                <div style="font-size: 13px; margin-top: 2px;">@_apiPreviewError</div>
            </div>
            <div style="text-align: center; margin-top: 16px;">
                <button type="button" class="tf-btn tf-btn-primary" @onclick="FetchApiRatesPreviewAsync">Thử kết nối lại</button>
            </div>
        }
        else if (_apiPreview != null)
        {
            <div style="padding: 12px 16px; background: rgba(16, 185, 129, 0.08); border-radius: 6px; border: 1px solid rgba(16, 185, 129, 0.2); margin-bottom: 16px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
                <div>
                    <div style="font-size: 13px; font-weight: 600; color: #065f46;">
                        Nguồn dữ liệu: @_apiPreview.ProviderName
                    </div>
                    <div style="font-size: 12px; color: var(--tf-text-secondary);">
                        Thời điểm lấy: @_apiPreview.FetchedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") | Tìm thấy @_apiPreview.Items.Count tỷ giá khả dụng
                    </div>
                </div>
                <div style="display: flex; gap: 8px;">
                    <button type="button" class="tf-btn tf-btn-ghost tf-btn-sm" @onclick="SelectAllApiItems">Chọn tất cả</button>
                    <button type="button" class="tf-btn tf-btn-ghost tf-btn-sm" @onclick="DeselectAllApiItems">Bỏ chọn</button>
                </div>
            </div>

            <div style="max-height: 380px; overflow-y: auto; border: 1px solid var(--tf-border); border-radius: 6px;">
                <table class="tf-table" style="margin-bottom: 0;">
                    <thead style="position: sticky; top: 0; background: var(--tf-card-bg); z-index: 1;">
                        <tr>
                            <th style="width: 40px; text-align: center;">Áp dụng</th>
                            <th>Mã</th>
                            <th>Tên loại tiền</th>
                            <th style="text-align: right;">Tỷ giá hiện tại</th>
                            <th style="text-align: right;">Tỷ giá mới (API)</th>
                            <th style="text-align: right;">Chênh lệch</th>
                            <th style="text-align: center;">Ghi chú</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _apiPreview.Items)
                        {
                            <tr style="@(item.IsManualOverride ? "background: rgba(245, 158, 11, 0.04);" : "")">
                                <td style="text-align: center;">
                                    <input type="checkbox" @bind="item.IsSelected" />
                                </td>
                                <td>
                                    <span class="tw-font-mono tw-font-bold tw-text-indigo-700 tw-text-xs">@item.CurrencyCode</span>
                                </td>
                                <td style="font-size: 13px;">@item.CurrencyName</td>
                                <td style="text-align: right; font-family: monospace;">@item.CurrentRate.ToString("N4")</td>
                                <td style="text-align: right; font-family: monospace; font-weight: 600; color: #4f46e5;">
                                    @item.NewRate.ToString("N4")
                                </td>
                                <td style="text-align: right; font-family: monospace; font-size: 12px;">
                                    @if (item.RateDifference > 0)
                                    {
                                        <span style="color: #10b981; font-weight: 600;">+@item.RateDifference.ToString("N2") (+@item.PercentageChange.ToString("N1")%)</span>
                                    }
                                    else if (item.RateDifference < 0)
                                    {
                                        <span style="color: #ef4444; font-weight: 600;">@item.RateDifference.ToString("N2") (@item.PercentageChange.ToString("N1")%)</span>
                                    }
                                    else
                                    {
                                        <span style="color: var(--tf-text-secondary);">-</span>
                                    }
                                </td>
                                <td style="text-align: center; font-size: 11px;">
                                    @if (item.IsManualOverride)
                                    {
                                        <span class="tw-bg-amber-100 tw-text-amber-800 tw-px-1.5 tw-py-0.5 tw-rounded tw-font-medium">
                                            Đang cố định
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="color: var(--tf-text-secondary);">Tự động</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div style="margin-top: 12px; font-size: 12px; color: var(--tf-text-secondary);">
                ℹ️ <strong>Bảo toàn dữ liệu:</strong> Chỉ các đồng tiền được tích chọn mới được cập nhật. Đồng tiền có đánh dấu cố định thủ công sẽ không bị ghi đè nếu bạn không chọn.
            </div>
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="tf-btn tf-btn-secondary" @onclick="CloseApiSyncModal">Hủy bỏ</button>
        @if (_apiPreview != null && !_isFetchingApi)
        {
            <LoadingButton Variant="primary"
                           IsLoading="@_isApplyingApiRates"
                           LoadingText="Đang áp dụng..."
                           Text="@($"Áp dụng {_apiPreview.Items.Count(x => x.IsSelected)} tỷ giá đã chọn")"
                           OnClick="ApplyApiRatesAsync" />
        }
    </FooterContent>
</TfModal>

@* ========================================================================= *@
@* MODAL 3: LỊCH SỬ BIẾN ĐỘNG TỶ GIÁ                                         *@
@* ========================================================================= *@
<TfModal IsOpen="@_showHistoryModal"
         Title="@($"Lịch sử tỷ giá - {_historyCurrencyCode} ({_historyCurrencyName})")"
         Size="lg"
         OnClose="CloseHistoryModal">
    <BodyContent>
        @if (_isLoadingHistory)
        {
            <Skeleton Type="table" Rows="5" Columns="5" />
        }
        else if (_rateHistories == null || _rateHistories.Count == 0)
        {
            <div class="tf-empty" style="padding: 24px;">
                <div class="tf-empty-title">Chưa có lịch sử điều chỉnh tỷ giá</div>
                <p class="tf-empty-description">Đồng tiền này chưa có lần điều chỉnh thủ công hoặc cập nhật trực tuyến nào kể từ khi khởi tạo.</p>
            </div>
        }
        else
        {
            <div style="max-height: 400px; overflow-y: auto;">
                <table class="tf-table" style="margin-bottom: 0;">
                    <thead>
                        <tr>
                            <th>Thời gian hiệu lực</th>
                            <th style="text-align: right;">Tỷ giá áp dụng</th>
                            <th style="text-align: right;">Tỷ giá trước đó</th>
                            <th style="text-align: center;">Nguồn</th>
                            <th>Người thực hiện</th>
                            <th>Căn cứ / Ghi chú</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var h in _rateHistories)
                        {
                            <tr>
                                <td style="font-size: 13px;">
                                    <div>@h.EffectiveAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                </td>
                                <td style="text-align: right; font-family: monospace; font-weight: 600; color: #4f46e5;">
                                    @h.Rate.ToString("N4")
                                </td>
                                <td style="text-align: right; font-family: monospace; color: var(--tf-text-secondary);">
                                    @(h.PreviousRate.HasValue ? h.PreviousRate.Value.ToString("N4") : "-")
                                </td>
                                <td style="text-align: center;">
                                    @if (h.Source.Contains("API"))
                                    {
                                        <TfBadge Variant="success" Text="API" />
                                    }
                                    else
                                    {
                                        <TfBadge Variant="gray" Text="Thủ công" />
                                    }
                                </td>
                                <td style="font-size: 13px;">@(h.ChangedBy ?? "System")</td>
                                <td style="font-size: 12px; color: var(--tf-text-secondary);">@(h.Notes ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="tf-btn tf-btn-secondary" @onclick="CloseHistoryModal">Đóng</button>
    </FooterContent>
</TfModal>

@* ========================================================================= *@
@* MODAL 4: THÊM / SỬA THÔNG TIN LOẠI TIỀN                                   *@
@* ========================================================================= *@
<TfModal IsOpen="@_showFormModal"
         Title="@(_isEditForm ? $"Sửa thông tin - {_formModel.Code}" : "Thêm loại tiền mới")"
         Size="md"
         OnClose="CloseFormModal">
    <BodyContent>
        <EditForm Model="_formModel" OnValidSubmit="SaveFormAsync">
            <DataAnnotationsValidator />

            <div style="display:grid; grid-template-columns: 1fr 1fr; gap: 14px;" class="tf-mb-3">
                <div class="tf-form-group">
                    <label class="tf-label">Mã tiền tệ (ISO 4217) <span style="color:var(--tf-error);">*</span></label>
                    <input type="text" class="tf-input" maxlength="3"
                           style="text-transform: uppercase; font-family: monospace; font-weight: 600;"
                           @bind="_formModel.Code"
                           disabled="@_isEditForm"
                           placeholder="USD, EUR, CNY..." />
                    <div style="font-size: 11px; color: var(--tf-text-secondary); margin-top: 2px;">Chuẩn 3 ký tự viết hoa</div>
                </div>

                <div class="tf-form-group">
                    <label class="tf-label">Ký hiệu tiền tệ</label>
                    <input type="text" class="tf-input" maxlength="5"
                           @bind="_formModel.Symbol"
                           placeholder="₫, $, €, ¥..." />
                </div>
            </div>

            <div class="tf-form-group tf-mb-3">
                <label class="tf-label">Tên đầy đủ loại tiền <span style="color:var(--tf-error);">*</span></label>
                <input type="text" class="tf-input"
                       @bind="_formModel.Name"
                       placeholder="Ví dụ: Đô la Mỹ, Đồng Euro..." />
            </div>

            <div style="display:grid; grid-template-columns: 1fr 1fr; gap: 14px;" class="tf-mb-3">
                <div class="tf-form-group">
                    <label class="tf-label">Tỷ giá so với VND (1 [Mã] = X VND) <span style="color:var(--tf-error);">*</span></label>
                    <input type="number" step="any" min="0.0001" class="tf-input"
                           @bind="_formModel.ExchangeRate" />
                </div>

                <div class="tf-form-group">
                    <label class="tf-label">Số chữ số thập phân</label>
                    <select class="tf-input" @bind="_formModel.DecimalPlaces">
                        <option value="0">0 (VND, JPY, KRW...)</option>
                        <option value="2">2 (USD, EUR, THB...)</option>
                        <option value="3">3 (BHD, KWD...)</option>
                        <option value="4">4 (Ngoại hối vi mô)</option>
                    </select>
                </div>
            </div>

            <div class="tf-form-group tf-mb-3">
                <label class="tf-label">Ghi chú / Căn cứ</label>
                <input type="text" class="tf-input" @bind="_formModel.Notes" placeholder="Ghi chú thêm về đồng tiền..." />
            </div>

            <div style="display: flex; gap: 20px; margin-top: 12px;" class="tf-mb-2">
                <label class="tf-label" style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                    <input type="checkbox" @bind="_formModel.IsActive" />
                    <span>Đang hoạt động</span>
                </label>
                <label class="tf-label" style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                    <input type="checkbox" @bind="_formModel.IsManualOverride" />
                    <span>Cố định tỷ giá thủ công</span>
                </label>
            </div>

            @if (!string.IsNullOrEmpty(_formError))
            {
                <div class="tf-alert tf-alert-error tf-mb-3">@_formError</div>
            }
        </EditForm>
    </BodyContent>
    <FooterContent>
        <button type="button" class="tf-btn tf-btn-secondary" @onclick="CloseFormModal">Hủy bỏ</button>
        <LoadingButton Variant="primary"
                       IsLoading="@_isSavingForm"
                       LoadingText="Đang lưu..."
                       Text="@(_isEditForm ? "Lưu thay đổi" : "Tạo loại tiền")"
                       OnClick="SaveFormAsync" />
    </FooterContent>
</TfModal>

@* ========================================================================= *@
@* MODAL XÓA ĐƠN LẺ & BULK DELETE                                            *@
@* ========================================================================= *@
<TfModal IsOpen="@(_itemToDeleteId != null)"
         Title="Xóa loại tiền tệ?"
         Size="sm"
         OnClose="CancelDelete">
    <BodyContent>
        <p class="tw-text-slate-600 tw-mb-4">Bạn có chắc chắn muốn xóa "<strong>@(_itemToDeleteName)</strong>"?</p>
        @if (!string.IsNullOrEmpty(_deleteError))
        {
            <div class="tf-alert tf-alert-error tw-mb-3">@_deleteError</div>
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="tf-btn tf-btn-secondary" @onclick="CancelDelete">Hủy</button>
        <LoadingButton Variant="danger"
                       IsLoading="@_isDeleting"
                       LoadingText="Đang xóa..."
                       Text="Xóa"
                       OnClick="ExecuteDelete" />
    </FooterContent>
</TfModal>

<TfModal IsOpen="@_showBulkDeleteModal"
         Title="@($"Xóa {_selectedItems.Count} bản ghi đã chọn?")"
         Size="md"
         OnClose="CancelBulkDelete">
    <BodyContent>
        <p class="tw-text-slate-600 tw-mb-4">Hành động này không thể hoàn tác. Các bản ghi đang được sử dụng sẽ bị bỏ qua thay vì xóa hoàn toàn.</p>
        @if (_bulkDeleteErrors.Count > 0)
        {
            <div class="tf-alert tf-alert-error tw-mb-4 tw-max-h-36 tw-overflow-y-auto">
                <ul class="tw-m-0 tw-pl-5">
                    @foreach (var err in _bulkDeleteErrors)
                    {
                        <li>@err</li>
                    }
                </ul>
            </div>
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="tf-btn tf-btn-secondary" @onclick="CancelBulkDelete">Hủy</button>
        <LoadingButton Variant="danger"
                       IsLoading="@_isBulkDeleting"
                       LoadingText="Đang xử lý..."
                       Text="Xóa tất cả"
                       OnClick="ExecuteBulkDelete" />
    </FooterContent>
</TfModal>

@code {
    private List<Currency>? _items;
    private DateTime? _lastRefreshedAt;
    private string _searchTerm = string.Empty;
    private string _statusFilter = "all";
    private string _sourceFilter = "all";
    private bool _isRefreshing = false;

    private string? _globalSuccessMessage;
    private string? _globalErrorMessage;

    // Interactive Calculator
    private decimal _calcAmount = 100m;
    private string _calcFromCode = "USD";
    private string _calcToCode = "VND";
    private CurrencyConversionResult? _calcResult;

    // Manual Rate Edit Modal
    private bool _showRateModal = false;
    private Currency? _editingCurrency;
    private string _editingRateCode = string.Empty;
    private decimal _editingRateValue = 1m;
    private DateTime _editingRateEffectiveAt = DateTime.UtcNow;
    private string? _editingRateNotes;
    private bool _editingRateIsManualOverride = false;
    private bool _isSavingRate = false;
    private string? _rateEditError;

    // Online API Refresh Modal
    private bool _showApiSyncModal = false;
    private bool _isFetchingApi = false;
    private bool _isApplyingApiRates = false;
    private ExchangeRatePreviewDto? _apiPreview;
    private string? _apiPreviewError;

    // History Modal
    private bool _showHistoryModal = false;
    private bool _isLoadingHistory = false;
    private string _historyCurrencyCode = string.Empty;
    private string _historyCurrencyName = string.Empty;
    private List<ExchangeRateHistoryDto>? _rateHistories;

    // Add / Edit General Modal
    private bool _showFormModal = false;
    private bool _isEditForm = false;
    private int? _editingFormCurrencyId;
    private bool _isSavingForm = false;
    private Currency _formModel = new();
    private string? _formError;

    // Delete single & bulk
    private int? _itemToDeleteId;
    private string _itemToDeleteName = "";
    private string? _deleteError;
    private bool _isDeleting = false;
    private HashSet<int> _selectedItems = new();
    private bool _showBulkDeleteModal = false;
    private List<string> _bulkDeleteErrors = new();
    private bool _isBulkDeleting = false;

    // Pagination
    private int _currentPage = 1;
    private int _pageSize = 20;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _items = await DbContext.Currencies
            .OrderByDescending(x => x.IsDefault)
            .ThenBy(x => x.Code)
            .ToListAsync();

        _lastRefreshedAt = _items
            .Where(x => x.LastRefreshedAt.HasValue)
            .Select(x => x.LastRefreshedAt)
            .Max();

        await CalculateConversionAsync();
    }

    private IEnumerable<Currency> FilteredItems
    {
        get
        {
            if (_items == null) return Enumerable.Empty<Currency>();

            var query = _items.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                var term = _searchTerm.Trim().ToLower();
                query = query.Where(x =>
                    (x.Code != null && x.Code.ToLower().Contains(term)) ||
                    (x.Name != null && x.Name.ToLower().Contains(term)) ||
                    (x.Symbol != null && x.Symbol.ToLower().Contains(term)));
            }

            if (_statusFilter == "active")
            {
                query = query.Where(x => x.IsActive);
            }
            else if (_statusFilter == "inactive")
            {
                query = query.Where(x => !x.IsActive);
            }

            if (_sourceFilter == "manual")
            {
                query = query.Where(x => x.RateSource == null || !x.RateSource.Contains("API"));
            }
            else if (_sourceFilter == "api")
            {
                query = query.Where(x => x.RateSource != null && x.RateSource.Contains("API"));
            }
            else if (_sourceFilter == "locked")
            {
                query = query.Where(x => x.IsManualOverride);
            }

            return query;
        }
    }

    private IEnumerable<Currency> PagedItems =>
        FilteredItems.Skip((_currentPage - 1) * _pageSize).Take(_pageSize);

    private void OnSearchChanged(string val)
    {
        _searchTerm = val;
        _currentPage = 1;
    }

    private void OnFilterChanged()
    {
        _currentPage = 1;
    }

    // =========================================================================
    // CALCULATOR WORKFLOW
    // =========================================================================
    private async Task OnCalcAmountChanged(ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var amt))
        {
            _calcAmount = Math.Max(0m, amt);
        }
        await CalculateConversionAsync();
    }

    private async Task OnCalcFromChanged(ChangeEventArgs e)
    {
        _calcFromCode = e.Value?.ToString() ?? "USD";
        await CalculateConversionAsync();
    }

    private async Task OnCalcToChanged(ChangeEventArgs e)
    {
        _calcToCode = e.Value?.ToString() ?? "VND";
        await CalculateConversionAsync();
    }

    private async Task SwapCurrencies()
    {
        var temp = _calcFromCode;
        _calcFromCode = _calcToCode;
        _calcToCode = temp;
        await CalculateConversionAsync();
    }

    private async Task CalculateConversionAsync()
    {
        if (_items == null || _items.Count == 0) return;

        try
        {
            var from = _items.FirstOrDefault(x => x.Code == _calcFromCode) ?? _items.FirstOrDefault(x => x.Code == "USD") ?? _items.First();
            var to = _items.FirstOrDefault(x => x.Code == _calcToCode) ?? _items.FirstOrDefault(x => x.Code == "VND") ?? _items.First();

            _calcFromCode = from.Code;
            _calcToCode = to.Code;

            _calcResult = await CurrencyService.ConvertAmountAsync(_calcAmount, from.Code, to.Code);
        }
        catch (Exception ex)
        {
            _calcResult = null;
            _globalErrorMessage = "Lỗi tính toán quy đổi: " + ex.Message;
        }
    }

