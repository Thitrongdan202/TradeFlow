    private async Task SaveFormAsync()
    {
        if (string.IsNullOrWhiteSpace(_formModel.Code) || string.IsNullOrWhiteSpace(_formModel.Name))
        {
            _formError = "Mã tiền tệ và Tên tiền tệ là bắt buộc.";
            return;
        }

        _formModel.Code = _formModel.Code.Trim().ToUpperInvariant();
        if (_formModel.Code.Length < 2 || _formModel.Code.Length > 5)
        {
            _formError = "Mã tiền tệ phải có độ dài từ 2 đến 5 ký tự (chuẩn ISO là 3 ký tự, ví dụ: USD).";
            return;
        }

        if (_formModel.ExchangeRate <= 0)
        {
            _formError = "Tỷ giá phải lớn hơn 0.";
            return;
        }

        _isSavingForm = true;
        _formError = null;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name ?? CurrentUser.UserName;

            if (_isEditForm)
            {
                var existing = await DbContext.Currencies.FindAsync(_editingFormCurrencyId);
                if (existing == null)
                {
                    _formError = "Không tìm thấy bản ghi để cập nhật.";
                    return;
                }

                existing.Name = _formModel.Name.Trim();
                existing.Symbol = _formModel.Symbol?.Trim();
                existing.DecimalPlaces = _formModel.DecimalPlaces;
                existing.IsActive = _formModel.IsActive;
                existing.Notes = _formModel.Notes?.Trim();
                existing.IsManualOverride = _formModel.IsManualOverride;
                existing.UpdatedAt = DateTime.UtcNow;
                existing.UpdatedBy = username;

                if (existing.ExchangeRate != _formModel.ExchangeRate)
                {
                    decimal oldRate = existing.ExchangeRate;
                    existing.ExchangeRate = _formModel.ExchangeRate;
                    existing.EffectiveAt = DateTime.UtcNow;

                    DbContext.ExchangeRateHistories.Add(new ExchangeRateHistory
                    {
                        CurrencyId = existing.Id,
                        CurrencyCode = existing.Code,
                        Rate = _formModel.ExchangeRate,
                        PreviousRate = oldRate,
                        Source = "Thủ công",
                        EffectiveAt = DateTime.UtcNow,
                        Notes = _formModel.Notes,
                        ChangedBy = username,
                        CreatedAt = DateTime.UtcNow
                    });
                }

                await DbContext.SaveChangesAsync();
                await AuditService.LogAsync(AuditEventType.CurrencyUpdated, username, "Currency", existing.Id.ToString(), $"Cập nhật thông tin đồng tiền {existing.Code}");
                _globalSuccessMessage = $"Đã cập nhật thông tin {_formModel.Code} thành công.";
            }
            else
            {
                if (await DbContext.Currencies.AnyAsync(x => x.Code == _formModel.Code))
                {
                    _formError = $"Mã tiền tệ '{_formModel.Code}' đã tồn tại trong hệ thống.";
                    return;
                }

                _formModel.CreatedAt = DateTime.UtcNow;
                _formModel.CreatedBy = username;
                _formModel.EffectiveAt = DateTime.UtcNow;
                _formModel.RateSource = "Thủ công";

                DbContext.Currencies.Add(_formModel);
                await DbContext.SaveChangesAsync();

                DbContext.ExchangeRateHistories.Add(new ExchangeRateHistory
                {
                    CurrencyId = _formModel.Id,
                    CurrencyCode = _formModel.Code,
                    Rate = _formModel.ExchangeRate,
                    PreviousRate = null,
                    Source = "Khởi tạo",
                    EffectiveAt = DateTime.UtcNow,
                    Notes = _formModel.Notes ?? "Khởi tạo loại tiền mới",
                    ChangedBy = username,
                    CreatedAt = DateTime.UtcNow
                });
                await DbContext.SaveChangesAsync();

                await AuditService.LogAsync(AuditEventType.CurrencyCreated, username, "Currency", _formModel.Code, $"Thêm mới loại tiền {_formModel.Code}");
                _globalSuccessMessage = $"Đã tạo loại tiền {_formModel.Code} thành công.";
            }

            CloseFormModal();
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _formError = "Có lỗi xảy ra: " + ex.Message;
        }
        finally
        {
            _isSavingForm = false;
        }
    }

    // =========================================================================
    // DELETE SINGLE & BULK WORKFLOW
    // =========================================================================
    private void ConfirmDelete(int id, string name)
    {
        _itemToDeleteId = id;
        _itemToDeleteName = name;
        _deleteError = null;
    }

    private void CancelDelete()
    {
        _itemToDeleteId = null;
        _deleteError = null;
    }

    private async Task ExecuteDelete()
    {
        if (_itemToDeleteId == null) return;
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!(await AuthService.AuthorizeAsync(authState.User, "Permission:Currencies:Delete")).Succeeded)
        {
            _deleteError = "Bạn không có quyền thực hiện thao tác này.";
            return;
        }

        _isDeleting = true;
        try
        {
            int id = _itemToDeleteId.Value;
            var entity = await DbContext.Currencies.FindAsync(id);
            if (entity == null)
            {
                CancelDelete();
                return;
            }

            if (entity.IsDefault || entity.Code == "VND")
            {
                _deleteError = "Không thể xóa đồng tiền cơ sở mặc định (VND).";
                return;
            }

            string code = entity.Code;
            bool isReferenced = await DbContext.PriceListItems.AnyAsync(x => x.CurrencyCode == code)
                                || await DbContext.Contracts.AnyAsync(x => x.CurrencyCode == code);

            if (isReferenced)
            {
                _deleteError = "Không thể xóa vì dữ liệu này đang được sử dụng trong bảng giá hoặc đơn hàng.";
                return;
            }

            DbContext.Remove(entity);
            await DbContext.SaveChangesAsync();

            await AuditService.LogAsync(AuditEventType.CurrencyDeleted, authState.User.Identity?.Name ?? "System", "Currency", id.ToString(), $"Xóa loại tiền {code}");
            CancelDelete();
            _globalSuccessMessage = $"Đã xóa loại tiền {code} thành công.";
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _deleteError = "Đã xảy ra lỗi: " + ex.Message;
        }
        finally
        {
            _isDeleting = false;
        }
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        if (e.Value is bool isChecked && isChecked)
        {
            _selectedItems = new HashSet<int>(FilteredItems.Where(x => !x.IsDefault && x.Code != "VND").Select(x => x.Id));
        }
        else
        {
            _selectedItems.Clear();
        }
    }

    private void ToggleSelect(int id, ChangeEventArgs e)
    {
        if (e.Value is bool isChecked && isChecked)
        {
            _selectedItems.Add(id);
        }
        else
        {
            _selectedItems.Remove(id);
        }
    }

    private void ConfirmBulkDelete()
    {
        _bulkDeleteErrors.Clear();
        _showBulkDeleteModal = true;
    }

    private void CancelBulkDelete()
    {
        _showBulkDeleteModal = false;
        _isBulkDeleting = false;
    }

    private async Task ExecuteBulkDelete()
    {
        if (_selectedItems.Count == 0) return;
        _isBulkDeleting = true;
        _bulkDeleteErrors.Clear();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!(await AuthService.AuthorizeAsync(authState.User, "Permission:Currencies:Delete")).Succeeded)
        {
            _bulkDeleteErrors.Add("Bạn không có quyền thực hiện thao tác này.");
            _isBulkDeleting = false;
            return;
        }

        try
        {
            int successCount = 0;
            var idsToProcess = _selectedItems.ToList();

            foreach (var id in idsToProcess)
            {
                var entity = await DbContext.Currencies.FindAsync(id);
                if (entity == null || entity.IsDefault || entity.Code == "VND")
                {
                    _selectedItems.Remove(id);
                    continue;
                }

                bool isReferenced = await DbContext.PriceListItems.AnyAsync(x => x.CurrencyCode == entity.Code)
                                    || await DbContext.Contracts.AnyAsync(x => x.CurrencyCode == entity.Code);

                if (isReferenced)
                {
                    _bulkDeleteErrors.Add($"Đồng tiền {entity.Code}: Đang được tham chiếu trong dữ liệu lịch sử.");
                    continue;
                }

                DbContext.Remove(entity);
                await AuditService.LogAsync(AuditEventType.CurrencyDeleted, authState.User.Identity?.Name ?? "System", "Currency", id.ToString(), $"Xóa loại tiền {entity.Code}");
                _selectedItems.Remove(id);
                successCount++;
            }

            if (successCount > 0)
            {
                await DbContext.SaveChangesAsync();
                _globalSuccessMessage = $"Đã xóa thành công {successCount} loại tiền.";
                await LoadDataAsync();
            }

            if (_selectedItems.Count == 0)
            {
                CancelBulkDelete();
            }
        }
        finally
        {
            _isBulkDeleting = false;
        }
    }
}
