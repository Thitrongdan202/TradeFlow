    private async Task FetchApiRatesPreviewAsync()
    {
        _isFetchingApi = true;
        _apiPreviewError = null;
        _apiPreview = null;
        StateHasChanged();

        try
        {
            var preview = await CurrencyService.FetchLatestRatesPreviewAsync();
            if (preview.Success)
            {
                _apiPreview = preview;
            }
            else
            {
                _apiPreviewError = preview.ErrorMessage ?? "Không nhận được phản hồi hợp lệ từ máy chủ tỷ giá.";
            }
        }
        catch (Exception ex)
        {
            _apiPreviewError = "Lỗi kết nối API: " + ex.Message;
        }
        finally
        {
            _isFetchingApi = false;
            StateHasChanged();
        }
