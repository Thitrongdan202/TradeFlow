    private async Task SaveRateEditAsync()
    {
        if (_editingCurrency == null) return;
        if (_editingRateValue <= 0)
        {
            _rateEditError = "Tỷ giá phải lớn hơn 0.";
            return;
        }

        _isSavingRate = true;
        _rateEditError = null;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name ?? CurrentUser.UserName;

            var request = new UpdateManualRateRequest
            {
                CurrencyId = _editingCurrency.Id,
                CurrencyCode = _editingCurrency.Code,
                NewRate = _editingRateValue,
                EffectiveAt = _editingRateEffectiveAt,
                Notes = _editingRateNotes,
                IsManualOverride = _editingRateIsManualOverride
            };

            var success = await CurrencyService.UpdateManualRateAsync(request, username);
            if (success)
            {
                _globalSuccessMessage = $"Đã cập nhật tỷ giá cho {_editingCurrency.Code} thành công ({_editingRateValue:N4} VND).";
