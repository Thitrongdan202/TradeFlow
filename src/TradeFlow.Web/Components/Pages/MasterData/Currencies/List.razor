    private void SelectAllApiItems()
    {
        if (_apiPreview?.Items == null) return;
        foreach (var item in _apiPreview.Items) item.IsSelected = true;
    }

    private void DeselectAllApiItems()
    {
        if (_apiPreview?.Items == null) return;
        foreach (var item in _apiPreview.Items) item.IsSelected = false;
    }

    private async Task ApplyApiRatesAsync()
    {
        if (_apiPreview?.Items == null) return;

        var selected = _apiPreview.Items.Where(x => x.IsSelected).ToList();
        if (selected.Count == 0)
        {
            _apiPreviewError = "Vui lòng chọn ít nhất một đồng tiền để áp dụng.";
            return;
        }

        _isApplyingApiRates = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name ?? CurrentUser.UserName;

            var request = new ApplyExchangeRatesRequest
            {
                RatesToApply = selected.Select(s => new ApplyRateItemDto
                {
                    CurrencyCode = s.CurrencyCode,
                    Rate = s.NewRate,
                    KeepManualOverride = s.IsManualOverride
                }).ToList(),
                EffectiveAt = DateTime.UtcNow
            };

            var result = await CurrencyService.ApplyExchangeRatesAsync(request, username);
            if (result.Success)
            {
                _globalSuccessMessage = result.Message ?? $"Đã cập nhật thành công {result.UpdatedCount} tỷ giá.";
                CloseApiSyncModal();
                await LoadDataAsync();
            }
            else
            {
                _apiPreviewError = result.Message ?? "Không thể áp dụng tỷ giá.";
            }
        }
        catch (Exception ex)
        {
            _apiPreviewError = "Lỗi khi áp dụng tỷ giá: " + ex.Message;
        }
        finally
        {
            _isApplyingApiRates = false;
        }
    }

