                                                                    @* Col 2: Identification & Classification *@
                                                                    <div style="background: #ffffff; padding: 16px; border-radius: 8px; border: 1px solid #e2e8f0; display: flex; flex-direction: column; gap: 12px;">
                                                                        <div style="font-size: 12px; font-weight: 700; color: #475569; text-transform: uppercase; border-bottom: 1px solid #f1f5f9; padding-bottom: 6px;">
                                                                            Thông tin cơ bản
