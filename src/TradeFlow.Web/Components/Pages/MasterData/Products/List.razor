@page "/danh-muc/san-pham"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Application.Common.Constants
@using TradeFlow.Domain.Entities.MasterData
@using TradeFlow.Domain.Entities.Pricing
@using TradeFlow.Domain.Enums
@using TradeFlow.Infrastructure.Persistence
@attribute [Authorize(Policy = "Permission:Products:View")]

@inject TradeFlowDbContext DbContext
@inject IPriceListService PriceListService
@inject IFileStorageService FileStorage
@inject ISystemCodeGenerator CodeGenerator
@inject IAuditService AuditService
@inject ICurrentUserService CurrentUser
@inject NavigationManager Nav
@inject IAuthorizationService AuthService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider

<PageTitle>Sản phẩm - TradeFlow</PageTitle>

@* Top Page Header with Search & Toolbar (KiotViet Style) *@
<div class="tf-page-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 16px;">
    <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">
        <div>
            <h1 class="tf-page-title" style="margin: 0; font-size: 20px;">Sản phẩm</h1>
            <p class="tf-page-subtitle" style="margin: 2px 0 0; font-size: 12px;">Quản lý danh mục hàng hóa, đơn giá và hình ảnh</p>
        </div>

        @* Quick search bar near title *@
        <div style="width: 340px; max-width: 100%;">
            <DebouncedSearchInput Placeholder="Tìm kiếm theo tên, mã mới, mã cũ, mã SP..."
                                  Value="@_searchTerm"
                                  ValueChanged="OnSearchChanged" />
        </div>
    </div>

    @* Right Toolbar Actions *@
    <div class="tf-page-actions" style="display: flex; align-items: center; gap: 8px;">
        <AuthorizeView Policy="Permission:PriceLists:Create">
            <button type="button" class="tf-btn tf-btn-secondary" @onclick="() => _showExcelImportModal = true" style="display: inline-flex; align-items: center; gap: 6px; height: 36px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="12" y1="18" x2="12" y2="12"></line>
                    <line x1="9" y1="15" x2="15" y2="15"></line>
                </svg>
                <span>Import Excel</span>
            </button>
        </AuthorizeView>

        <AuthorizeView Policy="Permission:Products:Create">
            <a href="/danh-muc/san-pham/them-moi" class="tf-btn tf-btn-primary" style="display: inline-flex; align-items: center; gap: 6px; height: 36px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                <span>+ Thêm mới</span>
            </a>
        </AuthorizeView>
    </div>
</div>

@if (!string.IsNullOrEmpty(_toastMessage))
{
    <div class="tf-alert tf-alert-info tf-mb-3" style="background:#eff6ff; border:1px solid #bfdbfe; color:#1e40af; display:flex; justify-content:space-between; align-items:center; padding: 10px 14px; border-radius: 6px;">
        <span>@_toastMessage</span>
        <button type="button" style="background:none; border:none; color:#1e40af; cursor:pointer; font-weight:bold;" @onclick="() => _toastMessage = null">✕</button>
    </div>
}

@* Main Layout: Left Filter Sidebar + Right Table (KiotViet Pattern) *@
<div class="tf-product-layout">
    @* Left Filter Sidebar *@
    <div class="tf-product-sidebar">
        <FilterSidebar Title="Bộ lọc sản phẩm" HasActiveFilters="@HasActiveFilters" OnClearFilters="ClearAllFilters">
            @* 1. Filter by Category *@
            <div class="tf-filter-card tf-mb-3">
                <div class="tf-filter-header" style="display: flex; justify-content: space-between; align-items: center;">
                    <span class="tf-filter-title">Loại hàng</span>
                    <a href="/danh-muc/danh-muc-san-pham" class="tf-link-action" style="font-size: 11px;">Quản lý</a>
                </div>
                <div style="padding: 6px 10px 4px;">
                    <input type="text" class="tf-input" style="height: 30px; font-size: 12px; padding: 0 8px;" placeholder="Tìm loại hàng..." @bind="_categorySearchTerm" @bind:event="oninput" />
                </div>
                <div class="tf-filter-body" style="max-height: 220px; overflow-y: auto;">
                    <div class="tf-filter-option @(_selectedCategoryId == null ? "selected" : "")" @onclick="() => SetCategoryFilter(null)">
                        <span>Tất cả loại hàng</span>
                        <span class="tf-filter-count">@(_items?.Count ?? 0)</span>
                    </div>
                    @if (_categories != null)
                    {
                        @foreach (var cat in FilteredCategoryOptions)
                        {
                            int count = _items?.Count(p => p.CategoryId == cat.Id) ?? 0;
                            <div class="tf-filter-option @(_selectedCategoryId == cat.Id ? "selected" : "")" @onclick="() => SetCategoryFilter(cat.Id)">
                                <span class="tf-truncate" title="@cat.Name">@cat.Name</span>
                                <span class="tf-filter-count">@count</span>
                            </div>
                        }
                    }
                </div>
            </div>

            @* 2. Filter by Status *@
            <div class="tf-filter-card tf-mb-3">
                <div class="tf-filter-header">
                    <span class="tf-filter-title">Trạng thái</span>
                </div>
                <div class="tf-filter-body">
                    <label class="tf-filter-option @(_statusFilter == null ? "selected" : "")" @onclick="() => SetStatusFilter(null)">
                        <input type="radio" name="prodStatus" checked="@(_statusFilter == null)" />
                        <span>Tất cả</span>
                        <span class="tf-filter-count">@(_items?.Count ?? 0)</span>
                    </label>
                    <label class="tf-filter-option @(_statusFilter == true ? "selected" : "")" @onclick="() => SetStatusFilter(true)">
                        <input type="radio" name="prodStatus" checked="@(_statusFilter == true)" />
                        <span>Đang hoạt động</span>
                        <span class="tf-filter-count">@(_items?.Count(p => p.IsActive) ?? 0)</span>
                    </label>
                    <label class="tf-filter-option @(_statusFilter == false ? "selected" : "")" @onclick="() => SetStatusFilter(false)">
                        <input type="radio" name="prodStatus" checked="@(_statusFilter == false)" />
                        <span>Đã ngừng sử dụng</span>
                        <span class="tf-filter-count">@(_items?.Count(p => !p.IsActive) ?? 0)</span>
                    </label>
                </div>
            </div>
        </FilterSidebar>
    </div>

    @* Right Main Table Container *@
    <div class="tf-product-main">
        <div class="tf-card">
            <div class="tf-card-body" style="padding: 0;">
                @* Bulk Action Bar *@
                @if (_selectedItems.Count > 0)
                {
                    <div style="background: #f1f5f9; padding: 8px 16px; border-bottom: 1px solid var(--tf-border); display: flex; align-items: center; justify-content: space-between;">
                        <span style="font-size: 13px; font-weight: 600; color: #1e293b;">
                            Đã chọn <strong>@_selectedItems.Count</strong> sản phẩm
                        </span>
                        <div style="display: flex; gap: 8px;">
                            <AuthorizeView Policy="Permission:Products:Delete">
                                <button type="button" class="tf-btn tf-btn-sm tf-btn-danger" @onclick="ConfirmBulkDelete">
                                    Xóa các mục đã chọn
                                </button>
                            </AuthorizeView>
                        </div>
                    </div>
                }

                @if (_items == null)
                {
                    <div style="padding: 20px;">
                        <Skeleton Type="table" Rows="6" Columns="8" />
                    </div>
                }
                else
                {
                    <TableLoadingOverlay IsLoading="@_isRefreshing" LoadingText="Đang cập nhật danh sách...">
                        <div style="overflow-x: auto;">
                            <table class="tf-table tf-product-table" style="width: 100%; border-collapse: collapse;">
                                <thead>
                                    <tr>
                                        <th style="width: 36px; text-align: center;">
                                            <input type="checkbox" @onchange="ToggleSelectAll" checked="@(PaginatedItems.Any() && _selectedItems.Count >= PaginatedItems.Count())" />
                                        </th>
                                        <th style="width: 52px; text-align: center;">Ảnh</th>
                                        <th style="min-width: 110px;">Mã hệ thống</th>
                                        <th style="min-width: 120px;">Mã mới</th>
                                        <th style="min-width: 100px;">Mã cũ</th>
                                        <th style="min-width: 220px;">Tên sản phẩm</th>
                                        <th style="min-width: 110px;">Loại hàng</th>
                                        <th style="width: 70px;">ĐVT</th>
                                        <th style="text-align: right; min-width: 130px;">Giá trước VAT</th>
                                        <th style="text-align: center; width: 110px;">Trạng thái</th>
                                        <th style="width: 50px; text-align: center;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!FilteredItems.Any())
                                    {
                                        <tr>
                                            <td colspan="11">
                                                <div class="tf-empty" style="padding: 40px 16px; text-align: center;">
                                                    <div class="tf-empty-title" style="color: #64748b; font-size: 14px;">Không tìm thấy sản phẩm nào phù hợp</div>
                                                    <button type="button" class="tf-link-action" style="margin-top: 8px;" @onclick="ClearAllFilters">Bỏ bộ lọc</button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var item in PaginatedItems)
                                        {
                                            bool isExpanded = _expandedProductId == item.Id;
                                            bool isEditing = _editingProductId == item.Id;
                                            var primaryImg = item.Images?.FirstOrDefault(i => i.IsActive && i.IsPrimary) 
                                                          ?? item.Images?.FirstOrDefault(i => i.IsActive);

                                            <tr class="tf-product-row @(isExpanded ? "is-expanded" : "")" @onclick="() => ToggleExpand(item.Id)">
                                                <td style="text-align: center;" @onclick:stopPropagation="true">
                                                    <input type="checkbox" @onchange="@(e => ToggleSelect(item.Id, e))" checked="@(_selectedItems.Contains(item.Id))" />
                                                </td>

                                                @* Product Thumbnail *@
                                                <td style="text-align: center; padding: 6px 8px;">
                                                    <div class="tf-product-thumb">
                                                        @if (primaryImg != null && !string.IsNullOrEmpty(primaryImg.StorageReference))
                                                        {
                                                            <img src="@FileStorage.GetPublicUrl(primaryImg.StorageReference)" alt="@item.Name" loading="lazy" />
                                                        }
                                                        else
                                                        {
                                                            <div class="tf-product-thumb-placeholder">
                                                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                                                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                                                                    <circle cx="8.5" cy="8.5" r="1.5"/>
                                                                    <polyline points="21 15 16 10 5 21"/>
                                                                </svg>
                                                            </div>
                                                        }
                                                    </div>
                                                </td>

                                                @* System Code *@
                                                <td>
                                                    <span class="tf-product-code">@item.Code</span>
                                                </td>

                                                @* New Code *@
                                                <td>
                                                    @if (!string.IsNullOrEmpty(item.NewCode))
                                                    {
                                                        <span class="tf-badge tf-badge-info" style="font-weight: 600; font-family: monospace;">@item.NewCode</span>
                                                    }
                                                    else
                                                    {
                                                        <span style="color: #94a3b8;">—</span>
                                                    }
                                                </td>

                                                @* Legacy Code *@
                                                <td>
                                                    @if (!string.IsNullOrEmpty(item.LegacyCode))
                                                    {
                                                        <span style="color: #64748b; font-family: monospace; font-size: 12px;">@item.LegacyCode</span>
                                                    }
                                                    else
                                                    {
                                                        <span style="color: #94a3b8;">—</span>
                                                    }
                                                </td>

                                                @* Product Name & Specs Summary *@
                                                <td>
                                                    <div style="font-weight: 600; color: #1e293b;">@item.Name</div>
                                                    @if (!string.IsNullOrWhiteSpace(item.Specifications))
                                                    {
                                                        <div style="font-size: 11px; color: #64748b; margin-top: 2px; max-width: 280px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@item.Specifications">
                                                            • @item.Specifications.Replace("\r\n", " • ").Replace("\n", " • ")
                                                        </div>
                                                    }
                                                </td>

                                                @* Category *@
                                                <td>
                                                    <span style="font-size: 12.5px; color: #334155;">@(item.Category?.Name ?? "—")</span>
                                                </td>

                                                @* Unit *@
                                                <td>
                                                    <span style="font-size: 12px; color: #64748b;">@(item.Unit?.Name ?? "Cái")</span>
                                                </td>

                                                @* Pre-VAT Price *@
                                                <td style="text-align: right;">
                                                    @if (_currentPrices.TryGetValue(item.Id, out var cp) && cp.HasValue && cp.Value > 0)
                                                    {
                                                        <div style="font-weight: 700; color: #047857; font-size: 13.5px;">@cp.Value.ToString("N0") ₫</div>
                                                    }
                                                    else
                                                    {
                                                        <span style="color: #94a3b8; font-size: 12px;">Chưa có giá</span>
                                                    }
                                                </td>

                                                @* Status *@
                                                <td style="text-align: center;">
                                                    @if (item.IsActive)
                                                    {
                                                        <span class="tf-badge tf-badge-success" style="font-size: 11px; padding: 2px 8px;">Hoạt động</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="tf-badge tf-badge-secondary" style="font-size: 11px; padding: 2px 8px;">Ngừng dùng</span>
                                                    }
                                                </td>

                                                @* Toggle Arrow Icon *@
                                                <td style="text-align: center;" @onclick:stopPropagation="true">
                                                    <button type="button" class="tf-btn-icon" style="background: none; border: none; cursor: pointer; color: #64748b; padding: 4px;" title="Chi tiết sản phẩm" @onclick="() => ToggleExpand(item.Id)">
                                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="transform:@(isExpanded ? "rotate(180deg)" : "rotate(0deg)"); transition:transform 0.2s;">
                                                            <polyline points="6 9 12 15 18 9"/>
                                                        </svg>
                                                    </button>
                                                </td>
                                            </tr>

                                            @* INLINE EXPANDED ROW (KiotViet & Employee Experience Unified) *@
                                            @if (isExpanded)
                                            {
                                                <tr class="tf-product-detail-tr">
                                                    <td colspan="11" style="padding: 0; background-color: #f8fafc; border-bottom: 2px solid #3b82f6;">
                                                        <div class="tf-product-expanded-box">
                                                            @* Expanded Header Bar *@
                                                            <div class="tf-product-expanded-header">
                                                                <div style="display: flex; align-items: center; gap: 14px;">
                                                                    <div style="width: 48px; height: 48px; border-radius: 8px; border: 1px solid #e2e8f0; background: #ffffff; display: flex; align-items: center; justify-content: center; overflow: hidden; flex-shrink: 0;">
                                                                        @if (primaryImg != null && !string.IsNullOrEmpty(primaryImg.StorageReference))
                                                                        {
                                                                            <img src="@FileStorage.GetPublicUrl(primaryImg.StorageReference)" alt="" style="width: 100%; height: 100%; object-fit: contain;" />
                                                                        }
                                                                        else
                                                                        {
                                                                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.8">
                                                                                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                                                                                <circle cx="8.5" cy="8.5" r="1.5"/>
                                                                                <polyline points="21 15 16 10 5 21"/>
                                                                            </svg>
                                                                        }
                                                                    </div>
                                                                    <div>
                                                                        <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                                                                            <h3 style="margin: 0; font-size: 17px; font-weight: 700; color: #0f172a;">@item.Name</h3>
                                                                            <span class="tf-product-code" style="font-size: 13px; background: #e0f2fe; padding: 2px 8px; border-radius: 4px;">@item.Code</span>
                                                                            @if (!string.IsNullOrEmpty(item.NewCode))
                                                                            {
                                                                                <span class="tf-badge tf-badge-info" style="font-size: 12px;">Mã mới: @item.NewCode</span>
                                                                            }
                                                                            @if (item.IsActive)
                                                                            {
                                                                                <span class="tf-badge tf-badge-success" style="font-size: 11px;">Đang hoạt động</span>
                                                                            }
                                                                            else
                                                                            {
                                                                                <span class="tf-badge tf-badge-neutral" style="font-size: 11px;">Đã ngừng sử dụng</span>
                                                                            }
                                                                        </div>
                                                                        <div style="font-size: 12.5px; color: #64748b; margin-top: 3px;">
                                                                            Danh mục: <strong>@(item.Category?.Name ?? "Chưa phân loại")</strong> • Đơn vị tính: <strong>@(item.Unit?.Name ?? "Cái")</strong>
                                                                        </div>
                                                                    </div>
                                                                </div>

                                                                @* Expanded Header Action Buttons *@
                                                                <div style="display: flex; align-items: center; gap: 8px;">
                                                                    @if (isEditing)
                                                                    {
                                                                        <button type="button" class="tf-btn tf-btn-ghost tf-btn-sm" @onclick="CancelInlineEdit" disabled="@_isSavingInline">
                                                                            Hủy
                                                                        </button>
                                                                        <LoadingButton Class="tf-btn tf-btn-primary tf-btn-sm" IsLoading="@_isSavingInline" LoadingText="Đang lưu..." OnClick="() => SaveInlineEditAsync(item)">
                                                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 4px;">
                                                                                <polyline points="20 6 9 17 4 12"/>
                                                                            </svg>
                                                                            <span>Lưu thay đổi</span>
                                                                        </LoadingButton>
                                                                    }
                                                                    else
                                                                    {
                                                                        <AuthorizeView Policy="Permission:Products:Edit">
                                                                            <button type="button" class="tf-btn tf-btn-outline-secondary tf-btn-sm" @onclick="() => StartInlineEdit(item)" style="display: inline-flex; align-items: center; gap: 4px;">
                                                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                                                    <path d="M12 20h9"/>
                                                                                    <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
                                                                                </svg>
                                                                                <span>Chỉnh sửa</span>
                                                                            </button>
                                                                        </AuthorizeView>

                                                                        <AuthorizeView Policy="Permission:Products:Edit">
                                                                            <button type="button" class="tf-btn @(item.IsActive ? "tf-btn-outline-danger" : "tf-btn-outline-success") tf-btn-sm" @onclick="() => ToggleProductStatusAsync(item)" style="display: inline-flex; align-items: center; gap: 4px;">
                                                                                @if (item.IsActive)
                                                                                {
                                                                                    <span>Ngừng dùng</span>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <span>Kích hoạt lại</span>
                                                                                }
                                                                            </button>
                                                                        </AuthorizeView>

                                                                        <button type="button" class="tf-btn tf-btn-ghost tf-btn-sm" @onclick="() => ToggleExpand(item.Id)">
                                                                            Đóng
                                                                        </button>
                                                                    }
                                                                </div>
                                                            </div>

                                                            @* INLINE VIEW VS EDIT SWITCH *@
                                                            @if (isEditing && _inlineEditModel != null)
                                                            {
                                                                @* INLINE EDIT FORM (3 COLUMNS) *@
                                                                <div class="tf-product-detail-grid">
                                                                    @* Col 1: Image & Upload *@
                                                                    <div class="tf-product-img-box">
                                                                        <div class="tf-product-img-main">
                                                                            @if (_inlineEditImages != null && _inlineEditImages.Any(i => i.IsActive && i.IsPrimary))
                                                                            {
                                                                                var curImg = _inlineEditImages.First(i => i.IsActive && i.IsPrimary);
                                                                                <img src="@FileStorage.GetPublicUrl(curImg.StorageReference)" alt="" />
                                                                            }
                                                                            else
                                                                            {
                                                                                <div style="color: #94a3b8; font-size: 13px; text-align: center; padding: 12px;">Chưa có ảnh</div>
                                                                            }
                                                                        </div>

                                                                        <label class="tf-btn tf-btn-sm tf-btn-outline-secondary" style="cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
                                                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                                                                                <polyline points="17 8 12 3 7 8"/>
                                                                                <line x1="12" y1="3" x2="12" y2="15"/>
                                                                            </svg>
                                                                            <span>Thay ảnh mới...</span>
                                                                            <InputFile OnChange="e => HandleInlineImageUpload(item.Id, e)" accept="image/*" style="display:none;" />
                                                                        </label>
                                                                        @if (_isUploadingInlineImage)
                                                                        {
                                                                            <span style="font-size: 11px; color: #2563eb;">Đang tải ảnh...</span>
                                                                        }
                                                                    </div>

                                                                    @* Col 2: Identification & Category Edit *@
                                                                    <div style="background: #ffffff; padding: 16px; border-radius: 8px; border: 1px solid #e2e8f0; display: flex; flex-direction: column; gap: 10px;">
                                                                        <div style="font-size: 12px; font-weight: 700; color: #475569; text-transform: uppercase; border-bottom: 1px solid #f1f5f9; padding-bottom: 6px;">
                                                                            Thông tin sản phẩm &amp; Mã
                                                                        </div>
                                                                        <div>
                                                                            <label class="tf-label" style="font-size: 12px;">Tên sản phẩm *</label>
                                                                            <input type="text" class="tf-input" style="height: 34px; font-size: 13px;" @bind="_inlineEditModel.Name" />
                                                                        </div>
                                                                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                                                                            <div>
                                                                                <label class="tf-label" style="font-size: 12px;">Mã hàng mới</label>
                                                                                <input type="text" class="tf-input" style="height: 34px; font-size: 13px;" @bind="_inlineEditModel.NewCode" placeholder="vd: TL2138" />
                                                                            </div>
                                                                            <div>
                                                                                <label class="tf-label" style="font-size: 12px;">Mã hàng cũ</label>
                                                                                <input type="text" class="tf-input" style="height: 34px; font-size: 13px;" @bind="_inlineEditModel.LegacyCode" placeholder="vd: TL2138" />
                                                                            </div>
                                                                        </div>
                                                                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                                                                            <div>
                                                                                <label class="tf-label" style="font-size: 12px;">Loại hàng</label>
                                                                                <select class="tf-input" style="height: 34px; font-size: 13px;" @bind="_inlineEditModel.CategoryId">
                                                                                    <option value="">-- Chọn danh mục --</option>
                                                                                    @if (_categories != null)
                                                                                    {
