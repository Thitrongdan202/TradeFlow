@page "/danh-muc/san-pham"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Domain.Entities.MasterData
@using TradeFlow.Infrastructure.Persistence
@attribute [Authorize(Policy = "Permission:Products:View")]

@inject TradeFlowDbContext DbContext
@inject IPriceListService PriceListService
@inject NavigationManager Nav
@inject IAuthorizationService AuthService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject IAuditService AuditService

<PageTitle>Sản phẩm - TradeFlow</PageTitle>

<div class="tf-page-header">
    <div class="tf-page-header-left">
        <h1 class="tf-page-title">Sản phẩm</h1>
        <p class="tf-page-subtitle">Danh mục sản phẩm, quy cách và đơn vị tính</p>
    </div>
    <div class="tf-page-actions">
        <AuthorizeView Policy="Permission:Products:Create">
            <a href="/danh-muc/san-pham/them-moi" class="tf-btn tf-btn-primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                Thêm sản phẩm
            </a>
        </AuthorizeView>
    </div>
</div>

@if (!string.IsNullOrEmpty(_toastMessage))
{
    <div class="tf-alert tf-alert-info tf-mb-4" style="background:#eff6ff; border:1px solid #bfdbfe; color:#1e40af; display:flex; justify-content:space-between; align-items:center; padding: 12px 16px; border-radius: 6px; margin-bottom: 16px;">
        <span>@_toastMessage</span>
        <button type="button" style="background:none; border:none; color:#1e40af; cursor:pointer; font-weight:bold;" @onclick="() => _toastMessage = null">✕</button>
    </div>
}

<div class="tf-card tf-mb-4" style="padding: 12px 16px;">
    <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
        <div style="flex: 1; min-width: 260px; position: relative;">
            <input type="text"
                   class="tf-input"
                   placeholder="Tìm theo mã hệ thống, mã mới, mã cũ, tên sản phẩm..."
                   value="@_searchTerm"
                   @oninput="OnSearchInput" />
        </div>
        <div style="width: 200px;">
            <select class="tf-select" @onchange="OnCategoryFilterChanged">
                <option value="">-- Tất cả danh mục --</option>
                @if (_categories != null)
                {
                    @foreach (var c in _categories)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                }
            </select>
        </div>
        <div style="width: 170px;">
            <select class="tf-select" @onchange="OnStatusFilterChanged">
                <option value="">-- Tất cả trạng thái --</option>
                <option value="true">Đang hoạt động</option>
                <option value="false">Tạm dừng</option>
            </select>
        </div>
    </div>
</div>

<div class="tf-card">
    <div class="tf-card-body" style="padding: 0;">
        @if (_selectedItems.Count > 0)
        {
            <div style="background: var(--tf-gray-50); padding: 10px 16px; border-bottom: 1px solid var(--tf-border); display: flex; align-items: center; justify-content: space-between;">
                <span style="font-size: 13px; font-weight: 500;">Đã chọn <strong>@_selectedItems.Count</strong> sản phẩm</span>
                <AuthorizeView Policy="Permission:Products:Delete">
                    <button type="button" class="tf-btn tf-btn-sm tf-btn-danger" @onclick="ConfirmBulkDelete">
                        Xóa các mục đã chọn
                    </button>
                </AuthorizeView>
            </div>
        }

@if (_showBulkDeleteModal)
{
    <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center;">
        <div style="background: white; padding: 24px; border-radius: 8px; width: 440px; max-width: 90%; box-shadow: 0 10px 25px rgba(0,0,0,0.2);">
            <h3 style="margin-top: 0; margin-bottom: 16px; font-size: 18px; color: var(--tf-danger);">Xóa sản phẩm đã chọn?</h3>
            <p style="margin-bottom: 16px;">Bạn có chắc chắn muốn xóa <strong>@_selectedItems.Count</strong> sản phẩm đã chọn?</p>
            @if (_bulkDeleteErrors.Any())
            {
                <div class="tf-alert tf-alert-danger" style="margin-bottom: 16px; max-height: 150px; overflow-y: auto;">
                    <ul style="margin: 0; padding-left: 20px;">
                        @foreach (var err in _bulkDeleteErrors)
                        {
                            <li>@err</li>
                        }
                    </ul>
                </div>
            }
            <div style="display: flex; justify-content: flex-end; gap: 12px;">
                <button type="button" class="tf-btn tf-btn-outline-secondary" @onclick="CancelBulkDelete">Hủy</button>
                <button type="button" class="tf-btn tf-btn-danger" @onclick="ExecuteBulkDelete" disabled="@_isBulkDeleting">
                    @(_isBulkDeleting ? "Đang xử lý..." : "Xóa tất cả")
                </button>
            </div>
        </div>
    </div>
}

<table class="tf-table">
            <thead>
                  <tr>
                      <th style="width: 40px; text-align: center;"><input type="checkbox" @onchange="ToggleSelectAll" checked="@(FilteredItems.Any() && _selectedItems.Count == FilteredItems.Count())" /></th>
                    <th style="min-width: 120px;">Mã hệ thống</th>
                    <th style="min-width: 110px;">Mã hàng mới</th>
                    <th style="min-width: 110px;">Mã hàng cũ</th>
                    <th style="min-width: 220px;">Tên sản phẩm</th>
                    <th>Danh mục</th>
                    <th>Đơn vị tính</th>
                    <th style="text-align:right; min-width: 130px;">
                        <div>Giá trước VAT</div>
                        <div style="font-size:10px; color:var(--tf-text-muted); font-weight:normal;">Giá hiện tại</div>
                    </th>
                    <th style="text-align:center;">Trạng thái</th>
                    <th style="text-align:right;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (_items == null)
                {
                    <tr><td colspan="10" style="text-align:center; padding: 24px;">Đang tải dữ liệu...</td></tr>
                }
                else if (!FilteredItems.Any())
                {
                    <tr><td colspan="10"><div class="tf-empty"><div class="tf-empty-title">Chưa có sản phẩm phù hợp</div></div></td></tr>
                }
                else
                {
                    foreach (var item in FilteredItems)
                    {
                        <tr>
                              <td style="text-align: center;"><input type="checkbox" @onchange="@(e => ToggleSelect(item.Id, e))" checked="@(_selectedItems.Contains(item.Id))" /></td>
                            <td>
                                <span style="font-family: monospace; font-weight: 600; color: var(--tf-primary);">@item.Code</span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.NewCode))
                                {
                                    <span class="tf-badge tf-badge-info" style="font-weight: 600;">@item.NewCode</span>
                                }
                                else
                                {
                                    <span style="color:var(--tf-text-muted);">-</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.LegacyCode))
                                {
                                    <span style="color:var(--tf-text-secondary); font-family: monospace;">@item.LegacyCode</span>
                                }
                                else
                                {
                                    <span style="color:var(--tf-text-muted);">-</span>
                                }
                            </td>
                            <td style="font-weight: 500;">
                                <div>@item.Name</div>
                                @if (!string.IsNullOrWhiteSpace(item.Specifications))
                                {
                                    <div style="font-size: 11px; color: var(--tf-text-muted); margin-top: 2px; line-height: 1.3; max-width: 320px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@item.Specifications">
                                        • @item.Specifications.Replace("\r\n", " • ").Replace("\n", " • ")
                                    </div>
                                }
                                else if (!string.IsNullOrWhiteSpace(item.Description))
                                {
                                    <div style="font-size: 11px; color: var(--tf-text-muted); margin-top: 2px; line-height: 1.3; max-width: 320px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@item.Description">
                                        • @item.Description.Replace("\r\n", " • ").Replace("\n", " • ")
                                    </div>
                                }
                            </td>
                            <td>@(item.Category?.Name ?? "-")</td>
                            <td>@(item.Unit?.Name ?? "-")</td>
                            <td style="text-align:right;">
                                @if (_currentPrices.TryGetValue(item.Id, out var cp) && cp.HasValue && cp.Value > 0)
                                {
                                    <div style="font-weight: 700; color: #047857;">@cp.Value.ToString("N0") ₫</div>
                                    <div style="font-size:10px; color:var(--tf-text-muted);">Giá trước VAT</div>
                                }
                                else
                                {
                                    <span style="color:var(--tf-text-muted); font-size:12px;">Chưa có giá</span>
                                }
                            </td>
                            <td style="text-align:center;">
                                @if (item.IsActive)
                                {
                                    <span class="tf-badge tf-badge-success">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="tf-badge tf-badge-neutral">Đã ngừng sử dụng</span>
                                }
                            </td>
                            <td style="text-align:right;">
                                <AuthorizeView Policy="Permission:Products:Edit">
                                    <a href="/danh-muc/san-pham/sua/@item.Id" class="tf-btn tf-btn-ghost tf-btn-sm">Sửa</a>
                                </AuthorizeView>
                                <AuthorizeView Policy="Permission:Products:Delete">
                                    <button class="tf-btn tf-btn-ghost tf-btn-sm" style="color:var(--tf-danger);" @onclick="() => ConfirmDelete(item.Id, item.Name ?? string.Empty)">Xóa</button>
                                </AuthorizeView>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>


@if (_itemToDeleteId != null)
{
    <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center;">
        <div style="background: white; padding: 24px; border-radius: 8px; width: 400px; max-width: 90%; box-shadow: 0 10px 25px rgba(0,0,0,0.2);">
            <h3 style="margin-top: 0; margin-bottom: 16px; font-size: 18px; color: var(--tf-danger);">Xóa dữ liệu?</h3>
            <p style="margin-bottom: 24px;">Bạn có chắc chắn muốn xóa @_itemToDeleteName?</p>
            @if (!string.IsNullOrEmpty(_deleteError))
            {
                <div class="tf-alert tf-alert-danger" style="margin-bottom: 16px;">
                    @_deleteError
                </div>
            }
            <div style="display: flex; justify-content: flex-end; gap: 12px;">
                <button type="button" class="tf-btn tf-btn-outline-secondary" @onclick="CancelDelete">Hủy</button>
                <button type="button" class="tf-btn tf-btn-danger" @onclick="ExecuteDelete">Xóa</button>
            </div>
        </div>
    </div>
}

@code {
    private int? _itemToDeleteId;
    private string _itemToDeleteName = "";
    private string? _deleteError;
    private string? _toastMessage;

    private List<Product>? _items;
    private Dictionary<int, decimal?> _currentPrices = new();
    private List<ProductCategory>? _categories;
    private string _searchTerm = string.Empty;
    private int? _selectedCategoryId;
    private bool? _statusFilter;

    protected override async Task OnInitializedAsync()
    {
        _categories = await DbContext.ProductCategories.Where(c => c.IsActive).OrderBy(c => c.Name).ToListAsync();
        await LoadProductsAsync();
    }

    private async Task LoadProductsAsync()
    {
        _items = await DbContext.Products
            .Include(p => p.Category)
            .Include(p => p.Unit)
            .OrderBy(x => x.Code)
            .ToListAsync();

        if (_items.Any())
        {
            _currentPrices = await PriceListService.GetCurrentPricesForProductsAsync(_items.Select(x => x.Id));
        }
        else
        {
            _currentPrices.Clear();
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? string.Empty;
    }

    private void OnCategoryFilterChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var catId))
        {
            _selectedCategoryId = catId;
        }
        else
        {
            _selectedCategoryId = null;
        }
    }

    private void OnStatusFilterChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (bool.TryParse(val, out var status))
        {
            _statusFilter = status;
        }
        else
        {
            _statusFilter = null;
        }
    }

    private IEnumerable<Product> FilteredItems
    {
        get
        {
            if (_items == null) return Enumerable.Empty<Product>();

            var q = _items.AsEnumerable();

            if (_selectedCategoryId.HasValue)
            {
                q = q.Where(x => x.CategoryId == _selectedCategoryId.Value);
            }

            if (_statusFilter.HasValue)
            {
                q = q.Where(x => x.IsActive == _statusFilter.Value);
            }

            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                var term = _searchTerm.Trim().ToLower();
                q = q.Where(x =>
                    (x.Code != null && x.Code.ToLower().Contains(term)) ||
                    (x.NewCode != null && x.NewCode.ToLower().Contains(term)) ||
                    (x.LegacyCode != null && x.LegacyCode.ToLower().Contains(term)) ||
                    (x.Name != null && x.Name.ToLower().Contains(term)) ||
                    (x.ShortName != null && x.ShortName.ToLower().Contains(term)));
            }

            return q;
        }
    }

    private void ConfirmDelete(int id, string name)
    {
        _itemToDeleteId = id;
        _itemToDeleteName = name;
        _deleteError = null;
    }

    private void CancelDelete()
    {
        _itemToDeleteId = null;
        _deleteError = null;
    }

    private async Task ExecuteDelete()
    {
        if (_itemToDeleteId == null) return;
        
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!(await AuthService.AuthorizeAsync(authState.User, "Permission:Products:Delete")).Succeeded)
        {
            _deleteError = "Bạn không có quyền thực hiện thao tác này.";
            return;
        }

        try
        {
            int id = _itemToDeleteId.Value;
            var entity = await DbContext.Products.FindAsync(id);
            if (entity == null)
            {
                CancelDelete();
                return;
            }

            bool isUsedInBusiness = await DbContext.SalesOrderItems.AnyAsync(x => x.ProductId == id) 
                                 || await DbContext.InvoiceItems.AnyAsync(x => x.ProductId == id);

            if (isUsedInBusiness)
            {
                entity.IsActive = false;
                entity.UpdatedAt = DateTime.UtcNow;
                entity.UpdatedBy = authState.User.Identity?.Name;
                DbContext.Products.Update(entity);
                await DbContext.SaveChangesAsync();
                await AuditService.LogAsync(TradeFlow.Domain.Enums.AuditEventType.ProductUpdated, authState.User.Identity?.Name ?? "System", "Product", id.ToString(), "Ngừng sử dụng sản phẩm do đã phát sinh chứng từ nghiệp vụ", authState.User.Identity?.Name);
                _toastMessage = "Sản phẩm đã được sử dụng trong dữ liệu nghiệp vụ nên không thể xóa vật lý. Sản phẩm đã được ngừng sử dụng.";
            }
            else
            {
                var priceListItems = await DbContext.PriceListItems.Where(x => x.ProductId == id).ToListAsync();
                foreach (var pli in priceListItems)
                {
                    pli.ProductId = null;
                }

                DbContext.Products.Remove(entity);
                await DbContext.SaveChangesAsync();
                await AuditService.LogAsync(TradeFlow.Domain.Enums.AuditEventType.ProductDeleted, authState.User.Identity?.Name ?? "System", "Product", id.ToString(), "Xóa vật lý sản phẩm", authState.User.Identity?.Name);
                _toastMessage = "Đã xóa sản phẩm thành công.";
            }

            CancelDelete();
            await OnInitializedAsync();
        }
        catch (Exception ex)
        {
            _deleteError = "Đã xảy ra lỗi: " + ex.Message;
        }
    }

    private HashSet<int> _selectedItems = new();
    private bool _showBulkDeleteModal = false;
    private List<string> _bulkDeleteErrors = new();
    private bool _isBulkDeleting = false;

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        if (e.Value is bool isChecked && isChecked)
        {
            _selectedItems = new HashSet<int>(FilteredItems.Select(x => x.Id));
        }
        else
        {
            _selectedItems.Clear();
        }
    }

    private void ToggleSelect(int id, ChangeEventArgs e)
    {
        if (e.Value is bool isChecked && isChecked)
        {
            _selectedItems.Add(id);
        }
        else
        {
            _selectedItems.Remove(id);
        }
    }

    private void ConfirmBulkDelete()
    {
        _bulkDeleteErrors.Clear();
        _showBulkDeleteModal = true;
    }

    private void CancelBulkDelete()
    {
        _showBulkDeleteModal = false;
        _isBulkDeleting = false;
    }

    private async Task ExecuteBulkDelete()
    {
        if (_selectedItems.Count == 0) return;
        _isBulkDeleting = true;
        _bulkDeleteErrors.Clear();
        StateHasChanged();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!(await AuthService.AuthorizeAsync(authState.User, "Permission:Products:Delete")).Succeeded)
        {
            _bulkDeleteErrors.Add("Bạn không có quyền thực hiện thao tác này.");
            _isBulkDeleting = false;
            return;
        }

        try
        {
            int successCount = 0;
            var idsToProcess = _selectedItems.ToList();
            
            foreach (var id in idsToProcess)
            {
                _itemToDeleteId = id; // reuse the id for the logic block
                try 
                {
                    await ProcessSingleDelete(id);
                    _selectedItems.Remove(id);
                    successCount++;
                } 
                catch (Exception ex)
                {
                    _bulkDeleteErrors.Add($"Bản ghi ID {id}: {ex.Message}");
                }
            }

            if (successCount > 0)
            {
                await OnInitializedAsync();
            }
            
            if (_selectedItems.Count == 0)
            {
                CancelBulkDelete();
            }
        }
        finally
        {
            _isBulkDeleting = false;
            _itemToDeleteId = null;
            StateHasChanged();
        }
    }

    private async Task ProcessSingleDelete(int currentId)
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        int id = currentId;
        var entity = await DbContext.Products.FindAsync(id);
        if (entity == null) return;

        bool isUsedInBusiness = await DbContext.SalesOrderItems.AnyAsync(x => x.ProductId == id) 
                             || await DbContext.InvoiceItems.AnyAsync(x => x.ProductId == id);

        if (isUsedInBusiness)
        {
            entity.IsActive = false;
            entity.UpdatedAt = DateTime.UtcNow;
            entity.UpdatedBy = authState.User.Identity?.Name;
            DbContext.Products.Update(entity);
            await DbContext.SaveChangesAsync();
            await AuditService.LogAsync(TradeFlow.Domain.Enums.AuditEventType.ProductUpdated, authState.User.Identity?.Name ?? "System", "Product", id.ToString(), "Ngừng sử dụng sản phẩm do đã phát sinh chứng từ nghiệp vụ", authState.User.Identity?.Name);
            _toastMessage = "Sản phẩm đã được sử dụng trong dữ liệu nghiệp vụ nên không thể xóa vật lý. Sản phẩm đã được ngừng sử dụng.";
        }
        else
        {
            var priceListItems = await DbContext.PriceListItems.Where(x => x.ProductId == id).ToListAsync();
            foreach (var pli in priceListItems)
            {
                pli.ProductId = null;
            }

            DbContext.Products.Remove(entity);
            await DbContext.SaveChangesAsync();
            await AuditService.LogAsync(TradeFlow.Domain.Enums.AuditEventType.ProductDeleted, authState.User.Identity?.Name ?? "System", "Product", id.ToString(), "Xóa vật lý sản phẩm", authState.User.Identity?.Name);
        }
    }
}
