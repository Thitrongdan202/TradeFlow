@* Modal: Bulk Delete Confirmation *@
@if (_showBulkDeleteModal)
{
    <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 1050; display: flex; align-items: center; justify-content: center; padding: 16px;">
        <div style="background: var(--tf-surface-card, #ffffff); color: var(--tf-text-primary, #0f172a); border: 1px solid var(--tf-border, #e2e8f0); padding: 24px; border-radius: 10px; width: 440px; max-width: 95%; box-shadow: 0 10px 25px rgba(0,0,0,0.2);">
            <h3 style="margin: 0 0 14px; font-size: 18px; color: var(--tf-danger);">Xóa sản phẩm đã chọn?</h3>
            <p style="margin-bottom: 16px; font-size: 13.5px; color: var(--tf-text-secondary, #334155);">
                Bạn có chắc chắn muốn xóa <strong>@_selectedItems.Count</strong> sản phẩm đã chọn?
            </p>
            @if (_bulkDeleteErrors.Any())
            {
                <div class="tf-alert tf-alert-error" style="margin-bottom: 16px; max-height: 140px; overflow-y: auto; font-size: 12px;">
                    <ul style="margin: 0; padding-left: 18px;">
                        @foreach (var err in _bulkDeleteErrors)
                        {
                            <li>@err</li>
                        }
                    </ul>
                </div>
            }
            <div style="display: flex; justify-content: flex-end; gap: 10px;">
                <button type="button" class="tf-btn tf-btn-secondary" @onclick="CancelBulkDelete">Hủy</button>
                <LoadingButton Class="tf-btn tf-btn-danger" IsLoading="@_isBulkDeleting" LoadingText="Đang xử lý..." OnClick="ExecuteBulkDelete">
                    Xóa tất cả
                </LoadingButton>
            </div>
        </div>
    </div>
}
@* Modal: Single Product Delete Confirmation *@
@if (_showSingleDeleteModal && _productToDelete != null)
{
    <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 1050; display: flex; align-items: center; justify-content: center; padding: 16px;">
        <div style="background: var(--tf-surface-card, #ffffff); color: var(--tf-text-primary, #0f172a); border: 1px solid var(--tf-border, #e2e8f0); padding: 24px; border-radius: 10px; width: 480px; max-width: 95%; box-shadow: 0 10px 25px rgba(0,0,0,0.2);">
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 14px;">
                <div style="width: 36px; height: 36px; border-radius: 50%; background: #fee2e2; color: #dc2626; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="3 6 5 6 21 6"/>
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                    </svg>
                </div>
                <h3 style="margin: 0; font-size: 18px; color: var(--tf-text-primary, #1e293b);">Xác nhận xóa sản phẩm</h3>
            </div>

            <p style="margin: 0 0 12px; font-size: 14px; color: var(--tf-text-secondary, #334155); line-height: 1.5;">
                Bạn có chắc chắn muốn xóa vĩnh viễn sản phẩm <strong>@_productToDelete.Name</strong> (Mã: <code>@_productToDelete.Code</code>@(!string.IsNullOrEmpty(_productToDelete.NewCode) ? $", Mã mới: {_productToDelete.NewCode}" : ""))?
            </p>

            <div style="background: var(--tf-surface-subtle, #f8fafc); border: 1px solid var(--tf-border, #e2e8f0); border-radius: 6px; padding: 10px 12px; font-size: 12.5px; color: var(--tf-text-secondary, #475569); margin-bottom: 16px; line-height: 1.4;">
                <strong style="color: var(--tf-text-primary, #0f172a);">Chính sách an toàn dữ liệu:</strong> Thao tác xóa vĩnh viễn chỉ áp dụng cho sản phẩm đã ngừng dùng và chưa từng phát sinh chứng từ kế toán lịch sử (đơn hàng, hóa đơn hoặc báo giá). Nếu đã có chứng từ, hệ thống sẽ ngăn chặn việc xóa vật lý để bảo vệ toàn vẹn lịch sử.
            </div>

            @if (!string.IsNullOrEmpty(_singleDeleteError))
            {
                <div class="tf-alert tf-alert-error" style="margin-bottom: 16px; font-size: 13px;">
                    @_singleDeleteError
                </div>
            }

            <div style="display: flex; justify-content: flex-end; gap: 10px;">
                <button type="button" class="tf-btn tf-btn-secondary" @onclick="CancelSingleDelete" disabled="@_isDeletingSingle">Hủy</button>
                <LoadingButton Class="tf-btn tf-btn-danger" IsLoading="@_isDeletingSingle" LoadingText="Đang xóa..." OnClick="ExecuteSingleDeleteAsync">
                    Xác nhận xóa
                </LoadingButton>
            </div>
        </div>
    </div>
}

@* Fullscreen Image Preview Lightbox Modal *@
@if (!string.IsNullOrEmpty(_previewImageUrl))
{
    <div class="tf-img-lightbox-backdrop" @onclick="CloseImagePreview">
        <div class="tf-img-lightbox-dialog" @onclick:stopPropagation="true">
            <div class="tf-img-lightbox-header">
                <div class="tf-img-lightbox-title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px;">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                        <circle cx="8.5" cy="8.5" r="1.5"/>
                        <polyline points="21 15 16 10 5 21"/>
                    </svg>
                    <span>@(_previewImageTitle ?? "Chi tiết ảnh sản phẩm")</span>
                </div>
                <button type="button" class="tf-modal-btn-close" @onclick="CloseImagePreview" aria-label="Đóng">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="6" x2="6" y2="18"/>
                        <line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                </button>
            </div>
            <div class="tf-img-lightbox-body">
                <img src="@_previewImageUrl" alt="@_previewImageTitle" />
            </div>
            <div class="tf-img-lightbox-footer">
                <a href="@_previewImageUrl" target="_blank" rel="noopener noreferrer" class="tf-btn tf-btn-outline-secondary tf-btn-sm" style="display: inline-flex; align-items: center; gap: 6px;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                        <polyline points="15 3 21 3 21 9"/>
                        <line x1="10" y1="14" x2="21" y2="3"/>
                    </svg>
                    <span>Mở tab mới</span>
                </a>
                <button type="button" class="tf-btn tf-btn-primary tf-btn-sm" @onclick="CloseImagePreview">
                    Đóng
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<Product>? _items;
    private Dictionary<int, decimal?> _currentPrices = new();
    private List<ProductCategory>? _categories;
    private List<UnitOfMeasure>? _units;

    // Image Stage and Lightbox State
    private Dictionary<int, string> _activeImageByProductId = new();
    private string? _previewImageUrl;
    private string? _previewImageTitle;

    private string? GetActiveImageReference(Product item, ProductImage? primaryImg)
    {
        if (_activeImageByProductId.TryGetValue(item.Id, out var activeRef) && !string.IsNullOrEmpty(activeRef))
        {
            return activeRef;
        }
        return primaryImg?.StorageReference;
    }

    private void OpenImagePreview(string? url, string? title)
    {
        if (!string.IsNullOrEmpty(url))
        {
            _previewImageUrl = url;
            _previewImageTitle = title;
        }
    }

    private bool HasValidImage(ProductImage? img) => img != null && !string.IsNullOrEmpty(img.StorageReference) && !img.StorageReference.Contains("dummy_ref");

    private void TryPreviewImage(ProductImage? img, string title)
    {
        if (HasValidImage(img))
        {
            OpenImagePreview(FileStorage.GetPublicUrl(img!.StorageReference), title);
        }
    }

    private void CloseImagePreview()
    {
        _previewImageUrl = null;
        _previewImageTitle = null;
    }

    private string _searchTerm = string.Empty;
    private string _categorySearchTerm = string.Empty;
    private int? _selectedCategoryId;
    private bool? _statusFilter;

    private int _pageSize = 20;
    private int _currentPage = 1;

    private int? _expandedProductId;
    private int? _editingProductId;
    private ProductInlineEditModel? _inlineEditModel;
    private List<ProductImage>? _inlineEditImages;
    private bool _isSavingInline;
    private bool _isUploadingInlineImage;

    private bool _isRefreshing;
    private string? _toastMessage;

    // Excel import modal state
    private bool _showExcelImportModal;

    // In-place Product Modal state
    private bool _showProductModal;
    private int? _selectedProductEditId;

    private void OpenCreateProductModal()
    {
        _selectedProductEditId = null;
        _showProductModal = true;
    }

    private void OpenEditProductModal(int id)
    {
        _selectedProductEditId = id;
        _showProductModal = true;
    }

    private async Task HandleProductSaved(Product p)
    {
        _toastMessage = $"Đã lưu sản phẩm '{p.Name}' ({p.Code}) thành công!";
        await LoadProductsAsync();
    }

    // Bulk selection
    private HashSet<int> _selectedItems = new();
    private bool _showBulkDeleteModal;
    private bool _isBulkDeleting;
    private List<string> _bulkDeleteErrors = new();

    private bool HasActiveFilters => !string.IsNullOrEmpty(_searchTerm) || _selectedCategoryId.HasValue || _statusFilter.HasValue;

    private IEnumerable<ProductCategory> FilteredCategoryOptions
    {
        get
        {
            if (_categories == null) return Enumerable.Empty<ProductCategory>();
            if (string.IsNullOrWhiteSpace(_categorySearchTerm)) return _categories;
            var term = _categorySearchTerm.Trim().ToLowerInvariant();
            return _categories.Where(c => c.Name.ToLowerInvariant().Contains(term));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await using (var db = await DbContextFactory.CreateDbContextAsync())
        {
            _categories = await db.ProductCategories.AsNoTracking().Where(c => c.IsActive).OrderBy(c => c.Name).ToListAsync();
            _units = await db.UnitOfMeasures.AsNoTracking().Where(u => u.IsActive).OrderBy(u => u.Name).ToListAsync();
        }
        await LoadProductsAsync();
    }

    private async Task LoadProductsAsync()
    {
        if (_isRefreshing) return;
        _isRefreshing = true;
        try
        {
            await using (var db = await DbContextFactory.CreateDbContextAsync())
            {
                _items = await db.Products
                    .AsNoTracking()
                    .Include(p => p.Category)
                    .Include(p => p.Unit)
                    .Include(p => p.Images)
                    .OrderBy(x => x.Code)
                    .ToListAsync();
            }

            if (_items.Any())
            {
                _currentPrices = await PriceListService.GetCurrentPricesForProductsAsync(_items.Select(x => x.Id));
            }
            else
            {
                _currentPrices.Clear();
            }
        }
        finally
        {
            _isRefreshing = false;
        }
    }

    private void OnSearchChanged(string val)
    {
        _searchTerm = val;
        _currentPage = 1;
    }

    private void SetCategoryFilter(int? catId)
    {
        _selectedCategoryId = catId;
        _currentPage = 1;
    }

    private void SetStatusFilter(bool? status)
    {
        _statusFilter = status;
        _currentPage = 1;
    }

    private void ClearAllFilters()
    {
        _searchTerm = string.Empty;
        _categorySearchTerm = string.Empty;
        _selectedCategoryId = null;
        _statusFilter = null;
        _currentPage = 1;
    }

    private IEnumerable<Product> FilteredItems
    {
        get
        {
            if (_items == null) return Enumerable.Empty<Product>();

            var q = _items.AsEnumerable();

            if (_selectedCategoryId.HasValue)
            {
                q = q.Where(x => x.CategoryId == _selectedCategoryId.Value);
            }

            if (_statusFilter.HasValue)
            {
                q = q.Where(x => x.IsActive == _statusFilter.Value);
            }

            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                var term = _searchTerm.Trim().ToLowerInvariant();
                q = q.Where(x =>
                    (x.Code != null && x.Code.ToLowerInvariant().Contains(term)) ||
                    (x.NewCode != null && x.NewCode.ToLowerInvariant().Contains(term)) ||
                    (x.LegacyCode != null && x.LegacyCode.ToLowerInvariant().Contains(term)) ||
                    (x.Name != null && x.Name.ToLowerInvariant().Contains(term)) ||
                    (x.ShortName != null && x.ShortName.ToLowerInvariant().Contains(term)) ||
                    (x.Specifications != null && x.Specifications.ToLowerInvariant().Contains(term)));
            }

            return q;
        }
    }

    private int TotalFilteredCount => FilteredItems.Count();
    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)TotalFilteredCount / _pageSize));

    private IEnumerable<Product> PaginatedItems
    {
        get
        {
            return FilteredItems.Skip((_currentPage - 1) * _pageSize).Take(_pageSize);
        }
    }

    private void SetPage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            _currentPage = page;
        }
    }

    private void OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int newSize) && newSize > 0)
        {
            OnNewPageSize(newSize);
        }
    }

    private void OnNewPageSize(int newSize)
    {
        if (newSize > 0)
        {
            _pageSize = newSize;
            int maxPages = TotalPages;
            if (_currentPage > maxPages)
            {
                _currentPage = Math.Max(1, maxPages);
            }
        }
    }

    private void ToggleExpand(int productId)
    {
        if (_expandedProductId == productId)
        {
            _expandedProductId = null;
            _editingProductId = null;
            _inlineEditModel = null;
        }
        else
        {
            _expandedProductId = productId;
            _editingProductId = null;
            _inlineEditModel = null;
        }
    }

    private void StartInlineEdit(Product product)
    {
        _editingProductId = product.Id;
        _currentPrices.TryGetValue(product.Id, out var curPrice);

        _inlineEditModel = new ProductInlineEditModel
        {
            Id = product.Id,
            Name = product.Name,
            NewCode = product.NewCode,
            LegacyCode = product.LegacyCode,
            ShortName = product.ShortName,
            CategoryId = product.CategoryId,
            UnitId = product.UnitId,
            UnitPrice = curPrice,
            Specifications = product.Specifications,
            Description = product.Description,
            TaxTreatment = product.TaxTreatment,
            IsTaxReductionEligible = product.IsTaxReductionEligible,
            IsActive = product.IsActive
        };

        _inlineEditImages = product.Images?.ToList() ?? new List<ProductImage>();
    }

    private void CancelInlineEdit()
    {
        _editingProductId = null;
        _inlineEditModel = null;
    }

    private async Task SaveInlineEditAsync(Product originalProduct)
    {
        if (_inlineEditModel == null) return;
        if (string.IsNullOrWhiteSpace(_inlineEditModel.Name))
        {
            _toastMessage = "Tên sản phẩm không được để trống.";
            return;
        }

        try
        {
            _isSavingInline = true;

            await using var db = await DbContextFactory.CreateDbContextAsync();
            var productToUpdate = await db.Products.FirstOrDefaultAsync(p => p.Id == originalProduct.Id);
            if (productToUpdate != null)
            {
                productToUpdate.Name = _inlineEditModel.Name;
                productToUpdate.NewCode = _inlineEditModel.NewCode;
                productToUpdate.LegacyCode = _inlineEditModel.LegacyCode;
                productToUpdate.ShortName = _inlineEditModel.ShortName;
                productToUpdate.CategoryId = _inlineEditModel.CategoryId;
                productToUpdate.UnitId = _inlineEditModel.UnitId;
                productToUpdate.Specifications = _inlineEditModel.Specifications;
                productToUpdate.Description = _inlineEditModel.Description;
                productToUpdate.UpdatedAt = DateTime.UtcNow;
                productToUpdate.UpdatedBy = CurrentUser.UserName;

                await db.SaveChangesAsync();
                await AuditService.LogAsync(AuditEventType.ProductUpdated, CurrentUser.UserName, "Product", productToUpdate.Id.ToString());

                // Update Price in active PriceList if entered
                if (_inlineEditModel.UnitPrice.HasValue && _inlineEditModel.UnitPrice.Value > 0)
                {
                    var activePriceList = await db.PriceLists
                        .OrderByDescending(p => p.Year)
                        .ThenByDescending(p => p.CreatedAt)
                        .FirstOrDefaultAsync(p => p.Status == PriceListStatus.Active);

                    if (activePriceList == null)
                    {
                        activePriceList = new PriceList
                        {
                            Code = await CodeGenerator.GenerateCodeAsync("PL"),
                            Name = $"BẢNG GIÁ HIỆN HÀNH {DateTime.UtcNow.Year}",
                            Year = DateTime.UtcNow.Year,
                            Status = PriceListStatus.Active,
                            CreatedAt = DateTime.UtcNow,
                            CreatedBy = CurrentUser.UserName
                        };
                        db.PriceLists.Add(activePriceList);
                        await db.SaveChangesAsync();
                    }

                    var priceItem = await db.PriceListItems.FirstOrDefaultAsync(i => i.PriceListId == activePriceList.Id && i.ProductId == productToUpdate.Id);
                    if (priceItem == null)
                    {
                        priceItem = new PriceListItem
                        {
                            PriceListId = activePriceList.Id,
                            ProductId = productToUpdate.Id,
                            NewCode = !string.IsNullOrWhiteSpace(productToUpdate.NewCode) ? productToUpdate.NewCode : productToUpdate.Code,
                            LegacyCode = productToUpdate.LegacyCode,
                            ProductInfo = productToUpdate.Name,
                            UnitPrice = _inlineEditModel.UnitPrice.Value,
                            VatRate = productToUpdate.TaxTreatment == TaxTreatment.Standard10 ? (productToUpdate.IsTaxReductionEligible ? 8 : 10) : 0,
                            MatchStatus = PriceMatchStatus.Matched,
                            CreatedAt = DateTime.UtcNow,
                            CreatedBy = CurrentUser.UserName
                        };
                        db.PriceListItems.Add(priceItem);
                    }
                    else
                    {
                        priceItem.UnitPrice = _inlineEditModel.UnitPrice.Value;
                        priceItem.NewCode = !string.IsNullOrWhiteSpace(productToUpdate.NewCode) ? productToUpdate.NewCode : productToUpdate.Code;
                        priceItem.LegacyCode = productToUpdate.LegacyCode;
                        priceItem.ProductInfo = productToUpdate.Name;
                        priceItem.UpdatedAt = DateTime.UtcNow;
                        priceItem.UpdatedBy = CurrentUser.UserName;
                    }
                    await db.SaveChangesAsync();
                    _currentPrices[productToUpdate.Id] = _inlineEditModel.UnitPrice.Value;
                }

                _editingProductId = null;
                _inlineEditModel = null;
                _toastMessage = "Đã lưu thay đổi sản phẩm thành công.";

                // Reload without resetting state
                await LoadProductsAsync();
            }
        }
        catch (Exception ex)
        {
            _toastMessage = "Có lỗi xảy ra: " + ex.Message;
        }
        finally
        {
            _isSavingInline = false;
        }
    }

    private async Task ToggleProductStatusAsync(Product product)
    {
        try
        {
            await using var db = await DbContextFactory.CreateDbContextAsync();
            var p = await db.Products.FirstOrDefaultAsync(x => x.Id == product.Id);
            if (p != null)
            {
                p.IsActive = !p.IsActive;
                p.UpdatedAt = DateTime.UtcNow;
                p.UpdatedBy = CurrentUser.UserName;
                await db.SaveChangesAsync();
                await AuditService.LogAsync(AuditEventType.ProductUpdated, CurrentUser.UserName, "Product", p.Id.ToString(), p.IsActive ? "Kích hoạt lại sản phẩm" : "Ngừng sử dụng sản phẩm");
                
                product.IsActive = p.IsActive;
                _toastMessage = p.IsActive ? "Đã kích hoạt lại sản phẩm." : "Đã ngừng sử dụng sản phẩm.";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            _toastMessage = "Lỗi khi cập nhật trạng thái: " + ex.Message;
        }
    }

    private async Task HandleInlineImageUpload(int productId, InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        try
        {
            _isUploadingInlineImage = true;
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            var storageRef = await FileStorage.SaveFileAsync(stream, file.Name, file.ContentType ?? "image/jpeg", "products");

            await using var db = await DbContextFactory.CreateDbContextAsync();
            // Deactivate old primary images
            var existingImages = await db.ProductImages.Where(i => i.ProductId == productId).ToListAsync();
            foreach (var img in existingImages)
            {
                img.IsPrimary = false;
            }

            var newImage = new ProductImage
            {
                ProductId = productId,
                FileName = file.Name,
                StorageReference = storageRef,
                ContentType = file.ContentType,
                FileSizeBytes = file.Size,
                IsPrimary = true,
                SortOrder = 1,
                IsActive = true,
                CreatedAt = DateTime.UtcNow,
                CreatedBy = CurrentUser.UserName
            };

            db.ProductImages.Add(newImage);
            await db.SaveChangesAsync();

            await LoadProductsAsync();
            _inlineEditImages = existingImages.Concat(new[] { newImage }).ToList();
            _toastMessage = "Đã cập nhật hình ảnh thành công.";
        }
        catch (Exception ex)
        {
            _toastMessage = "Lỗi khi tải ảnh: " + ex.Message;
        }
        finally
        {
            _isUploadingInlineImage = false;
        }
    }

    private async Task HandleImportCompleted()
    {
        _showExcelImportModal = false;
        _toastMessage = "Đã nhập dữ liệu từ Excel thành công. Danh mục sản phẩm đã được làm mới.";
        await LoadProductsAsync();
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        if ((bool)(e.Value ?? false))
        {
            foreach (var item in PaginatedItems)
            {
                _selectedItems.Add(item.Id);
            }
        }
        else
        {
            _selectedItems.Clear();
        }
    }

    private void ToggleSelect(int id, ChangeEventArgs e)
    {
        if ((bool)(e.Value ?? false))
            _selectedItems.Add(id);
        else
            _selectedItems.Remove(id);
    }

    private void ConfirmBulkDelete()
    {
        _bulkDeleteErrors.Clear();
        _showBulkDeleteModal = true;
    }

    private void CancelBulkDelete()
    {
        _showBulkDeleteModal = false;
        _bulkDeleteErrors.Clear();
    }

    // Single Product Delete State & Methods
    private Product? _productToDelete;
    private bool _showSingleDeleteModal;
    private bool _isDeletingSingle;
    private string? _singleDeleteError;

    private void ConfirmSingleDelete(Product product)
    {
        _productToDelete = product;
        _singleDeleteError = null;
        _showSingleDeleteModal = true;
    }

    private void CancelSingleDelete()
    {
        _showSingleDeleteModal = false;
        _productToDelete = null;
        _singleDeleteError = null;
    }

    private async Task ExecuteSingleDeleteAsync()
    {
        if (_productToDelete == null) return;
        _isDeletingSingle = true;
        _singleDeleteError = null;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var result = await ProductService.DeleteProductAsync(_productToDelete.Id, authState.User);
            if (result.Succeeded)
            {
                _toastMessage = $"Đã xóa vĩnh viễn sản phẩm '{_productToDelete.Name}' thành công.";
                _showSingleDeleteModal = false;
                _productToDelete = null;
                _expandedProductId = null;
                await LoadProductsAsync();
            }
            else
            {
                _singleDeleteError = result.ErrorMessage;
            }
        }
        catch (Exception ex)
        {
            _singleDeleteError = "Lỗi khi xóa sản phẩm: " + ex.Message;
        }
        finally
        {
            _isDeletingSingle = false;
        }
    }

    private async Task ExecuteBulkDelete()
    {
        _isBulkDeleting = true;
        _bulkDeleteErrors.Clear();

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (!authState.User.IsInRole("Administrator"))
            {
                _bulkDeleteErrors.Add("Chỉ Quản trị viên (Administrator) mới có quyền thực hiện thao tác xóa sản phẩm.");
                return;
            }

            var bulkResult = await ProductService.BulkDeleteProductsAsync(_selectedItems.ToList(), authState.User);
            if (bulkResult.DeletedCount > 0)
            {
                _toastMessage = $"Đã xóa vĩnh viễn {bulkResult.DeletedCount} sản phẩm ngừng dùng thành công.";
                _selectedItems.Clear();
                await LoadProductsAsync();
            }

            if (bulkResult.SkippedCount > 0)
            {
                _bulkDeleteErrors.AddRange(bulkResult.Messages);
            }
            else
            {
                _showBulkDeleteModal = false;
            }
        }
        catch (Exception ex)
        {
            _bulkDeleteErrors.Add("Lỗi khi xóa: " + ex.Message);
        }
        finally
        {
            _isBulkDeleting = false;
        }
    }

    public class ProductInlineEditModel
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string? NewCode { get; set; }
        public string? LegacyCode { get; set; }
        public string? ShortName { get; set; }
        public int? CategoryId { get; set; }
        public int? UnitId { get; set; }
        public decimal? UnitPrice { get; set; }
        public string? Specifications { get; set; }
        public string? Description { get; set; }
        public TaxTreatment TaxTreatment { get; set; }
        public bool IsTaxReductionEligible { get; set; }
        public bool IsActive { get; set; }
    }
}
