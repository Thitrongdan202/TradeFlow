@page "/danh-muc/don-vi-tinh"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Domain.Entities.MasterData
@using TradeFlow.Infrastructure.Persistence
@attribute [Authorize(Policy = "Permission:UnitOfMeasures:View")]

@inject TradeFlowDbContext DbContext
@inject NavigationManager Nav
@inject IAuthorizationService AuthService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject IAuditService AuditService

<PageTitle>Đơn vị tính - TradeFlow</PageTitle>

<div class="tf-page-header">
    <div class="tf-page-header-left">
        <h1 class="tf-page-title">Đơn vị tính</h1>
        <p class="tf-page-subtitle">Danh sách các đơn vị quy đổi và đo lường hàng hóa</p>
    </div>
    <div class="tf-page-actions">
        <AuthorizeView Policy="Permission:UnitOfMeasures:Create">
            <a href="/danh-muc/don-vi-tinh/them-moi" class="tf-btn tf-btn-primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                Thêm đơn vị tính
            </a>
        </AuthorizeView>
    </div>
</div>

<div class="tf-card tf-mb-4" style="padding: 12px 16px;">
    <input type="text"
           class="tf-input"
           placeholder="Tìm theo mã, tên đơn vị tính, ký hiệu..."
           value="@_searchTerm"
           @oninput="OnSearchInput" />
</div>

<div class="tf-card">
    <div class="tf-card-body" style="padding:0; overflow-x: auto;">
        
@if (_selectedItems.Count > 0)
{
    <div style="background: #eff6ff; border: 1px solid #bfdbfe; padding: 12px 16px; border-radius: 6px; margin-bottom: 16px; display: flex; justify-content: space-between; align-items: center;">
        <span style="color: #1e3a8a; font-weight: 500;">Đã chọn @_selectedItems.Count bản ghi</span>
        <AuthorizeView Policy="Permission:UnitOfMeasures:Delete">
            <button type="button" class="tf-btn tf-btn-danger" @onclick="ConfirmBulkDelete">Xóa đã chọn</button>
        </AuthorizeView>
    </div>
}

@if (_showBulkDeleteModal)
{
    <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center;">
        <div style="background: white; padding: 24px; border-radius: 8px; width: 500px; max-width: 90%; box-shadow: 0 10px 25px rgba(0,0,0,0.2);">
            <h3 style="margin-top: 0; margin-bottom: 16px; font-size: 18px; color: var(--tf-danger);">Xóa @_selectedItems.Count bản ghi đã chọn?</h3>
            <p style="margin-bottom: 24px;">Hành động này không thể hoàn tác. Các bản ghi đang được sử dụng sẽ bị bỏ qua hoặc vô hiệu hóa thay vì xóa hoàn toàn.</p>
            @if (_bulkDeleteErrors.Count > 0)
            {
                <div class="tf-alert tf-alert-danger" style="margin-bottom: 16px; max-height: 150px; overflow-y: auto;">
                    <ul style="margin: 0; padding-left: 20px;">
                        @foreach (var err in _bulkDeleteErrors)
                        {
                            <li>@err</li>
                        }
                    </ul>
                </div>
            }
            <div style="display: flex; justify-content: flex-end; gap: 12px;">
                <button type="button" class="tf-btn tf-btn-outline-secondary" @onclick="CancelBulkDelete">Hủy</button>
                <button type="button" class="tf-btn tf-btn-danger" @onclick="ExecuteBulkDelete" disabled="@_isBulkDeleting">
                    @(_isBulkDeleting ? "Đang xử lý..." : "Xóa tất cả")
                </button>
            </div>
        </div>
    </div>
}

<table class="tf-table">
            <thead>
                  <tr>
                      <th style="width: 40px; text-align: center;"><input type="checkbox" @onchange="ToggleSelectAll" checked="@(FilteredItems.Any() && _selectedItems.Count == FilteredItems.Count())" /></th>
                    <th style="min-width: 120px;">Mã đơn vị</th>
                    <th style="min-width: 180px;">Tên đơn vị tính</th>
                    <th>Ký hiệu</th>
                    <th style="text-align:center;">Trạng thái</th>
                    <th style="text-align:right;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (_items == null)
                {
                    <tr><td colspan="6" style="text-align:center; padding: 24px;">Đang tải dữ liệu...</td></tr>
                }
                else if (!FilteredItems.Any())
                {
                    <tr><td colspan="6"><div class="tf-empty"><div class="tf-empty-title">Chưa có đơn vị tính phù hợp</div></div></td></tr>
                }
                else
                {
                    foreach (var item in FilteredItems)
                    {
                        <tr>
                              <td style="text-align: center;"><input type="checkbox" @onchange="@(e => ToggleSelect(item.Id, e))" checked="@(_selectedItems.Contains(item.Id))" /></td>
                            <td>
                                <span style="font-family: monospace; font-weight: 600; color: var(--tf-primary);">@item.Code</span>
                            </td>
                            <td style="font-weight: 500;">@item.Name</td>
                            <td>@(item.Symbol ?? "-")</td>
                            <td style="text-align:center;">
                                @if (item.IsActive)
                                {
                                    <span class="tf-badge tf-badge-success">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="tf-badge tf-badge-neutral">Tạm dừng</span>
                                }
                            </td>
                            <td style="text-align:right;">
                                <AuthorizeView Policy="Permission:UnitOfMeasures:Edit">
                                    <a href="/danh-muc/don-vi-tinh/sua/@item.Id" class="tf-btn tf-btn-ghost tf-btn-sm">Sửa</a>
                                </AuthorizeView>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>


@if (_itemToDeleteId != null)
{
    <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center;">
        <div style="background: white; padding: 24px; border-radius: 8px; width: 400px; max-width: 90%; box-shadow: 0 10px 25px rgba(0,0,0,0.2);">
            <h3 style="margin-top: 0; margin-bottom: 16px; font-size: 18px; color: var(--tf-danger);">Xóa đơn vị tính?</h3>
            <p style="margin-bottom: 24px;">Bạn có chắc chắn muốn xóa "@(_itemToDeleteName)"?</p>
            @if (!string.IsNullOrEmpty(_deleteError))
            {
                <div class="tf-alert tf-alert-danger" style="margin-bottom: 16px;">
                    @_deleteError
                </div>
            }
            <div style="display: flex; justify-content: flex-end; gap: 12px;">
                <button class="tf-btn tf-btn-outline-secondary" @onclick="CancelDelete">Hủy</button>
                <button class="tf-btn tf-btn-danger" @onclick="ExecuteDelete">Xóa</button>
            </div>
        </div>
    </div>
}

@if (_itemToDeleteId != null)
{
    <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center;">
        <div style="background: white; padding: 24px; border-radius: 8px; width: 400px; max-width: 90%; box-shadow: 0 10px 25px rgba(0,0,0,0.2);">
            <h3 style="margin-top: 0; margin-bottom: 16px; font-size: 18px; color: var(--tf-danger);">Xóa dữ liệu?</h3>
            <p style="margin-bottom: 24px;">Bạn có chắc chắn muốn xóa @_itemToDeleteName?</p>
            @if (!string.IsNullOrEmpty(_deleteError))
            {
                <div class="tf-alert tf-alert-danger" style="margin-bottom: 16px;">
                    @_deleteError
                </div>
            }
            <div style="display: flex; justify-content: flex-end; gap: 12px;">
                <button type="button" class="tf-btn tf-btn-outline-secondary" @onclick="CancelDelete">Hủy</button>
                <button type="button" class="tf-btn tf-btn-danger" @onclick="ExecuteDelete">Xóa</button>
            </div>
        </div>
    </div>
}

@code {
    private int? _itemToDeleteId;
    private string _itemToDeleteName = "";
    private string? _deleteError;

    private List<UnitOfMeasure>? _items;
    private string _searchTerm = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _items = await DbContext.UnitOfMeasures
            .OrderBy(x => x.Code)
            .ToListAsync();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? string.Empty;
    }

    private IEnumerable<UnitOfMeasure> FilteredItems
    {
        get
        {
            if (_items == null) return Enumerable.Empty<UnitOfMeasure>();

            if (string.IsNullOrWhiteSpace(_searchTerm))
            {
                return _items;
            }

            var term = _searchTerm.Trim().ToLower();
            return _items.Where(x =>
                (x.Code != null && x.Code.ToLower().Contains(term)) ||
                (x.Name != null && x.Name.ToLower().Contains(term)) ||
                (x.Symbol != null && x.Symbol.ToLower().Contains(term)));
        }
    }

    private void ConfirmDelete(int id, string name)
    {
        _itemToDeleteId = id;
        _itemToDeleteName = name;
        _deleteError = null;
    }

    private void CancelDelete() { _itemToDeleteId = null; _deleteError = null; }
    private async Task ExecuteDelete() { if (_itemToDeleteId == null) return; var authState = await AuthStateProvider.GetAuthenticationStateAsync(); if (!(await AuthService.AuthorizeAsync(authState.User, "Permission:UnitOfMeasures:Delete")).Succeeded) { _deleteError = "Bạn không có quyền."; return; } try { int id = _itemToDeleteId.Value; var entity = await DbContext.UnitOfMeasures.FindAsync(id); if (entity == null) { CancelDelete(); return; } bool isReferenced = await DbContext.Products.AnyAsync(x => x.UnitId == id); if (isReferenced) { _deleteError = "Không thể xóa vì dữ liệu này đang được sử dụng."; return; } else { DbContext.Remove(entity); } await DbContext.SaveChangesAsync(); await AuditService.LogAsync(TradeFlow.Domain.Enums.AuditEventType.UnitDeleted, authState.User.Identity?.Name ?? "System", "Unit", id.ToString(), "Xóa đơn vị tính", authState.User.Identity?.Name); CancelDelete(); await OnInitializedAsync(); } catch (Exception ex) { _deleteError = "Đã xảy ra lỗi: " + ex.Message; } }


    private HashSet<int> _selectedItems = new();
    private bool _showBulkDeleteModal = false;
    private List<string> _bulkDeleteErrors = new();
    private bool _isBulkDeleting = false;

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        if (e.Value is bool isChecked && isChecked)
        {
            _selectedItems = new HashSet<int>(FilteredItems.Select(x => x.Id));
        }
        else
        {
            _selectedItems.Clear();
        }
    }

    private void ToggleSelect(int id, ChangeEventArgs e)
    {
        if (e.Value is bool isChecked && isChecked)
        {
            _selectedItems.Add(id);
        }
        else
        {
            _selectedItems.Remove(id);
        }
    }

    private void ConfirmBulkDelete()
    {
        _bulkDeleteErrors.Clear();
        _showBulkDeleteModal = true;
    }

    private void CancelBulkDelete()
    {
        _showBulkDeleteModal = false;
        _isBulkDeleting = false;
    }

    private async Task ExecuteBulkDelete()
    {
        if (_selectedItems.Count == 0) return;
        _isBulkDeleting = true;
        _bulkDeleteErrors.Clear();
        StateHasChanged();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!(await AuthService.AuthorizeAsync(authState.User, "Permission:UnitOfMeasures:Delete")).Succeeded)
        {
            _bulkDeleteErrors.Add("Bạn không có quyền thực hiện thao tác này.");
            _isBulkDeleting = false;
            return;
        }

        try
        {
            int successCount = 0;
            var idsToProcess = _selectedItems.ToList();
            
            foreach (var id in idsToProcess)
            {
                _itemToDeleteId = id; // reuse the id for the logic block
                try 
                {
                    await ProcessSingleDelete(id);
                    _selectedItems.Remove(id);
                    successCount++;
                } 
                catch (Exception ex)
                {
                    _bulkDeleteErrors.Add($"Bản ghi ID {id}: {ex.Message}");
                }
            }

            if (successCount > 0)
            {
                await OnInitializedAsync();
            }
            
            if (_selectedItems.Count == 0)
            {
                CancelBulkDelete();
            }
        }
        finally
        {
            _isBulkDeleting = false;
            _itemToDeleteId = null;
            StateHasChanged();
        }
    }

    private async Task ProcessSingleDelete(int currentId)
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        int id = _itemToDeleteId.Value; var entity = await DbContext.UnitOfMeasures.FindAsync(id); if (entity == null) {  return; } bool isReferenced = await DbContext.Products.AnyAsync(x => x.UnitId == id); if (isReferenced) { throw new Exception("Không thể xóa vì dữ liệu này đang được sử dụng."); } else { DbContext.Remove(entity); } await DbContext.SaveChangesAsync(); await AuditService.LogAsync(TradeFlow.Domain.Enums.AuditEventType.UnitDeleted, authState.User.Identity?.Name ?? "System", "Unit", id.ToString(), "Xóa đơn vị tính", authState.User.Identity?.Name); 
    }
}
