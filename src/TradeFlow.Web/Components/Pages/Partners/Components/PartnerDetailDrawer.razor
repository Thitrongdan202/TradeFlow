                                                                                <th style="min-width: 80px; padding: 4px 6px;">Mã SP</th>
                                                                                <th style="min-width: 140px; padding: 4px 6px;">Tên sản phẩm</th>
                                                                                <th style="width: 55px; text-align: center; padding: 4px 6px;">ĐVT</th>
                                                                                <th style="width: 60px; text-align: right; padding: 4px 6px;">SL</th>
                                                                                <th style="min-width: 85px; text-align: right; padding: 4px 6px;">Đơn giá</th>
                                                                                <th style="min-width: 75px; text-align: right; padding: 4px 6px;">Giảm giá</th>
                                                                                <th style="width: 55px; text-align: center; padding: 4px 6px;">VAT</th>
                                                                                <th style="min-width: 95px; text-align: right; padding: 4px 6px;">Thành tiền</th>
                                                                            </tr>
                                                                        </thead>
                                                                        <tbody>
                                                                            @for (int i = 0; i < t.LineItems.Count; i++)
                                                                            {
                                                                                var line = t.LineItems[i];
                                                                                <tr style="border-bottom: 1px solid #f1f5f9;">
                                                                                    <td style="text-align: center; color: #94a3b8; padding: 4px 6px;">@(i + 1)</td>
                                                                                    <td style="font-family: monospace; font-weight: 600; color: #2563eb; padding: 4px 6px;">@line.ProductCode</td>
                                                                                    <td style="color: #1e293b; padding: 4px 6px;">@line.ProductName</td>
                                                                                    <td style="text-align: center; color: #64748b; padding: 4px 6px;">@line.UnitName</td>
                                                                                    <td style="text-align: right; font-weight: 600; padding: 4px 6px;">@line.Quantity.ToString("N0")</td>
                                                                                    <td style="text-align: right; color: #475569; padding: 4px 6px;">@line.UnitPrice.ToString("N0") ₫</td>
                                                                                    <td style="text-align: right; color: @(line.DiscountAmount > 0 ? "#16a34a" : "#94a3b8"); padding: 4px 6px;">
                                                                                        @(line.DiscountAmount > 0 ? line.DiscountAmount.ToString("N0") + " ₫" : "-")
                                                                                    </td>
                                                                                    <td style="text-align: center; color: #64748b; padding: 4px 6px;">
                                                                                        @(line.TaxRate > 0 ? $"{line.TaxRate}%" : "0%")
                                                                                    </td>
                                                                                    <td style="text-align: right; font-weight: 600; color: #0f172a; padding: 4px 6px;">
                                                                                        @line.LineTotal.ToString("N0") ₫
                                                                                    </td>
                                                                                </tr>
                                                                            }
                                                                        </tbody>
                                                                    </table>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (_activeTab == DrawerTab.Audit)
                    {
                        <div class="tf-drawer-section">
                            <h4 class="tf-drawer-section-title">Nhật ký dữ liệu &amp; Nguồn gốc bản ghi</h4>
                            <div class="tf-drawer-audit-box">
                                <div class="tf-audit-step">
                                    <div class="tf-audit-marker create"></div>
                                    <div class="tf-audit-content">
                                        <div class="tf-audit-title">Khởi tạo bản ghi</div>
                                        <div class="tf-audit-time">@_supplier.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</div>
                                        <div class="tf-audit-user">
                                            Người tạo: <strong>@(!string.IsNullOrEmpty(_supplier.CreatedBy) ? _supplier.CreatedBy : "Hệ thống (Khởi tạo ban đầu)")</strong>
                                        </div>
                                    </div>
                                </div>

                                @if (_supplier.UpdatedAt.HasValue)
                                {
                                    <div class="tf-audit-step">
                                        <div class="tf-audit-marker update"></div>
                                        <div class="tf-audit-content">
                                            <div class="tf-audit-title">Cập nhật gần nhất</div>
                                            <div class="tf-audit-time">@_supplier.UpdatedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</div>
                                            <div class="tf-audit-user">
                                                Người cập nhật: <strong>@(!string.IsNullOrEmpty(_supplier.UpdatedBy) ? _supplier.UpdatedBy : "System")</strong>
