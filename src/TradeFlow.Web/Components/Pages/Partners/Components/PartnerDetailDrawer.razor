                                    <span class="tf-stat-val text-warning">@_supplier.CurrentPayable.ToString("N0") ₫</span>
                                </div>
                                <div class="tf-debt-header-stat secondary">
                                    <span class="tf-stat-label">Tổng mua:</span>
                                    <span class="tf-stat-val">@_supplier.TotalPurchases.ToString("N0") ₫</span>
                                </div>
                            </div>

                            @* Action Toolbar (matching screenshot reference) *@
                            <div class="tf-drawer-debt-actions">
                                <button type="button" class="tf-debt-action-btn" @onclick="() => OpenExportModal(false)" title="Xuất bảng đối soát công nợ chi tiết">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                        <polyline points="7 10 12 15 17 10"></polyline>
                                        <line x1="12" y1="15" x2="12" y2="3"></line>
                                    </svg>
                                    <span>Xuất file công nợ</span>
                                </button>
                                <button type="button" class="tf-debt-action-btn @(_isQuickExporting ? "loading" : "")" @onclick="ExecuteQuickExportAsync" disabled="@_isQuickExporting" title="Xuất nhanh toàn bộ lịch sử công nợ của nhà cung cấp này sang Excel (1-click)">
                                    @if (_isQuickExporting)
                                    {
                                        <span style="display:inline-block;width:12px;height:12px;border:2px solid #cbd5e1;border-top-color:#1e293b;border-radius:50%;animation:tf-spin 0.8s linear infinite;"></span>
