            </div>

            @* 4. Drawer Footer Actions *@
            <div class="tf-drawer-footer">
                @if (PartnerType == PartnerType.Customer && _customer != null)
                {
                    <a href="/doi-tac/khach-hang/sua/@_customer.Id" class="tf-drawer-btn primary">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                        </svg>
                        <span>Sửa thông tin</span>
                    </a>
                }
                else if (PartnerType == PartnerType.Supplier && _supplier != null)
                {
                    <a href="/doi-tac/nha-cung-cap/sua/@_supplier.Id" class="tf-drawer-btn primary">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                        </svg>
                        <span>Sửa thông tin</span>
                    </a>
                }
                <button type="button" class="tf-drawer-btn secondary" @onclick="HandleClose">
                    Đóng
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public PartnerType PartnerType { get; set; } = PartnerType.Customer;
    [Parameter] public int? PartnerId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnDebtUpdated { get; set; }

    private enum DrawerTab { Overview, Transactions, Audit }
    private DrawerTab _activeTab = DrawerTab.Overview;

    private bool _isLoading = false;
    private CustomerDetailDto? _customer;
    private SupplierDetailDto? _supplier;
    private int? _lastLoadedId;
    private PartnerType _lastLoadedType;

    // Debt Action Modals
    private bool _isExportModalOpen = false;
    private bool _isManagementExport = false;
    private bool _isPaymentModalOpen = false;
    private DebtTransactionType _modalTransactionType = DebtTransactionType.Payment;
    private bool _isQrModalOpen = false;
    private bool _isQuickExporting = false;
    private readonly HashSet<string> _expandedTransactionCodes = new();

    private void ToggleTxExpand(string documentCode)
    {
        if (string.IsNullOrEmpty(documentCode)) return;
        if (!_expandedTransactionCodes.Add(documentCode))
        {
            _expandedTransactionCodes.Remove(documentCode);
        }
    }

    private async Task ExecuteQuickExportAsync()
    {
        if (_isQuickExporting) return;

        int partnerId = PartnerType == PartnerType.Customer ? (_customer?.Id ?? 0) : (_supplier?.Id ?? 0);
        string partnerCode = PartnerType == PartnerType.Customer ? (_customer?.Code ?? "") : (_supplier?.Code ?? "");
        if (partnerId <= 0) return;

        _isQuickExporting = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var req = new PartnerDebtStatementExportRequest
            {
                Scope = DebtExportScope.CurrentPartner,
                PartnerType = PartnerType,
                PartnerIds = new List<int> { partnerId },
                FromDate = null,
                ToDate = null,
                DatePresetTitle = "Toàn thời gian",
                IncludeLineDetails = true,
                IncludeUnit = true,
                IncludeQuantity = true,
                IncludeUnitPrice = true,
                IncludeDiscount = true,
                IncludeVat = true,
                IncludeCostOrPurchasePrice = false,
                IncludeLineTotal = true
            };

            var bytes = await DebtService.ExportPartnerDebtStatementAsync(req, authState.User);
            string fileName = $"BaoCaoCongNo_{partnerCode}_{DateTime.Now:yyyyMMdd_HHmm}.xlsx";
            string base64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("eval", $@"
                var link = document.createElement('a');
                link.download = '{fileName}';
                link.href = 'data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,{base64}';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            ");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Quick export error: {ex.Message}");
        }
        finally
        {
            _isQuickExporting = false;
        }
    }

    private void OpenExportModal(bool isManagement)
    {
        _isManagementExport = isManagement;
        _isExportModalOpen = true;
    }

    private void OpenPaymentModal(DebtTransactionType type)
    {
        _modalTransactionType = type;
        _isPaymentModalOpen = true;
    }

    private void OpenQrModal()
    {
        _isQrModalOpen = true;
    }

    private async Task HandlePaymentRecorded(RecordDebtPaymentResult result)
    {
        await LoadPartnerDetailAsync();
        await OnDebtUpdated.InvokeAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && PartnerId.HasValue && (PartnerId != _lastLoadedId || PartnerType != _lastLoadedType))
        {
            await LoadPartnerDetailAsync();
        }
    }

    private async Task LoadPartnerDetailAsync()
    {
        if (!PartnerId.HasValue) return;

        _isLoading = true;
        _customer = null;
        _supplier = null;

        try
        {
            if (PartnerType == PartnerType.Customer)
            {
                _customer = await PartnerService.GetCustomerDetailAsync(PartnerId.Value);
            }
            else
            {
                _supplier = await PartnerService.GetSupplierDetailAsync(PartnerId.Value);
            }

            _lastLoadedId = PartnerId;
            _lastLoadedType = PartnerType;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading partner detail: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleClose()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
        await OnClose.InvokeAsync();
    }

    private async Task SwitchToSupplier(int supplierId)
    {
        PartnerType = PartnerType.Supplier;
        PartnerId = supplierId;
        await LoadPartnerDetailAsync();
    }

    private async Task SwitchToCustomer(int customerId)
    {
        PartnerType = PartnerType.Customer;
        PartnerId = customerId;
        await LoadPartnerDetailAsync();
    }
}

@* Modal Dialogs for Debt Operations *@
<DebtExportModal @bind-IsOpen="_isExportModalOpen"
                 IsManagementExport="_isManagementExport"
                 PartnerType="PartnerType"
                 SinglePartnerId="@(PartnerType == PartnerType.Customer ? _customer?.Id : _supplier?.Id)"
                 PartnerCodeDisplay="@(PartnerType == PartnerType.Customer ? _customer?.Code : _supplier?.Code)" />

<DebtPaymentModal @bind-IsOpen="_isPaymentModalOpen"
                  PartnerType="PartnerType"
                  PartnerId="@(PartnerType == PartnerType.Customer ? (_customer?.Id ?? 0) : (_supplier?.Id ?? 0))"
                  PartnerCode="@(PartnerType == PartnerType.Customer ? (_customer?.Code ?? "") : (_supplier?.Code ?? ""))"
                  PartnerName="@(PartnerType == PartnerType.Customer ? (_customer?.Name ?? "") : (_supplier?.Name ?? ""))"
                  PartnerCompanyName="@(PartnerType == PartnerType.Customer ? _customer?.CompanyName : _supplier?.CompanyName)"
                  PartnerPhone="@(PartnerType == PartnerType.Customer ? _customer?.Phone : _supplier?.Phone)"
                  PartnerTaxCode="@(PartnerType == PartnerType.Customer ? _customer?.TaxCode : _supplier?.TaxCode)"
                  CurrentBalance="@(PartnerType == PartnerType.Customer ? (_customer?.CurrentReceivable ?? 0) : (_supplier?.CurrentPayable ?? 0))"
                  InitialTransactionType="_modalTransactionType"
                  OnPaymentRecorded="HandlePaymentRecorded" />

<DebtQrModal @bind-IsOpen="_isQrModalOpen"
             PartnerCode="@(PartnerType == PartnerType.Customer ? (_customer?.Code ?? "") : (_supplier?.Code ?? ""))"
             PartnerName="@(PartnerType == PartnerType.Customer ? (_customer?.Name ?? "") : (_supplier?.Name ?? ""))"
             Amount="@(PartnerType == PartnerType.Customer ? (_customer?.CurrentReceivable ?? 0) : (_supplier?.CurrentPayable ?? 0))"
             ReferenceCode="@(PartnerType == PartnerType.Customer ? "TT CN" : "CN NCC")" />
