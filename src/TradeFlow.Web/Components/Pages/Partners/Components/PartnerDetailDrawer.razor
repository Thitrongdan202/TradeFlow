                                                        </td>
                                                        <td style="text-align:right; font-weight:600; color:#16a34a;">
                                                            @(t.CreditAmount > 0 ? t.CreditAmount.ToString("N0") + " ₫" : "-")
                                                        </td>
                                                        <td style="text-align:right; font-weight:600; color:@(t.OutstandingAmount > 0 ? "#d97706" : "#475569");">
                                                            @t.OutstandingAmount.ToString("N0") ₫
                                                        </td>
                                                        <td style="text-align:center;">
                                                            <span class="tf-badge-doc-status">@t.Status</span>
                                                        </td>
                                                    </tr>
                                                    @if (isExpanded && t.LineItems.Any())
                                                    {
                                                        <tr class="tf-tx-lineitems-row">
                                                            <td colspan="7" style="padding: 6px 12px 12px 28px; background-color: #f8fafc; border-bottom: 2px solid #e2e8f0;">
                                                                <div class="tf-tx-lineitems-box">
                                                                    <div style="font-size: 11.5px; font-weight: 600; color: #475569; margin-bottom: 6px; display: flex; align-items: center; gap: 6px;">
                                                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                                            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
                                                                            <line x1="3" y1="6" x2="21" y2="6"/>
                                                                        </svg>
                                                                        <span>Chi tiết các mặt hàng (@t.LineItems.Count sản phẩm):</span>
                                                                    </div>
                                                                    <table class="tf-drawer-table" style="font-size: 11.5px; background: #ffffff; border-radius: 6px; border: 1px solid #e2e8f0; width: 100%;">
