@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using TradeFlow.Application.Common.Constants
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Domain.Entities.MasterData
@using TradeFlow.Domain.Enums
@using TradeFlow.Infrastructure.Persistence
@inject TradeFlowDbContext DbContext
@inject ISystemCodeGenerator CodeGenerator
@inject IAuditService AuditService
@inject ICurrentUserService CurrentUser
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (IsOpen)
{
    <div class="tf-modal-overlay @(_isClosing ? "is-closing" : "")" @onclick="HandleBackdropClick" @onkeydown="HandleKeyDown" tabindex="-1">
        <div class="tf-modal tf-modal-lg customer-modal @(_isClosing ? "is-closing" : "")"
             style="max-width: 760px; max-height: calc(100dvh - 36px); min-height: 0; display: flex; flex-direction: column; overflow: hidden; position: relative;"
             @onclick:stopPropagation="true">

            @* Fixed Header *@
            <div class="tf-modal-header customer-modal-header" style="flex: 0 0 auto;">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <div class="tf-cust-header-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                            <circle cx="9" cy="7" r="4"/>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                        </svg>
                    </div>
                    <div>
                        <h3 class="tf-modal-title" style="margin: 0; font-size: 17px; font-weight: 700; color: var(--tf-text-primary);">
                            @(IsEditMode ? "Chỉnh sửa thông tin khách hàng" : "Thêm khách hàng mới")
                        </h3>
                        <p style="margin: 2px 0 0 0; font-size: 13px; color: var(--tf-text-muted);">
                            @(IsEditMode ? "Cập nhật hồ sơ pháp lý, thông tin đại diện và đầu mối liên hệ" : "Nhập hồ sơ đối tác khách hàng, phân loại doanh nghiệp/cá nhân và thông tin liên hệ")
                        </p>
                    </div>
                </div>
                <button type="button" class="tf-modal-close-btn" @onclick="RequestCloseAsync" aria-label="Đóng" title="Đóng (Esc)">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"/>
                        <line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                </button>
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="tf-modal-alert-error" style="flex: 0 0 auto; margin: 12px 24px 0;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0;">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="8" x2="12" y2="12"/>
                        <line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                    <span>@_errorMessage</span>
                </div>
            }

            @* Scrollable Form Body *@
            <div class="tf-modal-body customer-modal-body" style="flex: 1 1 auto; overflow-y: auto; padding: 20px 24px;">
                <EditForm Model="_model" OnValidSubmit="HandleSubmit" id="customerForm">
                    <DataAnnotationsValidator />

                    @* Section 1: Định danh & Phân loại *@
                    <div class="tf-form-section">
                        <div class="tf-form-section-title">
                            <span class="tf-section-step">1</span>
                            <span>Thông tin định danh &amp; Phân loại</span>
                        </div>
                        <div class="tf-form-grid-2">
                            <div class="tf-form-group">
                                <label class="tf-label">
                                    Mã khách hàng
                                    <span class="tf-label-hint">(Hệ thống tự sinh)</span>
                                </label>
                                <div class="tf-input-readonly-wrap">
                                    <input type="text" class="tf-input" value="@_displayCode" readonly disabled />
                                    <span class="tf-readonly-badge">Tự động</span>
                                </div>
                            </div>
                            <div class="tf-form-group">
                                <label class="tf-label">
                                    Mã quản lý nội bộ
                                    <span class="tf-label-hint">(Tùy chọn)</span>
                                </label>
                                <InputText @bind-Value="_model.BusinessCode" class="tf-input" placeholder="Ví dụ: KH-VIP-01, DL-MIENBAC..." maxlength="50" />
                            </div>
                        </div>
                    </div>

                    @* Section 2: Thông tin cơ bản & Pháp lý *@
                    <div class="tf-form-section tf-mt-4">
                        <div class="tf-form-section-title">
                            <span class="tf-section-step">2</span>
                            <span>Hồ sơ khách hàng &amp; Pháp nhân</span>
                        </div>
                        <div class="tf-form-grid-2">
                            <div class="tf-form-group">
                                <label class="tf-label">
                                    Tên khách hàng <span class="tf-text-danger">*</span>
                                </label>
                                <InputText @bind-Value="_model.Name" class="tf-input" placeholder="Tên khách hàng hoặc tên viết tắt giao dịch" maxlength="200" />
                                <ValidationMessage For="@(() => _model.Name)" class="tf-field-error" />
                            </div>
                            <div class="tf-form-group">
                                <label class="tf-label">
                                    Tên công ty / Doanh nghiệp
                                </label>
                                <InputText @bind-Value="_model.CompanyName" class="tf-input" placeholder="Tên đầy đủ theo đăng ký kinh doanh" maxlength="250" />
                            </div>
                        </div>

                        <div class="tf-form-grid-2 tf-mt-3">
                            <div class="tf-form-group">
                                <label class="tf-label">
                                    Mã số thuế (MST)
                                </label>
                                <InputText @bind-Value="_model.TaxCode" class="tf-input font-mono" placeholder="Mã số thuế doanh nghiệp (10 hoặc 13 số)" maxlength="30" />
                            </div>
                            <div class="tf-form-group">
                                <label class="tf-label">
                                    Người đại diện / Đầu mối liên hệ
                                </label>
                                <InputText @bind-Value="_model.ContactPerson" class="tf-input" placeholder="Họ và tên người liên hệ chính" maxlength="100" />
                            </div>
                        </div>
                    </div>

                    @* Section 3: Thông tin liên lạc & Địa chỉ *@
                    <div class="tf-form-section tf-mt-4">
                        <div class="tf-form-section-title">
                            <span class="tf-section-step">3</span>
                            <span>Thông tin liên lạc &amp; Trụ sở</span>
                        </div>
                        <div class="tf-form-grid-2">
                            <div class="tf-form-group">
                                <label class="tf-label">
                                    Số điện thoại
                                </label>
                                <InputText @bind-Value="_model.Phone" class="tf-input" placeholder="Số điện thoại di động hoặc hotline bàn" maxlength="30" />
                            </div>
                            <div class="tf-form-group">
                                <label class="tf-label">
                                    Địa chỉ Email
                                </label>
                                <InputText @bind-Value="_model.Email" class="tf-input" placeholder="email@congty.com" maxlength="100" />
                            </div>
                        </div>

                        <div class="tf-form-group tf-mt-3">
                            <label class="tf-label">
                                Địa chỉ giao dịch / Trụ sở chính
                            </label>
                            <InputText @bind-Value="_model.Address" class="tf-input" placeholder="Số nhà, đường phố, phường/xã, quận/huyện, tỉnh/thành phố" maxlength="300" />
                        </div>
                    </div>

                    @* Section 4: Ghi chú & Trạng thái *@
                    <div class="tf-form-section tf-mt-4">
                        <div class="tf-form-section-title">
                            <span class="tf-section-step">4</span>
                            <span>Ghi chú quản lý &amp; Trạng thái</span>
                        </div>
                        <div class="tf-form-group">
                            <label class="tf-label">Ghi chú về khách hàng</label>
                            <InputTextArea @bind-Value="_model.Notes" class="tf-input" rows="2" placeholder="Ghi chú về chính sách thanh toán, thói quen giao nhận hàng, chiết khấu đặc thù..." maxlength="500" />
                        </div>

                        <div class="tf-form-group tf-mt-3">
                            <label class="tf-checkbox-custom-label">
                                <InputCheckbox @bind-Value="_model.IsActive" class="tf-checkbox-input" />
                                <span class="tf-checkbox-text">
                                    <strong>Đang hoạt động</strong> — Khách hàng được phép lập đơn hàng, xuất kho và ghi nhận công nợ
                                </span>
                            </label>
                        </div>
                    </div>
                </EditForm>
            </div>

            @* Fixed Footer *@
            <div class="tf-modal-footer customer-modal-footer" style="flex: 0 0 auto;">
                <button type="button" class="tf-btn tf-btn-ghost" @onclick="RequestCloseAsync" disabled="@_isSubmitting">
                    Hủy bỏ
                </button>
                <button type="submit" form="customerForm" class="tf-btn tf-btn-primary" disabled="@_isSubmitting" style="min-width: 140px;">
                    @if (_isSubmitting)
                    {
                        <span class="tf-spinner-sm" style="margin-right: 6px;"></span>
                        <span>Đang lưu...</span>
                    }
                    else
                    {
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 6px;">
                            <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
                            <polyline points="17 21 17 13 7 13 7 21"/>
                            <polyline points="7 3 7 8 15 8"/>
                        </svg>
                        <span>@(IsEditMode ? "Lưu thay đổi" : "Lưu khách hàng")</span>
                    }
                </button>
            </div>

            @* Unsaved Changes Confirmation Dialog *@
            @if (_showDirtyConfirm)
            {
                <div class="tf-modal-confirm-overlay" @onclick:stopPropagation="true">
                    <div class="tf-modal-confirm-box text-center">
                        <div style="width: 46px; height: 46px; border-radius: 50%; background: rgba(245, 158, 11, 0.15); color: #d97706; display: flex; align-items: center; justify-content: center; margin: 0 auto 12px auto;">
                            <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                            </svg>
                        </div>
                        <h4 style="font-size: 16px; font-weight: 700; color: var(--tf-text-primary); margin: 0 0 6px 0;">Bạn có thay đổi chưa lưu</h4>
                        <p style="font-size: 13px; color: var(--tf-text-muted); margin: 0 0 20px 0; line-height: 1.5;">
                            Thông tin khách hàng bạn vừa nhập sẽ bị mất nếu đóng cửa sổ này. Bạn có chắc chắn muốn hủy?
                        </p>
                        <div style="display: flex; align-items: center; justify-content: center; gap: 10px;">
                            <button type="button" class="tf-btn tf-btn-secondary" @onclick="() => _showDirtyConfirm = false">
                                Tiếp tục nhập
                            </button>
                            <button type="button" class="tf-btn tf-btn-danger" @onclick="ConfirmDiscardAsync">
                                Hủy thay đổi
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public int? CustomerId { get; set; }
    [Parameter] public EventCallback<Customer> OnSaved { get; set; }

    private CustomerFormModel _model = new();
    private CustomerFormModel _initialSnapshot = new();
    private string _displayCode = "KH------";
    private bool _isSubmitting = false;
    private bool _isClosing = false;
    private bool _wasOpen = false;
    private bool _showDirtyConfirm = false;
    private string? _errorMessage;

    private bool IsEditMode => CustomerId.HasValue && CustomerId.Value > 0;

    private bool IsDirty =>
        _model.Name != _initialSnapshot.Name ||
        _model.BusinessCode != _initialSnapshot.BusinessCode ||
        _model.CompanyName != _initialSnapshot.CompanyName ||
        _model.TaxCode != _initialSnapshot.TaxCode ||
        _model.ContactPerson != _initialSnapshot.ContactPerson ||
        _model.Phone != _initialSnapshot.Phone ||
        _model.Email != _initialSnapshot.Email ||
        _model.Address != _initialSnapshot.Address ||
        _model.Notes != _initialSnapshot.Notes ||
        _model.IsActive != _initialSnapshot.IsActive;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && !_wasOpen)
        {
            _wasOpen = true;
            _isClosing = false;
            _errorMessage = null;
            _isSubmitting = false;
            _showDirtyConfirm = false;

            try
            {
                await JS.InvokeVoidAsync("TradeFlowMotion.lockScroll");
            }
            catch { }

            await InitializeFormAsync();
        }
        else if (!IsOpen && _wasOpen)
        {
            _wasOpen = false;
            try
            {
                await JS.InvokeVoidAsync("TradeFlowMotion.unlockScroll");
            }
            catch { }
        }
    }

    private async Task InitializeFormAsync()
    {
        try
        {
            if (IsEditMode)
            {
                var entity = await DbContext.Customers.FindAsync(CustomerId!.Value);
                if (entity != null)
                {
                    _displayCode = entity.Code;
                    _model = new CustomerFormModel
                    {
                        Id = entity.Id,
                        Code = entity.Code,
                        BusinessCode = entity.BusinessCode,
                        Name = entity.Name,
                        CompanyName = entity.CompanyName,
                        TaxCode = entity.TaxCode,
                        ContactPerson = entity.ContactPerson,
                        Phone = entity.Phone,
                        Email = entity.Email,
                        Address = entity.Address,
                        Notes = entity.Notes,
                        IsActive = entity.IsActive
                    };
                    _initialSnapshot = _model.Clone();
                }
                else
                {
                    _errorMessage = "Không tìm thấy khách hàng cần chỉnh sửa.";
                }
            }
            else
            {
                string nextCode = await CodeGenerator.PeekNextCodeAsync(SystemCodeConstants.Customer);
                _displayCode = $"{nextCode} (Tự sinh)";
                _model = new CustomerFormModel { IsActive = true };
                _initialSnapshot = _model.Clone();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Lỗi chuẩn bị dữ liệu: {ex.Message}";
        }
    }

    private async Task HandleBackdropClick()
    {
        if (_isSubmitting || _isClosing) return;

        if (IsDirty)
        {
            _showDirtyConfirm = true;
            return;
        }

        await CloseAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (_isSubmitting || _isClosing) return;

        if (e.Key == "Escape")
        {
            if (_showDirtyConfirm)
            {
                _showDirtyConfirm = false;
                return;
            }

            await RequestCloseAsync();
        }
    }

    public async Task RequestCloseAsync()
    {
        if (_isSubmitting || _isClosing) return;

        if (IsDirty)
        {
            _showDirtyConfirm = true;
            return;
        }

        await CloseAsync();
    }

    private async Task ConfirmDiscardAsync()
    {
        _showDirtyConfirm = false;
        await CloseAsync();
    }

    private async Task CloseAsync()
    {
        if (_isClosing) return;

        bool reduced = false;
        try
        {
            reduced = await JS.InvokeAsync<bool>("TradeFlowMotion.isReducedMotion");
        }
        catch { }

        if (!reduced)
        {
            _isClosing = true;
            StateHasChanged();
            await Task.Delay(160);
        }

        IsOpen = false;
        _isClosing = false;
        _wasOpen = false;

        try
        {
            await JS.InvokeVoidAsync("TradeFlowMotion.unlockScroll");
        }
        catch { }

        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task HandleSubmit()
    {
        if (_isSubmitting) return;

        if (string.IsNullOrWhiteSpace(_model.Name))
        {
            _errorMessage = "Vui lòng nhập tên khách hàng.";
            return;
        }

        _isSubmitting = true;
        _errorMessage = null;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name ?? CurrentUser.UserName ?? "Admin";

            Customer savedCustomer;

            if (IsEditMode)
            {
                var entity = await DbContext.Customers.FindAsync(CustomerId!.Value);
                if (entity == null)
                {
                    _errorMessage = "Không tìm thấy khách hàng để cập nhật.";
                    return;
                }

                entity.BusinessCode = _model.BusinessCode?.Trim();
                entity.Name = _model.Name.Trim();
                entity.CompanyName = _model.CompanyName?.Trim();
                entity.TaxCode = _model.TaxCode?.Trim();
                entity.ContactPerson = _model.ContactPerson?.Trim();
                entity.Phone = _model.Phone?.Trim();
                entity.Email = _model.Email?.Trim();
                entity.Address = _model.Address?.Trim();
                entity.Notes = _model.Notes?.Trim();
                entity.IsActive = _model.IsActive;
                entity.UpdatedAt = DateTime.UtcNow;
                entity.UpdatedBy = username;

                DbContext.Customers.Update(entity);
                await AuditService.LogAsync(AuditEventType.CustomerUpdated, username, "Customer", entity.Id.ToString());
                await DbContext.SaveChangesAsync();

                savedCustomer = entity;
            }
            else
            {
                var newCustomer = new Customer
                {
                    Code = await CodeGenerator.GenerateCodeAsync(SystemCodeConstants.Customer),
                    BusinessCode = _model.BusinessCode?.Trim(),
                    Name = _model.Name.Trim(),
                    CompanyName = _model.CompanyName?.Trim(),
                    TaxCode = _model.TaxCode?.Trim(),
                    ContactPerson = _model.ContactPerson?.Trim(),
                    Phone = _model.Phone?.Trim(),
                    Email = _model.Email?.Trim(),
                    Address = _model.Address?.Trim(),
                    Notes = _model.Notes?.Trim(),
                    IsActive = _model.IsActive,
                    CreatedAt = DateTime.UtcNow,
                    CreatedBy = username
                };

                DbContext.Customers.Add(newCustomer);
                await AuditService.LogAsync(AuditEventType.CustomerCreated, username, "Customer", newCustomer.Code);
                await DbContext.SaveChangesAsync();

                savedCustomer = newCustomer;
            }

            if (OnSaved.HasDelegate)
            {
                await OnSaved.InvokeAsync(savedCustomer);
            }

            await CloseAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = "Có lỗi xảy ra khi lưu khách hàng: " + ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("TradeFlowMotion.unlockScroll");
        }
        catch { }
    }

    private class CustomerFormModel
    {
        public int Id { get; set; }
        public string? Code { get; set; }
        public string? BusinessCode { get; set; }

        [Required(ErrorMessage = "Vui lòng nhập tên khách hàng")]
        [MaxLength(200, ErrorMessage = "Tên khách hàng tối đa 200 ký tự")]
        public string Name { get; set; } = string.Empty;

        public string? CompanyName { get; set; }
        public string? TaxCode { get; set; }
        public string? ContactPerson { get; set; }
        public string? Phone { get; set; }
        public string? Email { get; set; }
        public string? Address { get; set; }
        public string? Notes { get; set; }
        public bool IsActive { get; set; } = true;

        public CustomerFormModel Clone() => new()
        {
            Id = this.Id,
            Code = this.Code,
            BusinessCode = this.BusinessCode,
            Name = this.Name,
            CompanyName = this.CompanyName,
            TaxCode = this.TaxCode,
            ContactPerson = this.ContactPerson,
            Phone = this.Phone,
            Email = this.Email,
            Address = this.Address,
            Notes = this.Notes,
            IsActive = this.IsActive
        };
    }
}
