@page "/doi-tac/khach-hang"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Domain.Entities.MasterData
@using TradeFlow.Infrastructure.Persistence
@attribute [Authorize(Policy = "Permission:Customers:View")]

@inject TradeFlowDbContext DbContext
@inject NavigationManager Nav
@inject IAuthorizationService AuthService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject IAuditService AuditService

<PageTitle>Khách hàng - TradeFlow</PageTitle>

<div class="tf-page-header">
    <div class="tf-page-header-left">
        <h1 class="tf-page-title">Khách hàng</h1>
        <p class="tf-page-subtitle">Quản lý danh sách đối tác khách hàng và thông tin liên hệ</p>
    </div>
    <div class="tf-page-actions">
        <AuthorizeView Policy="Permission:Customers:Create">
            <a href="/doi-tac/khach-hang/them-moi" class="tf-btn tf-btn-primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                Thêm khách hàng
            </a>
        </AuthorizeView>
    </div>
</div>

<div class="tf-card tf-mb-4" style="padding: 12px 16px;">
    <input type="text"
           class="tf-input"
           placeholder="Tìm theo mã KH, mã nội bộ, tên khách hàng, tên công ty, MST, SĐT, email..."
           value="@_searchTerm"
           @oninput="OnSearchInput" />
</div>

<div class="tf-card">
    <div class="tf-card-body" style="padding:0; overflow-x: auto;">
        <table class="tf-table">
            <thead>
                <tr>
                    <th style="min-width: 120px;">Mã KH</th>
                    <th style="min-width: 110px;">Mã nội bộ</th>
                    <th style="min-width: 180px;">Tên khách hàng</th>
                    <th style="min-width: 180px;">Tên công ty</th>
                    <th>MST</th>
                    <th>Điện thoại</th>
                    <th>Email</th>
                    <th style="text-align:center;">Trạng thái</th>
                    <th style="text-align:right;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (_items == null)
                {
                    <tr><td colspan="9" style="text-align:center; padding: 24px;">Đang tải dữ liệu...</td></tr>
                }
                else if (!FilteredItems.Any())
                {
                    <tr><td colspan="9"><div class="tf-empty"><div class="tf-empty-title">Chưa có khách hàng phù hợp</div></div></td></tr>
                }
                else
                {
                    foreach (var item in FilteredItems)
                    {
                        <tr>
                            <td>
                                <span style="font-family: monospace; font-weight: 600; color: var(--tf-primary);">@item.Code</span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.BusinessCode))
                                {
                                    <span class="tf-badge tf-badge-info">@item.BusinessCode</span>
                                }
                                else
                                {
                                    <span style="color:var(--tf-text-muted);">-</span>
                                }
                            </td>
                            <td style="font-weight: 500;">@item.Name</td>
                            <td>@(item.CompanyName ?? "-")</td>
                            <td>@(item.TaxCode ?? "-")</td>
                            <td>@(item.Phone ?? "-")</td>
                            <td>@(item.Email ?? "-")</td>
                            <td style="text-align:center;">
                                @if (item.IsActive)
                                {
                                    <span class="tf-badge tf-badge-success">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="tf-badge tf-badge-neutral">Tạm dừng</span>
                                }
                            </td>
                            <td style="text-align:right;">
                                <AuthorizeView Policy="Permission:Customers:Edit">
                                    <a href="/doi-tac/khach-hang/sua/@item.Id" class="tf-btn tf-btn-ghost tf-btn-sm">Sửa</a>
                                </AuthorizeView>
                                <AuthorizeView Policy="Permission:Customers:Delete">
                                    <button class="tf-btn tf-btn-ghost tf-btn-sm" style="color:var(--tf-danger);" @onclick="() => ConfirmDelete(item.Id, item.Name ?? string.Empty)">Xóa</button>
                                </AuthorizeView>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private int? _itemToDeleteId;
    private string _itemToDeleteName = "";
    private string? _deleteError;

    private List<Customer>? _items;
    private string _searchTerm = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _items = await DbContext.Customers
            .OrderBy(x => x.Code)
            .ToListAsync();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? string.Empty;
    }

    private IEnumerable<Customer> FilteredItems
    {
        get
        {
            if (_items == null) return Enumerable.Empty<Customer>();

            if (string.IsNullOrWhiteSpace(_searchTerm))
            {
                return _items;
            }

            var term = _searchTerm.Trim().ToLower();
            return _items.Where(x =>
                (x.Code != null && x.Code.ToLower().Contains(term)) ||
                (x.BusinessCode != null && x.BusinessCode.ToLower().Contains(term)) ||
                (x.Name != null && x.Name.ToLower().Contains(term)) ||
                (x.CompanyName != null && x.CompanyName.ToLower().Contains(term)) ||
                (x.TaxCode != null && x.TaxCode.ToLower().Contains(term)) ||
                (x.Phone != null && x.Phone.ToLower().Contains(term)) ||
                (x.Email != null && x.Email.ToLower().Contains(term)));
        }
    }

    private void ConfirmDelete(int id, string name)
    {
        _itemToDeleteId = id;
        _itemToDeleteName = name;
        _deleteError = null;
    }

    private void CancelDelete()
    {
        _itemToDeleteId = null;
        _deleteError = null;
    }

    private async Task ExecuteDelete()
    {
        if (_itemToDeleteId == null) return;
        
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!(await AuthService.AuthorizeAsync(authState.User, "Permission:Customers:Delete")).Succeeded)
        {
            _deleteError = "Bạn không có quyền thực hiện thao tác này.";
            return;
        }

        try
        {
            int id = _itemToDeleteId.Value;
            var entity = await DbContext.Customers.FindAsync(id);
            if (entity == null)
            {
                CancelDelete();
                return;
            }

            bool isReferenced = await DbContext.SalesOrders.AnyAsync(x => x.CustomerId == id) || await DbContext.Invoices.AnyAsync(x => x.CustomerId == id);

            if (isReferenced)
            {
                entity.IsActive = false;
            }
            else
            {
                DbContext.Remove(entity);
            }

            await DbContext.SaveChangesAsync();
            await AuditService.LogAsync(TradeFlow.Domain.Enums.AuditEventType.CustomerDeleted, authState.User.Identity?.Name ?? "System", "Customer", id.ToString(), "Xóa hoặc ngừng hoạt động khách hàng", authState.User.Identity?.Name);
            CancelDelete();
            
            await OnInitializedAsync();
        }
        catch (Exception ex)
        {
            _deleteError = "Đã xảy ra lỗi: " + ex.Message;
        }
    }
}
