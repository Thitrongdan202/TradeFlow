@page "/doi-tac/khach-hang"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Domain.Entities.MasterData
@using TradeFlow.Infrastructure.Persistence
@attribute [Authorize(Policy = "Permission:Customers:View")]

@inject TradeFlowDbContext DbContext
@inject NavigationManager Nav
@inject IAuthorizationService AuthService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject IAuditService AuditService

<PageTitle>Khách hàng - TradeFlow</PageTitle>

<div class="tf-page-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 16px;">
    <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">
        <div>
            <h1 class="tf-page-title" style="margin: 0; font-size: 20px;">Khách hàng</h1>
            <p class="tf-page-subtitle" style="margin: 2px 0 0; font-size: 12px;">Quản lý danh sách đối tác khách hàng và thông tin liên hệ</p>
        </div>
        <div style="width: 340px; max-width: 100%;">
            <DebouncedSearchInput Placeholder="Tìm theo tên, mã KH, MST, SĐT, email..."
                                  Value="@_searchTerm"
                                  ValueChanged="OnSearchChanged" />
        </div>
    </div>
    <div class="tf-page-actions">
        <AuthorizeView Policy="Permission:Customers:Create">
            <a href="/doi-tac/khach-hang/them-moi" class="tf-btn tf-btn-primary" style="display: inline-flex; align-items: center; gap: 6px; height: 36px; white-space: nowrap;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                <span>Thêm khách hàng</span>
            </a>
        </AuthorizeView>
    </div>
</div>

<TfMasterDetailLayout SidebarWidth="260px">
    <SidebarContent>
        <FilterSidebar Title="Bộ lọc khách hàng" HasActiveFilters="@HasActiveFilters" OnClearFilters="ClearAllFilters">
            <div class="tf-filter-card tf-mb-3">
                <div class="tf-filter-header">
                    <span class="tf-filter-title">Trạng thái</span>
                </div>
                <div class="tf-filter-body">
                    <label class="tf-filter-option @(_statusFilter == null ? "selected" : "")" @onclick="() => SetStatusFilter(null)">
                        <input type="radio" name="custStatus" checked="@(_statusFilter == null)" />
                        <span>Tất cả</span>
                        <span class="tf-filter-count">@(_items?.Count ?? 0)</span>
                    </label>
                    <label class="tf-filter-option @(_statusFilter == true ? "selected" : "")" @onclick="() => SetStatusFilter(true)">
                        <input type="radio" name="custStatus" checked="@(_statusFilter == true)" />
                        <span>Đang hoạt động</span>
                        <span class="tf-filter-count">@(_items?.Count(p => p.IsActive) ?? 0)</span>
                    </label>
                    <label class="tf-filter-option @(_statusFilter == false ? "selected" : "")" @onclick="() => SetStatusFilter(false)">
                        <input type="radio" name="custStatus" checked="@(_statusFilter == false)" />
                        <span>Ngừng hoạt động</span>
                        <span class="tf-filter-count">@(_items?.Count(p => !p.IsActive) ?? 0)</span>
                    </label>
                </div>
            </div>
        </FilterSidebar>
    </SidebarContent>

    <MainContent>
        <div class="tf-card">
            <div class="tf-card-body" style="padding:0; overflow-x: auto;">
        
@if (_selectedItems.Count > 0)
{
    <div class="tw-bg-blue-50/80 tw-border tw-border-blue-200 tw-p-3.5 tw-rounded-lg tw-mb-4 tw-flex tw-justify-between tw-items-center tw-shadow-xs">
        <span class="tw-text-blue-900 tw-font-medium tw-text-sm">Đã chọn @_selectedItems.Count bản ghi</span>
        <AuthorizeView Policy="Permission:Customers:Delete">
            <button type="button" class="tf-btn tf-btn-sm tf-btn-danger" @onclick="ConfirmBulkDelete">Xóa đã chọn</button>
        </AuthorizeView>
    </div>
}

<TfModal IsOpen="@_showBulkDeleteModal"
         Title="@($"Xóa {_selectedItems.Count} bản ghi đã chọn?")"
         Size="md"
         OnClose="CancelBulkDelete">
    <BodyContent>
        <p class="tw-text-slate-600 tw-mb-4">Hành động này không thể hoàn tác. Các bản ghi đang được sử dụng sẽ bị bỏ qua hoặc vô hiệu hóa thay vì xóa hoàn toàn.</p>
        @if (_bulkDeleteErrors.Count > 0)
        {
            <div class="tf-alert tf-alert-error tw-mb-4 tw-max-h-36 tw-overflow-y-auto">
                <ul class="tw-m-0 tw-pl-5">
                    @foreach (var err in _bulkDeleteErrors)
                    {
                        <li>@err</li>
                    }
                </ul>
            </div>
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="tf-btn tf-btn-secondary" @onclick="CancelBulkDelete">Hủy</button>
        <LoadingButton Class="tf-btn tf-btn-danger"
                       IsLoading="@_isBulkDeleting"
                       LoadingText="Đang xử lý..."
                       OnClick="ExecuteBulkDelete">
            Xóa tất cả
        </LoadingButton>
    </FooterContent>
</TfModal>

@if (_items == null)
{
    <div style="padding: 16px;">
        <Skeleton Type="table" Rows="6" Columns="10" />
    </div>
}
else
{
    <div class="tf-table-loading-container">
        <TableLoadingOverlay Visible="@_isRefreshing" Message="Đang cập nhật..." />
        <table class="tf-table">
            <thead>
                <tr>
                    <th style="width: 40px; text-align: center;"><input type="checkbox" @onchange="ToggleSelectAll" checked="@(FilteredItems.Any() && _selectedItems.Count == FilteredItems.Count())" /></th>
                    <th style="min-width: 120px;">Mã KH</th>
                    <th style="min-width: 110px;">Mã nội bộ</th>
                    <th style="min-width: 180px;">Tên khách hàng</th>
                    <th style="min-width: 180px;">Tên công ty</th>
                    <th>MST</th>
                    <th>Điện thoại</th>
                    <th>Email</th>
                    <th style="text-align:center;">Trạng thái</th>
                    <th style="text-align:right;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!FilteredItems.Any())
                {
                    <tr><td colspan="10"><div class="tf-empty"><div class="tf-empty-title">Chưa có khách hàng phù hợp</div></div></td></tr>
                }
                else
                {
                    foreach (var item in PagedItems)
                    {
                        <tr>
                            <td style="text-align: center;"><input type="checkbox" @onchange="@(e => ToggleSelect(item.Id, e))" checked="@(_selectedItems.Contains(item.Id))" /></td>
                            <td>
                                <span class="tw-font-mono tw-font-semibold tw-text-indigo-700 tw-bg-indigo-50/70 tw-px-2 tw-py-0.5 tw-rounded tw-text-xs">@item.Code</span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.BusinessCode))
                                {
                                    <TfBadge Variant="info" Text="@item.BusinessCode" />
                                }
                                else
                                {
                                    <span class="tw-text-slate-400">-</span>
                                }
                            </td>
                            <td class="tw-font-medium tw-text-slate-900">@item.Name</td>
                            <td class="tw-text-slate-700">@(item.CompanyName ?? "-")</td>
                            <td class="tw-text-slate-600">@(item.TaxCode ?? "-")</td>
                            <td class="tw-text-slate-600">@(item.Phone ?? "-")</td>
                            <td class="tw-text-slate-600">@(item.Email ?? "-")</td>
                            <td style="text-align:center;">
                                <TfBadge Variant="@(item.IsActive ? "success" : "gray")"
                                         Dot="true"
                                         Text="@(item.IsActive ? "Hoạt động" : "Tạm dừng")" />
                            </td>
                            <td style="text-align:right;">
                                <div class="tw-inline-flex tw-gap-1">
                                    <AuthorizeView Policy="Permission:Customers:Edit">
                                        <a href="/doi-tac/khach-hang/sua/@item.Id" class="tf-btn tf-btn-ghost tf-btn-sm">Sửa</a>
                                    </AuthorizeView>
                                    <AuthorizeView Policy="Permission:Customers:Delete">
                                        <button class="tf-btn tf-btn-ghost tf-btn-sm tw-text-red-600 hover:tw-bg-red-50" @onclick="() => ConfirmDelete(item.Id, item.Name ?? string.Empty)">Xóa</button>
                                    </AuthorizeView>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        @if (FilteredItems.Any())
        {
            <TfPagination CurrentPage="@_currentPage"
                          PageSize="@_pageSize"
                          TotalCount="@FilteredItems.Count()"
                          ItemName="khách hàng"
                          CurrentPageChanged="@(p => _currentPage = p)"
                          PageSizeChanged="@(s => { _pageSize = s; _currentPage = 1; })" />
        }
    </div>
}
            </div>
        </div>
    </MainContent>
</TfMasterDetailLayout>

<TfModal IsOpen="@(_itemToDeleteId != null)"
         Title="Xóa dữ liệu?"
         Size="sm"
         OnClose="CancelDelete">
    <BodyContent>
        <p class="tw-text-slate-600 tw-mb-4">Bạn có chắc chắn muốn xóa "<strong>@(_itemToDeleteName)</strong>"?</p>
        @if (!string.IsNullOrEmpty(_deleteError))
        {
            <div class="tf-alert tf-alert-error tw-mb-3">
                @_deleteError
            </div>
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="tf-btn tf-btn-secondary" @onclick="CancelDelete">Hủy</button>
        <LoadingButton Class="tf-btn tf-btn-danger"
                       IsLoading="@_isDeleting"
                       LoadingText="Đang xóa..."
                       OnClick="ExecuteDelete">
            Xóa
        </LoadingButton>
    </FooterContent>
</TfModal>

@code {
    private int? _itemToDeleteId;
    private string _itemToDeleteName = "";
    private string? _deleteError;
    private bool _isDeleting = false;
    private bool _isRefreshing = false;

    private List<Customer>? _items;
    private string _searchTerm = string.Empty;
    private bool? _statusFilter;
    private int _currentPage = 1;
    private int _pageSize = 20;

    private bool HasActiveFilters => !string.IsNullOrEmpty(_searchTerm) || _statusFilter.HasValue;

    private void SetStatusFilter(bool? status) 
    { 
        _statusFilter = status; 
        _currentPage = 1; 
    }
    
    private void ClearAllFilters() 
    { 
        _searchTerm = string.Empty; 
        _statusFilter = null; 
        _currentPage = 1; 
    }

    protected override async Task OnInitializedAsync()
    {
        _items = await DbContext.Customers
            .OrderBy(x => x.Code)
            .ToListAsync();
    }

    private void OnSearchChanged(string val)
    {
        _searchTerm = val;
        _currentPage = 1;
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? string.Empty;
        _currentPage = 1;
    }

    private IEnumerable<Customer> PagedItems =>
        FilteredItems.Skip((_currentPage - 1) * _pageSize).Take(_pageSize);

    private IEnumerable<Customer> FilteredItems
    {
        get
        {
            if (_items == null) return Enumerable.Empty<Customer>();

            var q = _items.AsEnumerable();

            if (_statusFilter.HasValue)
            {
                q = q.Where(x => x.IsActive == _statusFilter.Value);
            }

            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                var term = _searchTerm.Trim().ToLower();
                q = q.Where(x =>
                    (x.Code != null && x.Code.ToLower().Contains(term)) ||
                    (x.BusinessCode != null && x.BusinessCode.ToLower().Contains(term)) ||
                    (x.Name != null && x.Name.ToLower().Contains(term)) ||
                    (x.CompanyName != null && x.CompanyName.ToLower().Contains(term)) ||
                    (x.TaxCode != null && x.TaxCode.ToLower().Contains(term)) ||
                    (x.Phone != null && x.Phone.ToLower().Contains(term)) ||
                    (x.Email != null && x.Email.ToLower().Contains(term)));
            }

            return q;
        }
    }

    private void ConfirmDelete(int id, string name)
    {
        _itemToDeleteId = id;
        _itemToDeleteName = name;
        _deleteError = null;
    }

    private void CancelDelete()
    {
        _itemToDeleteId = null;
        _deleteError = null;
    }

    private async Task ExecuteDelete()
    {
        if (_itemToDeleteId == null) return;
        
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!(await AuthService.AuthorizeAsync(authState.User, "Permission:Customers:Delete")).Succeeded)
        {
            _deleteError = "Bạn không có quyền thực hiện thao tác này.";
            return;
        }

        try
        {
            _isDeleting = true;
            int id = _itemToDeleteId.Value;
            var entity = await DbContext.Customers.FindAsync(id);
            if (entity == null)
            {
                CancelDelete();
                return;
            }

            bool isReferenced = await DbContext.SalesOrders.AnyAsync(x => x.CustomerId == id) || await DbContext.Invoices.AnyAsync(x => x.CustomerId == id);

            if (isReferenced)
            {
                entity.IsActive = false;
            }
            else
            {
                DbContext.Remove(entity);
            }

            await DbContext.SaveChangesAsync();
            await AuditService.LogAsync(TradeFlow.Domain.Enums.AuditEventType.CustomerDeleted, authState.User.Identity?.Name ?? "System", "Customer", id.ToString(), "Xóa hoặc ngừng hoạt động khách hàng", authState.User.Identity?.Name);
            CancelDelete();
            
            await OnInitializedAsync();
        }
        catch (Exception ex)
        {
            _deleteError = "Đã xảy ra lỗi: " + ex.Message;
        }
        finally
        {
            _isDeleting = false;
        }
    }

    private HashSet<int> _selectedItems = new();
    private bool _showBulkDeleteModal = false;
    private List<string> _bulkDeleteErrors = new();
    private bool _isBulkDeleting = false;

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        if (e.Value is bool isChecked && isChecked)
        {
            _selectedItems = new HashSet<int>(FilteredItems.Select(x => x.Id));
        }
        else
        {
            _selectedItems.Clear();
        }
    }

    private void ToggleSelect(int id, ChangeEventArgs e)
    {
        if (e.Value is bool isChecked && isChecked)
        {
            _selectedItems.Add(id);
        }
        else
        {
            _selectedItems.Remove(id);
        }
    }

    private void ConfirmBulkDelete()
    {
        _bulkDeleteErrors.Clear();
        _showBulkDeleteModal = true;
    }

    private void CancelBulkDelete()
    {
        _showBulkDeleteModal = false;
        _isBulkDeleting = false;
    }

    private async Task ExecuteBulkDelete()
    {
        if (_selectedItems.Count == 0) return;
        _isBulkDeleting = true;
        _bulkDeleteErrors.Clear();
        StateHasChanged();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!(await AuthService.AuthorizeAsync(authState.User, "Permission:Customers:Delete")).Succeeded)
        {
            _bulkDeleteErrors.Add("Bạn không có quyền thực hiện thao tác này.");
            _isBulkDeleting = false;
            return;
        }

        try
        {
            int successCount = 0;
            var idsToProcess = _selectedItems.ToList();
            
            foreach (var id in idsToProcess)
            {
                _itemToDeleteId = id; // reuse the id for the logic block
                try 
                {
                    await ProcessSingleDelete(id);
                    _selectedItems.Remove(id);
                    successCount++;
                } 
                catch (Exception ex)
                {
                    _bulkDeleteErrors.Add($"Bản ghi ID {id}: {ex.Message}");
                }
            }

            if (successCount > 0)
            {
                await OnInitializedAsync();
            }
            
            if (_selectedItems.Count == 0)
            {
                CancelBulkDelete();
            }
        }
        finally
        {
            _isBulkDeleting = false;
            _itemToDeleteId = null;
            StateHasChanged();
        }
    }

    private async Task ProcessSingleDelete(int currentId)
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        int id = _itemToDeleteId.Value;
            var entity = await DbContext.Customers.FindAsync(id);
            if (entity == null)
            {
                
                return;
            }

            bool isReferenced = await DbContext.SalesOrders.AnyAsync(x => x.CustomerId == id) || await DbContext.Invoices.AnyAsync(x => x.CustomerId == id);

            if (isReferenced)
            {
                entity.IsActive = false;
            }
            else
            {
                DbContext.Remove(entity);
            }

            await DbContext.SaveChangesAsync();
            await AuditService.LogAsync(TradeFlow.Domain.Enums.AuditEventType.CustomerDeleted, authState.User.Identity?.Name ?? "System", "Customer", id.ToString(), "Xóa hoặc ngừng hoạt động khách hàng", authState.User.Identity?.Name);
            
    }
}
