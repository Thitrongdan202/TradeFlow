@page "/doi-tac/nha-cung-cap/them-moi"
@page "/doi-tac/nha-cung-cap/sua/{Id:int}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using TradeFlow.Application.Common.Constants
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Domain.Entities.MasterData
@using TradeFlow.Infrastructure.Persistence
@using TradeFlow.Domain.Enums
@attribute [Authorize]

@inject TradeFlowDbContext DbContext
@inject ISystemCodeGenerator CodeGenerator
@inject IAuditService AuditService
@inject NavigationManager Nav
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject ICurrentUserService CurrentUser

<PageTitle>@(IsEdit ? "Sửa" : "Thêm") Nhà cung cấp - TradeFlow</PageTitle>

<div class="tf-page-header">
    <div class="tf-page-header-left">
        <h1 class="tf-page-title">@(IsEdit ? "Sửa" : "Thêm") Nhà cung cấp</h1>
        <p class="tf-page-subtitle">Quản lý thông tin nhà cung cấp và đối tác nguồn hàng</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="tf-alert tf-alert-error tf-mb-4">@_errorMessage</div>
}

@if (_model == null)
{
    <div style="padding:24px;text-align:center;">Đang tải thông tin...</div>
}
else
{
    <div class="tf-card" style="max-width: 800px;">
        <div class="tf-card-body">
            <EditForm Model="_model" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                    <div class="tf-form-group">
                        <label class="tf-label">Mã nhà cung cấp <span style="font-size:12px;color:var(--tf-text-muted);">(Tự động sinh)</span></label>
                        <input type="text" class="tf-input" value="@_displaySystemCode" readonly disabled style="background:var(--tf-gray-100);cursor:not-allowed;font-weight:600;" />
                    </div>
                    <div class="tf-form-group">
                        <label class="tf-label">Mã nội bộ <span style="font-size:12px;color:var(--tf-text-muted);">(Tùy chọn)</span></label>
                        <InputText @bind-Value="_model.BusinessCode" class="tf-input" placeholder="Mã phân loại nhà cung cấp riêng" />
                    </div>
                </div>

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                    <div class="tf-form-group">
                        <label class="tf-label">Tên nhà cung cấp <span style="color:var(--tf-error);">*</span></label>
                        <InputText @bind-Value="_model.Name" class="tf-input" placeholder="Tên nhà cung cấp" />
                    </div>
                    <div class="tf-form-group">
                        <label class="tf-label">Tên công ty / Doanh nghiệp</label>
                        <InputText @bind-Value="_model.CompanyName" class="tf-input" placeholder="Tên pháp nhân công ty" />
                    </div>
                </div>

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                    <div class="tf-form-group">
                        <label class="tf-label">Mã số thuế</label>
                        <InputText @bind-Value="_model.TaxCode" class="tf-input" placeholder="Mã số thuế nhà cung cấp" />
                    </div>
                    <div class="tf-form-group">
                        <label class="tf-label">Người liên hệ</label>
                        <InputText @bind-Value="_model.ContactPerson" class="tf-input" placeholder="Họ và tên người đại diện bán hàng" />
                    </div>
                </div>

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                    <div class="tf-form-group">
                        <label class="tf-label">Số điện thoại</label>
                        <InputText @bind-Value="_model.Phone" class="tf-input" placeholder="Số điện thoại liên hệ" />
                    </div>
                    <div class="tf-form-group">
                        <label class="tf-label">Email</label>
                        <InputText @bind-Value="_model.Email" class="tf-input" placeholder="Địa chỉ email nhận báo giá / đơn hàng" />
                    </div>
                </div>

                <div class="tf-form-group">
                    <label class="tf-label">Địa chỉ</label>
                    <InputText @bind-Value="_model.Address" class="tf-input" placeholder="Địa chỉ trụ sở / kho nhà cung cấp" />
                </div>

                <div class="tf-form-group">
                    <label class="tf-label">Ghi chú</label>
                    <InputTextArea @bind-Value="_model.Notes" class="tf-input" rows="2" placeholder="Ghi chú về điều khoản thanh toán, giao hàng..." />
                </div>

                <div class="tf-form-group">
                    <label class="tf-label" style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                        <InputCheckbox @bind-Value="_model.IsActive" />
                        <span>Đang hoạt động</span>
                    </label>
                </div>

                <div class="tf-form-actions" style="display: flex; gap: 12px; justify-content: flex-end; margin-top: 24px;">
                    <a href="/doi-tac/nha-cung-cap" class="tf-btn tf-btn-secondary">Hủy bỏ</a>
                    
                @if (IsEdit)
                {
                    <AuthorizeView Policy="Permission:Suppliers:Delete" Context="authContext">
                        <button type="button" class="tf-btn tf-btn-danger" style="margin-left: auto;" @onclick="ConfirmDelete">Xóa</button>
                    </AuthorizeView>
                }
<button type="submit" class="tf-btn tf-btn-primary">@(IsEdit ? "Lưu thay đổi" : "Tạo nhà cung cấp")</button>
                </div>
            </EditForm>
        </div>
    </div>
}


@if (_showDeleteModal)
{
    <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center;">
        <div style="background: white; padding: 24px; border-radius: 8px; width: 400px; max-width: 90%; box-shadow: 0 10px 25px rgba(0,0,0,0.2);">
            <h3 style="margin-top: 0; margin-bottom: 16px; font-size: 18px; color: var(--tf-danger);">Xóa dữ liệu?</h3>
            <p style="margin-bottom: 24px;">Bạn có chắc chắn muốn xóa bản ghi này?</p>
            @if (!string.IsNullOrEmpty(_deleteError))
            {
                <div class="tf-alert tf-alert-danger" style="margin-bottom: 16px;">
                    @_deleteError
                </div>
            }
            <div style="display: flex; justify-content: flex-end; gap: 12px;">
                <button type="button" class="tf-btn tf-btn-outline-secondary" @onclick="CancelDelete">Hủy</button>
                <button type="button" class="tf-btn tf-btn-danger" @onclick="ExecuteDelete">Xóa</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }
    private bool IsEdit => Id.HasValue;
    private Supplier? _model;
    private string _displaySystemCode = string.Empty;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (IsEdit)
        {
            if (!CurrentUser.HasPermission("Suppliers", "Edit"))
            {
                Nav.NavigateTo("/Account/AccessDenied");
                return;
            }
            _model = await DbContext.Suppliers.FindAsync(Id);
            if (_model == null)
            {
                Nav.NavigateTo("/doi-tac/nha-cung-cap");
                return;
            }
            _displaySystemCode = _model.Code;
        }
        else
        {
            if (!CurrentUser.HasPermission("Suppliers", "Create"))
            {
                Nav.NavigateTo("/Account/AccessDenied");
                return;
            }
            _model = new Supplier { IsActive = true };
            _displaySystemCode = await CodeGenerator.PeekNextCodeAsync(SystemCodeConstants.Supplier) + " (Tự sinh)";
        }
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            _errorMessage = null;

            if (string.IsNullOrWhiteSpace(_model!.Name))
            {
                _errorMessage = "Tên nhà cung cấp là bắt buộc.";
                return;
            }

            if (IsEdit)
            {
                _model.UpdatedAt = DateTime.UtcNow;
                _model.UpdatedBy = CurrentUser.UserName;
                DbContext.Suppliers.Update(_model);
                await AuditService.LogAsync(AuditEventType.SupplierUpdated, CurrentUser.UserName, "Supplier", _model.Id.ToString());
            }
            else
            {
                _model.Code = await CodeGenerator.GenerateCodeAsync(SystemCodeConstants.Supplier);
                _model.CreatedAt = DateTime.UtcNow;
                _model.CreatedBy = CurrentUser.UserName;
                DbContext.Suppliers.Add(_model);
                await AuditService.LogAsync(AuditEventType.SupplierCreated, CurrentUser.UserName, "Supplier", _model.Code);
            }

            await DbContext.SaveChangesAsync();
            Nav.NavigateTo("/doi-tac/nha-cung-cap");
        }
        catch (Exception ex)
        {
            _errorMessage = "Có lỗi xảy ra: " + ex.Message;
        }
    }

    private bool _showDeleteModal = false;
    private string? _deleteError;

    private void ConfirmDelete()
    {
        _showDeleteModal = true;
        _deleteError = null;
    }

    private void CancelDelete()
    {
        _showDeleteModal = false;
        _deleteError = null;
    }

    private async Task ExecuteDelete()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!(await AuthService.AuthorizeAsync(authState.User, "Permission:Suppliers:Delete")).Succeeded)
        {
            _deleteError = "Bạn không có quyền thực hiện thao tác này.";
            return;
        }

        try
        {
            bool isReferenced = false; if(isReferenced) { _model.IsActive = false; DbContext.Suppliers.Update(_model); } else {
            
                DbContext.Suppliers.Remove(_model);
            }

            await DbContext.SaveChangesAsync();
            await AuditService.LogAsync(TradeFlow.Domain.Enums.AuditEventType.SupplierDeleted, authState.User.Identity?.Name ?? "System", "Supplier", _model.Id.ToString(), "Xóa", authState.User.Identity?.Name);
            Nav.NavigateTo(Nav.Uri.Split('/')[1] == "danh-muc" ? "/danh-muc/" + Nav.Uri.Split('/')[2] : (Nav.Uri.Split('/')[1] == "doi-tac" ? "/doi-tac/" + Nav.Uri.Split('/')[2] : "/kho-hang"));
        }
        catch (Exception ex)
        {
            _deleteError = "Đã xảy ra lỗi: " + ex.Message;
        }
    }

}