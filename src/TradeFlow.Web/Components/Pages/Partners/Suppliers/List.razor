@page "/doi-tac/nha-cung-cap"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Domain.Entities.MasterData
@using TradeFlow.Infrastructure.Persistence
@attribute [Authorize(Policy = "Permission:Suppliers:View")]

@inject TradeFlowDbContext DbContext
@inject NavigationManager Nav
@inject IAuthorizationService AuthService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject IAuditService AuditService

<PageTitle>Nhà cung cấp - TradeFlow</PageTitle>

<div class="tf-page-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 16px;">
    <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">
        <div>
            <h1 class="tf-page-title" style="margin: 0; font-size: 20px;">Nhà cung cấp</h1>
            <p class="tf-page-subtitle" style="margin: 2px 0 0; font-size: 12px;">Quản lý danh sách nhà cung ứng vật tư và hàng hóa</p>
        </div>
        <div style="width: 340px; max-width: 100%;">
            <DebouncedSearchInput Placeholder="Tìm theo tên, mã NCC, MST, SĐT..."
                                  Value="@_searchTerm"
                                  ValueChanged="OnSearchChanged" />
        </div>
    </div>
    <div class="tf-page-actions">
        <AuthorizeView Policy="Permission:Suppliers:Create">
            <a href="/doi-tac/nha-cung-cap/them-moi" class="tf-btn tf-btn-primary" style="display: inline-flex; align-items: center; gap: 6px; height: 36px; white-space: nowrap;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                <span>Thêm nhà cung cấp</span>
            </a>
        </AuthorizeView>
    </div>
</div>

<div class="tf-product-layout">
    <div class="tf-product-sidebar">
        <FilterSidebar Title="Bộ lọc nhà cung cấp" HasActiveFilters="@HasActiveFilters" OnClearFilters="ClearAllFilters">
            <div class="tf-filter-card tf-mb-3">
                <div class="tf-filter-header">
                    <span class="tf-filter-title">Trạng thái</span>
                </div>
                <div class="tf-filter-body">
                    <label class="tf-filter-option @(_statusFilter == null ? "selected" : "")" @onclick="() => SetStatusFilter(null)">
                        <input type="radio" name="supStatus" checked="@(_statusFilter == null)" />
                        <span>Tất cả</span>
                        <span class="tf-filter-count">@(_items?.Count ?? 0)</span>
                    </label>
                    <label class="tf-filter-option @(_statusFilter == true ? "selected" : "")" @onclick="() => SetStatusFilter(true)">
                        <input type="radio" name="supStatus" checked="@(_statusFilter == true)" />
                        <span>Đang hoạt động</span>
                        <span class="tf-filter-count">@(_items?.Count(p => p.IsActive) ?? 0)</span>
                    </label>
                    <label class="tf-filter-option @(_statusFilter == false ? "selected" : "")" @onclick="() => SetStatusFilter(false)">
                        <input type="radio" name="supStatus" checked="@(_statusFilter == false)" />
                        <span>Ngừng hoạt động</span>
                        <span class="tf-filter-count">@(_items?.Count(p => !p.IsActive) ?? 0)</span>
                    </label>
                </div>
            </div>
        </FilterSidebar>
    </div>

    <div class="tf-product-main">
        <div class="tf-card">
            <div class="tf-card-body" style="padding:0; overflow-x: auto;">
        
@if (_selectedItems.Count > 0)
{
    <div style="background: #eff6ff; border: 1px solid #bfdbfe; padding: 12px 16px; border-radius: 6px; margin-bottom: 16px; display: flex; justify-content: space-between; align-items: center;">
        <span style="color: #1e3a8a; font-weight: 500;">Đã chọn @_selectedItems.Count bản ghi</span>
        <AuthorizeView Policy="Permission:Suppliers:Delete">
            <button type="button" class="tf-btn tf-btn-danger" @onclick="ConfirmBulkDelete">Xóa đã chọn</button>
        </AuthorizeView>
    </div>
}

@if (_showBulkDeleteModal)
{
    <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center;">
        <div style="background: white; padding: 24px; border-radius: 8px; width: 500px; max-width: 90%; box-shadow: 0 10px 25px rgba(0,0,0,0.2);">
            <h3 style="margin-top: 0; margin-bottom: 16px; font-size: 18px; color: var(--tf-danger);">Xóa @_selectedItems.Count bản ghi đã chọn?</h3>
            <p style="margin-bottom: 24px;">Hành động này không thể hoàn tác. Các bản ghi đang được sử dụng sẽ bị bỏ qua hoặc vô hiệu hóa thay vì xóa hoàn toàn.</p>
            @if (_bulkDeleteErrors.Count > 0)
            {
                <div class="tf-alert tf-alert-danger" style="margin-bottom: 16px; max-height: 150px; overflow-y: auto;">
                    <ul style="margin: 0; padding-left: 20px;">
                        @foreach (var err in _bulkDeleteErrors)
                        {
                            <li>@err</li>
                        }
                    </ul>
                </div>
            }
            <div style="display: flex; justify-content: flex-end; gap: 12px;">
                <button type="button" class="tf-btn tf-btn-outline-secondary" @onclick="CancelBulkDelete">Hủy</button>
                <LoadingButton Variant="danger"
                               IsLoading="@_isBulkDeleting"
                               LoadingText="Đang xử lý..."
                               Text="Xóa tất cả"
                               OnClick="ExecuteBulkDelete" />
            </div>
        </div>
    </div>
}

@if (_items == null)
{
    <Skeleton Type="table" Rows="6" Columns="9" />
}
else
{
    <div class="tf-table-loading-container">
        <TableLoadingOverlay Visible="@_isRefreshing" Message="Đang cập nhật..." />
        <table class="tf-table">
            <thead>
                  <tr>
                      <th style="width: 40px; text-align: center;"><input type="checkbox" @onchange="ToggleSelectAll" checked="@(FilteredItems.Any() && _selectedItems.Count == FilteredItems.Count())" /></th>
                    <th style="min-width: 120px;">Mã NCC</th>
                    <th style="min-width: 110px;">Mã nội bộ</th>
                    <th style="min-width: 180px;">Tên nhà cung cấp</th>
                    <th style="min-width: 180px;">Tên công ty</th>
                    <th>MST</th>
                    <th>Điện thoại</th>
                    <th style="text-align:center;">Trạng thái</th>
                    <th style="text-align:right;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!FilteredItems.Any())
                {
                    <tr><td colspan="9"><div class="tf-empty"><div class="tf-empty-title">Chưa có nhà cung cấp phù hợp</div></div></td></tr>
                }
                else
                {
                    foreach (var item in FilteredItems)
                    {
                        <tr>
                              <td style="text-align: center;"><input type="checkbox" @onchange="@(e => ToggleSelect(item.Id, e))" checked="@(_selectedItems.Contains(item.Id))" /></td>
                            <td>
                                <span style="font-family: monospace; font-weight: 600; color: var(--tf-primary);">@item.Code</span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.BusinessCode))
                                {
                                    <span class="tf-badge tf-badge-info">@item.BusinessCode</span>
                                }
                                else
                                {
                                    <span style="color:var(--tf-text-muted);">-</span>
                                }
                            </td>
                            <td style="font-weight: 500;">@item.Name</td>
                            <td>@(item.CompanyName ?? "-")</td>
                            <td>@(item.TaxCode ?? "-")</td>
                            <td>@(item.Phone ?? "-")</td>
                            <td style="text-align:center;">
                                @if (item.IsActive)
                                {
                                    <span class="tf-badge tf-badge-success">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="tf-badge tf-badge-neutral">Tạm dừng</span>
                                }
                            </td>
                            <td style="text-align:right;">
                                <AuthorizeView Policy="Permission:Suppliers:Edit">
                                    <a href="/doi-tac/nha-cung-cap/sua/@item.Id" class="tf-btn tf-btn-ghost tf-btn-sm">Sửa</a>
                                </AuthorizeView>
                                <AuthorizeView Policy="Permission:Suppliers:Delete">
                                    <button class="tf-btn tf-btn-ghost tf-btn-sm" style="color:var(--tf-danger);" @onclick="() => ConfirmDelete(item.Id, item.Name ?? string.Empty)">Xóa</button>
                                </AuthorizeView>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}
    </div>
</div>
    </div>
</div>

@if (_itemToDeleteId != null)
{
    <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center;">
        <div style="background: white; padding: 24px; border-radius: 8px; width: 400px; max-width: 90%; box-shadow: 0 10px 25px rgba(0,0,0,0.2);">
            <h3 style="margin-top: 0; margin-bottom: 16px; font-size: 18px; color: var(--tf-danger);">Xóa dữ liệu?</h3>
            <p style="margin-bottom: 24px;">Bạn có chắc chắn muốn xóa @_itemToDeleteName?</p>
            @if (!string.IsNullOrEmpty(_deleteError))
            {
                <div class="tf-alert tf-alert-danger" style="margin-bottom: 16px;">
                    @_deleteError
                </div>
            }
            <div style="display: flex; justify-content: flex-end; gap: 12px;">
                <button type="button" class="tf-btn tf-btn-outline-secondary" @onclick="CancelDelete">Hủy</button>
                <LoadingButton Variant="danger"
                               IsLoading="@_isDeleting"
                               LoadingText="Đang xóa..."
                               Text="Xóa"
                               OnClick="ExecuteDelete" />
            </div>
        </div>
    </div>
}

@code {
    private int? _itemToDeleteId;
    private string _itemToDeleteName = "";
    private string? _deleteError;

    private List<Supplier>? _items;
    private string _searchTerm = string.Empty;
    private bool? _statusFilter;
    private bool _isRefreshing = false;
    private bool _isDeleting = false;

    private bool HasActiveFilters => !string.IsNullOrEmpty(_searchTerm) || _statusFilter.HasValue;

    private void SetStatusFilter(bool? status) => _statusFilter = status;
    private void ClearAllFilters() { _searchTerm = string.Empty; _statusFilter = null; }

    protected override async Task OnInitializedAsync()
    {
        _items = await DbContext.Suppliers
            .OrderBy(x => x.Code)
            .ToListAsync();
    }

    private void OnSearchChanged(string val)
    {
        _searchTerm = val;
    }

    private IEnumerable<Supplier> FilteredItems
    {
        get
        {
            if (_items == null) return Enumerable.Empty<Supplier>();

            var q = _items.AsEnumerable();

            if (_statusFilter.HasValue)
            {
                q = q.Where(x => x.IsActive == _statusFilter.Value);
            }

            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                var term = _searchTerm.Trim().ToLower();
                q = q.Where(x =>
                    (x.Code != null && x.Code.ToLower().Contains(term)) ||
                    (x.BusinessCode != null && x.BusinessCode.ToLower().Contains(term)) ||
                    (x.Name != null && x.Name.ToLower().Contains(term)) ||
                    (x.CompanyName != null && x.CompanyName.ToLower().Contains(term)) ||
                    (x.TaxCode != null && x.TaxCode.ToLower().Contains(term)) ||
                    (x.Phone != null && x.Phone.ToLower().Contains(term)));
            }

            return q;
        }
    }

    private void ConfirmDelete(int id, string name)
    {
        _itemToDeleteId = id;
        _itemToDeleteName = name;
        _deleteError = null;
    }

    private void CancelDelete()
    {
        _itemToDeleteId = null;
        _deleteError = null;
    }

    private async Task ExecuteDelete()
    {
        if (_itemToDeleteId == null) return;
        
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!(await AuthService.AuthorizeAsync(authState.User, "Permission:Suppliers:Delete")).Succeeded)
        {
            _deleteError = "Bạn không có quyền thực hiện thao tác này.";
            return;
        }

        _isDeleting = true;
        try
        {
            int id = _itemToDeleteId.Value;
            var entity = await DbContext.Suppliers.FindAsync(id);
            if (entity == null)
            {
                CancelDelete();
                return;
            }

            bool isReferenced = false;

            if (isReferenced)
            {
                entity.IsActive = false;
            }
            else
            {
                DbContext.Remove(entity);
            }

            await DbContext.SaveChangesAsync();
            await AuditService.LogAsync(TradeFlow.Domain.Enums.AuditEventType.SupplierDeleted, authState.User.Identity?.Name ?? "System", "Supplier", id.ToString(), "Xóa nhà cung cấp", authState.User.Identity?.Name);
            CancelDelete();
            
            _isRefreshing = true;
            try
            {
                await OnInitializedAsync();
            }
            finally
            {
                _isRefreshing = false;
            }
        }
        catch (Exception ex)
        {
            _deleteError = "Đã xảy ra lỗi: " + ex.Message;
        }
        finally
        {
            _isDeleting = false;
        }
    }

    private HashSet<int> _selectedItems = new();
    private bool _showBulkDeleteModal = false;
    private List<string> _bulkDeleteErrors = new();
    private bool _isBulkDeleting = false;

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        if (e.Value is bool isChecked && isChecked)
        {
            _selectedItems = new HashSet<int>(FilteredItems.Select(x => x.Id));
        }
        else
        {
            _selectedItems.Clear();
        }
    }

    private void ToggleSelect(int id, ChangeEventArgs e)
    {
        if (e.Value is bool isChecked && isChecked)
        {
            _selectedItems.Add(id);
        }
        else
        {
            _selectedItems.Remove(id);
        }
    }

    private void ConfirmBulkDelete()
    {
        _bulkDeleteErrors.Clear();
        _showBulkDeleteModal = true;
    }

    private void CancelBulkDelete()
    {
        _showBulkDeleteModal = false;
        _isBulkDeleting = false;
    }

    private async Task ExecuteBulkDelete()
    {
        if (_selectedItems.Count == 0) return;
        _isBulkDeleting = true;
        _bulkDeleteErrors.Clear();
        StateHasChanged();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!(await AuthService.AuthorizeAsync(authState.User, "Permission:Suppliers:Delete")).Succeeded)
        {
            _bulkDeleteErrors.Add("Bạn không có quyền thực hiện thao tác này.");
            _isBulkDeleting = false;
            return;
        }

        try
        {
            int successCount = 0;
            var idsToProcess = _selectedItems.ToList();
            
            foreach (var id in idsToProcess)
            {
                _itemToDeleteId = id; // reuse the id for the logic block
                try 
                {
                    await ProcessSingleDelete(id);
                    _selectedItems.Remove(id);
                    successCount++;
                } 
                catch (Exception ex)
                {
                    _bulkDeleteErrors.Add($"Bản ghi ID {id}: {ex.Message}");
                }
            }

            if (successCount > 0)
            {
                _isRefreshing = true;
                try
                {
                    await OnInitializedAsync();
                }
                finally
                {
                    _isRefreshing = false;
                }
            }
            
            if (_selectedItems.Count == 0)
            {
                CancelBulkDelete();
            }
        }
        finally
        {
            _isBulkDeleting = false;
            _itemToDeleteId = null;
            StateHasChanged();
        }
    }

    private async Task ProcessSingleDelete(int currentId)
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        int id = _itemToDeleteId.Value;
            var entity = await DbContext.Suppliers.FindAsync(id);
            if (entity == null)
            {
                
                return;
            }

            bool isReferenced = false;

            if (isReferenced)
            {
                entity.IsActive = false;
            }
            else
            {
                DbContext.Remove(entity);
            }

            await DbContext.SaveChangesAsync();
            await AuditService.LogAsync(TradeFlow.Domain.Enums.AuditEventType.SupplierDeleted, authState.User.Identity?.Name ?? "System", "Supplier", id.ToString(), "Xóa nhà cung cấp", authState.User.Identity?.Name);
            
    }
}
