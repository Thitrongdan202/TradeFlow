@page "/doi-tac/nha-cung-cap"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Application.Common.Models.Partners
@using TradeFlow.Domain.Entities.MasterData
@using TradeFlow.Web.Components.Common
@using TradeFlow.Web.Components.Pages.Partners.Components
@attribute [Authorize(Policy = "Permission:Suppliers:View")]

@inject IPartnerService PartnerService
@inject NavigationManager Nav
@inject IAuthorizationService AuthService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject IAuditService AuditService

<PageTitle>Quản lý Nhà cung cấp - TradeFlow</PageTitle>

<div class="tf-page-container">
    @* 1. Page Header *@
    <div class="tf-page-header">
        <div class="tf-page-header-left">
            <h1 class="tf-page-title">Nhà cung cấp</h1>
            <p class="tf-page-subtitle">Quản lý danh sách nhà cung ứng vật tư, theo dõi công nợ phải trả và lịch sử mua hàng</p>
        </div>
        <div class="tf-page-header-actions">
            <div class="tf-header-search-wrap">
                <DebouncedSearchInput Placeholder="Tìm theo mã NCC, tên, công ty, MST, SĐT..."
                                      Value="@_filter.SearchTerm"
                                      ValueChanged="OnSearchChanged" />
            </div>

            <button type="button" class="tf-btn tf-btn-secondary @(_showSidebar ? "active" : "")" @onclick="ToggleSidebar" title="Bật/Tắt bộ lọc nâng cao">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                </svg>
                <span>Bộ lọc</span>
                @if (ActiveFilterCount > 0)
                {
                    <span class="tf-filter-active-count">@ActiveFilterCount</span>
                }
            </button>

            <AuthorizeView Policy="Permission:Suppliers:Edit">
                <button type="button" class="tf-btn tf-btn-secondary" @onclick="OpenCreatePaymentModal" title="Lập phiếu chi tiền nhà cung cấp">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="2" y="5" width="20" height="14" rx="2"/>
                        <line x1="2" y1="10" x2="22" y2="10"/>
                    </svg>
                    <span>Lập phiếu chi</span>
                </button>
            </AuthorizeView>

            <AuthorizeView Policy="Permission:Suppliers:Create">
                <a href="/doi-tac/nha-cung-cap/them-moi" class="tf-btn tf-btn-primary">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    <span>Thêm nhà cung cấp</span>
                </a>
            </AuthorizeView>
        </div>
    </div>

    @* 2. Summary Metric Cards *@
    <div class="tf-partner-metrics-grid">
        <div class="tf-partner-metric-card">
            <div class="tf-metric-icon-wrap supplier">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                    <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                    <line x1="12" y1="22.08" x2="12" y2="12"></line>
                </svg>
            </div>
            <div class="tf-metric-data">
                <div class="tf-metric-label">Tổng nhà cung cấp</div>
                <div class="tf-metric-value">@_totalCount</div>
                <div class="tf-metric-hint">@_activeCount đang hoạt động</div>
            </div>
        </div>

        <div class="tf-partner-metric-card @(_totalPayable > 0 ? "highlight-warning" : "")">
            <div class="tf-metric-icon-wrap payable">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
            </div>
            <div class="tf-metric-data">
                <div class="tf-metric-label">Nợ cần trả (Phải trả NCC)</div>
                <div class="tf-metric-value @(_totalPayable > 0 ? "text-warning" : "")">
                    @_totalPayable.ToString("N0") ₫
                </div>
                <div class="tf-metric-hint">
                    @if (_totalPayable > 0)
                    {
                        @($"{_debtSupplierCount} nhà cung cấp đang có công nợ")
                    }
                    else
                    {
                        <span>0 ₫ — Chưa phát sinh nợ nhập hàng</span>
                    }
                </div>
            </div>
        </div>

        <div class="tf-partner-metric-card">
            <div class="tf-metric-icon-wrap purchases">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="9" cy="21" r="1"></circle>
                    <circle cx="20" cy="21" r="1"></circle>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                </svg>
            </div>
            <div class="tf-metric-data">
                <div class="tf-metric-label">Tổng mua hàng</div>
                <div class="tf-metric-value text-primary">
                    @_totalPurchases.ToString("N0") ₫
                </div>
                <div class="tf-metric-hint">Giá trị mua hàng tích lũy</div>
            </div>
        </div>
    </div>

    @* 3. Master-Detail Split Layout *@
    <div class="tf-split-layout @(!_showSidebar ? "sidebar-collapsed" : "")">
        @* Left Filter Sidebar *@
        @if (_showSidebar)
        {
            <aside class="tf-filter-sidebar">
                <div class="tf-sidebar-header">
                    <span class="tf-sidebar-title">Bộ lọc nhà cung cấp</span>
                    @if (ActiveFilterCount > 0)
                    {
                        <button type="button" class="tf-btn-clear-filters" @onclick="ClearAllFilters">
                            Xóa lọc
                        </button>
                    }
                </div>

                <div class="tf-sidebar-body">
                    @* Filter: Trạng thái hoạt động *@
                    <div class="tf-filter-group">
                        <label class="tf-filter-label">Trạng thái</label>
                        <div class="tf-filter-pill-list">
                            <button type="button" class="tf-filter-pill @(!_filter.IsActive.HasValue ? "active" : "")"
                                    @onclick="() => SetStatus(null)">
                                Tất cả
                            </button>
                            <button type="button" class="tf-filter-pill @(_filter.IsActive == true ? "active" : "")"
                                    @onclick="() => SetStatus(true)">
                                Đang hoạt động
                            </button>
                            <button type="button" class="tf-filter-pill @(_filter.IsActive == false ? "active" : "")"
                                    @onclick="() => SetStatus(false)">
                                Ngừng hoạt động
                            </button>
                        </div>
                    </div>

                    @* Filter: Nợ cần trả *@
                    <div class="tf-filter-group">
                        <label class="tf-filter-label">Nợ cần trả (Phải trả NCC)</label>
                        <div class="tf-filter-pill-list tf-mb-2">
                            <button type="button" class="tf-filter-pill @(!_debtFilterMode.HasValue ? "active" : "")"
                                    @onclick="() => SetDebtMode(null)">
                                Tất cả
                            </button>
                            <button type="button" class="tf-filter-pill @(_debtFilterMode == 1 ? "active" : "")"
                                    @onclick="() => SetDebtMode(1)">
                                Có nợ (> 0)
                            </button>
                            <button type="button" class="tf-filter-pill @(_debtFilterMode == 0 ? "active" : "")"
                                    @onclick="() => SetDebtMode(0)">
                                Không nợ (= 0)
                            </button>
                        </div>
                        <div class="tf-range-inputs">
                            <input type="number" class="tf-input-sm" placeholder="Từ số tiền..." @bind="_filter.MinPayable" @bind:event="onchange" />
                            <span class="tf-range-sep">-</span>
                            <input type="number" class="tf-input-sm" placeholder="Tới số tiền..." @bind="_filter.MaxPayable" @bind:event="onchange" />
                        </div>
                    </div>

                    @* Filter: Ngày tạo *@
                    <div class="tf-filter-group">
                        <label class="tf-filter-label">Thời gian tạo</label>
                        <div class="tf-filter-pill-list tf-mb-2">
                            <button type="button" class="tf-filter-pill @(!_datePreset.HasValue ? "active" : "")"
                                    @onclick="() => SetDatePreset(null)">
                                Toàn thời gian
                            </button>
                            <button type="button" class="tf-filter-pill @(_datePreset == 1 ? "active" : "")"
                                    @onclick="() => SetDatePreset(1)">
                                Hôm nay
                            </button>
                            <button type="button" class="tf-filter-pill @(_datePreset == 30 ? "active" : "")"
                                    @onclick="() => SetDatePreset(30)">
                                Tháng này
                            </button>
                        </div>
                        <div class="tf-date-range-grid">
                            <div>
                                <span class="tf-sub-label">Từ ngày:</span>
                                <input type="date" class="tf-input-sm" @bind="_filter.CreatedFrom" />
                            </div>
                            <div>
                                <span class="tf-sub-label">Đến ngày:</span>
                                <input type="date" class="tf-input-sm" @bind="_filter.CreatedTo" />
                            </div>
                        </div>
                    </div>

                    @* Filter: Người tạo *@
                    @if (_creators.Any())
                    {
                        <div class="tf-filter-group">
                            <label class="tf-filter-label">Người tạo</label>
                            <select class="tf-select-sm" value="@_filter.CreatedBy" @onchange="OnCreatorChanged">
                                <option value="">Tất cả người tạo</option>
                                @foreach (var creator in _creators)
                                {
                                    <option value="@creator">@creator</option>
                                }
                            </select>
                        </div>
                    }
                </div>
            </aside>
        }

        @* Right Table Content *@
        <main class="tf-table-main-panel">
            @* Bulk Delete Action Bar (Only visible if user has delete permission & items selected) *@
            @if (_selectedIds.Any())
            {
                <div class="tf-bulk-actions-bar">
                    <span>Đã chọn <strong>@_selectedIds.Count</strong> nhà cung cấp</span>
                    <div class="tf-bulk-buttons">
                        <button type="button" class="tf-btn tf-btn-sm tf-btn-secondary" @onclick="() => _selectedIds.Clear()">
                            Bỏ chọn
                        </button>
                        <AuthorizeView Roles="Administrator">
                            <button type="button" class="tf-btn tf-btn-sm tf-btn-danger" @onclick="OpenBulkDeleteModal">
                                Xóa đã chọn (@_selectedIds.Count)
                            </button>
                        </AuthorizeView>
                    </div>
                </div>
            }

            <div class="tf-card">
                <div class="tf-card-body" style="padding:0; overflow-x:auto;">
                    @if (_isLoading)
                    {
                        <div style="padding: 24px;">
                            <Skeleton Type="table" Rows="6" Columns="8" />
                        </div>
                    }
                    else if (!_pagedResult.Items.Any())
                    {
                        <div class="tf-empty-state">
                            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                                <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                                <line x1="12" y1="22.08" x2="12" y2="12"></line>
                            </svg>
                            <h3>Không tìm thấy nhà cung cấp phù hợp</h3>
                            <p>Hãy thử thay đổi điều kiện tìm kiếm hoặc thiết lập lại bộ lọc.</p>
                            @if (ActiveFilterCount > 0)
                            {
                                <button type="button" class="tf-btn tf-btn-secondary tf-btn-sm tf-mt-2" @onclick="ClearAllFilters">
                                    Xóa toàn bộ bộ lọc
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <table class="tf-table">
                            <thead>
                                <tr>
                                    <th style="width: 40px; text-align: center;">
                                        <input type="checkbox" @onchange="ToggleSelectAll" checked="@(_pagedResult.Items.Any() && _selectedIds.Count == _pagedResult.Items.Count)" />
                                    </th>
                                    <th style="min-width: 120px;">Mã NCC</th>
                                    <th style="min-width: 220px;">Tên nhà cung cấp</th>
                                    <th style="min-width: 120px;">Điện thoại</th>
                                    <th style="min-width: 160px;">Email / Địa chỉ</th>
                                    <th style="min-width: 140px; text-align: right;">Nợ cần trả</th>
                                    <th style="min-width: 140px; text-align: right;">Tổng mua</th>
                                    <th style="min-width: 110px; text-align: center;">Trạng thái</th>
                                    <th style="min-width: 130px; text-align: right;">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _pagedResult.Items)
                                {
                                    <tr class="@(_selectedSupplierId == item.Id ? "row-selected" : "")" @onclick="() => OpenSupplierDrawer(item.Id)">
                                        <td style="text-align: center;" @onclick:stopPropagation="true">
                                            <input type="checkbox" @onchange="@(e => ToggleItemSelection(item.Id, e))" checked="@(_selectedIds.Contains(item.Id))" />
                                        </td>
                                        <td>
                                            <button type="button" class="tf-table-code-btn" @onclick="() => OpenSupplierDrawer(item.Id)">
                                                @item.Code
                                            </button>
                                        </td>
                                        <td>
                                            <div class="tf-table-supplier-name">
                                                <span class="tf-sup-name-text">@item.Name</span>
                                                @if (item.MatchingCustomerId.HasValue)
                                                {
                                                    <span class="tf-overlap-badge" title="Đối tác này đồng thời là Khách hàng (Mã: @item.MatchingCustomerCode)">
                                                        Cũng là KH (@item.MatchingCustomerCode)
                                                    </span>
                                                }
                                            </div>
                                            @if (!string.IsNullOrEmpty(item.CompanyName) && item.CompanyName != item.Name)
                                            {
                                                <div class="tf-table-subtext">@item.CompanyName</div>
                                            }
                                            @if (!string.IsNullOrEmpty(item.TaxCode))
                                            {
                                                <div class="tf-table-subtext font-mono">MST: @item.TaxCode</div>
                                            }
                                        </td>
                                        <td>
                                            <span class="tf-phone-text">@(!string.IsNullOrEmpty(item.Phone) ? item.Phone : "-")</span>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(item.Email))
                                            {
                                                <div class="tf-table-subtext">@item.Email</div>
                                            }
                                            @if (!string.IsNullOrEmpty(item.Address))
                                            {
                                                <div class="tf-table-subtext tw-truncate" style="max-width: 180px;" title="@item.Address">@item.Address</div>
                                            }
                                            @if (string.IsNullOrEmpty(item.Email) && string.IsNullOrEmpty(item.Address))
                                            {
                                                <span class="tw-text-slate-400">-</span>
                                            }
                                        </td>
                                        <td style="text-align: right;">
                                            @if (item.CurrentPayable > 0)
                                            {
                                                <span class="tf-debt-amount warning font-semibold">
                                                    @item.CurrentPayable.ToString("N0") ₫
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="tf-debt-amount neutral">0 ₫</span>
                                            }
                                        </td>
                                        <td style="text-align: right;">
                                            <span class="tf-sales-amount font-semibold">
                                                @item.TotalPurchases.ToString("N0") ₫
                                            </span>
                                        </td>
                                        <td style="text-align: center;">
                                            <TfBadge Variant="@(item.IsActive ? "success" : "gray")"
                                                     Dot="true"
                                                     Text="@(item.IsActive ? "Hoạt động" : "Tạm dừng")" />
                                        </td>
                                        <td style="text-align: right;" @onclick:stopPropagation="true">
                                            <div class="tf-row-actions">
                                                <button type="button" class="tf-btn-action" title="Xem chi tiết" @onclick="() => OpenSupplierDrawer(item.Id)">
                                                    Chi tiết
                                                </button>
                                                <AuthorizeView Policy="Permission:Suppliers:Edit">
                                                    <button type="button" class="tf-btn-action" title="Lập phiếu chi tiền nhà cung cấp" @onclick="() => OpenRowPaymentModal(item)">
                                                        Chi tiền
                                                    </button>
                                                    <a href="/doi-tac/nha-cung-cap/sua/@item.Id" class="tf-btn-action edit" title="Sửa thông tin">
                                                        Sửa
                                                    </a>
                                                </AuthorizeView>
                                                <AuthorizeView Roles="Administrator">
                                                    @if (!item.IsActive)
                                                    {
                                                        <button type="button" class="tf-btn-action delete" title="Xóa nhà cung cấp đã ngừng hoạt động" @onclick="() => ConfirmDelete(item.Id, item.Name, item.Code)">
                                                            Xóa
                                                        </button>
                                                    }
                                                </AuthorizeView>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        @* 4. Pagination *@
                        <div class="tf-pagination-container">
                            <TfPagination CurrentPage="@_filter.PageIndex"
                                          PageSize="@_filter.PageSize"
                                          TotalCount="@_pagedResult.TotalCount"
                                          ItemName="nhà cung cấp"
                                          PreferenceKey="suppliers"
                                          CurrentPageChanged="OnPageChanged"
                                          PageSizeChanged="OnPageSizeChanged" />
                        </div>
                    }
                </div>
            </div>
        </main>
    </div>
</div>

@* 5. Partner Detail Drawer Component *@
<PartnerDetailDrawer @bind-IsOpen="_isDrawerOpen"
                     PartnerType="PartnerType.Supplier"
                     PartnerId="@_selectedSupplierId"
                     OnClose="() => _selectedSupplierId = null"
                     OnDebtUpdated="LoadDataAsync" />

@* 6. Deletion Confirmation Modal *@
<TfModal IsOpen="@(_supplierToDeleteId.HasValue)"
         Title="Xác nhận xóa nhà cung cấp"
         Size="md"
         OnClose="CancelDelete">
    <BodyContent>
        <div class="tf-delete-dialog-content">
            <div class="tf-delete-warning-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                    <line x1="12" y1="9" x2="12" y2="13"></line>
                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
            </div>
            <div>
                <p class="tf-delete-msg">
                    Bạn có chắc chắn muốn xóa nhà cung cấp <strong>@_supplierToDeleteName</strong> (Mã: <code>@_supplierToDeleteCode</code>)?
                </p>
                <div class="tf-delete-policy-notice">
                    <strong>Chính sách bảo toàn chứng từ:</strong> Chỉ nhà cung cấp ở trạng thái <em>"Ngừng hoạt động"</em> và chưa từng phát sinh chứng từ giao dịch lịch sử (đơn mua hàng, thanh toán...) mới có thể xóa vĩnh viễn. Nếu nhà cung cấp đã có dữ liệu chứng từ tài chính, hệ thống sẽ từ chối xóa để đảm bảo toàn vẹn kế toán.
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_deleteMessage))
        {
            <div class="tf-alert @(_deleteIsWarning ? "tf-alert-warning" : "tf-alert-error") tf-mt-3">
                @_deleteMessage
            </div>
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="tf-btn tf-btn-secondary" @onclick="CancelDelete">Hủy</button>
        <LoadingButton Class="tf-btn tf-btn-danger"
                       IsLoading="@_isDeleting"
                       LoadingText="Đang xử lý..."
                       OnClick="ExecuteDelete">
            Xác nhận xóa
        </LoadingButton>
    </FooterContent>
</TfModal>

@* 7. Bulk Delete Modal *@
<TfModal IsOpen="@_showBulkDeleteModal"
         Title="@($"Xóa {_selectedIds.Count} nhà cung cấp đã chọn?")"
         Size="md"
         OnClose="() => _showBulkDeleteModal = false">
    <BodyContent>
        <p class="tf-delete-msg">
            Bạn có chắc chắn muốn xóa <strong>@_selectedIds.Count</strong> nhà cung cấp đã chọn?
        </p>
        <div class="tf-delete-policy-notice">
            Chỉ những nhà cung cấp ở trạng thái <em>Ngừng hoạt động</em> và chưa phát sinh chứng từ giao dịch lịch sử mới được xóa vĩnh viễn khỏi hệ thống.
        </div>
        @if (_bulkMessages.Any())
        {
            <div class="tf-alert tf-alert-warning tf-mt-3" style="max-height: 140px; overflow-y: auto;">
                <ul style="margin: 0; padding-left: 18px;">
                    @foreach (var msg in _bulkMessages)
                    {
                        <li>@msg</li>
                    }
                </ul>
            </div>
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="tf-btn tf-btn-secondary" @onclick="() => _showBulkDeleteModal = false">Hủy</button>
        <LoadingButton Class="tf-btn tf-btn-danger"
                       IsLoading="@_isBulkDeleting"
                       LoadingText="Đang xử lý..."
                       OnClick="ExecuteBulkDelete">
            Thực hiện xóa
        </LoadingButton>
    </FooterContent>
</TfModal>

@* 8. Debt Payment Modal *@
<DebtPaymentModal @bind-IsOpen="_isPaymentModalOpen"
                  PartnerType="PartnerType.Supplier"
                  PartnerId="_paymentPartnerId"
                  PartnerCode="@_paymentPartnerCode"
                  PartnerName="@_paymentPartnerName"
                  PartnerCompanyName="@_paymentPartnerCompanyName"
                  PartnerPhone="@_paymentPartnerPhone"
                  PartnerTaxCode="@_paymentPartnerTaxCode"
                  CurrentBalance="_paymentCurrentBalance"
                  OnPaymentRecorded="HandlePaymentRecorded" />

@code {
    private SupplierFilterDto _filter = new();
    private PagedResult<SupplierListItemDto> _pagedResult = new();
    private bool _isLoading = true;
    private bool _showSidebar = true;
    private List<string> _creators = new();

    // Aggregates
    private int _totalCount = 0;
    private int _activeCount = 0;
    private decimal _totalPayable = 0m;
    private decimal _totalPurchases = 0m;
    private int _debtSupplierCount = 0;

    // Filters UI state
    private int? _debtFilterMode = null; // null = all, 1 = has debt, 0 = zero debt
    private int? _datePreset = null; // null = all, 1 = today, 30 = this month

    // Selection & Bulk Actions
    private HashSet<int> _selectedIds = new();
    private bool _showBulkDeleteModal = false;
    private bool _isBulkDeleting = false;
    private List<string> _bulkMessages = new();

    // Drawer state
    private bool _isDrawerOpen = false;
    private int? _selectedSupplierId;

    // Deletion Modal state
    private int? _supplierToDeleteId;
    private string _supplierToDeleteName = string.Empty;
    private string _supplierToDeleteCode = string.Empty;
    private bool _isDeleting = false;
    private string? _deleteMessage;
    private bool _deleteIsWarning = false;

    private int ActiveFilterCount
    {
        get
        {
            int count = 0;
            if (!string.IsNullOrWhiteSpace(_filter.SearchTerm)) count++;
            if (_filter.IsActive.HasValue) count++;
            if (_debtFilterMode.HasValue || _filter.MinPayable.HasValue || _filter.MaxPayable.HasValue) count++;
            if (_datePreset.HasValue || _filter.CreatedFrom.HasValue || _filter.CreatedTo.HasValue) count++;
            if (!string.IsNullOrWhiteSpace(_filter.CreatedBy)) count++;
            return count;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
        _creators = await PartnerService.GetSupplierCreatorsAsync();
    }

    private async Task LoadDataAsync()
    {
        await LoadAggregatesAsync();
        await LoadSuppliersAsync();
    }

    private async Task LoadAggregatesAsync()
    {
        // Query master list to compute total KPI metrics
        var allSuppliers = await PartnerService.GetSuppliersAsync(new SupplierFilterDto { PageSize = 10000 });
        _totalCount = allSuppliers.TotalCount;
        _activeCount = allSuppliers.Items.Count(s => s.IsActive);
        _totalPayable = allSuppliers.Items.Sum(s => s.CurrentPayable);
        _totalPurchases = allSuppliers.Items.Sum(s => s.TotalPurchases);
        _debtSupplierCount = allSuppliers.Items.Count(s => s.CurrentPayable > 0);
    }

    private async Task LoadSuppliersAsync()
    {
        _isLoading = true;
        try
        {
            _pagedResult = await PartnerService.GetSuppliersAsync(_filter);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ToggleSidebar()
    {
        _showSidebar = !_showSidebar;
    }

    private async Task OnSearchChanged(string val)
    {
        _filter.SearchTerm = val;
        _filter.PageIndex = 1;
        await LoadSuppliersAsync();
    }

    private async Task SetStatus(bool? active)
    {
        _filter.IsActive = active;
        _filter.PageIndex = 1;
        await LoadSuppliersAsync();
    }

    private async Task SetDebtMode(int? mode)
    {
        _debtFilterMode = mode;
        if (mode == 1)
        {
            _filter.MinPayable = 1;
            _filter.MaxPayable = null;
        }
        else if (mode == 0)
        {
            _filter.MinPayable = null;
            _filter.MaxPayable = 0;
        }
        else
        {
            _filter.MinPayable = null;
            _filter.MaxPayable = null;
        }
        _filter.PageIndex = 1;
        await LoadSuppliersAsync();
    }

    private async Task SetDatePreset(int? days)
    {
        _datePreset = days;
        if (days == 1)
        {
            _filter.CreatedFrom = DateTime.Today;
            _filter.CreatedTo = DateTime.Today;
        }
        else if (days == 30)
        {
            var now = DateTime.Today;
            _filter.CreatedFrom = new DateTime(now.Year, now.Month, 1);
            _filter.CreatedTo = now;
        }
        else
        {
            _filter.CreatedFrom = null;
            _filter.CreatedTo = null;
        }
        _filter.PageIndex = 1;
        await LoadSuppliersAsync();
    }

    private async Task OnCreatorChanged(ChangeEventArgs e)
    {
        _filter.CreatedBy = e.Value?.ToString();
        _filter.PageIndex = 1;
        await LoadSuppliersAsync();
    }

    private async Task ClearAllFilters()
    {
        _filter = new SupplierFilterDto();
        _debtFilterMode = null;
        _datePreset = null;
        await LoadSuppliersAsync();
    }

    private async Task OnPageChanged(int newPage)
    {
        _filter.PageIndex = newPage;
        await LoadSuppliersAsync();
    }

    private async Task OnPageSizeChanged(int newSize)
    {
        _filter.PageSize = newSize;
        _filter.PageIndex = 1;
        await LoadSuppliersAsync();
    }

    private void OpenSupplierDrawer(int id)
    {
        _selectedSupplierId = id;
        _isDrawerOpen = true;
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        if (e.Value is bool isChecked && isChecked)
        {
            _selectedIds = new HashSet<int>(_pagedResult.Items.Select(x => x.Id));
        }
        else
        {
            _selectedIds.Clear();
        }
    }

    private void ToggleItemSelection(int id, ChangeEventArgs e)
    {
        if (e.Value is bool isChecked && isChecked)
        {
            _selectedIds.Add(id);
        }
        else
        {
            _selectedIds.Remove(id);
        }
    }

    // Single Deletion
    private void ConfirmDelete(int id, string name, string code)
    {
        _supplierToDeleteId = id;
        _supplierToDeleteName = name;
        _supplierToDeleteCode = code;
        _deleteMessage = null;
        _deleteIsWarning = false;
    }

    private void CancelDelete()
    {
        _supplierToDeleteId = null;
        _deleteMessage = null;
    }

    private async Task ExecuteDelete()
    {
        if (!_supplierToDeleteId.HasValue) return;

        _isDeleting = true;
        _deleteMessage = null;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var result = await PartnerService.DeleteSupplierAsync(_supplierToDeleteId.Value, authState.User);

            if (result.Succeeded)
            {
                CancelDelete();
                await LoadAggregatesAsync();
                await LoadSuppliersAsync();
            }
            else
            {
                _deleteMessage = result.ErrorMessage;
                _deleteIsWarning = result.SoftDeleted;
                if (result.SoftDeleted)
                {
                    await LoadAggregatesAsync();
                    await LoadSuppliersAsync();
                }
            }
        }
        catch (Exception ex)
        {
            _deleteMessage = "Lỗi khi thực hiện xóa: " + ex.Message;
            _deleteIsWarning = false;
        }
        finally
        {
            _isDeleting = false;
        }
    }

    // Bulk Deletion
    private void OpenBulkDeleteModal()
    {
        _bulkMessages.Clear();
        _showBulkDeleteModal = true;
    }

    private async Task ExecuteBulkDelete()
    {
        if (!_selectedIds.Any()) return;

        _isBulkDeleting = true;
        _bulkMessages.Clear();

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var result = await PartnerService.BulkDeleteSuppliersAsync(_selectedIds.ToList(), authState.User);

            if (result.Messages.Any())
            {
                _bulkMessages.AddRange(result.Messages);
            }

            if (result.DeletedCount > 0 || result.DeactivatedCount > 0)
            {
                _selectedIds.Clear();
                await LoadAggregatesAsync();
                await LoadSuppliersAsync();
            }

            if (!result.Messages.Any())
            {
                _showBulkDeleteModal = false;
            }
        }
        catch (Exception ex)
        {
            _bulkMessages.Add("Lỗi hệ thống: " + ex.Message);
        }
        finally
        {
            _isBulkDeleting = false;
        }
    }

