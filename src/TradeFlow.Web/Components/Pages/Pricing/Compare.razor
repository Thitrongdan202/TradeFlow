@page "/bang-gia/so-sanh"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Application.Common.Models.Pricing
@using TradeFlow.Domain.Enums
@attribute [Authorize(Policy = "Permission:PriceLists:View")]

@inject IPriceListService PriceListService
@inject IFileStorageService FileStorage
@inject NavigationManager Nav

<PageTitle>So sánh bảng giá - TradeFlow</PageTitle>

<div class="tf-page-header">
    <div class="tf-page-header-left">
        <div style="display:flex; align-items:center; gap: 8px;">
            <a href="/bang-gia" style="color: var(--tf-text-muted); text-decoration:none; display:inline-flex; align-items:center;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
                Bảng giá
            </a>
            <span style="color: var(--tf-text-muted);">/</span>
            <span style="font-weight: 600;">So sánh giá</span>
        </div>
        <h1 class="tf-page-title" style="margin-top: 4px;">So sánh bảng giá & Phân tích giá sản phẩm</h1>
        <p class="tf-page-subtitle">So sánh mức giá đại lý đa kỳ tải động từ CSDL, theo dõi biến động giá và tra cứu Giá hiện tại hiệu lực</p>
    </div>
</div>

@* View Mode Selector *@
<div class="tf-compare-mode-selector">
    <button type="button" 
            class="tf-btn @(_activeMode == "multi" ? "tf-btn-primary" : "tf-btn-secondary")" 
            style="display:flex; align-items:center; gap: 6px; padding: 8px 16px;" 
            @onclick='() => SwitchMode("multi")'>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
        <span>So sánh tổng hợp đa kỳ & Giá hiện tại</span>
    </button>
    <button type="button" 
            class="tf-btn @(_activeMode == "two" ? "tf-btn-primary" : "tf-btn-secondary")" 
            style="display:flex; align-items:center; gap: 6px; padding: 8px 16px;" 
            @onclick='() => SwitchMode("two")'>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 3h5v5"/><path d="M4 20L21 3"/><path d="M21 16v5h-5"/><path d="M15 15l6 6"/></svg>
        <span>So sánh chi tiết 2 kỳ (Tăng / Giảm giá)</span>
    </button>
</div>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="tf-alert tf-alert-danger tf-mb-4">
        @_errorMessage
    </div>
}

@if (_activeMode == "multi")
{
    @* Multi-Period Dynamic Comparison View *@
    <div class="tf-compare-notice-banner">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
        <div class="tf-compare-notice-content">
            <strong>Nguyên tắc so sánh:</strong> Tất cả các mức giá đều dùng chung cơ sở <strong>"Giá chưa VAT"</strong> (giá niêm yết đại lý trước thuế).
            Cột <strong>"Giá hiện tại"</strong> được truy vấn tự động từ Bảng giá đang có hiệu lực theo ngày áp dụng.
        </div>
    </div>

    @* Filters *@
    <div class="tf-card tf-compare-filter-card">
        <div style="display: flex; gap: 12px; align-items: center;">
            <div style="flex: 2;">
                <input type="text"
                       class="tf-input"
                       placeholder="Tìm nhanh theo mã mới, mã cũ, tên sản phẩm..."
                       value="@_multiSearchTerm"
                       @oninput="OnMultiSearchInput" />
            </div>
            <div style="font-size: 13px; color: var(--tf-text-muted); white-space:nowrap;">
                Hiển thị: <strong>@FilteredMultiItems.Count()</strong> / @(_multiPeriodResult?.Items.Count ?? 0) mặt hàng
                @if (_multiPeriodResult?.Periods.Any() == true)
                {
                    <span> | (@_multiPeriodResult.Periods.Count kỳ từ CSDL)</span>
                }
            </div>
        </div>
    </div>

    @if (_isLoadingMulti)
    {
        <Skeleton Type="table" Rows="6" Columns="8" />
    }
    else if (_multiPeriodResult == null || !_multiPeriodResult.Periods.Any())
    {
        <div class="tf-card" style="padding: 40px; text-align: center; color: var(--tf-text-muted);">
            Chưa có đủ dữ liệu bảng giá trong hệ thống để thực hiện so sánh đa kỳ. Vui lòng nhập thêm bảng giá từ Excel.
        </div>
    }
    else
    {
        <div class="tf-card">
            <div class="tf-card-body" style="padding:0; overflow-x: auto;">
                <table class="tf-table" style="font-size: 13px;">
                    <thead class="tf-compare-thead">
                        <tr class="tf-compare-tr">
                            <th class="tf-th-standard" style="width: 45px; text-align: center;">STT</th>
                            <th class="tf-th-standard" style="min-width: 120px;">NHÓM</th>
                            <th class="tf-th-standard" style="width: 50px; text-align: center;">ẢNH</th>
                            <th class="tf-th-standard" style="min-width: 110px;">MÃ MỚI</th>
                            <th class="tf-th-standard" style="min-width: 90px;">MÃ CŨ</th>
                            <th class="tf-th-standard" style="min-width: 200px;">SẢN PHẨM</th>

                            @* Dynamic Period Headers from DB *@
                            @foreach (var period in _multiPeriodResult.Periods)
                            {
                                <th class="tf-th-period" style="min-width: 130px; text-align: right;">
                                    <div class="tf-th-period-title">@period.PeriodLabel</div>
                                    <div class="tf-th-period-sub">Chưa VAT</div>
                                </th>
                            }

                            <th class="tf-th-current-price" style="min-width: 135px; text-align: right;">
                                <div class="tf-th-current-title">GIÁ HIỆN TẠI</div>
                                <div class="tf-th-current-sub">Chưa VAT</div>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!FilteredMultiItems.Any())
                        {
                            <tr>
                                <td colspan="@(7 + _multiPeriodResult.Periods.Count)" style="text-align:center; padding: 24px;">
                                    Không tìm thấy mặt hàng nào phù hợp với từ khóa tìm kiếm.
                                </td>
                            </tr>
                        }
                        else
                        {
                            int stt = 1;
                            @foreach (var item in FilteredMultiItems)
                            {
                                <tr>
                                    <td style="text-align: center; color: var(--tf-text-muted);">@(stt++)</td>
                                    <td><span style="font-weight: 600;">@(item.Group ?? "-")</span></td>
                                    <td style="text-align: center;">
                                        @if (!string.IsNullOrEmpty(item.ImageStorageRef))
                                        {
                                            <img src="@FileStorage.GetPublicUrl(item.ImageStorageRef)"
                                                 alt="@item.NewCode"
                                                 style="width: 36px; height: 36px; object-fit: contain; border-radius: 4px; border: 1px solid var(--tf-border); background:#fff;" />
                                        }
                                        else
                                        {
                                            <span style="color: var(--tf-text-muted); font-size: 11px;">-</span>
                                        }
                                    </td>
                                    <td>
                                        <strong class="tf-code-new">@item.NewCode</strong>
                                    </td>
                                    <td><span class="tf-code-legacy">@(item.LegacyCode ?? "-")</span></td>
                                    <td><span class="tf-product-name">@item.ProductName</span></td>

                                    @* Dynamic Period Prices *@
                                    @foreach (var period in _multiPeriodResult.Periods)
                                    {
                                        <td style="text-align: right;">
                                            @if (item.PeriodPrices.TryGetValue(period.PriceListId, out var pPrice) && pPrice.HasValue)
                                            {
                                                <div class="tf-period-price">@pPrice.Value.ToString("N0") ₫</div>
                                            }
                                            else
                                            {
                                                <span style="color: var(--tf-text-muted);">-</span>
                                            }
                                        </td>
                                    }

                                    @* Current Price Column *@
                                    <td class="tf-td-current-price" style="text-align: right;">
                                        @if (item.CurrentPrice.HasValue && item.CurrentPrice.Value > 0)
                                        {
                                            <div class="tf-current-price-val">
                                                @item.CurrentPrice.Value.ToString("N0") ₫
                                            </div>
                                        }
                                        else
                                        {
                                            <span style="color: var(--tf-text-muted);">Chưa có</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}
else
{
    @* Two-Period Detailed Comparison View *@
    <div class="tf-card tf-mb-4" style="padding: 20px;">
        <div style="display: grid; grid-template-columns: 1fr 1fr auto; gap: 16px; align-items: flex-end;">
            <div>
                <label style="display:block; font-size: 13px; font-weight: 600; margin-bottom: 6px; color: var(--tf-text-main);">
                    Bảng giá gốc (Kỳ cũ) *
                </label>
                <select class="tf-input" value="@_baseId" @onchange="OnBaseListSelected">
                    <option value="0">-- Chọn bảng giá gốc --</option>
                    @foreach (var pl in _availableLists)
                    {
                        <option value="@pl.Id">@pl.Code - @pl.Name (Năm @pl.Year)</option>
                    }
                </select>
            </div>
            <div>
                <label style="display:block; font-size: 13px; font-weight: 600; margin-bottom: 6px; color: var(--tf-text-main);">
                    Bảng giá so sánh (Kỳ mới) *
                </label>
                <select class="tf-input" value="@_targetId" @onchange="OnTargetListSelected">
                    <option value="0">-- Chọn bảng giá so sánh --</option>
                    @foreach (var pl in _availableLists)
                    {
                        <option value="@pl.Id">@pl.Code - @pl.Name (Năm @pl.Year)</option>
                    }
                </select>
            </div>
            <div>
                <LoadingButton Type="primary"
                               OnClick="ExecuteCompare"
                               IsLoading="_isComparing"
                               LoadingText="Đang so sánh..."
                               Disabled="@(_baseId <= 0 || _targetId <= 0 || _baseId == _targetId)">
                    So sánh giá
                </LoadingButton>
            </div>
        </div>
        @if (_baseId > 0 && _targetId > 0 && _baseId == _targetId)
        {
            <div style="color: #dc2626; font-size: 13px; margin-top: 8px;">
                Vui lòng chọn 2 bảng giá khác nhau để so sánh.
            </div>
        }
    </div>

    @if (_isComparing)
    {
        <Skeleton Type="stats" Count="5" />
        <Skeleton Type="table" Rows="6" Columns="11" />
    }
    else if (_comparisonResult != null)
    {
        @* Summary Cards *@
        <div class="tf-compare-kpi-grid">
            <div class="tf-card tf-compare-kpi-card">
                <div class="tf-kpi-subtitle">TỔNG MẶT HÀNG</div>
                <div class="tf-kpi-num">@_comparisonResult.Items.Count</div>
            </div>
            <div class="tf-card tf-compare-kpi-card increased">
                <div class="tf-kpi-subtitle">TĂNG GIÁ ▲</div>
                <div class="tf-kpi-num">
                    @_comparisonResult.Items.Count(i => i.ChangeStatus == PriceChangeStatus.Increased)
                </div>
            </div>
            <div class="tf-card tf-compare-kpi-card decreased">
                <div class="tf-kpi-subtitle">GIẢM GIÁ ▼</div>
                <div class="tf-kpi-num">
                    @_comparisonResult.Items.Count(i => i.ChangeStatus == PriceChangeStatus.Decreased)
                </div>
            </div>
            <div class="tf-card tf-compare-kpi-card unchanged">
                <div class="tf-kpi-subtitle">KHÔNG ĐỔI ▬</div>
                <div class="tf-kpi-num">
                    @_comparisonResult.Items.Count(i => i.ChangeStatus == PriceChangeStatus.Unchanged)
                </div>
            </div>
            <div class="tf-card tf-compare-kpi-card new-product">
                <div class="tf-kpi-subtitle">MẶT HÀNG MỚI ★</div>
                <div class="tf-kpi-num">
                    @_comparisonResult.Items.Count(i => i.ChangeStatus == PriceChangeStatus.NewProduct)
                </div>
            </div>
            <div class="tf-card tf-compare-kpi-card discontinued">
                <div class="tf-kpi-subtitle">NGỪNG ÁP DỤNG ✕</div>
                <div class="tf-kpi-num">
                    @_comparisonResult.Items.Count(i => i.ChangeStatus == PriceChangeStatus.Discontinued)
                </div>
            </div>
        </div>

        @* Table Filters *@
        <div class="tf-card tf-compare-filter-card">
            <div style="display: flex; gap: 12px; align-items: center;">
                <div style="flex: 2;">
                    <input type="text"
                           class="tf-input"
                           placeholder="Tìm theo mã mới, mã cũ, tên sản phẩm..."
                           value="@_searchTerm"
                           @oninput="OnSearchInput" />
                </div>
                <div style="flex: 1;">
                    <select class="tf-input" value="@_filterStatus" @onchange="OnStatusChanged">
                        <option value="">-- Tất cả trạng thái biến động --</option>
                        <option value="@PriceChangeStatus.Increased">Tăng giá ▲</option>
                        <option value="@PriceChangeStatus.Decreased">Giảm giá ▼</option>
                        <option value="@PriceChangeStatus.Unchanged">Không đổi ▬</option>
                        <option value="@PriceChangeStatus.NewProduct">Sản phẩm mới ★</option>
                        <option value="@PriceChangeStatus.Discontinued">Ngừng áp dụng ✕</option>
                    </select>
                </div>
                <div style="font-size: 13px; color: var(--tf-text-muted); white-space:nowrap;">
                    Hiển thị: <strong>@FilteredItems.Count()</strong> / @_comparisonResult.Items.Count mặt hàng
                </div>
            </div>
        </div>

        @* Comparison Table *@
        <div class="tf-card">
            <div class="tf-card-body" style="padding:0; overflow-x: auto;">
                <table class="tf-table" style="font-size: 13px;">
                    <thead class="tf-compare-thead">
                        <tr class="tf-compare-tr">
                            <th class="tf-th-standard" style="width: 50px; text-align: center;">STT</th>
                            <th class="tf-th-standard" style="min-width: 130px;">NHÓM</th>
                            <th class="tf-th-standard" style="width: 60px; text-align: center;">ẢNH</th>
                            <th class="tf-th-standard" style="min-width: 130px;">MÃ HÀNG MỚI</th>
                            <th class="tf-th-standard" style="min-width: 100px;">MÃ CŨ</th>
                            <th class="tf-th-standard" style="min-width: 220px;">TÊN SẢN PHẨM</th>
                            <th class="tf-th-standard" style="min-width: 130px; text-align: right;">
                                <div>GIÁ GỐC</div>
                                <div style="font-size: 10px; color: var(--tf-text-muted); font-weight: normal;">Chưa VAT</div>
                            </th>
                            <th class="tf-th-period" style="min-width: 130px; text-align: right;">
                                <div class="tf-th-period-title">GIÁ MỚI</div>
                                <div class="tf-th-period-sub">Chưa VAT</div>
                            </th>
                            <th class="tf-th-standard" style="min-width: 120px; text-align: right;">CHÊNH LỆCH</th>
                            <th class="tf-th-standard" style="min-width: 90px; text-align: right;">% BIẾN ĐỘNG</th>
                            <th class="tf-th-standard" style="min-width: 130px; text-align: center;">TRẠNG THÁI</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!FilteredItems.Any())
                        {
                            <tr>
                                <td colspan="11" style="text-align:center; padding: 24px;">Không tìm thấy mặt hàng nào khớp với điều kiện lọc.</td>
                            </tr>
                        }
                        else
                        {
                            int stt = 1;
                            @foreach (var item in FilteredItems)
                            {
                                <tr>
                                    <td style="text-align: center; color: var(--tf-text-muted);">@(stt++)</td>
                                    <td><span style="font-weight: 600;">@(item.Group ?? "-")</span></td>
                                    <td style="text-align: center;">
                                        @if (!string.IsNullOrEmpty(item.ImageStorageRef))
                                        {
                                            <img src="@FileStorage.GetPublicUrl(item.ImageStorageRef)"
                                                 alt="@item.NewCode"
                                                 style="width: 40px; height: 40px; object-fit: contain; border-radius: 4px; border: 1px solid var(--tf-border); background:#fff;" />
                                        }
                                        else
                                        {
                                            <span style="color: var(--tf-text-muted); font-size: 11px;">-</span>
                                        }
                                    </td>
                                    <td>
                                        <strong class="tf-code-new">@item.NewCode</strong>
                                    </td>
                                    <td><span class="tf-code-legacy">@(item.LegacyCode ?? "-")</span></td>
                                    <td><span class="tf-product-name">@(item.ProductName ?? "-")</span></td>
                                    <td style="text-align: right; font-weight: 600;">
                                        @(item.BasePrice.HasValue ? $"{item.BasePrice.Value:N0} ₫" : "-")
                                    </td>
                                    <td class="tf-td-period" style="text-align: right; font-weight: 700;">
                                        @(item.TargetPrice.HasValue ? $"{item.TargetPrice.Value:N0} ₫" : "-")
                                    </td>
                                    <td style="text-align: right; font-weight: 700;">
                                        @if (item.PriceDifference.HasValue)
                                        {
                                            if (item.PriceDifference.Value > 0)
                                            {
                                                <span style="color: #ea580c;">+@item.PriceDifference.Value.ToString("N0") ₫</span>
                                            }
                                            else if (item.PriceDifference.Value < 0)
                                            {
                                                <span style="color: #059669;">@item.PriceDifference.Value.ToString("N0") ₫</span>
                                            }
                                            else
                                            {
                                                <span style="color: var(--tf-text-muted);">0 ₫</span>
                                            }
                                        }
                                        else
                                        {
                                            <span style="color: var(--tf-text-muted);">-</span>
                                        }
                                    </td>
                                    <td style="text-align: right; font-weight: 700;">
                                        @if (item.PercentageDifference.HasValue)
                                        {
                                            if (item.PercentageDifference.Value > 0)
                                            {
                                                <span style="color: #ea580c;">+@item.PercentageDifference.Value.ToString("N1")%</span>
                                            }
                                            else if (item.PercentageDifference.Value < 0)
                                            {
                                                <span style="color: #059669;">@item.PercentageDifference.Value.ToString("N1")%</span>
                                            }
                                            else
                                            {
                                                <span style="color: var(--tf-text-muted);">0%</span>
                                            }
                                        }
                                        else
                                        {
                                            <span style="color: var(--tf-text-muted);">-</span>
                                        }
                                    </td>
                                    <td style="text-align: center;">
                                        @switch (item.ChangeStatus)
                                        {
                                            case PriceChangeStatus.Increased:
                                                <span class="tf-diff-badge increased">
                                                    ▲ Tăng giá
                                                </span>
                                                break;
                                            case PriceChangeStatus.Decreased:
                                                <span class="tf-diff-badge decreased">
                                                    ▼ Giảm giá
                                                </span>
                                                break;
                                            case PriceChangeStatus.Unchanged:
                                                <span class="tf-diff-badge unchanged">
                                                    ▬ Không đổi
                                                </span>
                                                break;
                                            case PriceChangeStatus.NewProduct:
                                                <span class="tf-diff-badge new-product">
                                                    ★ Sản phẩm mới
                                                </span>
                                                break;
                                            case PriceChangeStatus.Discontinued:
                                                <span class="tf-diff-badge discontinued">
                                                    ✕ Ngừng áp dụng
                                                </span>
                                                break;
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    [SupplyParameterFromQuery] public int? BaseId { get; set; }
    [SupplyParameterFromQuery] public int? TargetId { get; set; }

    private string _activeMode = "multi"; // "multi" or "two"
    private bool _isLoadingMulti = false;
    private MultiPeriodPriceComparisonDto? _multiPeriodResult;
    private string _multiSearchTerm = "";

    private List<PriceListDto> _availableLists = new();
    private int _baseId = 0;
    private int _targetId = 0;
    private bool _isComparing = false;
    private string? _errorMessage;
    private PriceComparisonResultDto? _comparisonResult;

    private string _searchTerm = "";
    private string _filterStatus = "";

    protected override async Task OnInitializedAsync()
    {
        _availableLists = await PriceListService.GetPriceListsAsync();

        if (BaseId.HasValue && BaseId.Value > 0)
        {
            _baseId = BaseId.Value;
            _activeMode = "two";
        }

        if (TargetId.HasValue && TargetId.Value > 0)
        {
            _targetId = TargetId.Value;
            _activeMode = "two";
        }

        if (_baseId > 0 && _targetId > 0 && _baseId != _targetId)
        {
            await ExecuteCompare();
        }

        // Tải so sánh đa kỳ mặc định
        await LoadMultiPeriodComparisonAsync();
    }

    private async Task SwitchMode(string mode)
    {
        _activeMode = mode;
        if (_activeMode == "multi" && _multiPeriodResult == null)
        {
            await LoadMultiPeriodComparisonAsync();
        }
    }

    private async Task LoadMultiPeriodComparisonAsync()
    {
        _isLoadingMulti = true;
        try
        {
            _multiPeriodResult = await PriceListService.CompareMultiplePriceListsAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Lỗi tải so sánh đa kỳ: {ex.Message}";
        }
        finally
        {
            _isLoadingMulti = false;
        }
    }

    private void OnBaseListSelected(ChangeEventArgs e)
    {
        _baseId = int.TryParse(e.Value?.ToString(), out var v) ? v : 0;
    }

    private void OnTargetListSelected(ChangeEventArgs e)
    {
        _targetId = int.TryParse(e.Value?.ToString(), out var v) ? v : 0;
    }

    private async Task ExecuteCompare()
    {
        if (_baseId <= 0 || _targetId <= 0 || _baseId == _targetId) return;

        _isComparing = true;
        _errorMessage = null;

        try
        {
            _comparisonResult = await PriceListService.ComparePriceListsAsync(_baseId, _targetId);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Lỗi so sánh: {ex.Message}";
        }
        finally
        {
            _isComparing = false;
        }
    }

    private IEnumerable<MultiPeriodComparisonItemDto> FilteredMultiItems
    {
        get
        {
            if (_multiPeriodResult == null) return Enumerable.Empty<MultiPeriodComparisonItemDto>();
            var res = _multiPeriodResult.Items.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_multiSearchTerm))
            {
                var term = _multiSearchTerm.Trim().ToLower();
                res = res.Where(i =>
                    i.NewCode.ToLower().Contains(term) ||
                    (i.LegacyCode != null && i.LegacyCode.ToLower().Contains(term)) ||
                    (!string.IsNullOrEmpty(i.ProductName) && i.ProductName.ToLower().Contains(term)));
            }

            return res;
        }
    }

    private void OnMultiSearchInput(ChangeEventArgs e)
    {
        _multiSearchTerm = e.Value?.ToString() ?? "";
    }

    private IEnumerable<PriceComparisonItemDto> FilteredItems
    {
        get
        {
            if (_comparisonResult == null) return Enumerable.Empty<PriceComparisonItemDto>();

            var res = _comparisonResult.Items.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                var term = _searchTerm.Trim().ToLower();
                res = res.Where(i =>
                    i.NewCode.ToLower().Contains(term) ||
                    (i.LegacyCode != null && i.LegacyCode.ToLower().Contains(term)) ||
                    (i.ProductName != null && i.ProductName.ToLower().Contains(term)));
            }

            if (!string.IsNullOrWhiteSpace(_filterStatus) && Enum.TryParse<PriceChangeStatus>(_filterStatus, out var st))
            {
                res = res.Where(i => i.ChangeStatus == st);
            }

            return res;
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? "";
    }

    private void OnStatusChanged(ChangeEventArgs e)
    {
        _filterStatus = e.Value?.ToString() ?? "";
    }
}