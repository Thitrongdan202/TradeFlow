@page "/bang-gia/nhap-excel"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using System.Threading
@using Microsoft.AspNetCore.Components.Forms
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Application.Common.Models.Pricing
@using TradeFlow.Domain.Enums
@attribute [Authorize(Policy = "Permission:PriceLists:Create")]

@inject IExcelPricingService ExcelPricingService
@inject IFileStorageService FileStorage
@inject ICurrentUserService CurrentUserService
@inject NavigationManager Nav

<PageTitle>Nhập bảng giá từ Excel - TradeFlow</PageTitle>

<div class="tf-page-header">
    <div class="tf-page-header-left">
        <div style="display:flex; align-items:center; gap: 8px;">
            <a href="/bang-gia" style="color: var(--tf-text-muted); text-decoration:none; display:inline-flex; align-items:center;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
                Bảng giá
            </a>
            <span style="color: var(--tf-text-muted);">/</span>
            <span style="font-weight: 600;">Nhập từ Excel</span>
        </div>
        <h1 class="tf-page-title" style="margin-top: 4px;">Nhập bảng giá từ file Excel</h1>
        <p class="tf-page-subtitle">Tự động nhận diện cấu trúc báo giá, trích xuất hình ảnh nhúng và đối soát mã hàng với danh mục</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="tf-alert tf-alert-danger tf-mb-4" style="display:flex; justify-content:space-between; align-items:center;">
        <span>@_errorMessage</span>
        <button type="button" style="background:none; border:none; cursor:pointer;" @onclick="() => _errorMessage = null">✕</button>
    </div>
}

@* Step 1: File Upload Box *@
@if (_analysisResult == null)
{
    <div class="tf-card tf-mb-4" style="padding: 40px 24px; text-align: center; border: 2px dashed #cbd5e1; background: #f8fafc;">
        <div style="width: 64px; height: 64px; margin: 0 auto 16px; border-radius: 50%; background: rgba(59, 130, 246, 0.1); color: #2563eb; display: flex; align-items: center; justify-content: center;">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="17 8 12 3 7 8"/>
                <line x1="12" y1="3" x2="12" y2="15"/>
            </svg>
        </div>
        <h3 style="font-size: 18px; font-weight: 700; color: var(--tf-text-main); margin-bottom: 8px;">
            Chọn file Excel bảng giá (.xlsx)
        </h3>
        <p style="color: var(--tf-text-muted); font-size: 14px; max-width: 520px; margin: 0 auto 20px;">
            Hệ thống hỗ trợ cấu trúc bảng giá tiêu chuẩn có hình ảnh nhúng trong ô Excel (OpenXML drawings), mã hàng mới, mã cũ, thông số quy cách và đơn giá đại lý.
        </p>

        <div style="display:inline-block; position:relative;">
            <InputFile OnChange="HandleFileSelected" accept=".xlsx" style="position:absolute; top:0; left:0; width:100%; height:100%; opacity:0; cursor:pointer;" disabled="@_isAnalyzing" />
            <button type="button" class="tf-btn tf-btn-primary" style="padding: 10px 24px; font-size: 15px;" disabled="@_isAnalyzing">
                @if (_isAnalyzing)
                {
                    <span>@(_progressMessage ?? "Đang phân tích dữ liệu...")</span>
                }
                else
                {
                    <span>Tải lên file Excel</span>
                }
            </button>
        </div>
        <div style="margin-top: 12px; font-size: 12px; color: var(--tf-text-muted);">
            Dung lượng tối đa 200MB. Đảm bảo file có định dạng .xlsx
        </div>
    </div>
}
else
{
    @* Step 2: Analysis Preview & Configuration Form *@
    <div class="tf-card tf-mb-4" style="border: 2px solid #10b981; padding: 20px; background: #fff;">
        <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom: 16px;">
            <div>
                <span class="tf-badge tf-badge-success" style="font-size: 12px; padding: 4px 10px;">Phân tích hoàn tất</span>
                <h2 style="font-size: 18px; font-weight: 700; margin-top: 6px; color: var(--tf-text-main);">
                    File: @_analysisResult.FileName
                </h2>
            </div>
            <button type="button" class="tf-btn tf-btn-secondary" @onclick="CancelAndCleanupAsync">
                Chọn file khác
            </button>
        </div>

        @* Detection Stats Grid *@
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; margin-bottom: 20px; background: #f8fafc; padding: 16px; border-radius: 6px;">
            <div>
                <div style="font-size: 11px; color: var(--tf-text-muted); font-weight: 600;">MẶT HÀNG TÌM THẤY</div>
                <div style="font-size: 20px; font-weight: 700; color: #1e293b;">@_analysisResult.Items.Count</div>
            </div>
            <div>
                <div style="font-size: 11px; color: var(--tf-text-muted); font-weight: 600;">ẢNH TRÍCH XUẤT NHÚNG</div>
                <div style="font-size: 20px; font-weight: 700; color: #ea580c;">@_analysisResult.ImagesFound</div>
            </div>
            <div>
                <div style="font-size: 11px; color: var(--tf-text-muted); font-weight: 600;">ĐÃ KHỚP DANH MỤC</div>
                <div style="font-size: 20px; font-weight: 700; color: #059669;">@_analysisResult.Items.Count(i => i.MatchStatus == PriceMatchStatus.Matched)</div>
            </div>
            <div>
                <div style="font-size: 11px; color: var(--tf-text-muted); font-weight: 600;">SẢN PHẨM MỚI</div>
                <div style="font-size: 20px; font-weight: 700; color: #2563eb;">@_analysisResult.Items.Count(i => i.MatchStatus == PriceMatchStatus.NewProduct)</div>
            </div>
        </div>

        @* Import Settings Form *@
        <h4 style="font-size: 15px; font-weight: 700; margin-bottom: 12px; color: var(--tf-text-main);">
            Cấu hình thông tin bảng giá trước khi lưu
        </h4>
        <div style="display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 16px; margin-bottom: 16px;">
            <div>
                <label style="display:block; font-size: 12px; font-weight: 600; margin-bottom: 4px;">Tên bảng giá *</label>
                <input type="text" class="tf-input" @bind="_importRequest.Name" placeholder="vd: BẢNG GIÁ ĐẠI LÝ KM 2026" />
            </div>
            <div>
                <label style="display:block; font-size: 12px; font-weight: 600; margin-bottom: 4px;">Số báo giá</label>
                <input type="text" class="tf-input" @bind="_importRequest.QuotationNumber" placeholder="vd: 06/LCS/2026" />
            </div>
            <div>
                <label style="display:block; font-size: 12px; font-weight: 600; margin-bottom: 4px;">Năm áp dụng *</label>
                <input type="number" class="tf-input" @bind="_importRequest.Year" min="2020" max="2035" />
            </div>
            <div>
                <label style="display:block; font-size: 12px; font-weight: 600; margin-bottom: 4px;">Quýý áp dụng</label>
                <select class="tf-input" @bind="_importRequest.Quarter">
                    <option value="">-- Chọn quý --</option>
                    <option value="1">Quýý 1</option>
                    <option value="2">Quýý 2</option>
                    <option value="3">Quýý 3</option>
                    <option value="4">Quýý 4</option>
                </select>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 16px; margin-bottom: 16px;">
            <div>
                <label style="display:block; font-size: 12px; font-weight: 600; margin-bottom: 4px;">Ngày báo giá</label>
                <input type="date" class="tf-input" value="@_importRequest.QuotationDate?.ToString("yyyy-MM-dd")" @onchange="OnQuotationDateChanged" />
            </div>
            <div>
                <label style="display:block; font-size: 12px; font-weight: 600; margin-bottom: 4px;">Hiệu lực từ ngày</label>
                <input type="date" class="tf-input" value="@_importRequest.EffectiveFrom?.ToString("yyyy-MM-dd")" @onchange="OnEffectiveFromChanged" />
            </div>
            <div>
                <label style="display:block; font-size: 12px; font-weight: 600; margin-bottom: 4px;">Hiệu lực đến ngày</label>
                <input type="date" class="tf-input" value="@_importRequest.EffectiveTo?.ToString("yyyy-MM-dd")" @onchange="OnEffectiveToChanged" />
            </div>
            <div>
                <label style="display:block; font-size: 12px; font-weight: 600; margin-bottom: 4px;">Trạng thái ban đầu</label>
                <select class="tf-input" @bind="_importRequest.InitialStatus">
                    <option value="@PriceListStatus.Draft">Bản nháp (chờ duyệt)</option>
                    <option value="@PriceListStatus.Active">Áp dụng ngay</option>
                </select>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
            <div>
                <label style="display:block; font-size: 12px; font-weight: 600; margin-bottom: 4px;">Điều kiện giá</label>
                <input type="text" class="tf-input" @bind="_importRequest.PriceCondition" placeholder="vd: Giá bán tại kho Lacasa Cần Thơ" />
            </div>
            <div>
                <label style="display:block; font-size: 12px; font-weight: 600; margin-bottom: 4px;">Ghi chú thuế VAT</label>
                <input type="text" class="tf-input" @bind="_importRequest.VatNote" placeholder="vd: Giá chưa bao gồm VAT 8% Sứ và 10% Inox" />
            </div>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 16px; border-top: 1px solid #e5e7eb;">
            <label style="display:flex; align-items:center; gap: 8px; font-size: 13px; cursor:pointer;">
                <input type="checkbox" @bind="_importRequest.AutoCreateProducts" />
                <span>Tự động tạo bản ghi sản phẩm mới vào danh mục sản phẩm nếu chưa tồn tại</span>
            </label>
            <div style="display:flex; gap: 8px;">
                <button type="button" class="tf-btn tf-btn-secondary" @onclick="CancelAndCleanupAsync" disabled="@_isCommitting">
                    Hủy bỏ
                </button>
                <button type="button" class="tf-btn tf-btn-primary" style="background:#059669; padding: 8px 20px;" @onclick="CommitImport" disabled="@_isCommitting">
                    @if (_isCommitting)
                    {
                        <span>Đang lưu bảng giá vào CSDL...</span>
                    }
                    else
                    {
                        <span>Xác nhận nhập @_analysisResult.Items.Count mặt hàng</span>
                    }
                </button>
            </div>
        </div>
    </div>

    @* Step 3: Items Preview Table *@
    <div class="tf-card">
        <div class="tf-card-header" style="padding: 16px; display:flex; justify-content:space-between; align-items:center;">
            <h3 style="font-size: 16px; font-weight: 700;">Xem trước danh sách mặt hàng (@_analysisResult.Items.Count dòng)</h3>
            <div style="font-size: 12px; color: var(--tf-text-muted);">
                Trích xuất hình ảnh: @_analysisResult.ImagesFound ảnh
            </div>
        </div>
        <div class="tf-card-body" style="padding:0; overflow-x: auto;">
            <table class="tf-table" style="font-size: 13px;">
                <thead>
                    <tr style="background: #ea580c; color: #fff;">
                        <th style="width: 50px; text-align: center; color:#fff;">STT</th>
                        <th style="min-width: 140px; color:#fff;">NHÓM</th>
                        <th style="width: 70px; text-align: center; color:#fff;">ẢNH</th>
                        <th style="min-width: 130px; color:#fff;">MÃ MỚI</th>
                        <th style="min-width: 110px; color:#fff;">MÃ CŨ</th>
                        <th style="min-width: 260px; color:#fff;">THÔNG TIN SẢN PHẨM</th>
                        <th style="min-width: 120px; text-align: right; color:#fff;">GIÁ ĐẠI LÝ</th>
                        <th style="min-width: 130px; text-align: center; color:#fff;">ĐỐI SOÁT</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _analysisResult.Items)
                    {
                        <tr>
                            <td style="text-align: center; font-weight: 600; color: #6b7280;">@item.SortOrder</td>
                            <td><span style="font-weight: 600;">@(item.Group ?? "-")</span></td>
                            <td style="text-align: center;">
                                @if (!string.IsNullOrEmpty(item.ImageStorageRef))
                                {
                                    <img src="@FileStorage.GetPublicUrl(item.ImageStorageRef)"
                                         alt="@item.NewCode"
                                         style="width: 44px; height: 44px; object-fit: contain; border-radius: 4px; border: 1px solid #e5e7eb; background:#fff;" />
                                }
                                else
                                {
                                    <span style="color: #9ca3af; font-size: 11px;">-</span>
                                }
                            </td>
                            <td>
                                <strong style="color: #dc2626; font-size: 14px;">@item.NewCode</strong>
                            </td>
                            <td>@(item.LegacyCode ?? "-")</td>
                            <td>@item.ProductInfo</td>
                            <td style="text-align: right; font-weight: 700; color: #047857;">
                                @item.UnitPrice.ToString("N0") ₫
                            </td>
                            <td style="text-align: center;">
                                @switch (item.MatchStatus)
                                {
                                    case PriceMatchStatus.Matched:
                                        <span class="tf-badge tf-badge-success" style="font-size: 11px;">Khớp: @item.MatchedProductName</span>
                                        break;
                                    case PriceMatchStatus.ReviewRequired:
                                        <span class="tf-badge tf-badge-warning" style="font-size: 11px;">Cần xem xét</span>
                                        break;
                                    case PriceMatchStatus.NewProduct:
                                        <span class="tf-badge tf-badge-info" style="font-size: 11px;">Sản phẩm mới</span>
                                        break;
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    
    private bool _isAnalyzing = false;
    private bool _isCommitting = false;
    private string? _errorMessage;
    private string? _progressMessage;
    private CancellationTokenSource? _cts;
    private ExcelAnalysisResultDto? _analysisResult;
    private ExcelImportCommitRequest _importRequest = new();


    
    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        _errorMessage = null;
        _progressMessage = "Đang tải file...";
        var file = e.File;
        if (file == null) return;

        if (!file.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase))
        {
            _errorMessage = "Vui lòng chọn file định dạng Excel (.xlsx).";
            return;
        }

        _isAnalyzing = true;
        _cts = new CancellationTokenSource(TimeSpan.FromMinutes(5)); // 5 minute timeout

        try
        {
            // Max 200MB
            using var stream = file.OpenReadStream(maxAllowedSize: 209715200);
            _analysisResult = await ExcelPricingService.AnalyzeAndDryRunAsync(
                stream, 
                file.Name, 
                msg => { _progressMessage = msg; InvokeAsync(StateHasChanged); },
                _cts.Token
            );

            if (_analysisResult.Errors.Any())
            {
                _errorMessage = string.Join(" | ", _analysisResult.Errors);
            }

            // Populate commit request with smart defaults
            _importRequest = new ExcelImportCommitRequest
            {
                Name = !string.IsNullOrWhiteSpace(_analysisResult.QuotationTitle)
                    ? _analysisResult.QuotationTitle
                    : $"BẢNG GIÁ {DateTime.Now.Year} - {Path.GetFileNameWithoutExtension(file.Name)}",
                QuotationNumber = _analysisResult.QuotationNumber,
                QuotationDate = _analysisResult.QuotationDate,
                EffectiveFrom = _analysisResult.EffectiveFrom,
                EffectiveTo = _analysisResult.EffectiveTo,
                Year = _analysisResult.EffectiveFrom?.Year ?? DateTime.Now.Year,
                ProgramTitle = _analysisResult.ProgramTitle,
                PriceCondition = _analysisResult.PriceCondition,
                VatNote = _analysisResult.VatNote,
                TempFileReference = _analysisResult.TempFileReference,
                OriginalFileName = file.Name,
                InitialStatus = PriceListStatus.Active,
                AutoCreateProducts = true,
                Items = _analysisResult.Items
            };
        }
        catch (OperationCanceledException)
        {
            _errorMessage = "Quá trình đọc file Excel đã bị hủy hoặc vượt quá thời gian cho phép (5 phút).";
        }
        catch (Exception ex)
        {
            _errorMessage = $"Lỗi đọc file Excel: {ex.Message}";
        }
        finally
        {
            _isAnalyzing = false;
            _progressMessage = null;
            _cts?.Dispose();
            _cts = null;
        }
    }

    private async Task CancelAndCleanupAsync()
    {
        if (_analysisResult != null)
        {
            // Clean up temporary excel file
            if (!string.IsNullOrEmpty(_analysisResult.TempFileReference))
            {
                await FileStorage.DeleteFileAsync(_analysisResult.TempFileReference);
            }
            // Clean up temporary extracted images
            foreach (var item in _analysisResult.Items)
            {
                if (!string.IsNullOrEmpty(item.ImageStorageRef))
                {
                    await FileStorage.DeleteFileAsync(item.ImageStorageRef);
                }
            }
        }
        _analysisResult = null;
        _errorMessage = null;
    }

    private void OnQuotationDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt)) _importRequest.QuotationDate = dt;
        else _importRequest.QuotationDate = null;
    }

    private void OnEffectiveFromChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt)) _importRequest.EffectiveFrom = dt;
        else _importRequest.EffectiveFrom = null;
    }

    private void OnEffectiveToChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt)) _importRequest.EffectiveTo = dt;
        else _importRequest.EffectiveTo = null;
    }

    
    private async Task CommitImport()
    {
        if (string.IsNullOrWhiteSpace(_importRequest.Name))
        {
            _errorMessage = "Vui lòng nhập tên bảng giá.";
            return;
        }

        _isCommitting = true;
        _errorMessage = null;
        _cts = new CancellationTokenSource(TimeSpan.FromMinutes(2));

        try
        {
            var user = CurrentUserService.UserName ?? "admin";
            var result = await ExcelPricingService.CommitImportAsync(
                _importRequest, 
                user,
                null,
                _cts.Token
            );
            Nav.NavigateTo($"/bang-gia/chi-tiet/{result.Id}");
        }
        catch (OperationCanceledException)
        {
            _errorMessage = "Quá trình lưu bảng giá đã vượt quá thời gian cho phép.";
            _isCommitting = false;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Lỗi lưu bảng giá: {ex.Message}";
            _isCommitting = false;
        }
        finally
        {
            _cts?.Dispose();
            _cts = null;
        }
    }
}
