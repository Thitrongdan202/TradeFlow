@page "/hoa-don/tao-moi"
@using Microsoft.AspNetCore.Authorization
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Application.Common.Models.Sales
@using TradeFlow.Domain.Entities.MasterData
@using TradeFlow.Domain.Enums
@inject IInvoiceService InvoiceService
@inject ISalesService SalesService
@inject NavigationManager Nav
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Permission:Invoices:Create")]

<PageTitle>Tạo hóa đơn mới | TradeFlow</PageTitle>

<div class="tf-invoice-create-container">
    <div class="tf-page-header">
        <div class="tf-page-header-content">
            <h1 class="tf-page-title">Tạo hóa đơn</h1>
            <p class="tf-page-subtitle">Nhập thông tin chứng từ hóa đơn điện tử và hàng hóa dịch vụ phát sinh</p>
        </div>
        <div class="tf-page-header-actions">
            <a href="/hoa-don" class="tf-btn tf-btn-outline-secondary">Hủy</a>
            <button class="tf-btn tf-btn-primary" @onclick="SaveInvoice" disabled="@_isProcessing">
                @if (_isProcessing)
                {
                    <span>Đang lưu...</span>
                }
                else
                {
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:4px;">
                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                        <polyline points="17 21 17 13 7 13 7 21"></polyline>
                        <polyline points="7 3 7 8 15 8"></polyline>
                    </svg>
                    <span>Lưu nháp</span>
                }
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="tf-alert tf-alert-danger tf-mb-4">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:8px; flex-shrink:0;">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <span>@_errorMessage</span>
        </div>
    }

    @* 1. Cấu hình chứng từ *@
    <div class="tf-card tf-invoice-card tf-mb-4">
        <div class="tf-card-section-header">
            <h3 class="tf-card-section-title">1. Cấu hình chứng từ</h3>
        </div>
        <div class="tf-invoice-config-grid">
            <div class="tf-form-group">
                <label class="tf-form-label">Loại hóa đơn <span class="tf-text-danger">*</span></label>
                <select class="tf-form-control" @bind="_dto.Type" @bind:after="CalculateTotals">
                    <option value="@InvoiceType.SalesInvoice">Hóa đơn bán hàng (02/BH)</option>
                    <option value="@InvoiceType.VatInvoice">Hóa đơn GTGT (01/GTGT)</option>
                </select>
            </div>
            <div class="tf-form-group">
                <label class="tf-form-label">Ngày lập hóa đơn</label>
                <input type="date" class="tf-form-control" @bind="_dto.InvoiceDate" />
            </div>
            <div class="tf-form-group">
                <label class="tf-form-label">Hình thức thanh toán</label>
                <input type="text" class="tf-form-control" @bind="_dto.PaymentMethod" placeholder="TM/CK, Tiền mặt..." />
            </div>
        </div>
    </div>

    @* 2. Thông tin bên mua *@
    <div class="tf-card tf-invoice-card tf-mb-4">
        <div class="tf-card-section-header">
            <h3 class="tf-card-section-title">2. Thông tin người mua</h3>
        </div>

        <div class="tf-search-toolbar tf-mb-4">
            <div class="tf-search-box">
                <span class="tf-search-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                </span>
                <input type="text" class="tf-form-control tf-search-input" @bind="_customerSearch" @bind:event="oninput" @onkeyup="SearchCustomers" placeholder="Tìm nhanh khách hàng theo tên, mã hoặc SĐT để tự động điền thông tin..." />
                @if (!string.IsNullOrEmpty(_customerSearch))
                {
                    <button type="button" class="tf-search-clear-btn" @onclick="ClearCustomerSearch" title="Xóa tìm kiếm">✕</button>
                }
            </div>
            @if (_customers.Any())
            {
                <ul class="tf-autocomplete-dropdown">
                    @foreach (var c in _customers)
                    {
                        <li class="tf-autocomplete-item" @onclick="() => SelectCustomer(c)">
                            <div class="tf-autocomplete-primary"><strong>@c.Name</strong> - @c.Phone</div>
                            <div class="tf-autocomplete-secondary">@c.CompanyName @(!string.IsNullOrEmpty(c.TaxCode) ? $"| MST: {c.TaxCode}" : "")</div>
                        </li>
                    }
                </ul>
            }
        </div>

        <div class="tf-buyer-grid">
            <div class="tf-form-group">
                <label class="tf-form-label">Họ tên người mua <span class="tf-text-danger">*</span></label>
                <input type="text" class="tf-form-control" @bind="_dto.CustomerName" placeholder="Tên cá nhân đại diện..." />
            </div>
            <div class="tf-form-group">
                <label class="tf-form-label">Tên đơn vị / Doanh nghiệp</label>
                <input type="text" class="tf-form-control" @bind="_dto.CustomerCompanyName" placeholder="Công ty TNHH / Cổ phần..." />
            </div>
            <div class="tf-form-group">
                <label class="tf-form-label">MST / CCCD</label>
                <input type="text" class="tf-form-control" @bind="_dto.CustomerTaxCode" placeholder="Mã số thuế..." />
            </div>
            <div class="tf-form-group">
                <label class="tf-form-label">Điện thoại / Email</label>
                <input type="text" class="tf-form-control" @bind="_dto.CustomerEmail" placeholder="SĐT hoặc email..." />
            </div>
            <div class="tf-form-group tf-buyer-col-2">
                <label class="tf-form-label">Địa chỉ</label>
                <input type="text" class="tf-form-control" @bind="_dto.CustomerAddress" placeholder="Địa chỉ giao dịch hoặc xuất hóa đơn..." />
            </div>
            <div class="tf-form-group">
                <label class="tf-form-label">Số tài khoản ngân hàng</label>
                <input type="text" class="tf-form-control" @bind="_dto.CustomerBankAccount" placeholder="Số tài khoản..." />
            </div>
            <div class="tf-form-group tf-buyer-col-2">
                <label class="tf-form-label">Tên ngân hàng / Chi nhánh</label>
                <input type="text" class="tf-form-control" @bind="_dto.CustomerBankName" placeholder="Tên ngân hàng thụ hưởng..." />
            </div>
        </div>
    </div>

    @* 3. Hàng hóa, dịch vụ *@
    <div class="tf-card tf-invoice-card tf-mb-4">
        <div class="tf-card-section-header tf-between-header">
            <div class="tf-header-title-group">
                <h3 class="tf-card-section-title">3. Hàng hóa, dịch vụ</h3>
                @if (_dto.Items.Any())
                {
                    <span class="tf-badge tf-badge-info">@_dto.Items.Count mặt hàng</span>
                }
            </div>
            <button type="button" class="tf-btn tf-btn-sm tf-btn-outline-primary" @onclick="AddManualItem">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:4px;">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                <span>Thêm dòng thủ công</span>
            </button>
        </div>
        
        <div class="tf-search-toolbar tf-mb-3">
            <div class="tf-search-box">
                <span class="tf-search-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                </span>
                <input type="text" class="tf-form-control tf-search-input" @bind="_productSearch" @bind:event="oninput" @onkeyup="SearchProducts" placeholder="Nhập tên hoặc mã sản phẩm để tìm kiếm và thêm vào bảng..." />
                @if (!string.IsNullOrEmpty(_productSearch))
                {
                    <button type="button" class="tf-search-clear-btn" @onclick="ClearProductSearch" title="Xóa tìm kiếm">✕</button>
                }
            </div>
            @if (_products.Any())
            {
                <ul class="tf-autocomplete-dropdown">
                    @foreach (var p in _products)
                    {
                        <li class="tf-autocomplete-item" @onclick="() => SelectProduct(p)">
                            <div class="tf-autocomplete-primary"><strong>@p.Name</strong> <span class="tf-product-code">(@p.Code)</span></div>
                        </li>
                    }
                </ul>
            }
        </div>

        <div class="tf-table-responsive">
            <table class="tf-table tf-invoice-items-table">
                <thead>
                    <tr>
                        <th class="tf-col-product">Tên hàng hóa, dịch vụ</th>
                        <th class="tf-col-unit">ĐVT</th>
                        <th class="tf-col-qty">Số lượng</th>
                        <th class="tf-col-price">Đơn giá</th>
                        <th class="tf-col-discount">Chiết khấu</th>
                        @if (_dto.Type == InvoiceType.VatInvoice)
                        {
                            <th class="tf-col-tax">Thuế %</th>
                        }
                        <th class="tf-col-total">Thành tiền</th>
                        <th class="tf-col-action"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (!_dto.Items.Any())
                    {
                        <tr>
                            <td colspan="@(_dto.Type == InvoiceType.VatInvoice ? 8 : 7)" class="tf-empty-items-cell">
                                <div class="tf-empty-items-wrap">
                                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                                        <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                                        <line x1="12" y1="22.08" x2="12" y2="12"></line>
                                    </svg>
                                    <span>Chưa có mặt hàng nào. Nhấn <strong>"+ Thêm dòng thủ công"</strong> hoặc tìm kiếm sản phẩm phía trên.</span>
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var item in _dto.Items)
                    {
                        <tr>
                            <td class="tf-col-product"><input type="text" class="tf-form-control tf-form-control-sm" @bind="item.ProductName" placeholder="Tên hàng hóa/dịch vụ" /></td>
                            <td class="tf-col-unit"><input type="text" class="tf-form-control tf-form-control-sm tf-text-center" @bind="item.UnitName" placeholder="Cái, Kg..." /></td>
                            <td class="tf-col-qty"><input type="number" class="tf-form-control tf-form-control-sm tf-text-right" @bind="item.Quantity" @bind:after="CalculateTotals" min="1" /></td>
                            <td class="tf-col-price"><input type="number" class="tf-form-control tf-form-control-sm tf-text-right" @bind="item.UnitPrice" @bind:after="CalculateTotals" min="0" step="any" /></td>
                            <td class="tf-col-discount"><input type="number" class="tf-form-control tf-form-control-sm tf-text-right" @bind="item.DiscountAmount" @bind:after="CalculateTotals" min="0" step="any" /></td>
                            @if (_dto.Type == InvoiceType.VatInvoice)
                            {
                                <td class="tf-col-tax">
                                    <select class="tf-form-control tf-form-control-sm tf-text-center" @bind="item.TaxRate" @bind:after="CalculateTotals">
                                        <option value="0">0%</option>
                                        <option value="5">5%</option>
                                        <option value="8">8%</option>
                                        <option value="10">10%</option>
                                    </select>
                                </td>
                            }
                            <td class="tf-col-total tf-text-right"><strong>@item.LineTotal.ToString("N0") đ</strong></td>
                            <td class="tf-col-action tf-text-center">
                                <button type="button" class="tf-btn-icon tf-btn-danger-icon" @onclick="() => RemoveItem(item)" title="Xóa dòng">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="3 6 5 6 21 6"></polyline>
                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                    </svg>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (_dto.Items.Any())
        {
            <div class="tf-table-bottom-actions tf-mt-3">
                <button type="button" class="tf-btn tf-btn-sm tf-btn-outline-primary" @onclick="AddManualItem">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:4px;">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    <span>Thêm dòng mới</span>
                </button>
            </div>
        }
    </div>

    @* 4. Ghi chú & Tổng kết hóa đơn *@
    <div class="tf-invoice-bottom-grid tf-mb-4">
        <div class="tf-card tf-invoice-card tf-notes-card">
            <div class="tf-card-section-header">
                <h3 class="tf-card-section-title">Ghi chú chứng từ</h3>
            </div>
            <div class="tf-form-group tf-notes-group-inner">
                <textarea class="tf-form-control tf-notes-textarea" @bind="_dto.Notes" placeholder="Nhập ghi chú điều khoản giao hàng, thanh toán hoặc lưu ý khác..." rows="5"></textarea>
            </div>
        </div>

        <div class="tf-card tf-invoice-card tf-summary-card">
            <div class="tf-card-section-header tf-summary-card-header">
                <h3 class="tf-card-section-title">Tổng cộng thanh toán</h3>
            </div>
            <div class="tf-summary-body">
                <div class="tf-summary-row">
                    <span class="tf-summary-label">Cộng tiền hàng:</span>
                    <strong class="tf-summary-val">@_dto.SubTotal.ToString("N0") đ</strong>
                </div>
                @if (_dto.TotalDiscount > 0)
                {
                    <div class="tf-summary-row">
                        <span class="tf-summary-label">Tiền chiết khấu:</span>
                        <strong class="tf-summary-val text-success">-@_dto.TotalDiscount.ToString("N0") đ</strong>
                    </div>
                }
                @if (_dto.Type == InvoiceType.VatInvoice)
                {
                    <div class="tf-summary-row">
                        <span class="tf-summary-label">Tiền thuế GTGT:</span>
                        <strong class="tf-summary-val">@_dto.TotalTax.ToString("N0") đ</strong>
                    </div>
                }
                <div class="tf-summary-divider"></div>
                <div class="tf-summary-total-row">
                    <span class="tf-summary-total-label">Tổng thanh toán:</span>
                    <strong class="tf-summary-total-val">@_dto.GrandTotal.ToString("N0") đ</strong>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private InvoiceDto _dto = new() { InvoiceDate = DateTime.Now, Type = InvoiceType.VatInvoice, PaymentMethod = "TM/CK" };
    private bool _isProcessing = false;
    private string? _errorMessage;

    private string _customerSearch = "";
    private List<Customer> _customers = new();
    
    private string _productSearch = "";
    private List<Product> _products = new();

    private void ClearCustomerSearch()
    {
        _customerSearch = "";
        _customers.Clear();
    }

    private void ClearProductSearch()
    {
        _productSearch = "";
        _products.Clear();
    }

    private CancellationTokenSource? _customerSearchCts;
    private async Task SearchCustomers(KeyboardEventArgs e)
    {
        _customerSearchCts?.Cancel();
        _customerSearchCts = new CancellationTokenSource();
        var token = _customerSearchCts.Token;

        if (_customerSearch.Length >= 2)
        {
            try
            {
                await Task.Delay(300, token);
                if (!token.IsCancellationRequested)
                {
                    _customers = await SalesService.SearchCustomersAsync(_customerSearch, token);
                    StateHasChanged();
                }
            }
            catch (TaskCanceledException) { }
        }
        else
        {
            _customers.Clear();
        }
    }

    private void SelectCustomer(Customer c)
    {
        _dto.CustomerId = c.Id;
        _dto.CustomerName = c.Name;
        _dto.CustomerCompanyName = c.CompanyName;
        _dto.CustomerTaxCode = c.TaxCode;
        _dto.CustomerAddress = c.Address;
        _dto.CustomerEmail = c.Phone;
        _customers.Clear();
        _customerSearch = "";
    }

    private CancellationTokenSource? _productSearchCts;
    private async Task SearchProducts(KeyboardEventArgs e)
    {
        _productSearchCts?.Cancel();
        _productSearchCts = new CancellationTokenSource();
        var token = _productSearchCts.Token;

        if (_productSearch.Length >= 2)
        {
            try
            {
                await Task.Delay(300, token);
                if (!token.IsCancellationRequested)
                {
                    _products = await SalesService.SearchProductsAsync(_productSearch, token);
                    StateHasChanged();
                }
            }
            catch (TaskCanceledException) { }
        }
        else
        {
            _products.Clear();
        }
    }

    private async Task SelectProduct(Product p)
    {
        var price = await SalesService.GetActivePriceAsync(p.Id, _dto.InvoiceDate);

        _dto.Items.Add(new InvoiceItemDto
        {
            ProductId = p.Id,
            ProductCode = p.Code,
            ProductName = p.Name,
            UnitName = p.Unit?.Name ?? string.Empty,
            Quantity = 1,
            UnitPrice = price,
            TaxRate = _dto.Type == InvoiceType.VatInvoice ? 10 : 0
        });
        _products.Clear();
        _productSearch = "";
        CalculateTotals();
    }

    private void AddManualItem()
    {
        _dto.Items.Add(new InvoiceItemDto { Quantity = 1, TaxRate = _dto.Type == InvoiceType.VatInvoice ? 10 : 0 });
        CalculateTotals();
    }

    private void RemoveItem(InvoiceItemDto item)
    {
        _dto.Items.Remove(item);
        CalculateTotals();
    }

    private void CalculateTotals()
    {
        _dto.SubTotal = _dto.Items.Sum(x => x.Quantity * x.UnitPrice);
        _dto.TotalDiscount = _dto.Items.Sum(x => x.DiscountAmount);
        _dto.TotalTax = 0;

        foreach (var item in _dto.Items)
        {
            if (_dto.Type != InvoiceType.VatInvoice) item.TaxRate = 0;
            
            var lineAmount = (item.Quantity * item.UnitPrice) - item.DiscountAmount;
            item.TaxAmount = _dto.Type == InvoiceType.VatInvoice ? Math.Round(lineAmount * (item.TaxRate / 100m), 0) : 0m;
            item.LineTotal = lineAmount + item.TaxAmount;

            _dto.TotalTax += item.TaxAmount;
        }

        _dto.GrandTotal = _dto.SubTotal - _dto.TotalDiscount + _dto.TotalTax;
    }

    private async Task SaveInvoice()
    {
        if (string.IsNullOrWhiteSpace(_dto.CustomerName))
        {
            _errorMessage = "Vui lòng nhập họ tên người mua.";
            return;
        }
        if (!_dto.Items.Any())
        {
            _errorMessage = "Vui lòng thêm ít nhất một hàng hóa/dịch vụ.";
            return;
        }

        _isProcessing = true;
        _errorMessage = null;
        try
        {
            CalculateTotals();
            var inv = await InvoiceService.CreateManualInvoiceAsync(_dto);
            Nav.NavigateTo($"/hoa-don/chi-tiet/{inv.Id}");
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isProcessing = false;
        }
    }
}
