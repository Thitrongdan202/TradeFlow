@page "/hoa-don/chi-tiet/{Id:int}"
@using Microsoft.AspNetCore.Authorization
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Application.Common.Models.Sales
@using TradeFlow.Domain.Enums
@using Microsoft.JSInterop
@inject IInvoiceService InvoiceService
@inject NavigationManager Nav
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Permission:Invoices:View")]

<PageTitle>Chi tiết Hóa đơn | TradeFlow</PageTitle>

@if (_isLoading)
{
    <div class="tf-loading">Đang tải dữ liệu...</div>
}
else if (_invoice == null)
{
    <div class="tf-alert tf-alert-danger">Không tìm thấy hóa đơn.</div>
}
else
{
    <div class="tf-page-header">
        <div class="tf-page-header-content">
            <div style="display:flex; align-items:center; gap:12px;">
                <h1 class="tf-page-title">Hóa đơn @_invoice.InvoiceNumber</h1>
                @if (_invoice.Status == InvoiceStatus.Draft)
                {
                    <span class="tf-badge tf-badge-secondary">Nháp</span>
                }
                else if (_invoice.Status == InvoiceStatus.Issued)
                {
                    <span class="tf-badge tf-badge-success">Đã phát hành</span>
                }
                else
                {
                    <span class="tf-badge tf-badge-danger">Đã hủy</span>
                }
            </div>
            <p class="tf-page-subtitle">Ngày tạo: @_invoice.InvoiceDate.ToString("dd/MM/yyyy")</p>
        </div>
        <div class="tf-page-header-actions">
            @if (_invoice.Status == InvoiceStatus.Draft)
            {
                <AuthorizeView Policy="Permission:Invoices:Approve">
                    <button class="tf-btn tf-btn-success" @onclick="IssueInvoice" disabled="@_isProcessing">Phát hành</button>
                </AuthorizeView>
            }
            <button class="tf-btn tf-btn-outline-primary" @onclick="ExportPdf" disabled="@_isProcessing">Xuất PDF</button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="tf-alert tf-alert-danger tf-mb-4">
            @_errorMessage
            <button type="button" style="float:right; background:none; border:none; cursor:pointer;" @onclick="() => _errorMessage = null">✕</button>
        </div>
    }

    <div class="tf-card tf-mb-4" style="padding: 40px;">
        <!-- Company Header -->
        <div style="display:flex; justify-content:space-between; border-bottom:2px solid #e2e8f0; padding-bottom:20px; margin-bottom:20px;">
            <div>
                <h2 style="margin:0; font-size:24px; color:var(--tf-color-primary);">@_invoice.CompanyName</h2>
                <p style="margin:4px 0;">MST: @_invoice.CompanyTaxCode</p>
                <p style="margin:4px 0; max-width:300px;">@_invoice.CompanyAddress</p>
                <p style="margin:4px 0;">SĐT: @_invoice.CompanyPhone</p>
            </div>
            <div style="text-align:right;">
                <h1 style="margin:0; font-size:36px; color:#64748b;">HÓA ĐƠN BÁN HÀNG</h1>
                <p style="margin:4px 0; font-size:16px;"><strong>Số: @_invoice.InvoiceNumber</strong></p>
                <p style="margin:4px 0;">Ngày: @_invoice.InvoiceDate.ToString("dd/MM/yyyy")</p>
            </div>
        </div>

        <!-- Customer Info -->
        <div style="margin-bottom:30px;">
            <h3 style="font-size:14px; color:#64748b; margin-bottom:8px;">THÔNG TIN KHÁCH HÀNG:</h3>
            <p style="margin:4px 0;"><strong>Đơn vị mua:</strong> @_invoice.CustomerName</p>
            @if(!string.IsNullOrEmpty(_invoice.CustomerTaxCode)) { <p style="margin:4px 0;"><strong>MST:</strong> @_invoice.CustomerTaxCode</p> }
            <p style="margin:4px 0;"><strong>Địa chỉ:</strong> @_invoice.CustomerAddress</p>
        </div>

        <!-- Items Table -->
        <table style="width:100%; border-collapse:collapse; margin-bottom:30px;">
            <thead>
                <tr style="background:#f1f5f9; border-bottom:2px solid #cbd5e1;">
                    <th style="padding:12px; text-align:left;">Mã Hàng</th>
                    <th style="padding:12px; text-align:left;">Tên Hàng Hóa</th>
                    <th style="padding:12px; text-align:center;">ĐVT</th>
                    <th style="padding:12px; text-align:right;">Số lượng</th>
                    <th style="padding:12px; text-align:right;">Đơn giá</th>
                    <th style="padding:12px; text-align:right;">Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in _invoice.Items)
                {
                    <tr style="border-bottom:1px solid #e2e8f0;">
                        <td style="padding:12px;">@item.ProductCode</td>
                        <td style="padding:12px;">@item.ProductName</td>
                        <td style="padding:12px; text-align:center;">@item.UnitName</td>
                        <td style="padding:12px; text-align:right;">@item.Quantity</td>
                        <td style="padding:12px; text-align:right;">@item.UnitPrice.ToString("N0")</td>
                        <td style="padding:12px; text-align:right;"><strong>@item.LineTotal.ToString("N0")</strong></td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Totals -->
        <div style="display:flex; justify-content:flex-end;">
            <table style="width:300px;">
                <tr>
                    <td style="padding:8px 0; color:#64748b;">Tổng tiền hàng:</td>
                    <td style="padding:8px 0; text-align:right;"><strong>@_invoice.SubTotal.ToString("N0")</strong></td>
                </tr>
                <tr>
                    <td style="padding:8px 0; color:#64748b;">Chiết khấu:</td>
                    <td style="padding:8px 0; text-align:right;"><strong>@_invoice.TotalDiscount.ToString("N0")</strong></td>
                </tr>
                <tr>
                    <td style="padding:8px 0; color:#64748b; font-size:18px; border-top:1px solid #cbd5e1; padding-top:12px;">Tổng cộng:</td>
                    <td style="padding:8px 0; text-align:right; font-size:18px; border-top:1px solid #cbd5e1; padding-top:12px;"><strong style="color:var(--tf-color-danger);">@_invoice.GrandTotal.ToString("N0")</strong></td>
                </tr>
                <tr>
                    <td colspan="2" style="padding:12px 0 0 0; font-style:italic; font-size:14px; text-align:right; color:#64748b;">
                        Số tiền viết bằng chữ: @TradeFlow.Application.Common.Helpers.NumberToTextHelper.ConvertToWords((long)_invoice.GrandTotal) đồng
                    </td>
                </tr>
            </table>
        </div>
        
        <div style="margin-top:40px; text-align:center; font-style:italic; color:#64748b;">
            <p>Xin cảm ơn Quý khách đã mua sắm tại @_invoice.CompanyName!</p>
        </div>
    </div>
}


@if (_showDeleteModal)
{
    <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center;">
        <div style="background: white; padding: 24px; border-radius: 8px; width: 400px; max-width: 90%; box-shadow: 0 10px 25px rgba(0,0,0,0.2);">
            <h3 style="margin-top: 0; margin-bottom: 16px; font-size: 18px; color: var(--tf-danger);">Xóa dữ liệu?</h3>
            <p style="margin-bottom: 24px;">Bạn có chắc chắn muốn xóa bản ghi này?</p>
            @if (!string.IsNullOrEmpty(_deleteError))
            {
                <div class="tf-alert tf-alert-danger" style="margin-bottom: 16px;">
                    @_deleteError
                </div>
            }
            <div style="display: flex; justify-content: flex-end; gap: 12px;">
                <button type="button" class="tf-btn tf-btn-outline-secondary" @onclick="CancelDelete">Hủy</button>
                <button type="button" class="tf-btn tf-btn-danger" @onclick="ExecuteDelete">Xóa</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private InvoiceDto? _invoice;
    private bool _isLoading = true;
    private bool _isProcessing = false;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            _isLoading = true;
            _invoice = await InvoiceService.GetInvoiceByIdAsync(Id);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task IssueInvoice()
    {
        _isProcessing = true;
        _errorMessage = null;
        try
        {
            await InvoiceService.IssueInvoiceAsync(Id);
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task ExportPdf()
    {
        _isProcessing = true;
        try
        {
            var bytes = await InvoiceService.GeneratePdfAsync(Id);
            var b64 = Convert.ToBase64String(bytes);
            
            // Trigger download via JS
            await JS.InvokeVoidAsync("eval", $@"
                var link = document.createElement('a');
                link.download = 'Invoice_{_invoice?.InvoiceNumber}.pdf';
                link.href = 'data:application/pdf;base64,{b64}';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            ");
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private bool _showDeleteModal = false;
    private string? _deleteError;

    private void ConfirmDelete()
    {
        _showDeleteModal = true;
        _deleteError = null;
    }

    private void CancelDelete()
    {
        _showDeleteModal = false;
        _deleteError = null;
    }

    private async Task ExecuteDelete()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!(await AuthService.AuthorizeAsync(authState.User, "Permission:Invoices:Delete")).Succeeded)
        {
            _deleteError = "Bạn không có quyền thực hiện thao tác này.";
            return;
        }

        try
        {
            var ok = await InvoiceService.DeleteInvoiceAsync(Id); if(ok) { Nav.NavigateTo("/hoa-don"); } else { _deleteError = "Không thể xóa."; }
        }
        catch (Exception ex)
        {
            _deleteError = "Đã xảy ra lỗi: " + ex.Message;
        }
    }

}