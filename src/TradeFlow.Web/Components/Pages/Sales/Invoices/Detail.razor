@page "/hoa-don/chi-tiet/{Id:int}"
@using Microsoft.AspNetCore.Authorization
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Application.Common.Models.Sales
@using TradeFlow.Application.Common.Helpers
@using TradeFlow.Domain.Enums
@inject IInvoiceService InvoiceService
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IJSRuntime JS
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Permission:Invoices:View")]

<PageTitle>Chi tiết hóa đơn | TradeFlow</PageTitle>

<div class="tf-page-header">
    <div class="tf-page-header-content">
        <h1 class="tf-page-title">Chi tiết hóa đơn</h1>
        <p class="tf-page-subtitle">Xem trước hóa đơn theo mẫu chuẩn, xuất PDF, ký điện tử và tải tệp XML.</p>
    </div>
    <div class="tf-page-header-actions">
        <a href="/hoa-don" class="tf-btn tf-btn-outline-secondary">Quay lại</a>
        @if (_invoice?.Status == InvoiceStatus.Draft)
        {
            <AuthorizeView Policy="Permission:Invoices:Edit">
                <a href="/hoa-don/sua/@Id" class="tf-btn tf-btn-secondary">Sửa hóa đơn</a>
            </AuthorizeView>
            <AuthorizeView Policy="Permission:Invoices:Delete">
                <button class="tf-btn tf-btn-danger" @onclick="ConfirmDelete">Xóa</button>
            </AuthorizeView>
        }
        @if (_invoice != null)
        {
            @if (_invoice.SignatureStatus != DigitalSignatureStatus.Signed)
            {
                <button class="tf-btn tf-btn-success" @onclick="SignInvoice" disabled="@_isProcessing">✍ Ký điện tử</button>
            }
            <button class="tf-btn tf-btn-outline-primary" @onclick="ExportPdf" disabled="@_isProcessing">⬇ Tải PDF</button>
            <button class="tf-btn tf-btn-outline-secondary" @onclick="ExportXml" disabled="@_isProcessing">📄 Tải XML</button>
        }
    </div>
</div>

@if (_isLoading)
{
    <div class="tf-loading">Đang tải dữ liệu...</div>
}
else if (_invoice == null)
{
    <div class="tf-alert tf-alert-danger">Không tìm thấy hóa đơn.</div>
}
else
{
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="tf-alert tf-alert-danger tf-mb-4">@_errorMessage</div>
    }
    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="tf-alert tf-alert-success tf-mb-4">@_successMessage</div>
    }

    @* Tab switcher *@
    <div style="display:flex; gap:8px; margin-bottom:16px;">
        <button class="tf-btn @(_activeTab == "preview" ? "tf-btn-primary" : "tf-btn-secondary")"
                @onclick='() => _activeTab = "preview"'>Xem trước (Mẫu hóa đơn)</button>
        <button class="tf-btn @(_activeTab == "pdf" ? "tf-btn-primary" : "tf-btn-secondary")"
                @onclick='() => _activeTab = "pdf"'>Bản in PDF</button>
        <button class="tf-btn @(_activeTab == "xml" ? "tf-btn-primary" : "tf-btn-secondary")"
                @onclick='() => _activeTab = "xml"'>Dữ liệu XML</button>
    </div>

    @if (_activeTab == "pdf")
    {
        <div class="tf-card" style="padding:0; overflow:hidden; border:none; box-shadow:none;">
            <iframe src="data:application/pdf;base64,@_pdfBase64"
                    style="width:100%; height:880px; border:1px solid #e2e8f0; border-radius:8px;"></iframe>
        </div>
    }
    else if (_activeTab == "xml")
    {
        <div class="tf-card" style="padding:16px;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
                <h3 style="margin:0; font-size:15px; font-weight:600;">Dữ liệu Hóa đơn điện tử XML (NĐ 123 / TT 78)</h3>
                <button class="tf-btn tf-btn-sm tf-btn-outline-primary" @onclick="ExportXml">Tải tệp .xml</button>
            </div>
            <pre style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:6px; padding:16px; font-size:12px; max-height:600px; overflow:auto; white-space:pre-wrap; word-break:break-all;">@_xmlContent</pre>
        </div>
    }
    else
    {
        @* ─── WEB PREVIEW — strictly matching reference empty invoice template (media_1789552936429.pdf) ─── *@
        <div style="max-width:820px; margin:0 auto 24px; font-family:Arial,sans-serif; font-size:8.5pt; color:@BorderBlue; background:#fff; border:2px solid @BorderBlue; padding:3px;">
            <div style="border:1px solid @BorderBlue;">

                @* ── 1. HEADER ── *@
                <div style="padding:10px 14px 8px;">
                    <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:8px;">
                        <div style="width:140px; flex-shrink:0;"></div>

                        <div style="flex:1; text-align:center;">
                            <div style="font-size:15pt; font-weight:bold; color:@BorderBlue; letter-spacing:0.5px;">
                                HÓA ĐƠN GIÁ TRỊ GIA TĂNG
                            </div>
                            <div style="font-size:10pt; font-weight:600; color:@BorderBlue; margin-top:2px;">
                                (VAT INVOICE)
                            </div>
                        </div>

                        <div style="width:170px; flex-shrink:0; font-size:8pt; color:@BorderBlue; line-height:1.7;">
                            <div><span style="color:@BorderBlue;">Mẫu số <em>(Form No.)</em></span>: <span style="color:#000;">@_invoice.FormNumber</span></div>
                            <div><span style="color:@BorderBlue;">Ký hiệu <em>(Serial No.)</em></span>: <span style="color:#000;">@_invoice.InvoiceSeries</span></div>
                            <div><span style="color:@BorderBlue;">Số <em>(Invoice No.)</em></span>: <strong style="color:#000; font-size:9pt;">@_invoice.InvoiceNo</strong></div>
                        </div>
                    </div>

                    <div style="text-align:center; font-size:8.5pt; padding-top:4px; color:@BorderBlue;">
                        <span>Ngày <em>(day) </em></span><strong style="color:#000;">@_invoice.InvoiceDate.ToString("dd")</strong>
                        <span>   tháng <em>(month) </em></span><strong style="color:#000;">@_invoice.InvoiceDate.ToString("MM")</strong>
                        <span>   năm <em>(year) </em></span><strong style="color:#000;">@_invoice.InvoiceDate.ToString("yyyy")</strong>
                    </div>
                </div>

                @* ── 2. SELLER BLOCK ── *@
                <div style="border-top:1px solid @BorderBlue; padding:4px 8px;">
                    @InfoRowHtml("Đơn vị bán hàng (Seller)", _invoice.CompanyName, true)
                    @InfoRowHtml("MST (Tax Code)", _invoice.CompanyTaxCode)
                    @InfoRowHtml("Địa chỉ (Address)", _invoice.CompanyAddress)
                    @InfoRowDualHtml("Điện thoại (Tel.)", _invoice.CompanyPhone, "Email", _invoice.CompanyEmail)
                    @InfoRowDualHtml("STK (Account No.)", _invoice.CompanyBankAccount, "Ngân hàng (Bank)", _invoice.CompanyBankName)
                </div>

                @* ── 3. BUYER BLOCK ── *@
                <div style="border-top:1px solid @BorderBlue; padding:4px 8px;">
                    @InfoRowHtml("Người mua hàng (Buyer)", _invoice.CustomerName, true)
                    @InfoRowHtml("Đơn vị (Co. name)", _invoice.CustomerCompanyName)
                    @InfoRowHtml("MST (Tax Code)", _invoice.CustomerTaxCode)
                    @InfoRowHtml("Địa chỉ (Address)", _invoice.CustomerAddress)
                    @InfoRowHtml("HTTT (Pay. method)", _invoice.PaymentMethod ?? "TM/CK")
                    @InfoRowDualHtml("STK (Account No.)", _invoice.CustomerBankAccount, "Ngân hàng (Bank)", _invoice.CustomerBankName)
                </div>

                @* ── 4. PRODUCT TABLE ── *@
                <div style="border-top:1px solid @BorderBlue;">
                    <table style="width:100%; border-collapse:collapse; font-size:8.5pt;">
                        <thead>
                            <tr style="background:@TableHeadBg;">
                                <th style="border:0.5px solid @BorderBlue; padding:5px 3px; text-align:center; width:32px; color:@BorderBlue;">
                                    STT<br /><em style="font-size:7pt; font-weight:normal;">(No.)</em>
                                </th>
                                <th style="border:0.5px solid @BorderBlue; padding:5px 4px; text-align:center; color:@BorderBlue;">
                                    Tên hàng hoá, dịch vụ<br /><em style="font-size:7pt; font-weight:normal;">(Description)</em>
                                </th>
                                <th style="border:0.5px solid @BorderBlue; padding:5px 3px; text-align:center; width:44px; color:@BorderBlue;">
                                    ĐVT<br /><em style="font-size:7pt; font-weight:normal;">(Unit)</em>
                                </th>
                                <th style="border:0.5px solid @BorderBlue; padding:5px 3px; text-align:center; width:48px; color:@BorderBlue;">
                                    SL<br /><em style="font-size:7pt; font-weight:normal;">(Quantity)</em>
                                </th>
                                <th style="border:0.5px solid @BorderBlue; padding:5px 3px; text-align:center; width:75px; color:@BorderBlue;">
                                    Đơn giá<br /><em style="font-size:7pt; font-weight:normal;">(Unit Price)</em>
                                </th>
                                <th style="border:0.5px solid @BorderBlue; padding:5px 3px; text-align:center; width:80px; color:@BorderBlue;">
                                    Thành tiền<br /><em style="font-size:7pt; font-weight:normal;">(Amount)</em>
                                </th>
                                @if (IsVat)
                                {
                                    <th style="border:0.5px solid @BorderBlue; padding:5px 3px; text-align:center; width:52px; color:@BorderBlue;">
                                        Thuế suất<br /><em style="font-size:7pt; font-weight:normal;">(Tax Rate)</em>
                                    </th>
                                    <th style="border:0.5px solid @BorderBlue; padding:5px 3px; text-align:center; width:75px; color:@BorderBlue;">
                                        Tiền thuế<br /><em style="font-size:7pt; font-weight:normal;">(Tax Amount)</em>
                                    </th>
                                }
                            </tr>
                            @* Column numbers row: 1 | 2 | 3 | 4 | 5 | 6 = 4 x 5 | 7 | 8 = 6 x 7 *@
                            <tr style="background:@RowAltBg; font-style:italic; font-size:7.5pt; color:@BorderBlue;">
                                <td style="border:0.5px solid @BorderBlue; padding:2px; text-align:center;">1</td>
                                <td style="border:0.5px solid @BorderBlue; padding:2px; text-align:center;">2</td>
                                <td style="border:0.5px solid @BorderBlue; padding:2px; text-align:center;">3</td>
                                <td style="border:0.5px solid @BorderBlue; padding:2px; text-align:center;">4</td>
                                <td style="border:0.5px solid @BorderBlue; padding:2px; text-align:center;">5</td>
                                <td style="border:0.5px solid @BorderBlue; padding:2px; text-align:center;">6 = 4 x 5</td>
                                @if (IsVat)
                                {
                                    <td style="border:0.5px solid @BorderBlue; padding:2px; text-align:center;">7</td>
                                    <td style="border:0.5px solid @BorderBlue; padding:2px; text-align:center;">8 = 6 x 7</td>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int rowIdx = 1;
                                foreach (var item in _invoice.Items)
                                {
                                    var lineAmt = item.Quantity * item.UnitPrice - item.DiscountAmount;
                                    <tr>
                                        <td style="border:0.5px solid @BorderBlue; padding:4px 3px; text-align:center; color:#000;">@rowIdx</td>
                                        <td style="border:0.5px solid @BorderBlue; padding:4px 4px; color:#000;">@item.ProductName</td>
                                        <td style="border:0.5px solid @BorderBlue; padding:4px 3px; text-align:center; color:#000;">@item.UnitName</td>
                                        <td style="border:0.5px solid @BorderBlue; padding:4px 3px; text-align:right; color:#000;">@item.Quantity.ToString("G29")</td>
                                        <td style="border:0.5px solid @BorderBlue; padding:4px 3px; text-align:right; color:#000;">@item.UnitPrice.ToString("N0", ViCulture)</td>
                                        <td style="border:0.5px solid @BorderBlue; padding:4px 3px; text-align:right; color:#000;">@lineAmt.ToString("N0", ViCulture)</td>
                                        @if (IsVat)
                                        {
                                            <td style="border:0.5px solid @BorderBlue; padding:4px 3px; text-align:center; color:#000;">@item.TaxRate%</td>
                                            <td style="border:0.5px solid @BorderBlue; padding:4px 3px; text-align:right; color:#000;">@item.TaxAmount.ToString("N0", ViCulture)</td>
                                        }
                                    </tr>
                                    rowIdx++;
                                }

                                @* Minimum height padding up to 8 rows to preserve exact empty template proportions *@
                                int emptyCount = Math.Max(0, 8 - _invoice.Items.Count);
                                int colCount = IsVat ? 8 : 6;
                                for (int e = 0; e < emptyCount; e++)
                                {
                                    <tr>
                                        @for (int ci = 0; ci < colCount; ci++)
                                        {
                                            <td style="border:0.5px solid @BorderBlue; padding:0; height:22px;"></td>
                                        }
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                @* ── 5. TOTALS SECTION ── *@
                <div style="border-top:0.5px solid @BorderBlue;">
                    @if (IsVat)
                    {
                        @TotalRowHtml("Cộng tiền hàng", "(Sub total)", _invoice.SubTotal.ToString("N0", ViCulture))
                        @TotalRowHtml("Cộng tiền thuế GTGT", "(VAT amount)", _invoice.TotalTax.ToString("N0", ViCulture))
                    }
                    @TotalRowHtml("Tổng cộng tiền thanh toán", "(Total payment)", _invoice.GrandTotal.ToString("N0", ViCulture), true)
                </div>

                @* ── 6. AMOUNT IN WORDS ── *@
                <div style="border-top:0.5px solid @BorderBlue; padding:5px 8px; display:flex; gap:4px; font-size:8.5pt;">
                    <span style="white-space:nowrap; color:@BorderBlue;">
                        Số tiền viết bằng chữ <em>(Amount in words)</em>:
                    </span>
                    <span style="font-style:italic; color:#000;">
                        @NumberToTextHelper.ConvertToWords((long)_invoice.GrandTotal) đồng chẵn.
                    </span>
                </div>

                @* ── 7. SIGNATURE AREA ── *@
                <div style="border-top:1px solid @BorderBlue; display:flex;">
                    @* Buyer (left) *@
                    <div style="flex:1; padding:10px 8px; text-align:center;">
                        <div style="font-weight:bold; color:@BorderBlue; font-size:9pt;">
                            Người mua hàng <em style="font-weight:normal; font-size:8pt;">(Buyer)</em>
                        </div>
                        <div style="font-size:8pt; font-style:italic; color:#4b5563;">(Ký, ghi rõ họ tên)</div>
                        <div style="font-size:7.5pt; font-style:italic; color:#4b5563;">(Sign, full name)</div>
                        <div style="height:70px;"></div>
                    </div>

                    @* Seller (right) *@
                    <div style="flex:1; padding:10px 8px; text-align:center;">
                        <div style="font-weight:bold; color:@BorderBlue; font-size:9pt;">
                            Người bán hàng <em style="font-weight:normal; font-size:8pt;">(Seller)</em>
                        </div>
                        <div style="font-size:8pt; font-style:italic; color:#4b5563;">(Ký, ghi rõ họ tên, đóng dấu nếu có)</div>
                        <div style="font-size:7.5pt; font-style:italic; color:#4b5563;">(Sign, full name, stamp if any)</div>

                        @* Actual electronic signature state display *@
                        @if (_invoice.SignatureStatus == DigitalSignatureStatus.Signed)
                        {
                            <div style="margin:8px auto 0; display:inline-block; border:1px solid #4caf50; background:#f1f8e9; border-radius:6px; padding:10px 18px; min-width:210px; text-align:center;">
                                <div style="font-weight:bold; color:#2e7d32; font-size:8.5pt;">Đã được ký điện tử bởi</div>
                                <div style="font-style:italic; color:#2e7d32; font-size:7.5pt;">(Signed digitally by)</div>
                                <div style="font-size:24pt; color:#4caf50; line-height:1.2; margin:2px 0;">✓</div>
                                <div style="font-weight:bold; color:#1b5e20; font-size:8.5pt; letter-spacing:0.4px;">@_invoice.CompanyName.ToUpper()</div>
                                <div style="font-size:8pt; color:#2e7d32; margin-top:4px;">
                                    Ký ngày: @((_invoice.SignedAt ?? _invoice.InvoiceDate).ToString("dd/MM/yyyy"))
                                </div>
                            </div>
                        }
                        else if (_invoice.SignatureStatus == DigitalSignatureStatus.Invalid)
                        {
                            <div style="margin:8px auto 0; display:inline-block; border:1px solid #e53935; background:#ffebee; border-radius:6px; padding:8px 16px; text-align:center;">
                                <div style="font-weight:bold; color:#c62828; font-size:8.5pt;">Chữ ký không hợp lệ</div>
                                <div style="font-style:italic; color:#c62828; font-size:7.5pt;">(Invalid signature)</div>
                            </div>
                        }
                        else
                        {
                            <div style="height:70px;"></div>
                        }
                    </div>
                </div>

                @* ── 8. FOOTER NOTE ── *@
                <div style="border-top:0.5px solid @BorderBlue; padding:4px 8px; display:flex; justify-content:space-between; font-size:7.5pt; color:#4b5563;">
                    <div style="font-style:italic;">(Khởi tạo theo quy định về hóa đơn chứng từ bán hàng & cung ứng dịch vụ)</div>
                    <div>Trang 1/1</div>
                </div>

            </div>
        </div>
    }
}

@if (_showDeleteModal)
{
    <div style="position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1000; display:flex; align-items:center; justify-content:center;">
        <div style="background:white; padding:24px; border-radius:8px; width:400px; max-width:90%; box-shadow:0 10px 25px rgba(0,0,0,0.2);">
            <h3 style="margin-top:0; margin-bottom:16px; font-size:18px; color:var(--tf-danger);">Xóa hóa đơn?</h3>
            <p style="margin-bottom:24px;">Bạn có chắc chắn muốn xóa bản ghi này?</p>
            @if (!string.IsNullOrEmpty(_deleteError))
            {
                <div class="tf-alert tf-alert-danger" style="margin-bottom:16px;">@_deleteError</div>
            }
            <div style="display:flex; justify-content:flex-end; gap:12px;">
                <button type="button" class="tf-btn tf-btn-outline-secondary" @onclick="CancelDelete">Hủy</button>
                <button type="button" class="tf-btn tf-btn-danger" @onclick="ExecuteDelete">Xóa</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    // Palette strictly matching empty invoice template (media_1789552936429.pdf)
    private const string BorderBlue  = "#0b5394";
    private const string TableHeadBg = "#d9edf7";
    private const string RowAltBg    = "#f2f7fb";

    private bool IsVat => _invoice?.Type == InvoiceType.VatInvoice;
    private static readonly System.Globalization.CultureInfo ViCulture = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");

    private InvoiceDto? _invoice;
    private string? _pdfBase64;
    private string? _xmlContent;
    private bool _isLoading = true;
    private bool _isProcessing = false;
    private string? _errorMessage;
    private string? _successMessage;
    private string _activeTab = "preview";

    protected override async Task OnInitializedAsync() => await LoadDataAsync();

    private async Task LoadDataAsync()
    {
        try
        {
            _isLoading = true;
            _invoice = await InvoiceService.GetInvoiceByIdAsync(Id);
            if (_invoice != null)
            {
                var bytes = await InvoiceService.GeneratePdfAsync(Id);
                _pdfBase64 = Convert.ToBase64String(bytes);
                _xmlContent = await InvoiceService.GenerateXmlAsync(Id);
            }
        }
        finally { _isLoading = false; }
    }

    private RenderFragment InfoRowHtml(string label, string? value, bool boldValue = false) => __builder =>
    {
        __builder.OpenElement(0, "div");
        __builder.AddAttribute(1, "style", "padding:2px 0; display:flex; gap:6px; font-size:8.5pt;");
        __builder.OpenElement(2, "span");
        __builder.AddAttribute(3, "style", $"white-space:nowrap; color:{BorderBlue};");
        __builder.AddContent(4, label + ": ");
        __builder.CloseElement();
        __builder.OpenElement(5, "span");
        __builder.AddAttribute(6, "style", $"color:#000; {(boldValue ? "font-weight:bold;" : "")}");
        __builder.AddContent(7, value ?? "");
        __builder.CloseElement();
        __builder.CloseElement();
    };

    private RenderFragment InfoRowDualHtml(string label1, string? val1, string label2, string? val2) => __builder =>
    {
        __builder.OpenElement(0, "div");
        __builder.AddAttribute(1, "style", "padding:2px 0; display:flex; gap:16px; font-size:8.5pt;");

        __builder.OpenElement(2, "div");
        __builder.AddAttribute(3, "style", "flex:1; display:flex; gap:6px;");
        __builder.OpenElement(4, "span");
        __builder.AddAttribute(5, "style", $"white-space:nowrap; color:{BorderBlue};");
        __builder.AddContent(6, label1 + ": ");
        __builder.CloseElement();
        __builder.OpenElement(7, "span");
        __builder.AddAttribute(8, "style", "color:#000;");
        __builder.AddContent(9, val1 ?? "");
        __builder.CloseElement();
        __builder.CloseElement();

        __builder.OpenElement(10, "div");
        __builder.AddAttribute(11, "style", "flex:1; display:flex; gap:6px;");
        __builder.OpenElement(12, "span");
        __builder.AddAttribute(13, "style", $"white-space:nowrap; color:{BorderBlue};");
        __builder.AddContent(14, label2 + ": ");
        __builder.CloseElement();
        __builder.OpenElement(15, "span");
        __builder.AddAttribute(16, "style", "color:#000;");
        __builder.AddContent(17, val2 ?? "");
        __builder.CloseElement();
        __builder.CloseElement();

        __builder.CloseElement();
    };

    private RenderFragment TotalRowHtml(string viLabel, string enLabel, string value, bool bold = false) => __builder =>
    {
        __builder.OpenElement(0, "div");
        __builder.AddAttribute(1, "style", $"border-bottom:0.5px solid {BorderBlue}; display:flex; justify-content:flex-end; font-size:8.5pt;");
        __builder.OpenElement(2, "div");
        __builder.AddAttribute(3, "style", $"padding:3px 8px; text-align:right; color:{BorderBlue};");
        __builder.AddContent(4, viLabel + " ");
        __builder.OpenElement(5, "em");
        __builder.AddAttribute(6, "style", "font-size:7.5pt;");
        __builder.AddContent(7, enLabel);
        __builder.CloseElement();
        __builder.AddContent(8, ":");
        __builder.CloseElement();
        __builder.OpenElement(9, "div");
        __builder.AddAttribute(10, "style", $"border-left:0.5px solid {BorderBlue}; padding:3px 8px; min-width:90px; text-align:right; color:#000; {(bold ? "font-weight:bold; font-size:9pt;" : "")}");
        __builder.AddContent(11, value);
        __builder.CloseElement();
        __builder.CloseElement();
    };

    private async Task SignInvoice()
    {
        _isProcessing = true;
        _errorMessage = null;
        try
        {
            var ok = await InvoiceService.SignInvoiceAsync(Id);
            if (ok)
            {
                _successMessage = "Đã ký điện tử hóa đơn thành công!";
                await LoadDataAsync();
            }
            else
            {
                _errorMessage = "Không thể ký điện tử hóa đơn.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Lỗi khi ký: " + ex.Message;
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task ExportPdf()
    {
        if (string.IsNullOrEmpty(_pdfBase64) || _invoice == null) return;
        _isProcessing = true;
        try
        {
            await JS.InvokeVoidAsync("eval", $@"
                var link = document.createElement('a');
                link.download = 'HoaDon_{_invoice.InvoiceSeries}_{_invoice.InvoiceNo}.pdf';
                link.href = 'data:application/pdf;base64,{_pdfBase64}';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            ");
        }
        catch (Exception ex) { _errorMessage = ex.Message; }
        finally { _isProcessing = false; }
    }

    private async Task ExportXml()
    {
        if (string.IsNullOrEmpty(_xmlContent) || _invoice == null) return;
        _isProcessing = true;
        try
        {
            var base64Xml = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(_xmlContent));
            await JS.InvokeVoidAsync("eval", $@"
                var link = document.createElement('a');
                link.download = 'HoaDon_{_invoice.InvoiceSeries}_{_invoice.InvoiceNo}.xml';
                link.href = 'data:application/xml;base64,{base64Xml}';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            ");
        }
        catch (Exception ex) { _errorMessage = ex.Message; }
        finally { _isProcessing = false; }
    }

    private bool _showDeleteModal = false;
    private string? _deleteError;

    private void ConfirmDelete() { _showDeleteModal = true; _deleteError = null; }
    private void CancelDelete() { _showDeleteModal = false; _deleteError = null; }

    private async Task ExecuteDelete()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!(await AuthService.AuthorizeAsync(authState.User, "Permission:Invoices:Delete")).Succeeded)
        {
            _deleteError = "Bạn không có quyền thực hiện thao tác này.";
            return;
        }
        try
        {
            var ok = await InvoiceService.DeleteInvoiceAsync(Id);
            if (ok) Nav.NavigateTo("/hoa-don"); else _deleteError = "Không thể xóa.";
        }
        catch (Exception ex) { _deleteError = "Đã xảy ra lỗi: " + ex.Message; }
    }
}
