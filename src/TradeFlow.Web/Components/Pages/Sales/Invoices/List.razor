@page "/hoa-don"
@using Microsoft.AspNetCore.Authorization
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Application.Common.Models.Sales
@using TradeFlow.Domain.Enums
@inject IInvoiceService InvoiceService
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Permission:Invoices:View")]

<PageTitle>Danh sách hóa đơn | TradeFlow</PageTitle>

<div class="tf-page-header">
    <div class="tf-page-header-content">
        <h1 class="tf-page-title">Hóa đơn</h1>
        <p class="tf-page-subtitle">Quản lý hóa đơn bán hàng.</p>
    </div>
    <div class="tf-page-header-actions">
        <AuthorizeView Policy="Permission:Invoices:Create">
            <a href="/hoa-don/tao-moi" class="tf-btn tf-btn-primary">+ Tạo hóa đơn</a>
        </AuthorizeView>
    </div>
</div>

@if (_isLoading && _invoices.Count == 0)
{
    <div class="tf-card">
        <div style="padding: 16px;">
            <Skeleton Type="table" Rows="6" Columns="6" />
        </div>
    </div>
}
else if (!_invoices.Any())
{
    <div class="tf-empty-state">
        <div class="tf-empty-icon">📝</div>
        <h3>Chưa có hóa đơn nào</h3>
        <p>Hóa đơn sẽ tự động sinh ra khi bạn xác nhận Đơn bán hàng, hoặc bạn có thể tạo thủ công.</p>
        <AuthorizeView Policy="Permission:Invoices:Create">
            <a href="/hoa-don/tao-moi" class="tf-btn tf-btn-primary" style="margin-top:16px;">+ Tạo hóa đơn</a>
        </AuthorizeView>
    </div>
}
else
{
    <div class="tf-card">
        <TableLoadingOverlay IsLoading="@_isLoading" LoadingText="Đang tải danh sách hóa đơn...">
            <div class="tf-table-responsive">
                <table class="tf-table">
                <thead>
                    <tr>
                        <th>Số hóa đơn</th>
                        <th>Ngày tạo</th>
                        <th>Khách hàng</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inv in PagedInvoices)
                    {
                        <tr>
                            <td>
                                <span class="tw-font-mono tw-font-semibold tw-text-indigo-700 tw-bg-indigo-50/70 tw-px-2 tw-py-0.5 tw-rounded tw-text-xs">@inv.InvoiceNumber</span>
                            </td>
                            <td class="tw-text-slate-600">@inv.InvoiceDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                <div class="tw-font-medium tw-text-slate-900">@inv.CustomerName</div>
                            </td>
                            <td><strong class="tw-text-rose-600 tw-font-semibold">@inv.GrandTotal.ToString("N0") đ</strong></td>
                            <td>
                                @if (inv.Status == InvoiceStatus.Draft)
                                {
                                    <TfBadge Variant="gray" Dot="true" Text="Nháp" />
                                }
                                else if (inv.Status == InvoiceStatus.Issued)
                                {
                                    <TfBadge Variant="success" Dot="true" Text="Đã phát hành" />
                                }
                                else
                                {
                                    <TfBadge Variant="danger" Dot="true" Text="Đã hủy" />
                                }
                            </td>
                            <td class="tf-text-right">
                                <div class="tw-inline-flex tw-gap-1">
                                    @if (inv.Status == InvoiceStatus.Draft)
                                    {
                                        <a href="/hoa-don/sua/@inv.Id" class="tf-btn tf-btn-ghost tf-btn-sm">Sửa</a>
                                    }
                                    <a href="/hoa-don/chi-tiet/@inv.Id" class="tf-btn tf-btn-ghost tf-btn-sm">Chi tiết</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (_invoices.Any())
        {
            <TfPagination CurrentPage="@_currentPage"
                          PageSize="@_pageSize"
                          TotalCount="@_invoices.Count"
                          ItemName="hóa đơn"
                          PreferenceKey="invoices"
                          CurrentPageChanged="@(p => _currentPage = p)"
                          PageSizeChanged="@(s => { _pageSize = s; _currentPage = 1; })" />
        }
        </TableLoadingOverlay>
    </div>
}

@code {
    private List<InvoiceDto> _invoices = new();
    private bool _isLoading = true;
    private int _currentPage = 1;
    private int _pageSize = 20;

    private IEnumerable<InvoiceDto> PagedInvoices =>
        _invoices.Skip((_currentPage - 1) * _pageSize).Take(_pageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            _isLoading = true;
            _invoices = await InvoiceService.GetInvoicesAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }
}