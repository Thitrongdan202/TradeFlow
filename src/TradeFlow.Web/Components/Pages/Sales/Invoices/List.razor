@page "/hoa-don"
@using Microsoft.AspNetCore.Authorization
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Application.Common.Models.Sales
@using TradeFlow.Domain.Enums
@inject IInvoiceService InvoiceService
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Permission:Invoices:View")]

<PageTitle>Danh sách hóa đơn | TradeFlow</PageTitle>

<div class="tf-page-header">
    <div class="tf-page-header-content">
        <h1 class="tf-page-title">Hóa đơn</h1>
        <p class="tf-page-subtitle">Quản lý hóa đơn bán hàng.</p>
    </div>
</div>

@if (_isLoading)
{
    <div class="tf-loading">Đang tải dữ liệu...</div>
}
else if (!_invoices.Any())
{
    <div class="tf-empty-state">
        <div class="tf-empty-icon">📄</div>
        <h3>Chưa có hóa đơn nào</h3>
        <p>Hóa đơn sẽ tự động sinh ra khi bạn tạo từ một Đơn bán hàng đã xác nhận.</p>
    </div>
}
else
{
    <div class="tf-card">
        <div class="tf-table-responsive">
            <table class="tf-table">
                <thead>
                    <tr>
                        <th>Số hóa đơn</th>
                        <th>Ngày tạo</th>
                        <th>Khách hàng</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inv in _invoices)
                    {
                        <tr>
                            <td><strong>@inv.InvoiceNumber</strong></td>
                            <td>@inv.InvoiceDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                <div><strong>@inv.CustomerName</strong></div>
                            </td>
                            <td><strong style="color:var(--tf-color-danger);">@inv.GrandTotal.ToString("N0")</strong></td>
                            <td>
                                @if (inv.Status == InvoiceStatus.Draft)
                                {
                                    <span class="tf-badge tf-badge-secondary">Nháp</span>
                                }
                                else if (inv.Status == InvoiceStatus.Issued)
                                {
                                    <span class="tf-badge tf-badge-success">Đã phát hành</span>
                                }
                                else
                                {
                                    <span class="tf-badge tf-badge-danger">Đã hủy</span>
                                }
                            </td>
                            <td class="tf-text-right">
                                @if (inv.Status == InvoiceStatus.Draft)
                                {
                                    <a href="/hoa-don/sua/@inv.Id" class="tf-btn tf-btn-sm tf-btn-outline-secondary" style="margin-right:4px;">Sửa</a>
                                }
                                <a href="/hoa-don/chi-tiet/@inv.Id" class="tf-btn tf-btn-sm tf-btn-outline-primary">Chi tiết</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}


@if (_itemToDeleteId != null)
{
    <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center;">
        <div style="background: white; padding: 24px; border-radius: 8px; width: 400px; max-width: 90%; box-shadow: 0 10px 25px rgba(0,0,0,0.2);">
            <h3 style="margin-top: 0; margin-bottom: 16px; font-size: 18px; color: var(--tf-danger);">Xóa hóa đơn?</h3>
            <p style="margin-bottom: 24px;">Bạn có chắc chắn muốn xóa "@(_itemToDeleteName)"?</p>
            @if (!string.IsNullOrEmpty(_deleteError))
            {
                <div class="tf-alert tf-alert-danger" style="margin-bottom: 16px;">
                    @_deleteError
                </div>
            }
            <div style="display: flex; justify-content: flex-end; gap: 12px;">
                <button class="tf-btn tf-btn-outline-secondary" @onclick="CancelDelete">Hủy</button>
                <button class="tf-btn tf-btn-danger" @onclick="ExecuteDelete">Xóa</button>
            </div>
        </div>
    </div>
}

@if (_itemToDeleteId != null)
{
    <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center;">
        <div style="background: white; padding: 24px; border-radius: 8px; width: 400px; max-width: 90%; box-shadow: 0 10px 25px rgba(0,0,0,0.2);">
            <h3 style="margin-top: 0; margin-bottom: 16px; font-size: 18px; color: var(--tf-danger);">Xóa dữ liệu?</h3>
            <p style="margin-bottom: 24px;">Bạn có chắc chắn muốn xóa @_itemToDeleteName?</p>
            @if (!string.IsNullOrEmpty(_deleteError))
            {
                <div class="tf-alert tf-alert-danger" style="margin-bottom: 16px;">
                    @_deleteError
                </div>
            }
            <div style="display: flex; justify-content: flex-end; gap: 12px;">
                <button type="button" class="tf-btn tf-btn-outline-secondary" @onclick="CancelDelete">Hủy</button>
                <button type="button" class="tf-btn tf-btn-danger" @onclick="ExecuteDelete">Xóa</button>
            </div>
        </div>
    </div>
}

@code {
    private int? _itemToDeleteId;
    private string _itemToDeleteName = "";
    private string? _deleteError;

    private List<InvoiceDto> _invoices = new();
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            _isLoading = true;
            _invoices = await InvoiceService.GetInvoicesAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ConfirmDelete(int id, string name)
    {
        _itemToDeleteId = id;
        _itemToDeleteName = name;
        _deleteError = null;
    }

    private void CancelDelete() { _itemToDeleteId = null; _deleteError = null; }
    private async Task ExecuteDelete() { if (_itemToDeleteId == null) return; var authState = await AuthStateProvider.GetAuthenticationStateAsync(); if (!(await AuthService.AuthorizeAsync(authState.User, "Permission:Invoices:Delete")).Succeeded) { _deleteError = "Bạn không có quyền."; return; } try { int id = _itemToDeleteId.Value; await InvoiceService.DeleteInvoiceAsync(id); CancelDelete(); await OnInitializedAsync(); } catch (Exception ex) { _deleteError = "Đã xảy ra lỗi: " + ex.Message; } }

}