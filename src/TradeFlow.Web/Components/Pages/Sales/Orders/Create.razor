@page "/ban-hang/don-ban-hang/tao-moi"
@using Microsoft.AspNetCore.Authorization
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Application.Common.Models.Sales
@using TradeFlow.Domain.Entities.MasterData
@inject ISalesService SalesService
@inject IVatRuleEngine VatRuleEngine
@inject NavigationManager Nav
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Permission:SalesOrders:Create")]

<PageTitle>Tạo đơn bán hàng | TradeFlow</PageTitle>

<div class="tf-page-header">
    <div class="tf-page-header-content">
        <h1 class="tf-page-title">Tạo đơn bán hàng</h1>
    </div>
</div>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="tf-alert tf-alert-danger tf-mb-4">
        @_errorMessage
        <button type="button" style="float:right; background:none; border:none; cursor:pointer;" @onclick="() => _errorMessage = null">✕</button>
    </div>
}

<div class="tf-card tf-mb-4">
    <div style="padding: 20px; border-bottom: 1px solid #e2e8f0; background: #f8fafc;">
        <h3 style="margin: 0 0 16px 0; font-size: 16px;">THÔNG TIN ĐƠN BÁN HÀNG</h3>
        
        <div class="tf-form-group">
            <label class="tf-form-label">Khách hàng <span style="color:red">*</span></label>
            <div style="display:flex; gap:10px; align-items:center;">
                <input type="text" class="tf-form-control" placeholder="🔍 Tìm khách hàng (Tên, Mã, SĐT...)" @bind="_customerSearch" @bind:event="oninput" @onkeyup="SearchCustomers" style="flex:1;" />
                @if (_selectedCustomer != null)
                {
                    <span style="color:green; font-weight:bold;">Đã chọn: @_selectedCustomer.Name</span>
                    <button class="tf-btn tf-btn-sm tf-btn-outline-danger" @onclick="ClearCustomer">Bỏ chọn</button>
                }
            </div>
            @if (_isCustomerSearched)
            {
                <div style="position:relative; z-index:100;">
                    <ul style="position:absolute; top:0; left:0; right:0; background:white; border:1px solid #ccc; list-style:none; padding:0; margin:0; max-height:200px; overflow-y:auto; box-shadow:0 4px 6px -1px rgba(0,0,0,0.1);">
                        @if (!_customerSearchResults.Any())
                        {
                            <li style="padding:10px; color:var(--tf-text-muted);">Chưa có khách hàng</li>
                            <li style="padding:10px; border-top:1px solid #eee; text-align:center;">
                                <a href="/doi-tac/khach-hang/tao-moi" class="tf-btn tf-btn-sm tf-btn-outline-primary">+ Thêm khách hàng</a>
                            </li>
                        }
                        else
                        {
                            @foreach (var c in _customerSearchResults)
                            {
                                <li style="padding:10px; border-bottom:1px solid #eee; cursor:pointer;" @onclick="() => SelectCustomer(c)">
                                    <strong>@c.Name</strong> - @c.Phone - @c.Address
                                </li>
                            }
                        }
                    </ul>
                </div>
            }
        </div>
        
        <div style="display:grid; grid-template-columns: 1fr 1fr; gap:20px; margin-top: 16px;">
            <div class="tf-form-group">
                <label class="tf-form-label">Ngày tạo</label>
                <input type="date" class="tf-form-control" @bind="_orderRequest.OrderDate" />
            </div>
            <div class="tf-form-group">
                <label class="tf-form-label">Ngày giao hàng</label>
                <input type="date" class="tf-form-control" @bind="_orderRequest.DeliveryDate" />
            </div>
        </div>
        <div class="tf-form-group">
            <label class="tf-form-label">Ghi chú</label>
            <textarea class="tf-form-control" @bind="_orderRequest.Notes"></textarea>
        </div>
    </div>
</div>

<div class="tf-card tf-mb-4">
    <div style="padding: 20px;">
        <h3 style="margin: 0 0 16px 0; font-size: 16px;">SẢN PHẨM</h3>
        
        <div class="tf-form-group" style="margin-bottom:20px;">
              <label style="display:block; margin-bottom:8px; font-weight:600;">Bảng giá:</label>
              <select class="tf-form-control" @bind="_selectedPriceListId" @bind:after="OnPriceListChanged">
                  <option value="">-- Chọn bảng giá --</option>
                  @foreach(var pl in _availablePriceLists)
                  {
                      <option value="@pl.Id">@pl.Name</option>
                  }
              </select>
              @if (!_availablePriceLists.Any()) {
                  <small style="color:var(--tf-text-muted);">Chưa có bảng giá phù hợp</small>
              }
          </div>
          
          <div class="tf-form-group" style="margin-bottom:20px;">
              <input type="text" class="tf-form-control" placeholder="🔍 Tìm sản phẩm (Tên, Mã)..." @bind="_productSearch" @bind:event="oninput" @onkeyup="SearchProducts" />
            @if (_isProductSearched)
            {
                <div style="position:relative; z-index:90;">
                    <ul style="position:absolute; top:0; left:0; right:0; background:white; border:1px solid #ccc; list-style:none; padding:0; margin:0; max-height:200px; overflow-y:auto; box-shadow:0 4px 6px -1px rgba(0,0,0,0.1);">
                        @if (!_productSearchResults.Any())
                        {
                            <li style="padding:10px; color:var(--tf-text-muted);">Chưa có sản phẩm</li>
                            <li style="padding:10px; border-top:1px solid #eee; text-align:center;">
                                <a href="/danh-muc/san-pham/tao-moi" class="tf-btn tf-btn-sm tf-btn-outline-primary">+ Thêm sản phẩm</a>
                            </li>
                        }
                        else
                        {
                            @foreach (var p in _productSearchResults)
                            {
                                <li style="padding:10px; border-bottom:1px solid #eee; cursor:pointer;" @onclick="() => SelectProduct(p)">
                                    <strong>@p.Code</strong> - @p.Name (@p.Unit?.Name)
                                </li>
                            }
                        }
                    </ul>
                </div>
            }
        </div>

        <div class="tf-table-responsive">
            <table class="tf-table">
                <thead>
                    <tr>
                        <th>Mã</th>
                        <th>Sản phẩm</th>
                        <th>ĐVT</th>
                        <th style="width:75px;">SL</th>
                        <th style="width:105px;">Nguồn giá</th>
                        <th style="width:130px;">Giá trước VAT</th>
                        <th style="width:100px;">Chiết khấu</th>
                        <th style="width:120px;" class="tf-text-right">Giá sau CK</th>
                        <th style="width:115px;">Thuế suất</th>
                        <th style="width:95px;" class="tf-text-right">Tiền thuế</th>
                        <th style="width:130px;" class="tf-text-right">Thành tiền</th>
                        <th style="width:35px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _orderRequest.Items)
                    {
                        <tr>
                            <td>@item.ProductCode</td>
                            <td>@item.ProductName</td>
                            <td>@item.UnitName</td>
                            <td>
                                <input type="number" class="tf-form-control" style="padding:4px;" @bind="item.Quantity" @bind:after="() => OnQuantityChanged(item)" min="0.01" step="any" />
                            </td>
                            <td>
                                @if (item.PriceSource == "Thủ công" || item.UnitPrice == null) {
                                    <span class="tf-badge tf-badge-warning">Nhập thủ công</span>
                                } else {
                                    <span class="tf-badge tf-badge-info">@item.PriceSource</span>
                                }
                            </td>
                            <td>
                                @if (item.UnitPrice == null) {
                                    <div style="color:red; font-size:12px; margin-bottom:4px;">Chưa có giá</div>
                                }
                                <AuthorizeView Policy="Permission:SalesOrders:OverridePrice" Context="authContext">
                                    <Authorized>
                                        <input type="number" class="tf-form-control" style="padding:4px;" @bind="item.UnitPrice" @bind:after="() => OnManualPriceChanged(item)" min="0" step="any" />
                                    </Authorized>
                                    <NotAuthorized>
                                        @if (item.PriceSource == "Thủ công" || string.IsNullOrEmpty(item.PriceSource)) {
                                            <input type="number" class="tf-form-control" style="padding:4px;" @bind="item.UnitPrice" @bind:after="() => OnManualPriceChanged(item)" min="0" step="any" />
                                        } else {
                                            <input type="number" class="tf-form-control" style="padding:4px; background:#f1f5f9; cursor:not-allowed;" value="@item.UnitPrice" readonly />
                                        }
                                    </NotAuthorized>
                                </AuthorizeView>
                            </td>
                            <td>
                                <div style="display:flex; align-items:center; gap:2px;">
                                    <input type="number" class="tf-form-control" style="padding:4px; width:55px;" @bind="item.DiscountRate" @bind:after="() => OnDiscountRateChanged(item)" min="0" max="100" step="any" placeholder="%" />
                                    <span style="font-size:11px; color:#64748b;">%</span>
                                </div>
                                @if (item.DiscountAmount > 0)
                                {
                                    <div style="font-size:11px; color:#64748b; margin-top:2px;">-@item.DiscountAmount.ToString("N0")</div>
                                }
                            </td>
                            <td class="tf-text-right" style="font-weight:600; color:#059669; font-size:13px;">
                                @item.DiscountedUnitPrice.ToString("N0")
                            </td>
                            <td>
                                <select class="tf-form-control" style="padding:4px; font-size:13px;" @bind="item.TaxRate" @bind:after="CalculateTotals">
                                    <option value="10">10%</option>
                                    <option value="8">8%</option>
                                    <option value="5">5%</option>
                                    <option value="0">0%</option>
                                    <option value="-1">Không chịu thuế</option>
                                </select>
                            </td>
                            <td class="tf-text-right" style="font-size:13px; color:var(--tf-text-secondary);">
                                @item.TaxAmount.ToString("N0")
                            </td>
                            <td class="tf-text-right"><strong style="color:var(--tf-color-danger);">@item.LineTotal.ToString("N0")</strong></td>
                            <td>
                                <button class="tf-btn-icon" style="color:red;" @onclick="() => RemoveItem(item)">🗑</button>
                            </td>
                        </tr>
                    }
                    @if (!_orderRequest.Items.Any())
                    {
                        <tr>
                            <td colspan="12" class="tf-text-center" style="color:var(--tf-text-muted);">Chưa có sản phẩm nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        <div style="margin-top:24px; display:flex; justify-content:flex-end;">
            <div style="width:340px; background:#f8fafc; padding:20px; border-radius:8px; border:1px solid #e2e8f0;">
                <div style="display:flex; justify-content:space-between; margin-bottom:8px;">
                    <span style="color:var(--tf-text-muted);">Tiền hàng (Chưa VAT):</span>
                    <strong>@_orderRequest.SubTotal.ToString("N0") ₫</strong>
                </div>
                <div style="display:flex; justify-content:space-between; margin-bottom:8px;">
                    <span style="color:var(--tf-text-muted);">Chiết khấu:</span>
                    <strong>@_orderRequest.TotalDiscount.ToString("N0") ₫</strong>
                </div>
                <div style="display:flex; justify-content:space-between; margin-bottom:8px;">
                    <span style="color:var(--tf-text-muted);">Tiền thuế GTGT:</span>
                    <strong style="color:var(--tf-primary);">@_orderRequest.TotalTax.ToString("N0") ₫</strong>
                </div>
                <div style="display:flex; justify-content:space-between; margin-top:16px; padding-top:16px; border-top:1px dashed #cbd5e1; font-size:18px;">
                    <span>Khách cần trả:</span>
                    <strong style="color:var(--tf-color-danger);">@_orderRequest.GrandTotal.ToString("N0") ₫</strong>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="tf-form-actions" style="margin-bottom: 40px; display:flex; gap:12px;">
    <button type="button" class="tf-btn tf-btn-secondary" @onclick='() => Nav.NavigateTo("/ban-hang/don-ban-hang")'>Hủy</button>
    <button type="button" class="tf-btn tf-btn-primary" @onclick="SaveDraft" disabled="@_isSaving">
        @if (_isSaving) { <span>Đang lưu...</span> } else { <span>Lưu nháp</span> }
    </button>
</div>

@code {
    private SalesOrderDto _orderRequest = new() { OrderDate = DateTime.UtcNow };
    private Customer? _selectedCustomer;
    private string _customerSearch = "";
    private string _productSearch = "";
    private List<Customer> _customerSearchResults = new();
    private List<Product> _productSearchResults = new();
    private bool _isCustomerSearched = false;
    private bool _isProductSearched = false;
    private int? _selectedPriceListId;
    private List<TradeFlow.Domain.Entities.Pricing.PriceList> _availablePriceLists = new();

    protected override async Task OnInitializedAsync()
    {
        _availablePriceLists = await SalesService.GetApplicablePriceListsAsync(_orderRequest.OrderDate);
        if (_selectedPriceListId == null && _availablePriceLists.Any())
        {
            _selectedPriceListId = _availablePriceLists.First().Id;
        }
    }

    private async Task OnPriceListChanged()
    {
        foreach (var item in _orderRequest.Items)
        {
            var res = await SalesService.GetProductPriceAsync(item.ProductId, _selectedPriceListId, _orderRequest.OrderDate);
            item.UnitPrice = res.Price;
            item.PriceSource = res.SourceName;
            if (item.DiscountRate > 0)
            {
                var baseAmount = item.Quantity * (item.UnitPrice ?? 0);
                item.DiscountAmount = Math.Round(baseAmount * (item.DiscountRate / 100m), 0);
            }
        }
        CalculateTotals();
    }

    private void OnDiscountRateChanged(SalesOrderItemDto item)
    {
        var baseAmount = item.Quantity * (item.UnitPrice ?? 0);
        item.DiscountAmount = Math.Round(baseAmount * (item.DiscountRate / 100m), 0);
        CalculateTotals();
    }

    private void OnQuantityChanged(SalesOrderItemDto item)
    {
        if (item.DiscountRate > 0)
        {
            var baseAmount = item.Quantity * (item.UnitPrice ?? 0);
            item.DiscountAmount = Math.Round(baseAmount * (item.DiscountRate / 100m), 0);
        }
        CalculateTotals();
    }
    
    private void OnManualPriceChanged(SalesOrderItemDto item)
    {
        item.PriceSource = "Thủ công";
        if (item.DiscountRate > 0)
        {
            var baseAmount = item.Quantity * (item.UnitPrice ?? 0);
            item.DiscountAmount = Math.Round(baseAmount * (item.DiscountRate / 100m), 0);
        }
        CalculateTotals();
    }
    
    private string? _errorMessage;
    private bool _isSaving = false;

    private CancellationTokenSource? _customerSearchCts;
    private async Task SearchCustomers(KeyboardEventArgs e)
    {
        _customerSearchCts?.Cancel();
        _customerSearchCts = new CancellationTokenSource();
        var token = _customerSearchCts.Token;

        _isCustomerSearched = true;
        if (_customerSearch.Length >= 2)
        {
            try
            {
                await Task.Delay(300, token);
                if (!token.IsCancellationRequested)
                {
                    _customerSearchResults = await SalesService.SearchCustomersAsync(_customerSearch, token);
                    StateHasChanged();
                }
            }
            catch (TaskCanceledException) { }
            catch (Exception ex)
            {
                _errorMessage = "Lỗi khi tìm khách hàng: " + ex.Message;
                StateHasChanged();
            }
        }
        else
        {
            _customerSearchResults.Clear();
            _isCustomerSearched = false;
        }
    }

    private void SelectCustomer(Customer c)
    {
        _selectedCustomer = c;
        _orderRequest.CustomerId = c.Id;
        _orderRequest.CustomerName = c.Name;
        _orderRequest.CustomerTaxCode = c.TaxCode;
        _orderRequest.CustomerAddress = c.Address;
        _orderRequest.CustomerPhone = c.Phone;
        _customerSearch = "";
        _customerSearchResults.Clear();
        _isCustomerSearched = false;
    }

    private void ClearCustomer()
    {
        _selectedCustomer = null;
        _orderRequest.CustomerId = 0;
        _isCustomerSearched = false;
    }

    private CancellationTokenSource? _productSearchCts;
    private async Task SearchProducts(KeyboardEventArgs e)
    {
        _productSearchCts?.Cancel();
        _productSearchCts = new CancellationTokenSource();
        var token = _productSearchCts.Token;

        _isProductSearched = true;
        if (_productSearch.Length >= 2)
        {
            try
            {
                await Task.Delay(300, token);
                if (!token.IsCancellationRequested)
                {
                    _productSearchResults = await SalesService.SearchProductsAsync(_productSearch, token);
                    StateHasChanged();
                }
            }
            catch (TaskCanceledException) { }
            catch (Exception ex)
            {
                _errorMessage = "Lỗi khi tìm sản phẩm: " + ex.Message;
                StateHasChanged();
            }
        }
        else
        {
            _productSearchResults.Clear();
            _isProductSearched = false;
        }
    }

    private async Task SelectProduct(Product p)
    {
        _productSearch = "";
        _productSearchResults.Clear();
        _isProductSearched = false;
        
        // Find if already exists
        var existing = _orderRequest.Items.FirstOrDefault(x => x.ProductId == p.Id);
        if (existing != null)
        {
            existing.Quantity += 1;
        }
        else
        {
            var res = await SalesService.GetProductPriceAsync(p.Id, _selectedPriceListId, _orderRequest.OrderDate);
            var vatRes = VatRuleEngine.DetermineVatRate(p, _orderRequest.OrderDate);
            decimal initialTaxRate = vatRes.IsNonTaxable ? -1 : vatRes.Rate;
            
            _orderRequest.Items.Add(new SalesOrderItemDto
            {
                ProductId = p.Id,
                ProductCode = p.Code,
                ProductName = p.Name,
                UnitName = p.Unit?.Name ?? string.Empty,
                Quantity = 1,
                UnitPrice = res.Price,
                PriceSource = res.SourceName,
                DiscountRate = 0,
                DiscountAmount = 0,
                TaxRate = initialTaxRate,
                TaxAmount = 0,
            });
        }
        
        CalculateTotals();
    }

    private void RemoveItem(SalesOrderItemDto item)
    {
        _orderRequest.Items.Remove(item);
        CalculateTotals();
    }

    private void CalculateTotals()
    {
        foreach (var item in _orderRequest.Items)
        {
            var effectiveTaxRate = item.TaxRate > 0 ? item.TaxRate : 0m;
            var baseAmount = item.Quantity * (item.UnitPrice ?? 0);
            if (item.DiscountRate > 0 && item.DiscountAmount == 0)
            {
                item.DiscountAmount = Math.Round(baseAmount * (item.DiscountRate / 100m), 0);
            }
            var taxableAmount = Math.Max(0, baseAmount - item.DiscountAmount);
            item.TaxAmount = Math.Round(taxableAmount * (effectiveTaxRate / 100m), 0);
            item.LineTotal = taxableAmount + item.TaxAmount;
        }
        
        _orderRequest.SubTotal = _orderRequest.Items.Sum(x => x.Quantity * (x.UnitPrice ?? 0));
        _orderRequest.TotalDiscount = _orderRequest.Items.Sum(x => x.DiscountAmount);
        _orderRequest.TotalTax = _orderRequest.Items.Sum(x => x.TaxAmount);
        _orderRequest.GrandTotal = _orderRequest.SubTotal - _orderRequest.TotalDiscount + _orderRequest.TotalTax;
    }

    private async Task SaveDraft()
    {
        _errorMessage = null;
        if (_orderRequest.CustomerId <= 0)
        {
            _errorMessage = "Vui lòng chọn khách hàng.";
            return;
        }
        if (!_orderRequest.Items.Any())
        {
            _errorMessage = "Vui lòng thêm ít nhất một sản phẩm.";
            return;
        }

        _isSaving = true;
        try
        {
            var saved = await SalesService.CreateOrderAsync(_orderRequest);
            Nav.NavigateTo($"/ban-hang/don-ban-hang/chi-tiet/{saved.Id}");
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }
}
