@page "/ban-hang/don-ban-hang"
@using Microsoft.AspNetCore.Authorization
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Application.Common.Models.Sales
@using TradeFlow.Domain.Enums
@inject ISalesService SalesService
@inject NavigationManager Nav
@inject IAuthorizationService AuthService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject IAuditService AuditService
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Permission:SalesOrders:View")]

<PageTitle>Danh sách đơn bán hàng | TradeFlow</PageTitle>

<div class="tf-page-header">
    <div class="tf-page-header-content">
        <h1 class="tf-page-title">Đơn bán hàng</h1>
        <p class="tf-page-subtitle">Quản lý và theo dõi các đơn hàng bán cho khách hàng.</p>
    </div>
    <div class="tf-page-header-actions">
        <AuthorizeView Policy="Permission:SalesOrders:Create">
            <a href="/ban-hang/don-ban-hang/tao-moi" class="tf-btn tf-btn-primary">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:8px;"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                Tạo đơn hàng mới
            </a>
        </AuthorizeView>
    </div>
</div>

@if (_isLoading && _orders.Count == 0)
{
    <div class="tf-card">
        <div style="padding: 16px;">
            <Skeleton Type="table" Rows="6" Columns="6" />
        </div>
    </div>
}
else if (!_orders.Any())
{
    <div class="tf-empty-state">
        <div class="tf-empty-icon">📦</div>
        <h3>Chưa có đơn bán hàng nào</h3>
        <p>Bắt đầu bằng cách tạo đơn bán hàng mới cho khách hàng của bạn.</p>
    </div>
}
else
{
    <div class="tf-card">
        <TableLoadingOverlay IsLoading="@_isLoading" LoadingText="Đang tải danh sách đơn hàng...">
            <div class="tf-table-responsive">
                <table class="tf-table">
                <thead>
                    <tr>
                        <th>Mã đơn</th>
                        <th>Ngày tạo</th>
                        <th>Khách hàng</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in PagedOrders)
                    {
                        <tr>
                            <td>
                                <span class="tw-font-mono tw-font-semibold tw-text-indigo-700 tw-bg-indigo-50/70 tw-px-2 tw-py-0.5 tw-rounded tw-text-xs">@order.Code</span>
                            </td>
                            <td class="tw-text-slate-600">@order.OrderDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                <div class="tw-font-medium tw-text-slate-900">@order.CustomerName</div>
                                @if (!string.IsNullOrEmpty(order.CustomerPhone))
                                {
                                    <div class="tw-text-xs tw-text-slate-500">@order.CustomerPhone</div>
                                }
                            </td>
                            <td><strong class="tw-text-rose-600 tw-font-semibold">@order.GrandTotal.ToString("N0") đ</strong></td>
                            <td>
                                @if (order.Status == SalesOrderStatus.Draft)
                                {
                                    <TfBadge Variant="gray" Dot="true" Text="Nháp" />
                                }
                                else if (order.Status == SalesOrderStatus.Confirmed)
                                {
                                    <TfBadge Variant="primary" Dot="true" Text="Đã xác nhận" />
                                }
                                else if (order.Status == SalesOrderStatus.Invoiced)
                                {
                                    <TfBadge Variant="success" Dot="true" Text="Đã lên hóa đơn" />
                                }
                                else
                                {
                                    <TfBadge Variant="danger" Dot="true" Text="Đã hủy" />
                                }
                            </td>
                            <td class="tf-text-right">
                                <div class="tw-inline-flex tw-gap-1">
                                    <a href="/ban-hang/don-ban-hang/chi-tiet/@order.Id" class="tf-btn tf-btn-ghost tf-btn-sm">Chi tiết</a>
                                    <AuthorizeView Policy="Permission:SalesOrders:Delete">
                                        <button type="button" class="tf-btn tf-btn-ghost tf-btn-sm tw-text-red-600 hover:tw-bg-red-50" @onclick="() => ConfirmDelete(order.Id, order.Code)">Xóa</button>
                                    </AuthorizeView>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (_orders.Any())
        {
            <TfPagination CurrentPage="@_currentPage"
                          PageSize="@_pageSize"
                          TotalCount="@_orders.Count"
                          ItemName="đơn hàng"
                          CurrentPageChanged="@(p => _currentPage = p)"
                          PageSizeChanged="@(s => { _pageSize = s; _currentPage = 1; })" />
        }
        </TableLoadingOverlay>
    </div>
}

<TfModal IsOpen="@(_itemToDeleteId != null)"
         Title="Xóa đơn bán hàng?"
         Size="sm"
         OnClose="CancelDelete">
    <BodyContent>
        <p class="tw-text-slate-600 tw-mb-4">Bạn có chắc chắn muốn xóa "<strong>@(_itemToDeleteName)</strong>"?</p>
        @if (!string.IsNullOrEmpty(_deleteError))
        {
            <div class="tf-alert tf-alert-error tw-mb-3">
                @_deleteError
            </div>
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="tf-btn tf-btn-secondary" @onclick="CancelDelete">Hủy</button>
        <LoadingButton Class="tf-btn tf-btn-danger"
                       IsLoading="@_isDeleting"
                       LoadingText="Đang xóa..."
                       OnClick="ExecuteDelete">
            Xóa
        </LoadingButton>
    </FooterContent>
</TfModal>

@code {
    private int? _itemToDeleteId;
    private string _itemToDeleteName = "";
    private string? _deleteError;
    private bool _isDeleting = false;

    private List<SalesOrderDto> _orders = new();
    private bool _isLoading = true;
    private int _currentPage = 1;
    private int _pageSize = 20;

    private IEnumerable<SalesOrderDto> PagedOrders =>
        _orders.Skip((_currentPage - 1) * _pageSize).Take(_pageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            _isLoading = true;
            _orders = await SalesService.GetOrdersAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ConfirmDelete(int id, string name)
    {
        _itemToDeleteId = id;
        _itemToDeleteName = name;
        _deleteError = null;
    }

    private void CancelDelete()
    {
        _itemToDeleteId = null;
        _deleteError = null;
    }

    private async Task ExecuteDelete()
    {
        if (_itemToDeleteId == null) return;
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!(await AuthService.AuthorizeAsync(authState.User, "Permission:SalesOrders:Delete")).Succeeded)
        {
            _deleteError = "Bạn không có quyền.";
            return;
        }

        try
        {
            _isDeleting = true;
            int id = _itemToDeleteId.Value;
            await SalesService.DeleteOrderAsync(id);
            CancelDelete();
            await OnInitializedAsync();
        }
        catch (Exception ex)
        {
            _deleteError = "Đã xảy ra lỗi: " + ex.Message;
        }
        finally
        {
            _isDeleting = false;
        }
    }
}