    private async Task LoadInitialDataAsync()
    {
        // 0. Company Settings (for QR Code & Bank configuration)
        _companySettings = await DbContext.CompanySettings.AsNoTracking().FirstOrDefaultAsync();

        // 1. Applicable Price lists
        _priceLists = await SalesService.GetApplicablePriceListsAsync(DateTime.UtcNow);
        if (_priceLists.Any())
        {
            var defaultPlId = _priceLists.First().Id;
            foreach (var tab in _tabs)
            {
                if (!tab.PriceListId.HasValue)
                {
                    tab.PriceListId = defaultPlId;
                }
            }
        }

        // 2. Product Categories
        _categories = await DbContext.ProductCategories
            .AsNoTracking()
            .Where(c => c.IsActive)
            .OrderBy(c => c.DisplayOrder)
            .ThenBy(c => c.Name)
            .ToListAsync();

        // 3. Load catalog products
        await LoadCatalogPageAsync();

        // 4. Load recent orders
        var allOrders = await SalesService.GetOrdersAsync();
        _recentOrders = allOrders.Take(15).ToList();
    }

    private async Task RefreshDataAsync()
