    // ============================================================
    // TOTALS CALCULATIONS & CONFIGURABLE VAT
    // ============================================================
    private decimal CalculateSubTotal()
    {
        return ActiveTab.Items.Sum(i => i.Quantity * i.UnitPrice);
    }

    private decimal CalculateTotalDiscount()
    {
        decimal itemDiscounts = ActiveTab.Items.Sum(i => i.Discount);
        return itemDiscounts + ActiveTab.Discount;
    }

    private decimal CalculateTaxableBase()
    {
        decimal sub = CalculateSubTotal();
        decimal disc = CalculateTotalDiscount();
        return Math.Max(0, sub - disc);
    }

    private decimal GetItemEffectiveVatRate(PosItem item)
    {
        if (!ActiveTab.ApplyVat) return 0m;
        if (ActiveTab.VatRateSelection == "auto") return item.TaxRate;
        if (decimal.TryParse(ActiveTab.VatRateSelection, out var r)) return r;
        return 0m;
    }

    private decimal CalculateTaxTotal()
    {
        if (!ActiveTab.ApplyVat) return 0m;
        if (ActiveTab.VatRateSelection == "auto")
        {
            decimal totalTax = 0m;
            decimal totalItemBase = ActiveTab.Items.Sum(i => Math.Max(0, (i.Quantity * i.UnitPrice) - i.Discount));
            if (totalItemBase <= 0) return 0m;

            decimal orderDiscount = ActiveTab.Discount;
            foreach (var i in ActiveTab.Items)
            {
                decimal itemBase = Math.Max(0, (i.Quantity * i.UnitPrice) - i.Discount);
                decimal itemShareOfDiscount = totalItemBase > 0 ? (itemBase / totalItemBase) * orderDiscount : 0m;
                decimal taxableLine = Math.Max(0, itemBase - itemShareOfDiscount);
                totalTax += taxableLine * (i.TaxRate / 100m);
            }
            return Math.Round(totalTax, 0, MidpointRounding.AwayFromZero);
        }
        else
        {
            if (decimal.TryParse(ActiveTab.VatRateSelection, out var rate))
            {
                return Math.Round(CalculateTaxableBase() * (rate / 100m), 0, MidpointRounding.AwayFromZero);
            }
            return 0m;
        }
    }

    private decimal CalculateGrandTotal()
    {
        decimal taxableBase = CalculateTaxableBase();
        decimal tax = CalculateTaxTotal();
        return Math.Max(0, taxableBase + tax);
    }

    private string GetVatRateDescription()
    {
        if (!ActiveTab.ApplyVat) return "0% (Miễn/Không áp dụng)";
        if (ActiveTab.VatRateSelection == "auto") return "Theo SP (Tự động)";
        return $"{ActiveTab.VatRateSelection}%";
    }

