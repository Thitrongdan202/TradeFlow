                    var priceResult = await SalesService.GetProductPriceAsync(prod.Id, ActiveTab.PriceListId, ActiveTab.OrderDate);
                    _productPrices[prod.Id] = priceResult.Price;
                }
            }
        }
        finally
        {
            _searchLock.Release();
        }
    }

