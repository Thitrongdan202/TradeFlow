    // ============================================================
    // CATALOG & PRICING LOGIC
    // ============================================================
    private async Task LoadCatalogPageAsync()
    {
        var query = DbContext.Products
            .Include(p => p.Unit)
            .Include(p => p.Images)
            .AsNoTracking()
            .Where(p => p.IsActive);

        // Category filter (multi-select modal)
        if (_selectedCategoryIds.Any())
        {
            query = query.Where(p => p.CategoryId.HasValue && _selectedCategoryIds.Contains(p.CategoryId.Value));
        }

        // Text search
        if (!string.IsNullOrWhiteSpace(_catalogSearch))
        {
            var term = $"%{_catalogSearch}%";
            query = query.Where(p => EF.Functions.ILike(p.Name, term) 
                                  || EF.Functions.ILike(p.Code, term) 
                                  || (p.NewCode != null && EF.Functions.ILike(p.NewCode, term)));
        }

        // Attribute filter (SỨ, INOX, HÀNG XI, NHỰA, KÍNH, NHÔM)
        if (_selectedAttributes.Any())
        {
            query = ApplyAttributeFilters(query, _selectedAttributes);
        }

        _catalogTotalCount = await query.CountAsync();
        _catalogProducts = await query
            .OrderBy(p => p.Name)
            .Skip((_catalogPage - 1) * _catalogPageSize)
            .Take(_catalogPageSize)
            .ToListAsync();

        // Cache prices for catalog products
        foreach (var p in _catalogProducts)
        {
            if (!_productPrices.ContainsKey(p.Id))
            {
                var priceResult = await SalesService.GetProductPriceAsync(p.Id, ActiveTab.PriceListId, ActiveTab.OrderDate);
                _productPrices[p.Id] = priceResult.Price;
            }

            if (!_productImages.ContainsKey(p.Id))
            {
                var primaryImg = p.Images.FirstOrDefault(i => i.IsPrimary) ?? p.Images.FirstOrDefault();
                _productImages[p.Id] = primaryImg != null ? FileStorage.GetPublicUrl(primaryImg.StorageReference) : null;
            }
        }
    }

    private decimal? GetProductPrice(int productId)
    {
        if (_productPrices.TryGetValue(productId, out var p))
        {
            return p;
        }
        return null;
    }

    private string? GetProductImageUrl(Product prod)
    {
        if (_productImages.TryGetValue(prod.Id, out var url))
        {
            return url;
        }
        var primaryImg = prod.Images?.FirstOrDefault(i => i.IsPrimary) ?? prod.Images?.FirstOrDefault();
        var publicUrl = primaryImg != null ? FileStorage.GetPublicUrl(primaryImg.StorageReference) : null;
        _productImages[prod.Id] = publicUrl;
        return publicUrl;
    }

