                <button type="button" class="tf-btn-clear-filter" @onclick="ClearAllAttributeSelections">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="3 6 5 6 21 6"></polyline>
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                    </svg>
                    <span>Xóa chọn tất cả</span>
                </button>
                <div class="tf-filter-footer-actions">
                    <button type="button" class="tf-btn-secondary" @onclick="() => _showAttributeFilterModal = false">Bỏ qua</button>
                    <button type="button" class="tf-btn-primary" @onclick="ApplyAttributeFilterAsync">Xong</button>
                </div>
            </div>
        </div>
    </div>
}

@* ============================================================
   LINE-ITEM NOTE MODAL (Ghi chú độc lập từng dòng hàng)
   ============================================================ *@
@if (_showItemNoteModal && _editingNoteItem != null)
{
    <div class="tf-modal-backdrop" @onclick="CancelItemNoteEditor">
        <div class="tf-modal-dialog tf-note-dialog" @onclick:stopPropagation="true">
            <div class="tf-modal-header">
                <div class="tf-note-dialog-title-group">
                    <h3 class="tf-modal-title">Ghi chú dòng sản phẩm</h3>
                    <span class="tf-note-dialog-item-name">@_editingNoteItem.Code — @_editingNoteItem.Name</span>
                </div>
                <button type="button" class="tf-modal-close-btn" @onclick="CancelItemNoteEditor">✕</button>
            </div>
            <div class="tf-modal-body">
                <div class="tf-form-group">
                    <label class="tf-label">Yêu cầu đặc biệt cho sản phẩm này</label>
                    <textarea class="tf-textarea"
                              placeholder="Nhập yêu cầu đặc biệt của khách hàng (quy cách cắt, kiểm tra nước men, đổi phụ kiện, lưu ý bảo quản...)..."
                              @bind="_editingNoteText"
                              @bind:event="oninput"></textarea>
                    <div class="tf-help-text">Ghi chú này thuộc về riêng dòng sản phẩm này, không ảnh hưởng đến các sản phẩm khác hoặc ghi chú chung của đơn hàng.</div>
                </div>
            </div>
            <div class="tf-modal-footer">
                @if (!string.IsNullOrWhiteSpace(_editingNoteItem.Note))
                {
                    <button type="button" class="tf-btn tf-btn-danger-outline" @onclick="() => { ClearItemNote(_editingNoteItem); SaveItemNote(); }">
                        Xóa ghi chú
                    </button>
                }
                <div style="flex: 1;"></div>
                <button type="button" class="tf-btn tf-btn-secondary" @onclick="CancelItemNoteEditor">Bỏ qua</button>
                <button type="button" class="tf-btn tf-btn-primary" @onclick="SaveItemNote">Lưu ghi chú</button>
            </div>
        </div>
    </div>
}

@* ============================================================
   PRODUCT DETAIL MODAL (Xem chi tiết thông số hàng hóa)
   ============================================================ *@
@if (_showProductDetailModal && _viewingProductDetail != null)
{
    <div class="tf-modal-backdrop" @onclick="() => _showProductDetailModal = false">
        <div class="tf-modal-dialog tf-product-detail-dialog" @onclick:stopPropagation="true">
            <div class="tf-modal-header">
                <div class="tf-product-detail-header-text">
                    <h3 class="tf-modal-title">Chi tiết sản phẩm</h3>
                    <span class="tf-product-detail-sub">@(_viewingProductDetail.NewCode ?? _viewingProductDetail.Code) — @_viewingProductDetail.Name</span>
                </div>
                <button type="button" class="tf-modal-close-btn" @onclick="() => _showProductDetailModal = false">✕</button>
            </div>
            <div class="tf-modal-body tf-detail-modal-body">
                <div class="tf-detail-info-grid">
                    <div class="tf-detail-field">
                        <span class="tf-detail-label">Mã sản phẩm:</span>
                        <span class="tf-detail-value font-bold">@(_viewingProductDetail.NewCode ?? _viewingProductDetail.Code)</span>
                    </div>
                    @if (!string.IsNullOrEmpty(_viewingProductDetail.LegacyCode))
                    {
                        <div class="tf-detail-field">
