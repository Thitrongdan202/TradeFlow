                        </div>
                    }
                </div>
            </div>
            <div class="tf-modal-footer">
                <button type="button" class="tf-btn tf-btn-primary" @onclick="() => _showProductDetailModal = false">Đóng</button>
            </div>
        </div>
    </div>
}

