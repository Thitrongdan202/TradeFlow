        if (existing != null)
        {
            existing.Quantity += 1;
        }
        else
        {
            var unitPrice = GetProductPrice(product.Id);
            var vatRate = VatRuleEngine.DetermineVatRate(product, ActiveTab.OrderDate);

            ActiveTab.Items.Add(new PosItem
            {
                ProductId = product.Id,
                Code = product.NewCode ?? product.Code,
                Name = product.Name,
                UnitName = product.Unit?.Name ?? "Cái",
                Quantity = 1,
                UnitPrice = unitPrice ?? 0m,
                HasPrice = unitPrice.HasValue && unitPrice.Value > 0,
                Discount = 0,
                TaxRate = vatRate.Rate,
                MaterialTag = GetMaterialTag(product.Name, product.Specifications, product.Description)
