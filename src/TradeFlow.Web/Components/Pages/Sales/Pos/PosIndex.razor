    private async Task SaveNewCustomerAsync()
    {
        _addCustError = null;

        if (_newCustType == CustomerTypeChoice.Retail)
        {
            if (string.IsNullOrWhiteSpace(_newCustPhone))
            {
                _addCustError = "Vui lòng nhập số điện thoại khách hàng.";
                return;
            }

            string phone = _newCustPhone.Trim();

            // Check deduplication by phone
            var existing = await DbContext.Customers.FirstOrDefaultAsync(c => c.Phone == phone);
            if (existing != null)
            {
                SelectCustomer(existing);
                _showAddCustomerModal = false;
                ResetAddCustomerForm();
                return;
            }

            string finalName = !string.IsNullOrWhiteSpace(_newCustName) 
                ? _newCustName.Trim() 
                : $"Khách lẻ ({phone})";

            var cust = new Customer
            {
                Code = $"KL{DateTime.Now:yyMMddHHmm}",
                Name = finalName,
                Phone = phone,
                Address = _newCustAddress?.Trim(),
                IsActive = true
            };

            DbContext.Customers.Add(cust);
            await DbContext.SaveChangesAsync();

            SelectCustomer(cust);
            _showAddCustomerModal = false;
            ResetAddCustomerForm();
        }
        else
        {
            if (string.IsNullOrWhiteSpace(_newCustCompanyName))
            {
                _addCustError = "Vui lòng nhập tên công ty / doanh nghiệp.";
                return;
            }

            if (string.IsNullOrWhiteSpace(_newCustTaxCode))
            {
                _addCustError = "Vui lòng nhập mã số thuế (MST) của doanh nghiệp.";
                return;
            }

            string compName = _newCustCompanyName.Trim();
            string taxCode = _newCustTaxCode.Trim();

            // Check deduplication by tax code
            var existingByTax = await DbContext.Customers.FirstOrDefaultAsync(c => c.TaxCode == taxCode);
            if (existingByTax != null)
            {
                SelectCustomer(existingByTax);
                _showAddCustomerModal = false;
                ResetAddCustomerForm();
                return;
            }

            var cust = new Customer
            {
                Code = $"DN{DateTime.Now:yyMMddHHmm}",
                Name = compName,
                CompanyName = compName,
                TaxCode = taxCode,
                ContactPerson = _newCustContactPerson?.Trim(),
                Phone = _newCustPhone?.Trim(),
                Email = _newCustEmail?.Trim(),
                Address = _newCustAddress?.Trim(),
                IsActive = true
            };

            DbContext.Customers.Add(cust);
            await DbContext.SaveChangesAsync();

            SelectCustomer(cust);
            _showAddCustomerModal = false;
            ResetAddCustomerForm();
        }
    }

