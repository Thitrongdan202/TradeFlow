    private static string GetMaterialTag(string productName, string? specs = null, string? desc = null)
    {
        var text = $"{productName} {specs} {desc}".ToLowerInvariant();
        if (text.Contains("bồn cầu") || text.Contains("bàn cầu") || text.Contains("lavabo") || text.Contains("chậu") || text.Contains("tiểu nam") || text.Contains("sứ"))
            return "sứ";
        if (text.Contains("inox") || text.Contains("sus 304") || text.Contains("sus 201"))
            return "inox";
        if (text.Contains("xi") || text.Contains("mạ") || text.Contains("củ sen") || text.Contains("cây sen") || text.Contains("vòi"))
            return "hàng xi";
        if (text.Contains("nhựa") || text.Contains("bộ xả") || text.Contains("dây cấp") || text.Contains("nắp bàn cầu") || text.Contains("phao"))
            return "nhựa";
        if (text.Contains("kính") || text.Contains("gương"))
            return "kính";
        if (text.Contains("nhôm"))
            return "nhôm";
        return "";
    }

    private static IQueryable<Product> ApplyAttributeFilters(IQueryable<Product> query, HashSet<string> attrs)
    {
        return query.Where(p =>
            (attrs.Contains("SỨ") && (
                EF.Functions.ILike(p.Name, "%bồn cầu%") ||
                EF.Functions.ILike(p.Name, "%bàn cầu%") ||
                EF.Functions.ILike(p.Name, "%lavabo%") ||
                EF.Functions.ILike(p.Name, "%chậu%") ||
                EF.Functions.ILike(p.Name, "%tiểu nam%") ||
                EF.Functions.ILike(p.Name, "%sứ%") ||
                (p.Specifications != null && EF.Functions.ILike(p.Specifications, "%sứ%"))
            )) ||
            (attrs.Contains("INOX") && (
                EF.Functions.ILike(p.Name, "%inox%") ||
                EF.Functions.ILike(p.Name, "%sus 304%") ||
                EF.Functions.ILike(p.Name, "%sus 201%") ||
                (p.Specifications != null && EF.Functions.ILike(p.Specifications, "%inox%"))
            )) ||
            (attrs.Contains("HÀNG XI") && (
                EF.Functions.ILike(p.Name, "%xi%") ||
                EF.Functions.ILike(p.Name, "%mạ%") ||
                EF.Functions.ILike(p.Name, "%củ sen%") ||
                EF.Functions.ILike(p.Name, "%cây sen%") ||
                EF.Functions.ILike(p.Name, "%vòi%")
            )) ||
            (attrs.Contains("NHỰA") && (
                EF.Functions.ILike(p.Name, "%nhựa%") ||
                EF.Functions.ILike(p.Name, "%bộ xả%") ||
                EF.Functions.ILike(p.Name, "%dây cấp%") ||
                EF.Functions.ILike(p.Name, "%nắp bàn cầu%") ||
                EF.Functions.ILike(p.Name, "%phao%")
            )) ||
            (attrs.Contains("KÍNH") && (
                EF.Functions.ILike(p.Name, "%kính%") ||
                EF.Functions.ILike(p.Name, "%gương%")
            )) ||
            (attrs.Contains("NHÔM") && (
                EF.Functions.ILike(p.Name, "%nhôm%")
            ))
        );
    }

    // ============================================================
    // CART OPERATIONS
    // ============================================================
    private void UpdateQuantity(PosItem item, decimal newQty)
    {
        if (newQty <= 0)
        {
            ActiveTab.Items.Remove(item);
        }
        else
        {
            item.Quantity = newQty;
        }
        StateHasChanged();
    }

    private void OnQuantityChanged(PosItem item, ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out var qty))
        {
            UpdateQuantity(item, qty);
        }
    }

    private void OnItemDiscountChanged(PosItem item, ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out var disc))
        {
            item.Discount = Math.Max(0, disc);
            StateHasChanged();
        }
    }

    private void OnItemUnitPriceChanged(PosItem item, ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out var price) && price > 0)
        {
            item.UnitPrice = price;
            item.HasPrice = true;
            _checkoutErrorMessage = null;
            StateHasChanged();
        }
    }

    private void RemoveItem(int index)
    {
        if (index >= 0 && index < ActiveTab.Items.Count)
        {
            ActiveTab.Items.RemoveAt(index);
            StateHasChanged();
        }
    }

    // ============================================================
    // TABS MANAGEMENT
    // ============================================================
    private void AddNewTab()
    {
        if (_tabs.Count >= 10) return;
        int nextNum = _tabs.Count + 1;
        var newTab = new PosTab
        {
            Title = $"Hóa đơn {nextNum}",
            OrderDate = DateTime.Now,
            PriceListId = _priceLists.FirstOrDefault()?.Id
        };
        _tabs.Add(newTab);
        _activeTabIndex = _tabs.Count - 1;
        StateHasChanged();
    }

    private void SwitchTab(int index)
    {
        if (index >= 0 && index < _tabs.Count)
        {
            _activeTabIndex = index;
            _checkoutErrorMessage = null;
            StateHasChanged();
        }
    }

    private void CloseTab(int index)
    {
        if (_tabs.Count <= 1) return;
        _tabs.RemoveAt(index);
        if (_activeTabIndex >= _tabs.Count)
        {
            _activeTabIndex = _tabs.Count - 1;
        }
        _checkoutErrorMessage = null;
        StateHasChanged();
    }

    // ============================================================
    // CUSTOMER SELECTION (F4)
    // ============================================================
    private async Task OnCustomerSearchInput(ChangeEventArgs e)
    {
        _custSearchTerm = e.Value?.ToString() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(_custSearchTerm))
        {
            _custResults.Clear();
            _showCustDropdown = false;
            return;
        }

        await _searchLock.WaitAsync();
        try
        {
            _custResults = await SalesService.SearchCustomersAsync(_custSearchTerm);
            _showCustDropdown = _custResults.Any();
        }
        finally
        {
            _searchLock.Release();
        }
    }

