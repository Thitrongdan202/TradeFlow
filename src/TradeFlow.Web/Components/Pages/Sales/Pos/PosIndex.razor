@* ============================================================
   GROUP FILTER MODAL (Lọc theo nhóm hàng — Matching media_1791897987311_db5ad73e.png)
   ============================================================ *@
@if (_showGroupFilterModal)
{
    <div class="tf-modal-backdrop" @onclick="() => _showGroupFilterModal = false">
        <div class="tf-modal-dialog tf-filter-dialog" @onclick:stopPropagation="true">
            <div class="tf-modal-header">
                <h3 class="tf-modal-title">Lọc theo nhóm hàng</h3>
                <button type="button" class="tf-modal-close-btn" @onclick="() => _showGroupFilterModal = false">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>
            <div class="tf-modal-body tf-filter-modal-body">
                <div class="tf-filter-search-row">
                    <span class="tf-filter-search-label">Nhóm hàng</span>
                    <div class="tf-filter-search-input-wrap">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                        <input type="text"
                               class="tf-filter-search-input"
                               placeholder="Tìm nhóm hàng..."
                               value="@_groupFilterTerm"
                               @oninput="OnGroupFilterTermInput" />
                    </div>
                </div>

                <div class="tf-filter-items-list">
                    <label class="tf-filter-checkbox-item">
                        <input type="checkbox"
                               checked="@_allCategoriesSelected"
                               @onchange="ToggleSelectAllCategories" />
                        <span class="tf-filter-item-text font-bold">Tất cả</span>
                    </label>

                    @foreach (var cat in FilteredGroupCategories)
                    {
                        bool isChecked = _selectedCategoryIds.Contains(cat.Id);
                        <label class="tf-filter-checkbox-item">
                            <input type="checkbox"
                                   checked="@isChecked"
                                   @onchange="() => ToggleCategorySelection(cat.Id)" />
                            <span class="tf-filter-item-text">@cat.Name</span>
                        </label>
                    }
                </div>
            </div>
            <div class="tf-modal-footer tf-filter-modal-footer">
                <button type="button" class="tf-btn-clear-filter" @onclick="ClearAllCategorySelections">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="3 6 5 6 21 6"></polyline>
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                    </svg>
                    <span>Xóa chọn tất cả</span>
                </button>
                <div class="tf-filter-footer-actions">
                    <button type="button" class="tf-btn-secondary" @onclick="() => _showGroupFilterModal = false">Bỏ qua</button>
                    <button type="button" class="tf-btn-primary" @onclick="ApplyGroupFilterAsync">Xong</button>
                </div>
            </div>
        </div>
    </div>
}

@* ============================================================
   ATTRIBUTE FILTER MODAL (Lọc theo thuộc tính — Matching media_1791897987306_fb152322.png)
   ============================================================ *@
@if (_showAttributeFilterModal)
{
    <div class="tf-modal-backdrop" @onclick="() => _showAttributeFilterModal = false">
        <div class="tf-modal-dialog tf-filter-dialog" @onclick:stopPropagation="true">
            <div class="tf-modal-header">
                <h3 class="tf-modal-title">Lọc hàng hóa theo thuộc tính</h3>
                <button type="button" class="tf-modal-close-btn" @onclick="() => _showAttributeFilterModal = false">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>
            <div class="tf-modal-body tf-attr-modal-body">
                @foreach (var attr in _allAttributes)
                {
                    bool isSelected = _selectedAttributes.Contains(attr);
                    <div class="tf-attr-section">
                        <div class="tf-attr-group-title">@attr</div>
                        <div class="tf-attr-chips-wrap">
                            <button type="button"
                                    class="tf-attr-chip @(isSelected ? "selected" : "")"
