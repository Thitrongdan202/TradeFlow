    private decimal CalculateChangeDue()
    {
        if (ActiveTab.CashTendered <= 0) return 0;
        decimal grand = CalculateGrandTotal();
        return Math.Max(0, ActiveTab.CashTendered - grand);
    }

    private static decimal RoundUpCash(decimal amount, decimal roundStep)
    {
        if (roundStep <= 0) return amount;
        return Math.Ceiling(amount / roundStep) * roundStep;
    }

