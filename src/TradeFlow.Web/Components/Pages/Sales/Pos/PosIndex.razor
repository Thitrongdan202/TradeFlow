    // ============================================================
    // KEYBOARD SHORTCUTS HANDLER
    // ============================================================
    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "F3")
        {
            await _f3InputRef.FocusAsync();
        }
        else if (e.Key == "F4")
        {
            await _f4InputRef.FocusAsync();
        }
        else if (e.Key == "F8")
        {
            await _f8InputRef.FocusAsync();
        }
        else if (e.Key == "F9")
        {
            if (_showCheckoutModal)
            {
                await ConfirmAndExecuteCheckoutAsync();
            }
            else
            {
                OpenCheckoutModal();
            }
        }
        else if (e.Key == "Escape")
        {
            _openItemMenuId = null;
            _showItemNoteModal = false;
            _showProductDetailModal = false;
            _showF3Dropdown = false;
            _showCustDropdown = false;
            _showCheckoutModal = false;
            _showShortcutsModal = false;
            _showAddCustomerModal = false;
            _showPromotionModal = false;
            _showRecentOrdersModal = false;
        }
    }
