    private void OpenCheckoutModal()
    {
        if (!ActiveTab.Items.Any()) return;

        // Verify all items have valid prices
        var unpricedItems = ActiveTab.Items.Where(i => !i.HasPrice || i.UnitPrice <= 0).ToList();
        if (unpricedItems.Any())
        {
            _checkoutErrorMessage = $"Đơn hàng có {unpricedItems.Count} sản phẩm chưa thiết lập giá bán ({string.Join(", ", unpricedItems.Take(2).Select(i => i.Name))}). Vui lòng nhập giá hoặc xóa sản phẩm khỏi giỏ hàng trước khi thanh toán.";
            return;
        }

        _checkoutErrorMessage = null;
        if (ActiveTab.CashTendered <= 0)
        {
            ActiveTab.CashTendered = CalculateGrandTotal();
        }
        _showCheckoutModal = true;
    }

    private async Task ConfirmAndExecuteCheckoutAsync()
    {
        if (!ActiveTab.Items.Any() || _isProcessingCheckout) return;

        var unpricedItems = ActiveTab.Items.Where(i => !i.HasPrice || i.UnitPrice <= 0).ToList();
        if (unpricedItems.Any())
        {
            _checkoutErrorMessage = "Vui lòng nhập giá bán hợp lệ cho tất cả sản phẩm trước khi thanh toán.";
            _showCheckoutModal = false;
            return;
        }

        try
        {
            _isProcessingCheckout = true;
            _showCheckoutModal = false;

            // 1. Ensure Customer
            var customer = ActiveTab.Customer;
            if (customer == null)
            {
                customer = await DbContext.Customers.FirstOrDefaultAsync(c => c.Name == "Khách lẻ" || c.Code == "KL" || c.Code == "KH_LE");
                if (customer == null)
                {
                    customer = new Customer
                    {
                        Code = "KL",
                        Name = "Khách lẻ",
                        Phone = "0900000000",
                        Address = "Tại quầy cửa hàng",
                        IsActive = true
                    };
                    DbContext.Customers.Add(customer);
                    await DbContext.SaveChangesAsync();
                }
            }

            // 2. Build SalesOrderDto with safe editable OrderDate & mapped VAT rates
            var orderDto = new SalesOrderDto
            {
                CustomerId = customer.Id,
                CustomerName = !string.IsNullOrEmpty(customer.CompanyName) ? customer.CompanyName : customer.Name,
                CustomerPhone = customer.Phone,
                CustomerAddress = customer.Address,
                OrderDate = ActiveTab.OrderDate,
                TotalDiscount = ActiveTab.Discount,
                Notes = string.IsNullOrWhiteSpace(ActiveTab.Notes) 
                    ? $"[Kênh: {ActiveTab.SalesChannel}]" 
                    : $"[Kênh: {ActiveTab.SalesChannel}] {ActiveTab.Notes}",
                Items = ActiveTab.Items.Select(i =>
                {
                    decimal effRate = GetItemEffectiveVatRate(i);
                    decimal itemBase = Math.Max(0, (i.Quantity * i.UnitPrice) - i.Discount);
                    decimal itemTax = Math.Round(itemBase * (effRate / 100m), 0, MidpointRounding.AwayFromZero);
                    return new SalesOrderItemDto
                    {
                        ProductId = i.ProductId,
                        ProductCode = i.Code,
                        ProductName = i.Name,
                        UnitName = i.UnitName ?? "Cái",
                        Quantity = i.Quantity,
                        UnitPrice = i.UnitPrice,
                        DiscountAmount = i.Discount,
                        TaxRate = effRate,
                        TaxAmount = itemTax,
                        LineTotal = itemBase + itemTax,
                        Notes = i.Note
                    };
                }).ToList()
            };

            // 3. Create Sales Order
            var createdOrder = await SalesService.CreateOrderAsync(orderDto);
            _lastCreatedOrderId = createdOrder.Id;
            _lastCreatedOrderCode = createdOrder.Code;
            _lastSubTotal = CalculateSubTotal();
            _lastTotalDiscount = CalculateTotalDiscount();
            _lastTaxTotal = CalculateTaxTotal();
            _lastGrandTotal = CalculateGrandTotal();

            // 4. Optionally Create Sales Invoice Directly (Without VAT on sales invoice template)
            if (_createInvoiceDirectly)
            {
                await SalesService.ConfirmOrderAsync(createdOrder.Id);
                var createdInvoice = await InvoiceService.CreateInvoiceFromOrderAsync(
                    createdOrder.Id,
                    InvoiceType.SalesInvoice);
                
                _lastCreatedInvoiceId = createdInvoice.Id;
                _lastCreatedInvoiceNumber = !string.IsNullOrEmpty(createdInvoice.InvoiceNo) ? createdInvoice.InvoiceNo : createdInvoice.InvoiceNumber;
            }

            _showSuccessModal = true;
            await RefreshDataAsync();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Lỗi thanh toán: {ex.Message}");
        }
        finally
        {
            _isProcessingCheckout = false;
        }
    }

    private async Task PrintSalesInvoicePdfAsync()
    {
        if (_lastCreatedOrderId <= 0) return;
        try
        {
            if (_lastCreatedInvoiceId <= 0)
            {
                var inv = await InvoiceService.CreateInvoiceFromOrderAsync(_lastCreatedOrderId, InvoiceType.SalesInvoice);
                _lastCreatedInvoiceId = inv.Id;
                _lastCreatedInvoiceNumber = !string.IsNullOrEmpty(inv.InvoiceNo) ? inv.InvoiceNo : inv.InvoiceNumber;
            }
            var pdfBytes = await InvoiceService.GeneratePdfAsync(_lastCreatedInvoiceId);
            var base64 = Convert.ToBase64String(pdfBytes);
            await JS.InvokeVoidAsync("tradeflow.downloadPdfBase64", base64, $"HoaDonBanHang_{_lastCreatedOrderCode}.pdf");
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Lỗi tạo hóa đơn PDF: {ex.Message}");
        }
    }

    private async Task PrintOrderDocPdfAsync()
    {
        if (_lastCreatedOrderId <= 0) return;
        try
        {
            var doc = await InvoiceService.GetOrderDocumentByOrderIdAsync(_lastCreatedOrderId);
            if (doc != null)
            {
                var pdfBytes = await InvoiceService.GenerateOrderDocumentPdfAsync(doc);
                var base64 = Convert.ToBase64String(pdfBytes);
                await JS.InvokeVoidAsync("tradeflow.downloadPdfBase64", base64, $"ChungTuBanHang_VAT_{_lastCreatedOrderCode}.pdf");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Lỗi tạo chứng từ PDF: {ex.Message}");
        }
    }

