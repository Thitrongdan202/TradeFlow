                            <span class="tf-detail-value">@_viewingProductDetail.LegacyCode</span>
                        </div>
                    }
                    <div class="tf-detail-field">
                        <span class="tf-detail-label">Tên sản phẩm:</span>
                        <span class="tf-detail-value">@_viewingProductDetail.Name</span>
                    </div>
                    <div class="tf-detail-field">
                        <span class="tf-detail-label">Danh mục:</span>
                        <span class="tf-detail-value">@(_viewingProductDetail.Category?.Name ?? "Chưa phân loại")</span>
                    </div>
