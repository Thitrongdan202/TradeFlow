@page "/ban-hang/bao-gia/chinh-sua/{Id:int}"
@using Microsoft.AspNetCore.Authorization
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Application.Common.Models.Pricing
@using TradeFlow.Application.Common.Models.Sales
@using TradeFlow.Domain.Entities.MasterData
@using TradeFlow.Domain.Enums
@inject IQuotationService QuotationService
@inject ISalesService SalesService
@inject IPriceListService PriceListService
@inject NavigationManager Nav
@inject IJSRuntime JS
@rendermode InteractiveServer
@attribute [Authorize(Policy = "Permission:Quotations:Edit")]

<PageTitle>Chỉnh sửa báo giá @(_quotation?.Code) | TradeFlow</PageTitle>

@if (_isLoading)
{
    <div class="tf-card tf-mb-4" style="padding: 24px;">
        <Skeleton Type="title" Width="30%" Class="tf-mb-3" />
        <Skeleton Type="text" Width="20%" Class="tf-mb-4" />
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
            <Skeleton Type="card" Height="100px" />
            <Skeleton Type="card" Height="100px" />
        </div>
    </div>
    <div class="tf-card" style="padding: 24px;">
        <Skeleton Type="table" Rows="4" Columns="7" />
    </div>
}
else if (_quotation == null)
{
    <div class="tf-empty-state">
        <h3>Không tìm thấy báo giá</h3>
        <p>Báo giá không tồn tại hoặc đã bị xóa.</p>
        <a href="/ban-hang/bao-gia" class="tf-btn tf-btn-secondary">Quay lại danh sách</a>
    </div>
}
else if (_quotation.Status == QuotationStatus.Converted)
{
    <div class="tf-card" style="padding:24px; text-align:center;">
        <h3 style="color:#0f766e;">Báo giá đã được chuyển đổi sang Đơn bán hàng</h3>
        <p>Báo giá @_quotation.Code đã được chuyển thành đơn bán hàng @_quotation.SalesOrderCode. Không thể chỉnh sửa.</p>
        <div style="margin-top:16px;">
            <a href="/ban-hang/bao-gia/chi-tiet/@_quotation.Id" class="tf-btn tf-btn-primary">Xem chi tiết báo giá</a>
            <a href="/ban-hang/bao-gia" class="tf-btn tf-btn-outline-secondary" style="margin-left:8px;">Danh sách</a>
        </div>
    </div>
}
else if (_quotation.Status == QuotationStatus.Cancelled)
{
    <div class="tf-card" style="padding:24px; text-align:center;">
        <h3 style="color:var(--tf-danger);">Báo giá đã bị hủy</h3>
        <p>Báo giá @_quotation.Code đã bị hủy và không thể chỉnh sửa.</p>
        <div style="margin-top:16px;">
            <a href="/ban-hang/bao-gia/chi-tiet/@_quotation.Id" class="tf-btn tf-btn-secondary">Quay lại chi tiết</a>
        </div>
    </div>
}
else
{
    <div class="tf-page-header">
        <div class="tf-page-header-content">
            <h1 class="tf-page-title">Chỉnh sửa báo giá: @_quotation.Code</h1>
            <p class="tf-page-subtitle">Cập nhật thông tin khách hàng, chi tiết mặt hàng, đơn giá, chiết khấu và điều khoản thương mại.</p>
        </div>
        <div class="tf-page-header-actions">
            <a href="/ban-hang/bao-gia/chi-tiet/@Id" class="tf-btn tf-btn-outline-secondary">
                ← Xem chi tiết
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="tf-alert tf-alert-danger tf-mb-4" style="display:flex; justify-content:space-between; align-items:center;">
            <div>
                <strong>Lỗi:</strong> @_errorMessage
            </div>
            <button type="button" style="background:none; border:none; cursor:pointer; font-size:16px; color:#991b1b;" @onclick="() => _errorMessage = null">✕</button>
        </div>
    }

    @* 1. Customer Info *@
    <div class="tf-card tf-mb-4 tf-quotation-section">
        <div class="tf-quotation-section-header">
            <div>
                <h3 class="tf-quotation-section-title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" style="margin-right:8px;">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                    THÔNG TIN KHÁCH HÀNG & BÁO GIÁ
                </h3>
                <p class="tf-quotation-section-desc">Thông tin đối tác nhận báo giá và các mốc thời gian hiệu lực.</p>
            </div>
        </div>

        <div class="tf-quotation-section-body">
            @* Customer Selected Card / Switcher *@
            <div class="tf-form-group">
                <label class="tf-form-label" style="font-weight:600; margin-bottom:6px;">
                    Khách hàng nhận báo giá <span style="color:#ef4444;">*</span>
                </label>

                <div class="tf-customer-card">
                    <div class="tf-customer-card-header">
                        <div class="tf-customer-card-identity">
                            <div class="tf-customer-card-avatar">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="12" cy="7" r="4"></circle>
                                </svg>
                            </div>
                            <div>
                                <div class="tf-customer-card-name">
                                    @_quotation.CustomerName
                                    <span class="tf-badge tf-badge-success" style="font-size:11px; margin-left:8px;">✓ Đang áp dụng</span>
                                </div>
                                <div class="tf-customer-card-sub">Mã khách hàng ID: <strong>#@_quotation.CustomerId</strong></div>
                            </div>
                        </div>
                        <button type="button" class="tf-btn tf-btn-sm tf-btn-outline-secondary" @onclick="ToggleChangeCustomer">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:4px;">
                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                            </svg>
                            @(_isChangingCustomer ? "Đóng tìm kiếm" : "Thay đổi khách hàng")
                        </button>
                    </div>

                    @if (_isChangingCustomer)
                    {
                        <div style="padding:14px 0 6px; border-bottom:1px solid #e2e8f0;">
                            <div class="tf-search-input-group">
                                <div class="tf-search-icon-prefix">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="11" cy="11" r="8"></circle>
                                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                    </svg>
                                </div>
                                <input type="text"
                                       class="tf-form-control tf-search-control"
                                       placeholder="Tìm khách hàng thay thế theo tên, mã, SĐT hoặc MST..."
                                       @bind="_customerSearch"
                                       @bind:event="oninput"
                                       @onkeyup="SearchCustomers" />
                            </div>

                            @if (_isCustomerSearched)
                            {
                                <div style="position:relative; z-index:100;">
                                    <ul style="position:absolute; top:4px; left:0; right:0; background:white; border:1px solid #cbd5e1; border-radius:8px; list-style:none; padding:6px 0; margin:0; max-height:220px; overflow-y:auto; box-shadow:0 10px 15px -3px rgba(0,0,0,0.1), 0 4px 6px -2px rgba(0,0,0,0.05);">
                                        @if (!_customerSearchResults.Any())
                                        {
                                            <li style="padding:12px 16px; color:#64748b; font-size:13px; text-align:center;">
                                                Không tìm thấy khách hàng phù hợp.
                                            </li>
                                        }
                                        else
                                        {
                                            @foreach (var c in _customerSearchResults)
                                            {
                                                <li style="padding:10px 16px; border-bottom:1px solid #f8fafc; cursor:pointer; transition:background-color 0.15s ease;"
                                                    onmouseover="this.style.backgroundColor='#f1f5f9'"
                                                    onmouseout="this.style.backgroundColor='white'"
                                                    @onclick="() => SelectCustomer(c)">
                                                    <div style="display:flex; justify-content:space-between; align-items:center;">
                                                        <div style="font-weight:600; color:#1e293b; font-size:13.5px;">@c.Name</div>
                                                        <span class="tf-badge tf-badge-secondary" style="font-size:11px;">Mã: @c.Code</span>
                                                    </div>
                                                    <div style="font-size:12px; color:#64748b; margin-top:2px;">
                                                        MST: @(c.TaxCode ?? "—") | SĐT: @(c.Phone ?? "—") | Đ/c: @(c.Address ?? "—")
                                                    </div>
                                                </li>
                                            }
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                    }

                    <div class="tf-customer-card-body">
                        <div class="tf-customer-meta-item">
                            <span class="tf-meta-label">Mã số thuế:</span>
                            <span class="tf-meta-value">@(!string.IsNullOrWhiteSpace(_quotation.CustomerTaxCode) ? _quotation.CustomerTaxCode : "—")</span>
                        </div>
                        <div class="tf-customer-meta-item">
                            <span class="tf-meta-label">Số điện thoại:</span>
                            <span class="tf-meta-value">@(!string.IsNullOrWhiteSpace(_quotation.CustomerPhone) ? _quotation.CustomerPhone : "—")</span>
                        </div>
                        <div class="tf-customer-meta-item">
                            <span class="tf-meta-label">Email:</span>
                            <span class="tf-meta-value">@(!string.IsNullOrWhiteSpace(_quotation.CustomerEmail) ? _quotation.CustomerEmail : "—")</span>
                        </div>
                        <div class="tf-customer-meta-item" style="grid-column: 1 / -1;">
                            <span class="tf-meta-label">Địa chỉ:</span>
                            <span class="tf-meta-value">@(!string.IsNullOrWhiteSpace(_quotation.CustomerAddress) ? _quotation.CustomerAddress : "—")</span>
                        </div>
                    </div>
                </div>
            </div>

            @* Quotation Metadata Grid *@
            <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap:16px; margin-top: 18px;">
                <div class="tf-form-group">
                    <label class="tf-form-label" style="font-weight:600;">Ngày báo giá <span style="color:#ef4444;">*</span></label>
                    <input type="date" class="tf-form-control" @bind="_quotation.QuotationDate" />
                </div>
                <div class="tf-form-group">
                    <label class="tf-form-label" style="font-weight:600;">Hạn hiệu lực</label>
                    <input type="date" class="tf-form-control" @bind="_quotation.ExpiryDate" />
                </div>
                <div class="tf-form-group">
                    <label class="tf-form-label" style="font-weight:600;">Người lập / Phụ trách</label>
                    <input type="text" class="tf-form-control" placeholder="Tên nhân viên kinh doanh..." @bind="_quotation.SalespersonName" />
                </div>
                <div class="tf-form-group">
                    <label class="tf-form-label" style="font-weight:600;">Người liên hệ bên mua</label>
                    <input type="text" class="tf-form-control" placeholder="Tên người nhận báo giá..." @bind="_quotation.CustomerContactPerson" />
                </div>
            </div>

            @* General Notes *@
            <div class="tf-form-group" style="margin-top:16px;">
                <label class="tf-form-label" style="font-weight:600;">Ghi chú chung</label>
                <textarea class="tf-notes-textarea" placeholder="Ghi chú thêm về báo giá..." @bind="_quotation.Notes"></textarea>
            </div>
        </div>
    </div>

    @* 2. Products Table & Pricing Selection *@
    <div class="tf-card tf-mb-4 tf-quotation-section">
        <div class="tf-quotation-section-header">
            <div>
                <h3 class="tf-quotation-section-title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" style="margin-right:8px;">
                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                        <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                        <line x1="12" y1="22.08" x2="12" y2="12"></line>
                    </svg>
                    CHI TIẾT MẶT HÀNG BÁO GIÁ
                </h3>
                <p class="tf-quotation-section-desc">Cập nhật số lượng, đơn giá, chiết khấu các sản phẩm trong báo giá.</p>
            </div>
            <div>
                <span class="tf-badge tf-badge-info" style="font-size:12px; font-weight:600; padding:5px 10px;">
                    Đơn giá trước VAT
                </span>
            </div>
        </div>

        <div class="tf-quotation-section-body">
            @* Controls *@
            <div style="display:grid; grid-template-columns: 280px 1fr; gap:16px; margin-bottom:20px; align-items:end;">
                <div class="tf-form-group">
                    <label class="tf-form-label" style="font-weight:600; margin-bottom:6px;">Áp dụng bảng giá:</label>
                    <select class="tf-form-control" @bind="_selectedPriceListId">
                        <option value="">-- Bảng giá mặc định --</option>
                        @foreach (var pl in _availablePriceLists)
                        {
                            <option value="@pl.Id">@pl.Name</option>
                        }
                    </select>
                </div>
                <div class="tf-form-group">
                    <label class="tf-form-label" style="font-weight:600; margin-bottom:6px;">Thêm sản phẩm:</label>
                    <div class="tf-search-input-group">
                        <div class="tf-search-icon-prefix">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="11" cy="11" r="8"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            </svg>
                        </div>
                        <input type="text"
                               class="tf-form-control tf-search-control"
                               placeholder="Tìm kiếm sản phẩm theo tên hoặc mã mặt hàng..."
                               @bind="_productSearch"
                               @bind:event="oninput"
                               @onkeyup="SearchProducts" />
                    </div>

                    @if (_isProductSearched)
                    {
                        <div style="position:relative; z-index:90;">
                            <ul style="position:absolute; top:4px; left:0; right:0; background:white; border:1px solid #cbd5e1; border-radius:8px; list-style:none; padding:6px 0; margin:0; max-height:240px; overflow-y:auto; box-shadow:0 10px 15px -3px rgba(0,0,0,0.1), 0 4px 6px -2px rgba(0,0,0,0.05);">
                                @if (!_productSearchResults.Any())
                                {
                                    <li style="padding:12px 16px; color:#64748b; font-size:13px; text-align:center;">
                                        Không tìm thấy sản phẩm phù hợp.
                                    </li>
                                }
                                else
                                {
                                    @foreach (var p in _productSearchResults)
                                    {
                                        <li style="padding:10px 16px; border-bottom:1px solid #f8fafc; cursor:pointer; transition:background-color 0.15s ease;"
                                            onmouseover="this.style.backgroundColor='#f1f5f9'"
                                            onmouseout="this.style.backgroundColor='white'"
                                            @onclick="() => SelectProduct(p)">
                                            <div style="display:flex; justify-content:space-between; align-items:center;">
                                                <div style="font-weight:600; color:#1e293b; font-size:13.5px;">@p.Name</div>
                                                <span class="tf-badge tf-badge-secondary" style="font-size:11px;">Mã: @p.Code</span>
                                            </div>
                                            <div style="font-size:12px; color:#64748b; margin-top:2px;">
                                                Đơn vị tính: @(p.Unit?.Name ?? "—")
                                            </div>
                                        </li>
                                    }
                                }
                            </ul>
                        </div>
                    }
                </div>
            </div>

            @if (!_quotation.Items.Any())
            {
                <div class="tf-quotation-empty-items">
                    <div class="tf-empty-icon-wrap">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="1.75">
                            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                            <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                            <line x1="12" y1="22.08" x2="12" y2="12"></line>
                        </svg>
                    </div>
                    <div class="tf-empty-title">Chưa có sản phẩm nào trong báo giá</div>
                    <div class="tf-empty-desc">Sử dụng ô tìm kiếm phía trên để thêm các sản phẩm, dịch vụ vào báo giá.</div>
                </div>
            }
            else
            {
                <div class="tf-table-responsive" style="border:1px solid #e2e8f0; border-radius:8px; overflow:hidden;">
                    <table class="tf-table" style="font-size:13px; margin-bottom:0;">
                        <thead style="background:#f8fafc;">
                            <tr>
                                <th style="width:36px; text-align:center;">#</th>
                                <th style="width:110px;">Mã SP</th>
                                <th>Tên sản phẩm / Quy cách</th>
                                <th style="width:75px; text-align:center;">ĐVT</th>
                                <th style="width:85px; text-align:right;">Số lượng</th>
                                <th style="width:130px; text-align:right;">Đơn giá trước VAT</th>
                                <th style="width:105px; text-align:center;">Nguồn giá</th>
                                <th style="width:85px; text-align:right;">CK (%)</th>
                                <th style="width:115px; text-align:right;">Tiền CK</th>
                                <th style="width:135px; text-align:right;">Thành tiền</th>
                                <th style="width:40px; text-align:center;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int rowNum = 1;
                                foreach (var item in _quotation.Items)
                                {
                                    <tr>
                                        <td style="text-align:center; color:#64748b;">@rowNum</td>
                                        <td><strong>@item.ProductCode</strong></td>
                                        <td>
                                            <div style="font-weight:600; color:#1e293b;">@item.ProductName</div>
                                            <input type="text" class="tf-form-control" style="font-size:11.5px; padding:3px 8px; margin-top:4px; height:28px;" placeholder="Ghi chú quy cách..." @bind="item.Notes" />
                                        </td>
                                        <td style="text-align:center;">@item.UnitName</td>
                                        <td>
                                            <input type="number" min="1" step="1" class="tf-form-control" style="text-align:right; padding:3px 8px; height:32px;" @bind="item.Quantity" @bind:after="() => OnQuantityChanged(item)" />
                                        </td>
                                        <td>
                                            <input type="number" min="0" step="1000" class="tf-form-control" style="text-align:right; padding:3px 8px; height:32px;" @bind="item.UnitPrice" @bind:after="() => OnManualPriceChanged(item)" />
                                        </td>
                                        <td style="text-align:center;">
                                            <span class="tf-badge tf-badge-secondary" style="font-size:11px;">@item.PriceSource</span>
                                        </td>
                                        <td>
                                            <input type="number" min="0" max="100" step="0.5" class="tf-form-control" style="text-align:right; padding:3px 8px; height:32px;" @bind="item.DiscountRate" @bind:after="() => OnDiscountRateChanged(item)" />
                                        </td>
                                        <td>
                                            <input type="number" min="0" step="1000" class="tf-form-control" style="text-align:right; padding:3px 8px; height:32px;" @bind="item.DiscountAmount" @bind:after="() => OnDiscountAmountChanged(item)" />
                                        </td>
                                        <td style="text-align:right; font-weight:700; color:#0f766e; font-size:13.5px;">
                                            @item.LineTotal.ToString("N0") đ
                                        </td>
                                        <td style="text-align:center;">
                                            <button type="button" class="tf-btn tf-btn-sm tf-btn-outline-danger" style="padding:2px 6px; border-radius:4px; height:26px; width:26px;" title="Xóa mặt hàng" @onclick="() => RemoveItem(item)">✕</button>
                                        </td>
                                    </tr>
                                    rowNum++;
                                }
                            }
                        </tbody>
                    </table>
                </div>

                @* Totals Summary *@
                <div style="display:flex; justify-content:flex-end; margin-top:20px;">
                    <div style="width:360px; background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; padding:18px;">
                        <div style="display:flex; justify-content:space-between; margin-bottom:8px; font-size:13.5px;">
                            <span style="color:#64748b;">Tổng tiền hàng trước VAT:</span>
                            <strong style="color:#1e293b;">@_quotation.SubTotal.ToString("N0") đ</strong>
                        </div>
                        @if (_quotation.TotalDiscount > 0)
                        {
                            <div style="display:flex; justify-content:space-between; margin-bottom:8px; font-size:13.5px; color:#d97706;">
                                <span>Tổng chiết khấu:</span>
                                <strong>-@_quotation.TotalDiscount.ToString("N0") đ</strong>
                            </div>
                        }
                        <div style="display:flex; justify-content:space-between; padding-top:10px; border-top:2px solid #cbd5e1; font-size:16px;">
                            <span style="font-weight:700; color:#0f766e;">TỔNG GIÁ TRỊ:</span>
                            <strong style="color:#0f766e; font-size:17px;">@_quotation.GrandTotal.ToString("N0") đ</strong>
                        </div>
                        <div style="font-size:11.5px; color:#64748b; font-style:italic; margin-top:6px; text-align:right;">
                            (Đơn giá thương mại chưa bao gồm thuế GTGT)
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    @* 3. Terms & Conditions *@
    <div class="tf-card tf-mb-4 tf-quotation-section">
        <div class="tf-quotation-section-header">
            <div>
                <h3 class="tf-quotation-section-title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" style="margin-right:8px;">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                        <polyline points="10 9 9 9 8 9"></polyline>
                    </svg>
                    ĐIỀU KHOẢN THƯƠNG MẠI & THANH TOÁN
                </h3>
                <p class="tf-quotation-section-desc">Cập nhật quy định về thanh toán, giao nhận, bảo hành và cam kết đối với báo giá này.</p>
            </div>
            <div class="tf-terms-actions">
                <span class="tf-terms-char-count">@((_quotation.Terms ?? "").Length) ký tự</span>
                <button type="button" class="tf-btn tf-btn-xs tf-btn-outline-secondary" @onclick="ResetDefaultTerms" title="Nạp lại các điều khoản thương mại chuẩn">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:4px;">
                        <polyline points="1 4 1 10 7 10"></polyline>
                        <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
                    </svg>
                    Nạp điều khoản chuẩn
                </button>
            </div>
        </div>
        <div class="tf-quotation-section-body">
            <textarea class="tf-terms-editor"
                      placeholder="Nhập các điều khoản thương mại, tiến độ thanh toán, thời gian giao hàng, bảo hành..."
                      @bind="_quotation.Terms"
                      @bind:event="oninput"></textarea>
            <div class="tf-terms-footer-hint">
                <span>💡 <strong>Gợi ý:</strong> Khung soạn thảo tự động mở rộng theo nội dung. Nhấn <code>Enter</code> để xuống dòng, phân tách rõ các điều khoản bằng đánh số 1, 2, 3...</span>
            </div>
        </div>
    </div>

    @* Action Buttons *@
    <div class="tf-action-footer">
        <div class="tf-action-footer-left">
            <a href="/ban-hang/bao-gia/chi-tiet/@Id" class="tf-btn tf-btn-outline-secondary">
                ← Quay lại chi tiết báo giá
            </a>
        </div>
        <div class="tf-action-footer-right">
            <a href="/ban-hang/bao-gia/chi-tiet/@Id" class="tf-btn tf-btn-light">
                Hủy bỏ
            </a>
            <button type="button" class="tf-btn tf-btn-primary" @onclick="SaveUpdates" disabled="@_isSaving">
                @if (_isSaving)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true" style="margin-right:6px;"></span>
                    <span>Đang lưu thay đổi...</span>
                }
                else
                {
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:6px;">
                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                        <polyline points="17 21 17 13 7 13 7 21"></polyline>
                        <polyline points="7 3 7 8 15 8"></polyline>
                    </svg>
                    <span>Lưu thay đổi</span>
                }
            </button>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private QuotationDto? _quotation;
    private bool _isLoading = true;
    private bool _isSaving = false;
    private bool _isChangingCustomer = false;
    private string? _errorMessage;

    private List<Customer> _customerSearchResults = new();
    private string _customerSearch = "";
    private bool _isCustomerSearched = false;
    private CancellationTokenSource? _customerSearchCts;

    private List<Product> _productSearchResults = new();
    private string _productSearch = "";
    private bool _isProductSearched = false;
    private CancellationTokenSource? _productSearchCts;

    private List<PriceListDto> _availablePriceLists = new();
    private int? _selectedPriceListId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLoading = true;
            _quotation = await QuotationService.GetQuotationByIdAsync(Id);
            var priceLists = await PriceListService.GetPriceListsAsync();
            _availablePriceLists = priceLists.Where(x => x.Status == PriceListStatus.Active).ToList();
        }
        catch (Exception ex)
        {
            _errorMessage = "Lỗi khi tải dữ liệu báo giá: " + ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || !_isLoading)
        {
            try
            {
                await JS.InvokeVoidAsync("eval", "document.querySelectorAll('.tf-terms-editor').forEach(el => window.tradeflow && window.tradeflow.autoResizeTextarea(el, 180, 450))");
            }
            catch { }
        }
    }

    private void ToggleChangeCustomer()
    {
        _isChangingCustomer = !_isChangingCustomer;
        if (!_isChangingCustomer)
        {
            _customerSearch = "";
            _customerSearchResults.Clear();
            _isCustomerSearched = false;
        }
    }

    private void ResetDefaultTerms()
    {
        if (_quotation == null) return;
        _quotation.Terms = "1. Đơn giá trên là giá bán chưa bao gồm thuế GTGT (8%).\n2. Thanh toán: Tiền mặt hoặc chuyển khoản theo thỏa thuận hợp đồng.\n3. Thời gian giao hàng: Theo tiến độ thỏa thuận giữa hai bên.\n4. Bảo hành: Theo tiêu chuẩn kỹ thuật của nhà sản xuất.";
    }

    private async Task SearchCustomers(KeyboardEventArgs e)
    {
        _customerSearchCts?.Cancel();
        _customerSearchCts = new CancellationTokenSource();
        var token = _customerSearchCts.Token;

        _isCustomerSearched = true;
        if (_customerSearch.Length >= 2)
        {
            try
            {
                await Task.Delay(300, token);
                if (!token.IsCancellationRequested)
                {
                    _customerSearchResults = await SalesService.SearchCustomersAsync(_customerSearch, token);
                    StateHasChanged();
                }
            }
            catch (TaskCanceledException) { }
            catch (Exception ex)
            {
                _errorMessage = "Lỗi khi tìm khách hàng: " + ex.Message;
            }
        }
        else
        {
            _customerSearchResults.Clear();
            _isCustomerSearched = false;
        }
    }

    private void SelectCustomer(Customer c)
    {
        if (_quotation == null) return;
        _quotation.CustomerId = c.Id;
        _quotation.CustomerName = c.Name;
        _quotation.CustomerTaxCode = c.TaxCode;
        _quotation.CustomerAddress = c.Address;
        _quotation.CustomerPhone = c.Phone;
        _quotation.CustomerContactPerson = c.ContactPerson;
        _quotation.CustomerEmail = c.Email;
        _customerSearch = "";
        _customerSearchResults.Clear();
        _isCustomerSearched = false;
        _isChangingCustomer = false;
    }

    private async Task SearchProducts(KeyboardEventArgs e)
    {
        _productSearchCts?.Cancel();
        _productSearchCts = new CancellationTokenSource();
        var token = _productSearchCts.Token;

        _isProductSearched = true;
        if (_productSearch.Length >= 2)
        {
            try
            {
                await Task.Delay(300, token);
                if (!token.IsCancellationRequested)
                {
                    _productSearchResults = await SalesService.SearchProductsAsync(_productSearch, token);
                    StateHasChanged();
                }
            }
            catch (TaskCanceledException) { }
            catch (Exception ex)
            {
                _errorMessage = "Lỗi khi tìm sản phẩm: " + ex.Message;
            }
        }
        else
        {
            _productSearchResults.Clear();
            _isProductSearched = false;
        }
    }

    private async Task SelectProduct(Product p)
    {
        if (_quotation == null) return;
        _productSearch = "";
        _productSearchResults.Clear();
        _isProductSearched = false;

        var existing = _quotation.Items.FirstOrDefault(x => x.ProductId == p.Id);
        if (existing != null)
        {
            existing.Quantity += 1;
            RecalculateItem(existing);
        }
        else
        {
            var priceRes = await SalesService.GetProductPriceAsync(p.Id, _selectedPriceListId, _quotation.QuotationDate);
            var item = new QuotationItemDto
            {
                QuotationId = _quotation.Id,
                ProductId = p.Id,
                ProductCode = p.Code,
                ProductName = p.Name,
                UnitName = p.Unit?.Name ?? "Cái",
                Quantity = 1,
                UnitPrice = priceRes.Price ?? 0,
                PriceSource = priceRes.SourceName,
                DiscountRate = 0,
                DiscountAmount = 0,
                LineTotal = priceRes.Price ?? 0
            };
            _quotation.Items.Add(item);
        }

        CalculateTotals();
    }

    private void RemoveItem(QuotationItemDto item)
    {
        if (_quotation == null) return;
        _quotation.Items.Remove(item);
        CalculateTotals();
    }

    private void OnQuantityChanged(QuotationItemDto item)
    {
        RecalculateItem(item);
        CalculateTotals();
    }

    private void OnManualPriceChanged(QuotationItemDto item)
    {
        item.PriceSource = "Thủ công";
        RecalculateItem(item);
        CalculateTotals();
    }

    private void OnDiscountRateChanged(QuotationItemDto item)
    {
        var baseAmount = item.Quantity * item.UnitPrice;
        item.DiscountAmount = Math.Round(baseAmount * (item.DiscountRate / 100m), 0);
        RecalculateItem(item);
        CalculateTotals();
    }

    private void OnDiscountAmountChanged(QuotationItemDto item)
    {
        var baseAmount = item.Quantity * item.UnitPrice;
        if (baseAmount > 0)
        {
            item.DiscountRate = Math.Round((item.DiscountAmount / baseAmount) * 100m, 2);
        }
        RecalculateItem(item);
        CalculateTotals();
    }

    private void RecalculateItem(QuotationItemDto item)
    {
        var baseAmount = item.Quantity * item.UnitPrice;
        if (item.DiscountAmount > baseAmount)
        {
            item.DiscountAmount = baseAmount;
        }
        item.LineTotal = baseAmount - item.DiscountAmount;
        if (item.LineTotal < 0) item.LineTotal = 0;
    }

    private void CalculateTotals()
    {
        if (_quotation == null) return;
        _quotation.SubTotal = _quotation.Items.Sum(x => x.Quantity * x.UnitPrice);
        _quotation.TotalDiscount = _quotation.Items.Sum(x => x.DiscountAmount);
        _quotation.GrandTotal = _quotation.SubTotal - _quotation.TotalDiscount;
    }

    private async Task SaveUpdates()
    {
        if (_quotation == null) return;
        _errorMessage = null;

        if (_quotation.CustomerId <= 0)
        {
            _errorMessage = "Vui lòng chọn khách hàng nhận báo giá.";
            return;
        }

        if (!_quotation.Items.Any())
        {
            _errorMessage = "Vui lòng có ít nhất một sản phẩm trong báo giá.";
            return;
        }

        try
        {
            _isSaving = true;
            await QuotationService.UpdateQuotationAsync(_quotation);
            Nav.NavigateTo($"/ban-hang/bao-gia/chi-tiet/{_quotation.Id}");
        }
        catch (Exception ex)
        {
            _errorMessage = "Lỗi khi cập nhật báo giá: " + ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }
}
