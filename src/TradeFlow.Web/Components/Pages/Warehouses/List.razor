@page "/kho/kho-hang"
@page "/kho-hang"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Domain.Entities.MasterData
@using TradeFlow.Infrastructure.Persistence
@attribute [Authorize(Policy = "Permission:Warehouses:View")]

@inject IDbContextFactory<TradeFlowDbContext> DbContextFactory
@inject NavigationManager Nav
@inject IAuthorizationService AuthService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject IAuditService AuditService

<PageTitle>Kho hàng - TradeFlow</PageTitle>

<WarehouseNavTabs ActiveTab="warehouses" />

<div class="tf-page-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 16px;">
    <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
        <div>
            <h1 class="tf-page-title" style="margin: 0; font-size: 20px;">Kho hàng</h1>
            <p class="tf-page-subtitle" style="margin: 2px 0 0; font-size: 12px;">Danh sách kho bãi, địa điểm lưu trữ và thủ kho quản lý</p>
        </div>
        <div style="width: 320px; max-width: 100%;">
            <DebouncedSearchInput Placeholder="Tìm theo tên kho, mã kho, người phụ trách..."
                                  Value="@_searchTerm"
                                  ValueChanged="OnSearchChanged" />
        </div>
        <div class="tf-filter-popover-anchor" style="position: relative; display: inline-block;">
            <button type="button" class="tf-btn tf-btn-secondary @(_showFilterPopover ? "active" : "")" @onclick="ToggleFilterPopover" title="Bộ lọc trạng thái">
                <span>Bộ lọc</span>
                @if (HasActiveFilters)
                {
                    <span class="tf-filter-active-count" style="margin-left: 6px; padding: 1px 6px; border-radius: 10px; background: #2563eb; color: #fff; font-size: 11px; font-weight: 700;">1</span>
                }
            </button>
            @if (_showFilterPopover)
            {
                <div class="tf-popover-backdrop" style="position: fixed; inset: 0; z-index: 998; background: transparent;" @onclick="CloseFilterPopover"></div>
                <div class="tf-filter-popover" style="position: absolute; top: calc(100% + 6px); left: 0; z-index: 999; width: 280px; background: var(--tf-surface-card, #ffffff); border: 1px solid var(--tf-border, #cbd5e1); border-radius: 10px; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.15); padding: 14px;" role="dialog" aria-modal="false" @onkeydown="HandleFilterKeyDown" tabindex="0">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; padding-bottom: 8px; border-bottom: 1px solid var(--tf-border, #e2e8f0);">
                        <span style="font-size: 13px; font-weight: 700; text-transform: uppercase; color: var(--tf-text-primary, #1e293b);">Bộ lọc kho hàng</span>
                        <div style="display: flex; align-items: center; gap: 8px;">
                            @if (HasActiveFilters)
                            {
                                <button type="button" style="background: none; border: none; color: #ef4444; font-size: 12px; font-weight: 600; cursor: pointer; padding: 2px 4px;" @onclick="ClearAllFilters">Xóa lọc</button>
                            }
                            <button type="button" style="background: none; border: none; color: var(--tf-text-muted, #64748b); cursor: pointer; padding: 2px 4px; font-size: 14px;" @onclick="CloseFilterPopover" title="Đóng">✕</button>
                        </div>
                    </div>
                    <div class="tf-filter-card">
                        <div class="tf-filter-header" style="font-weight: 600; font-size: 12.5px; margin-bottom: 8px; color: var(--tf-text-primary, #1e293b);">
                            <span class="tf-filter-title">Trạng thái</span>
                        </div>
                        <div class="tf-filter-body" style="display: flex; flex-direction: column; gap: 8px;">
                            <label class="tf-filter-option @(_statusFilter == null ? "selected" : "")" @onclick="() => SetStatusFilter(null)" style="cursor: pointer; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--tf-text-primary, #1e293b);">
                                <input type="radio" name="whStatus" checked="@(_statusFilter == null)" />
                                <span>Tất cả</span>
                                <span class="tf-filter-count" style="margin-left: auto; color: var(--tf-text-muted, #64748b); font-size: 12px;">@(_items?.Count ?? 0)</span>
                            </label>
                            <label class="tf-filter-option @(_statusFilter == true ? "selected" : "")" @onclick="() => SetStatusFilter(true)" style="cursor: pointer; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--tf-text-primary, #1e293b);">
                                <input type="radio" name="whStatus" checked="@(_statusFilter == true)" />
                                <span>Đang hoạt động</span>
                                <span class="tf-filter-count" style="margin-left: auto; color: var(--tf-text-muted, #64748b); font-size: 12px;">@(_items?.Count(p => p.IsActive) ?? 0)</span>
                            </label>
                            <label class="tf-filter-option @(_statusFilter == false ? "selected" : "")" @onclick="() => SetStatusFilter(false)" style="cursor: pointer; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--tf-text-primary, #1e293b);">
                                <input type="radio" name="whStatus" checked="@(_statusFilter == false)" />
                                <span>Ngừng hoạt động</span>
                                <span class="tf-filter-count" style="margin-left: auto; color: var(--tf-text-muted, #64748b); font-size: 12px;">@(_items?.Count(p => !p.IsActive) ?? 0)</span>
                            </label>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="tf-page-actions">
        <AuthorizeView Policy="Permission:Warehouses:Create">
            <button type="button" class="tf-btn tf-btn-primary" @onclick="OpenCreateWarehouseModal" style="display: inline-flex; align-items: center; gap: 6px; height: 36px; white-space: nowrap;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                <span>Thêm kho hàng</span>
            </button>
        </AuthorizeView>
    </div>
</div>

<div class="tf-card">
    <div class="tf-card-body" style="padding:0; overflow-x: auto;">
        
@if (_selectedItems.Count > 0)
{
    <div class="tf-bulk-actions-bar tw-bg-blue-50/80 tw-border tw-border-blue-200 tw-p-3.5 tw-rounded-lg tw-mb-4 tw-flex tw-justify-between tw-items-center tw-shadow-xs">
        <span class="tw-text-blue-900 tw-font-medium tw-text-sm">Đã chọn @_selectedItems.Count bản ghi</span>
        <AuthorizeView Policy="Permission:Warehouses:Delete">
            <button type="button" class="tf-btn tf-btn-sm tf-btn-danger" @onclick="ConfirmBulkDelete">Xóa đã chọn</button>
        </AuthorizeView>
    </div>
}

<TfModal IsOpen="@_showBulkDeleteModal"
         Title="@($"Xóa {_selectedItems.Count} bản ghi đã chọn?")"
         Size="md"
         OnClose="CancelBulkDelete">
    <BodyContent>
        <p class="tw-text-slate-600 tw-mb-4">Hành động này không thể hoàn tác. Các bản ghi đang được sử dụng sẽ bị bỏ qua hoặc vô hiệu hóa thay vì xóa hoàn toàn.</p>
        @if (_bulkDeleteErrors.Count > 0)
        {
            <div class="tf-alert tf-alert-error tw-mb-4 tw-max-h-36 tw-overflow-y-auto">
                <ul class="tw-m-0 tw-pl-5">
                    @foreach (var err in _bulkDeleteErrors)
                    {
                        <li>@err</li>
                    }
                </ul>
            </div>
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="tf-btn tf-btn-secondary" @onclick="CancelBulkDelete">Hủy</button>
        <LoadingButton Variant="danger"
                       IsLoading="@_isBulkDeleting"
                       LoadingText="Đang xử lý..."
                       Text="Xóa tất cả"
                       OnClick="ExecuteBulkDelete" />
    </FooterContent>
</TfModal>

@if (_items == null)
{
    <Skeleton Type="table" Rows="6" Columns="9" />
}
else
{
    <div class="tf-table-loading-container">
        <TableLoadingOverlay Visible="@_isRefreshing" Message="Đang cập nhật..." />
        <table class="tf-table">
            <thead>
                <tr>
                    <th style="width: 40px; text-align: center;"><input type="checkbox" @onchange="ToggleSelectAll" checked="@(FilteredItems.Any() && _selectedItems.Count == FilteredItems.Count())" /></th>
                    <th style="min-width: 120px;">Mã kho</th>
                    <th style="min-width: 110px;">Mã nội bộ</th>
                    <th style="min-width: 180px;">Tên kho</th>
                    <th style="min-width: 220px;">Địa chỉ</th>
                    <th>Người phụ trách</th>
                    <th>Điện thoại</th>
                    <th style="text-align:center;">Trạng thái</th>
                    <th style="text-align:right;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!FilteredItems.Any())
                {
                    <tr><td colspan="9"><div class="tf-empty"><div class="tf-empty-title">Chưa có kho hàng phù hợp</div></div></td></tr>
                }
                else
                {
                    foreach (var item in PagedItems)
                    {
                        <tr>
                            <td style="text-align: center;"><input type="checkbox" @onchange="@(e => ToggleSelect(item.Id, e))" checked="@(_selectedItems.Contains(item.Id))" /></td>
                            <td>
                                <span class="tw-font-mono tw-font-semibold tw-text-indigo-700 tw-bg-indigo-50/70 tw-px-2 tw-py-0.5 tw-rounded tw-text-xs">@item.Code</span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.BusinessCode))
                                {
                                    <TfBadge Variant="info" Text="@item.BusinessCode" />
                                }
                                else
                                {
                                    <span class="tw-text-slate-400">-</span>
                                }
                            </td>
                            <td class="tw-font-medium tw-text-slate-900">@item.Name</td>
                            <td class="tw-text-slate-600">@(item.Address ?? "-")</td>
                            <td class="tw-text-slate-700">@(item.ManagerName ?? "-")</td>
                            <td class="tw-text-slate-600">@(item.Phone ?? "-")</td>
                            <td style="text-align:center;">
                                <TfBadge Variant="@(item.IsActive ? "success" : "gray")"
                                         Dot="true"
                                         Text="@(item.IsActive ? "Hoạt động" : "Tạm dừng")" />
                            </td>
                            <td style="text-align:right;">
                                <div class="tw-inline-flex tw-gap-1">
                                    <AuthorizeView Policy="Permission:Warehouses:Edit">
                                        <button type="button" class="tf-btn tf-btn-ghost tf-btn-sm" @onclick="() => OpenEditWarehouseModal(item.Id)">Sửa</button>
                                    </AuthorizeView>
                                    <AuthorizeView Policy="Permission:Warehouses:Delete">
                                        <button class="tf-btn tf-btn-ghost tf-btn-sm tw-text-red-600 hover:tw-bg-red-50" @onclick="() => ConfirmDelete(item.Id, item.Name ?? string.Empty)">Xóa</button>
                                    </AuthorizeView>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        
        @if (FilteredItems.Any())
        {
            <TfPagination CurrentPage="@_currentPage"
                          PageSize="@_pageSize"
                          TotalCount="@FilteredItems.Count()"
                          ItemName="kho hàng"
                          PreferenceKey="warehouses"
                          CurrentPageChanged="@(p => _currentPage = p)"
                          PageSizeChanged="@(s => { _pageSize = s; _currentPage = 1; })" />
        }
    </div>
}
            </div>
        </div>

<TfModal IsOpen="@(_itemToDeleteId != null)"
         Title="Xóa dữ liệu?"
         Size="sm"
         OnClose="CancelDelete">
    <BodyContent>
        <p class="tw-text-slate-600 tw-mb-4">Bạn có chắc chắn muốn xóa "<strong>@(_itemToDeleteName)</strong>"?</p>
        @if (!string.IsNullOrEmpty(_deleteError))
        {
            <div class="tf-alert tf-alert-error tw-mb-3">
                @_deleteError
            </div>
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="tf-btn tf-btn-secondary" @onclick="CancelDelete">Hủy</button>
        <LoadingButton Variant="danger"
                       IsLoading="@_isDeleting"
                       LoadingText="Đang xóa..."
                       Text="Xóa"
                       OnClick="ExecuteDelete" />
    </FooterContent>
</TfModal>

<WarehouseFormModal @bind-IsOpen="_showWarehouseModal"
                    WarehouseId="_selectedWarehouseEditId"
                    OnSaved="HandleWarehouseSaved" />

@code {
    private bool _showWarehouseModal = false;
    private int? _selectedWarehouseEditId;

    private void OpenCreateWarehouseModal()
    {
        _selectedWarehouseEditId = null;
        _showWarehouseModal = true;
    }

    private void OpenEditWarehouseModal(int id)
    {
        _selectedWarehouseEditId = id;
        _showWarehouseModal = true;
    }

    private async Task HandleWarehouseSaved(Warehouse wh)
    {
        await LoadWarehousesAsync();
    }

    private int? _itemToDeleteId;
    private string _itemToDeleteName = "";
    private string? _deleteError;

    private List<Warehouse>? _items;
    private string _searchTerm = string.Empty;
    private bool? _statusFilter;
    private bool _showFilterPopover = false;
    private bool _isRefreshing = false;
    private bool _isDeleting = false;

    private void ToggleFilterPopover() => _showFilterPopover = !_showFilterPopover;
    private void CloseFilterPopover() => _showFilterPopover = false;
    private void HandleFilterKeyDown(KeyboardEventArgs e) { if (e.Key == "Escape") _showFilterPopover = false; }

    private bool HasActiveFilters => !string.IsNullOrEmpty(_searchTerm) || _statusFilter.HasValue;

    protected override async Task OnInitializedAsync()
    {
        await LoadWarehousesAsync();
    }

    private async Task LoadWarehousesAsync()
    {
        if (_isRefreshing) return;
        _isRefreshing = true;
        try
        {
            await using var db = await DbContextFactory.CreateDbContextAsync();
            _items = await db.Warehouses
                .AsNoTracking()
                .OrderBy(x => x.Code)
                .ToListAsync();
        }
        finally
        {
            _isRefreshing = false;
        }
    }

    private int _currentPage = 1;
    private int _pageSize = 20;

    private void OnSearchChanged(string val)
    {
        _searchTerm = val;
        _currentPage = 1;
    }

    private void SetStatusFilter(bool? status)
    {
        _statusFilter = status;
        _currentPage = 1;
    }

    private void ClearAllFilters()
    {
        _searchTerm = string.Empty;
        _statusFilter = null;
        _currentPage = 1;
        _showFilterPopover = false;
    }

    private IEnumerable<Warehouse> FilteredItems
    {
        get
        {
            if (_items == null) return Enumerable.Empty<Warehouse>();

            var q = _items.AsEnumerable();

            if (_statusFilter.HasValue)
            {
                q = q.Where(x => x.IsActive == _statusFilter.Value);
            }

            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                var term = _searchTerm.Trim().ToLower();
                q = q.Where(x =>
                    (x.Code != null && x.Code.ToLower().Contains(term)) ||
                    (x.BusinessCode != null && x.BusinessCode.ToLower().Contains(term)) ||
                    (x.Name != null && x.Name.ToLower().Contains(term)) ||
                    (x.Address != null && x.Address.ToLower().Contains(term)) ||
                    (x.ManagerName != null && x.ManagerName.ToLower().Contains(term)) ||
                    (x.Phone != null && x.Phone.ToLower().Contains(term)));
            }

            return q;
        }
    }

    private IEnumerable<Warehouse> PagedItems =>
        FilteredItems.Skip((_currentPage - 1) * _pageSize).Take(_pageSize);

    private void ConfirmDelete(int id, string name)
    {
        _itemToDeleteId = id;
        _itemToDeleteName = name;
        _deleteError = null;
    }

    private void CancelDelete()
    {
        _itemToDeleteId = null;
        _deleteError = null;
    }

    private async Task ExecuteDelete()
    {
        if (_itemToDeleteId == null) return;
        
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!(await AuthService.AuthorizeAsync(authState.User, "Permission:Warehouses:Delete")).Succeeded)
        {
            _deleteError = "Bạn không có quyền thực hiện thao tác này.";
            return;
        }

        _isDeleting = true;
        try
        {
            int id = _itemToDeleteId.Value;
            await using (var db = await DbContextFactory.CreateDbContextAsync())
            {
                var entity = await db.Warehouses.FindAsync(id);
                if (entity == null)
                {
                    CancelDelete();
                    return;
                }

                bool isReferenced = false;

                if (isReferenced)
                {
                    entity.IsActive = false;
                }
                else
                {
                    db.Remove(entity);
                }

                await db.SaveChangesAsync();
            }

            await AuditService.LogAsync(TradeFlow.Domain.Enums.AuditEventType.WarehouseDeleted, authState.User.Identity?.Name ?? "System", "Warehouse", id.ToString(), "Xóa kho hàng", authState.User.Identity?.Name);
            CancelDelete();
            
            await LoadWarehousesAsync();
        }
        catch (Exception ex)
        {
            _deleteError = "Đã xảy ra lỗi: " + ex.Message;
        }
        finally
        {
            _isDeleting = false;
        }
    }

    private HashSet<int> _selectedItems = new();
    private bool _showBulkDeleteModal = false;
    private List<string> _bulkDeleteErrors = new();
    private bool _isBulkDeleting = false;

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        if (e.Value is bool isChecked && isChecked)
        {
            _selectedItems = new HashSet<int>(FilteredItems.Select(x => x.Id));
        }
        else
        {
            _selectedItems.Clear();
        }
    }

    private void ToggleSelect(int id, ChangeEventArgs e)
    {
        if (e.Value is bool isChecked && isChecked)
        {
            _selectedItems.Add(id);
        }
        else
        {
            _selectedItems.Remove(id);
        }
    }

    private void ConfirmBulkDelete()
    {
        _bulkDeleteErrors.Clear();
        _showBulkDeleteModal = true;
    }

    private void CancelBulkDelete()
    {
        _showBulkDeleteModal = false;
        _isBulkDeleting = false;
    }

    private async Task ExecuteBulkDelete()
    {
        if (_selectedItems.Count == 0) return;
        _isBulkDeleting = true;
        _bulkDeleteErrors.Clear();
        StateHasChanged();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!(await AuthService.AuthorizeAsync(authState.User, "Permission:Warehouses:Delete")).Succeeded)
        {
            _bulkDeleteErrors.Add("Bạn không có quyền thực hiện thao tác này.");
            _isBulkDeleting = false;
            return;
        }

        try
        {
            int successCount = 0;
            var idsToProcess = _selectedItems.ToList();
            
            foreach (var id in idsToProcess)
            {
                _itemToDeleteId = id; // reuse the id for the logic block
                try 
                {
                    await ProcessSingleDelete(id);
                    _selectedItems.Remove(id);
                    successCount++;
                } 
                catch (Exception ex)
                {
                    _bulkDeleteErrors.Add($"Bản ghi ID {id}: {ex.Message}");
                }
            }

            if (successCount > 0)
            {
                await LoadWarehousesAsync();
            }
            
            if (_selectedItems.Count == 0)
            {
                CancelBulkDelete();
            }
        }
        finally
        {
            _isBulkDeleting = false;
            _itemToDeleteId = null;
            StateHasChanged();
        }
    }

    private async Task ProcessSingleDelete(int currentId)
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        int id = _itemToDeleteId.Value;
        await using (var db = await DbContextFactory.CreateDbContextAsync())
        {
            var entity = await db.Warehouses.FindAsync(id);
            if (entity == null)
            {
                return;
            }

            bool isReferenced = false;

            if (isReferenced)
            {
                entity.IsActive = false;
            }
            else
            {
                db.Remove(entity);
            }

            await db.SaveChangesAsync();
        }
        await AuditService.LogAsync(TradeFlow.Domain.Enums.AuditEventType.WarehouseDeleted, authState.User.Identity?.Name ?? "System", "Warehouse", id.ToString(), "Xóa kho hàng", authState.User.Identity?.Name);
    }
}
