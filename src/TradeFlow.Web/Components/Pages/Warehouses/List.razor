@page "/kho/kho-hang"
@page "/kho-hang"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Domain.Entities.MasterData
@using TradeFlow.Infrastructure.Persistence
@attribute [Authorize(Policy = "Permission:Warehouses:View")]

@inject TradeFlowDbContext DbContext
@inject NavigationManager Nav
@inject IAuthorizationService AuthService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject IAuditService AuditService

<PageTitle>Kho hàng - TradeFlow</PageTitle>

<div class="tf-page-header">
    <div class="tf-page-header-left">
        <h1 class="tf-page-title">Kho hàng</h1>
        <p class="tf-page-subtitle">Danh sách kho bãi, địa điểm lưu trữ và thủ kho quản lý</p>
    </div>
    <div class="tf-page-actions">
        <AuthorizeView Policy="Permission:Warehouses:Create">
            <a href="/kho/kho-hang/them-moi" class="tf-btn tf-btn-primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                Thêm kho hàng
            </a>
        </AuthorizeView>
    </div>
</div>

<div class="tf-card tf-mb-4" style="padding: 12px 16px;">
    <input type="text"
           class="tf-input"
           placeholder="Tìm theo mã kho, mã nội bộ, tên kho, địa chỉ, người phụ trách..."
           value="@_searchTerm"
           @oninput="OnSearchInput" />
</div>

<div class="tf-card">
    <div class="tf-card-body" style="padding:0; overflow-x: auto;">
        <table class="tf-table">
            <thead>
                <tr>
                    <th style="min-width: 120px;">Mã kho</th>
                    <th style="min-width: 110px;">Mã nội bộ</th>
                    <th style="min-width: 180px;">Tên kho</th>
                    <th style="min-width: 220px;">Địa chỉ</th>
                    <th>Người phụ trách</th>
                    <th>Điện thoại</th>
                    <th style="text-align:center;">Trạng thái</th>
                    <th style="text-align:right;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (_items == null)
                {
                    <tr><td colspan="8" style="text-align:center; padding: 24px;">Đang tải dữ liệu...</td></tr>
                }
                else if (!FilteredItems.Any())
                {
                    <tr><td colspan="8"><div class="tf-empty"><div class="tf-empty-title">Chưa có kho hàng phù hợp</div></div></td></tr>
                }
                else
                {
                    foreach (var item in FilteredItems)
                    {
                        <tr>
                            <td>
                                <span style="font-family: monospace; font-weight: 600; color: var(--tf-primary);">@item.Code</span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.BusinessCode))
                                {
                                    <span class="tf-badge tf-badge-info">@item.BusinessCode</span>
                                }
                                else
                                {
                                    <span style="color:var(--tf-text-muted);">-</span>
                                }
                            </td>
                            <td style="font-weight: 500;">@item.Name</td>
                            <td>@(item.Address ?? "-")</td>
                            <td>@(item.ManagerName ?? "-")</td>
                            <td>@(item.Phone ?? "-")</td>
                            <td style="text-align:center;">
                                @if (item.IsActive)
                                {
                                    <span class="tf-badge tf-badge-success">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="tf-badge tf-badge-neutral">Tạm dừng</span>
                                }
                            </td>
                            <td style="text-align:right;">
                                <AuthorizeView Policy="Permission:Warehouses:Edit">
                                    <a href="/kho/kho-hang/sua/@item.Id" class="tf-btn tf-btn-ghost tf-btn-sm">Sửa</a>
                                </AuthorizeView>
                                <AuthorizeView Policy="Permission:Warehouses:Delete">
                                    <button class="tf-btn tf-btn-ghost tf-btn-sm" style="color:var(--tf-danger);" @onclick="() => ConfirmDelete(item.Id, item.Name ?? string.Empty)">Xóa</button>
                                </AuthorizeView>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>


@if (_itemToDeleteId != null)
{
    <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center;">
        <div style="background: white; padding: 24px; border-radius: 8px; width: 400px; max-width: 90%; box-shadow: 0 10px 25px rgba(0,0,0,0.2);">
            <h3 style="margin-top: 0; margin-bottom: 16px; font-size: 18px; color: var(--tf-danger);">Xóa dữ liệu?</h3>
            <p style="margin-bottom: 24px;">Bạn có chắc chắn muốn xóa @_itemToDeleteName?</p>
            @if (!string.IsNullOrEmpty(_deleteError))
            {
                <div class="tf-alert tf-alert-danger" style="margin-bottom: 16px;">
                    @_deleteError
                </div>
            }
            <div style="display: flex; justify-content: flex-end; gap: 12px;">
                <button type="button" class="tf-btn tf-btn-outline-secondary" @onclick="CancelDelete">Hủy</button>
                <button type="button" class="tf-btn tf-btn-danger" @onclick="ExecuteDelete">Xóa</button>
            </div>
        </div>
    </div>
}

@code {
    private int? _itemToDeleteId;
    private string _itemToDeleteName = "";
    private string? _deleteError;

    private List<Warehouse>? _items;
    private string _searchTerm = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _items = await DbContext.Warehouses
            .OrderBy(x => x.Code)
            .ToListAsync();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? string.Empty;
    }

    private IEnumerable<Warehouse> FilteredItems
    {
        get
        {
            if (_items == null) return Enumerable.Empty<Warehouse>();

            if (string.IsNullOrWhiteSpace(_searchTerm))
            {
                return _items;
            }

            var term = _searchTerm.Trim().ToLower();
            return _items.Where(x =>
                (x.Code != null && x.Code.ToLower().Contains(term)) ||
                (x.BusinessCode != null && x.BusinessCode.ToLower().Contains(term)) ||
                (x.Name != null && x.Name.ToLower().Contains(term)) ||
                (x.Address != null && x.Address.ToLower().Contains(term)) ||
                (x.ManagerName != null && x.ManagerName.ToLower().Contains(term)) ||
                (x.Phone != null && x.Phone.ToLower().Contains(term)));
        }
    }

    private void ConfirmDelete(int id, string name)
    {
        _itemToDeleteId = id;
        _itemToDeleteName = name;
        _deleteError = null;
    }

    private void CancelDelete()
    {
        _itemToDeleteId = null;
        _deleteError = null;
    }

    private async Task ExecuteDelete()
    {
        if (_itemToDeleteId == null) return;
        
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!(await AuthService.AuthorizeAsync(authState.User, "Permission:Warehouses:Delete")).Succeeded)
        {
            _deleteError = "Bạn không có quyền thực hiện thao tác này.";
            return;
        }

        try
        {
            int id = _itemToDeleteId.Value;
            var entity = await DbContext.Warehouses.FindAsync(id);
            if (entity == null)
            {
                CancelDelete();
                return;
            }

            bool isReferenced = false;

            if (isReferenced)
            {
                entity.IsActive = false;
            }
            else
            {
                DbContext.Remove(entity);
            }

            await DbContext.SaveChangesAsync();
            await AuditService.LogAsync(TradeFlow.Domain.Enums.AuditEventType.WarehouseDeleted, authState.User.Identity?.Name ?? "System", "Warehouse", id.ToString(), "Xóa kho hàng", authState.User.Identity?.Name);
            CancelDelete();
            
            await OnInitializedAsync();
        }
        catch (Exception ex)
        {
            _deleteError = "Đã xảy ra lỗi: " + ex.Message;
        }
    }
}
