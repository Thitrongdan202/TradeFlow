                                            <span class="tw-font-bold @(item.Quantity <= 0 ? "tw-text-rose-600" : (item.Quantity < 15 ? "tw-text-amber-600" : "tw-text-slate-900"))">
                                                @item.Quantity.ToString("N0")
                                            </span>
                                            <span class="tw-text-xs tw-text-slate-400 tw-ml-1">@item.UnitName</span>
                                        </td>
                                        <td class="tw-p-3" style="text-align: right;">
                                            <span class="tw-text-slate-600">@unitCost.ToString("N0")</span>
                                        </td>
                                        <td class="tw-p-3" style="text-align: right;">
                                            <span class="tw-font-bold tw-text-purple-700">@totalVal.ToString("N0") đ</span>
                                        </td>
                                        <td class="tw-p-3" style="text-align: right;">
                                            <a href="/kho/the-kho?warehouseId=@item.WarehouseId&productId=@item.ProductId" class="tw-inline-flex tw-items-center tw-gap-1 tw-text-xs tw-font-semibold tw-text-blue-600 hover:tw-text-blue-800 hover:tw-underline" title="Xem lịch sử biến động thẻ kho">
                                                <span>Thẻ kho</span>
                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (TotalPages > 1)
                {
                    <div class="tw-p-3 tw-border-t tw-border-slate-100 tw-flex tw-justify-between tw-items-center tw-text-xs">
                        <span class="tw-text-slate-500">Trang @_currentPage / @TotalPages</span>
                        <div class="tw-flex tw-gap-1">
                            <button class="tw-px-2.5 tw-py-1 tw-rounded-md tw-border tw-border-slate-200 hover:tw-bg-slate-50 disabled:tw-opacity-50 tw-font-medium" disabled="@(_currentPage == 1)" @onclick="() => _currentPage--">
                                Trước
                            </button>
                            <button class="tw-px-2.5 tw-py-1 tw-rounded-md tw-border tw-border-slate-200 hover:tw-bg-slate-50 disabled:tw-opacity-50 tw-font-medium" disabled="@(_currentPage >= TotalPages)" @onclick="() => _currentPage++">
                                Tiếp
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}
