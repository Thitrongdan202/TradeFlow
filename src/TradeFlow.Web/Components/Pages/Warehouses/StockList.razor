                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                    </div>
                    <div class="tw-text-xs tw-text-slate-500">
                        Hiển thị <strong>@FilteredItems.Count()</strong> bản ghi
                    </div>
                </div>

                <div class="tw-overflow-x-auto">
                    <table class="tf-table tw-w-full">
                        <thead>
                            <tr class="tw-bg-slate-50 tw-border-b tw-border-slate-200 tw-text-left tw-text-xs tw-font-bold tw-text-slate-600 tw-uppercase tw-tracking-wider">
                                <th class="tw-p-3" style="min-width: 110px;">Mã SP</th>
                                <th class="tw-p-3" style="min-width: 200px;">Tên sản phẩm</th>
