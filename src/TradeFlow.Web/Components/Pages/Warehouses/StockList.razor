@page "/kho/ton-kho"
@page "/kho"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Application.Common.Models.Warehouse
@using TradeFlow.Domain.Entities.MasterData
@using TradeFlow.Domain.Entities.Warehouses
@using TradeFlow.Domain.Enums
@using TradeFlow.Infrastructure.Persistence
@attribute [Authorize(Policy = "Permission:Warehouses:View")]

@inject IWarehouseService WarehouseService
@inject IDbContextFactory<TradeFlowDbContext> DbContextFactory
@inject NavigationManager Nav
@inject IAuditService AuditService
@inject IJSRuntime JS

<PageTitle>Báo cáo Tồn kho &amp; Tổng quan Đa kho — TradeFlow</PageTitle>

<WarehouseNavTabs ActiveTab="stock" />

<div class="tf-page-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 16px;">
    <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">
        <div>
            <h1 class="tf-page-title" style="margin: 0; font-size: 20px;">Tồn kho thực tế &amp; Tổng quan Đa kho</h1>
            <p class="tf-page-subtitle" style="margin: 2px 0 0; font-size: 12px;">Số dư tồn kho chi tiết, phẩm chất hàng hóa và đối chiếu số lượng giữa các kho bãi LACASA</p>
        </div>
    </div>
    <div class="tf-page-actions tw-flex tw-gap-2">
        <a href="/api/warehouses/stock/export-excel@(BuildExportQuery())" target="_blank" class="tf-btn tf-btn-secondary" style="display: inline-flex; align-items: center; gap: 6px; height: 36px; white-space: nowrap;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="7 10 12 15 17 10"/>
                <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            <span>Xuất Excel tồn kho</span>
        </a>
        <AuthorizeView Policy="Permission:Warehouses:Create">
            <a href="/kho/phieu-kho" class="tf-btn tf-btn-secondary" style="display: inline-flex; align-items: center; gap: 6px; height: 36px; white-space: nowrap;">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>
                </svg>
                <span>Phiếu kho</span>
            </a>
            <a href="/kho/kiem-kho" class="tf-btn tf-btn-primary" style="display: inline-flex; align-items: center; gap: 6px; height: 36px; white-space: nowrap;">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                </svg>
                <span>Đợt kiểm kê mới</span>
            </a>
        </AuthorizeView>
    </div>
</div>

<!-- KPI Cards: Do NOT sum heterogeneous units of measure -->
<div class="tw-grid tw-grid-cols-1 sm:tw-grid-cols-2 lg:tw-grid-cols-4 tw-gap-4 tw-mb-4">
    <!-- Card 1: Kho hàng hoạt động -->
    <div class="tw-bg-white tw-border tw-border-slate-200 tw-rounded-xl tw-p-4 tw-shadow-2xs tw-transition-all tw-duration-200 hover:-tw-translate-y-0.5 hover:tw-shadow-sm">
        <div class="tw-flex tw-justify-between tw-items-center tw-mb-1.5">
            <span class="tw-text-xs tw-font-bold tw-text-slate-500 tw-uppercase tw-tracking-wide">Kho đang hoạt động</span>
            <div class="tw-w-8 tw-h-8 tw-rounded-lg tw-bg-blue-50 tw-flex tw-items-center tw-justify-center tw-text-blue-600 tw-border tw-border-blue-100/60">
                <svg class="tw-w-4 tw-h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
            </div>
        </div>
        <div class="tw-text-2xl tw-font-bold tw-text-slate-900">@(_warehouses.Count(w => w.IsActive)) <span class="tw-text-xs tw-font-semibold tw-text-slate-500">/ @_warehouses.Count kho</span></div>
        <div class="tw-text-xs tw-text-slate-500 tw-mt-1">Mạng lưới kho bãi phân phối</div>
    </div>

    <!-- Card 2: Tổng số mã hàng (SKU) -->
    <div class="tw-bg-white tw-border tw-border-slate-200 tw-rounded-xl tw-p-4 tw-shadow-2xs tw-transition-all tw-duration-200 hover:-tw-translate-y-0.5 hover:tw-shadow-sm">
        <div class="tw-flex tw-justify-between tw-items-center tw-mb-1.5">
            <span class="tw-text-xs tw-font-bold tw-text-emerald-700 tw-uppercase tw-tracking-wide">Mặt hàng (SKU) lưu kho</span>
            <div class="tw-w-8 tw-h-8 tw-rounded-lg tw-bg-emerald-50 tw-flex tw-items-center tw-justify-center tw-text-emerald-600 tw-border tw-border-emerald-100/60">
                <svg class="tw-w-4 tw-h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                </svg>
            </div>
        </div>
        <div class="tw-text-2xl tw-font-bold tw-text-emerald-700">@(_items.Where(i => i.Quantity > 0).Select(i => i.ProductId).Distinct().Count())</div>
        <div class="tw-text-xs tw-text-slate-500 tw-mt-1">Số mã sản phẩm đang có số dư tồn > 0</div>
    </div>

    <!-- Card 3: Cảnh báo tồn thấp -->
    <div class="tw-bg-white tw-border tw-border-slate-200 tw-rounded-xl tw-p-4 tw-shadow-2xs tw-transition-all tw-duration-200 hover:-tw-translate-y-0.5 hover:tw-shadow-sm">
        <div class="tw-flex tw-justify-between tw-items-center tw-mb-1.5">
            <span class="tw-text-xs tw-font-bold tw-text-amber-700 tw-uppercase tw-tracking-wide">Cảnh báo tồn thấp (&lt; 15)</span>
            <div class="tw-w-8 tw-h-8 tw-rounded-lg tw-bg-amber-50 tw-flex tw-items-center tw-justify-center tw-text-amber-600 tw-border tw-border-amber-100/60">
                <svg class="tw-w-4 tw-h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
            </div>
        </div>
        <div class="tw-text-2xl tw-font-bold tw-text-amber-700">@(_items.Where(i => i.Condition == StockCondition.Saleable && i.Quantity > 0 && i.Quantity < 15).Select(i => i.ProductId).Distinct().Count()) <span class="tw-text-xs tw-font-normal tw-text-amber-600">SKU</span></div>
        <div class="tw-text-xs tw-text-slate-500 tw-mt-1">Cần lập kế hoạch nhập bổ sung</div>
    </div>

    <!-- Card 4: Tổng giá trị tồn kho -->
    <div class="tw-bg-white tw-border tw-border-slate-200 tw-rounded-xl tw-p-4 tw-shadow-2xs tw-transition-all tw-duration-200 hover:-tw-translate-y-0.5 hover:tw-shadow-sm">
        <div class="tw-flex tw-justify-between tw-items-center tw-mb-1.5">
            <span class="tw-text-xs tw-font-bold tw-text-purple-700 tw-uppercase tw-tracking-wide">Tổng giá trị tồn ước tính</span>
            <div class="tw-w-8 tw-h-8 tw-rounded-lg tw-bg-purple-50 tw-flex tw-items-center tw-justify-center tw-text-purple-600 tw-border tw-border-purple-100/60">
                <svg class="tw-w-4 tw-h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
        </div>
        <div class="tw-text-2xl tw-font-bold tw-text-purple-700">@(_totalStockValue.ToString("N0")) đ</div>
        <div class="tw-text-xs tw-text-slate-500 tw-mt-1">Theo giá vốn bình quân kiểm toán</div>
    </div>
</div>

<!-- Multi-Warehouse Overview Cards Section -->
<div class="tw-bg-white tw-border tw-border-slate-200 tw-rounded-xl tw-p-4 tw-mb-4 tw-shadow-2xs">
    <div class="tw-flex tw-justify-between tw-items-center tw-mb-3.5">
        <div>
            <h2 class="tw-text-sm tw-font-bold tw-text-slate-800 tw-uppercase tw-tracking-wider tw-flex tw-items-center tw-gap-2">
                <svg class="tw-w-4 tw-h-4 tw-text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
                <span>Tổng quan các kho hàng trong hệ thống (@_warehouseOverviews.Count kho)</span>
            </h2>
            <p class="tw-text-xs tw-text-slate-500 tw-mt-0.5">Nhấp vào kho để lọc danh mục sản phẩm và kiểm tra số dư tồn kho của kho đó</p>
        </div>
        @if (_selectedWarehouseId.HasValue)
        {
            <button type="button" class="tw-text-xs tw-font-semibold tw-text-blue-700 hover:tw-text-blue-900 tw-flex tw-items-center tw-gap-1 tw-bg-blue-50 tw-border tw-border-blue-200 tw-px-3 tw-py-1.5 tw-rounded-lg tw-transition-colors" @onclick="() => SelectWarehouse(null)">
                <span>Đang lọc: @_warehouses.FirstOrDefault(w => w.Id == _selectedWarehouseId)?.Name</span>
                <span class="tw-font-bold ms-1">× Bỏ lọc</span>
            </button>
        }
    </div>

    <div class="tw-grid tw-grid-cols-1 @(_warehouseOverviews.Count == 2 ? "md:tw-grid-cols-2" : (_warehouseOverviews.Count == 1 ? "md:tw-grid-cols-1" : "md:tw-grid-cols-2 lg:tw-grid-cols-3")) tw-gap-3.5">
        @foreach (var wh in _warehouseOverviews)
        {
            var isSelected = _selectedWarehouseId == wh.WarehouseId;
            <div class="tf-wh-card @(isSelected ? "is-selected" : "") tf-card-interactive">
                <div class="tw-flex tw-justify-between tw-items-start tw-mb-2.5">
                    <div>
                        <div class="tw-flex tw-items-center tw-gap-2">
                            <span class="tw-font-bold tw-text-sm sm:tw-text-base tw-text-slate-900">@wh.WarehouseName</span>
                            <span class="tw-font-mono tw-text-2xs tw-font-bold tw-bg-slate-100 tw-text-slate-700 tw-border tw-border-slate-200 tw-px-1.5 tw-py-0.5 tw-rounded">@wh.WarehouseCode</span>
                        </div>
                        <div class="tw-text-xs tw-text-slate-500 tw-mt-1 tw-flex tw-items-center tw-gap-1 tw-truncate" title="@wh.Address">
                            <svg class="tw-w-3.5 tw-h-3.5 tw-text-slate-400 tw-flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                            <span class="tw-truncate">@(string.IsNullOrEmpty(wh.Address) ? "Chưa cập nhật địa chỉ" : wh.Address)</span>
                        </div>
                    </div>
                    <span class="tw-inline-flex tw-items-center tw-px-2.5 tw-py-0.5 tw-rounded-full tw-text-2xs tw-font-semibold @(wh.IsActive ? "tw-bg-emerald-50 tw-text-emerald-700 tw-border tw-border-emerald-200" : "tw-bg-slate-100 tw-text-slate-600 tw-border tw-border-slate-200")">
                        @(wh.IsActive ? "Đang hoạt động" : "Tạm ngưng")
                    </span>
                </div>

                <div class="tw-grid tw-grid-cols-2 tw-gap-2.5 tw-py-2.5 tw-border-t tw-border-b tw-border-slate-100 tw-my-2.5 tw-text-xs">
                    <div class="tw-bg-slate-50/70 tw-p-2 tw-rounded-md">
                        <div class="tw-text-slate-500 tw-text-2xs">Mặt hàng lưu:</div>
                        <div class="tw-font-bold tw-text-slate-800 tw-text-sm tw-mt-0.5">@wh.DistinctSkuCount <span class="tw-font-normal tw-text-xs tw-text-slate-500">SKU</span></div>
                    </div>
                    <div class="tw-bg-slate-50/70 tw-p-2 tw-rounded-md">
                        <div class="tw-text-slate-500 tw-text-2xs">Tồn thấp (&lt; 15):</div>
                        <div class="tw-font-bold @(wh.LowStockSkuCount > 0 ? "tw-text-amber-600" : "tw-text-slate-800") tw-text-sm tw-mt-0.5">@wh.LowStockSkuCount <span class="tw-font-normal tw-text-xs tw-text-slate-500">SKU</span></div>
                    </div>
                    <div class="tw-bg-slate-50/70 tw-p-2 tw-rounded-md">
                        <div class="tw-text-slate-500 tw-text-2xs">Hàng lỗi / Cách ly:</div>
                        <div class="tw-font-bold @(wh.DefectiveItemCount > 0 ? "tw-text-rose-600" : "tw-text-slate-800") tw-text-sm tw-mt-0.5">@wh.DefectiveItemCount <span class="tw-font-normal tw-text-xs tw-text-slate-500">SP</span></div>
                    </div>
                    <div class="tw-bg-slate-50/70 tw-p-2 tw-rounded-md">
                        <div class="tw-text-slate-500 tw-text-2xs">Tổng giá trị tồn:</div>
                        <div class="tw-font-bold tw-text-purple-700 tw-text-sm tw-mt-0.5">@wh.TotalValuation.ToString("N0") <span class="tw-font-normal tw-text-xs tw-text-purple-500">đ</span></div>
                    </div>
                </div>

                <div class="tw-flex tw-justify-between tw-items-center tw-text-2xs tw-text-slate-400 tw-mt-1">
                    <span>Biến động gần nhất: <strong>@(wh.LatestMovementAt?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa có")</strong></span>
                    @if (isSelected)
                    {
                        <button type="button" class="tw-inline-flex tw-items-center tw-gap-1 tw-text-xs tw-font-bold tw-text-blue-700 tw-bg-blue-100/70 tw-px-3 tw-py-1.5 tw-rounded-md" @onclick="() => SelectWarehouse(null)">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                            <span>Đang chọn kho này</span>
                        </button>
                    }
                    else
                    {
                        <button type="button" class="tw-inline-flex tw-items-center tw-gap-1 tw-text-xs tw-font-semibold tw-text-blue-600 hover:tw-text-blue-800 hover:tw-bg-blue-50 tw-border tw-border-blue-200 tw-px-3 tw-py-1.5 tw-rounded-md tw-transition-colors" @onclick="() => SelectWarehouse(wh.WarehouseId)">
                            <span>Xem tồn kho</span>
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                        </button>
                    }
                </div>
            </div>
        }
    </div>
</div>

<!-- View Switcher Tabs (Segmented Control) -->
<div class="tw-flex tw-items-center tw-justify-between tw-mb-4 tw-border-b tw-border-slate-200 tw-pb-3">
    <div class="tf-segmented-tabs">
        <button type="button" class="tf-segmented-tab @(_activeView == "detail" ? "is-active" : "")"
                @onclick='() => SwitchStockView("detail")'>
            <svg class="tw-w-4 tw-h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
            </svg>
            <span>Tồn kho chi tiết theo kho</span>
            <span class="tw-ml-1.5 tw-text-2xs tw-px-1.5 tw-py-0.5 tw-rounded-full @(_activeView == "detail" ? "tw-bg-blue-100 tw-text-blue-700 tw-font-bold" : "tw-bg-slate-200/80 tw-text-slate-600")">@FilteredItems.Count()</span>
        </button>

        <button type="button" class="tf-segmented-tab @(_activeView == "matrix" ? "is-active" : "")"
                @onclick='() => SwitchStockView("matrix")'>
            <svg class="tw-w-4 tw-h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2" />
            </svg>
            <span>So sánh tồn kho đa kho (Ma trận)</span>
            <span class="tw-ml-1.5 tw-text-2xs tw-px-1.5 tw-py-0.5 tw-rounded-full @(_activeView == "matrix" ? "tw-bg-blue-100 tw-text-blue-700 tw-font-bold" : "tw-bg-slate-200/80 tw-text-slate-600")">@_matrixItems.Count</span>
        </button>
    </div>
</div>

<div id="stock-content-view">
@if (_activeView == "detail")
{
    <!-- ========================================== -->
    <!-- VIEW 1: TỒN KHO CHI TIẾT THEO KHO          -->
    <!-- ========================================== -->
    <div class="tw-grid tw-grid-cols-1 lg:tw-grid-cols-4 tw-gap-4">
        <!-- Filter Sidebar -->
        <div class="lg:tw-col-span-1">
            <div class="tw-bg-white tw-border tw-border-slate-200 tw-rounded-xl tw-p-4 tw-shadow-2xs tw-space-y-4">
                <div class="tw-flex tw-justify-between tw-items-center tw-border-b tw-border-slate-100 tw-pb-2.5">
                    <span class="tw-font-bold tw-text-sm tw-text-slate-800 tw-flex tw-items-center tw-gap-1.5">
                        <svg class="tw-w-4 tw-h-4 tw-text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
                        </svg>
                        <span>Bộ lọc tồn kho</span>
                    </span>
                    @if (HasActiveFilters)
                    {
                        <button class="tw-text-xs tw-font-semibold tw-text-blue-600 hover:tw-text-blue-800 hover:tw-underline" @onclick="ClearFilters">Xóa bộ lọc</button>
                    }
                </div>

                <!-- Warehouse Filter -->
                <div>
                    <label class="tw-block tw-text-xs tw-font-semibold tw-text-slate-700 tw-mb-1.5">Kho lưu trữ</label>
                    <select class="tf-custom-select tw-w-full" @bind="_selectedWarehouseId">
                        <option value="">-- Tất cả kho bãi --</option>
                        @foreach (var wh in _warehouses)
                        {
                            <option value="@wh.Id">@wh.Name (@wh.Code)</option>
                        }
                    </select>
                </div>

                <!-- Condition Filter -->
                <div>
                    <label class="tw-block tw-text-xs tw-font-semibold tw-text-slate-700 tw-mb-1.5">Phẩm chất hàng hóa</label>
                    <div class="tw-space-y-1">
                        <label class="tw-flex tw-items-center tw-gap-2.5 tw-text-sm tw-text-slate-700 tw-cursor-pointer tw-p-1.5 tw-rounded-lg hover:tw-bg-slate-50 tw-transition-colors">
                            <input type="radio" name="stockCond" class="tf-filter-radio" checked="@(_selectedCondition == null)" @onchange="() => _selectedCondition = null" />
                            <span>Tất cả phẩm chất</span>
                        </label>
                        <label class="tw-flex tw-items-center tw-gap-2.5 tw-text-sm tw-text-slate-700 tw-cursor-pointer tw-p-1.5 tw-rounded-lg hover:tw-bg-slate-50 tw-transition-colors">
                            <input type="radio" name="stockCond" class="tf-filter-radio" checked="@(_selectedCondition == StockCondition.Saleable)" @onchange="() => _selectedCondition = StockCondition.Saleable" />
                            <span class="tw-inline-block tw-w-2.5 tw-h-2.5 tw-rounded-full tw-bg-emerald-500"></span>
                            <span>Hàng tốt khả dụng</span>
                        </label>
                        <label class="tw-flex tw-items-center tw-gap-2.5 tw-text-sm tw-text-slate-700 tw-cursor-pointer tw-p-1.5 tw-rounded-lg hover:tw-bg-slate-50 tw-transition-colors">
                            <input type="radio" name="stockCond" class="tf-filter-radio" checked="@(_selectedCondition == StockCondition.Usable)" @onchange="() => _selectedCondition = StockCondition.Usable" />
                            <span class="tw-inline-block tw-w-2.5 tw-h-2.5 tw-rounded-full tw-bg-blue-500"></span>
                            <span>Hàng dùng được / Cũ</span>
                        </label>
                        <label class="tw-flex tw-items-center tw-gap-2.5 tw-text-sm tw-text-slate-700 tw-cursor-pointer tw-p-1.5 tw-rounded-lg hover:tw-bg-slate-50 tw-transition-colors">
