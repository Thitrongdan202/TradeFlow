@page "/kho/kiem-kho"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Application.Common.Models.Warehouse
@using TradeFlow.Domain.Entities.MasterData
@using TradeFlow.Domain.Enums
@using TradeFlow.Infrastructure.Persistence
@attribute [Authorize(Policy = "Permission:Warehouses:View")]

@inject IWarehouseService WarehouseService
@inject IDbContextFactory<TradeFlowDbContext> DbContextFactory
@inject NavigationManager Nav
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider

<PageTitle>Quản lý Kiểm kê Kho - TradeFlow</PageTitle>

<WarehouseNavTabs ActiveTab="stocktake" />

<div class="tf-page-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 16px;">
    <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">
        <div>
            <h1 class="tf-page-title" style="margin: 0; font-size: 20px;">Kiểm kê kho & Đối soát thực tế</h1>
            <p class="tf-page-subtitle" style="margin: 2px 0 0; font-size: 12px;">Quy trình kiểm kê định kỳ/đột xuất, ghi nhận số lượng thực tế, đối soát chênh lệch và tự động lập biên bản điều chỉnh</p>
        </div>
        <div style="width: 280px; max-width: 100%;">
            <input type="text"
                   class="tf-form-control tw-w-full tw-h-9 tw-px-3 tw-text-sm tw-rounded-md tw-border tw-border-slate-300 focus:tw-border-blue-500 focus:tw-outline-none"
                   placeholder="Tìm mã đợt kiểm kê, lý do..."
                   @bind="_searchTerm"
                   @bind:event="oninput" />
        </div>
    </div>
    <div class="tf-page-actions">
        <AuthorizeView Policy="Permission:Warehouses:Create">
            <button class="tf-btn tf-btn-primary" @onclick="OpenCreateModal" style="display: inline-flex; align-items: center; gap: 6px; height: 36px; white-space: nowrap;">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                <span>Tạo đợt kiểm kê mới</span>
            </button>
        </AuthorizeView>
    </div>
</div>

<!-- KPI Cards -->
<div class="tw-grid tw-grid-cols-1 sm:tw-grid-cols-2 lg:tw-grid-cols-4 tw-gap-4 tw-mb-4">
    <div class="tw-bg-white tw-border tw-border-slate-200 tw-rounded-lg tw-p-4 tw-shadow-xs">
        <div class="tw-text-xs tw-font-semibold tw-text-slate-500 tw-uppercase tw-mb-1">Tổng đợt kiểm kê</div>
        <div class="tw-text-2xl tw-font-bold tw-text-slate-900">@_sessions.Count</div>
        <div class="tw-text-xs tw-text-slate-500 tw-mt-1">Lịch sử kiểm kê toàn hệ thống</div>
    </div>
    <div class="tw-bg-white tw-border tw-border-slate-200 tw-rounded-lg tw-p-4 tw-shadow-xs">
        <div class="tw-text-xs tw-font-semibold tw-text-blue-600 tw-uppercase tw-mb-1">Đang kiểm đếm</div>
        <div class="tw-text-2xl tw-font-bold tw-text-blue-700">@_sessions.Count(s => s.Status == StocktakeStatus.Counting)</div>
        <div class="tw-text-xs tw-text-slate-500 tw-mt-1">Thủ kho đang đếm thực tế</div>
    </div>
    <div class="tw-bg-white tw-border tw-border-slate-200 tw-rounded-lg tw-p-4 tw-shadow-xs">
        <div class="tw-text-xs tw-font-semibold tw-text-amber-600 tw-uppercase tw-mb-1">Chờ phê duyệt</div>
        <div class="tw-text-2xl tw-font-bold tw-text-amber-700">@_sessions.Count(s => s.Status == StocktakeStatus.PendingReview)</div>
        <div class="tw-text-xs tw-text-slate-500 tw-mt-1">Chờ Quản lý đối soát và duyệt</div>
    </div>
    <div class="tw-bg-white tw-border tw-border-slate-200 tw-rounded-lg tw-p-4 tw-shadow-xs">
        <div class="tw-text-xs tw-font-semibold tw-text-emerald-600 tw-uppercase tw-mb-1">Đã xử lý xong</div>
        <div class="tw-text-2xl tw-font-bold tw-text-emerald-700">@_sessions.Count(s => s.Status == StocktakeStatus.Completed || s.Status == StocktakeStatus.Approved)</div>
        <div class="tw-text-xs tw-text-slate-500 tw-mt-1">Đã sinh phiếu điều chỉnh kho</div>
    </div>
</div>

<!-- Status Filter Tabs (Segmented Control) -->
<div class="tw-mb-4">
    <div class="tf-segmented-tabs">
        <button type="button" class="tf-segmented-tab @(_statusFilter == null ? "is-active" : "")"
                @onclick="() => _statusFilter = null">
            <span>Tất cả đợt kiểm kê</span>
            <span class="tw-ml-1.5 tw-text-2xs tw-px-1.5 tw-py-0.5 tw-rounded-full @(_statusFilter == null ? "tw-bg-blue-100 tw-text-blue-700 tw-font-bold" : "tw-bg-slate-200/80 tw-text-slate-600")">@_sessions.Count</span>
        </button>
        <button type="button" class="tf-segmented-tab @(_statusFilter == StocktakeStatus.Counting ? "is-active" : "")"
                @onclick="() => _statusFilter = StocktakeStatus.Counting">
            <span>Đang kiểm đếm</span>
            <span class="tw-ml-1.5 tw-text-2xs tw-px-1.5 tw-py-0.5 tw-rounded-full @(_statusFilter == StocktakeStatus.Counting ? "tw-bg-blue-100 tw-text-blue-700 tw-font-bold" : "tw-bg-slate-200/80 tw-text-slate-600")">@_sessions.Count(s => s.Status == StocktakeStatus.Counting)</span>
        </button>
        <button type="button" class="tf-segmented-tab @(_statusFilter == StocktakeStatus.PendingReview ? "is-active" : "")"
                @onclick="() => _statusFilter = StocktakeStatus.PendingReview">
            <span>Chờ Quản lý duyệt</span>
            <span class="tw-ml-1.5 tw-text-2xs tw-px-1.5 tw-py-0.5 tw-rounded-full @(_statusFilter == StocktakeStatus.PendingReview ? "tw-bg-amber-100 tw-text-amber-800 tw-font-bold" : "tw-bg-slate-200/80 tw-text-slate-600")">@_sessions.Count(s => s.Status == StocktakeStatus.PendingReview)</span>
        </button>
        <button type="button" class="tf-segmented-tab @(_statusFilter == StocktakeStatus.Completed ? "is-active" : "")"
                @onclick="() => _statusFilter = StocktakeStatus.Completed">
            <span>Đã hoàn tất</span>
            <span class="tw-ml-1.5 tw-text-2xs tw-px-1.5 tw-py-0.5 tw-rounded-full @(_statusFilter == StocktakeStatus.Completed ? "tw-bg-emerald-100 tw-text-emerald-800 tw-font-bold" : "tw-bg-slate-200/80 tw-text-slate-600")">@_sessions.Count(s => s.Status == StocktakeStatus.Completed || s.Status == StocktakeStatus.Approved)</span>
        </button>
    </div>
</div>

<!-- Sessions Table Card -->
<div class="tw-bg-white tw-border tw-border-slate-200 tw-rounded-lg tw-shadow-xs tw-overflow-hidden">
    <div class="tw-overflow-x-auto">
        <table class="tf-table tw-w-full">
            <thead>
                <tr class="tw-bg-slate-50 tw-border-b tw-border-slate-200 tw-text-left tw-text-xs tw-font-semibold tw-text-slate-600 tw-uppercase">
                    <th class="tw-p-3" style="min-width: 140px;">Mã đợt</th>
                    <th class="tw-p-3" style="min-width: 150px;">Kho kiểm kê</th>
                    <th class="tw-p-3" style="min-width: 120px;">Ngày chốt sổ</th>
                    <th class="tw-p-3" style="min-width: 180px;">Mục đích / Lý do</th>
                    <th class="tw-p-3" style="min-width: 130px;">Người lập</th>
                    <th class="tw-p-3" style="min-width: 130px;">Người duyệt</th>
                    <th class="tw-p-3" style="text-align: right; min-width: 80px;">Số dòng</th>
                    <th class="tw-p-3" style="text-align: center; min-width: 140px;">Trạng thái</th>
                    <th class="tw-p-3" style="text-align: right; min-width: 130px;">Thao tác</th>
                </tr>
            </thead>
            <tbody class="tw-divide-y tw-divide-slate-100 tw-text-sm">
                @if (_isLoading)
                {
                    <tr>
                        <td colspan="9" class="tw-p-8 tw-text-center tw-text-slate-500">
                            <div class="tw-inline-block tw-animate-spin tw-rounded-full tw-h-6 tw-w-6 tw-border-b-2 tw-border-blue-600 tw-mr-2"></div>
                            <span>Đang tải danh sách đợt kiểm kê...</span>
                        </td>
                    </tr>
                }
                else if (!FilteredSessions.Any())
                {
                    <tr>
                        <td colspan="9" class="tw-p-8 tw-text-center tw-text-slate-500">
                            <div class="tw-text-base tw-font-medium tw-text-slate-600 tw-mb-1">Chưa có đợt kiểm kê nào</div>
                            <p class="tw-text-xs tw-text-slate-400">Khởi tạo đợt kiểm kê mới để đối soát tồn kho sổ sách và thực tế</p>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var s in FilteredSessions)
                    {
                        <tr class="hover:tw-bg-slate-50/70 tw-transition-colors">
                            <td class="tw-p-3">
                                <a href="/kho/kiem-kho/@s.Id" class="tw-font-mono tw-font-bold tw-text-blue-600 hover:tw-underline">
                                    @s.Code
                                </a>
                            </td>
                            <td class="tw-p-3 tw-font-medium tw-text-slate-800">
                                @s.WarehouseName
                            </td>
                            <td class="tw-p-3 tw-text-slate-600 tw-text-xs">
                                @s.StocktakeDate.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td class="tw-p-3 tw-text-slate-700">
                                @s.Reason
                            </td>
                            <td class="tw-p-3 tw-text-slate-600 tw-text-xs">
                                @(s.CountedByName ?? "Chưa kiểm đếm")
                            </td>
                            <td class="tw-p-3 tw-text-slate-600 tw-text-xs">
                                @(s.ReviewedByName ?? "Chờ giám sát")
                            </td>
                            <td class="tw-p-3 tw-text-right tw-font-semibold">
                                @s.Items.Count
                            </td>
                            <td class="tw-p-3" style="text-align: center;">
                                @if (s.Status == StocktakeStatus.Completed)
                                {
                                    <span class="tw-inline-flex tw-items-center tw-px-2 tw-py-0.5 tw-rounded-full tw-text-xs tw-font-medium tw-bg-emerald-100 tw-text-emerald-800">
                                        Đã xử lý xong
                                    </span>
                                }
                                else if (s.Status == StocktakeStatus.PendingReview)
                                {
                                    <span class="tw-inline-flex tw-items-center tw-px-2 tw-py-0.5 tw-rounded-full tw-text-xs tw-font-medium tw-bg-amber-100 tw-text-amber-800">
                                        Chờ Quản lý duyệt
                                    </span>
                                }
                                else if (s.Status == StocktakeStatus.Counting)
                                {
                                    <span class="tw-inline-flex tw-items-center tw-px-2 tw-py-0.5 tw-rounded-full tw-text-xs tw-font-medium tw-bg-blue-100 tw-text-blue-800">
                                        Đang kiểm đếm
                                    </span>
                                }
                                else if (s.Status == StocktakeStatus.Rejected)
                                {
                                    <span class="tw-inline-flex tw-items-center tw-px-2 tw-py-0.5 tw-rounded-full tw-text-xs tw-font-medium tw-bg-red-100 tw-text-red-800">
                                        Từ chối / Đếm lại
                                    </span>
                                }
                                else
                                {
                                    <span class="tw-inline-flex tw-items-center tw-px-2 tw-py-0.5 tw-rounded-full tw-text-xs tw-font-medium tw-bg-slate-100 tw-text-slate-700">
                                        Dự thảo
                                    </span>
                                }
                            </td>
                            <td class="tw-p-3" style="text-align: right;">
                                <a href="/kho/kiem-kho/@s.Id" class="tf-btn tf-btn-sm tf-btn-secondary">
                                    Chi tiết & Đếm
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Create Modal (Standardized Global Policy) -->
@if (_showCreateModal)
{
    <div class="tf-modal-overlay"
         @onclick="HandleModalBackdropClick"
         @onkeydown="HandleModalKeyDown"
         tabindex="-1"
         role="presentation">
        <div class="tw-bg-white tw-rounded-xl tw-shadow-2xl tw-max-w-lg tw-w-full tw-p-6 tw-relative tw-border tw-border-slate-200"
             role="dialog"
             aria-modal="true"
             aria-labelledby="stocktake-create-modal-title"
             @onclick:stopPropagation="true">

            <div class="tw-flex tw-justify-between tw-items-center tw-border-b tw-border-slate-200 tw-pb-3.5 tw-mb-4">
                <div class="tw-flex tw-items-center tw-gap-2.5">
                    <div class="tw-w-8 tw-h-8 tw-rounded-lg tw-bg-blue-100 tw-text-blue-700 tw-flex tw-items-center tw-justify-center">
                        <svg class="tw-w-4 tw-h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                        </svg>
                    </div>
                    <div>
                        <h3 id="stocktake-create-modal-title" class="tw-text-base tw-font-bold tw-text-slate-900 tw-m-0">
                            Khởi tạo đợt kiểm kê kho
                        </h3>
                        <div class="tw-text-xs tw-text-slate-500">
                            Đối soát chốt tồn kho thực tế và sổ sách kế toán
                        </div>
                    </div>
                </div>

                <button type="button"
                        class="tf-modal-close-btn"
                        @onclick="RequestCloseCreateModal"
                        disabled="@_isSubmitting"
                        aria-label="Đóng"
                        title="Đóng">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            @if (!string.IsNullOrEmpty(_createError))
            {
                <div class="tw-bg-red-50 tw-border tw-border-red-200 tw-rounded-lg tw-p-3 tw-mb-4 tw-text-xs tw-text-red-700 tw-flex tw-items-start tw-gap-2">
                    <svg class="tw-w-4 tw-h-4 tw-text-red-600 tw-shrink-0 tw-mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <div class="tw-flex-1">
                        <span class="tw-font-semibold">Lỗi khởi tạo: </span>@_createError
                    </div>
                </div>
            }

            <div class="tw-space-y-4">
                <div>
                    <label class="tw-block tw-text-xs tw-font-semibold tw-text-slate-700 tw-mb-1.5">Kho kiểm kê *</label>
                    <select class="tf-form-control tw-w-full tw-h-9 tw-px-2.5 tw-text-sm tw-rounded-lg tw-border tw-border-slate-300 focus:tw-border-blue-500 focus:tw-outline-none"
                            @bind="_newWarehouseId"
                            disabled="@_isSubmitting">
                        @foreach (var wh in _warehouses)
                        {
                            <option value="@wh.Id">@wh.Name (@wh.Code)</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="tw-block tw-text-xs tw-font-semibold tw-text-slate-700 tw-mb-1.5">Thời điểm chốt số liệu sổ sách (Cutoff Snapshot) *</label>
                    <input type="datetime-local"
                           class="tf-form-control tw-w-full tw-h-9 tw-px-2.5 tw-text-sm tw-rounded-lg tw-border tw-border-slate-300 focus:tw-border-blue-500 focus:tw-outline-none"
                           @bind="_newCutoffDate"
                           disabled="@_isSubmitting" />
                    <p class="tw-text-xs tw-text-slate-500 tw-mt-1.5">Hệ thống sẽ chụp lại ảnh chụp tồn sổ sách chính xác tại thời điểm này để so sánh.</p>
                </div>

                <div>
                    <label class="tw-block tw-text-xs tw-font-semibold tw-text-slate-700 tw-mb-1.5">Mục đích / Lý do kiểm kê *</label>
                    <input type="text"
                           class="tf-form-control tw-w-full tw-h-9 tw-px-2.5 tw-text-sm tw-rounded-lg tw-border tw-border-slate-300 focus:tw-border-blue-500 focus:tw-outline-none"
                           placeholder="Ví dụ: Kiểm kê định kỳ cuối tháng, Kiểm kê đột xuất..."
                           @bind="_newReason"
                           disabled="@_isSubmitting" />
                </div>
            </div>

            <div class="tw-flex tw-justify-end tw-gap-2.5 tw-border-t tw-border-slate-200 tw-pt-4 tw-mt-5">
                <button type="button"
                        class="tf-btn tf-btn-secondary"
                        @onclick="RequestCloseCreateModal"
                        disabled="@_isSubmitting">
                    Đóng
                </button>
                <button type="button"
                        class="tf-btn tf-btn-primary"
                        @onclick="CreateSessionAsync"
                        disabled="@_isSubmitting">
                    @if (_isSubmitting)
                    {
                        <span class="tw-inline-block tw-animate-spin tw-rounded-full tw-h-3.5 tw-w-3.5 tw-border-b-2 tw-border-white tw-mr-1.5"></span>
                        <span>Đang chốt số...</span>
                    }
                    else
                    {
                        <span>Chốt số & Bắt đầu đếm</span>
                    }
                </button>
            </div>

            @* Unsaved Changes Confirm Dialog *@
            @if (_showDiscardConfirm)
            {
                <div class="tf-modal-confirm-overlay" @onclick:stopPropagation="true">
                    <div class="tf-modal-confirm-box tw-text-center">
                        <div class="tw-w-12 tw-h-12 tw-rounded-full tw-bg-amber-100 tw-text-amber-600 tw-flex tw-items-center tw-justify-center tw-mx-auto tw-mb-3">
                            <svg class="tw-w-6 tw-h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                            </svg>
                        </div>
                        <h4 class="tw-text-base tw-font-bold tw-text-slate-900 tw-mb-1.5">Bạn có thay đổi chưa lưu</h4>
                        <p class="tw-text-xs tw-text-slate-500 tw-mb-5 tw-leading-relaxed">
                            Bạn có chắc muốn đóng và hủy thay đổi? Thông tin đợt kiểm kê bạn đang thiết lập sẽ không được lưu.
                        </p>
                        <div class="tw-flex tw-items-center tw-justify-center tw-gap-2.5">
                            <button type="button" class="tf-btn tf-btn-secondary tw-text-xs" @onclick="() => _showDiscardConfirm = false">
                                Tiếp tục chỉnh sửa
                            </button>
                            <button type="button" class="tf-btn tf-btn-danger tw-text-xs" @onclick="ConfirmDiscard">
                                Hủy thay đổi
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    private List<StocktakeSessionDto> _sessions = new();
    private List<Warehouse> _warehouses = new();
    private bool _isLoading = true;
    private string _searchTerm = string.Empty;
    private StocktakeStatus? _statusFilter;

    // Create Modal state
    private bool _showCreateModal = false;
    private bool _showDiscardConfirm = false;
    private bool _isSubmitting = false;
    private string? _createError;
    private string _initialReason = string.Empty;
    private int _newWarehouseId;
    private DateTime _newCutoffDate = DateTime.Now;
    private string _newReason = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            using var ctx = await DbContextFactory.CreateDbContextAsync();
            _warehouses = await ctx.Warehouses.Where(w => w.IsActive).OrderBy(w => w.Name).ToListAsync();
            if (_warehouses.Any() && _newWarehouseId == 0)
            {
                _newWarehouseId = _warehouses.First().Id;
            }

            _sessions = await WarehouseService.GetStocktakeSessionsAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private IEnumerable<StocktakeSessionDto> FilteredSessions
    {
        get
        {
            var query = _sessions.AsEnumerable();

            if (_statusFilter.HasValue)
            {
                if (_statusFilter.Value == StocktakeStatus.Completed)
                {
                    query = query.Where(s => s.Status == StocktakeStatus.Completed || s.Status == StocktakeStatus.Approved);
                }
                else
                {
                    query = query.Where(s => s.Status == _statusFilter.Value);
                }
            }

            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                var term = _searchTerm.Trim().ToLower();
                query = query.Where(s =>
                    (s.Code?.ToLower().Contains(term) ?? false) ||
                    (s.WarehouseName?.ToLower().Contains(term) ?? false) ||
                    (s.Reason?.ToLower().Contains(term) ?? false));
            }
            return query.OrderByDescending(s => s.StocktakeDate);
        }
    }

    private void OpenCreateModal()
    {
        _initialReason = "Kiểm kê định kỳ tháng " + DateTime.Now.Month + "/" + DateTime.Now.Year;
        _newReason = _initialReason;
        _newCutoffDate = DateTime.Now;
        _createError = null;
        _isSubmitting = false;
        _showDiscardConfirm = false;
        _showCreateModal = true;
    }

    private bool IsModalDirty => _newReason != _initialReason;

    private void RequestCloseCreateModal()
    {
        if (_isSubmitting) return;

        if (IsModalDirty)
        {
            _showDiscardConfirm = true;
            return;
        }

        CloseCreateModalDirectly();
    }

    private void HandleModalBackdropClick()
    {
        if (_isSubmitting) return;

        if (IsModalDirty)
        {
            _showDiscardConfirm = true;
            return;
        }

        CloseCreateModalDirectly();
    }

    private void HandleModalKeyDown(KeyboardEventArgs e)
    {
        if (_isSubmitting) return;

        if (e.Key == "Escape")
        {
            if (_showDiscardConfirm)
            {
                _showDiscardConfirm = false;
                return;
            }

            RequestCloseCreateModal();
        }
    }

    private void ConfirmDiscard()
    {
        _showDiscardConfirm = false;
        CloseCreateModalDirectly();
    }

    private void CloseCreateModalDirectly()
    {
        _showCreateModal = false;
        _createError = null;
        _isSubmitting = false;
        _showDiscardConfirm = false;
    }

    private async Task CreateSessionAsync()
    {
        if (_newWarehouseId == 0 || string.IsNullOrWhiteSpace(_newReason))
        {
            _createError = "Vui lòng chọn kho kiểm kê và nhập mục đích kiểm kê.";
            return;
        }

        _isSubmitting = true;
        _createError = null;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            var userName = user.Identity?.Name ?? "Admin";
            var userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "admin";

            var session = await WarehouseService.CreateStocktakeSessionAsync(_newWarehouseId, _newCutoffDate, _newReason.Trim(), userId, userName);
            CloseCreateModalDirectly();
            Nav.NavigateTo($"/kho/kiem-kho/{session.Id}");
        }
        catch (Exception ex)
        {
            _createError = $"Không thể khởi tạo đợt kiểm kê: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
