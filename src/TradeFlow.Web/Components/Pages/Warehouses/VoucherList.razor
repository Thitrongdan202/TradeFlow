@code {
    private List<WarehouseVoucherDto> _vouchers = new();
    private List<Warehouse> _warehouses = new();
    private List<Product> _products = new();
    private bool _isLoading = true;

    private string _searchTerm = string.Empty;
    private WarehouseVoucherType? _typeFilter;

    private int _currentPage = 1;
    private int _pageSize = 20;

    // Create Modal state
    private bool _showCreateModal = false;
    private bool _showDiscardConfirm = false;
    private bool _isSubmitting = false;
    private string? _saveError;
    private WarehouseVoucherType _newVoucherType = WarehouseVoucherType.InboundReceipt;
    private int _newWarehouseId;
    private DateTime _newVoucherDate = DateTime.Today;
    private string _newPartnerName = string.Empty;
    private string _newDeliverer = string.Empty;
    private string _newReason = string.Empty;
    private List<WarehouseVoucherItemDto> _newItems = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            using var ctx = await DbContextFactory.CreateDbContextAsync();
            _warehouses = await ctx.Warehouses.Where(w => w.IsActive).OrderBy(w => w.Name).ToListAsync();
            _products = await ctx.Products.Where(p => p.IsActive).OrderBy(p => p.Name).ToListAsync();

            if (_warehouses.Any() && _newWarehouseId == 0)
            {
                _newWarehouseId = _warehouses.First().Id;
            }

            _vouchers = await WarehouseService.GetVouchersAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private IEnumerable<WarehouseVoucherDto> FilteredVouchers
    {
        get
        {
            var query = _vouchers.AsEnumerable();

            if (_typeFilter.HasValue)
            {
                query = query.Where(v => v.VoucherType == _typeFilter.Value);
            }

            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                var term = _searchTerm.Trim().ToLower();
                query = query.Where(v =>
                    (v.VoucherNumber?.ToLower().Contains(term) ?? false) ||
                    (v.PartnerName?.ToLower().Contains(term) ?? false) ||
                    (v.DelivererOrReceiverName?.ToLower().Contains(term) ?? false) ||
                    (v.Reason?.ToLower().Contains(term) ?? false));
            }

            return query.OrderByDescending(v => v.VoucherDate).ThenByDescending(v => v.Id);
        }
    }

    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)FilteredVouchers.Count() / _pageSize));

    private IEnumerable<WarehouseVoucherDto> PagedVouchers =>
        FilteredVouchers.Skip((_currentPage - 1) * _pageSize).Take(_pageSize);

    private string GetVoucherTypeBadgeClass(WarehouseVoucherType type) => type switch
    {
        WarehouseVoucherType.InboundReceipt => "tw-bg-emerald-100 tw-text-emerald-800",
        WarehouseVoucherType.OutboundIssue => "tw-bg-blue-100 tw-text-blue-800",
        WarehouseVoucherType.InspectionRecord => "tw-bg-indigo-100 tw-text-indigo-800",
        WarehouseVoucherType.StocktakeReport => "tw-bg-purple-100 tw-text-purple-800",
        _ => "tw-bg-slate-100 tw-text-slate-800"
    };

    private bool IsModalDirty =>
        !string.IsNullOrWhiteSpace(_newPartnerName) ||
        !string.IsNullOrWhiteSpace(_newDeliverer) ||
        _newItems.Count > 1;

    private void OpenCreateModal(WarehouseVoucherType type)
    {
        _newVoucherType = type;
        _newVoucherDate = DateTime.Today;
        _newPartnerName = string.Empty;
        _newDeliverer = string.Empty;
        _newReason = type == WarehouseVoucherType.InboundReceipt ? "Nhập kho mua hàng" : "Xuất kho giao hàng";
        _newItems = new List<WarehouseVoucherItemDto>
        {
            new() { ProductId = _products.FirstOrDefault()?.Id ?? 0, ActualQuantity = 10, UnitPrice = 1000000 }
        };
        _saveError = null;
        _isSubmitting = false;
        _showDiscardConfirm = false;
        _showCreateModal = true;
    }

    private void RequestCloseCreateModal()
    {
        if (_isSubmitting) return;

        if (IsModalDirty)
        {
            _showDiscardConfirm = true;
            return;
        }

        CloseCreateModalDirectly();
    }

    private void HandleModalBackdropClick()
    {
        if (_isSubmitting) return;

        if (IsModalDirty)
        {
            _showDiscardConfirm = true;
            return;
        }

        CloseCreateModalDirectly();
    }

    private void HandleModalKeyDown(KeyboardEventArgs e)
    {
        if (_isSubmitting) return;

        if (e.Key == "Escape")
        {
            if (_showDiscardConfirm)
            {
                _showDiscardConfirm = false;
                return;
            }

            RequestCloseCreateModal();
        }
    }

    private void ConfirmDiscard()
    {
        _showDiscardConfirm = false;
        CloseCreateModalDirectly();
    }

    private void CloseCreateModalDirectly()
    {
        _showCreateModal = false;
        _saveError = null;
        _isSubmitting = false;
        _showDiscardConfirm = false;
    }

    private void AddVoucherItemRow()
    {
        _newItems.Add(new WarehouseVoucherItemDto
        {
            ProductId = _products.FirstOrDefault()?.Id ?? 0,
            ActualQuantity = 1,
            UnitPrice = 500000
        });
    }

    private async Task SaveVoucherAsync()
    {
        if (_newWarehouseId == 0 || string.IsNullOrWhiteSpace(_newReason))
        {
            _saveError = "Vui lòng chọn kho hàng và nhập lý do chứng từ.";
            return;
        }

        _isSubmitting = true;
        _saveError = null;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            var userName = user.Identity?.Name ?? "Admin";
            var userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "admin";

            var dto = new WarehouseVoucherDto
            {
                VoucherType = _newVoucherType,
                VoucherDate = _newVoucherDate,
                WarehouseId = _newWarehouseId,
                PartnerName = _newPartnerName.Trim(),
                DelivererOrReceiverName = _newDeliverer.Trim(),
                Reason = _newReason.Trim(),
                Status = WarehouseVoucherStatus.Draft,
                Items = _newItems.Where(i => i.ProductId > 0 && i.ActualQuantity > 0).ToList()
            };

            var created = await WarehouseService.CreateVoucherAsync(dto, userId, userName);
            CloseCreateModalDirectly();
            await LoadDataAsync();
            Nav.NavigateTo($"/kho/phieu-kho/{created.Id}");
        }
        catch (Exception ex)
        {
            _saveError = $"Không thể lưu chứng từ: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task ApproveVoucher(int voucherId)
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userName = user.Identity?.Name ?? "Admin";
        var userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "admin";

        await WarehouseService.ApproveVoucherAsync(voucherId, userId, userName);
        await LoadDataAsync();
    }
}
