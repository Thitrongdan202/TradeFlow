@page "/kho/phieu-kho"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Application.Common.Models.Warehouse
@using TradeFlow.Domain.Entities.MasterData
@using TradeFlow.Domain.Enums
@using TradeFlow.Infrastructure.Persistence
@attribute [Authorize(Policy = "Permission:Warehouses:View")]

@inject IWarehouseService WarehouseService
@inject IDbContextFactory<TradeFlowDbContext> DbContextFactory
@inject NavigationManager Nav
@inject IAuditService AuditService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider

<PageTitle>Chứng từ Kho - TradeFlow</PageTitle>

<WarehouseNavTabs ActiveTab="vouchers" />

<div class="tf-page-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 16px;">
    <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">
        <div>
            <h1 class="tf-page-title" style="margin: 0; font-size: 20px;">Chứng từ xuất nhập kho</h1>
            <p class="tf-page-subtitle" style="margin: 2px 0 0; font-size: 12px;">Phiếu nhập kho Mẫu 01-VT, Phiếu xuất kho Mẫu 02-VT theo chế độ kế toán Bộ Tài chính</p>
        </div>
        <div style="width: 300px; max-width: 100%;">
            <input type="text"
                   class="tf-form-control tw-w-full tw-h-9 tw-px-3 tw-text-sm tw-rounded-md tw-border tw-border-slate-300 focus:tw-border-emerald-500 focus:tw-outline-none"
                   placeholder="Tìm số phiếu, đối tác, người giao nhận..."
                   @bind="_searchTerm"
                   @bind:event="oninput" />
        </div>
    </div>
    <div class="tf-page-actions tw-flex tw-gap-2">
        <AuthorizeView Policy="Permission:Warehouses:Create">
            <button class="tf-btn tf-btn-secondary" @onclick='() => OpenCreateModal(WarehouseVoucherType.InboundReceipt)' style="display: inline-flex; align-items: center; gap: 6px; height: 36px; white-space: nowrap;">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                <span>Lập Phiếu nhập (01-VT)</span>
            </button>
            <button class="tf-btn tf-btn-primary" @onclick='() => OpenCreateModal(WarehouseVoucherType.OutboundIssue)' style="display: inline-flex; align-items: center; gap: 6px; height: 36px; white-space: nowrap;">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                <span>Lập Phiếu xuất (02-VT)</span>
            </button>
        </AuthorizeView>
    </div>
</div>

<!-- Type Filter Chips -->
<div class="tw-flex tw-gap-2 tw-mb-4 tw-overflow-x-auto tw-pb-1">
    <button class="tw-px-3 tw-py-1.5 tw-rounded-full tw-text-xs tw-font-medium tw-transition-colors @(_typeFilter == null ? "tw-bg-emerald-600 tw-text-white" : "tw-bg-slate-100 tw-text-slate-700 hover:tw-bg-slate-200")"
            @onclick="() => _typeFilter = null">
        Tất cả chứng từ
    </button>
    <button class="tw-px-3 tw-py-1.5 tw-rounded-full tw-text-xs tw-font-medium tw-transition-colors @(_typeFilter == WarehouseVoucherType.InboundReceipt ? "tw-bg-emerald-600 tw-text-white" : "tw-bg-slate-100 tw-text-slate-700 hover:tw-bg-slate-200")"
            @onclick="() => _typeFilter = WarehouseVoucherType.InboundReceipt">
        Phiếu nhập kho (01-VT)
    </button>
    <button class="tw-px-3 tw-py-1.5 tw-rounded-full tw-text-xs tw-font-medium tw-transition-colors @(_typeFilter == WarehouseVoucherType.OutboundIssue ? "tw-bg-emerald-600 tw-text-white" : "tw-bg-slate-100 tw-text-slate-700 hover:tw-bg-slate-200")"
            @onclick="() => _typeFilter = WarehouseVoucherType.OutboundIssue">
        Phiếu xuất kho (02-VT)
    </button>
    <button class="tw-px-3 tw-py-1.5 tw-rounded-full tw-text-xs tw-font-medium tw-transition-colors @(_typeFilter == WarehouseVoucherType.InspectionRecord ? "tw-bg-emerald-600 tw-text-white" : "tw-bg-slate-100 tw-text-slate-700 hover:tw-bg-slate-200")"
            @onclick="() => _typeFilter = WarehouseVoucherType.InspectionRecord">
        Biên bản kiểm nghiệm (03-VT)
    </button>
    <button class="tw-px-3 tw-py-1.5 tw-rounded-full tw-text-xs tw-font-medium tw-transition-colors @(_typeFilter == WarehouseVoucherType.StocktakeReport ? "tw-bg-emerald-600 tw-text-white" : "tw-bg-slate-100 tw-text-slate-700 hover:tw-bg-slate-200")"
            @onclick="() => _typeFilter = WarehouseVoucherType.StocktakeReport">
        Biên bản kiểm kê (05-VT)
    </button>
</div>

<!-- Main Table Card -->
<div class="tw-bg-white tw-border tw-border-slate-200 tw-rounded-lg tw-shadow-xs tw-overflow-hidden">
    <div class="tw-overflow-x-auto">
        <table class="tf-table tw-w-full">
            <thead>
                <tr class="tw-bg-slate-50 tw-border-b tw-border-slate-200 tw-text-left tw-text-xs tw-font-semibold tw-text-slate-600 tw-uppercase">
                    <th class="tw-p-3" style="min-width: 140px;">Số phiếu</th>
                    <th class="tw-p-3" style="min-width: 160px;">Loại biểu mẫu</th>
                    <th class="tw-p-3" style="min-width: 110px;">Ngày lập</th>
                    <th class="tw-p-3" style="min-width: 150px;">Kho hàng</th>
                    <th class="tw-p-3" style="min-width: 180px;">Đối tác / Giao nhận</th>
                    <th class="tw-p-3" style="min-width: 200px;">Lý do xuất nhập</th>
                    <th class="tw-p-3" style="text-align: right; min-width: 100px;">Tổng SL</th>
                    <th class="tw-p-3" style="text-align: right; min-width: 130px;">Tổng giá trị</th>
                    <th class="tw-p-3" style="text-align: center; min-width: 110px;">Trạng thái</th>
                    <th class="tw-p-3" style="text-align: right; min-width: 120px;">Thao tác</th>
                </tr>
            </thead>
            <tbody class="tw-divide-y tw-divide-slate-100 tw-text-sm">
                @if (_isLoading)
                {
                    <tr>
                        <td colspan="10" class="tw-p-8 tw-text-center tw-text-slate-500">
                            <div class="tw-inline-block tw-animate-spin tw-rounded-full tw-h-6 tw-w-6 tw-border-b-2 tw-border-emerald-600 tw-mr-2"></div>
                            <span>Đang tải danh sách chứng từ...</span>
                        </td>
                    </tr>
                }
                else if (!FilteredVouchers.Any())
                {
                    <tr>
                        <td colspan="10" class="tw-p-8 tw-text-center tw-text-slate-500">
                            <div class="tw-text-base tw-font-medium tw-text-slate-600 tw-mb-1">Chưa có chứng từ kho nào phù hợp</div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var v in PagedVouchers)
                    {
                        <tr class="hover:tw-bg-slate-50/70 tw-transition-colors">
                            <td class="tw-p-3">
                                <a href="/kho/phieu-kho/@v.Id" class="tw-font-mono tw-font-bold tw-text-emerald-700 hover:tw-underline">
                                    @v.VoucherNumber
                                </a>
                                @if (!string.IsNullOrEmpty(v.SourceReference))
                                {
                                    <div class="tw-text-xs tw-text-slate-400">Ref: @v.SourceReference</div>
                                }
                            </td>
                            <td class="tw-p-3">
                                <span class="tw-inline-flex tw-items-center tw-px-2 tw-py-0.5 tw-rounded tw-text-xs tw-font-semibold @GetVoucherTypeBadgeClass(v.VoucherType)">
                                    @v.VoucherTypeName
                                </span>
                            </td>
                            <td class="tw-p-3 tw-text-slate-600">
                                @v.VoucherDate.ToString("dd/MM/yyyy")
                            </td>
                            <td class="tw-p-3 tw-text-slate-700 tw-font-medium">
                                @v.WarehouseName
                            </td>
                            <td class="tw-p-3">
                                <div class="tw-font-medium tw-text-slate-900">@(v.PartnerName ?? v.DelivererOrReceiverName ?? "-")</div>
                                @if (!string.IsNullOrEmpty(v.DelivererOrReceiverName) && v.DelivererOrReceiverName != v.PartnerName)
                                {
                                    <div class="tw-text-xs tw-text-slate-400">Người giao/nhận: @v.DelivererOrReceiverName</div>
                                }
                            </td>
                            <td class="tw-p-3 tw-text-slate-600">
                                <span class="tw-line-clamp-2" title="@v.Reason">@v.Reason</span>
                            </td>
                            <td class="tw-p-3" style="text-align: right;">
                                <span class="tw-font-semibold tw-text-slate-900">@v.TotalQuantity.ToString("N0")</span>
                            </td>
                            <td class="tw-p-3 tw-font-bold tw-text-slate-900" style="text-align: right;">
                                @v.TotalAmount.ToString("N0") đ
                            </td>
                            <td class="tw-p-3" style="text-align: center;">
                                @if (v.Status == WarehouseVoucherStatus.Approved)
                                {
                                    <span class="tw-inline-flex tw-items-center tw-px-2 tw-py-0.5 tw-rounded-full tw-text-xs tw-font-medium tw-bg-emerald-100 tw-text-emerald-800">
                                        Đã duyệt
                                    </span>
                                }
                                else if (v.Status == WarehouseVoucherStatus.Draft)
                                {
                                    <span class="tw-inline-flex tw-items-center tw-px-2 tw-py-0.5 tw-rounded-full tw-text-xs tw-font-medium tw-bg-amber-100 tw-text-amber-800">
                                        Dự thảo
                                    </span>
                                }
                                else
                                {
                                    <span class="tw-inline-flex tw-items-center tw-px-2 tw-py-0.5 tw-rounded-full tw-text-xs tw-font-medium tw-bg-slate-100 tw-text-slate-700">
                                        Đã hủy
                                    </span>
                                }
                            </td>
                            <td class="tw-p-3" style="text-align: right;">
                                <div class="tw-flex tw-justify-end tw-gap-1">
                                    <a href="/kho/phieu-kho/@v.Id" class="tf-btn tf-btn-ghost tf-btn-sm" title="Xem chi tiết và In phiếu">
                                        Xem/In
                                    </a>
                                    @if (v.Status == WarehouseVoucherStatus.Draft)
                                    {
                                        <AuthorizeView Policy="Permission:Warehouses:Approve">
                                            <button class="tf-btn tf-btn-sm tf-btn-primary" @onclick="() => ApproveVoucher(v.Id)">
                                                Duyệt
                                            </button>
                                        </AuthorizeView>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (FilteredVouchers.Any())
    {
        <div class="tw-p-3 tw-border-t tw-border-slate-200 tw-flex tw-justify-between tw-items-center tw-flex-wrap tw-gap-2">
            <div class="tw-text-xs tw-text-slate-500">
                Hiển thị @((_currentPage - 1) * _pageSize + 1) đến @(Math.Min(_currentPage * _pageSize, FilteredVouchers.Count())) trong tổng số @FilteredVouchers.Count() chứng từ
            </div>
            <div class="tw-flex tw-gap-1">
                <button class="tf-btn tf-btn-ghost tf-btn-sm" disabled="@(_currentPage <= 1)" @onclick="() => _currentPage--">Trước</button>
                <span class="tw-px-3 tw-py-1 tw-text-xs tw-font-medium tw-text-slate-700 tw-flex tw-items-center">Trang @_currentPage / @TotalPages</span>
                <button class="tf-btn tf-btn-ghost tf-btn-sm" disabled="@(_currentPage >= TotalPages)" @onclick="() => _currentPage++">Sau</button>
            </div>
        </div>
    }
</div>

<!-- Modal Create Voucher -->
@if (_showCreateModal)
{
    <div class="tw-fixed tw-inset-0 tw-z-50 tw-flex tw-items-center tw-justify-center tw-bg-slate-900/50 tw-p-4">
        <div class="tw-bg-white tw-rounded-lg tw-shadow-xl tw-max-w-2xl tw-w-full tw-p-6 tw-overflow-y-auto tw-max-h-[90vh]">
            <div class="tw-flex tw-justify-between tw-items-center tw-border-b tw-border-slate-200 tw-pb-3 tw-mb-4">
                <h3 class="tw-text-lg tw-font-bold tw-text-slate-900">
                    @(_newVoucherType == WarehouseVoucherType.InboundReceipt ? "Lập Phiếu Nhập Kho (Mẫu 01-VT)" : "Lập Phiếu Xuất Kho (Mẫu 02-VT)")
                </h3>
                <button type="button" class="tw-text-slate-400 hover:tw-text-slate-600" @onclick="() => _showCreateModal = false">&times;</button>
            </div>

            <div class="tw-space-y-4">
                <div class="tw-grid tw-grid-cols-2 tw-gap-4">
                    <div>
                        <label class="tw-block tw-text-xs tw-font-medium tw-text-slate-700 tw-mb-1">Kho hàng *</label>
                        <select class="tf-form-control tw-w-full tw-h-9 tw-px-2 tw-text-sm tw-rounded tw-border tw-border-slate-300" @bind="_newWarehouseId">
                            @foreach (var wh in _warehouses)
                            {
                                <option value="@wh.Id">@wh.Name (@wh.Code)</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="tw-block tw-text-xs tw-font-medium tw-text-slate-700 tw-mb-1">Ngày chứng từ *</label>
                        <input type="date" class="tf-form-control tw-w-full tw-h-9 tw-px-2 tw-text-sm tw-rounded tw-border tw-border-slate-300" @bind="_newVoucherDate" />
                    </div>
                </div>

                <div class="tw-grid tw-grid-cols-2 tw-gap-4">
                    <div>
                        <label class="tw-block tw-text-xs tw-font-medium tw-text-slate-700 tw-mb-1">Đối tác / Đơn vị giao nhận</label>
                        <input type="text" class="tf-form-control tw-w-full tw-h-9 tw-px-2 tw-text-sm tw-rounded tw-border tw-border-slate-300" placeholder="Tên đối tác hoặc nhà cung cấp" @bind="_newPartnerName" />
                    </div>
                    <div>
                        <label class="tw-block tw-text-xs tw-font-medium tw-text-slate-700 tw-mb-1">Họ tên người giao / nhận hàng</label>
                        <input type="text" class="tf-form-control tw-w-full tw-h-9 tw-px-2 tw-text-sm tw-rounded tw-border tw-border-slate-300" placeholder="Người đại diện giao nhận" @bind="_newDeliverer" />
                    </div>
                </div>

                <div>
                    <label class="tw-block tw-text-xs tw-font-medium tw-text-slate-700 tw-mb-1">Lý do nhập / xuất *</label>
                    <input type="text" class="tf-form-control tw-w-full tw-h-9 tw-px-2 tw-text-sm tw-rounded tw-border tw-border-slate-300" placeholder="Ví dụ: Nhập hàng theo hợp đồng, Xuất hàng theo đơn..." @bind="_newReason" />
                </div>

                <!-- Product Lines -->
                <div class="tw-border-t tw-border-slate-200 tw-pt-3">
                    <div class="tw-flex tw-justify-between tw-items-center tw-mb-2">
                        <span class="tw-font-semibold tw-text-sm tw-text-slate-800">Danh mục hàng hóa</span>
                        <button type="button" class="tf-btn tf-btn-ghost tf-btn-sm tw-text-emerald-600" @onclick="AddVoucherItemRow">
                            + Thêm sản phẩm
                        </button>
                    </div>

                    @foreach (var row in _newItems)
                    {
                        <div class="tw-flex tw-gap-2 tw-items-center tw-mb-2">
                            <select class="tf-form-control tw-flex-1 tw-h-8 tw-text-xs tw-px-2 tw-rounded tw-border tw-border-slate-300" @bind="row.ProductId">
                                <option value="0">-- Chọn sản phẩm --</option>
                                @foreach (var prod in _products)
                                {
                                    <option value="@prod.Id">@prod.Code - @prod.Name</option>
                                }
                            </select>
                            <input type="number" step="1" min="1" class="tf-form-control tw-w-20 tw-h-8 tw-text-xs tw-px-2 tw-rounded tw-border tw-border-slate-300" placeholder="Số lượng" @bind="row.ActualQuantity" />
                            <input type="number" step="1000" min="0" class="tf-form-control tw-w-28 tw-h-8 tw-text-xs tw-px-2 tw-rounded tw-border tw-border-slate-300" placeholder="Đơn giá" @bind="row.UnitPrice" />
                            <button type="button" class="tw-text-red-500 hover:tw-text-red-700 tw-px-2" @onclick="() => _newItems.Remove(row)">&times;</button>
                        </div>
                    }
                </div>
            </div>

            <div class="tw-flex tw-justify-end tw-gap-2 tw-border-t tw-border-slate-200 tw-pt-4 tw-mt-6">
                <button type="button" class="tf-btn tf-btn-secondary" @onclick="() => _showCreateModal = false">Đóng</button>
                <button type="button" class="tf-btn tf-btn-primary" @onclick="SaveVoucherAsync">Lưu chứng từ</button>
            </div>
        </div>
    </div>
}

@code {
    private List<WarehouseVoucherDto> _vouchers = new();
    private List<Warehouse> _warehouses = new();
    private List<Product> _products = new();
    private bool _isLoading = true;

    private string _searchTerm = string.Empty;
    private WarehouseVoucherType? _typeFilter;

    private int _currentPage = 1;
    private int _pageSize = 20;

    // Create Modal state
    private bool _showCreateModal = false;
    private WarehouseVoucherType _newVoucherType = WarehouseVoucherType.InboundReceipt;
    private int _newWarehouseId;
    private DateTime _newVoucherDate = DateTime.Today;
    private string _newPartnerName = string.Empty;
    private string _newDeliverer = string.Empty;
    private string _newReason = string.Empty;
    private List<WarehouseVoucherItemDto> _newItems = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            using var ctx = await DbContextFactory.CreateDbContextAsync();
            _warehouses = await ctx.Warehouses.Where(w => w.IsActive).OrderBy(w => w.Name).ToListAsync();
            _products = await ctx.Products.Where(p => p.IsActive).OrderBy(p => p.Name).ToListAsync();

            if (_warehouses.Any() && _newWarehouseId == 0)
            {
                _newWarehouseId = _warehouses.First().Id;
            }

            _vouchers = await WarehouseService.GetVouchersAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private IEnumerable<WarehouseVoucherDto> FilteredVouchers
    {
        get
        {
            var query = _vouchers.AsEnumerable();

            if (_typeFilter.HasValue)
            {
                query = query.Where(v => v.VoucherType == _typeFilter.Value);
            }

            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                var term = _searchTerm.Trim().ToLower();
                query = query.Where(v =>
                    (v.VoucherNumber?.ToLower().Contains(term) ?? false) ||
                    (v.PartnerName?.ToLower().Contains(term) ?? false) ||
                    (v.DelivererOrReceiverName?.ToLower().Contains(term) ?? false) ||
                    (v.Reason?.ToLower().Contains(term) ?? false));
            }

            return query.OrderByDescending(v => v.VoucherDate).ThenByDescending(v => v.Id);
        }
    }

    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)FilteredVouchers.Count() / _pageSize));

    private IEnumerable<WarehouseVoucherDto> PagedVouchers =>
        FilteredVouchers.Skip((_currentPage - 1) * _pageSize).Take(_pageSize);

    private string GetVoucherTypeBadgeClass(WarehouseVoucherType type) => type switch
    {
        WarehouseVoucherType.InboundReceipt => "tw-bg-emerald-100 tw-text-emerald-800",
        WarehouseVoucherType.OutboundIssue => "tw-bg-blue-100 tw-text-blue-800",
        WarehouseVoucherType.InspectionRecord => "tw-bg-indigo-100 tw-text-indigo-800",
        WarehouseVoucherType.StocktakeReport => "tw-bg-purple-100 tw-text-purple-800",
        _ => "tw-bg-slate-100 tw-text-slate-800"
    };

    private void OpenCreateModal(WarehouseVoucherType type)
    {
        _newVoucherType = type;
        _newVoucherDate = DateTime.Today;
        _newPartnerName = string.Empty;
        _newDeliverer = string.Empty;
        _newReason = type == WarehouseVoucherType.InboundReceipt ? "Nhập kho mua hàng" : "Xuất kho giao hàng";
        _newItems = new List<WarehouseVoucherItemDto>
        {
            new() { ProductId = _products.FirstOrDefault()?.Id ?? 0, ActualQuantity = 10, UnitPrice = 1000000 }
        };
        _showCreateModal = true;
    }

    private void AddVoucherItemRow()
    {
        _newItems.Add(new WarehouseVoucherItemDto
        {
            ProductId = _products.FirstOrDefault()?.Id ?? 0,
            ActualQuantity = 1,
            UnitPrice = 500000
        });
    }

    private async Task SaveVoucherAsync()
    {
        if (_newWarehouseId == 0 || string.IsNullOrWhiteSpace(_newReason)) return;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userName = user.Identity?.Name ?? "Admin";
        var userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "admin";

        var dto = new WarehouseVoucherDto
        {
            VoucherType = _newVoucherType,
            VoucherDate = _newVoucherDate,
            WarehouseId = _newWarehouseId,
            PartnerName = _newPartnerName,
            DelivererOrReceiverName = _newDeliverer,
            Reason = _newReason,
            Status = WarehouseVoucherStatus.Draft,
            Items = _newItems.Where(i => i.ProductId > 0 && i.ActualQuantity > 0).ToList()
        };

        var created = await WarehouseService.CreateVoucherAsync(dto, userId, userName);
        _showCreateModal = false;
        await LoadDataAsync();
        Nav.NavigateTo($"/kho/phieu-kho/{created.Id}");
    }

    private async Task ApproveVoucher(int voucherId)
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userName = user.Identity?.Name ?? "Admin";
        var userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "admin";

        await WarehouseService.ApproveVoucherAsync(voucherId, userId, userName);
        await LoadDataAsync();
    }
}
