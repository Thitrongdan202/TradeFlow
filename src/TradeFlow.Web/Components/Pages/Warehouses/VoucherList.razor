@page "/kho/phieu-kho"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using TradeFlow.Application.Common.Interfaces
@using TradeFlow.Application.Common.Models.Warehouse
@using TradeFlow.Domain.Entities.MasterData
@using TradeFlow.Domain.Enums
@using TradeFlow.Infrastructure.Persistence
@attribute [Authorize(Policy = "Permission:Warehouses:View")]

@inject IWarehouseService WarehouseService
@inject IDbContextFactory<TradeFlowDbContext> DbContextFactory
@inject NavigationManager Nav
@inject IAuditService AuditService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider

<PageTitle>Chứng từ Kho - TradeFlow</PageTitle>

<WarehouseNavTabs ActiveTab="vouchers" />

<div class="tf-page-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 16px;">
    <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">
        <div>
            <h1 class="tf-page-title" style="margin: 0; font-size: 20px;">Chứng từ xuất nhập kho</h1>
            <p class="tf-page-subtitle" style="margin: 2px 0 0; font-size: 12px;">Phiếu nhập kho Mẫu 01-VT, Phiếu xuất kho Mẫu 02-VT theo chế độ kế toán Bộ Tài chính</p>
        </div>
        <div style="width: 300px; max-width: 100%;">
            <input type="text"
                   class="tf-form-control tw-w-full tw-h-9 tw-px-3 tw-text-sm tw-rounded-md tw-border tw-border-slate-300 focus:tw-border-emerald-500 focus:tw-outline-none"
                   placeholder="Tìm số phiếu, đối tác, người giao nhận..."
                   @bind="_searchTerm"
                   @bind:event="oninput" />
        </div>
    </div>
    <div class="tf-page-actions tw-flex tw-gap-2">
        <AuthorizeView Policy="Permission:Warehouses:Create">
            <button class="tf-btn tf-btn-secondary" @onclick='() => OpenCreateModal(WarehouseVoucherType.InboundReceipt)' style="display: inline-flex; align-items: center; gap: 6px; height: 36px; white-space: nowrap;">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                <span>Lập Phiếu nhập (01-VT)</span>
            </button>
            <button class="tf-btn tf-btn-primary" @onclick='() => OpenCreateModal(WarehouseVoucherType.OutboundIssue)' style="display: inline-flex; align-items: center; gap: 6px; height: 36px; white-space: nowrap;">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                <span>Lập Phiếu xuất (02-VT)</span>
            </button>
        </AuthorizeView>
    </div>
</div>

<!-- Type Filter Tabs (Standard Segmented Control) -->
<div class="tw-mb-4">
    <div class="tf-segmented-tabs">
        <button type="button" class="tf-segmented-tab @(_typeFilter == null ? "is-active" : "")"
                @onclick="() => _typeFilter = null">
            <span>Tất cả chứng từ</span>
            <span class="tw-ml-1.5 tw-text-2xs tw-px-1.5 tw-py-0.5 tw-rounded-full @(_typeFilter == null ? "tw-bg-blue-100 tw-text-blue-700 tw-font-bold" : "tw-bg-slate-200/80 tw-text-slate-600")">@_vouchers.Count</span>
        </button>
        <button type="button" class="tf-segmented-tab @(_typeFilter == WarehouseVoucherType.InboundReceipt ? "is-active" : "")"
                @onclick="() => _typeFilter = WarehouseVoucherType.InboundReceipt">
            <span>Phiếu nhập kho (01-VT)</span>
            <span class="tw-ml-1.5 tw-text-2xs tw-px-1.5 tw-py-0.5 tw-rounded-full @(_typeFilter == WarehouseVoucherType.InboundReceipt ? "tw-bg-blue-100 tw-text-blue-700 tw-font-bold" : "tw-bg-slate-200/80 tw-text-slate-600")">@_vouchers.Count(v => v.VoucherType == WarehouseVoucherType.InboundReceipt)</span>
        </button>
        <button type="button" class="tf-segmented-tab @(_typeFilter == WarehouseVoucherType.OutboundIssue ? "is-active" : "")"
                @onclick="() => _typeFilter = WarehouseVoucherType.OutboundIssue">
            <span>Phiếu xuất kho (02-VT)</span>
            <span class="tw-ml-1.5 tw-text-2xs tw-px-1.5 tw-py-0.5 tw-rounded-full @(_typeFilter == WarehouseVoucherType.OutboundIssue ? "tw-bg-blue-100 tw-text-blue-700 tw-font-bold" : "tw-bg-slate-200/80 tw-text-slate-600")">@_vouchers.Count(v => v.VoucherType == WarehouseVoucherType.OutboundIssue)</span>
        </button>
        <button type="button" class="tf-segmented-tab @(_typeFilter == WarehouseVoucherType.InspectionRecord ? "is-active" : "")"
                @onclick="() => _typeFilter = WarehouseVoucherType.InspectionRecord">
            <span>Biên bản kiểm nghiệm (03-VT)</span>
            <span class="tw-ml-1.5 tw-text-2xs tw-px-1.5 tw-py-0.5 tw-rounded-full @(_typeFilter == WarehouseVoucherType.InspectionRecord ? "tw-bg-blue-100 tw-text-blue-700 tw-font-bold" : "tw-bg-slate-200/80 tw-text-slate-600")">@_vouchers.Count(v => v.VoucherType == WarehouseVoucherType.InspectionRecord)</span>
        </button>
        <button type="button" class="tf-segmented-tab @(_typeFilter == WarehouseVoucherType.StocktakeReport ? "is-active" : "")"
                @onclick="() => _typeFilter = WarehouseVoucherType.StocktakeReport">
            <span>Biên bản kiểm kê (05-VT)</span>
            <span class="tw-ml-1.5 tw-text-2xs tw-px-1.5 tw-py-0.5 tw-rounded-full @(_typeFilter == WarehouseVoucherType.StocktakeReport ? "tw-bg-blue-100 tw-text-blue-700 tw-font-bold" : "tw-bg-slate-200/80 tw-text-slate-600")">@_vouchers.Count(v => v.VoucherType == WarehouseVoucherType.StocktakeReport)</span>
        </button>
    </div>
</div>

<!-- Main Table Card -->
<div class="tw-bg-white tw-border tw-border-slate-200 tw-rounded-lg tw-shadow-xs tw-overflow-hidden">
    <div class="tw-overflow-x-auto">
        <table class="tf-table tw-w-full">
            <thead>
                <tr class="tw-bg-slate-50 tw-border-b tw-border-slate-200 tw-text-left tw-text-xs tw-font-semibold tw-text-slate-600 tw-uppercase">
                    <th class="tw-p-3" style="min-width: 140px;">Số phiếu</th>
                    <th class="tw-p-3" style="min-width: 160px;">Loại biểu mẫu</th>
                    <th class="tw-p-3" style="min-width: 110px;">Ngày lập</th>
                    <th class="tw-p-3" style="min-width: 150px;">Kho hàng</th>
                    <th class="tw-p-3" style="min-width: 180px;">Đối tác / Giao nhận</th>
                    <th class="tw-p-3" style="min-width: 200px;">Lý do xuất nhập</th>
                    <th class="tw-p-3" style="text-align: right; min-width: 100px;">Tổng SL</th>
                    <th class="tw-p-3" style="text-align: right; min-width: 130px;">Tổng giá trị</th>
                    <th class="tw-p-3" style="text-align: center; min-width: 110px;">Trạng thái</th>
                    <th class="tw-p-3" style="text-align: right; min-width: 120px;">Thao tác</th>
                </tr>
            </thead>
            <tbody class="tw-divide-y tw-divide-slate-100 tw-text-sm">
                @if (_isLoading)
                {
                    <tr>
                        <td colspan="10" class="tw-p-8 tw-text-center tw-text-slate-500">
                            <div class="tw-inline-block tw-animate-spin tw-rounded-full tw-h-6 tw-w-6 tw-border-b-2 tw-border-emerald-600 tw-mr-2"></div>
                            <span>Đang tải danh sách chứng từ...</span>
                        </td>
                    </tr>
                }
                else if (!FilteredVouchers.Any())
                {
                    <tr>
                        <td colspan="10" class="tw-p-8 tw-text-center tw-text-slate-500">
                            <div class="tw-text-base tw-font-medium tw-text-slate-600 tw-mb-1">Chưa có chứng từ kho nào phù hợp</div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var v in PagedVouchers)
                    {
                        <tr class="hover:tw-bg-slate-50/70 tw-transition-colors">
                            <td class="tw-p-3">
                                <a href="/kho/phieu-kho/@v.Id" class="tw-font-mono tw-font-bold tw-text-emerald-700 hover:tw-underline">
                                    @v.VoucherNumber
                                </a>
                                @if (!string.IsNullOrEmpty(v.SourceReference))
                                {
                                    <div class="tw-text-xs tw-text-slate-400">Ref: @v.SourceReference</div>
                                }
                            </td>
                            <td class="tw-p-3">
                                <span class="tw-inline-flex tw-items-center tw-px-2 tw-py-0.5 tw-rounded tw-text-xs tw-font-semibold @GetVoucherTypeBadgeClass(v.VoucherType)">
                                    @v.VoucherTypeName
                                </span>
                            </td>
                            <td class="tw-p-3 tw-text-slate-600">
                                @v.VoucherDate.ToString("dd/MM/yyyy")
                            </td>
                            <td class="tw-p-3 tw-text-slate-700 tw-font-medium">
                                @v.WarehouseName
                            </td>
                            <td class="tw-p-3">
                                <div class="tw-font-medium tw-text-slate-900">@(v.PartnerName ?? v.DelivererOrReceiverName ?? "-")</div>
                                @if (!string.IsNullOrEmpty(v.DelivererOrReceiverName) && v.DelivererOrReceiverName != v.PartnerName)
                                {
                                    <div class="tw-text-xs tw-text-slate-400">Người giao/nhận: @v.DelivererOrReceiverName</div>
                                }
                            </td>
                            <td class="tw-p-3 tw-text-slate-600">
                                <span class="tw-line-clamp-2" title="@v.Reason">@v.Reason</span>
                            </td>
                            <td class="tw-p-3" style="text-align: right;">
                                <span class="tw-font-semibold tw-text-slate-900">@v.TotalQuantity.ToString("N0")</span>
                            </td>
                            <td class="tw-p-3 tw-font-bold tw-text-slate-900" style="text-align: right;">
                                @v.TotalAmount.ToString("N0") đ
                            </td>
                            <td class="tw-p-3" style="text-align: center;">
                                @if (v.Status == WarehouseVoucherStatus.Approved)
                                {
                                    <span class="tw-inline-flex tw-items-center tw-px-2 tw-py-0.5 tw-rounded-full tw-text-xs tw-font-medium tw-bg-emerald-100 tw-text-emerald-800">
                                        Đã duyệt
                                    </span>
                                }
                                else if (v.Status == WarehouseVoucherStatus.Draft)
                                {
                                    <span class="tw-inline-flex tw-items-center tw-px-2 tw-py-0.5 tw-rounded-full tw-text-xs tw-font-medium tw-bg-amber-100 tw-text-amber-800">
                                        Dự thảo
                                    </span>
                                }
                                else
                                {
                                    <span class="tw-inline-flex tw-items-center tw-px-2 tw-py-0.5 tw-rounded-full tw-text-xs tw-font-medium tw-bg-slate-100 tw-text-slate-700">
                                        Đã hủy
                                    </span>
                                }
                            </td>
                            <td class="tw-p-3" style="text-align: right;">
                                <div class="tw-flex tw-justify-end tw-gap-1">
                                    <a href="/kho/phieu-kho/@v.Id" class="tf-btn tf-btn-ghost tf-btn-sm" title="Xem chi tiết và In phiếu">
                                        Xem/In
                                    </a>
                                    @if (v.Status == WarehouseVoucherStatus.Draft)
                                    {
                                        <AuthorizeView Policy="Permission:Warehouses:Approve">
                                            <button class="tf-btn tf-btn-sm tf-btn-primary" @onclick="() => ApproveVoucher(v.Id)">
                                                Duyệt
                                            </button>
                                        </AuthorizeView>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (FilteredVouchers.Any())
    {
        <div class="tw-p-3 tw-border-t tw-border-slate-200 tw-flex tw-justify-between tw-items-center tw-flex-wrap tw-gap-2">
            <div class="tw-text-xs tw-text-slate-500">
                Hiển thị @((_currentPage - 1) * _pageSize + 1) đến @(Math.Min(_currentPage * _pageSize, FilteredVouchers.Count())) trong tổng số @FilteredVouchers.Count() chứng từ
            </div>
            <div class="tw-flex tw-gap-1">
                <button class="tf-btn tf-btn-ghost tf-btn-sm" disabled="@(_currentPage <= 1)" @onclick="() => _currentPage--">Trước</button>
                <span class="tw-px-3 tw-py-1 tw-text-xs tw-font-medium tw-text-slate-700 tw-flex tw-items-center">Trang @_currentPage / @TotalPages</span>
                <button class="tf-btn tf-btn-ghost tf-btn-sm" disabled="@(_currentPage >= TotalPages)" @onclick="() => _currentPage++">Sau</button>
            </div>
        </div>
    }
</div>

<!-- Modal Create Voucher (Standardized Global Policy) -->
@if (_showCreateModal)
{
    <div class="tf-modal-overlay"
         @onclick="HandleModalBackdropClick"
         @onkeydown="HandleModalKeyDown"
         tabindex="-1"
         role="presentation">
        <div class="tw-bg-white tw-rounded-xl tw-shadow-2xl tw-max-w-2xl tw-w-full tw-p-6 tw-overflow-y-auto tw-max-h-[90vh] tw-relative tw-border tw-border-slate-200"
             role="dialog"
             aria-modal="true"
             aria-labelledby="voucher-create-modal-title"
             @onclick:stopPropagation="true">

            <div class="tw-flex tw-justify-between tw-items-center tw-border-b tw-border-slate-200 tw-pb-3.5 tw-mb-4">
                <div class="tw-flex tw-items-center tw-gap-2.5">
                    <div class="tw-w-8 tw-h-8 tw-rounded-lg tw-bg-blue-100 tw-text-blue-700 tw-flex tw-items-center tw-justify-center">
                        <svg class="tw-w-4 tw-h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                    </div>
                    <div>
                        <h3 id="voucher-create-modal-title" class="tw-text-base tw-font-bold tw-text-slate-900 tw-m-0">
                            @(_newVoucherType == WarehouseVoucherType.InboundReceipt ? "Lập Phiếu Nhập Kho (Mẫu 01-VT)" : "Lập Phiếu Xuất Kho (Mẫu 02-VT)")
                        </h3>
                        <div class="tw-text-xs tw-text-slate-500">
                            Theo chế độ kế toán và hóa đơn chứng từ Bộ Tài chính
                        </div>
                    </div>
                </div>

                <button type="button"
                        class="tf-modal-close-btn"
                        @onclick="RequestCloseCreateModal"
                        disabled="@_isSubmitting"
                        aria-label="Đóng"
                        title="Đóng">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            @if (!string.IsNullOrEmpty(_saveError))
            {
                <div class="tw-bg-red-50 tw-border tw-border-red-200 tw-rounded-lg tw-p-3 tw-mb-4 tw-text-xs tw-text-red-700 tw-flex tw-items-start tw-gap-2">
                    <svg class="tw-w-4 tw-h-4 tw-text-red-600 tw-shrink-0 tw-mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <div class="tw-flex-1">
                        <span class="tw-font-semibold">Lỗi lập phiếu: </span>@_saveError
                    </div>
                </div>
            }

            <div class="tw-space-y-4">
                <div class="tw-grid tw-grid-cols-2 tw-gap-4">
                    <div>
                        <label class="tw-block tw-text-xs tw-font-semibold tw-text-slate-700 tw-mb-1.5">Kho hàng *</label>
                        <select class="tf-form-control tw-w-full tw-h-9 tw-px-2.5 tw-text-sm tw-rounded-lg tw-border tw-border-slate-300 focus:tw-border-blue-500 focus:tw-outline-none"
                                @bind="_newWarehouseId"
                                disabled="@_isSubmitting">
                            @foreach (var wh in _warehouses)
                            {
                                <option value="@wh.Id">@wh.Name (@wh.Code)</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="tw-block tw-text-xs tw-font-semibold tw-text-slate-700 tw-mb-1.5">Ngày chứng từ *</label>
                        <input type="date"
                               class="tf-form-control tw-w-full tw-h-9 tw-px-2.5 tw-text-sm tw-rounded-lg tw-border tw-border-slate-300 focus:tw-border-blue-500 focus:tw-outline-none"
                               @bind="_newVoucherDate"
                               disabled="@_isSubmitting" />
                    </div>
                </div>

                <div class="tw-grid tw-grid-cols-2 tw-gap-4">
                    <div>
                        <label class="tw-block tw-text-xs tw-font-semibold tw-text-slate-700 tw-mb-1.5">Đối tác / Đơn vị giao nhận</label>
                        <input type="text"
                               class="tf-form-control tw-w-full tw-h-9 tw-px-2.5 tw-text-sm tw-rounded-lg tw-border tw-border-slate-300 focus:tw-border-blue-500 focus:tw-outline-none"
                               placeholder="Tên đối tác hoặc nhà cung cấp"
                               @bind="_newPartnerName"
                               disabled="@_isSubmitting" />
                    </div>
                    <div>
                        <label class="tw-block tw-text-xs tw-font-semibold tw-text-slate-700 tw-mb-1.5">Họ tên người giao / nhận hàng</label>
                        <input type="text"
                               class="tf-form-control tw-w-full tw-h-9 tw-px-2.5 tw-text-sm tw-rounded-lg tw-border tw-border-slate-300 focus:tw-border-blue-500 focus:tw-outline-none"
                               placeholder="Người đại diện giao nhận"
                               @bind="_newDeliverer"
                               disabled="@_isSubmitting" />
                    </div>
                </div>

                <div>
                    <label class="tw-block tw-text-xs tw-font-semibold tw-text-slate-700 tw-mb-1.5">Lý do nhập / xuất *</label>
                    <input type="text"
                           class="tf-form-control tw-w-full tw-h-9 tw-px-2.5 tw-text-sm tw-rounded-lg tw-border tw-border-slate-300 focus:tw-border-blue-500 focus:tw-outline-none"
                           placeholder="Ví dụ: Nhập hàng theo hợp đồng, Xuất hàng theo đơn..."
                           @bind="_newReason"
                           disabled="@_isSubmitting" />
                </div>

                <!-- Product Lines -->
                <div class="tw-border-t tw-border-slate-200 tw-pt-3">
                    <div class="tw-flex tw-justify-between tw-items-center tw-mb-2">
                        <span class="tw-font-semibold tw-text-sm tw-text-slate-800">Danh mục hàng hóa</span>
                        <button type="button"
                                class="tf-btn tf-btn-ghost tf-btn-sm tw-text-blue-600"
                                @onclick="AddVoucherItemRow"
                                disabled="@_isSubmitting">
                            + Thêm sản phẩm
                        </button>
                    </div>

                    @foreach (var row in _newItems)
                    {
                        <div class="tw-flex tw-gap-2.5 tw-items-center tw-mb-2">
                            <select class="tf-form-control tw-flex-1 tw-h-9 tw-text-xs tw-px-2.5 tw-rounded-lg tw-border tw-border-slate-300 focus:tw-border-blue-500 focus:tw-outline-none"
                                    @bind="row.ProductId"
                                    disabled="@_isSubmitting">
                                <option value="0">-- Chọn sản phẩm --</option>
                                @foreach (var prod in _products)
                                {
                                    <option value="@prod.Id">@prod.Code - @prod.Name</option>
                                }
                            </select>
                            <input type="number" step="1" min="1"
                                   class="tf-form-control tw-w-24 tw-h-9 tw-text-xs tw-px-2.5 tw-rounded-lg tw-border tw-border-slate-300 focus:tw-border-blue-500 focus:tw-outline-none"
                                   placeholder="Số lượng"
                                   @bind="row.ActualQuantity"
                                   disabled="@_isSubmitting" />
                            <input type="number" step="1000" min="0"
                                   class="tf-form-control tw-w-32 tw-h-9 tw-text-xs tw-px-2.5 tw-rounded-lg tw-border tw-border-slate-300 focus:tw-border-blue-500 focus:tw-outline-none"
                                   placeholder="Đơn giá"
                                   @bind="row.UnitPrice"
                                   disabled="@_isSubmitting" />
                            <button type="button"
                                    class="tf-modal-close-btn tw-w-8 tw-h-8 tw-min-w-[32px] tw-min-h-[32px] tw-text-slate-400 hover:tw-text-red-600"
                                    @onclick="() => _newItems.Remove(row)"
                                    disabled="@_isSubmitting"
                                    title="Xóa dòng">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <line x1="18" y1="6" x2="6" y2="18"></line>
                                    <line x1="6" y1="6" x2="18" y2="18"></line>
                                </svg>
                            </button>
                        </div>
                    }
                </div>
            </div>

            <div class="tw-flex tw-justify-end tw-gap-2.5 tw-border-t tw-border-slate-200 tw-pt-4 tw-mt-5">
                <button type="button"
                        class="tf-btn tf-btn-secondary"
                        @onclick="RequestCloseCreateModal"
                        disabled="@_isSubmitting">
                    Đóng
                </button>
                <button type="button"
                        class="tf-btn tf-btn-primary"
                        @onclick="SaveVoucherAsync"
                        disabled="@_isSubmitting">
                    @if (_isSubmitting)
                    {
                        <span class="tw-inline-block tw-animate-spin tw-rounded-full tw-h-3.5 tw-w-3.5 tw-border-b-2 tw-border-white tw-mr-1.5"></span>
                        <span>Đang ghi sổ chứng từ...</span>
                    }
                    else
                    {
                        <span>Lưu chứng từ</span>
                    }
                </button>
            </div>

            @* Unsaved Changes Confirm Dialog *@
            @if (_showDiscardConfirm)
            {
                <div class="tf-modal-confirm-overlay" @onclick:stopPropagation="true">
                    <div class="tf-modal-confirm-box tw-text-center">
                        <div class="tw-w-12 tw-h-12 tw-rounded-full tw-bg-amber-100 tw-text-amber-600 tw-flex tw-items-center tw-justify-center tw-mx-auto tw-mb-3">
                            <svg class="tw-w-6 tw-h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                            </svg>
                        </div>
                        <h4 class="tw-text-base tw-font-bold tw-text-slate-900 tw-mb-1.5">Bạn có thay đổi chưa lưu</h4>
                        <p class="tw-text-xs tw-text-slate-500 tw-mb-5 tw-leading-relaxed">
                            Bạn có chắc muốn đóng và hủy thay đổi? Thông tin chứng từ kho bạn đang soạn thảo sẽ không được lưu.
                        </p>
                        <div class="tw-flex tw-items-center tw-justify-center tw-gap-2.5">
                            <button type="button" class="tf-btn tf-btn-secondary tw-text-xs" @onclick="() => _showDiscardConfirm = false">
                                Tiếp tục chỉnh sửa
                            </button>
                            <button type="button" class="tf-btn tf-btn-danger tw-text-xs" @onclick="ConfirmDiscard">
