@namespace TradeFlow.Web.Components.Shared.Display
@inject IJSRuntime JS

@if (TotalCount > 0)
{
    <div class="tf-pagination-container @Class" @attributes="AdditionalAttributes">
        <div class="tf-pagination-info">
            <span class="tf-pagination-text">
                Hiển thị <strong>@StartRecord</strong> – <strong>@EndRecord</strong> trong tổng số <strong>@TotalCount</strong> @ItemName
            </span>
            @if (ShowPageSizeSelector)
            {
                <div class="tf-pagination-size-selector">
                    <select class="tf-input tf-pagination-select"
                            value="@EffectivePageSizeValue"
                            @onchange="HandlePageSizeChange"
                            aria-label="Số bản ghi trên mỗi trang">
                        @foreach (var size in PageSizes)
                        {
                            <option value="@size">@size dòng / trang</option>
                        }
                        @if (AllowAll)
                        {
                            <option value="@AllPageSizeValue">
                                Tất cả@(TotalCount > MaxAllSize ? $" (tối đa {MaxAllSize})" : "")
                            </option>
                        }
                    </select>
                </div>
            }
        </div>

        @if (TotalPages > 1)
        {
            <div class="tf-pagination-controls" role="navigation" aria-label="Phân trang">
                <button type="button"
                        class="tf-btn tf-btn-sm tf-btn-secondary tf-pagination-btn"
                        disabled="@(CurrentPage <= 1)"
                        @onclick="() => SetPage(CurrentPage - 1)"
                        title="Trang trước"
                        aria-label="Trang trước">
                    ‹ Trước
                </button>

                @foreach (var p in VisiblePages)
                {
                    var pageNum = p;
                    if (pageNum == -1)
                    {
                        <span class="tf-pagination-ellipsis" aria-hidden="true">…</span>
                    }
                    else
                    {
                        <button type="button"
                                class="tf-btn tf-btn-sm tf-pagination-btn @(pageNum == CurrentPage ? "tf-btn-primary" : "tf-btn-secondary")"
                                @onclick="() => SetPage(pageNum)"
                                aria-current="@(pageNum == CurrentPage ? "page" : null)"
                                aria-label="@($"Trang {pageNum}")">
                            @pageNum
                        </button>
                    }
                }

                <button type="button"
                        class="tf-btn tf-btn-sm tf-btn-secondary tf-pagination-btn"
                        disabled="@(CurrentPage >= TotalPages)"
                        @onclick="() => SetPage(CurrentPage + 1)"
                        title="Trang sau"
                        aria-label="Trang sau">
                    Sau ›
                </button>
            </div>
        }
    </div>
}

@code {
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public int PageSize { get; set; } = 20;
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public string ItemName { get; set; } = "mục";
    [Parameter] public bool ShowPageSizeSelector { get; set; } = true;
    [Parameter] public int[] PageSizes { get; set; } = new[] { 10, 20, 50, 100 };
    [Parameter] public bool AllowAll { get; set; } = true;
    [Parameter] public int MaxAllSize { get; set; } = 500;
    [Parameter] public string? PreferenceKey { get; set; }
    [Parameter] public EventCallback<int> CurrentPageChanged { get; set; }
    [Parameter] public EventCallback<int> PageSizeChanged { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    public int AllPageSizeValue => MaxAllSize;
    public int EffectivePageSizeValue => PageSize >= MaxAllSize ? AllPageSizeValue : PageSize;

    public int TotalPages => Math.Max(1, (int)Math.Ceiling((double)TotalCount / (PageSize > 0 ? PageSize : 20)));
    public int StartRecord => TotalCount == 0 ? 0 : (CurrentPage - 1) * PageSize + 1;
    public int EndRecord => Math.Min(CurrentPage * PageSize, TotalCount);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !string.IsNullOrEmpty(PreferenceKey))
        {
            try
            {
                var stored = await JS.InvokeAsync<string?>("localStorage.getItem", $"tf_pagesize_{PreferenceKey}");
                if (int.TryParse(stored, out int savedSize) && savedSize > 0)
                {
                    if (PageSizes.Contains(savedSize) || (AllowAll && savedSize >= MaxAllSize))
                    {
                        if (savedSize != PageSize)
                        {
                            PageSize = savedSize;
                            if (PageSizeChanged.HasDelegate)
                            {
                                await PageSizeChanged.InvokeAsync(savedSize);
                            }
                            StateHasChanged();
                        }
                    }
                }
            }
            catch
            {
                // Ignore JS interop errors in non-browser/test environments
            }
        }
    }

    private IEnumerable<int> VisiblePages
    {
        get
        {
            var pages = new List<int>();
            int total = TotalPages;
            int current = CurrentPage;

            if (total <= 7)
            {
                for (int i = 1; i <= total; i++) pages.Add(i);
                return pages;
            }

            pages.Add(1);

            if (current > 4)
            {
                pages.Add(-1); // ellipsis
            }

            int start = Math.Max(2, current - 1);
            int end = Math.Min(total - 1, current + 1);

            if (current <= 4)
            {
                start = 2;
                end = 4;
            }
            else if (current >= total - 3)
            {
                start = total - 3;
                end = total - 1;
            }

            for (int i = start; i <= end; i++)
            {
                pages.Add(i);
            }

            if (current < total - 3)
            {
                pages.Add(-1); // ellipsis
            }

            pages.Add(total);

            return pages;
        }
    }

    private async Task SetPage(int page)
    {
        if (page < 1 || page > TotalPages || page == CurrentPage) return;
        CurrentPage = page;
        if (CurrentPageChanged.HasDelegate)
        {
            await CurrentPageChanged.InvokeAsync(page);
        }
    }

    private async Task HandlePageSizeChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int newSize) && newSize > 0)
        {
            PageSize = newSize;
            if (!string.IsNullOrEmpty(PreferenceKey))
            {
                try
                {
                    await JS.InvokeVoidAsync("localStorage.setItem", $"tf_pagesize_{PreferenceKey}", newSize.ToString());
                }
                catch { }
            }
            if (PageSizeChanged.HasDelegate)
            {
                await PageSizeChanged.InvokeAsync(newSize);
            }
        }
    }
}
