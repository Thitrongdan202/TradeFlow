@namespace TradeFlow.Web.Components.Shared.Forms

@if (IsOpen)
{
    <div class="tf-modal-overlay"
         @onclick="HandleBackdropClick"
         @onkeydown="HandleKeyDown"
         tabindex="-1"
         role="presentation">
        <div class="@ComputedModalClass"
             style="position: relative;"
             role="dialog"
             aria-modal="true"
             aria-labelledby="@(string.IsNullOrEmpty(Title) ? null : "tf-modal-title-id")"
             @onclick:stopPropagation="true">
            <div class="tf-modal-header">
                @if (HeaderContent != null)
                {
                    @HeaderContent
                }
                else
                {
                    <h3 id="tf-modal-title-id" class="tf-modal-title">@Title</h3>
                    <button type="button"
                            class="tf-modal-close-btn"
                            @onclick="RequestCloseAsync"
                            disabled="@IsSubmitting"
                            aria-label="Đóng"
                            title="Đóng">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                }
            </div>

            <div class="tf-modal-body">
                @if (BodyContent != null)
                {
                    @BodyContent
                }
                else
                {
                    @ChildContent
                }
            </div>

            @if (FooterContent != null)
            {
                <div class="tf-modal-footer">
                    @FooterContent
                </div>
            }

            @* Unsaved Changes Confirmation Modal Overlay *@
            @if (_showDirtyConfirm)
            {
                <div class="tf-modal-confirm-overlay" @onclick:stopPropagation="true">
                    <div class="tf-modal-confirm-box text-center">
                        <div class="tw-w-12 tw-h-12 tw-rounded-full tw-bg-amber-100 tw-text-amber-600 tw-flex tw-items-center tw-justify-center tw-mx-auto tw-mb-3">
                            <svg class="tw-w-6 tw-h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                            </svg>
                        </div>
                        <h4 class="tw-text-base tw-font-bold tw-text-slate-900 tw-mb-1.5">Bạn có thay đổi chưa lưu</h4>
                        <p class="tw-text-xs tw-text-slate-500 tw-mb-5 tw-leading-relaxed">
                            Bạn có chắc muốn đóng và hủy thay đổi? Dữ liệu bạn vừa nhập sẽ không được lưu.
                        </p>
                        <div class="tw-flex tw-items-center tw-justify-center tw-gap-2.5">
                            <button type="button" class="tf-btn tf-btn-secondary tw-text-xs" @onclick="() => _showDirtyConfirm = false">
                                Tiếp tục chỉnh sửa
                            </button>
                            <button type="button" class="tf-btn tf-btn-danger tw-text-xs" @onclick="ConfirmDiscardAsync">
                                Hủy thay đổi
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string Size { get; set; } = "md"; // sm, md, lg
    [Parameter] public RenderFragment? HeaderContent { get; set; }
    [Parameter] public RenderFragment? BodyContent { get; set; }
    [Parameter] public RenderFragment? FooterContent { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public bool CloseOnBackdropClick { get; set; } = true;
    [Parameter] public bool CloseOnEscape { get; set; } = true;
    [Parameter] public bool IsDirty { get; set; } = false;
    [Parameter] public bool IsSubmitting { get; set; } = false;
    [Parameter] public string? Class { get; set; }

    private bool _showDirtyConfirm = false;

    private string ComputedModalClass
    {
        get
        {
            var classes = new List<string> { "tf-modal" };
            var sizeClass = Size?.ToLowerInvariant().Trim() switch
            {
                "sm" => "tf-modal-sm",
                "lg" => "tf-modal-lg",
                _ => "tf-modal-md"
            };
            classes.Add(sizeClass);
            if (!string.IsNullOrWhiteSpace(Class)) classes.Add(Class);
            return string.Join(" ", classes);
        }
    }

    private async Task HandleBackdropClick()
    {
        if (IsSubmitting) return;

        // If form has unsaved changes, prevent accidental backdrop dismissal
        if (IsDirty)
        {
            _showDirtyConfirm = true;
            return;
        }

        if (CloseOnBackdropClick)
        {
            await CloseAsync();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (IsSubmitting) return;

        if (CloseOnEscape && e.Key == "Escape")
        {
            if (_showDirtyConfirm)
            {
                _showDirtyConfirm = false;
                return;
            }

            await RequestCloseAsync();
        }
    }

    public async Task RequestCloseAsync()
    {
        if (IsSubmitting) return;

        if (IsDirty)
        {
            _showDirtyConfirm = true;
            return;
        }

        await CloseAsync();
    }

    private async Task ConfirmDiscardAsync()
    {
        _showDirtyConfirm = false;
        await CloseAsync();
    }

    private async Task CloseAsync()
    {
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }
}
