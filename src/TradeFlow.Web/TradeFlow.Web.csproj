<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>tradeflow-web-dev-secrets</UserSecretsId>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.11" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TradeFlow.Application\TradeFlow.Application.csproj" />
    <ProjectReference Include="..\TradeFlow.Infrastructure\TradeFlow.Infrastructure.csproj" />
  </ItemGroup>

  <Target Name="CopyGsap" BeforeTargets="Build" Condition="Exists('node_modules\gsap\dist\gsap.min.js')">
    <Copy SourceFiles="node_modules\gsap\dist\gsap.min.js" DestinationFolder="wwwroot\lib\gsap" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="BuildTailwindCss" BeforeTargets="Build" Condition="Exists('node_modules')">
    <Exec Command="npm.cmd run build:css" ContinueOnError="true" StandardOutputImportance="low" />
  </Target>

</Project>
